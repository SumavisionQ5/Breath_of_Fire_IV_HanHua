  "src": "シャド",
  "tgt": "夏德"
 },
 {
  "id": "016023",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「みんなでいっしょに\nケチャしない？{码14820C82}はい\nいいえ",
  "tgt": "「大家一起\n来跳凯恰舞吗？是\n否{码14820C82}はい\nいいえ"
 },
 {
  "id": "016024",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "また来てよう！",
  "tgt": "再来哟！"
 },
 {
  "id": "016025",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "說明は闻く？{码14820CC2}はい\nいいえ",
  "tgt": "要听说明吗？是\n否{码14820CC2}はい\nいいえ"
 },
 {
  "id": "016026",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "ケチャのリズムに合わせて\nタイミングよくボタンを\n押してよう\n---\nジャストで押すと高得点\nずれてると得点がマイナス\n---\n終了後に合計点数が\nひょうじされるから‥\n---\nもしもそれが一定点数を\n超えていたら、一度だけ\n何かアイテムをあげるよう\n---\nちなみに一番いいものは\n{色02}1500点{/色}であげるよう\n---\n{码0B}‥でもこんな点数を出せた人\nいまだに見たことがないけど\n---\n說明は以上だけど、\nもう一度闻く？{码14820CC2}はい\nいいえ",
  "tgt": "跟着克恰的节奏\n看准时机\n按键哟\n---\n按准得高分\n按偏要扣分\n---\n结束后会显示\n总分……\n---\n要是分数超过\n一定数值，会一次性\n送你一件道具哟\n---\n顺便说一句，最好的东西\n要{色02}1500分{/色}才送哟\n---\n{码0B}……不过打出\n这种分数的人\n至今还没见过\n---\n说明就是这些\n要再听一遍吗？{码14820CC2}是\n否"
 },
 {
  "id": "016027",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "それじゃあ、はじめるよう！",
  "tgt": "那么，开始了哟！"
 },
 {
  "id": "016028",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "どうする？{码14820C93}本番にチャレンジ！\nレッスンする\nやめる",
  "tgt": "怎么做？挑战正式演奏！\n上练习课\n不玩了{码14820C93}本番にチャレンジ！\nレッスンする\nやめる"
 },
 {
  "id": "016029",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "どのレッスンをする？{码14820C15}初心者向き\n少し上手な人向き\nすごく上手な人向き\nスペシャリスト向き\n最後のキメ",
  "tgt": "上哪种练习课？面向新手\n面向稍熟练的人\n面向高手\n面向专家\n最后的压轴{码14820C15}初心者向き\n少し上手な人向き\nすごく上手な人向き\nスペシャリスト向き\n最後のキメ"
 },
 {
  "id": "016030",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "レッスン、スタートよう！",
  "tgt": "练习课，开始哟！"
 },
 {
  "id": "016031",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "それじゃあ、本番だよう！",
  "tgt": "那么，正式演奏开始哟！"
 },
 {
  "id": "016032",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "もう一度チャレンジする？{码14820C93}もう一度！\nレッスンする\nやめる",
  "tgt": "要再挑战一次吗？再来一次！\n上练习课\n不玩了{码14820C93}もう一度！\nレッスンする\nやめる"
 },
 {
  "id": "016033",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「じゃんけん じゃんけん\nカードじゃんけん だよう！\nおおもうけ、確実だよう！",
  "tgt": "「猜拳猜拳\n是卡片猜拳哟！\n大赚一笔，稳稳的哟！"
 },
 {
  "id": "016034",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「どうするの？{码14820C94}プレイする\n說明をきく\nけい品を見る\nやらない",
  "tgt": "「要怎么做？玩一把\n听说明\n看奖品\n不玩了{码14820C94}プレイする\n說明をきく\nけい品を見る\nやらない"
 },
 {
  "id": "016035",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "それじゃあ說明するよう\n---\nこれはカードを使って\nじゃんけんするゲームだよう\n---\nモードは{色03}ノーマル{/色}と{色03}ランダム{/色}の\n2種類\n---\nりょうほう6まいのカードを使って\nじゃんけんするんだけど‥\n---\n{色03}ランダム{/色}は じゃんけんカードが\nてきとうにくばられるから\n\n---\n運が悪いと、すぐに負けちゃうよう\n---\nどちらかのカードがなくなった時点で\nゲームは終了\n---\nそっちのカードがなくなるか\nひきわけだったら\nあたしの勝ち\n---\nあたしのカードが\n先になくなったら\nあなたの勝ち\n---\n勝利した場合は\nのこったカード数に応じて\nポイントをゲット\n---\nポイントとこうかんで\nけい品が手に入るけど‥\n---\nどんなにポイントがあっても\n一度のこうかんで\n全部を うしなってしまうよう\n---\nついでに高いポイントの\nけい品を手に入れるには\n---\n何度もれんぞくして勝って\nポイントをためる必要があるよう\n---\nあとは‥\n---\nもしかしたら妖精の せいかくで\nプレイスタイルに\nとくちょうが出るかもしれないよう\n---\n何度もプレイすると\nそのうち分かるかも\n---\n長くなったけど\n說明はこんなところだよう",
  "tgt": "那么来说明哟\n---\n这是用卡片\n来玩猜拳的游戏哟\n---\n模式有普通和随机\n两种\n---\n双方各用6张卡片\n来玩猜拳‥\n---\n随机模式下猜拳卡片\n是随机分发的\n\n---\n运气不好的话马上就会输掉哟\n---\n任意一方的卡片用完之时\n游戏即告结束\n---\n你那边卡片先用完\n或者打平的话\n就算人家赢\n---\n人家的卡片\n先用完的话\n就算你赢\n---\n获胜的话\n按剩余卡片数量\n获得点数\n---\n用点数交换\n能拿到奖品‥\n---\n但不管攒了多少点数\n交换一次\n就会全部失去哟\n---\n想拿到高点数的\n奖品的话\n---\n需要连胜多次\n攒够点数才行哟\n---\n还有‥\n---\n说不定因为妖精的性格\n玩法上会\n出现特色哟\n---\n多玩几次的话\n或许就会明白了\n---\n说得有点长\n说明就到这里哟{色03}ノーマル{/色}と{色03}ランダム{/色}の\n2種類\n---\nりょうほう6まいのカードを使って\nじゃんけんするんだけど‥\n---\n{色03}ランダム{/色}は じゃんけんカードが\nてきとうにくばられるから\n\n---\n運が悪いと、すぐに負けちゃうよう\n---\nどちらかのカードがなくなった時点で\nゲームは終了\n---\nそっちのカードがなくなるか\nひきわけだったら\nあたしの勝ち\n---\nあたしのカードが\n先になくなったら\nあなたの勝ち\n---\n勝利した場合は\nのこったカード数に応じて\nポイントをゲット\n---\nポイントとこうかんで\nけい品が手に入るけど‥\n---\nどんなにポイントがあっても\n一度のこうかんで\n全部を うしなってしまうよう\n---\nついでに高いポイントの\nけい品を手に入れるには\n---\n何度もれんぞくして勝って\nポイントをためる必要があるよう\n---\nあとは‥\n---\nもしかしたら妖精の せいかくで\nプレイスタイルに\nとくちょうが出るかもしれないよう\n---\n何度もプレイすると\nそのうち分かるかも\n---\n長くなったけど\n說明はこんなところだよう"
 },
 {
  "id": "016036",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "また来てよう",
  "tgt": "再来哟"
 },
 {
  "id": "016037",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{金钱00}りょうきんの\n300ゼニーを いただくよう",
  "tgt": "{金钱00}手续费\n收你300泽尼哟"
 },
 {
  "id": "016038",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「お金が足りないよう\nゲームはさせられないよう！",
  "tgt": "「钱不够哟\n没法让你玩哟！"
 },
 {
  "id": "016039",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "勝負開始だよう！\nどっちが負けても\nうらみっこなしだよう",
  "tgt": "胜负开始哟！\n不管哪边输了\n都不许记仇哟"
 },
 {
  "id": "016040",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "ゲーム、やめちゃうの？\n---\nポイントが残っているのに\nゲームをやめると\n---\nポイントはみんな\nなくなっちゃうよう？{码14820C82}はい\nいいえ",
  "tgt": "游戏不玩了吗？\n---\n还剩着点数\n却不玩了的话\n---\n点数会\n全部消失哟？是\n否{码14820C82}はい\nいいえ"
 },
 {
  "id": "016041",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「今回も いいバトルだったよう！\nまだまだプレイする？{码14820C93}ゲームをプレイする\nけい品とこうかん\nやらない",
  "tgt": "「这次也是场好对决哟！\n还要继续玩吗？玩游戏\n用点数换奖品\n不玩了{码14820C93}ゲームをプレイする\nけい品とこうかん\nやらない"
 },
 {
  "id": "016042",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「‥うーん、負けちゃったよう\n---\n残りカード{占位00}まいだから\n{占位00}ポイントかくとくだよう",
  "tgt": "「……嗯——，输了哟\n---\n剩下的牌有{占位00}张\n所以得{占位00}点数哟"
 },
 {
  "id": "016043",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「へへ、あたしの勝ちだよう！\n---\n悪いけど\nこれでポイントは\nリセットだよう",
  "tgt": "「嘿嘿，是人家赢了哟！\n---\n不好意思\n这下点数\n清零了哟"
 },
 {
  "id": "016044",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「それでこそギャンブラー！\nゲーム續行だよう！",
  "tgt": "「这才像赌徒嘛！\n游戏继续哟！"
 },
 {
  "id": "016045",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "ポイントとそれを\nこうかんする？{码14820C82}はい\nいいえ",
  "tgt": "要用点数\n换奖品吗？是\n否{码14820C82}はい\nいいえ"
 },
 {
  "id": "016046",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "ん？\n---\nどうやらそのアイテムは\nいっぱいだよう",
  "tgt": "嗯？\n---\n那个道具好像\n已经满了哟"
 },
 {
  "id": "016047",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "それではこの{色03}{占位00}{/色}を\nプレゼントするよう\n大事にしてほしいよう",
  "tgt": "那就把这件{色03}{占位00}{/色}\n送给你哟\n请好好珍惜哟"
 },
 {
  "id": "016048",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「今回はどっちのモードで\nプレイする？{码14820C02}ノーマル\nランダム",
  "tgt": "{框44}「这次要用哪种模式\n来玩？普通\n随机{码14820C02}ノーマル\nランダム"
 },
 {
  "id": "016049",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框46}「このカードで\nよろしいですか？{码14820C82}はい\nいいえ",
  "tgt": "{框46}「用这张卡片\n可以吗？是\n否{码14820C82}はい\nいいえ"
 },
 {
  "id": "016050",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「それでは勝負だよう！\n---\nじゃんけーん！\nぽん！",
  "tgt": "{框44}「那么一决胜负哟！\n---\n猜拳——！\n啪！"
 },
 {
  "id": "016051",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「あっ！！",
  "tgt": "{框44}「啊！！"
 },
 {
  "id": "016052",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「‥ま、また負けたよう",
  "tgt": "{框44}「‥又、又输了哟"
 },
 {
  "id": "016053",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「へへへ\nまたあたしの勝ち！",
  "tgt": "{框44}「嘿嘿嘿\n又是人家赢！"
 },
 {
  "id": "016054",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「これじゃあ\nもう勝てないよう‥",
  "tgt": "{框44}「这下\n已经赢不了了哟‥"
 },
 {
  "id": "016055",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「連續で負けると\nへこむよう‥",
  "tgt": "{框44}「连输的话\n会受打击的哟‥"
 },
 {
  "id": "016056",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「へへへ\n---\nこれなら絶対に\nあたしの勝ちだよう",
  "tgt": "{框44}「嘿嘿嘿\n---\n这下绝对是\n人家赢了哟"
 },
 {
  "id": "016057",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「よわいなー\n---\nもう少し\nがんばってほしいよう",
  "tgt": "{框44}「真弱呀——\n---\n希望你\n再加把劲哟"
 },
 {
  "id": "016058",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「なんだか\nいいかんじだよう",
  "tgt": "{框44}「总觉得\n感觉不错哟"
 },
 {
  "id": "016059",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「なんだか\nにやけてくるよう",
  "tgt": "{框44}「不知不觉\n要笑出声了哟"
 },
 {
  "id": "016060",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「次はどうしようかな‥",
  "tgt": "{框44}「下次出什么好呢‥"
 },
 {
  "id": "016061",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「へへん！",
  "tgt": "{框44}「嘿嘿！"
 },
 {
  "id": "016062",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「うーん\n次はどうしようかな‥",
  "tgt": "{框44}「唔嗯\n下次出什么好呢‥"
 },
 {
  "id": "016063",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「えーと‥",
  "tgt": "{框44}「那个‥"
 },
 {
  "id": "016064",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「よく分からないよう‥",
  "tgt": "{框44}「人家也搞不懂了哟‥"
 },
 {
  "id": "016065",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「まだまだ勝負は\nわからないよう！",
  "tgt": "{框44}「胜负还没\n见分晓哟！"
 },
 {
  "id": "016066",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「負けたくないよう！",
  "tgt": "{框44}「不想输哟！"
 },
 {
  "id": "016067",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「がんばるよう！",
  "tgt": "{框44}「加油哟！"
 },
 {
  "id": "016068",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「はぁ‥",
  "tgt": "{框44}「哈啊‥"
 },
 {
  "id": "016069",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「勝てるわけないよう‥",
  "tgt": "{框44}「不可能赢的哟‥"
 },
 {
  "id": "016070",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「あれ？\n---\nあっという間に\n勝っちゃったよう！\n---\nどこか ぐあいでも\nわるかったの？",
  "tgt": "{框44}「咦？\n---\n一眨眼\n就赢了哟！\n---\n是不是哪里\n不舒服呀？"
 },
 {
  "id": "016071",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「やったー！\nあたしの勝ちだよう！",
  "tgt": "{框44}「太棒了！\n人家赢了哟！"
 },
 {
  "id": "016072",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「あたしの勝ちだよう！\n---\nだけどなかなか\nつらかったよう",
  "tgt": "{框44}「人家赢了哟！\n---\n不过打得\n相当艰难哟"
 },
 {
  "id": "016073",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「どうやら\nひきわけ だよう\n---\n{码0B}‥ということは\n残念ながらあたしの\n勝ちだよう！",
  "tgt": "{框44}「看来\n是平局哟\n---\n‥也就是说\n很遗憾算人家\n赢了哟！{码0B}‥ということは\n残念ながらあたしの\n勝ちだよう！"
 },
 {
  "id": "016074",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「‥カードがもうないよう\n---\n今回は\nつめがあまかったよう",
  "tgt": "{框44}「‥卡片已经没了哟\n---\n这次\n是人家手软了哟"
 },
 {
  "id": "016075",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「あああ‥\n---\nま、負けちゃったよう‥",
  "tgt": "{框44}「啊啊啊‥\n---\n输、输掉了哟‥"
 },
 {
  "id": "016076",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「だ、だめだよう‥\n---\n何もかもが\nうらめに出たよう‥",
  "tgt": "{框44}「不、不行了哟‥\n---\n做什么\n都不顺哟‥"
 },
 {
  "id": "016077",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "ソウルリング",
  "tgt": "灵魂戒指"
 },
 {
  "id": "016078",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "10000ゼニー",
  "tgt": "10000泽尼"
 },
 {
  "id": "016079",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "オトシ玉",
  "tgt": "压岁玉"
 },
 {
  "id": "016080",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "1000ゼニー",
  "tgt": "1000泽尼"
 },
 {
  "id": "016081",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "パンプス",
  "tgt": "浅口鞋"
 },
 {
  "id": "016082",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "純元気玉",
  "tgt": "纯元气玉"
 },
 {
  "id": "016083",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「次はグーを出すかも\nしれないよう",
  "tgt": "{框44}「下次说不定\n会出石头哟"
 },
 {
  "id": "016084",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「チョキ‥‥{码0B}{码0B}\nいや、なんでもないよう！",
  "tgt": "{框44}「剪刀‥‥\n不，没什么哟！{码0B}{码0B}\nいや、なんでもないよう！"
 },
 {
  "id": "016085",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「次はパーを出そうかな‥",
  "tgt": "{框44}「下次要不要出布呢‥"
 },
 {
  "id": "016086",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框44}「カードの残りを考えると\n次はあれしかないよう",
  "tgt": "{框44}「考虑到剩下的卡片\n下次只能出那个了哟"
 },
 {
  "id": "016087",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "あだなをつける人を選んでください",
  "tgt": "请选择要起外号的人"
 },
 {
  "id": "016088",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "方向キー：カーソル移動\n \n{色0A}○{/色}：決定   {色0A}×{/色}：キャンセル",
  "tgt": "方向键：移动光标\n\n○：确定×：取消{色0A}○{/色}：決定   {色0A}×{/色}：キャンセル"
 },
 {
  "id": "016089",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "まじめ",
  "tgt": "认真"
 },
 {
  "id": "016090",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "ノーマル",
  "tgt": "普通"
 },
 {
  "id": "016091",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "なまけもの",
  "tgt": "懒汉"
 },
 {
  "id": "016092",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "かわりもの",
  "tgt": "怪胎"
 },
 {
  "id": "016093",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "ストリート",
  "tgt": "街道"
 },
 {
  "id": "016094",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "ひろば",
  "tgt": "广场"
 },
 {
  "id": "016095",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "たいじゅ",
  "tgt": "大树"
 },
 {
  "id": "016096",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "みずうみ",
  "tgt": "湖"
 },
 {
  "id": "016097",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "やどなし",
  "tgt": "无旅店"
 },
 {
  "id": "016098",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「じゃんけん じゃんけん\nカードじゃんけん だよう！\n---\n真面目なあたしと\nカードじゃんけん しようよう！",
  "tgt": "「猜拳猜拳\n是卡片猜拳哟！\n---\n来和认真的\n人家玩卡片猜拳吧！"
 },
 {
  "id": "016099",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「じゃんけん じゃんけん\nカードじゃんけん だよう！\n---\nへいぼんなあたしと\nカードじゃんけん しようよう！",
  "tgt": "「猜拳猜拳\n是卡片猜拳哟！\n---\n来和平凡的\n人家玩卡片猜拳吧！"
 },
 {
  "id": "016100",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「じゃんけん じゃんけん\nカードじゃんけん だよう！\n---\n不真面目なあたしと\nカードじゃんけん しようよう！",
  "tgt": "「猜拳猜拳\n是卡片猜拳哟！\n---\n来和不认真的\n人家玩卡片猜拳吧！"
 },
 {
  "id": "016101",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「じゃんけん じゃんけん\nカードじゃんけん だよう！\n---\n変わり者のあたしと\nカードじゃんけん しようよう！",
  "tgt": "「猜拳猜拳\n是卡片猜拳哟！\n---\n来和怪脾气的\n人家玩卡片猜拳吧！"
 },
 {
  "id": "016102",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「かんぺきだよう！\n本番にチャレンジしてもOKよう！",
  "tgt": "「完美了哟！\n可以直接挑战正式演奏了哟！"
 },
 {
  "id": "016103",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「かんぺきだよう！\n今度はもう少しむずかしいのに\nチャレンジしようよう！",
  "tgt": "「完美了哟！\n这次来挑战\n更难一点的吧！"
 },
 {
  "id": "016104",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「おしい！\nもう少し落ち着いて\nやってみようよう",
  "tgt": "「好可惜！\n再沉着些\n慢慢练哟"
 },
 {
  "id": "016105",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「う〜ん‥‥{码0B}{码0B}\nもっとレッスンした方がいいよう",
  "tgt": "「唔～‥‥\n还是多练习练习比较好哟{码0B}{码0B}\nもっとレッスンした方がいいよう"
 },
 {
  "id": "016106",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「よくできたので ごほうびに\n{色03}{占位00}{/色}をあげるよう！",
  "tgt": "「表现很好，作为奖励\n把{色03}{占位00}{/色}送给你哟！"
 },
 {
  "id": "016107",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "きょうどうたいのしつない",
  "tgt": "共同体室内"
 },
 {
  "id": "016108",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框8A}{码14820C82}はい\nいいえ",
  "tgt": "{框8A}{码14820C82}是\n否"
 },
 {
  "id": "016109",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框88}{码14820C82}はい\nいいえ",
  "tgt": "{框88}{码14820C82}是\n否"
 },
 {
  "id": "016110",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{码14000C92}「仕事のことだけど\n「最近どう？",
  "tgt": "{码14000C92}「关于工作\n「最近怎么样？"
 },
 {
  "id": "016111",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「つかれた体での旅は\nキケンだよう\n---\n泊まってく？{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく",
  "tgt": "「疲惫的身体\n赶路可危险哟\n---\n要住下吗？住下\n只做旅途记录\n先不住{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく"
 },
 {
  "id": "016112",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「泊まる？{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく",
  "tgt": "「要住宿吗？住下\n只做旅途记录\n先不住{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく"
 },
 {
  "id": "016113",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「サービス業は気を使うから\nタイヘンなのよう\n---\n泊まる？{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく",
  "tgt": "「服务业要处处留心\n所以很辛苦的哟\n---\n要住宿吗？住下\n只做旅途记录\n先不住{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく"
 },
 {
  "id": "016114",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「この村でいちばん\nセイケツな宿屋だよう\n---\n泊まってく？{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく",
  "tgt": "「这可是村里\n最干净的旅店哟\n---\n要住下吗？住下\n只做旅途记录\n先不住{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく"
 },
 {
  "id": "016115",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「{队员00}のことは なんでも\n知ってるよう\n---\nんっとねー今まで{占位00}回\nモンスターにあってるよう\n---\nあとねー宿屋にとまったのは\n{占位01}回でしょ\nキャンプが{占位02}回\n---\nで、今まで\n{占位03}ゼニーもうけてるよ\n---\n‥えっストーカーじゃないよ\nほんとだよう",
  "tgt": "「关于{队员00}的事\n我什么都知道哟\n---\n嗯——到现在为止\n遇到过{占位00}次魔物哟\n---\n还有呢——住旅店\n住了{占位01}次吧\n露营了{占位02}次\n---\n然后，到现在\n赚了{占位03}泽尼哟\n---\n……咦？我才不是跟踪狂呢\n真的是哟"
 },
 {
  "id": "016116",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「今まで{占位00}回\nタンスを調べてるよう\n---\nで、宝物は{占位01}こ\n手に入れてるよう\n---\nつりはね···\n{占位02}回やってるよう",
  "tgt": "「到现在为止\n翻过{占位00}次柜子哟\n---\n然后，得到了\n{占位01}个宝物哟\n---\n钓鱼的话···\n钓过{占位02}次哟"
 },
 {
  "id": "016117",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{金钱00}「いらっしゃいだよう\nまじめな道具屋だよう{码14850C93}買う\n売る\nやめる",
  "tgt": "{金钱00}「欢迎光临哟\n是认真的道具店哟{码14850C93}买\n卖\n算了"
 },
 {
  "id": "016118",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{金钱00}「いらっしゃいだよう\nふつうの道具屋だよう{码14850C93}買う\n売る\nやめる",
  "tgt": "{金钱00}「欢迎光临哟\n是普通的道具店哟{码14850C93}买\n卖\n算了"
 },
 {
  "id": "016119",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{金钱00}「はやく遊びに行きたいから\nさっさと買い物すませてよう{码14850C93}買う\n売る\nやめる",
  "tgt": "{金钱00}「我想快点去玩\n赶紧买完哟{码14850C93}买\n卖\n算了"
 },
 {
  "id": "016120",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{金钱00}「いらっしゃいだよう\nいい道具なら、ここだよう{码14850C93}買う\n売る\nやめる",
  "tgt": "{金钱00}「欢迎光临哟\n好道具就在这里哟{码14850C93}买\n卖\n算了"
 },
 {
  "id": "016121",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「‥‥‥‥\nなーんであたしが\n道具屋なのよう！\n---\nジミなシゴトなんて\nしたくないのよう！",
  "tgt": "「‥‥‥‥\n为什么偏偏是我\n在当道具屋呀！\n---\n朴素的工作\n人家才不想干呢！"
 },
 {
  "id": "016122",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「道具っていっても\nいろいろあるのよう",
  "tgt": "「说是道具\n其实五花八门哟"
 },
 {
  "id": "016123",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「にぎやかなほうが\nめずらしい品物も\n手に入れやすいのよう",
  "tgt": "「热闹一点的话\n稀罕的货色\n也更容易到手哟"
 },
 {
  "id": "016124",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「いらっしゃい\nいつもありがとよう",
  "tgt": "「欢迎光临\n一直多谢惠顾哟"
 },
 {
  "id": "016125",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「ふーっ\nヒマだよう",
  "tgt": "「呼——\n闲得慌哟"
 },
 {
  "id": "016126",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「あたしたちの腹の中に\n品物をおいてるのよう\n---\n{码0B}ウソだよう！",
  "tgt": "「道具都放在\n我们的肚子里哟\n---\n骗你的哟！{码0B}ウソだよう！"
 },
 {
  "id": "016127",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「何してる？って\nあたしたちはバイヤー\nなのよう",
  "tgt": "「你问在干嘛？\n我们呀是\n采购员哟"
 },
 {
  "id": "016128",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「ごめんよう\nおまけしてあげたいんだけど‥",
  "tgt": "「对不起哟\n本来想给你优惠的‥"
 },
 {
  "id": "016129",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{金钱00}「あきんど なのよう！\nまじめな武器屋なのよう\n何か 買ってよう{码14840C94}買う\n売る\n下取り\nやめる",
  "tgt": "{金钱00}「是商人哟！\n是认真的武器店哟\n买点什么吧哟{码14840C94}买\n卖\n折价\n算了"
 },
 {
  "id": "016130",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{金钱00}「あきんど なのよう！\nふつうの武器屋なのよう\n何か 買ってよう{码14840C94}買う\n売る\n下取り\nやめる",
  "tgt": "{金钱00}「是商人哟！\n是普通的武器店哟\n买点什么吧哟{码14840C94}买\n卖\n折价\n算了"
 },
 {
  "id": "016131",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{金钱00}「武器を売ってるけど\n早く仕事終わらせて\n遊びたいよう{码14840C94}買う\n売る\n下取り\nやめる",
  "tgt": "{金钱00}「虽然卖着武器\n但我想快点干完活\n去玩哟{码14840C94}买\n卖\n折价\n算了"
 },
 {
  "id": "016132",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{金钱00}「あきんど なのよう！\nいい武器そろえてるから\n何か 買ってよう{码14840C94}買う\n売る\n下取り\nやめる",
  "tgt": "{金钱00}「是商人哟！\n好武器备齐了\n买点什么吧哟{码14840C94}买\n卖\n折价\n算了"
 },
 {
  "id": "016133",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「あたし‥‥\n---\n武器屋ってスキじゃないんだ\nほんとは",
  "tgt": "「人家‥‥\n---\n其实才不喜欢\n开武器屋呢"
 },
 {
  "id": "016134",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「ためし斬りしてみる？\n---\n‥あ、あたしを‥\nそんな目であたしを\n見ないでよう！",
  "tgt": "「要试斩一下吗？\n---\n‥别、别把我‥\n别用那种眼神\n看人家啦！"
 },
 {
  "id": "016135",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「にぎやかなほうが\nいいものが\n手に入りやすいのよう",
  "tgt": "「热闹一点的话\n好东西\n也更容易到手哟"
 },
 {
  "id": "016136",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「いらっしゃい\nこれからもひいきにしてよう",
  "tgt": "「欢迎光临\n今后也请多多关照哟"
 },
 {
  "id": "016137",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「あたし、武器をとぐシゴト\n---\nいいシゴトをしたときは\nためしてみたくなるのよう",
  "tgt": "「人家呀，磨武器的活儿\n---\n干得漂亮的时候\n就想试试刀锋哟"
 },
 {
  "id": "016138",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「ナイフのマルのみできる？",
  "tgt": "「小刀只做圆刃吗？"
 },
 {
  "id": "016139",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「ウエポンフェチって\nちょっとこわいよね",
  "tgt": "「武器控什么的\n有点可怕呢"
 },
 {
  "id": "016140",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「きゃうん\n今日もきてくれて\nありがとよう",
  "tgt": "「呀呜\n今天也谢谢\n你光临哟"
 },
 {
  "id": "016141",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「あちこちに探険に行って\nいろいろな物を探してくるよう\n---\n探険に行く？{码14820C82}はい\nやめる",
  "tgt": "「我们会去各地探险\n找来各种各样的东西哟\n---\n要去探险吗？是\n不去了{码14820C82}はい\nやめる"
 },
 {
  "id": "016142",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「あちこちに探険に行って\nいろいろな物をひろってくるよう\n---\n探険に行く？{码14820C82}はい\nやめる",
  "tgt": "「我们会去各地探险\n捡来各种各样的东西哟\n---\n要去探险吗？是\n不去了{码14820C82}はい\nやめる"
 },
 {
  "id": "016143",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「あちこちに探険に行って\nいろいろな物をぱちってくるよう\n---\n探険に行く？{码14820C82}はい\nやめる",
  "tgt": "「我们会去各地探险\n顺手拿回各种东西哟\n---\n要去探险吗？是\n不去了{码14820C82}はい\nやめる"
 },
 {
  "id": "016144",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「あちこちに探険に行くよう\nアイテムはそのオマケね\n---\n探険に行く？{码14820C82}はい\nやめる",
  "tgt": "「我们要去各地探险哟\n道具只是附带品呢\n---\n要去探险吗？是\n不去了{码14820C82}はい\nやめる"
 },
 {
  "id": "016145",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "どこを探険しよう？",
  "tgt": "去哪里探险呢？"
 },
 {
  "id": "016146",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{占位00}\nでいいのね？{码14820C82}はい\nいいえ",
  "tgt": "{占位00}\n这样可以吗？{码14820C82}是\n否"
 },
 {
  "id": "016147",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "がんばってくるよう！",
  "tgt": "我们会加油的哟！"
 },
 {
  "id": "016148",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "またきてよう",
  "tgt": "再来哟"
 },
 {
  "id": "016149",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「がんばって、すてきなものを\n探してくるよう！\n---\nそれとも、探険やめる？{码14820C93}行き先を変更する\n探険をやめる\nやめない",
  "tgt": "「我们会加油\n找来棒棒的东西哟！\n---\n还是说，不探险了？变更目的地\n取消探险\n继续探险{码14820C93}行き先を変更する\n探険をやめる\nやめない"
 },
 {
  "id": "016150",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「遠くに探険に行くなんて\nドキドキするよう\n---\nやっぱり、探険やめる？{码14820C93}行き先を変更する\n探険をやめる\nやめない",
  "tgt": "「要去那么远的地方探险\n真是让人心跳加速哟\n---\n还是说，不探险了？变更目的地\n取消探险\n继续探险{码14820C93}行き先を変更する\n探険をやめる\nやめない"
 },
 {
  "id": "016151",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「あたしが死んだら\n{队员00}のせいだよう\n---\n探険やめていい？{码14820C93}行き先を変更する\n探険をやめる\nやめちゃダメ",
  "tgt": "「我要是死了\n可都是{队员00}的错哟\n---\n可以停止探险吗？{码14820C93}更改目的地\n停止探险\n不许停"
 },
 {
  "id": "016152",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「今、探険のじゅんび中だよう\nいそがしいのよう\n---\nやっぱり、探険やめる？{码14820C93}行き先を変更する\n探険をやめる\nやめない",
  "tgt": "「现在正在准备探险哟\n忙着呢\n---\n还是说，不探险了？变更目的地\n取消探险\n继续探险{码14820C93}行き先を変更する\n探険をやめる\nやめない"
 },
 {
  "id": "016153",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「それじゃあ、探険は中止するよう",
  "tgt": "「那么，这次探险就中止了哟"
 },
 {
  "id": "016154",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "大砂漠地方    難度5",
  "tgt": "大沙漠地方难度5"
 },
