 },
 {
  "id": "009513",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "「イベント共同体マップ",
  "tgt": "「事件共同体地图"
 },
 {
  "id": "009514",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "{立绘0000}「竜のヒトたち‥\n元の世界に 戻る？{码14000C42}はい\nいいえ",
  "tgt": "{立绘0000}「龙的人们…\n要回原来的世界吗？{码14000C42}是\n否"
 },
 {
  "id": "009515",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "{立绘0000}「じゃ、いったん戻るよう。",
  "tgt": "{立绘0000}「那就先回去哟。"
 },
 {
  "id": "009516",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "{立绘0000}「竜のヒトたちは、もう\n好きなときに\n行ったり来たり できるから‥\n---\n戻りたくなったら\n言ってよう！",
  "tgt": "{立绘0000}「龙的人们以后\n随时都能\n来来回回了…\n---\n想回来\n就说一声哟！"
 },
 {
  "id": "009517",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "{立绘8140}「よく来たよう！",
  "tgt": "{立绘8140}「来得正好哟！"
 },
 {
  "id": "009518",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "{立绘8041}「あたし達、もともと\nこの‥\n---\n{色05}夢の世界{/色}に\n住んでたよう！",
  "tgt": "{立绘8041}「我们本来\n就住在这个‥\n---\n梦的世界\n里哟！{色05}夢の世界{/色}に\n住んでたよう！"
 },
 {
  "id": "009519",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "{立绘8042}「でも‥、ちょっと前に‥\n---\n{立绘8242}{色02}アイツ{/色}らが‥‥",
  "tgt": "{立绘8042}「不过…，刚才…\n---\n{立绘8242}{色02}那些家伙{/色}……"
 },
 {
  "id": "009520",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "{立绘8000}「闻こえた‥？\n---\nアイツら‥、{色02}夢魔{/色}の\nいびきだよう‥‥",
  "tgt": "{立绘8000}「听到了…？\n---\n那些家伙…，是{色02}梦魔{/色}的\n鼾声哟……"
 },
 {
  "id": "009521",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "{立绘8241}「夢魔が、ひどいよう！\n---\nあたしたちを ここから\n追い出したよう！\n---\nにくいよう。",
  "tgt": "{立绘8241}「梦魔太可恶了哟！\n---\n把我们从这里\n赶了出去哟！\n---\n可恨哟。"
 },
 {
  "id": "009522",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "{立绘8242}「竜のヒト‥\n{道具4E00}、あげるから‥\n---\n夢魔たち やっつけてよう！",
  "tgt": "{立绘8242}「龙的人们…\n把{道具4E00}给你们…\n---\n快去收拾梦魔们哟！"
 },
 {
  "id": "009523",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "{立绘0001}「夢魔、見えないけど‥\n---\nぐーぐーって いびきを\n賴りに 探すのよう！",
  "tgt": "{立绘0001}「梦魔看不见…\n---\n靠呼噜呼噜的\n鼾声来找哟！"
 },
 {
  "id": "009524",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "{立绘0002}「夢の中も 現実も\nそんなに 変わんないけど‥\n---\nあたし達は、夢のほうが\n好きなのよう。",
  "tgt": "{立绘0002}「梦里和现实\n也没什么两样…\n---\n但我们还是\n更喜欢梦哟。"
 },
 {
  "id": "009525",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "たてふだが、ある‥\n---\n今は何も 書かれていない。",
  "tgt": "有块告示牌‥\n---\n现在什么都没写。"
 },
 {
  "id": "009526",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "{立绘0100}「すごいよう、やったよう！",
  "tgt": "{立绘0100}「好厉害哟，做到了哟！"
 },
 {
  "id": "009527",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "{立绘0000}「ありがとうよう！\n---\nこれでまた、ここで\nくらせるよう。",
  "tgt": "{立绘0000}「谢谢你们哟！\n---\n这样又能在这里\n生活了哟。"
 },
 {
  "id": "009528",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "{立绘0000}「あ、そだ‥‥！\n---\nあれ、あげちゃうから\nちょっと 待ってよう！",
  "tgt": "{立绘0000}「啊，对了……！\n---\n要送你们那个\n稍等哟！"
 },
 {
  "id": "009529",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "{立绘0000}「う〜〜ん‥‥",
  "tgt": "{立绘0000}「嗯～～…"
 },
 {
  "id": "009530",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "{立绘0000}「ふー‥‥\n---\nひさしぶり だったから\nおっきいよう！\n---\n{立绘0100}はい、{码0B}これ。",
  "tgt": "{立绘0000}「呼……\n---\n好久没出\n这么大的了哟！\n---\n{立绘0100}喏，{码0B}给你。"
 },
 {
  "id": "009531",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "\n {色03}{道具4E00}{/色}を手に入れた！",
  "tgt": "\n 获得了{色03}{道具4E00}{/色}！"
 },
 {
  "id": "009532",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "{立绘4100}「{道具4E00}‥‥\n---\n{立绘0303}キラキラしてて‥\nとっても きれいですね。",
  "tgt": "{立绘4100}「{道具4E00}……\n---\n{立绘0303}闪闪发光…\n好漂亮啊。"
 },
 {
  "id": "009533",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "{立绘8040}「あ、{码0B}あんまり\nしげしげ、見ないでよう‥",
  "tgt": "{立绘8040}「啊，别盯着我\n看个不停哟‥{码0B}あんまり\nしげしげ、見ないでよう‥"
 },
 {
  "id": "009534",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "「‥ほう、妖精のお手伝いで\n夢の世界を 取り戻しに？\n---\nたいへん 申しわけ\nございませんが‥\n---\n妖精の物は 夢魔の物\n夢魔の物は 夢魔の物で\nございます。",
  "tgt": "「‥哦？为了帮妖精们\n夺回梦的世界？\n---\n实在非常\n抱歉‥\n---\n妖精之物尽归梦魔\n梦魔之物仍归梦魔\n请多包涵。"
 },
 {
  "id": "009535",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "「‥夢の世界へ、遠い所から\nようこそ こんにちは‥\n---\nそして さようなら。",
  "tgt": "「‥从遥远之地来到\n梦的世界，欢迎你好‥\n---\n然后，再会。"
 },
 {
  "id": "009536",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "「‥お初にお目にかかります。\n---\n妖精も 食べあきたので‥\nかわりに アナタ様を\nいただきます。",
  "tgt": "「‥初次见面。\n---\n妖精已经吃腻了‥\n这次就换成\n您了。"
 },
 {
  "id": "009537",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "「‥いやいや、すっかり\n寢入っていました‥\n---\n眠気覺ましの 運動に\nおつき合い いただけますか？",
  "tgt": "「‥哎呀哎呀，睡得\n太沉了‥\n---\n能否陪我\n做做醒瞌睡的运动？"
 },
 {
  "id": "009538",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "「‥妖精達の お手伝い\nご苦勞様でございます\n---\nここは ひとつ‥\n返りうちにさせて\nいただきます。",
  "tgt": "「‥帮助妖精们\n辛苦了\n---\n那就让我‥\n反将一军\n如何。"
 },
 {
  "id": "009539",
  "file": "WORLD/AREAE037.EMI",
  "seg": 13,
  "src": "「この度は‥ 手下達を\n倒していただき‥\n---\nまことに お世話さまで\nございました‥\n---\nつきましては、わたくし‥\n手下達に なり代わりまして‥\n---\nせいいっぱい おあいてさせて\nいただく所存です。",
  "tgt": "「此次‥您打倒了\n我的手下们‥\n---\n实在承蒙\n关照了‥\n---\n因此，在下‥\n决定替代手下们‥\n---\n竭尽全力\n回报于您。"
 },
 {
  "id": "009540",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "「どらごんたちとのかいわ",
  "tgt": "「与龙们的对话"
 },
 {
  "id": "009541",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "{立绘0000}「われは タープ\n果て野より、世界を\n見守るもの‥\n---\nアルカイの竜よ\nうつろう者達よ‥\nわれの力が 必要か？{码14000C92}力をかして！\n今は必要ない",
  "tgt": "{立绘0000}「吾乃塔普\n自尽头之野守望\n世界…\n---\n阿尔凯之龙啊\n无常者啊…\n需要吾之力吗？{码14000C92}借你力量！\n现在不需要"
 },
 {
  "id": "009542",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "{立绘0000}「では、世界の行くすえ\n共に 見さだめよう‥",
  "tgt": "{立绘0000}「那么，就一同\n观定世界的归宿…"
 },
 {
  "id": "009543",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "{立绘0000}「では、世界の行くすえ\nこの野で 見守ろう‥",
  "tgt": "{立绘0000}「那么，就在这片原野\n守望世界的归宿…"
 },
 {
  "id": "009544",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "草竜の力を かりて‥\n『{道具4504}』を 身につけた！",
  "tgt": "借草龙之力‥\n掌握了『{道具4504}』！"
 },
 {
  "id": "009545",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "{立绘0101}「わが名は ジュナー\nかわいた砂の底にて\n世界を 見守るもの‥\n---\nアルカイの竜よ\nうつろう者達よ‥\nわれの力が 必要か？{码14010C92}力をかして！\n今は必要ない",
  "tgt": "{立绘0101}「我名朱纳\n于干涸的沙之底\n守望世界‥\n---\n阿尔凯之龙啊\n无常之众啊‥\n需要我的力量吗？借你力量！\n现在不需要{码14010C92}力をかして！\n今は必要ない"
 },
 {
  "id": "009546",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "{立绘0101}「では、世界の行くすえ\n共に 見さだめよう‥",
  "tgt": "{立绘0101}「那么，世界的结局\n就一同守望吧‥"
 },
 {
  "id": "009547",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "{立绘0101}「では、世界の行くすえ\n砂中にて 見守ろう‥",
  "tgt": "{立绘0101}「那么，世界的结局\n就在沙中守望吧‥"
 },
 {
  "id": "009548",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "砂竜の力を かりて‥\n『{道具4304}』を 身につけた！",
  "tgt": "借沙龙之力‥\n掌握了『{道具4304}』！"
 },
 {
  "id": "009549",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "{立绘0202}「われは 名もなきもの‥\n---\n大地の一部となりて\n世界を 見守るもの‥\n---\nアルカイの竜よ\nうつろう者達よ‥\nわれの力が 必要か？{码14020C92}力をかして！\n今は必要ない",
  "tgt": "{立绘0202}「我是无名之物‥\n---\n化作大地的一部分\n守望世界‥\n---\n阿尔凯之龙啊\n无常之众啊‥\n需要我的力量吗？借你力量！\n现在不需要{码14020C92}力をかして！\n今は必要ない"
 },
 {
  "id": "009550",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "{立绘0202}「では、世界の行くすえ\n共に 見さだめよう‥",
  "tgt": "{立绘0202}「那么，世界的结局\n就一同守望吧‥"
 },
 {
  "id": "009551",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "{立绘0202}「では、世界の行くすえ\nこの地にあって 見守ろう‥",
  "tgt": "{立绘0202}「那么，世界的结局\n就在此地守望吧‥"
 },
 {
  "id": "009552",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "岩竜の力を かりて‥\n『{道具4804}』を 身につけた！",
  "tgt": "借岩龙之力‥\n掌握了『{道具4804}』！"
 },
 {
  "id": "009553",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "{立绘0303}「われは 人をして\n賢樹と呼ばれしもの\n---\n大地に 根を下ろし\n世界を 見守るもの‥\n---\nアルカイの竜よ\nうつろう者達よ‥\nわれの力が 必要か？{码14030C92}力をかして！\n今は必要ない",
  "tgt": "{立绘0303}「我是被人们\n称作贤树之物\n---\n扎根大地\n守望世界‥\n---\n阿尔凯之龙啊\n无常之众啊‥\n需要我的力量吗？借你力量！\n现在不需要{码14030C92}力をかして！\n今は必要ない"
 },
 {
  "id": "009554",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "{立绘0303}「では、世界の行くすえ\n共に 見さだめよう‥",
  "tgt": "{立绘0303}「那么，世界的结局\n就一同守望吧‥"
 },
 {
  "id": "009555",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "{立绘0303}「では、世界の行くすえ\nこの森と共に 見守ろう‥",
  "tgt": "{立绘0303}「那么，世界的结局\n就与这片森林一同守望吧‥"
 },
 {
  "id": "009556",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "樹竜の力を かりて‥\n『{道具4904}』を 身につけた！",
  "tgt": "借树龙之力‥\n掌握了『{道具4904}』！"
 },
 {
  "id": "009557",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "{立绘0000}「大砂漠の北‥\n---\nかわいた 大地にて\nアルカイの竜を 待つもの‥\n---\n更なる力‥求むるなら\nたずねるがいい。",
  "tgt": "{立绘0000}「大沙漠之北…\n---\n在干涸的大地\n静候阿尔凯之龙…\n---\n若求更强的力量…\n便来寻吾。"
 },
 {
  "id": "009558",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "{立绘0303}「あおき海‥そのいずこかに\nアルカイの竜を 待つもの‥\n---\n更なる力‥求むるなら\nたずねるがいい。",
  "tgt": "{立绘0303}「苍之海‥某处\n有龙在等待阿尔凯之龙‥\n---\n若渴求\n更多力量，去寻访吧。"
 },
 {
  "id": "009559",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "{立绘0101}「大砂漠の南‥\n---\n泥波うちよせる地にて\nアルカイの竜を 待つもの‥\n---\n更なる力‥求むるなら\nたずねるがいい。",
  "tgt": "{立绘0101}「大沙漠之南‥\n---\n泥浪拍岸之地\n有龙在等待阿尔凯之龙‥\n---\n若渴求\n更多力量，去寻访吧。"
 },
 {
  "id": "009560",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "{立绘0202}「黄金と呼ばれし\n平原の 果て野に\nアルカイの竜を 待つもの‥\n---\n更なる力‥求むるなら\nたずねるがいい。",
  "tgt": "{立绘0202}「被称为黄金的\n平原尽头的原野\n有龙在等待阿尔凯之龙‥\n---\n若渴求\n更多力量，去寻访吧。"
 },
 {
  "id": "009561",
  "file": "WORLD/AREAE038.EMI",
  "seg": 11,
  "src": "{色02}アルカイの竜{/色}でなければ\n話すことは できない‥",
  "tgt": "若非{色02}阿尔凯之龙{/色}\n便无话可说…"
 },
 {
  "id": "009562",
  "file": "WORLD/AREAE039.EMI",
  "seg": 11,
  "src": "「どらごんたちとのかいわ",
  "tgt": "「与龙们的对话"
 },
