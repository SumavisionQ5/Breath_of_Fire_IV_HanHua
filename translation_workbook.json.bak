  "seg": 8,
  "src": "妖精の移動を行います",
  "tgt": "进行妖精的移动"
 },
 {
  "id": "009156",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "妖精のパーソナルデータです",
  "tgt": "妖精的详细资料"
 },
 {
  "id": "009157",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "この職業はまだ開発されていません",
