 {
  "id": "007394",
  "file": "WORLD/AREAE009.EMI",
  "seg": 8,
  "src": "狩りマップ！",
  "tgt": "狩猎地图！"
 },
 {
  "id": "007395",
  "file": "WORLD/AREAE009.EMI",
  "seg": 8,
  "src": "{立绘0000}「助けてよう！！",
  "tgt": "{立绘0000}「救命哟！！"
 },
 {
  "id": "007396",
  "file": "WORLD/AREAE009.EMI",
  "seg": 8,
  "src": "{立绘0000}「ひどいよう···",
  "tgt": "{立绘0000}「好过分哟···"
 },
 {
  "id": "007397",
  "file": "WORLD/AREAE009.EMI",
  "seg": 8,
  "src": "{立绘0100}「ありがとう、助かったよう！\n---\nあたし達、狩りに来て\nときどき こんな風に\n逆に おそわれるんだよう‥",
  "tgt": "{立绘0100}「谢谢，得救了哟！\n---\n我们来打猎\n有时反倒会\n被这样袭击哟…"
 },
 {
  "id": "007398",
  "file": "WORLD/AREAE009.EMI",
  "seg": 8,
  "src": "{占位00}を{占位01}コ見つけた！\n---\n妖精にあげますか？{码14000C02}はい\nいいえ",
  "tgt": "找到{占位00}{占位01}个！\n---\n要给妖精吗？{码14000C02}是\n否"
 },
 {
  "id": "007399",
  "file": "WORLD/AREAE009.EMI",
  "seg": 8,
  "src": "{占位00}を{占位01}コ\n妖精にあげた",
  "tgt": "把{占位00}{占位01}个\n给了妖精"
 },
 {
  "id": "007400",
  "file": "WORLD/AREAE009.EMI",
  "seg": 8,
  "src": "外に出ますか？{码14010CC2}はい\nいいえ",
  "tgt": "要出去吗？是\n否{码14010CC2}はい\nいいえ"
 },
 {
  "id": "007401",
  "file": "WORLD/AREAE009.EMI",
  "seg": 8,
  "src": "{立绘0100}「剣とか、てっぽーで\nえものを とってよう！\n---\nダメージを受けた えものは\n動き回るたびに、にくが\nまずくなるから‥\n---\n一気に しとめるのよう！",
  "tgt": "{立绘0100}「用剑啊枪啊\n捕捉猎物哟！\n---\n受伤的猎物\n每挣扎一次肉\n就会变难吃…\n---\n要一口气放倒哟！"
 },
 {
  "id": "007402",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "すなぶねついらく",
  "tgt": "砂船坠落"
 },
 {
  "id": "007403",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「ダメだ‥\n砂をかんでる‥‥",
  "tgt": "{框06}{立绘C240}「不行了‥\n陷进沙里了‥‥"
 },
 {
  "id": "007404",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「部品を かえないと‥\n---\n修理するのは、むりだな。",
  "tgt": "{框06}{立绘C240}「不更换零件‥\n---\n是没法修好的。"
 },
 {
  "id": "007405",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「あの竜‥\n---\nわたし達を‥\nおそってきたんでしょうか？",
  "tgt": "{框05}{立绘4100}「那条龙…\n---\n是想袭击\n我们吗？"
 },
 {
  "id": "007406",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「分からん‥\n---\nあの後は‥\n出てくる様子も無いし。",
  "tgt": "{框06}{立绘8040}「不知道‥\n---\n那之后‥\n也没有再出来的迹象。"
 },
 {
  "id": "007407",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框06}{立绘4240}「まあ、いずれにせよ‥\n---\n砂漠のはしで 落ちたのは\n助かったな。",
  "tgt": "{框06}{立绘4240}「罢了，无论如何‥\n---\n在沙漠边上坠机\n已是不幸中的万幸。"
 },
 {
  "id": "007408",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「ここからなら‥\n步いて、近くの町まで行ける。",
  "tgt": "{框06}{立绘C240}「从这里的话‥\n步行能到附近的镇子。"
 },
 {
  "id": "007409",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「そこで、部品が\n手に入れば‥\n---\n砂船を 動かせるように\nなりますね。",
  "tgt": "{框05}{立绘4100}「若能在那里\n找到零件…\n---\n沙船\n就能动起来了呢。"
 },
 {
  "id": "007410",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框06}{立绘4200}「ああ、だが‥",
  "tgt": "{框06}{立绘4200}「嗯，可是…"
 },
 {
  "id": "007411",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「こんな所に、砂船を\n放り出しておくと‥\n---\n盗賊どもに、狙われる\n恐れがある‥",
  "tgt": "{框06}{立绘C240}「把砂船\n丢在这种地方‥\n---\n恐怕会被盗贼们\n盯上的‥"
 },
 {
  "id": "007412",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「町で、部品を手に入れて\n戻ってきても‥\n---\n盗賊に やられて\n船が、跡形もなくなっていたら\n話にならない‥",
  "tgt": "{框06}{立绘C240}「就算去镇上买了零件\n回来‥\n---\n要是船被盗贼\n拆得连影子都不剩\n就完了‥"
 },
 {
  "id": "007413",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「{队员02}兄さま‥\nわたしが、行ってきます。",
  "tgt": "{框05}{立绘4100}「{队员02}兄长…\n我去去就来。"
 },
 {
  "id": "007414",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「わたし、砂船の部品を\n探してきます。\n---\nひとりで、だいじょうぶです\n兄さま‥！",
  "tgt": "{框05}{立绘4100}「我去找\n沙船的零件。\n---\n一个人\n没问题的\n兄长…！"
 },
 {
  "id": "007415",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「しかし‥、{队员01}‥",
  "tgt": "{框06}{立绘8040}「可是‥、{队员01}‥"
 },
 {
  "id": "007416",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「いつまでも、兄さまに\n賴ってばかりじゃ‥\n---\n{立绘0101}姉さまに、笑われます。",
  "tgt": "{框05}{立绘4100}「总不能\n事事依赖兄长…\n---\n{立绘0101}会被姐姐\n笑话的。"
 },
 {
  "id": "007417",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「分かった、{码0B}{队员01}‥\nそうだな‥",
  "tgt": "{框06}{立绘C240}「明白了，{码0B}{队员01}‥\n也是啊‥"
 },
 {
  "id": "007418",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{立绘C240}「{队员01}‥\n---\nここから、南に少し下ると\n{色02}サライ{/色}という町が\nあるんだ‥",
  "tgt": "{立绘C240}「{队员01}…\n---\n从这里往南\n下去一点\n有个叫{色02}萨莱{/色}的镇…"
 },
 {
  "id": "007419",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{立绘C240}「そこで、砂船の部品が\n手に入るかもしれない‥",
  "tgt": "{立绘C240}「在那里，说不定\n能买到砂船的零件‥"
 },
 {
  "id": "007420",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{立绘C240}「賴んだぞ、{队员01}。",
  "tgt": "{立绘C240}「拜托了，{队员01}。"
 },
 {
  "id": "007421",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框05}{立绘0201}「はい、兄さま！",
  "tgt": "{框05}{立绘0201}「是，兄长大人！"
 },
 {
  "id": "007422",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{立绘C240}「これを、持って行くといい\n『{道具0101}』だ‥\n---\n何か、めんどうがあった時に\n役立つかもしれない‥",
  "tgt": "{立绘C240}「把这个带上吧\n是『{道具0101}』‥\n---\n遇到麻烦时\n说不定能派上用场‥"
 },
 {
  "id": "007423",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「では、行ってきます\n{队员02}兄さま。",
  "tgt": "{框05}{立绘4100}「那么，我出发了\n{队员02}兄长。"
 },
 {
  "id": "007424",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{立绘C240}「気をつけてな、{队员01}‥\n---\n信じている‥。",
  "tgt": "{立绘C240}「多保重，{队员01}‥\n---\n我相信你‥。"
 },
 {
  "id": "007425",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{立绘4200}「{色02}サライ{/色}の町は\n南の、ガケ道を\nこえた所だ‥\n---\n気をつけてな、{队员01}。",
  "tgt": "{立绘4200}「{色02}萨莱{/色}镇\n在南边崖道\n的那头…\n---\n路上小心，{队员01}。"
 },
 {
  "id": "007426",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{立绘4100}「兄さまっ！",
  "tgt": "{立绘4100}「兄长！"
 },
 {
  "id": "007427",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框05}{立绘4200}「{队员01}‥、{码0B}よかった‥！\n---\n何かあったかと‥\n心配した‥{码0B}‥！",
  "tgt": "{框05}{立绘4200}「{队员01}…，{码0B}太好了…！\n---\n我还担心\n出了事…{码0B}…！"
 },
 {
  "id": "007428",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框06}{立绘8341}「ごめんなさい\n{队员02}兄さま‥！\n---\nわたし‥{码0B}‥",
  "tgt": "{框06}{立绘8341}「对不起\n{队员02}兄长大人‥！\n---\n我‥‥{码0B}‥"
 },
 {
  "id": "007429",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「そうだ、兄さま\nえーとですね‥\n---\n{队员00}さんと\n{队员05}さんです‥",
  "tgt": "{框06}{立绘C140}「对了，兄长\n那个是…\n---\n{队员00}先生和\n{队员05}先生…"
 },
 {
  "id": "007430",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「‥{码0B}‥ふーむ？\n---\n{立绘4200}「ともかく、{码0B}そうだな\n話を 闻かせてもらおう。",
  "tgt": "{框05}{立绘0000}「…{码0B}…唔嗯？\n---\n{立绘4200}「总之，{码0B}好啊\n说来听听。"
 },
 {
  "id": "007431",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{立绘4200}「そうか‥{码0B}‥",
  "tgt": "{立绘4200}「这样啊…{码0B}…"
 },
 {
  "id": "007432",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框06}{立绘0401}「わたし‥、{码0B}けっきょく‥\n---\n砂船の部品も\n手に入れられなかったし‥\n---\n{队员00}さんや\n{队员05}さんに‥\n---\nいろいろ、助けてもらって‥",
  "tgt": "{框06}{立绘0401}「我…，{码0B}结果…\n---\n沙船的零件\n也没找到…\n---\n还受了{队员00}先生\n和{队员05}先生\n---\n那么多帮助…"
 },
 {
  "id": "007433",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{立绘4200}「部品のことは、{码0B}いい。\n---\n{队员01}が、無事に\n戻ったのが 何よりだ‥",
  "tgt": "{立绘4200}「零件的事，{码0B}算了。\n---\n{队员01}平安\n回来就好…"
 },
 {
  "id": "007434",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{立绘4200}「{队员01}を‥\n---\nひとりで 行かせた\n俺が、悪かったのだ‥",
  "tgt": "{立绘4200}「让{队员01}\n---\n独自前往\n是我的不对…"
 },
 {
  "id": "007435",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框06}{立绘0501}「兄さま‥{码0B}‥",
  "tgt": "{框06}{立绘0501}「兄长大人‥‥{码0B}‥"
 },
 {
  "id": "007436",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框06}{立绘C540}「この、砂の船は‥\n---\n砂漠の{色02}竜{/色}が出てきて\n壊されたのだろう、と‥\n---\n{队员05}、言ってますよ。",
  "tgt": "{框06}{立绘C540}「这艘沙船…\n---\n是沙漠的{色02}龙{/色}\n出来弄坏的…\n---\n{队员05}是这么说的哟。"
 },
 {
  "id": "007437",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{立绘0000}「その通りだが‥\n---\nなぜ、そんな事が\n分かるのだ‥！？",
  "tgt": "{立绘0000}「说得没错…\n---\n可你怎么\n会知道…！？"
 },
 {
  "id": "007438",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框06}{立绘C540}「{队员05}には\nそう言う事が、分かる\nようなのですよ‥",
  "tgt": "{框06}{立绘C540}「{队员05}似乎\n能懂得\n这种事哦‥"
 },
 {
  "id": "007439",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框06}{立绘C540}「{队员05}が、もう\nおネムですよ‥",
  "tgt": "{框06}{立绘C540}「{队员05}已经\n困了哦‥"
 },
 {
  "id": "007440",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{立绘4200}「すまない、{码0B}お疲れでしたな。",
  "tgt": "{立绘4200}「抱歉，{码0B}辛苦你们了。"
 },
 {
  "id": "007441",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{立绘4200}「ともかく‥ お二方には\n今一度、礼を言わせてもらう。\n---\n今晚は‥、不自由を\nおかけするが‥\nここで、お休み下さい。",
  "tgt": "{立绘4200}「总之…让二位\n容我再度致谢。\n---\n今晚…条件简陋\n就在这里\n休息吧。"
 },
 {
  "id": "007442",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "その夜、わたしは夢を見ました。",
  "tgt": "那晚，我做了一个梦。"
 },
 {
  "id": "007443",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{立绘0000}「夢‥！？",
  "tgt": "{立绘0000}「梦…！？"
 },
 {
  "id": "007444",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「わたしと、兄さまと‥\n{队员00}さんが‥",
  "tgt": "{框05}{立绘4100}「我和兄长…\n{队员00}先生…"
 },
 {
  "id": "007445",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框04}{立绘C200}「‥{码0B}‥エリーナを 助けに\n行く夢、{码0B}か？",
  "tgt": "{框04}{立绘C200}「…{码0B}…去救艾莉娜的\n梦，{码0B}吗？"
 },
 {
  "id": "007446",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「じゃ、兄さまも\n同じ夢を‥！？",
  "tgt": "{框05}{立绘4100}「那，兄长也做了\n同样的梦…！？"
 },
 {
  "id": "007447",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框04}{立绘C540}「それは、{队员00}の\n見た夢だって‥\n---\n{队员05}、言ってます。",
  "tgt": "{框04}{立绘C540}「那是{队员00}\n做的梦…\n---\n{队员05}是这么说的。"
 },
 {
  "id": "007448",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框06}{立绘C100}「{队员05}さん‥\nそれって、一体‥？",
  "tgt": "{框06}{立绘C100}「{队员05}先生…\n那到底是…？"
 },
 {
  "id": "007449",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框04}{立绘0602}「{色02}竜眼{/色}の見た\n時の向こう‥\n---\nそうなるかも知れない\n未来‥、{码0B}だそうですよ。",
  "tgt": "{框04}{立绘0602}「{色02}龙眼{/色}所见的\n时间彼端…\n---\n或许会那样的\n未来…，{码0B}是这么说的哟。"
 },
 {
  "id": "007450",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框06}{立绘8741}「それは、あのう‥\nつまり‥‥？",
  "tgt": "{框06}{立绘8741}「那究竟是，那个‥\n也就是说‥‥？"
 },
 {
  "id": "007451",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框06}{立绘C200}「つまり‥、彼を\n連れて行けば‥\n---\n夢で見た、あの場所に‥\n---\nエリーナが、いるかもしれない\nあの場所に‥\n---\n行けると言うことなのか！？",
  "tgt": "{框06}{立绘C200}「也就是说…带上他…\n---\n就能去梦里见的\n那个地方…\n---\n艾莉娜可能在的\n那个地方…\n---\n是这意思吗！？"
 },
 {
  "id": "007452",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框04}{立绘0602}「そのようです。",
  "tgt": "{框04}{立绘0602}「是的。"
 },
 {
  "id": "007453",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框03}{立绘C200}「夢の、おつげだろうと\n何だろうと‥\n---\n俺は、見たものを\n信じたい‥",
  "tgt": "{框03}{立绘C200}「不管是梦的\n启示还是什么…\n---\n我只信\n亲眼所见…"
 },
 {
  "id": "007454",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框02}{立绘C140}「これまで、姉さまの\n手がかり‥\n---\n何も、無いみたいな\nものでしたけど‥",
  "tgt": "{框02}{立绘C140}「在此之前，姐姐大人的\n线索‥\n---\n几乎什么\n都没有‥"
 },
 {
  "id": "007455",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框02}{立绘4100}「今、ちょっと\n姉さまに 近づいてる\n気がします‥\n---\n{立绘0201}{队员00}さんの\nおかげ‥、なんですよね？",
  "tgt": "{框02}{立绘4100}「现在感觉\n离姐姐\n近了一点…\n---\n{立绘0201}都是托了\n{队员00}先生的福…对吧？"
 },
 {
  "id": "007456",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框04}{立绘C540}「{队员05}は‥\n---\n{队员00}の 行くところに\n行くと、言ってます。",
  "tgt": "{框04}{立绘C540}「{队员05}…\n---\n说要去\n{队员00}所去之处。"
 },
 {
  "id": "007457",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "{框03}{立绘4200}「では、出発しよう。\n---\n砂船が、使えないので\n砂漠を 回りこんで\n海岸ぞいに、北上する‥",
  "tgt": "{框03}{立绘4200}「那么，出发。\n---\n沙船没法用\n绕过大沙漠\n沿海岸北上…"
 },
 {
  "id": "007458",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "「捨ててある 砂船なら‥\nおれら盗賊も\n---\nどうどうと、パーツを\nいただけるってもんだ！",
  "tgt": "「如果是被丢弃的砂船‥\n我们盗贼也能\n---\n堂堂正正地\n收下零件嘛！"
 },
 {
  "id": "007459",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "「壊れて 捨てられた\n砂船も‥\n---\nオレたち 盗賊には\n{色03}お宝{/色}なのさ。",
  "tgt": "「就算是坏掉\n丢弃的砂船‥\n---\n对我们盗贼来说\n也是宝贝。{色03}お宝{/色}なのさ。"
 },
 {
  "id": "007460",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "「いいなあ、それ\nひょっとして\n{色03}{占位00}{/色}かい‥？\n---\nおくれ！{码0B}{码0B}‥とはいわん\nオレの{色03}お宝{/色}と\n取り替えておくれ！{码14000C92}取り替えよう！\nやめておこう‥",
  "tgt": "「真好啊，那东西\n该不会是\n{色03}{占位00}{/色}吧…？\n---\n开玩笑！{码0B}{码0B}…才怪\n拿我的{色03}宝贝{/色}\n跟你换换！{码14000C92}交换吧！\n算了…"
 },
 {
  "id": "007461",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "\n {色03}{占位01}{/色}と 取り替えた！\n---\n",
  "tgt": "\n换成了{色03}{占位01}{/色}！\n---\n"
 },
 {
  "id": "007462",
  "file": "WORLD/AREAE015.EMI",
  "seg": 11,
  "src": "そのお宝は、盗んだり\nした物じゃないよ。",
  "tgt": "那宝贝可不是\n偷来的东西哦。"
 },
 {
  "id": "007463",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "すなぶねついらく",
  "tgt": "砂船坠落"
 },
 {
  "id": "007464",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框06}{立绘C240}「ダメだ‥\n砂をかんでる‥‥",
  "tgt": "{框06}{立绘C240}「不行了‥\n陷进沙里了‥‥"
 },
 {
  "id": "007465",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框06}{立绘C240}「部品を かえないと‥\n---\n修理するのは、むりだな。",
  "tgt": "{框06}{立绘C240}「不更换零件‥\n---\n是没法修好的。"
 },
 {
  "id": "007466",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框05}{立绘4100}「あの竜‥\n---\nわたし達を‥\nおそってきたんでしょうか？",
  "tgt": "{框05}{立绘4100}「那条龙…\n---\n是想袭击\n我们吗？"
 },
 {
  "id": "007467",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框06}{立绘8040}「分からん‥\n---\nあの後は‥\n出てくる様子も無いし。",
  "tgt": "{框06}{立绘8040}「不知道‥\n---\n那之后‥\n也没有再出来的迹象。"
 },
 {
  "id": "007468",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框06}{立绘4240}「まあ、いずれにせよ‥\n---\n砂漠のはしで 落ちたのは\n助かったな。",
  "tgt": "{框06}{立绘4240}「罢了，无论如何‥\n---\n在沙漠边上坠机\n已是不幸中的万幸。"
 },
 {
  "id": "007469",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框06}{立绘C240}「ここからなら‥\n步いて、近くの町まで行ける。",
  "tgt": "{框06}{立绘C240}「从这里的话‥\n步行能到附近的镇子。"
 },
 {
  "id": "007470",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框05}{立绘4100}「そこで、部品が\n手に入れば‥\n---\n砂船を 動かせるように\nなりますね。",
  "tgt": "{框05}{立绘4100}「若能在那里\n找到零件…\n---\n沙船\n就能动起来了呢。"
 },
 {
  "id": "007471",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框06}{立绘4200}「ああ、だが‥",
  "tgt": "{框06}{立绘4200}「嗯，可是…"
 },
 {
  "id": "007472",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框06}{立绘C240}「こんな所に、砂船を\n放り出しておくと‥\n---\n盗賊どもに、狙われる\n恐れがある‥",
  "tgt": "{框06}{立绘C240}「把砂船\n丢在这种地方‥\n---\n恐怕会被盗贼们\n盯上的‥"
 },
 {
  "id": "007473",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框06}{立绘C240}「町で、部品を手に入れて\n戻ってきても‥\n---\n盗賊に やられて\n船が、跡形もなくなっていたら\n話にならない‥",
  "tgt": "{框06}{立绘C240}「就算去镇上买了零件\n回来‥\n---\n要是船被盗贼\n拆得连影子都不剩\n就完了‥"
 },
 {
  "id": "007474",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框05}{立绘4100}「{队员02}兄さま‥\nわたしが、行ってきます。",
  "tgt": "{框05}{立绘4100}「{队员02}兄长…\n我去去就来。"
 },
 {
  "id": "007475",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框05}{立绘4100}「わたし、砂船の部品を\n探してきます。\n---\nひとりで、だいじょうぶです\n兄さま‥！",
  "tgt": "{框05}{立绘4100}「我去找\n沙船的零件。\n---\n一个人\n没问题的\n兄长…！"
 },
 {
  "id": "007476",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框06}{立绘8040}「しかし‥、{队员01}‥",
  "tgt": "{框06}{立绘8040}「可是‥、{队员01}‥"
 },
 {
  "id": "007477",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框05}{立绘4100}「いつまでも、兄さまに\n賴ってばかりじゃ‥\n---\n{立绘0101}姉さまに、笑われます。",
  "tgt": "{框05}{立绘4100}「总不能\n事事依赖兄长…\n---\n{立绘0101}会被姐姐\n笑话的。"
 },
 {
  "id": "007478",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框06}{立绘C240}「分かった、{码0B}{队员01}‥\nそうだな‥",
  "tgt": "{框06}{立绘C240}「明白了，{码0B}{队员01}‥\n也是啊‥"
 },
 {
  "id": "007479",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{立绘C240}「{队员01}‥\n---\nここから、南に少し下ると\n{色02}サライ{/色}という町が\nあるんだ‥",
  "tgt": "{立绘C240}「{队员01}…\n---\n从这里往南\n下去一点\n有个叫{色02}萨莱{/色}的镇…"
 },
 {
  "id": "007480",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{立绘C240}「そこで、砂船の部品が\n手に入るかもしれない‥",
  "tgt": "{立绘C240}「在那里，说不定\n能买到砂船的零件‥"
 },
 {
  "id": "007481",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{立绘C240}「賴んだぞ、{队员01}。",
  "tgt": "{立绘C240}「拜托了，{队员01}。"
 },
 {
  "id": "007482",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框05}{立绘0201}「はい、兄さま！",
  "tgt": "{框05}{立绘0201}「是，兄长大人！"
 },
 {
  "id": "007483",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{立绘C240}「これを、持って行くといい\n『{道具0101}』だ‥\n---\n何か、めんどうがあった時に\n役立つかもしれない‥",
  "tgt": "{立绘C240}「把这个带上吧\n是『{道具0101}』‥\n---\n遇到麻烦时\n说不定能派上用场‥"
 },
 {
  "id": "007484",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框05}{立绘4100}「では、行ってきます\n{队员02}兄さま。",
  "tgt": "{框05}{立绘4100}「那么，我出发了\n{队员02}兄长。"
 },
 {
  "id": "007485",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{立绘C240}「気をつけてな、{队员01}‥\n---\n信じている‥。",
  "tgt": "{立绘C240}「多保重，{队员01}‥\n---\n我相信你‥。"
 },
 {
  "id": "007486",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{立绘4200}「{色02}サライ{/色}の町は\n南の、ガケ道を\nこえた所だ‥\n---\n気をつけてな、{队员01}。",
  "tgt": "{立绘4200}「{色02}萨莱{/色}镇\n在南边崖道\n的那头…\n---\n路上小心，{队员01}。"
 },
 {
  "id": "007487",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{立绘4100}「兄さまっ！",
  "tgt": "{立绘4100}「兄长！"
 },
 {
  "id": "007488",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框05}{立绘4200}「{队员01}‥、{码0B}よかった‥！\n---\n何かあったかと‥\n心配した‥{码0B}‥！",
  "tgt": "{框05}{立绘4200}「{队员01}…，{码0B}太好了…！\n---\n我还担心\n出了事…{码0B}…！"
 },
 {
  "id": "007489",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框06}{立绘8341}「ごめんなさい\n{队员02}兄さま‥！\n---\nわたし‥{码0B}‥",
  "tgt": "{框06}{立绘8341}「对不起\n{队员02}兄长大人‥！\n---\n我‥‥{码0B}‥"
 },
 {
  "id": "007490",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框06}{立绘C140}「そうだ、兄さま\nえーとですね‥\n---\n{队员00}さんと\n{队员05}さんです‥",
  "tgt": "{框06}{立绘C140}「对了，兄长\n那个是…\n---\n{队员00}先生和\n{队员05}先生…"
 },
 {
  "id": "007491",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框05}{立绘0000}「‥{码0B}‥ふーむ？\n---\n{立绘4200}「ともかく、{码0B}そうだな\n話を 闻かせてもらおう。",
  "tgt": "{框05}{立绘0000}「…{码0B}…唔嗯？\n---\n{立绘4200}「总之，{码0B}好啊\n说来听听。"
 },
 {
  "id": "007492",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{立绘4200}「そうか‥{码0B}‥",
  "tgt": "{立绘4200}「这样啊…{码0B}…"
 },
 {
  "id": "007493",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框06}{立绘0401}「わたし‥、{码0B}けっきょく‥\n---\n砂船の部品も\n手に入れられなかったし‥\n---\n{队员00}さんや\n{队员05}さんに‥\n---\nいろいろ、助けてもらって‥",
  "tgt": "{框06}{立绘0401}「我…，{码0B}结果…\n---\n沙船的零件\n也没找到…\n---\n还受了{队员00}先生\n和{队员05}先生\n---\n那么多帮助…"
 },
 {
  "id": "007494",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{立绘4200}「部品のことは、{码0B}いい。\n---\n{队员01}が、無事に\n戻ったのが 何よりだ‥",
  "tgt": "{立绘4200}「零件的事，{码0B}算了。\n---\n{队员01}平安\n回来就好…"
 },
 {
  "id": "007495",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{立绘4200}「{队员01}を‥\n---\nひとりで 行かせた\n俺が、悪かったのだ‥",
  "tgt": "{立绘4200}「让{队员01}\n---\n独自前往\n是我的不对…"
 },
 {
  "id": "007496",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框06}{立绘0501}「兄さま‥{码0B}‥",
  "tgt": "{框06}{立绘0501}「兄长大人‥‥{码0B}‥"
 },
 {
  "id": "007497",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框06}{立绘C540}「この、砂の船は‥\n---\n砂漠の{色02}竜{/色}が出てきて\n壊されたのだろう、と‥\n---\n{队员05}、言ってますよ。",
  "tgt": "{框06}{立绘C540}「这艘沙船…\n---\n是沙漠的{色02}龙{/色}\n出来弄坏的…\n---\n{队员05}是这么说的哟。"
 },
 {
  "id": "007498",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{立绘0000}「その通りだが‥\n---\nなぜ、そんな事が\n分かるのだ‥！？",
  "tgt": "{立绘0000}「说得没错…\n---\n可你怎么\n会知道…！？"
 },
 {
  "id": "007499",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框06}{立绘C540}「{队员05}には\nそう言う事が、分かる\nようなのですよ‥",
  "tgt": "{框06}{立绘C540}「{队员05}似乎\n能懂得\n这种事哦‥"
 },
 {
  "id": "007500",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框06}{立绘C540}「{队员05}が、もう\nおネムですよ‥",
  "tgt": "{框06}{立绘C540}「{队员05}已经\n困了哦‥"
 },
 {
  "id": "007501",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{立绘4200}「すまない、{码0B}お疲れでしたな。",
  "tgt": "{立绘4200}「抱歉，{码0B}辛苦你们了。"
 },
 {
  "id": "007502",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{立绘4200}「ともかく‥ お二方には\n今一度、礼を言わせてもらう。\n---\n今晚は‥、不自由を\nおかけするが‥\nここで、お休み下さい。",
  "tgt": "{立绘4200}「总之…让二位\n容我再度致谢。\n---\n今晚…条件简陋\n就在这里\n休息吧。"
 },
 {
  "id": "007503",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "その夜、わたしは夢を見ました。",
  "tgt": "那晚，我做了一个梦。"
 },
 {
  "id": "007504",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{立绘0000}「夢‥！？",
  "tgt": "{立绘0000}「梦…！？"
 },
 {
  "id": "007505",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框05}{立绘4100}「わたしと、兄さまと‥\n{队员00}さんが‥",
  "tgt": "{框05}{立绘4100}「我和兄长…\n{队员00}先生…"
 },
 {
  "id": "007506",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框04}{立绘C200}「‥{码0B}‥エリーナを 助けに\n行く夢、{码0B}か？",
  "tgt": "{框04}{立绘C200}「…{码0B}…去救艾莉娜的\n梦，{码0B}吗？"
 },
 {
  "id": "007507",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框05}{立绘4100}「じゃ、兄さまも\n同じ夢を‥！？",
  "tgt": "{框05}{立绘4100}「那，兄长也做了\n同样的梦…！？"
 },
 {
  "id": "007508",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框04}{立绘C540}「それは、{队员00}の\n見た夢だって‥\n---\n{队员05}、言ってます。",
  "tgt": "{框04}{立绘C540}「那是{队员00}\n做的梦…\n---\n{队员05}是这么说的。"
 },
 {
  "id": "007509",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框06}{立绘C100}「{队员05}さん‥\nそれって、一体‥？",
  "tgt": "{框06}{立绘C100}「{队员05}先生…\n那到底是…？"
 },
 {
  "id": "007510",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框04}{立绘0602}「{色02}竜眼{/色}の見た\n時の向こう‥\n---\nそうなるかも知れない\n未来‥、{码0B}だそうですよ。",
  "tgt": "{框04}{立绘0602}「{色02}龙眼{/色}所见的\n时间彼端…\n---\n或许会那样的\n未来…，{码0B}是这么说的哟。"
 },
 {
  "id": "007511",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框06}{立绘8741}「それは、あのう‥\nつまり‥‥？",
  "tgt": "{框06}{立绘8741}「那究竟是，那个‥\n也就是说‥‥？"
 },
 {
  "id": "007512",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框06}{立绘C200}「つまり‥、彼を\n連れて行けば‥\n---\n夢で見た、あの場所に‥\n---\nエリーナが、いるかもしれない\nあの場所に‥\n---\n行けると言うことなのか！？",
  "tgt": "{框06}{立绘C200}「也就是说…带上他…\n---\n就能去梦里见的\n那个地方…\n---\n艾莉娜可能在的\n那个地方…\n---\n是这意思吗！？"
 },
 {
  "id": "007513",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框04}{立绘0602}「そのようです。",
  "tgt": "{框04}{立绘0602}「是的。"
 },
 {
  "id": "007514",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框03}{立绘C200}「夢の、おつげだろうと\n何だろうと‥\n---\n俺は、見たものを\n信じたい‥",
  "tgt": "{框03}{立绘C200}「不管是梦的\n启示还是什么…\n---\n我只信\n亲眼所见…"
 },
 {
  "id": "007515",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框02}{立绘C140}「これまで、姉さまの\n手がかり‥\n---\n何も、無いみたいな\nものでしたけど‥",
  "tgt": "{框02}{立绘C140}「在此之前，姐姐大人的\n线索‥\n---\n几乎什么\n都没有‥"
 },
 {
  "id": "007516",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框02}{立绘4100}「今、ちょっと\n姉さまに 近づいてる\n気がします‥\n---\n{立绘0201}{队员00}さんの\nおかげ‥、なんですよね？",
  "tgt": "{框02}{立绘4100}「现在感觉\n离姐姐\n近了一点…\n---\n{立绘0201}都是托了\n{队员00}先生的福…对吧？"
 },
 {
  "id": "007517",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框04}{立绘C540}「{队员05}は‥\n---\n{队员00}の 行くところに\n行くと、言ってます。",
  "tgt": "{框04}{立绘C540}「{队员05}…\n---\n说要去\n{队员00}所去之处。"
 },
 {
  "id": "007518",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "{框03}{立绘4200}「では、出発しよう。\n---\n砂船が、使えないので\n砂漠を 回りこんで\n海岸ぞいに、北上する‥",
  "tgt": "{框03}{立绘4200}「那么，出发。\n---\n沙船没法用\n绕过大沙漠\n沿海岸北上…"
 },
 {
  "id": "007519",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "「捨ててある 砂船なら‥\nおれら盗賊も\n---\nどうどうと、パーツを\nいただけるってもんだ！",
  "tgt": "「如果是被丢弃的砂船‥\n我们盗贼也能\n---\n堂堂正正地\n收下零件嘛！"
 },
 {
  "id": "007520",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "「壊れて 捨てられた\n砂船も‥\n---\nオレたち 盗賊には\n{色03}お宝{/色}なのさ。",
  "tgt": "「就算是坏掉\n丢弃的砂船‥\n---\n对我们盗贼来说\n也是宝贝。{色03}お宝{/色}なのさ。"
 },
 {
  "id": "007521",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "「いいなあ、それ\nひょっとして\n{色03}{占位00}{/色}かい‥？\n---\nおくれ！{码0B}{码0B}‥とはいわん\nオレの{色03}お宝{/色}と\n取り替えておくれ！{码14000C92}取り替えよう！\nやめておこう‥",
  "tgt": "「真好啊，那东西\n该不会是\n{色03}{占位00}{/色}吧…？\n---\n开玩笑！{码0B}{码0B}…才怪\n拿我的{色03}宝贝{/色}\n跟你换换！{码14000C92}交换吧！\n算了…"
 },
 {
  "id": "007522",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "\n {色03}{占位01}{/色}と 取り替えた！\n---\n",
  "tgt": "\n换成了{色03}{占位01}{/色}！\n---\n"
 },
 {
  "id": "007523",
  "file": "WORLD/AREAE016.EMI",
  "seg": 8,
  "src": "そのお宝は、盗んだり\nした物じゃないよ。",
  "tgt": "那宝贝可不是\n偷来的东西哦。"
 },
 {
  "id": "007524",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "すなぶねついらく",
  "tgt": "砂船坠落"
 },
 {
  "id": "007525",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「ダメだ‥\n砂をかんでる‥‥",
  "tgt": "{框06}{立绘C240}「不行了‥\n陷进沙里了‥‥"
 },
 {
  "id": "007526",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「部品を かえないと‥\n---\n修理するのは、むりだな。",
  "tgt": "{框06}{立绘C240}「不更换零件‥\n---\n是没法修好的。"
 },
 {
  "id": "007527",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「あの竜‥\n---\nわたし達を‥\nおそってきたんでしょうか？",
  "tgt": "{框05}{立绘4100}「那条龙…\n---\n是想袭击\n我们吗？"
 },
 {
  "id": "007528",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「分からん‥\n---\nあの後は‥\n出てくる様子も無いし。",
  "tgt": "{框06}{立绘8040}「不知道‥\n---\n那之后‥\n也没有再出来的迹象。"
 },
 {
  "id": "007529",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框06}{立绘4240}「まあ、いずれにせよ‥\n---\n砂漠のはしで 落ちたのは\n助かったな。",
  "tgt": "{框06}{立绘4240}「罢了，无论如何‥\n---\n在沙漠边上坠机\n已是不幸中的万幸。"
 },
 {
  "id": "007530",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「ここからなら‥\n步いて、近くの町まで行ける。",
  "tgt": "{框06}{立绘C240}「从这里的话‥\n步行能到附近的镇子。"
 },
 {
  "id": "007531",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「そこで、部品が\n手に入れば‥\n---\n砂船を 動かせるように\nなりますね。",
  "tgt": "{框05}{立绘4100}「若能在那里\n找到零件…\n---\n沙船\n就能动起来了呢。"
 },
 {
  "id": "007532",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框06}{立绘4200}「ああ、だが‥",
  "tgt": "{框06}{立绘4200}「嗯，可是…"
 },
 {
  "id": "007533",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「こんな所に、砂船を\n放り出しておくと‥\n---\n盗賊どもに、狙われる\n恐れがある‥",
  "tgt": "{框06}{立绘C240}「把砂船\n丢在这种地方‥\n---\n恐怕会被盗贼们\n盯上的‥"
 },
 {
  "id": "007534",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「町で、部品を手に入れて\n戻ってきても‥\n---\n盗賊に やられて\n船が、跡形もなくなっていたら\n話にならない‥",
  "tgt": "{框06}{立绘C240}「就算去镇上买了零件\n回来‥\n---\n要是船被盗贼\n拆得连影子都不剩\n就完了‥"
 },
 {
  "id": "007535",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「{队员02}兄さま‥\nわたしが、行ってきます。",
  "tgt": "{框05}{立绘4100}「{队员02}兄长…\n我去去就来。"
 },
 {
  "id": "007536",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「わたし、砂船の部品を\n探してきます。\n---\nひとりで、だいじょうぶです\n兄さま‥！",
  "tgt": "{框05}{立绘4100}「我去找\n沙船的零件。\n---\n一个人\n没问题的\n兄长…！"
 },
 {
  "id": "007537",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「しかし‥、{队员01}‥",
  "tgt": "{框06}{立绘8040}「可是‥、{队员01}‥"
 },
 {
  "id": "007538",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「いつまでも、兄さまに\n賴ってばかりじゃ‥\n---\n{立绘0101}姉さまに、笑われます。",
  "tgt": "{框05}{立绘4100}「总不能\n事事依赖兄长…\n---\n{立绘0101}会被姐姐\n笑话的。"
 },
 {
  "id": "007539",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「分かった、{码0B}{队员01}‥\nそうだな‥",
  "tgt": "{框06}{立绘C240}「明白了，{码0B}{队员01}‥\n也是啊‥"
 },
 {
  "id": "007540",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{立绘C240}「{队员01}‥\n---\nここから、南に少し下ると\n{色02}サライ{/色}という町が\nあるんだ‥",
  "tgt": "{立绘C240}「{队员01}…\n---\n从这里往南\n下去一点\n有个叫{色02}萨莱{/色}的镇…"
 },
 {
  "id": "007541",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{立绘C240}「そこで、砂船の部品が\n手に入るかもしれない‥",
  "tgt": "{立绘C240}「在那里，说不定\n能买到砂船的零件‥"
 },
 {
  "id": "007542",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{立绘C240}「賴んだぞ、{队员01}。",
  "tgt": "{立绘C240}「拜托了，{队员01}。"
 },
 {
  "id": "007543",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框05}{立绘0201}「はい、兄さま！",
  "tgt": "{框05}{立绘0201}「是，兄长大人！"
 },
 {
  "id": "007544",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{立绘C240}「これを、持って行くといい\n『{道具0101}』だ‥\n---\n何か、めんどうがあった時に\n役立つかもしれない‥",
  "tgt": "{立绘C240}「把这个带上吧\n是『{道具0101}』‥\n---\n遇到麻烦时\n说不定能派上用场‥"
 },
 {
  "id": "007545",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「では、行ってきます\n{队员02}兄さま。",
  "tgt": "{框05}{立绘4100}「那么，我出发了\n{队员02}兄长。"
 },
 {
  "id": "007546",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{立绘C240}「気をつけてな、{队员01}‥\n---\n信じている‥。",
  "tgt": "{立绘C240}「多保重，{队员01}‥\n---\n我相信你‥。"
 },
 {
  "id": "007547",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{立绘4200}「{色02}サライ{/色}の町は\n南の、ガケ道を\nこえた所だ‥\n---\n気をつけてな、{队员01}。",
  "tgt": "{立绘4200}「{色02}萨莱{/色}镇\n在南边崖道\n的那头…\n---\n路上小心，{队员01}。"
 },
 {
  "id": "007548",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{立绘4100}「兄さまっ！",
  "tgt": "{立绘4100}「兄长！"
 },
 {
  "id": "007549",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框05}{立绘4200}「{队员01}‥、{码0B}よかった‥！\n---\n何かあったかと‥\n心配した‥{码0B}‥！",
  "tgt": "{框05}{立绘4200}「{队员01}…，{码0B}太好了…！\n---\n我还担心\n出了事…{码0B}…！"
 },
 {
  "id": "007550",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框06}{立绘8341}「ごめんなさい\n{队员02}兄さま‥！\n---\nわたし‥{码0B}‥",
  "tgt": "{框06}{立绘8341}「对不起\n{队员02}兄长大人‥！\n---\n我‥‥{码0B}‥"
 },
 {
  "id": "007551",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「そうだ、兄さま\nえーとですね‥\n---\n{队员00}さんと\n{队员05}さんです‥",
  "tgt": "{框06}{立绘C140}「对了，兄长\n那个是…\n---\n{队员00}先生和\n{队员05}先生…"
 },
 {
  "id": "007552",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「‥{码0B}‥ふーむ？\n---\n{立绘4200}「ともかく、{码0B}そうだな\n話を 闻かせてもらおう。",
  "tgt": "{框05}{立绘0000}「…{码0B}…唔嗯？\n---\n{立绘4200}「总之，{码0B}好啊\n说来听听。"
 },
 {
  "id": "007553",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{立绘4200}「そうか‥{码0B}‥",
  "tgt": "{立绘4200}「这样啊…{码0B}…"
 },
 {
  "id": "007554",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框06}{立绘0401}「わたし‥、{码0B}けっきょく‥\n---\n砂船の部品も\n手に入れられなかったし‥\n---\n{队员00}さんや\n{队员05}さんに‥\n---\nいろいろ、助けてもらって‥",
  "tgt": "{框06}{立绘0401}「我…，{码0B}结果…\n---\n沙船的零件\n也没找到…\n---\n还受了{队员00}先生\n和{队员05}先生\n---\n那么多帮助…"
 },
 {
  "id": "007555",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{立绘4200}「部品のことは、{码0B}いい。\n---\n{队员01}が、無事に\n戻ったのが 何よりだ‥",
  "tgt": "{立绘4200}「零件的事，{码0B}算了。\n---\n{队员01}平安\n回来就好…"
 },
 {
  "id": "007556",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{立绘4200}「{队员01}を‥\n---\nひとりで 行かせた\n俺が、悪かったのだ‥",
  "tgt": "{立绘4200}「让{队员01}\n---\n独自前往\n是我的不对…"
 },
 {
  "id": "007557",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框06}{立绘0501}「兄さま‥{码0B}‥",
  "tgt": "{框06}{立绘0501}「兄长大人‥‥{码0B}‥"
 },
 {
  "id": "007558",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框06}{立绘C540}「この、砂の船は‥\n---\n砂漠の{色02}竜{/色}が出てきて\n壊されたのだろう、と‥\n---\n{队员05}、言ってますよ。",
  "tgt": "{框06}{立绘C540}「这艘沙船…\n---\n是沙漠的{色02}龙{/色}\n出来弄坏的…\n---\n{队员05}是这么说的哟。"
 },
 {
  "id": "007559",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{立绘0000}「その通りだが‥\n---\nなぜ、そんな事が\n分かるのだ‥！？",
  "tgt": "{立绘0000}「说得没错…\n---\n可你怎么\n会知道…！？"
 },
 {
  "id": "007560",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框06}{立绘C540}「{队员05}には\nそう言う事が、分かる\nようなのですよ‥",
  "tgt": "{框06}{立绘C540}「{队员05}似乎\n能懂得\n这种事哦‥"
 },
 {
  "id": "007561",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框06}{立绘C540}「{队员05}が、もう\nおネムですよ‥",
  "tgt": "{框06}{立绘C540}「{队员05}已经\n困了哦‥"
 },
 {
  "id": "007562",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{立绘4200}「すまない、{码0B}お疲れでしたな。",
  "tgt": "{立绘4200}「抱歉，{码0B}辛苦你们了。"
 },
 {
  "id": "007563",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{立绘4200}「ともかく‥ お二方には\n今一度、礼を言わせてもらう。\n---\n今晚は‥、不自由を\nおかけするが‥\nここで、お休み下さい。",
  "tgt": "{立绘4200}「总之…让二位\n容我再度致谢。\n---\n今晚…条件简陋\n就在这里\n休息吧。"
 },
 {
  "id": "007564",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "その夜、わたしは夢を見ました。",
  "tgt": "那晚，我做了一个梦。"
 },
 {
  "id": "007565",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{立绘0000}「夢‥！？",
  "tgt": "{立绘0000}「梦…！？"
 },
 {
  "id": "007566",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「わたしと、兄さまと‥\n{队员00}さんが‥",
  "tgt": "{框05}{立绘4100}「我和兄长…\n{队员00}先生…"
 },
 {
  "id": "007567",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框04}{立绘C200}「‥{码0B}‥エリーナを 助けに\n行く夢、{码0B}か？",
  "tgt": "{框04}{立绘C200}「…{码0B}…去救艾莉娜的\n梦，{码0B}吗？"
 },
 {
  "id": "007568",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「じゃ、兄さまも\n同じ夢を‥！？",
  "tgt": "{框05}{立绘4100}「那，兄长也做了\n同样的梦…！？"
 },
 {
  "id": "007569",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框04}{立绘C540}「それは、{队员00}の\n見た夢だって‥\n---\n{队员05}、言ってます。",
  "tgt": "{框04}{立绘C540}「那是{队员00}\n做的梦…\n---\n{队员05}是这么说的。"
 },
 {
  "id": "007570",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框06}{立绘C100}「{队员05}さん‥\nそれって、一体‥？",
  "tgt": "{框06}{立绘C100}「{队员05}先生…\n那到底是…？"
 },
 {
  "id": "007571",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框04}{立绘0602}「{色02}竜眼{/色}の見た\n時の向こう‥\n---\nそうなるかも知れない\n未来‥、{码0B}だそうですよ。",
  "tgt": "{框04}{立绘0602}「{色02}龙眼{/色}所见的\n时间彼端…\n---\n或许会那样的\n未来…，{码0B}是这么说的哟。"
 },
 {
  "id": "007572",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框06}{立绘8741}「それは、あのう‥\nつまり‥‥？",
  "tgt": "{框06}{立绘8741}「那究竟是，那个‥\n也就是说‥‥？"
 },
 {
  "id": "007573",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框06}{立绘C200}「つまり‥、彼を\n連れて行けば‥\n---\n夢で見た、あの場所に‥\n---\nエリーナが、いるかもしれない\nあの場所に‥\n---\n行けると言うことなのか！？",
  "tgt": "{框06}{立绘C200}「也就是说…带上他…\n---\n就能去梦里见的\n那个地方…\n---\n艾莉娜可能在的\n那个地方…\n---\n是这意思吗！？"
 },
 {
  "id": "007574",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框04}{立绘0602}「そのようです。",
  "tgt": "{框04}{立绘0602}「是的。"
 },
 {
  "id": "007575",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框03}{立绘C200}「夢の、おつげだろうと\n何だろうと‥\n---\n俺は、見たものを\n信じたい‥",
  "tgt": "{框03}{立绘C200}「不管是梦的\n启示还是什么…\n---\n我只信\n亲眼所见…"
 },
 {
  "id": "007576",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框02}{立绘C140}「これまで、姉さまの\n手がかり‥\n---\n何も、無いみたいな\nものでしたけど‥",
  "tgt": "{框02}{立绘C140}「在此之前，姐姐大人的\n线索‥\n---\n几乎什么\n都没有‥"
 },
 {
  "id": "007577",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框02}{立绘4100}「今、ちょっと\n姉さまに 近づいてる\n気がします‥\n---\n{立绘0201}{队员00}さんの\nおかげ‥、なんですよね？",
  "tgt": "{框02}{立绘4100}「现在感觉\n离姐姐\n近了一点…\n---\n{立绘0201}都是托了\n{队员00}先生的福…对吧？"
 },
 {
  "id": "007578",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框04}{立绘C540}「{队员05}は‥\n---\n{队员00}の 行くところに\n行くと、言ってます。",
  "tgt": "{框04}{立绘C540}「{队员05}…\n---\n说要去\n{队员00}所去之处。"
 },
 {
  "id": "007579",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "{框03}{立绘4200}「では、出発しよう。\n---\n砂船が、使えないので\n砂漠を 回りこんで\n海岸ぞいに、北上する‥",
  "tgt": "{框03}{立绘4200}「那么，出发。\n---\n沙船没法用\n绕过大沙漠\n沿海岸北上…"
 },
 {
  "id": "007580",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "「捨ててある 砂船なら‥\nおれら盗賊も\n---\nどうどうと、パーツを\nいただけるってもんだ！",
  "tgt": "「如果是被丢弃的砂船‥\n我们盗贼也能\n---\n堂堂正正地\n收下零件嘛！"
 },
 {
  "id": "007581",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "「壊れて 捨てられた\n砂船も‥\n---\nオレたち 盗賊には\n{色03}お宝{/色}なのさ。",
  "tgt": "「就算是坏掉\n丢弃的砂船‥\n---\n对我们盗贼来说\n也是宝贝。{色03}お宝{/色}なのさ。"
 },
 {
  "id": "007582",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "「いいなあ、それ\nひょっとして\n{色03}{占位00}{/色}かい‥？\n---\nおくれ！{码0B}{码0B}‥とはいわん\nオレの{色03}お宝{/色}と\n取り替えておくれ！{码14000C92}取り替えよう！\nやめておこう‥",
  "tgt": "「真好啊，那东西\n该不会是\n{色03}{占位00}{/色}吧…？\n---\n开玩笑！{码0B}{码0B}…才怪\n拿我的{色03}宝贝{/色}\n跟你换换！{码14000C92}交换吧！\n算了…"
 },
 {
  "id": "007583",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "\n {色03}{占位01}{/色}と 取り替えた！\n---\n",
  "tgt": "\n换成了{色03}{占位01}{/色}！\n---\n"
 },
 {
  "id": "007584",
  "file": "WORLD/AREAE017.EMI",
  "seg": 11,
  "src": "そのお宝は、盗んだり\nした物じゃないよ。",
  "tgt": "那宝贝可不是\n偷来的东西哦。"
 },
 {
  "id": "007585",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "きゃんぷよるいべんと\nM046 M047",
  "tgt": "营地夜晚事件\nM046M047"
 },
 {
  "id": "007586",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4200}「まず、ウインディアの\n城の地下で\n{色03}{道具0705}{/色}を 見つけて‥\n---\n次に、それを使って\n{色02}風の塔{/色}に\n入るんだったな‥",
  "tgt": "{立绘4200}「先在温迪亚\n城的地下\n找到{色03}{道具0705}{/色}…\n---\n然后用它\n进入{色02}风之塔{/色}\n没错…"
 },
 {
  "id": "007587",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘C140}「ええ‥\n---\n風の塔には、空高く\n上がるための 装置が\nあるんです。\n---\nその装置を 使えば\nラーウィ様に‥",
  "tgt": "{立绘C140}「嗯‥\n---\n风之塔里，有能\n升上高空的\n装置。\n---\n用那装置就能\n见到拉维大人‥"
 },
 {
  "id": "007588",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘C140}「あれ‥、ところで\n{队员03}さんは？",
  "tgt": "{立绘C140}「咦‥，话说\n{队员03}先生呢？"
 },
 {
  "id": "007589",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘8000}「あいつは‥\nルディアに、やとわれた\n見張りだ‥\n---\n俺達のことを、報せに\n行ったのかも しれない！？",
  "tgt": "{立绘8000}「那家伙…\n是卢迪亚雇的\n眼线…\n---\n说不定是去\n通风报信了！？"
 },
 {
  "id": "007590",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘8141}「そんな‥‥",
  "tgt": "{立绘8141}「怎么会‥‥"
 },
 {
  "id": "007591",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4200}「ともかく‥\n急いだほうが、良さそうだ。",
  "tgt": "{立绘4200}「总之…\n还是抓紧为妙。"
 },
 {
  "id": "007592",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4100}「{队员00}‥\nわたし達、ここで\n待ってます‥\n---\n気をつけて\n行ってきてくださいね。",
  "tgt": "{立绘4100}「{队员00}…\n我们在这里\n等着你…\n---\n路上小心\n早去早回哦。"
 },
 {
  "id": "007593",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘0101}「{队员00}！？",
  "tgt": "{立绘0101}「{队员00}！？"
 },
 {
  "id": "007594",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4500}「竜眼で オームを\nコントロール できますが‥\n---\nなれるまでは\n大変だろうって\n{队员05}、言ってます。",
  "tgt": "{立绘4500}「可以用龙眼\n操控巨鸟…\n---\n但熟练之前\n会很费劲\n{队员05}是这么说的。"
 },
 {
  "id": "007595",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘0101}「でも‥\n---\n步いて探すには\n黄金平野は 大きすぎます‥\n---\n今は、なんとか\n{队员00}に\nがんばってもらうしか‥",
  "tgt": "{立绘0101}「可是…\n---\n步行去找的话\n黄金平原太大了…\n---\n现在只能\n拜托{队员00}\n加油了…"
 },
 {
  "id": "007596",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘0201}「‥{队员00}\nお願いしますね。",
  "tgt": "{立绘0201}「…{队员00}\n拜托了。"
 },
 {
  "id": "007597",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4300}「なぜ‥\n---\n何の得にも\nならない事を‥？",
  "tgt": "{立绘4300}「为什么…\n---\n去管毫无\n好处的事…？"
 },
 {
  "id": "007598",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4300}「そ‥、それで‥\n---\nうまく行くか、どうか‥\n---\n分から‥ないのに！？",
  "tgt": "{立绘4300}「而…、而且…\n---\n成不成…\n---\n都还不…知道！？"
 },
 {
  "id": "007599",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘C140}「得‥、は たしかに\n{立绘8241}ないのかも しれないですね‥",
  "tgt": "{立绘C140}「呃‥，确实\n{立绘8241}或许是没有呢‥"
 },
 {
  "id": "007600",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘C140}「それと‥\n---\nうまく行かないかも\nしれないから‥\n---\n何も しないって言うのは‥",
  "tgt": "{立绘C140}「还有‥\n---\n也许会\n不顺利‥\n---\n所以什么都不做‥"
 },
 {
  "id": "007601",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘C140}「よくないって‥\n---\n{立绘8341}そんな気がします。",
  "tgt": "{立绘C140}「总觉得‥\n---\n{立绘8341}不太妥当。"
 },
 {
  "id": "007602",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘C140}「{队员00}‥\n---\nもうすぐ\n{色02}ウインディア{/色}です。",
  "tgt": "{立绘C140}「{队员00}…\n---\n马上就到\n{色02}温迪亚{/色}了。"
 },
 {
  "id": "007603",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘C140}「私や エリーナ姉様は\nウインディアのお城で\n生まれ そだったんです‥",
  "tgt": "{立绘C140}「我和艾莉娜姐姐\n是在温迪亚的城里\n出生长大的‥"
 },
 {
  "id": "007604",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4200}「すまん、{队员01}‥\n---\nエリーナを\n見つけられないまま\n---\n逃げ归るようなコトに\nなってしまって‥",
  "tgt": "{立绘4200}「抱歉，{队员01}…\n---\n没能找到艾莉娜\n---\n却成了\n落荒而逃…"
 },
 {
  "id": "007605",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘8141}「‥{队员02}兄様が\nまた ルディアに捕まったら\n---\n今度こそ姉様を\n探せなくなってしまいます。",
  "tgt": "{立绘8141}「‥{队员02}哥哥要是\n再被卢迪亚抓住\n---\n就真的再也无法\n寻找姐姐了。"
 },
 {
  "id": "007606",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4200}「‥そうだな\n---\nウインディアに戻れば\n何か、新しい手がかりが\n見つかる 可能性もあるか。",
  "tgt": "{立绘4200}「…也是\n---\n回温迪亚的话\n或许还能找到\n新的线索。"
 },
 {
  "id": "007607",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘0402}「やっと 見つけたよう！",
  "tgt": "{立绘0402}「总算找到了哟！"
 },
 {
  "id": "007608",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘0402}「助けてよう、竜のヒト！\n---\nアタシたち 夢の世界に\nもどれたけど‥",
  "tgt": "{立绘0402}「救救我们哟，龙人！\n---\n我们虽然回到了\n梦的世界‥"
 },
 {
  "id": "007609",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘0402}「夢の世界に来て\n教えてよう‥！{码14000C12}教えてあげる\n教えてあげない",
  "tgt": "{立绘0402}「都到梦的世界了\n就教我吧哟…！{码14000C12}教给你\n不教"
 },
 {
  "id": "007610",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘0502}「そりゃ あんまりだよう\n---\nイジワルしないで\n教えてよう‥！{码14000C12}教えてあげる\n教えてあげない",
  "tgt": "{立绘0502}「那也太狠了哟\n---\n别使坏\n教给我哟…！{码14000C12}教给你\n不教"
 },
 {
  "id": "007611",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘0502}「ヒドイよう、せつないよう\n---\nそんなこと いわずに\n教えてよう‥！{码14000C12}教えてあげる\n教えてあげない",
  "tgt": "{立绘0502}「好过分哟，好难过哟\n---\n别说那种话\n教给我哟…！{码14000C12}教给你\n不教"
 },
 {
  "id": "007612",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘0602}「オニだよう、アクマだよう\n---\nおねがいだから\n教えてよう‥！{码14000C12}教えてあげる\n教えてあげない",
  "tgt": "{立绘0602}「是鬼哟，是魔哟\n---\n求求你\n教给我哟…！{码14000C12}教给你\n不教"
 },
 {
  "id": "007613",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘0702}「ほんと？\n---\nうれしいよう\nおねがいよう。",
  "tgt": "{立绘0702}「真的？\n---\n好高兴哟\n拜托了哟。"
 },
 {
  "id": "007614",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘0502}くらしかたが\nわかんないのよう‥！",
  "tgt": "{立绘0502}不知道\n怎么生活嘛‥！"
 },
 {
  "id": "007615",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4300}「‥{码0B}‥{码0B}‥",
  "tgt": "{立绘4300}「…{码0B}…{码0B}…"
 },
 {
  "id": "007616",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4500}「{队员05}だったら\nもっと 上手に\nオームに乘るって‥\n---\n{队员05}、言ってます。",
  "tgt": "{立绘4500}「{队员05}说\n换他来的话\n巨鸟骑得更好…\n---\n{队员05}是这么说的。"
 },
 {
  "id": "007617",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4100}「フーレンの里に\n戻って‥\n---\n長老さんたちに\n会いましょう。",
  "tgt": "{立绘4100}「回弗雷恩村…\n---\n去见\n长老们吧。"
 },
 {
  "id": "007618",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4100}「{道具0101}を\nもうひとつ‥？",
  "tgt": "{立绘4100}「{道具0101}\n再来一把…？"
 },
 {
  "id": "007619",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4100}「それで 兄さまへの\nおとがめを‥\n---\n少し、かるくできるかも\n知れないんですね‥！\n---\nありがとう、{队员00}！",
  "tgt": "{立绘4100}「这样兄长的\n处罚…\n---\n说不定就能\n减轻一点呢…！\n---\n谢谢你，{队员00}！"
 },
 {
  "id": "007620",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4100}「{色02}グーの火山{/色}の場所は\nフーレンの誰かが\n知ってるでしょうね‥",
  "tgt": "{立绘4100}「{色02}古之火山{/色}的位置\n弗雷恩的族人\n应该有人知道…"
 },
 {
  "id": "007621",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4100}「なら、いそいで\nフーレンの里に\n戻りましょう。",
  "tgt": "{立绘4100}「那就赶快\n回弗雷恩村吧。"
 },
 {
  "id": "007622",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘0803}{码0A}\n「ぴっぴき",
  "tgt": "{立绘0803}{码0A}\n「噼噼叽"
 },
 {
  "id": "007623",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4100}「おかえりなさい\n{队员00}‥‥\n---\n少し休んでいって\nくださいね。{码14860C93}休んで行こう\n旅の記錄だけしておこう\nまだがんばる",
  "tgt": "{立绘4100}「欢迎回来\n{队员00}……\n---\n休息一会儿\n再走吧。{码14860C93}休息一下\n只记录旅程\n继续努力"
 },
 {
  "id": "007624",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4500}「たくさん\n落っこちてきた？\n---\n‥と、{队员05}\nきいてます。",
  "tgt": "{立绘4500}「捡到\n好多东西了？\n---\n…{队员05}\n在问。"
 },
 {
  "id": "007625",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4300}「なぜ{码0B}‥{码0B}‥\n---\nがんばる{码0B}‥{码0B}？",
  "tgt": "{立绘4300}「为什么{码0B}…{码0B}…\n---\n要努力{码0B}…{码0B}？"
 },
 {
  "id": "007626",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "\n     どこへ行こうか？{码14010C93}黄金平野に出発する\n他のところへ行く\nどこにも行かない",
  "tgt": "\n要去哪里？出发去黄金平原\n去别处\n哪儿也不去{码14010C93}黄金平野に出発する\n他のところへ行く\nどこにも行かない"
 },
 {
  "id": "007627",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘C240}「この調子なら‥\n---\n明日には、捨てられた村に\n着けそうだな‥",
  "tgt": "{立绘C240}「照这个速度‥\n---\n明天应该就能到\n被遗弃的村庄了‥"
 },
 {
  "id": "007628",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘C240}「かくれてる 人達が\n帝国のやつらに‥\n---\n見つかって いなければ\nいいんだが‥",
  "tgt": "{立绘C240}「希望躲起来的\n人们‥\n---\n没被帝国的\n家伙们发现‥"
 },
 {
  "id": "007629",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{框02}{立绘0000}「{队员01}‥‥\n---\n{队员05}の事なら\nつめたい 言い方だと\n思うが‥‥\n---\nもともと、ただのヨロイ\nなのだし‥",
  "tgt": "{框02}{立绘0000}「{队员01}……\n---\n要我说{队员05}\n话说得\n是挺冷的……\n---\n毕竟它本来\n就只是副铠甲…"
 },
 {
  "id": "007630",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{框04}{立绘C140}「だったら、兄さま‥\n---\nわたしたちの 知っている\n{队员05}さんは‥\n---\n最初から、いなかったって\nことに なるんでしょうか？",
  "tgt": "{框04}{立绘C140}「那样的话，兄长大人‥\n---\n我们所认识的\n{队员05}先生‥\n---\n是不是从一开始\n就不存在呢？"
 },
 {
  "id": "007631",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{框04}{立绘8941}「そんなのって\nへんですよね‥",
  "tgt": "{框04}{立绘8941}「那样\n太奇怪了吧‥"
 },
 {
  "id": "007632",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{框04}{立绘C140}「あ、ごめんなさい‥\n---\n{立绘8241}今は、チェクの人達の事が\n先決ですよね‥",
  "tgt": "{框04}{立绘C140}「啊，对不起‥\n---\n{立绘8241}现在，切克的人们\n才是最要紧的‥"
 },
 {
  "id": "007633",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4200}「{队员01}‥\n感傷的に なっているようだ。\n---\n分からないでも、ないがな。",
  "tgt": "{立绘4200}「{队员01}…\n好像太多愁善感了。\n---\n也不是不能理解。"
 },
 {
  "id": "007634",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4100}「{队员05}さん、どこへ\n行ってしまったんでしょう‥\n---\n{立绘0901}わたし達が、死んでしまうのと\nどう違うんでしょうね‥",
  "tgt": "{立绘4100}「{队员05}先生\n到底去哪了呢…\n---\n{立绘0901}和我们死去\n又有什么区别呢…"
 },
 {
  "id": "007635",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4300}「せ‥\n---\n戦爭のときは‥\n---\nたくさん、死んだ‥\n---\n悲しむひまは‥\n無かった‥",
  "tgt": "{立绘4300}「战…\n---\n打仗的时候…\n---\n死了很多人…\n---\n连悲伤的\n工夫…都没有"
 },
 {
  "id": "007636",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "今日は、もう休もう‥",
  "tgt": "今天，先休息吧‥"
 },
 {
  "id": "007637",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘C440}「{队员00}だな‥？\n---\nフォウ帝国軍\n{队员04}だ‥",
  "tgt": "{立绘C440}「是{队员00}吧…？\n---\n福乌帝国军\n{队员04}…"
 },
 {
  "id": "007638",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘C440}「おまえが‥\nアルカイの竜で あるという\n調べは、ついている。\n---\n‥いっしょに、来てもらおう。",
  "tgt": "{立绘C440}「已查明‥\n你就是\n阿尔凯之龙。\n---\n‥请跟我们走一趟吧。"
 },
 {
  "id": "007639",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{框05}{立绘4200}「きさま達が、ここに\n来たと言う事は‥\n---\nやはり、かくれていた\n村人たちは‥\n見つかっていたか‥",
  "tgt": "{框05}{立绘4200}「你们来到这里\n就说明…\n---\n藏起来的\n村民果然…\n还是被找到了…"
 },
 {
  "id": "007640",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{框05}{立绘0000}「俺達のことを\n闻き出すのに‥\n---\n村人たちに\n手あらなマネを\nしたんじゃ ないだろうな！？",
  "tgt": "{框05}{立绘0000}「你们为了\n逼问我们的事…\n---\n该不会对\n村民下\n毒手了吧！？"
 },
 {
  "id": "007641",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘8A44}「何の話だ‥？",
  "tgt": "{立绘8A44}「在说什么‥？"
 },
 {
  "id": "007642",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{框05}{立绘0000}「とぼけるな‥\n---\n{队员05}に した事を\n見れば‥‥\n---\n{立绘0B00}きさま達が、どんな\n種類の人間かは、{码0B}分かる！",
  "tgt": "{框05}{立绘0000}「少装蒜…\n---\n看你们对\n{队员05}做过的事…\n---\n{立绘0B00}就知道你们\n是哪种货色，{码0B}一目了然！"
 },
 {
  "id": "007643",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{框05}{立绘4100}「この先の‥\n捨てられた村と、いう場所に‥\n---\nかくれている 人達が\nいるハズなんです‥",
  "tgt": "{框05}{立绘4100}「前面那个…\n叫废村的地方…\n---\n应该藏着\n一些人…"
 },
 {
  "id": "007644",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{框05}{立绘0101}「そこまで行って‥\n---\n村人の無事を\n確認させてください‥！",
  "tgt": "{框05}{立绘0101}「请让我们‥\n---\n去确认村民\n是否平安‥！"
 },
 {
  "id": "007645",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{框06}{立绘8141}「都に、現れたって\n魔物‥\n---\nもう一人の、{队员00}と\n関係あるんでしょうか？",
  "tgt": "{框06}{立绘8141}「帝都出现\n的那种魔物…\n---\n和另一个\n{队员00}有关系吗？"
 },
 {
  "id": "007646",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{框05}{立绘4200}「あるいは、{码0B}そうかもな‥\n---\nそれよりも‥‥",
  "tgt": "{框05}{立绘4200}「说不定，{码0B}还真有…\n---\n比起这个……"
 },
 {
  "id": "007647",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{框05}{立绘4200}「{队员04}隊長さんは\nどうして‥\n---\n俺達を 軍に\n突き出さない‥？\n---\n何か、たくらみでも\nあるのか‥？",
  "tgt": "{框05}{立绘4200}「{队员04}队长\n为什么不…\n---\n把我们扭送\n军中…？\n---\n是有什么\n企图吗…？"
 },
 {
  "id": "007648",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{框06}{立绘8A44}「ちょくせつ、命令をうけた\n將軍のもとへ\n向かっているだけだ‥\n---\nたくらみなど、ない。",
  "tgt": "{框06}{立绘8A44}「我只是奉命\n前往将军\n处而已‥\n---\n并无任何图谋。"
 },
 {
  "id": "007649",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{框05}{立绘0000}「それで、帝都へ‥？\n---\nしかし、都が壊滅したって\n話じゃないか‥\n---\nその將軍とやらも‥",
  "tgt": "{框05}{立绘0000}「所以，要去帝都…？\n---\n可是不是听说\n帝都毁了…\n---\n那位将军也…"
 },
 {
  "id": "007650",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{框06}{立绘8C45}「ルーン様が、かんたんに\n負けたり するものか！\n---\n帝都の軍本部で\n私を 待っていて下さる。",
  "tgt": "{框06}{立绘8C45}「鲁恩大人岂会\n轻易落败！\n---\n请到帝都军本部\n等我的消息。"
 },
 {
  "id": "007651",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4500}「{队员01}‥\nつらいのですか？",
  "tgt": "{立绘4500}「{队员01}…\n难过吗？"
 },
 {
  "id": "007652",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘8901}「どう‥、言ったら\nいいのか‥‥\n---\n姉さまのこと‥",
  "tgt": "{立绘8901}「该‥怎么\n说才好‥‥\n---\n姐姐的事‥"
 },
 {
  "id": "007653",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘8901}「前に、見つからなかった時‥\n---\nもう、あきらめようって\n言われて‥‥\n---\nでも‥、でも‥\n死んだって、闻かされたら‥",
  "tgt": "{立绘8901}「上次，找不到时‥\n---\n有人劝我说\n放弃吧‥‥\n---\n可是‥、可是‥\n若听到的是死讯‥"
 },
 {
  "id": "007654",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{框06}{立绘8D46}「{队员05}が‥\nディース様が、出て行った時‥\n---\nよく分かりませんが\nカラッポに なりましたよ‥\nけれど‥‥",
  "tgt": "{框06}{立绘8D46}「{队员05}‥\n蒂斯大人离开时‥\n---\n虽然不太明白\n它变得空空的‥\n不过‥‥"
 },
 {
  "id": "007655",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘8E01}「はげまして‥\nくれてるんですよね\n{队员05}さん‥？",
  "tgt": "{立绘8E01}「是在‥\n鼓励我吧\n{队员05}先生‥？"
 },
 {
  "id": "007656",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘8E01}「そうですね‥\n---\nわたしは、カラッポじゃ\nないですよね‥\n---\nみんなが いるもの、ね。",
  "tgt": "{立绘8E01}「是啊‥\n---\n我并不是\n空壳对吧‥\n---\n因为大家都在，对吧。"
 },
 {
  "id": "007657",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{框06}{立绘C440}「私が‥‥",
  "tgt": "{框06}{立绘C440}「我‥‥"
 },
 {
  "id": "007658",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{框06}{立绘C440}「私が、彼女でも‥\n---\nお前に 同じ事を\n賴んだと 思うぞ‥",
  "tgt": "{框06}{立绘C440}「我若是她‥\n---\n我想也会向你\n托付同样的事‥"
 },
 {
  "id": "007659",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘C440}「まちがった事は‥\n---\n{立绘8C45}していない、{码0B}と\n私は思う‥‥",
  "tgt": "{立绘C440}「你没有‥\n---\n{立绘8C45}做错，我是\n这么想的‥‥{码0B}と\n私は思う‥‥"
 },
 {
  "id": "007660",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘4300}「お‥‥\n---\n俺も、そう思う。",
  "tgt": "{立绘4300}「哦……\n---\n我也是这么想。"
 },
 {
  "id": "007661",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{立绘0402}「竜のヒト‥\n何か、あったの？\n---\n今日は、遊ばないよね。",
  "tgt": "{立绘0402}「龙人‥\n发生什么事了吗？\n---\n今天，不玩了吗。"
 },
 {
  "id": "007662",
  "file": "WORLD/AREAE018.EMI",
  "seg": 8,
  "src": "{框21}{打字02}ここから しばらく\n{队员00}の 一人旅です‥\n---\n仲間の {色03}スキル{/色}は\nまき物に 戻りました。",
  "tgt": "{框21}{打字02}从这里开始\n{队员00}将独自旅行一段…\n---\n伙伴的{色03}技能{/色}\n已收回卷轴。"
 },
 {
  "id": "007663",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "るーぷさばく。",
  "tgt": "鲁普沙漠。"
 },
 {
  "id": "007664",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "お城を出て3日目。",
  "tgt": "离开城堡第3天。"
 },
 {
  "id": "007665",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "明け方、私たちの砂船は",
  "tgt": "拂晓，我们的砂船"
 },
 {
  "id": "007666",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "大砂漠にさしかかった。",
  "tgt": "驶入了大沙漠。"
 },
 {
  "id": "007667",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "エリーナ姉さまの",
  "tgt": "艾莉娜姐姐的"
 },
 {
  "id": "007668",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "行方が分からなくなった",
  "tgt": "下落变得不明"
 },
 {
  "id": "007669",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "セネスタの町まで‥",
  "tgt": "是直到塞内斯塔镇‥"
 },
 {
  "id": "007670",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "砂漠をこえれば",
  "tgt": "只要越过沙漠"
 },
 {
  "id": "007671",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "もうすぐでした。",
  "tgt": "就快到了。"
 },
 {
  "id": "007672",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "{框05}{立绘4100}「兄さま、流れ星！",
  "tgt": "{框05}{立绘4100}「兄长，流星！"
 },
 {
  "id": "007673",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "{框06}{立绘4100}「兄さま‥{码0B}‥\n---\n姉さま、見つかりますよね。",
  "tgt": "{框06}{立绘4100}「兄长…{码0B}…\n---\n姐姐一定能找到的，对吧。"
 },
 {
  "id": "007674",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "{框05}{立绘C240}「ああ‥、{码0B}必ず。",
  "tgt": "{框05}{立绘C240}「嗯‥，一定。{码0B}必ず。"
 },
 {
  "id": "007675",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "{立绘8000}「ふう、{码0B}あつ‥‥。",
  "tgt": "{立绘8000}「呼，{码0B}热……。"
 },
 {
  "id": "007676",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "{立绘0100}「あ‥、{码0B}だいじょうぶです\n兄さま‥！",
  "tgt": "{立绘0100}「啊…，{码0B}没事的\n兄长…！"
 },
 {
  "id": "007677",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "{框06}{立绘8241}「いや‥、やはり\n日中の移動は、つらいな‥\n---\n{立绘C240}「どこか、岩カゲを見つけて\n日ぐれまで、休もう‥",
  "tgt": "{框06}{立绘8241}「不行‥果然\n白天赶路，太辛苦了‥\n---\n{立绘C240}「找个岩石的阴凉\n休息到日落后吧‥"
 },
 {
  "id": "007678",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "{立绘0100}「わたし‥ まだ、へいきです\nそれより‥‥\n---\n{立绘4100}「早く、姉さまを‥",
  "tgt": "{立绘0100}「我…还没事\n比起这个……\n---\n{立绘4100}「快点，姐姐…"
 },
 {
  "id": "007679",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "{框06}{立绘C240}「ここまで来て\nあわてる事はない。\n---\n休んでも、明日には‥",
  "tgt": "{框06}{立绘C240}「都到这儿了\n不必慌张。\n---\n休息一下，明天也能‥"
 },
 {
  "id": "007680",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "{框04}{立绘C240}「なんだ‥！？{延时30}",
  "tgt": "{框04}{立绘C240}「什么‥！？{延时30}"
 },
 {
  "id": "007681",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "{立绘8341}「竜っ！？",
  "tgt": "{立绘8341}「龙！？"
 },
 {
  "id": "007682",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "{立绘4200}「この砂漠に‥\n竜がいるとは、闻いていたが‥",
  "tgt": "{立绘4200}「虽然听说\n这沙漠里有龙…"
 },
 {
  "id": "007683",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "{框06}{立绘8400}「兄さま、来ます！",
  "tgt": "{框06}{立绘8400}「兄长，来了！"
 },
 {
  "id": "007684",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "{立绘4200}「つかまってろ！{延时20}",
  "tgt": "{立绘4200}「抓稳了！{延时20}"
 },
 {
  "id": "007685",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "{立绘C140}「竜が、人を おそうなんて‥{延时40}",
  "tgt": "{立绘C140}「龙，竟然袭击人类‥{延时40}"
 },
 {
  "id": "007686",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "{立绘C240}「おそう気が、なくても‥\nあんなのに ぶつかったら\nこんな船、バラバラだっ！{延时60}",
  "tgt": "{立绘C240}「就算没有袭击的性子‥\n撞上那种东西\n这船也会散架的！{延时60}"
 },
 {
  "id": "007687",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "{立绘C240}「くそっ、何だって‥{延时30}",
  "tgt": "{立绘C240}「可恶，怎么回事‥{延时30}"
 },
 {
  "id": "007688",
  "file": "WORLD/AREAE023.EMI",
  "seg": 18,
  "src": "{立绘8341}「ダメだ！ 当たる！{延时20}",
  "tgt": "{立绘8341}「不好！要撞上！{延时20}"
 },
 {
  "id": "007689",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "きょうどうたい",
  "tgt": "共同体"
 },
 {
  "id": "007690",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "「何が知りたい？{码14040C99}はじめに‥\n食べ物と『狩り』\n作戦\nタイプと能力\n文化と仕事\n仕事に妖精を配置する\n土木\n家を建てる\nおわり",
  "tgt": "「想知道什么？‥\n食物与『狩猎』\n作战\n类型与能力\n文化与工作\n给妖精安排工作\n土木\n建房\n结束{码14040C99}はじめに‥\n食べ物と『狩り』\n作戦\nタイプと能力\n文化と仕事\n仕事に妖精を配置する\n土木\n家を建てる\nおわり"
 },
 {
  "id": "007691",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "「おおざっぱに言うと‥\n---\nあたし達、妖精に\n色んな仕事を させて‥\n---\n人口を ふやして\n町を 大きくするのよう\n---\n最初は 何にもないケド‥\n---\nがんばれば、りっぱな\n町になるよう！\n---\n{引2 0100}",
  "tgt": "「大体上说‥\n---\n我们妖精\n会做各种工作‥\n---\n以此增加人口\n把镇子变大哟\n---\n虽然最初什么都没有‥\n---\n只要努力，就能成为\n像样的镇子哟！\n---\n{引2 0100}"
 },
 {
  "id": "007692",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "「食べ物は、大切よう！\n---\nこれが、なくなると\nあたし達、死んじゃうから‥\n---\n『狩り』を して\nふやさないと だめよう！\n---\n狩りをさせる 人数は‥\n人口の{色02}1/3{/色}を 目安に\n配置すると、いいみたいよう\n---\n{引2 0100}",
  "tgt": "「食物很重要哟！\n---\n没了食物\n我们会死掉的…\n---\n必须让人去『打猎』\n增加储备哟！\n---\n打猎的人数…\n以人口的{色02}1/3{/色}为标准\n来安排比较好哟\n---\n{引2 0100}"
 },
 {
  "id": "007693",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "「『作戦』で あたしたちの\n働き具合を 決めてよう\n---\n『しゃかりき』から\n『のんびり』までの\n4種類あって‥\n---\nたとえば、『しゃかりき』は\n成果が 高くなるけど‥\n---\nその分、いっぱい食べる‥\nみたいなバランスだよう！\n---\nなれない間は、『がんばれ』が\n安心だよう\n---\n{引2 0100}",
  "tgt": "「用『作战』决定\n我们的干劲吧\n---\n从『全力』到\n『悠闲』共有\n4种‥\n---\n比如『全力』\n成果虽高‥\n---\n但相应地\n吃得也多哟！\n---\n不熟悉的时候\n『加油』最安心哟\n---\n{引2 0100}"
 },
 {
  "id": "007694",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "「あたしたちの 能力は‥\n---\n体力‥\n知力‥\nセンス‥ の、3つだよう\n---\nこの能力で 仕事に\n向き、不向きが あるよう‥\n---\nたとえば、体力があったら‥\n力仕事に 向いてるよう！\n---\nそれと、『タイプ』って言うのは\nせいかくの事で‥\n---\nこれでも、作業効果が\n変わるよう\n---\n{引2 0100}",
  "tgt": "「我们的能力是‥\n---\n体力‥\n智力‥\n悟性，3种哟\n---\n不同工作对能力\n各有要求哟‥\n---\n比如体力好\n就适合力气活哟！\n---\n还有『类型』\n指的是性格‥\n---\n这也会影响\n作业效果哟\n---\n{引2 0100}"
 },
 {
  "id": "007695",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "「『仕事』は、最初『狩り』と\n『土木』しかないけど‥\n---\n『文化』が上がると\nだんだん ふえるよう！\n---\n『文化』は、あたし達の知力に\nかんけいあるよう\n---\n{引2 0100}",
  "tgt": "「『工作』最初只有\n『狩猎』和『土木』‥\n---\n『文化』上升后\n会渐渐增多哟！\n---\n『文化』与我们的\n智力有关哟\n---\n{引2 0100}"
 },
 {
  "id": "007696",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "「どの妖精に、どの仕事を\nさせるのか 決めるのよう\n---\n仕事ウインドウで\n決定ボタンを押すと‥\n---\nメニューが出るから\n『選択』を選んで‥\n---\nウインドウの中の 妖精を\nさせたい仕事の ウインドウまで\n移動させてよう\n---\n『全選択』を使うと\nそこにいる妖精を\nいっぺんに 移動できるよう\n---\n{引2 0100}",
  "tgt": "「决定让哪只妖精\n做哪份工作哟\n---\n在工作窗口\n按下决定键‥\n---\n会弹出菜单\n选择『选择』‥\n---\n把窗口里的妖精\n移到想让它做的工作\n窗口去哟\n---\n用『全选』的话\n能把那里的妖精\n一次全移过去哟\n---\n{引2 0100}"
 },
 {
  "id": "007697",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "「『土木』は‥\n土地をひろげて、家を建てる\nお仕事よう！\n---\n土地が ひろがったら\n家を建てる場所が\nどんどん ふえるよう！\n---\n{引2 0100}",
  "tgt": "「『土木』是‥\n开垦土地、建造房屋\n的工作哟！\n---\n土地扩展后\n能建房的地方\n会越来越多哟！\n---\n{引2 0100}"
 },
 {
  "id": "007698",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "「家を建てるには‥\n---\n『土木』の メニューの中から\n『土地』を選んで‥\n---\n家を建てたい場所を\nカーソルで選んで\n決定してよう！\n---\n反対に、家をつぶす時は‥\n---\n家を選んで、決定してよう！\n---\n{引2 0100}",
  "tgt": "「想建房的话‥\n---\n从『土木』菜单中\n选择『土地』‥\n---\n用光标选好想建房的位置\n按下决定哟！\n---\n反过来，想拆房时‥\n---\n选好房子\n按下决定哟！\n---\n{引2 0100}"
 },
 {
  "id": "007699",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "よろしく賴むよう\n---\n{引2 1200}",
  "tgt": "多多关照哟\n---\n{引2 1200}"
 },
 {
  "id": "007700",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "{立绘0000}「よく来たよう‥！\n---\nあたし達、すっかり\nくらし方を\nわすれちゃったから‥\n---\n作戦を 決めたり\n仕事の配置を 決めたり\nしてよう‥！{码14030C94}仕事と作戦\n土地をみたい\n說明をききたい\nやっぱりやめる",
  "tgt": "{立绘0000}「来得正好哟…！\n---\n我们把过日子的\n方法\n全忘光了…\n---\n定定作战\n安排安排工作\n这样子哟…！{码14030C94}工作与作战\n看看土地\n想听说明\n还是算了"
 },
 {
  "id": "007701",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "{框8A}{码14820C82}はい\nいいえ",
  "tgt": "{框8A}{码14820C82}是\n否"
 },
 {
  "id": "007702",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "{框88}{码14820C82}はい\nいいえ",
  "tgt": "{框88}{码14820C82}是\n否"
 },
 {
  "id": "007703",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "{立绘0000}「どうするのか、言ってよう{码14030C94}仕事と作戦\n土地をみたい\n說明をききたい\nやっぱりやめる",
  "tgt": "{立绘0000}「快说怎么办哟{码14030C94}工作与作战\n看看土地\n想听说明\n还是算了"
 },
 {
  "id": "007704",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "{立绘0100}「長い間、ほっとかれたよう\nせつないよう‥\n---\nどうすればいいのか\n教えてくれないと、やだよう{码14030C94}仕事と作戦\n土地をみたい\n說明をききたい\nやっぱりやめる",
  "tgt": "{立绘0100}「被冷落了那么久哟\n好伤心哟…\n---\n不说怎么弄\n人家就不干哟{码14030C94}工作与作战\n看看土地\n想听说明\n还是算了"
 },
 {
  "id": "007705",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "{立绘0000}「おしえてよう、おしえてよう！{码14030C94}仕事と作戦\n土地をみたい\n說明をききたい\nやっぱりやめる",
  "tgt": "{立绘0000}「快教我哟，快教我哟！{码14030C94}工作与作战\n看看土地\n想听说明\n还是算了"
 },
 {
  "id": "007706",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "{码14030C94}仕事と作戦\n土地をみたい\n說明をききたい\nやっぱりやめる",
  "tgt": "{码14030C94}工作与作战\n查看土地\n听取说明\n还是算了"
 },
