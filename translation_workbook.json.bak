 {
  "id": "000123",
  "file": "SYSTEM/CAMP.EMI",
  "seg": 8,
  "src": "さきがけ：敵よりも早く、行動できる",
  "tgt": "先锋：可先于敌人行动"
 },
 {
  "id": "000124",
  "file": "SYSTEM/CAMP.EMI",
  "seg": 8,
  "src": "のんびり：目をはなすと‥",
  "tgt": "悠闲：视线一移开‥"
 },
 {
  "id": "000125",
  "file": "SYSTEM/CAMP.EMI",
  "seg": 8,
  "src": "おいうち：コンボ時、弱っている敵にトドメをさす",
  "tgt": "追击：连击时给虚弱之敌最后一击"
 },
 {
  "id": "000126",
  "file": "SYSTEM/CAMP.EMI",
  "seg": 8,
  "src": "かんさつ：攻撃を見切る（ラーニング率UP）",
  "tgt": "观察：看破攻击（学习率UP）"
 },
 {
  "id": "000127",
  "file": "SYSTEM/CAMP.EMI",
  "seg": 8,
  "src": "なきむし：反撃がでたら「必殺」になる",
  "tgt": "爱哭鬼：反击必成「必杀」"
 },
 {
  "id": "000128",
  "file": "SYSTEM/CAMP.EMI",
  "seg": 8,
  "src": "けんやく：アイテムが「アタリつき」になる",
  "tgt": "节俭：道具带有「附赠」"
 },
 {
  "id": "000129",
  "file": "SYSTEM/CAMP.EMI",
  "seg": 8,
  "src": "いただき：見たことがないアイテムを勝手にぬすむ",
  "tgt": "贪得：擅自偷取没见过的道具"
 },
 {
  "id": "000130",
  "file": "SYSTEM/CAMP.EMI",
  "seg": 8,
  "src": "全力：当れば大きいが、やや命中率がさがる",
  "tgt": "全力：命中伤害大，但命中率略降"
 },
 {
  "id": "000131",
  "file": "SYSTEM/CAMP.EMI",
  "seg": 8,
  "src": "しんがん：100発100中？",
  "tgt": "神眼：百发百中？"
 },
 {
  "id": "000132",
  "file": "SYSTEM/CAMP.EMI",
  "seg": 8,
  "src": "かばう：ひん死の仲間への攻撃を自分が受ける",
  "tgt": "掩护：替濒死同伴承受攻击"
 },
 {
  "id": "000133",
  "file": "SYSTEM/CAMP.EMI",
  "seg": 8,
  "src": "ガッツ！：痛くても、根性で立ち上がる",
  "tgt": "拼劲！：再痛也靠毅力站起来"
 },
 {
  "id": "000134",
