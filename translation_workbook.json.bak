  "file": "WORLD/AREAD043.EMI",
  "seg": 11,
  "src": "{立绘8040}「いや‥！\nたとえ、何人であろうと\n通すワケには、いかん！",
  "tgt": "{立绘8040}「不‥！\n不管来者何人\n绝不放行！"
 },
 {
  "id": "004815",
  "file": "WORLD/AREAD043.EMI",
  "seg": 11,
  "src": "上へ行きますか？{码14000C82}はい\nいいえ",
  "tgt": "要上去吗？{码14000C82}是\n否"
 },
 {
  "id": "004816",
  "file": "WORLD/AREAD043.EMI",
  "seg": 11,
  "src": "下へ行きますか？{码14010C82}はい\nいいえ",
  "tgt": "要下去吗？是\n否{码14010C82}はい\nいいえ"
 },
