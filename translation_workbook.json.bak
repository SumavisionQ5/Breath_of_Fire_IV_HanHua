 },
 {
  "id": "000265",
  "file": "SYSTEM/CAMP.EMI",
  "seg": 9,
  "src": "命をはぐくむ、聖なるかけら\n一人のMAXHPを 10上げます",
  "tgt": "培育生命的神圣碎片\n使1人MAXHP提升10"
 },
 {
  "id": "000266",
  "file": "SYSTEM/CAMP.EMI",
  "seg": 9,
  "src": "魔力を宿した、ふしぎなかけら\n一人のMAXAPを 1上げます",
  "tgt": "蕴含魔力的神秘碎片\n使1人MAXAP提升1"
 },
 {
  "id": "000267",
  "file": "SYSTEM/CAMP.EMI",
  "seg": 9,
  "src": "たべるだけでパワーアップ\n一人の攻撃力を 1上げます",
  "tgt": "吃下即可提升力量\n使1人攻击力提升1"
 },
 {
  "id": "000268",
  "file": "SYSTEM/CAMP.EMI",
  "seg": 9,
  "src": "じょうぶな体を つくります\n一人の防御力を 1上げます",
