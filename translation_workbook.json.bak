  "file": "WORLD/AREAE036.EMI",
  "seg": 12,
  "src": "{框21}{色02}シェド{/色}から‥\n{色02}シューク地方{/色}に 向かいます。",
  "tgt": "{框21}从{色02}谢德{/色}…\n前往{色02}修克地区{/色}。"
 },
 {
