  "tgt": "悟性"
 },
 {
  "id": "009161",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "年れい",
  "tgt": "年龄"
 },
 {
  "id": "009162",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "職業",
  "tgt": "职业"
 },
 {
  "id": "009163",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "整理方法をえらんでください",
  "tgt": "请选择整理方式"
 },
 {
  "id": "009164",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "解体できます",
  "tgt": "可拆除"
 },
 {
  "id": "009165",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "空き家です 解体できます",
  "tgt": "空房 可拆除"
 },
 {
  "id": "009166",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "建築中です 解体できます",
  "tgt": "建筑中 可拆除"
 },
 {
  "id": "009167",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "空き地です 家を建てることができます",
  "tgt": "空地 可以建房"
 },
 {
  "id": "009168",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "選べません",
  "tgt": "无法选择"
 },
 {
  "id": "009169",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "家を解体しますか？",
  "tgt": "要拆除房屋吗？"
 },
 {
  "id": "009170",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "建てたい場所を選んでください",
  "tgt": "请选择想建房的位置"
 },
 {
  "id": "009171",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "空き地にもどしていいですか？",
  "tgt": "要恢复为空地吗？"
 },
 {
  "id": "009172",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「土木」の妖精がいません",
  "tgt": "没有「土木」的妖精"
 },
 {
  "id": "009173",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "{码14000C92}「仕事のことだけど\n「最近どう？",
  "tgt": "{码14000C92}「关于工作\n「最近怎么样？"
 },
 {
  "id": "009174",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "ひりょうを与えてみますか？{码14820C82}与える\nやめとく",
  "tgt": "要试着施肥吗？施肥\n算了{码14820C82}与える\nやめとく"
 },
 {
  "id": "009175",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "与えたいアイテムを選んでください",
  "tgt": "请选择要给予的物品"
 },
 {
  "id": "009176",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "いくつ与えますか？",
  "tgt": "要给多少？"
 },
 {
  "id": "009177",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "実がなっている\nゆらしてとってみよう",
  "tgt": "结出了果实\n摇一摇试着摘下吧"
 },
 {
  "id": "009178",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "{占位00}を{占位01}コ手に入れた！",
  "tgt": "获得了{占位00}{占位01}个！"
 },
 {
  "id": "009179",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "作戦とは、妖精の働き具合です\nこれで作業成果と食物消化が\n変化します\n『{色02}じゆうに{/色}』に関しては、\n作業成果はそこそこですが\n{色07}センス{/色}があがりやすいようです",
  "tgt": "作战指妖精的干劲\n作业成果与食物消耗\n会随之变化\n至于『{色02}自由{/色}』，\n作业成果一般\n但{色07}品味{/色}似乎容易提升"
 },
 {
  "id": "009180",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "シゴトについていない妖精を\nあらわします\n妖精が生まれると\n最初にこの中に入ります",
  "tgt": "表示未从事工作的妖精\n妖精出生后\n最初会进入\n这里"
 },
 {
  "id": "009181",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "食べ物を集めます\nたくさん取れるときがあれば\n少ないときもあり\nその作業効果に関しては\n不安定です",
  "tgt": "收集食物\n收获有时多\n有时少\n作业效果\n并不稳定"
 },
 {
  "id": "009182",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "土地をひろげ家を建てます\nこのウインドウにいれておくと\n土地は自動でひろがりますが\n家を建てるときは\nコマンドメニューの『土地』を\n選んでください",
  "tgt": "开垦土地建造房屋\n放在此窗口中\n土地会自动扩展\n但建房时\n请选择命令菜单中的\n『土地』"
 },
 {
  "id": "009183",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "食べ物を作ります\nリンゴ配分を高めることにより\nプレイヤー用のアイテムを\n作ることも可能です\n良いひりょうを与えることで\nできるアイテムが変化します",
  "tgt": "制作食物\n提高苹果配比后\n也可制作\n玩家用的道具\n给予好的肥料\n可改变产出物品"
 },
 {
  "id": "009184",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "道具を売買します\n妖精の せいかくにより\nあつかう商品が変化します\n『文化』の度合が高いほど\n商品の種類が多くなります",
  "tgt": "买卖道具\n会因妖精的性格\n而改变经营的商品\n『文化』程度越高\n商品种类越多"
 },
 {
  "id": "009185",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "武器を売買します\n妖精の せいかくにより\nあつかう商品が変化します\n『文化』の度合が高いほど\n商品の種類が多くなります",
  "tgt": "买卖武器\n会因妖精的性格\n而改变经营的商品\n『文化』程度越高\n商品种类越多"
 },
 {
  "id": "009186",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "宿屋です\nタダでとまることができます\nここでさまざまなプレイヤー\n情報を闻くこともできます",
  "tgt": "旅店\n可以免费住宿\n在这里也能打听到\n各种玩家情报"
 },
 {
  "id": "009187",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "探険をしてアイテムを\n見つけてきます\n探険にシッパイすると\n归らぬ人となることも‥‥",
  "tgt": "外出探险寻找道具\n若探险失败\n也可能变成\n不归之人‥‥"
 },
 {
  "id": "009188",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "プレイヤーの戦闘を\n助けてくれます\n人数が多く能力が高いほど\n妖精魔法が強力になります",
  "tgt": "会在玩家的战斗中\n施以援手\n人数越多能力越高\n妖精魔法越强大"
 },
 {
  "id": "009189",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "音楽を闻かせてくれます\nセンスが高いほど\nたくさんの曲を闻けるように\nなります",
  "tgt": "会为玩家演奏音乐\n悟性越高\n能听到的曲子\n越多"
 },
 {
  "id": "009190",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "イラストを見せてくれます\nセンスが高いほど\nたくさんの作品を見れるように\nなります",
  "tgt": "会展示插画\n悟性越高\n能看到的\n作品越多"
 },
 {
  "id": "009191",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "メタルの売買を行います\n（手数りょうは10%です）\nかかくは変動するので\n安いときに買って\n高いときに売れば\nお金をもうけることも可能です",
  "tgt": "进行金属买卖\n（手续费为10%）\n价格会波动\n低价买入\n高价卖出\n也能赚到钱"
 },
 {
  "id": "009192",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "さまざまなミニゲームを\n楽しむことができます",
  "tgt": "可以游玩\n各种小游戏"
 },
 {
  "id": "009193",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "保険に入っておけば\n全滅しても その場で\nやりなおせることが\nあります\n保険にさまざまな特約を\nつけることも可能です",
  "tgt": "若入了保险\n即使全灭\n有时也能当场\n重来\n还能为保险\n附加各种特约"
 },
 {
  "id": "009194",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "空き家です\nまず職業を決めて下さい",
  "tgt": "空房\n请先决定职业"
 },
 {
  "id": "009195",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「ハラペコよう‥",
  "tgt": "「肚子饿了哟"
 },
 {
  "id": "009196",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「ヒトの目を 突っつくと\n痛がるから、おかしいよう！",
  "tgt": "「戳人类的眼睛\n它们会喊痛，真有趣哟！"
 },
 {
  "id": "009197",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「{队员00}は、どうも\n信用できないよう‥",
  "tgt": "「总感觉\n没法信任{队员00}…"
 },
 {
  "id": "009198",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「ねむいよう",
  "tgt": "「困了哟"
 },
 {
  "id": "009199",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「はあ‥",
  "tgt": "「哈啊‥"
 },
 {
  "id": "009200",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「せつないよう‥",
  "tgt": "「好难受哟‥"
 },
 {
  "id": "009201",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「どうして、仕事なんて\nしなくちゃ いけないのよう！？",
  "tgt": "「为什么非得\n工作不可啊！？"
 },
 {
  "id": "009202",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「別に、話すことないよう",
  "tgt": "「没什么好说的哟"
 },
 {
  "id": "009203",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「{队员00}って\nみんなに きらわれる\nタイプだよう",
  "tgt": "「{队员00}这种类型\n大家都会\n讨厌的哟"
 },
 {
  "id": "009204",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「なによう？",
  "tgt": "「什么事哟？"
 },
 {
  "id": "009205",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「{队员00}って‥\nあたしたちを\n食い物にしてるって、ほんと？{码14000C02}本当だよ\nまさか",
  "tgt": "「{队员00}…\n把我们当\n摇钱树，真的假的？{码14000C02}真的哦\n怎么会"
 },
 {
  "id": "009206",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「食べかけの 木の実を\n落としちゃった‥\n---\nついてないよう‥",
  "tgt": "「咬了一半的坚果\n掉掉了‥\n---\n真倒霉哟‥"
 },
 {
  "id": "009207",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「仕事が、つまらないよう‥",
  "tgt": "「工作，好无聊哟‥"
 },
 {
  "id": "009208",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「いそがしいよう‥\nいやだよう‥",
  "tgt": "「好忙哟‥\n讨厌哟‥"
 },
 {
  "id": "009209",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「旅に‥、出たいよう‥",
  "tgt": "「好想‥、去旅行哟‥"
 },
 {
  "id": "009210",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「しあわせじゃ、ないよう‥",
  "tgt": "「我不幸福哟‥"
 },
 {
  "id": "009211",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「はいはい‥",
  "tgt": "「是是‥"
 },
 {
  "id": "009212",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「もう、逃げたいよう‥",
  "tgt": "「真想，逃走哟‥"
 },
 {
  "id": "009213",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「また、無理なこと\n言うよう‥",
  "tgt": "「又提\n过分要求哟‥"
 },
 {
  "id": "009214",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「ぶー",
  "tgt": "「噗——"
 },
 {
  "id": "009215",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「やっぱり‥",
  "tgt": "「果然‥"
 },
 {
  "id": "009216",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「ほんとかなぁ‥",
  "tgt": "「真的吗‥"
 },
 {
  "id": "009217",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「たてた家に出てるメーターは\n活気度をあらわすよう\n---\nみどり色が長いほど\n活気があるらしいよう",
  "tgt": "「建好的房子上显示的槽\n表示活跃度哟\n---\n绿色越长\n好像越有活力哟"
 },
 {
  "id": "009218",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「ルートを移動中、かならず\n{色02}？マーク{/色}が出る場所があるよう\n---\nそこには何かあるから\nとりあえず入ってみたほうが\nいいよう",
  "tgt": "「赶路途中，肯定会有\n冒出{色02}？标记{/色}的地方哟\n---\n那里有东西\n先进去探一探\n比较好哟"
 },
 {
  "id": "009219",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「{队员00}達が 外で\n戦闘している間に‥\n---\nあたし達、はたらいて\nいるんだよう",
  "tgt": "「{队员00}他们\n在外面战斗的时候…\n---\n我们\n在干活哟"
 },
 {
  "id": "009220",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「能力のひくい人を\n探険に行かせちゃ\nだめだよう！",
  "tgt": "「让能力低的家伙\n去探险\n可不行哟！"
 },
 {
  "id": "009221",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「あたし達は、オトコでも\nオンナでも、ないのよう‥\n---\n知ってた？",
  "tgt": "「我们既不是\n男人也不是女人哟‥\n---\n你知道吗？"
 },
 {
  "id": "009222",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「まめに 来てくれると\nみんな よろこぶよう",
  "tgt": "「常来看我们\n大家会很高兴哟"
 },
 {
  "id": "009223",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「変わり者って、\nあまり生まれないから\n変わり者なんだよう",
  "tgt": "「怪胎之所以是怪胎\n是因为很少\n生出怪胎哟"
 },
 {
  "id": "009224",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「あたし達の 仲間で‥\n---\nヒトと いっしょに住んでる\n妖精が いるよう",
  "tgt": "「我们的同伴中‥\n---\n有妖精和人类\n住在一起哟"
 },
 {
  "id": "009225",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「もっと休みがほしいよう",
  "tgt": "「想要更多休息哟"
 },
 {
  "id": "009226",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「食べ物の 残り数に\n注意してよう",
  "tgt": "「注意食物的\n剩余量哟"
 },
 {
  "id": "009227",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「狩り場であったら\n手伝ってよう",
  "tgt": "「在狩猎场遇到\n就帮忙一下哟"
 },
 {
  "id": "009228",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「たまには あたしたちの\n性かくにも注意してよう",
  "tgt": "「偶尔也注意\n一下我们的性格哟"
 },
 {
  "id": "009229",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「{码03}のせなかに\nなにか ついてるよう",
  "tgt": "「背上\n好像沾着什么东西哟{码03}のせなかに\nなにか ついてるよう"
 },
 {
  "id": "009230",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「つれない魚は\nルアーをかえるといいらしいよう",
  "tgt": "「不给面子的鱼\n据说换换拟饵比较好哟"
 },
 {
  "id": "009231",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「{队员00}は、どのくらい\nあたしたちのこと すき？{码14010C13}いっぱい\nふつう\n··",
  "tgt": "「{队员00}有多\n喜欢我们呀？{码14010C13}超喜欢\n一般\n··"
 },
 {
  "id": "009232",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「おみやげ ちょうだい",
  "tgt": "「给我带伴手礼嘛"
 },
 {
  "id": "009233",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「あたしたちはシゴトすることで\n成長するんだよう",
  "tgt": "「我们通过工作\n成长哟"
 },
 {
  "id": "009234",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「あたしたちは ごはんより\nイタズラとおひるねが\n大好きなのよう",
  "tgt": "「比起吃饭\n我们更喜欢恶作剧\n和睡午觉哟"
 },
 {
  "id": "009235",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「よく性かくがいいって言われない？\n---\n{码0B}··なーんちゃって ウソだよう！",
  "tgt": "「常被人夸性格好？\n---\n··开玩笑的骗你的哟！{码0B}··なーんちゃって ウソだよう！"
 },
 {
  "id": "009236",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「狩りはねー 成功すると\nいっぱい食べ物がとれるけど\nしっぱいすることもあるのよう",
  "tgt": "「狩猎呀，成功的话\n能收获好多食物\n但也会失败哟"
 },
 {
  "id": "009237",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「うそつき",
  "tgt": "「骗子"
 },
 {
  "id": "009238",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「ふーん",
  "tgt": "「哦——"
 },
 {
  "id": "009239",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「ざんねん",
  "tgt": "「遗憾"
 },
 {
  "id": "009240",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「ルートを移動中、かならず\n{色02}？マーク{/色}が出る場所があるよう\n---\nそこには何かあるから\nとりあえず入ってみたほうが\nいいよう",
  "tgt": "「赶路途中，肯定会有\n冒出{色02}？标记{/色}的地方哟\n---\n那里有东西\n先进去探一探\n比较好哟"
 },
 {
  "id": "009241",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「{队员00}がくると\nもっとシゴトがんばろうって\n思うのよう",
  "tgt": "「{队员00}一来\n干活就更有\n劲头了哟"
 },
 {
  "id": "009242",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「空気のいいところは\n能力が成長しやすいのよう",
  "tgt": "「空气好的地方\n能力容易成长哟"
 },
 {
  "id": "009243",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「『文化』がひくいと\nいい商品は作れないよう",
  "tgt": "「『文化』低的话\n做不出好商品哟"
 },
 {
  "id": "009244",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「となりに家があると、活気が\n高くなってショップの品物が\n早くふえるよう",
  "tgt": "「旁边有房子的话\n活跃度会变高\n商店的商品增加更快哟"
 },
 {
  "id": "009245",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「今は{队员00}のこと好きだけど\nあたしたちは気まぐれだから\nこれからは わからないよう",
  "tgt": "「现在是喜欢{队员00}\n但我们很善变\n以后就不知道了哟"
 },
 {
  "id": "009246",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「{队员00}といっしょに\n遊ぶのよう",
  "tgt": "「和{队员00}\n一起玩哟"
 },
 {
  "id": "009247",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「あたし この町だーいすき\n{队员00} ありがとう！！",
  "tgt": "「人家最喜欢这个镇子啦\n{队员00} 谢谢你！！"
 },
 {
  "id": "009248",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「妖精の伝承師はもう見つけた？{码14020C02}見つけた\nまだ",
  "tgt": "「找到妖精的传承师了吗？找到了\n还没有{码14020C02}見つけた\nまだ"
 },
 {
  "id": "009249",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「闻いて 闻いて\n---\nあたし、ミスターフェアリーに\n選ばれたのよう！！\n---\nえっオトコじゃないって？\n{码0B}うーん、フクザツな気分··",
  "tgt": "「听听听我说\n---\n我，被选为\n妖精先生了哟！！\n---\n诶？不是男人？\n唔，心情好复杂··{码0B}うーん、フクザツな気分··"
 },
 {
  "id": "009250",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「海って見たことある？\n見てみたいなあ",
  "tgt": "「你见过海吗？\n好想看看啊"
 },
 {
  "id": "009251",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「たてた家に出てるメーターは\n活気度をあらわすよう\n---\nみどり色が長いほど\n活気があるらしいよう",
  "tgt": "「建好的房子上显示的槽\n表示活跃度哟\n---\n绿色越长\n好像越有活力哟"
 },
 {
  "id": "009252",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「底の方にいる魚って\nねらわないとつりにくいよね",
  "tgt": "「待在深处的鱼\n不瞄准的话很难钓呢"
 },
 {
  "id": "009253",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「きのうね‥‥\n{队员00}のユメをみたよう",
  "tgt": "「昨天啊……\n梦到{队员00}了哟"
 },
 {
  "id": "009254",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「よう兵は、使えば使うほど\n強くなるんだよう",
  "tgt": "「佣兵呀，越用\n越强哟"
 },
 {
  "id": "009255",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「伝承師を見つけたいなら\n---\nむかし行ったところに\nもう1度行ってみるべきだよう",
  "tgt": "「想找传承师的话\n---\n应该再去\n以前去过的地方看看哟"
 },
 {
  "id": "009256",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「あたしたちがアイツに\n食べられなかったのは\n{队员00}のおかげだよう",
  "tgt": "「我们能不被\n那家伙吃掉\n全靠{队员00}哟"
 },
 {
  "id": "009257",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「タイプによってダメな作戦と\nいい作戦があるの気づいてた？\n共感度が大きく変わるのよう",
  "tgt": "「不同类型有好用和\n不好用的作战，注意到了吗？\n共鸣度会大不相同哟"
 },
 {
  "id": "009258",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「みずうみでの 水あび\n気持ちがいいんだよう",
  "tgt": "「在湖里洗澡\n可舒服了哟"
 },
 {
  "id": "009259",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「会話って大切だよう\nあいてがどう思っているか\nわかるもんね",
  "tgt": "「对话很重要哟\n能知道对方\n在想什么呢"
 },
 {
  "id": "009260",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「そう",
  "tgt": "「是吗"
 },
 {
  "id": "009261",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「どっかで人間と\nくらしているよう",
  "tgt": "「好像在哪和人类\n一起生活哟"
 },
 {
  "id": "009262",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「最初はグー\n---\n‥そんなことをいいながら\nじゃんけんする人がいるよう",
  "tgt": "「第一把出石头\n---\n‥有人一边这么说\n一边猜拳哟"
 },
 {
  "id": "009263",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「作物のひりょうは\n魚がいいみたいだけど‥\n---\n{色02}くさったニク{/色} {色02}おこげ{/色}\n{色02}鳥のフン{/色}もいいらしいわよう",
  "tgt": "「作物施肥\n好像用鱼最好…\n---\n{色02}腐肉{/色} {色02}锅巴{/色}\n{色02}鸟粪{/色}好像也不错哟"
 },
 {
  "id": "009264",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「{色03}スーパーコンボ{/色}は\nコンボの3人目で出すと\nいいらしいよう",
  "tgt": "「超级连击\n在连击第3人时\n放出好像不错哟{色03}スーパーコンボ{/色}は\nコンボの3人目で出すと\nいいらしいよう"
 },
 {
  "id": "009265",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「{色03}反射撃ち{/色} {色03}ワータイガー{/色}\n{色03}夢氷絶命剣{/色} {色03}火の鳥{/色}‥\n---\nどれか知ってる？",
  "tgt": "「反射射击双头虎\n梦冰绝命剑火之鸟‥\n---\n知道哪个？{色03}反射撃ち{/色} {色03}ワータイガー{/色}\n{色03}夢氷絶命剣{/色} {色03}火の鳥{/色}‥\n---\nどれか知ってる？"
 },
 {
  "id": "009266",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「つりの深度メーターって\nよく見るとたまに光らない？\n---\nあれはね‥もしかしたら\n魚がたくさんいる場所で\nよく光るのかもしれないよう",
  "tgt": "「钓鱼的深度槽\n仔细看，偶尔会不会发光？\n---\n那个呀‥说不定\n在鱼多的地方\n容易发光哟"
 },
 {
  "id": "009267",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「{色02}やすにく{/色}は1つぶん\n{色02}ロース{/色}は3つぶん\n{色02}うまにく{/色}は5つぶん‥\n---\n{色02}マンモにく{/色}ならなんと\n10こぶんの食べ物になるよう",
  "tgt": "「{色02}便宜肉{/色}顶1份\n{色02}里脊{/色}顶3份\n{色02}好肉{/色}顶5份…\n---\n{色02}猛犸肉{/色}居然能顶\n10份口粮哟"
 },
 {
  "id": "009268",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「ちゅきっ！！！",
  "tgt": "「啾——！！！"
 },
 {
  "id": "009269",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「敵によっては回復魔法で\nダメージをあたえられるよう",
  "tgt": "「有的敌人\n用恢复魔法也能造成伤害哟"
 },
 {
  "id": "009270",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「『がんばれ』って共感度を\n下げない作戦なんだよう",
  "tgt": "「『加油』是不会降低\n共鸣度的作战哟"
 },
 {
  "id": "009271",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「どこかにものすごい強い敵が\nいるらしいよう\n---\n{色02}ペイル{/色}だかなんだか\nたしかそんな名前ではじまる\nやつだったよう",
  "tgt": "「好像哪里有个\n超强的大敌哟\n---\n叫{色02}佩尔{/色}什么的\n好像名字就是那么开头的家伙哟"
 },
 {
  "id": "009272",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「ああっ\nすっごいラッキーなことが\nおこるわよう",
  "tgt": "「啊——\n会有超幸运的\n事发生哟"
 },
 {
  "id": "009273",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「狩りしているところで\n出会ったら\n助けてほしいよう",
  "tgt": "「在狩猎时\n若遇到\n请帮帮我们哟"
 },
 {
  "id": "009274",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「もう ここの住人になっちゃえば\nいいよう",
  "tgt": "「干脆变成这里的\n居民就好了哟"
 },
 {
  "id": "009275",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「ごちそうつくるから\n家によっていってよう",
  "tgt": "「我会做好吃的\n请来家里玩哟"
 },
 {
  "id": "009276",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「これからも ずーっとよろしくね",
  "tgt": "「今后也请一直多多关照"
 },
 {
  "id": "009277",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「パーツがほしければ難度2‥\n---\nなんのことだか\nよくわからないよう",
  "tgt": "「想要零件的话难度2‥\n---\n完全搞不懂\n什么意思哟"
 },
 {
  "id": "009278",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「{队员00}がいないと\nさみしいよう",
  "tgt": "「没有{队员00}\n好寂寞哟"
 },
 {
  "id": "009279",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「{队员00}って神様みたい",
  "tgt": "「{队员00}像神明一样"
 },
 {
  "id": "009280",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「逃走回数で攻撃力のあがる\nスキルもあるらしいよう",
  "tgt": "「似乎还有凭逃跑次数\n提升攻击力的技能哟"
 },
 {
  "id": "009281",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「{色02}アケロン{/色}って魚、知ってる？\n---\n呪いで変異した魚らしいよう",
  "tgt": "「知道{色02}阿克隆{/色}鱼吗？\n---\n好像是受诅咒变异的鱼哟"
 },
 {
  "id": "009282",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "ストリート",
  "tgt": "街道"
 },
 {
  "id": "009283",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "ひろば",
  "tgt": "广场"
 },
 {
  "id": "009284",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "たいじゅ",
  "tgt": "大树"
 },
 {
  "id": "009285",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "みずうみ",
  "tgt": "湖"
 },
 {
  "id": "009286",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "やどなし",
  "tgt": "无旅店"
 },
 {
  "id": "009287",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "ほかのひりょうも\nまぜてみますか？{码14820C82}まぜる\nやめとく",
  "tgt": "要混入其他\n肥料吗？混入\n算了{码14820C82}まぜる\nやめとく"
 },
 {
  "id": "009288",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "これ以上、ひりょうを\nあたえられないようだ‥",
  "tgt": "似乎不能再\n施肥了‥"
 },
 {
  "id": "009289",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "{色03}{占位00}{/色}が {占位01}コ\n落ちてきた\n---\nしかし、持ち物がいっぱいだ！",
  "tgt": "{色03}{占位00}{/色}掉落了 {占位01}个\n---\n但是，行李已满！"
 },
 {
  "id": "009290",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "{色03}{占位00}{/色}が {占位01}コ\n落ちてきた\n---\nしかし、すべては拾えない！\n持てる分だけ拾いますか？\n{色02}ふたたび拾うことはできません{/色}{码14820C02}はい\nいいえ",
  "tgt": "{色03}{占位00}{/色}掉落了 {占位01}个\n---\n但是，无法全部拾取！\n只拾取拿得下的部分吗？\n{色02}无法再次拾取{/色}{码14820C02}是\n否"
 },
 {
  "id": "009291",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "ひりょうを与えても\n世話をする妖精がいません",
  "tgt": "即使施肥\n也没有照料的妖精"
 },
 {
  "id": "009292",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "{占位00}を {占位01}コ\nひりょうに与えた",
  "tgt": "把{占位00}{占位01}个\n施到了田里"
 },
 {
  "id": "009293",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "何も書かれていない",
  "tgt": "什么都没写"
 },
 {
  "id": "009294",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "何か書かれている。\n讀みますか？{码14820C82}はい\nいいえ",
  "tgt": "写着什么。\n要读吗？是\n否{码14820C82}はい\nいいえ"
 },
 {
  "id": "009295",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "死ぼう報告に関するメモです",
  "tgt": "关于死亡报告的备忘"
 },
 {
  "id": "009296",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "出生報告に関するメモです",
  "tgt": "关于出生报告的备忘"
 },
 {
  "id": "009297",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "仕事報告に関するメモです",
  "tgt": "关于工作报告的备忘"
 },
 {
  "id": "009298",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "ただのラクガキのようです",
  "tgt": "似乎只是涂鸦"
 },
 {
  "id": "009299",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "メモは はられていません",
  "tgt": "没有贴备忘"
 },
 {
  "id": "009300",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "{占位00}が生まれたよう",
  "tgt": "{占位00}出生了哟"
 },
 {
  "id": "009301",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "{占位00}はお腹をすかせて\nどこかに消えたよう",
  "tgt": "{占位00}饿着肚子\n不知躲哪去了哟"
 },
 {
  "id": "009302",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "{占位00}が探険から\n归ってこないよう‥‥",
  "tgt": "{占位00}探险之后\n没回来哟……"
 },
 {
  "id": "009303",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "道具屋の商品が\nふえたよう",
  "tgt": "道具屋的商品\n增加了哟"
 },
 {
  "id": "009304",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "武器屋の商品が\nふえたよう",
  "tgt": "武器屋的商品\n增加了哟"
 },
 {
  "id": "009305",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "探険から無事に\nもどってきたよう",
  "tgt": "探险平安\n归来了哟"
 },
 {
  "id": "009306",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "新しい作品が\nふえたよう",
  "tgt": "新作品\n增加了哟"
 },
 {
  "id": "009307",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "新しい音楽が\nふえたよう",
  "tgt": "新音乐\n增加了哟"
 },
 {
  "id": "009308",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "農家で作物が\nできたよう",
  "tgt": "农家的作物\n收获了哟"
 },
 {
  "id": "009309",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "よう兵のレベルが\nあがったよう",
  "tgt": "佣兵的等级\n提升了哟"
 },
 {
  "id": "009310",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "遊び屋の遊びが\nふえたよう",
  "tgt": "游艺屋的游戏\n增加了哟"
 },
 {
  "id": "009311",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "新しい仕事が\nふえたよう",
  "tgt": "新的工作\n增加了哟"
 },
 {
  "id": "009312",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "新しい家が\n建ったよう",
  "tgt": "新房子\n盖好了哟"
 },
 {
  "id": "009313",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "土地がやっと\nひろがったよう",
  "tgt": "土地终于\n扩展了哟"
 },
 {
  "id": "009314",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "なんとなく\nはってみたよう",
  "tgt": "不知为何\n贴了上去哟"
 },
 {
  "id": "009315",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "ちゃんと見てる？",
  "tgt": "有好好看着吗？"
 },
 {
  "id": "009316",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "あたしのおやつ盗んだ人\nはやく名乘り出てよう",
  "tgt": "偷我点心的人\n快点站出来哟"
 },
 {
  "id": "009317",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "仕事をさぼっている人が\nいるよう！",
  "tgt": "有人偷懒\n不干活哟！"
 },
 {
  "id": "009318",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "みんなもっと\nあたしに話しかけてよう",
  "tgt": "大家多来\n找我聊天哟"
 },
 {
  "id": "009319",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "外出は10さいに\nなってからだよう",
  "tgt": "外出要等\n满10岁才行哟"
 },
 {
  "id": "009320",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "あいうえお\nあえいおう",
  "tgt": "啊咿呜诶哦\n啊诶咿哦呜"
 },
 {
  "id": "009321",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「わたしの夢」\nもっとでかくなる",
  "tgt": "「我的梦想」\n变得更大"
 },
 {
  "id": "009322",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "「わたしの夢」\nとりになる",
  "tgt": "「我的梦想」\n变成鸟"
 },
 {
  "id": "009323",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "すこし\nへこんでるよう‥",
  "tgt": "有些\n消沉哟‥"
 },
 {
  "id": "009324",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "死ぼう報告",
  "tgt": "死亡报告"
 },
 {
  "id": "009325",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "出生報告",
  "tgt": "出生报告"
 },
 {
  "id": "009326",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "仕事報告",
  "tgt": "工作报告"
 },
 {
  "id": "009327",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "{占位01}より",
  "tgt": "来自{占位01}"
 },
 {
  "id": "009328",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "この木で作物をそだてるよう\n良いひりょうをあたえて\nほしいよう",
  "tgt": "用这棵树培育作物哟\n希望能给予\n好肥料哟"
 },
 {
  "id": "009329",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "道具屋です",
  "tgt": "道具屋"
 },
 {
  "id": "009330",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "武器屋です",
  "tgt": "武器屋"
 },
 {
  "id": "009331",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "宿屋です",
  "tgt": "旅店"
 },
 {
  "id": "009332",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "探険家です",
  "tgt": "探险家"
 },
 {
  "id": "009333",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "よう兵です",
  "tgt": "佣兵"
 },
 {
  "id": "009334",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "音楽家です",
  "tgt": "音乐家"
 },
 {
  "id": "009335",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "芸術家です",
  "tgt": "艺术家"
 },
 {
  "id": "009336",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "メタル屋です",
  "tgt": "金属屋"
 },
 {
  "id": "009337",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "遊び屋です",
  "tgt": "游艺屋"
 },
 {
  "id": "009338",
  "file": "WORLD/AREAE028.EMI",
  "seg": 8,
  "src": "保険屋です",
  "tgt": "保险屋"
 },
 {
  "id": "009339",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "るでぃあのとう",
  "tgt": "卢迪亚塔"
 },
 {
  "id": "009340",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "そうして、わたし達は捕らえられ‥",
  "tgt": "就这样，我们被捕‥"
 },
 {
  "id": "009341",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "本国へと、送り返されました。",
  "tgt": "被遣送回了本国。"
 },
 {
  "id": "009342",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "ルディア王家は、わたし達のした事を",
  "tgt": "卢迪亚王室把我们做的事"
 },
 {
  "id": "009343",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "勝手な行動と責め‥",
  "tgt": "斥为擅自行动‥"
 },
 {
  "id": "009344",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "兄さまは、取り調べを",
  "tgt": "兄长大人则要"
 },
 {
  "id": "009345",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "受けることになりました。",
  "tgt": "接受调查了。"
 },
 {
  "id": "009346",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "{框02}「フーレン族、族長\n{队员02}どの‥\n---\n用意ができたので\n来なさい。",
  "tgt": "{框02}「弗雷恩族族长\n{队员02}大人‥\n---\n已经准备好了\n过来吧。"
 },
 {
  "id": "009347",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "{框03}{立绘C240}「エリーナ‥‥",
  "tgt": "{框03}{立绘C240}「艾莉娜‥‥"
 },
 {
  "id": "009348",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "{框03}{立绘C240}「何を やってるんだ\n俺は‥‥",
  "tgt": "{框03}{立绘C240}「我到底‥‥\n在干什么啊‥‥"
 },
 {
  "id": "009349",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「兄さま‥！",
  "tgt": "{框06}{立绘C140}「兄长大人‥！"
 },
 {
  "id": "009350",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "{框03}{立绘0040}「{队员01}‥！？\nな‥‥、{码0B}どうして ここへ？",
  "tgt": "{框03}{立绘0040}「{队员01}…！？\n怎……，{码0B}怎么会来这里？"
 },
 {
  "id": "009351",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「助けに来ました‥\n兄さま、逃げましょう。",
  "tgt": "{框06}{立绘C140}「我来救您了‥\n兄长大人，快逃吧。"
 },
 {
  "id": "009352",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "{框03}{立绘4240}「そんな事‥‥\n---\nだいいち、どこへ\n逃げようと言うんだ‥？",
  "tgt": "{框03}{立绘4240}「那种事‥‥\n---\n况且，又能逃到\n哪里去‥？"
 },
 {
  "id": "009353",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「ここで、兄さまが‥\n{立绘8141}{特效}し{码0E}‥、{/特效}",
  "tgt": "{框06}{立绘C140}「兄长大人要是在这‥\n{立绘8141}{特效}出事‥、{码0E}‥、{/特效}"
 },
 {
  "id": "009354",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "{框06}{立绘8241}「それに、わたし‥\n{队员02}兄さまと\nいっしょだったら‥\n---\n{立绘C140}どこへだって\n逃げます‥！",
  "tgt": "{框06}{立绘8241}「而且，我‥\n只要和{队员02}兄长大人\n在一起‥\n---\n{立绘C140}无论哪里\n都逃得掉‥！"
 },
 {
  "id": "009355",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "{框03}{立绘C240}「そう‥、だな\n{队员01}‥‥\n---\n{立绘4240}そのとおりだ。",
  "tgt": "{框03}{立绘C240}「说‥得对\n{队员01}‥‥\n---\n{立绘4240}正是如此。"
 },
 {
  "id": "009356",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "{框03}{立绘C240}「それに、ここで\n捕まってると‥\n---\n恐らく、エリーナが\n探し出される事は\nもう、ないだろう‥",
  "tgt": "{框03}{立绘C240}「而且，一直被\n关在这里的话‥\n---\n恐怕，艾莉娜\n也再没有机会\n被找到了吧‥"
 },
 {
  "id": "009357",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "{框03}{立绘4240}「俺たちだけでも\nエリーナが 無事だと‥\n---\n信じてやらないとな‥！？",
  "tgt": "{框03}{立绘4240}「哪怕只有我们\n也要坚信艾莉娜平安‥\n---\n绝不能放弃希望‥！？"
 },
 {
  "id": "009358",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「え‥、{码0B}{立绘8341}はい！\n兄さま‥",
  "tgt": "{框06}{立绘C140}「诶‥、{码0B}{立绘8341}是！\n兄长大人‥"
 },
 {
  "id": "009359",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "{框03}{立绘4240}「よし、逃げるぞ！",
  "tgt": "{框03}{立绘4240}「好，逃吧！"
 },
 {
  "id": "009360",
  "file": "WORLD/AREAE029.EMI",
  "seg": 11,
  "src": "{框03}{立绘4240}「まずは、{色02}フーレンの里{/色}へ‥\n---\n反乱など 起こさぬよう\n言っておかねば‥",
  "tgt": "{框03}{立绘4240}「先去{色02}弗雷恩村{/色}…\n---\n得叮嘱他们\n不可叛乱…"
 },
 {
  "id": "009361",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "るーぷさばく。",
  "tgt": "鲁普沙漠。"
 },
 {
  "id": "009362",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "お城を出て3日目。",
  "tgt": "离开城堡第3天。"
 },
 {
  "id": "009363",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "明け方、私たちの砂船は",
  "tgt": "拂晓，我们的砂船"
 },
 {
  "id": "009364",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "大砂漠にさしかかった。",
  "tgt": "驶入了大沙漠。"
 },
 {
  "id": "009365",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "エリーナ姉さまの",
  "tgt": "艾莉娜姐姐的"
 },
 {
  "id": "009366",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "行方が分からなくなった",
  "tgt": "下落变得不明"
 },
 {
  "id": "009367",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "セネスタの町まで‥",
  "tgt": "是直到塞内斯塔镇‥"
 },
 {
  "id": "009368",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "砂漠をこえれば",
  "tgt": "只要越过沙漠"
 },
 {
  "id": "009369",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "もうすぐでした。",
  "tgt": "就快到了。"
 },
 {
  "id": "009370",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "{框05}{立绘4100}「兄さま、流れ星！",
  "tgt": "{框05}{立绘4100}「兄长，流星！"
 },
 {
  "id": "009371",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "{框06}{立绘4100}「兄さま‥{码0B}‥\n---\n姉さま、見つかりますよね。",
  "tgt": "{框06}{立绘4100}「兄长…{码0B}…\n---\n姐姐一定能找到的，对吧。"
 },
 {
  "id": "009372",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "{框05}{立绘C240}「ああ‥、{码0B}必ず。",
  "tgt": "{框05}{立绘C240}「嗯‥，一定。{码0B}必ず。"
 },
 {
  "id": "009373",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "{立绘8000}「ふう、{码0B}あつ‥‥。",
  "tgt": "{立绘8000}「呼，{码0B}热……。"
 },
 {
  "id": "009374",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "{立绘0100}「あ‥、{码0B}だいじょうぶです\n兄さま‥！",
  "tgt": "{立绘0100}「啊…，{码0B}没事的\n兄长…！"
 },
 {
  "id": "009375",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "{框06}{立绘8241}「いや‥、やはり\n日中の移動は、つらいな‥\n---\n{立绘C240}「どこか、岩カゲを見つけて\n日ぐれまで、休もう‥",
  "tgt": "{框06}{立绘8241}「不行‥果然\n白天赶路，太辛苦了‥\n---\n{立绘C240}「找个岩石的阴凉\n休息到日落后吧‥"
 },
 {
  "id": "009376",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "{立绘0100}「わたし‥ まだ、へいきです\nそれより‥‥\n---\n{立绘4100}「早く、姉さまを‥",
  "tgt": "{立绘0100}「我…还没事\n比起这个……\n---\n{立绘4100}「快点，姐姐…"
 },
 {
  "id": "009377",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "{框06}{立绘C240}「ここまで来て\nあわてる事はない。\n---\n休んでも、明日には‥",
  "tgt": "{框06}{立绘C240}「都到这儿了\n不必慌张。\n---\n休息一下，明天也能‥"
 },
 {
  "id": "009378",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "{框04}{立绘C240}「なんだ‥！？{延时30}",
  "tgt": "{框04}{立绘C240}「什么‥！？{延时30}"
 },
 {
  "id": "009379",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "{立绘8341}「竜っ！？",
  "tgt": "{立绘8341}「龙！？"
 },
 {
  "id": "009380",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "{立绘4200}「この砂漠に‥\n竜がいるとは、闻いていたが‥",
  "tgt": "{立绘4200}「虽然听说\n这沙漠里有龙…"
 },
 {
  "id": "009381",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "{框06}{立绘8400}「兄さま、来ます！",
  "tgt": "{框06}{立绘8400}「兄长，来了！"
 },
 {
  "id": "009382",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "{立绘4200}「つかまってろ！{延时20}",
  "tgt": "{立绘4200}「抓稳了！{延时20}"
 },
 {
  "id": "009383",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "{立绘C140}「竜が、人を おそうなんて‥{延时40}",
  "tgt": "{立绘C140}「龙，竟然袭击人类‥{延时40}"
 },
 {
  "id": "009384",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "{立绘C240}「おそう気が、なくても‥\nあんなのに ぶつかったら\nこんな船、バラバラだっ！{延时60}",
  "tgt": "{立绘C240}「就算没有袭击的性子‥\n撞上那种东西\n这船也会散架的！{延时60}"
 },
 {
  "id": "009385",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "{立绘C240}「くそっ、何だって‥{延时30}",
  "tgt": "{立绘C240}「可恶，怎么回事‥{延时30}"
 },
 {
  "id": "009386",
  "file": "WORLD/AREAE030.EMI",
  "seg": 13,
  "src": "{立绘8341}「ダメだ！ 当たる！{延时20}",
  "tgt": "{立绘8341}「不好！要撞上！{延时20}"
 },
 {
  "id": "009387",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "ますとのうえ",
  "tgt": "桅杆之上"
 },
 {
  "id": "009388",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘8040}「ど、{码0B}どうだ‥\n高いだろう‥、怖いだろう？\n---\nやめるんだったら\n今のうちだぜ‥！？",
  "tgt": "{立绘8040}「怎、怎么样‥\n很高吧‥、很怕吧？\n---\n要是不想玩了\n现在还来得及‥！？{码0B}どうだ‥\n高いだろう‥、怖いだろう？\n---\nやめるんだったら\n今のうちだぜ‥！？"
 },
 {
  "id": "009389",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘4100}「すごく、いいながめです。\nわくわく しますね‥",
  "tgt": "{立绘4100}「风景真好。\n让人心潮澎湃呢…"
 },
 {
  "id": "009390",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘4100}「さ、それじゃ\n決闘しましょう‥\n---\n{立绘0101}よろしく お願いしますね\nツネキチさん。",
  "tgt": "{立绘4100}「来，那就\n决斗吧…\n---\n{立绘0101}请多指教\n常吉先生。"
 },
 {
  "id": "009391",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框21}ツネキチの 体当たりを\n{色0A}×{/色}ボタンで、ジャンプして\nかわして下さい。\n---\n上手くかわして、ツネキチを\nマストから 落とせば\n{队员01}の 勝ちです。",
  "tgt": "{框21}常吉会冲撞过来\n请按×键\n起跳躲避。\n---\n成功躲避后，把常吉\n从桅杆上撞落\n即{色0A}获胜。{/色}ボタンで、ジャンプして\nかわして下さい。\n---\n上手くかわして、ツネキチを\nマストから 落とせば\n{队员01}の 勝ちです。"
 },
 {
  "id": "009392",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0000}「{特效}の〜〜っっ！{码0E}{/特效}\n",
  "tgt": "{立绘0000}「{特效}诺～～！{码0E}{/特效}\n"
 },
 {
  "id": "009393",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘8242}「どうだ、海の上は‥？\n気持ちいいだろう。",
  "tgt": "{立绘8242}「如何，大海上‥？\n很惬意吧。"
 },
 {
  "id": "009394",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘8242}「さあて、それで‥\nどこへ向かえば、いいんだ？",
  "tgt": "{立绘8242}「那么，接下来‥\n该往哪儿开才好？"
 },
 {
  "id": "009395",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框05}{立绘4200}「俺たちを‥\n帝国まで、運んで欲しい。",
  "tgt": "{框05}{立绘4200}「希望你能\n把我们运到帝国。"
 },
 {
  "id": "009396",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘8242}「ふむ‥、西側の大陸か‥\n---\n船で、直通ってワケには\nいかねぇな‥",
  "tgt": "{立绘8242}「唔姆‥、西侧大陆啊‥\n---\n船没法\n直达那儿‥"
 },
 {
  "id": "009397",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘8242}「だが、船で 近くまで行って\nそこから‥\n---\nあさせを 伝って\n上陸できるって 闻いてるよ。\n---\nまあ、何とかなるんじゃ\nねぇかな‥",
  "tgt": "{立绘8242}「不过，听说可以先开船\n到附近‥\n---\n再沿着浅滩\n登陆上岸。\n---\n总会有办法的\n吧‥"
 },
 {
  "id": "009398",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘8242}「それまでの、何日か‥\n船の旅を 楽しむこった‥！",
  "tgt": "{立绘8242}「在那之前的几天‥\n就好好享受航程吧‥！"
 },
 {
  "id": "009399",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘8040}「異常、なーし‥！",
  "tgt": "{立绘8040}「一切，正常——‥！"
 },
 {
  "id": "009400",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0101}「海の上って‥\n気持ちいいですね\n{队员00}‥",
  "tgt": "{立绘0101}「海上…\n真舒服啊\n{队员00}…"
 },
 {
  "id": "009401",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘4100}「ちょっと、船の中を\n見て回りましょうか‥？",
  "tgt": "{立绘4100}「要不要去\n船里转转…？"
 },
 {
  "id": "009402",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0003}「今回の、船のルートには\n大して危険な場所は\nなかったと思うから‥\n---\nま、のんびり してなよー。",
  "tgt": "{立绘0003}「这次航线\n没什么特别危险的地方…\n---\n嘛，你们放心悠闲吧。"
 },
 {
  "id": "009403",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘4300}「ぴすー",
  "tgt": "{立绘4300}「呼咝…"
 },
 {
  "id": "009404",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0304}「あたしも、海の上は\n初めてだよ‥\n---\n{立绘4500}‥って、言ってます。",
  "tgt": "{立绘0304}「我也是\n第一次到海上…\n---\n{立绘4500}…是这么说的。"
 },
 {
  "id": "009405",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框05}{立绘0405}「何かが‥、この船を\n追ってきて‥\n---\n体当たり してるみたいだ‥",
  "tgt": "{框05}{立绘0405}「有什么东西‥在\n追着这艘船‥\n---\n好像在用身体撞船‥"
 },
 {
  "id": "009406",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框04}{立绘8242}「クジラ‥？ イルカ‥？\n---\nいや‥、何だ ありゃ！？",
  "tgt": "{框04}{立绘8242}「鲸鱼‥？海豚‥？\n---\n不对‥、那是什么！？"
 },
 {
  "id": "009407",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框05}{立绘0506}「ふっはー！\n---\nきたえ抜いた、この体！\nあのていどで\nやられは せぬわ！",
  "tgt": "{框05}{立绘0506}「呼哈——！\n---\n这具千锤百炼之躯！\n区区那种程度\n可打不倒我！"
 },
 {
  "id": "009408",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框05}{立绘0506}「お前たちには、何度も\nおくれを とったが‥\n---\nそれも、ここまでだ\nぬっ{码0B}ふーん！\n---\nあら海に もまれた\nこの俺様の\n技を 食らえぇ〜い！",
  "tgt": "{框05}{立绘0506}「虽然输给\n你们好多次‥\n---\n到此为止了\n哼噗——！\n---\n尝尝我在大海里\n千锤百炼的\n这招吧——！{码0B}ふーん！\n---\nあら海に もまれた\nこの俺様の\n技を 食らえぇ〜い！"
 },
 {
  "id": "009409",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框8B}{立绘0506}「どぅはっ！{延时30}",
  "tgt": "{框8B}{立绘0506}「咚哈！{延时30}"
 },
 {
  "id": "009410",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框03}{立绘4100}「い、いいんですか‥\n---\n助けないでも？",
  "tgt": "{框03}{立绘4100}「这、这样好吗…\n---\n不去救吗？"
 },
 {
  "id": "009411",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框02}{立绘8242}「あいつ‥、海の男の\n修行したいって\nオレの所に 来たんだけど‥\n---\nあのとおり、ケンカばかり\nしててなぁ‥",
  "tgt": "{框02}{立绘8242}「那家伙‥说是想\n修习海之男\n来我这儿拜师‥\n---\n结果就像这样\n整天只知道打架‥"
 },
 {
  "id": "009412",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框02}{立绘8242}「あんたらに、負けて\nいいクスリに なったろう‥",
  "tgt": "{框02}{立绘8242}「输给你们\n也算吃了剂良药吧‥"
 },
 {
  "id": "009413",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框02}{立绘8242}「ま、心配しなくても\nあの様子なら‥\n---\nイルカに 助けられて\n町まで 归るだろ‥",
  "tgt": "{框02}{立绘8242}「嘛，不用担心\n看他那样子‥\n---\n会有海豚救他\n游回镇上的‥"
 },
 {
  "id": "009414",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "‥それから、しばらく",
  "tgt": "‥在那之后，有一阵子"
 },
 {
  "id": "009415",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "わたし達の 船の旅は",
  "tgt": "我们的海上航行"
 },
 {
  "id": "009416",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "何事もなく 行きました。",
  "tgt": "一路平安无事。"
 },
 {
  "id": "009417",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘4500}「{队员01}は\nマストの上で\n見張りを してますよ。\n---\n高いところ 好きですね。",
  "tgt": "{立绘4500}「{队员01}\n在桅杆上\n望风哦。\n---\n真喜欢高处呢。"
 },
 {
  "id": "009418",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0202}「大船に乘った気で\n安心してな‥\nと、言いたいところだが‥\n---\n風が、止まっちまった。\nおかしいな‥",
  "tgt": "{立绘0202}「想让你们\n安心乘船‥\n话是这么说‥\n---\n可风，停了。\n怪了‥"
 },
 {
  "id": "009419",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0000}「ひょっとして、マップを\n讀みちがえたかなぁ‥",
  "tgt": "{立绘0000}「该不会是\n看错地图了吧…"
 },
 {
  "id": "009420",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框02}{立绘C140}「ジグさん！\n島が 見えます‥！",
  "tgt": "{框02}{立绘C140}「吉格先生！\n能看见岛了‥！"
 },
 {
  "id": "009421",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框06}{立绘8040}「兄キ、島って\nもしかして‥！？",
  "tgt": "{框06}{立绘8040}「老大，那岛\n莫非是‥！？"
 },
 {
  "id": "009422",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0202}「ああ、どうやら\nマズい場所に\n迷いこんだ らしい‥\n---\nくそ、オレとした事が‥！",
  "tgt": "{立绘0202}「啊，看来我们\n迷路闯进了\n麻烦的地方‥\n---\n可恶，我竟会‥！"
 },
 {
  "id": "009423",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘8202}「ここは、{色02}火の山島{/色}という\n島の近くで‥\n---\n魔神の海と 呼ばれる\n边りなんだ‥",
  "tgt": "{立绘8202}「这里是{色02}火山岛{/色}\n附近的海域…\n---\n被称作\n魔神之海的地方…"
 },
 {
  "id": "009424",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘8040}「それで‥、その島に\n神様が いて‥\n---\n気まぐれに 風を止めたり\n高波を おこしたりして‥\n---\nたくさんの船が\n沈められて いるんだ‥！",
  "tgt": "{立绘8040}「然后‥那座岛上\n住着一位神‥\n---\n会心血来潮地止住风\n掀起巨浪‥\n---\n很多船\n都被他弄沉了‥！"
 },
 {
  "id": "009425",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0202}「つまり‥、その\n神様の 気が変わって‥\n---\n風が ふくまで\n船が 動かせねぇって\nことなんだ。",
  "tgt": "{立绘0202}「也就是说‥那位\n神大人心血来潮‥\n---\n不到风起\n船就动不了\n就是这个意思。"
 },
 {
  "id": "009426",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框06}{立绘C140}「でも、{队员00}‥\n---\nその島の 神様って\nひょっとしたら‥\n---\n竜の化身かも\n知れませんね？",
  "tgt": "{框06}{立绘C140}「不过，{队员00}…\n---\n那座岛的神明\n说不定…\n---\n就是龙的\n化身呢？"
 },
 {
  "id": "009427",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框06}{立绘C140}「ジグさん‥\nその島に 上陸することは\nできますか？",
  "tgt": "{框06}{立绘C140}「吉格先生‥\n我们可以登上\n那座岛吗？"
 },
 {
  "id": "009428",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0202}「そりゃ、できない事は\nねぇけど‥\n---\nさっきも 言ったとおり\nヤバいかも 知れねぇぞ？",
  "tgt": "{立绘0202}「那倒不是\n做不到‥\n---\n可就像刚才说的\n搞不好会有危险哦？"
 },
 {
  "id": "009429",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0202}「だったら、そこの\nボートを 使って\n島へ 行けばいいぜ‥\n---\nツネキチ！\nおめぇ、ボートを\nこいでやりな‥！",
  "tgt": "{立绘0202}「那就用那边的\n小艇\n上岛就行‥\n---\n常吉！\n你给他们\n划船‥！"
 },
 {
  "id": "009430",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘8040}「じゃ、{码0B}じゃあ‥\n---\n島に行く 用意が\nできたら‥\n---\nおれに 声をかけてよ。\nボートを 出してやるから‥",
  "tgt": "{立绘8040}「那、那‥\n---\n等你们做好\n上岛准备‥\n---\n就叫我一声。\n我把小艇放下去‥{码0B}じゃあ‥\n---\n島に行く 用意が\nできたら‥\n---\nおれに 声をかけてよ。\nボートを 出してやるから‥"
 },
 {
  "id": "009431",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0304}「竜の化身‥？\n---\nどうも、そんな気配は\nしないけどねぇ‥\n---\n{立绘0607}って、言ってます。",
  "tgt": "{立绘0304}「龙的化身‥？\n---\n总感觉没有\n那种气息呢‥\n---\n{立绘0607}它是这么说的。"
 },
 {
  "id": "009432",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0202}「島へ、行くんなら\nそのボートで‥\n---\nツネキチに、ボートを\nこがせるよ。",
  "tgt": "{立绘0202}「要上岛\n就用那艘小艇‥\n---\n我会让常吉\n给你们划。"
 },
 {
  "id": "009433",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0000}「島に行く、用意は\nいいのか‥？\n---\nじゃ、ボート出すよ‥？{码14000C82}お願い\n待って",
  "tgt": "{立绘0000}「去岛上的\n准备做好了吗…？\n---\n那，放小艇了哦…？{码14000C82}拜托了\n等等"
 },
 {
  "id": "009434",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0000}「よし、出発！",
  "tgt": "{立绘0000}「好，出发！"
 },
 {
  "id": "009435",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框04}{立绘8040}「ここから、上陸できるよ‥",
  "tgt": "{框04}{立绘8040}「从这里，就能上岸了‥"
 },
 {
  "id": "009436",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框04}{立绘8040}「おれは、ここで\n待ってるから‥\n---\n船に戻るときは\nここまで、来てくれ‥",
  "tgt": "{框04}{立绘8040}「我就在这里\n等着‥\n---\n要回船上时\n就到这里来‥"
 },
 {
  "id": "009437",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0000}「‥船に 戻るかい？{码14010C82}はい\nいいえ",
  "tgt": "{立绘0000}「…要回船上吗？{码14010C82}是\n否"
 },
 {
  "id": "009438",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0000}「じゃ、戻ろう‥\nここは、壊れた船\nばっかりで‥\n---\n気味が悪いよ‥",
  "tgt": "{立绘0000}「那就回去吧…\n这里全是\n破船…\n---\n怪渗人的…"
 },
 {
  "id": "009439",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0000}「また、島に行きたければ\nおれに 言ってくれ‥\nボートを 出すよ。",
  "tgt": "{立绘0000}「还想上岛的话\n跟我说一声…\n我放小艇。"
 },
 {
  "id": "009440",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0000}「また、火の山島へ\n渡るかい？{码14000C82}はい\nいいえ",
  "tgt": "{立绘0000}「还要再渡去\n火山岛吗？{码14000C82}是\n否"
 },
 {
  "id": "009441",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框05}{立绘0708}「なんだあ‥\n神様に お供えでも\n持ってきたのが？",
  "tgt": "{框05}{立绘0708}「什么人啊‥\n是给神带来\n供品的吗？"
 },
 {
  "id": "009442",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框06}{立绘8841}「こ、{码0B}こんにちは‥\n---\nえーと‥\n海の竜さん ですか？",
  "tgt": "{框06}{立绘8841}「你、你好‥\n---\n那个‥\n您是海之龙吗？{码0B}こんにちは‥\n---\nえーと‥\n海の竜さん ですか？"
 },
 {
  "id": "009443",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框06}{立绘C540}「うつろわざるもの、なのか\nどうなのか‥\nって、言ってますよ。",
  "tgt": "{框06}{立绘C540}「它在问你们\n是不是不变不易者‥\n哦。"
 },
 {
  "id": "009444",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框06}{立绘0304}「ちがうみたいだね‥\n気配が しないよ。\n---\n{立绘0909}って、言ってます。",
  "tgt": "{框06}{立绘0304}「好像不是呢‥\n感觉不到那种气息。\n---\n{立绘0909}它这么说。"
 },
 {
  "id": "009445",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框05}{立绘0708}「うう‥\nお供え、ないのが？\n---\nむずかしい事、ばっかり言って\nバカにしたなー！？\n---\nころすー！",
  "tgt": "{框05}{立绘0708}「呜哇‥\n连供品，都没带？\n---\n净说些听不懂的话\n瞧不起我啊！？\n---\n杀了你们——！"
 },
 {
  "id": "009446",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框06}{立绘8304}「世界に、竜の気が\n高まると‥\n---\n今みたいに、魔の物が\nえいきょうを うけて‥\n---\n神様に なったつもりに\nなっちゃうんだ‥",
  "tgt": "{框06}{立绘8304}「世界的龙气\n一旦高涨‥\n---\n魔物就会像这样\n受到影响‥\n---\n错以为\n自己成了神‥"
 },
 {
  "id": "009447",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框06}{立绘8304}「{队员00}が\n半身と、分かれてるから‥\n---\n竜の気が 乱れて\nいるのかも しれないねぇ‥\n---\n{立绘8607}って、言ってます。",
  "tgt": "{框06}{立绘8304}「因为{队员00}\n与半身分离…\n---\n龙之气可能\n因此紊乱…\n---\n{立绘8607}是这么说的。"
 },
 {
  "id": "009448",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "ただの石のようだ。",
  "tgt": "似乎只是块普通的石头。"
 },
 {
  "id": "009449",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘C140}「風が、戻りましたね。",
  "tgt": "{立绘C140}「风，回来了呢。"
 },
 {
  "id": "009450",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框05}{立绘8344}「世界に 滿ちる\n竜の気の‥\n---\nえいきょうを うけやすい\n魔物が、力をつけると\nタチが悪いね‥\n---\n{立绘C540}って言ってます。",
  "tgt": "{框05}{立绘8344}「充盈世界的\n龙气‥\n---\n最受其影响的魔物\n一旦得势\n就麻烦了‥\n---\n{立绘C540}它是这么说的。"
 },
 {
  "id": "009451",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘4100}「本当の 海の竜は\nどこに いるんでしょうね‥\n---\n海って すごく大きいから\n探すのが 難しそう‥",
  "tgt": "{立绘4100}「真正的海龙\n会在哪里呢…\n---\n海那么大\n找起来好像很难…"
 },
 {
  "id": "009452",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0304}「ただの 石ころでも‥\n---\n長い間、いろんな気を\nあび續けたら\n魔物に なる事もある‥\n---\n{立绘4500}さっきのも、そんなだろう\nって、言ってます。",
  "tgt": "{立绘0304}「就算是普通石块…\n---\n长年累月\n受各种气息熏陶\n也可能成魔物…\n---\n{立绘4500}刚才那个\n也是这样，是这么说的。"
 },
 {
  "id": "009453",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0000}「あとは、もう\n何にも 起こらないと\n思うぜ‥、たぶん。",
  "tgt": "{立绘0000}「之后应该\n不会再发生\n什么事了…，大概。"
 },
 {
  "id": "009454",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0003}「火の山島‥\n魔物が いっぱい\nいるんじゃ ないかい？\n---\n{金钱00}ところで‥\n何か、要る物ある？{码14840C94}買い物しよう\n持ち物を売ろう\n下取りをしてもらおう\n今は、用がない",
  "tgt": "{立绘0003}「火山岛…\n不是有很多\n魔物吗？\n---\n{金钱00}话说…\n需要点什么吗？{码14840C94}买点东西\n卖点东西\n折卖换钱\n现在不用"
 },
 {
  "id": "009455",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框21}{打字02}ツネキチを 後ろから\n突き飛ばして‥\n---\n時間內に マストの上から\n落とせば、クリアです\n---\n{色0A}×{/色}ボタンで、ジャンプし\nツネキチの 頭をふむと\nスキができます‥\n---\nその間に 後ろから\n体当たりして\n突き飛ばしてください\n---\n{色0A}□{/色}ボタンの ダッシュを\nうまく使って‥\n思いっきり行くのが コツ。\n---\n\n  もう一度、說明を讀みますか？{码14020C82}はい\nいいえ",
  "tgt": "{框21}{打字02}从背后\n撞飞常吉‥\n---\n在时间内把他从\n桅杆上撞落即算过关\n---\n按×键起跳\n踩到常吉头上\n可让其露出破绽‥\n---\n趁此时从背后\n用身体撞击\n把他撞下去吧\n---\n善用□键的\n冲刺‥\n全力出击是诀窍。\n---\n\n要再读一遍说明吗？是\n否{色0A}×{/色}ボタンで、ジャンプし\nツネキチの 頭をふむと\nスキができます‥\n---\nその間に 後ろから\n体当たりして\n突き飛ばしてください\n---\n{色0A}□{/色}ボタンの ダッシュを\nうまく使って‥\n思いっきり行くのが コツ。\n---\n\n  もう一度、說明を讀みますか？{码14020C82}はい\nいいえ"
 },
 {
  "id": "009456",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{框21}{打字02}   TIME BONUS！\n     {色02}{占位00}{/色}PTS",
  "tgt": "{框21}{打字02}   TIME BONUS！\n     {色02}{占位00}{/色}PTS"
 },
 {
  "id": "009457",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0000}「もうじき、目的地の\n{色02}リプ村{/色}に 着くよ‥！",
  "tgt": "{立绘0000}「快到目的地\n{色02}莉普村{/色}了…！"
 },
 {
  "id": "009458",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘4200}「リプ村から、西大陸まで\nけっこう 遠いらしい‥\n---\n長い旅に なりそうだな‥",
  "tgt": "{立绘4200}「从莉普村到\n西大陆好像挺远…\n---\n看来是场长途旅行啊…"
 },
 {
  "id": "009459",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0801}「海の風で、べとべと。\nあー、おフロ入りたいな‥",
  "tgt": "{立绘0801}「海风吹得黏糊糊。\n啊——好想泡澡啊‥"
 },
 {
  "id": "009460",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "{立绘0202}「おう、{码0B}そろそろ\nリプの村が、見えるころだぜ‥",
  "tgt": "{立绘0202}「哦，差不多\n能望见莉普村了吧‥{码0B}そろそろ\nリプの村が、見えるころだぜ‥"
 },
 {
  "id": "009461",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "それは、力を うしない",
  "tgt": "从此失去力量"
 },
 {
  "id": "009462",
  "file": "WORLD/AREAE031.EMI",
  "seg": 9,
  "src": "人として、生きてゆく事でした。",
  "tgt": "以凡人之身度过余生。"
 },
 {
  "id": "009463",
  "file": "WORLD/AREAE032.EMI",
  "seg": 11,
  "src": "{框21}\n   操作の說明を讀みますか？{码14000C82}はい\nいいえ",
  "tgt": "{框21}\n   要读操作说明吗？{码14000C82}是\n否"
 },
 {
  "id": "009464",
  "file": "WORLD/AREAE032.EMI",
  "seg": 11,
  "src": "{框21}クレーンを操作して、荷物を\n船に つみこみます。\n---\n方向キーの上下左右で\nクレーンの 「アーム」を操作して\n---\nフックが 荷物の真上まで\nきたら{色0A}○{/色}ボタン！\n---\n成功なら、荷物を\n持ち上げることができます。\n---\n持ち上げた荷物は\nもう一度{色0A}○{/色}ボタンで\n船の上に おろす事ができます\n---\n船に置ける荷物は 最大10コまで\n決められた時間內に できるだけ多く\nつみこんでください。\n---\nフックの真下にできる 「かげ」を\n目印に、クレーンを操作するのが\nうまく荷物を置くコツです。\n---\n{色03}水色{/色}のマークが 出ている場所に\n荷物を置くと、ボーナスポイントが\n入るので高得点のチャンス！\n---\n\n  もう一度、說明を讀みますか？{码14000C82}はい\nいいえ",
  "tgt": "{框21}操控起重机\n把货物装上船。\n---\n用方向键上下左右\n操控起重机的「吊臂」\n---\n吊钩升到货物正上方时\n按{色0A}○{/色}键！\n---\n成功的话\n就能吊起货物。\n---\n吊起的货物\n再按一次{色0A}○{/色}键\n就能放到船上\n---\n船上最多放10件货\n请在限定时间内\n尽量多装。\n---\n以吊钩正下方的「影子」\n为标记操控起重机\n是放准货物的诀窍。\n---\n放到有{色03}水色{/色}标记的地方\n可得奖励分\n是得高分的机会！\n---\n\n  要再读一次说明吗？{码14000C82}是\n否"
 },
 {
  "id": "009465",
  "file": "WORLD/AREAE032.EMI",
  "seg": 11,
  "src": "{框01}{打字02}     タイムボーナス！     \n      {色02}{占位00}{/色}PTS.\n{码0B}{码0B}{码0B}",
  "tgt": "{框01}{打字02}     时间奖励！     \n      {色02}{占位00}{/色}PTS.\n{码0B}{码0B}{码0B}"
 },
 {
  "id": "009466",
  "file": "WORLD/AREAE033.EMI",
  "seg": 9,
  "src": "{立绘0000}「食い物が なくなったんで\n港へ归るぜ‥！",
  "tgt": "{立绘0000}「吃的没了\n就回港咯…！"
 },
 {
  "id": "009467",
  "file": "WORLD/AREAE033.EMI",
  "seg": 9,
  "src": " 北の風",
  "tgt": "北风"
 },
 {
  "id": "009468",
  "file": "WORLD/AREAE033.EMI",
  "seg": 9,
  "src": "北東の風",
  "tgt": "东北风"
 },
 {
  "id": "009469",
  "file": "WORLD/AREAE033.EMI",
  "seg": 9,
  "src": " 東の風",
  "tgt": "东风"
 },
 {
