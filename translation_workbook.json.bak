  "src": "{色02}滿足{/色}",
  "tgt": "{色02}满足{/色}"
 },
 {
  "id": "013218",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "{色03}醉い{/色}",
  "tgt": "{色03}醉意{/色}"
 },
 {
  "id": "013219",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "あっさり食事",
  "tgt": "清淡餐食"
 },
 {
  "id": "013220",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "かるいお酒",
  "tgt": "低度酒"
 },
 {
  "id": "013221",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "こってり食事",
  "tgt": "浓味餐食"
 },
 {
  "id": "013222",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "きついお酒",
  "tgt": "烈酒"
 },
 {
  "id": "013223",
  "file": "WORLD/AREAS001.EMI",
