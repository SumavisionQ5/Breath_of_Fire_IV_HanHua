 {
  "id": "002890",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キーで 画面フレームを調整してください\n>{色0A}×{/色}で 終了（決定）",
  "tgt": "用方向键调整画面边框\n>按×结束（确定）{色0A}×{/色}で 終了（決定）"
 },
 {
  "id": "002891",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー上下：コマンドを選択\n方向キー左右：前·後衛のきりかえ\n---\n{色0A}□{/色}：ステータスのきりかえ\n{色0A}○{/色}：決定  {色0A}×{/色}サブ画面の終了\n---\n{色0A}△{/色}：サブ画面の終了\n  （設定·セーブモードいがいで\n  ゆうこうです）",
  "tgt": "方向键上下：选择指令\n方向键左右：切换前·后排\n---\n□：切换状态\n○：确定×关闭子画面\n---\n△：关闭子画面\n（设置·存档模式外\n有效）{色0A}□{/色}：ステータスのきりかえ\n{色0A}○{/色}：決定  {色0A}×{/色}サブ画面の終了\n---\n{色0A}△{/色}：サブ画面の終了\n  （設定·セーブモードいがいで\n  ゆうこうです）"
 },
 {
  "id": "002892",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー上下：コマンドを選択\n方向キー左右：リストのきりかえ\n---\nL1·L2：ページアップ\nR1·R2：ページダウン\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "方向键上下：选择指令\n方向键左右：切换列表\n---\nL1·L2：上翻页\nR1·R2：下翻页\n○：确定×：取消{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "002893",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー上下：カーソル移動\n方向キー左右：リストのきりかえ\n{色0A}□{/色}  ：データのきりかえ\n---\nL1·L2：ページアップ\nR1·R2：ページダウン\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "方向键上下：移动光标\n方向键左右：切换列表\n□：切换数据\n---\nL1·L2：上翻页\nR1·R2：下翻页\n○：确定×：取消{色0A}□{/色}  ：データのきりかえ\n---\nL1·L2：ページアップ\nR1·R2：ページダウン\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "002894",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー：アイテムを 誰に使うか選択\n{色0A}□{/色}：データのきりかえ\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "方向键：选择对谁使用道具\n□：切换数据\n○：确定×：取消{色0A}□{/色}：データのきりかえ\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "002895",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "つぎの方法で整理をおこなってください\n1.入れかえたいアイテムを選びます\n2.移動先を 決定してください\n---\n方向キー上下：カーソル移動\n方向キー左右：リストのきりかえ\n（方向キー左右は「2」では無効です）\n---\nL1·L2：ページアップ\nR1·R2：ページダウン\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "请按以下方法整理\n1.选择要交换的道具\n2.确定移动目标\n---\n方向键上下：移动光标\n方向键左右：切换列表\n（步骤「2」中左右无效）\n---\nL1·L2：上翻页\nR1·R2：下翻页\n○：确定×：取消{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "002896",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー上下：カーソル移動\n方向キー左右：リストのきりかえ\n---\nL1·L2：ページアップ\nR1·R2：ページダウン\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "方向键上下：选择指令\n方向键左右：切换列表\n---\nL1·L2：上翻页\nR1·R2：下翻页\n○：确定×：取消{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "002897",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー：カーソルの移動\n{色0A}□{/色}：データのきりかえ\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "方向键：移动光标\n□：切换数据\n○：确定×：取消{色0A}□{/色}：データのきりかえ\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "002898",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー左右：メンバーのきりかえ\n \n{色0A}×{/色}：メンバー選択画面に戻る",
  "tgt": "方向键左右：切换成员\n\n×：返回成员选择画面{色0A}×{/色}：メンバー選択画面に戻る"
 },
 {
  "id": "002899",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "つぎの方法で 並びかえをおこなえます\nちゅうい！イベントにより、並びが\n自動でへんこうされる事もあります\n---\n1.並びをかえたいメンバーを選択\n2.移動先を 決定してください\n---\n{码0E}EMPTYには 移動できません\n方向キー：カーソル移動\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "可按以下方法排序\n注意！随事件发生\n排列也可能自动变化\n---\n1.选择要改变排列的成员\n2.确定移动目标\n---\n无法移到EMPTY\n方向键：移动光标\n○：确定×：取消{码0E}EMPTYには 移動できません\n方向キー：カーソル移動\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "002900",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー上下：コマンドを選択\n{色0A}○{/色}：決定\n{色0A}×{/色}：ゲーム設定の終了",
  "tgt": "方向键上下：选择指令\n○：确定\n×：结束游戏设置{色0A}○{/色}：決定\n{色0A}×{/色}：ゲーム設定の終了"
 },
 {
  "id": "002901",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー上下：設定かしょの選択\n方向キー左右：設定のへんこう\n{色0A}×{/色}：キャンセル",
  "tgt": "方向键上下：选择设置项\n方向键左右：更改设置\n×：取消{色0A}×{/色}：キャンセル"
 },
 {
  "id": "002902",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー左右：ボタン設定の選択\n \n{色0A}×{/色}：ゲーム設定画面に戻る（決定）",
  "tgt": "方向键左右：选择按键设置\n\n×：返回游戏设置画面（确定）{色0A}×{/色}：ゲーム設定画面に戻る（決定）"
 },
 {
  "id": "002903",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー：画面ポジションの調整\n \n{色0A}×{/色}：ゲーム設定画面に戻る（決定）",
  "tgt": "方向键：调整画面位置\n\n×：返回游戏设置画面（确定）{色0A}×{/色}：ゲーム設定画面に戻る（決定）"
 },
 {
  "id": "002904",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "イベントに必要な 大事なアイテムです\nこれらを使用することはできません\n---\n方向キー上下：カーソルの移動\n{色0A}×{/色}：キャンセル",
  "tgt": "事件所需的重要道具\n这些道具无法使用\n---\n方向键上下：移动光标\n×：取消{色0A}×{/色}：キャンセル"
 },
 {
  "id": "002905",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー上下：コマンドを選択\n \n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "方向键上下：选择指令\n\n○：确定×：取消{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "002906",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー：特能を使うメンバーを選択\n \n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル\n---\nL1·L2：特能リストのページアップ\nR1·R2：特能リストのページダウン",
  "tgt": "方向键：选择使用特能的成员\n\n○：确定×：取消\n---\nL1·L2：特能列表上翻页\nR1·R2：特能列表下翻页{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル\n---\nL1·L2：特能リストのページアップ\nR1·R2：特能リストのページダウン"
 },
 {
  "id": "002907",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー上下：カーソル移動\n方向キー左右：リストのきりかえ\n---\nL1·L2：ページアップ\nR1·R2：ページダウン\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "方向键上下：移动光标\n方向键左右：切换列表\n---\nL1·L2：上翻页\nR1·R2：下翻页\n○：确定×：取消{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "002908",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー：特能を誰に使うか選択\n \n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "方向键：选择对谁使用特能\n\n○：确定×：取消{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "002909",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー：誰の特能を整理するか選択\n \n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "方向键：选择整理谁的特能\n\n○：确定×：取消{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "002910",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー上下：コマンドを選択\n方向キー左右：リストのきりかえ\n---\nL1·L2：ページアップ\nR1·R2：ページダウン\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "方向键上下：选择指令\n方向键左右：切换列表\n---\nL1·L2：上翻页\nR1·R2：下翻页\n○：确定×：取消{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "002911",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "つぎの方法で整理をおこなってください\n1.入れかえたい特能を 選びます\n2.移動先を 決定してください\n---\n方向キー上下：カーソル移動\n方向キー左右：リストのきりかえ\n（方向キー左右は「2」では無効です）\n---\nL1·L2：ページアップ\nR1·R2：ページダウン\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "请按以下方法整理\n1.选择要交换的特能\n2.确定移动目标\n---\n方向键上下：移动光标\n方向键左右：切换列表\n（步骤「2」中左右无效）\n---\nL1·L2：上翻页\nR1·R2：下翻页\n○：确定×：取消{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "002912",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー：装備のへんこうをしたい\n     メンバーの選択\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "方向键：选择要更改\n装备的成员\n○：确定×：取消{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "002913",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー：最強装備をさせたい\n     メンバーを選択\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "方向键：选择要让其\n最强装备的成员\n○：确定×：取消{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "002914",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー：装備をはずしたい\n     メンバーの選択\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "方向键：选择要卸下\n装备的成员\n○：确定×：取消{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "002915",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "武器·防具·オプションを それぞれ\n一つずつ装備できます\nへんこうかしょを 選んでください\n---\n方向キー上下：装備かしょの選択\n方向キー左右：メンバーのへんこう\n---\n{色0A}□{/色}：装備をはずす（武器は不可）\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "武器·防具·饰品\n各可装备一件\n请选择要更改的位置\n---\n方向键上下：选择装备位置\n方向键左右：切换成员\n---\n□：卸下装备（武器不可）\n○：确定×：取消{色0A}□{/色}：装備をはずす（武器は不可）\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "002916",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "新しい装備を リストの中から\n選んでください\n---\n方向キー上下：装備品の選択\nL1·L2：ページアップ\nR1·R2：ページダウン\n---\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "请从列表中选择\n新装备\n---\n方向键上下：选择装备\nL1·L2：上翻页\nR1·R2：下翻页\n---\n○：确定×：取消{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "002917",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "はずしたい防具かオプションを\n選んでください\n武器をはずすことはできません\n---\n方向キー上下：装備かしょの選択\n方向キー左右：メンバーのへんこう\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "请选择要卸下的\n防具或饰品\n武器无法卸下\n---\n方向键上下：选择装备位置\n方向键左右：切换成员\n○：确定×：取消{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
