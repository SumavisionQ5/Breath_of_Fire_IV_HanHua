  "seg": 8,
  "src": "{道具7004}",
  "tgt": "{道具7004}"
 },
 {
  "id": "010114",
  "file": "WORLD/AREAE075.EMI",
  "seg": 8,
  "src": "{道具9D04}",
  "tgt": "{道具9D04}"
 },
 {
  "id": "010115",
