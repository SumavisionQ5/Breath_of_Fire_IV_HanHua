 {
  "id": "004127",
  "file": "WORLD/AREAD000.EMI",
  "seg": 11,
  "src": "ダムじょーりゅう。",
  "tgt": "大坝上游。"
 },
 {
  "id": "004128",
  "file": "WORLD/AREAD000.EMI",
  "seg": 11,
  "src": "{立绘4200}「‥ひとっ気がないな？",
  "tgt": "{立绘4200}「…一个人影都没有？"
 },
 {
  "id": "004129",
  "file": "WORLD/AREAD000.EMI",
  "seg": 11,
  "src": "{框04}{立绘C240}「大勢、ひとが働いていると\n闻いていたのだが‥",
  "tgt": "{框04}{立绘C240}「听说有很多人\n在这里干活‥"
 },
 {
  "id": "004130",
  "file": "WORLD/AREAD000.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「何だ、あんたら？",
  "tgt": "{框04}{立绘8040}「怎么了，你们？"
 },
 {
  "id": "004131",
  "file": "WORLD/AREAD000.EMI",
  "seg": 11,
  "src": "{框01}{立绘4100}「すみません‥\n---\n向こう岸まで、行きたいんです\n通っていいですか？",
  "tgt": "{框01}{立绘4100}「不好意思…\n---\n我们想去对岸\n可以过去吗？"
 },
 {
  "id": "004132",
  "file": "WORLD/AREAD000.EMI",
  "seg": 11,
  "src": "{框01}{立绘0040}「そりゃ、かまわんが‥\nあんたら、知らんのか？",
  "tgt": "{框01}{立绘0040}「那倒无所谓…\n你们不知道吗？"
 },
 {
  "id": "004133",
  "file": "WORLD/AREAD000.EMI",
  "seg": 11,
  "src": "{框01}{立绘0040}「‥今の、闻いたろ？\n『竜』が 出たのさ",
  "tgt": "{框01}{立绘0040}「…刚才听到了吧？\n出现『龙』了"
 },
 {
  "id": "004134",
  "file": "WORLD/AREAD000.EMI",
  "seg": 11,
  "src": "{框01}{立绘8040}「この、竜‥\nいっつもは、泥のそこで\nおとなしく してるんだが‥\n---\n最近になって、暴れだしてね\n---\n水門が壊れちゃ、ヤバイって\nみんな、避難してんのさ",
  "tgt": "{框01}{立绘8040}「这条龙‥\n平时都乖乖待在\n泥底下的‥\n---\n最近却开始撒起野来\n---\n水门一坏就危险了\n大家都避难去了"
 },
 {
  "id": "004135",
  "file": "WORLD/AREAD000.EMI",
  "seg": 11,
  "src": "{框01}{立绘0040}「‥んなワケで、あんたらも\nここを通るんなら\n気ィつけて 行くこった",
  "tgt": "{框01}{立绘0040}「…所以啊，你们要是\n也要从这里过\n就小心点走"
 },
 {
  "id": "004136",
  "file": "WORLD/AREAD000.EMI",
  "seg": 11,
  "src": "{框06}{立绘4100}「ありがとう‥\n気をつけます",
  "tgt": "{框06}{立绘4100}「谢谢…\n我们会小心的"
 },
 {
  "id": "004137",
  "file": "WORLD/AREAD000.EMI",
  "seg": 11,
  "src": "{立绘4240}「よし‥、行こう",
  "tgt": "{立绘4240}「好‥，走吧"
 },
 {
  "id": "004138",
  "file": "WORLD/AREAD000.EMI",
  "seg": 11,
  "src": "{立绘0101}「竜が 暴れ出したんで\nみんな 逃げちゃったけど‥\n---\n下流には がめつい連中が\nまだ残ってるよ",
  "tgt": "{立绘0101}「龙一撒野\n大家都逃跑了‥\n---\n可下游还有一群\n贪心的家伙留着呢"
 },
 {
  "id": "004139",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "さるでぃん。",
  "tgt": "萨鲁丁。"
 },
 {
  "id": "004140",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘0000}「コ、サルディン‥\nニ、コール ウェシ！",
  "tgt": "{框05}{立绘0000}「科，萨鲁丁…\n尼，科尔 韦西！"
 },
 {
  "id": "004141",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘C140}「ここを、ずっと行けば‥\n---\n大陸に、着くって\n{立绘8141}ことですよね、ポコさん‥？",
  "tgt": "{立绘C140}「一直往这边走‥\n---\n就能抵达大陆\n{立绘8141}对吧，波科先生‥？"
 },
 {
  "id": "004142",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘0000}「ニ、プレチ\nコール ウェシ！",
  "tgt": "{框05}{立绘0000}「尼，普雷奇\n科尔 韦西！"
 },
 {
  "id": "004143",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘0000}「ポッコ、コール パブパブ\nニ、プレチ\nプカプカ！！",
  "tgt": "{框05}{立绘0000}「波科，科尔 帕布帕布\n尼，普雷奇\n普卡普卡！！"
 },
 {
  "id": "004144",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4100}「それじゃ、行きましょう！",
  "tgt": "{立绘4100}「那么，走吧！"
 },
 {
  "id": "004145",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4300}「ゆう‥‥\n---\nやけ‥‥",
  "tgt": "{立绘4300}「晚…\n---\n霞…"
 },
 {
  "id": "004146",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘0202}「ふふふー‥\n---\nこんな所で、夜になったら\n困るって\n言ってますよ‥",
  "tgt": "{立绘0202}「呵呵呵‥\n---\n他说在这种地方\n天一黑\n可就麻烦了‥"
 },
 {
  "id": "004147",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘0301}「いけない‥\n暗くなって きました‥！",
  "tgt": "{立绘0301}「糟糕‥\n天色暗下来了‥！"
 },
 {
  "id": "004148",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘0403}「いかんな‥\n暗くなってきたぞ。",
  "tgt": "{立绘0403}「不好‥\n天色暗下来了。"
 },
 {
  "id": "004149",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘0504}「急いだほうが\nよさそうだな。",
  "tgt": "{立绘0504}「看来最好\n抓紧些。"
 },
 {
  "id": "004150",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4400}「‥急ごう。",
  "tgt": "{立绘4400}「…快走吧。"
 },
 {
  "id": "004151",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4100}「急ぎましょう‥！",
  "tgt": "{立绘4100}「快走吧…！"
 },
 {
  "id": "004152",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘0605}「急がないと\n見えなく なっちまうよ！\n---\n{立绘4500}「‥って、言ってます。\nふふふふー。",
  "tgt": "{立绘0605}「再不快点\n就看不见了哟！\n---\n{立绘4500}「…是这么说的。\n呼呼呼呼…。"
 },
 {
  "id": "004153",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框02}{立绘8741}「ふう‥‥\n---\n{立绘C140}今日は、これ以上\n無理ですね‥‥",
  "tgt": "{框02}{立绘8741}「呼……\n---\n{立绘C140}今天无法\n再走了……"
 },
 {
  "id": "004154",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框02}{立绘C240}「くっ‥‥\nここまで暗くなると\n道が 見えないな‥",
  "tgt": "{框02}{立绘C240}「唔……\n暗成这样\n路都看不清了‥"
 },
 {
  "id": "004155",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框02}{立绘C440}「すっかり、暗くなったな‥\n---\nひとまず、ここまでに\nした方が 良さそうだ。",
  "tgt": "{框02}{立绘C440}「天已经全黑了‥\n---\n最好先\n到此为止。"
 },
 {
  "id": "004156",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框02}{立绘8645}「もう、暗いから\n今日は、ここまでだね。\n---\n{立绘C540}「って、言ってますよ。",
  "tgt": "{框02}{立绘8645}「天已经黑了\n今天就到这里吧。\n---\n{立绘C540}「他是这么说的。"
 },
 {
  "id": "004157",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘8544}「ふむ‥、しかし‥\n---\nあと、どのくらいだろう‥",
  "tgt": "{立绘8544}「嗯‥，可是‥\n---\n还有多远呢‥"
 },
 {
  "id": "004158",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘C240}「こんな所で、足止めを\nくっていて‥\n---\nだいじょうぶ だろうか‥",
  "tgt": "{立绘C240}「在这样的地方\n被耽搁‥\n---\n不要紧吧‥"
 },
 {
  "id": "004159",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘4100}「今は、あせっても\n仕方ありません\n兄さま‥\n---\n{立绘0101}体を 休めて‥\n明日 がんばりましょう。",
  "tgt": "{框05}{立绘4100}「现在再着急\n也没有用\n兄长…\n---\n{立绘0101}先休息…\n明天再加油吧。"
 },
 {
  "id": "004160",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘C240}「そう、だな‥",
  "tgt": "{立绘C240}「是啊‥"
 },
 {
  "id": "004161",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框06}{立绘8841}「兄さま‥、{码0B}道が‥！！",
  "tgt": "{框06}{立绘8841}「兄长‥，路‥！！{码0B}道が‥！！"
 },
 {
  "id": "004162",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘4200}「くそ、何て事だ！！\n---\n夜の間に、あさせが\nなくなったのか！！",
  "tgt": "{框05}{立绘4200}「可恶，怎么会这样！！\n---\n一夜之间，浅滩就\n消失了吗！！"
 },
 {
  "id": "004163",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘0904}「無理をしてでも\n夜のうちに\n渡っておく べきだった！",
  "tgt": "{框05}{立绘0904}「就算勉强\n也本该趁夜里\n渡过去的！"
 },
 {
  "id": "004164",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框06}{立绘8A41}「ご、{码0B}ごめんなさい。\nわたし‥、休もうなんて\n言ってしまって‥‥",
  "tgt": "{框06}{立绘8A41}「对，对不起。\n是我‥，说了\n要休息的话……{码0B}ごめんなさい。\nわたし‥、休もうなんて\n言ってしまって‥‥"
 },
 {
  "id": "004165",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4400}「おちつけ‥！\n---\n{立绘8B06}来た道が、ふさがったが\n行く道も、そうだとは\nかぎらん‥",
  "tgt": "{立绘4400}「冷静点…！\n---\n{立绘8B06}来路虽被堵住\n但去路未必\n也被堵了…"
 },
 {
  "id": "004166",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘C400}「まだ、通じてる あさせを\n探すんだ‥\n---\n急げ‥！",
  "tgt": "{立绘C400}「快去找\n还能通行的浅滩…\n---\n快…！"
 },
 {
  "id": "004167",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框06}{立绘C140}「わ‥、わたし達も\n探さないと‥！",
  "tgt": "{框06}{立绘C140}「我‥，我们也\n得去找‥！"
 },
 {
  "id": "004168",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4500}「あさせが、無くなった\nですか‥？\n---\n{立绘0605}そりゃ、たいへん‥\nむにゃむにゃ‥\n---\n{立绘0C07}って、言ってます。",
  "tgt": "{立绘4500}「浅滩消失了\n是吗…？\n---\n{立绘0605}那可糟了…\n呼噜呼噜…\n---\n{立绘0C07}是这么说的。"
 },
 {
  "id": "004169",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4300}「たい‥‥\n---\nへん。",
  "tgt": "{立绘4300}「糟…\n---\n了。"
 },
 {
  "id": "004170",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘C440}「地形からすれば\nこの边りが‥\n---\n大陸に つながる\nあさせの ようだが‥",
  "tgt": "{框05}{立绘C440}「从地形来看\n这一带‥\n---\n似乎就是连着大陆\n的浅滩‥"
 },
 {
  "id": "004171",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘C440}「ダメだな‥\n---\nこちらの道も\nふさがって しまった‥",
  "tgt": "{框05}{立绘C440}「不行啊‥\n---\n这条路\n也被堵死了‥"
 },
 {
  "id": "004172",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘C140}「つまり‥‥",
  "tgt": "{立绘C140}「也就是说……"
 },
 {
  "id": "004173",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘0403}「次に、あさせが\n通れるまで‥\n---\nここで、足止めと\n言う事だな‥",
  "tgt": "{框05}{立绘0403}「要等浅滩\n再次能通行‥\n---\n就只能在此\n停留了‥"
 },
 {
  "id": "004174",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘0504}「これが、落ち着いて\nいられるか‥！？",
  "tgt": "{立绘0504}「这叫人怎么\n冷静得下来‥！？"
 },
 {
  "id": "004175",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4200}「次に、いつ\nあさせが 通れるのか‥\n---\n分からないのだぞ‥！？",
  "tgt": "{立绘4200}「下次浅滩\n什么时候能通行…\n---\n根本不知道啊…！？"
 },
 {
  "id": "004176",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘4200}「ことによると、このまま‥\n---\n何も無い、この島で\n行き倒れになるって\n事も‥‥",
  "tgt": "{框05}{立绘4200}「搞不好就这样…\n---\n倒毙在这座\n一无所有的岛上\n也说不定…"
 },
 {
  "id": "004177",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘8645}「それは、ないね‥\n---\n{队员00}が‥\n神皇{队员06}と\n会うって事は‥\n---\n運命づけられた\n事だからね‥",
  "tgt": "{立绘8645}「那不会发生…\n---\n{队员00}…\n与神皇{队员06}\n相会之事…\n---\n早已是\n命中注定…"
 },
 {
  "id": "004178",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘8645}「少なくとも\n{队员00}だけは‥\n---\nここで、死んだり\nしないよ‥\n---\n{立绘8C47}「って、言ってます。",
  "tgt": "{立绘8645}「至少\n{队员00}…\n---\n不会死在\n这种地方…\n---\n{立绘8C47}「是这么说的。"
 },
 {
  "id": "004179",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘0701}「あ、{码0B}おはよう\n{队员00}‥",
  "tgt": "{立绘0701}「啊，{码0B}早安\n{队员00}…"
 },
 {
  "id": "004180",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘0504}「‥{码0B}‥{码0B}‥",
  "tgt": "{立绘0504}「……{码0B}‥{码0B}‥"
 },
 {
  "id": "004181",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘0701}「何だか、変なことに\nなっちゃいましたね‥\n---\n{立绘0101}でも‥‥\nだいじょうぶ ですよ。",
  "tgt": "{立绘0701}「总觉得\n事情变得好奇怪‥\n---\n{立绘0101}不过……\n不要紧的。"
 },
 {
  "id": "004182",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4400}「次に あさせを\n通れるのが‥\n---\n3日後か、1年後か‥\n分からんが、な。",
  "tgt": "{立绘4400}「下次能过\n浅滩是什么时候…\n---\n3天后还是1年后…\n没人知道。"
 },
 {
  "id": "004183",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4300}「ここ‥‥\n---\n寢やすい。",
  "tgt": "{立绘4300}「这里…\n---\n很好睡。"
 },
 {
  "id": "004184",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘0605}「ま、そのうち\n渡れるさ‥\n---\n{立绘4500}って、言ってますね。\nうふふふふー。",
  "tgt": "{立绘0605}「嘛，总有一天\n能过去的…\n---\n{立绘4500}是这么说的。\n呜呼呼呼呼…。"
 },
 {
  "id": "004185",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4100}「あ、{队员00}‥！",
  "tgt": "{立绘4100}「啊，{队员00}…！"
 },
 {
  "id": "004186",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘C140}「島の様子を\n見に行くんだったら‥\n---\nわたしも、行く！",
  "tgt": "{立绘C140}「要去看看\n岛上的情况的话‥\n---\n我也要去！"
 },
 {
  "id": "004187",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框02}{立绘4400}「私も、行こう‥",
  "tgt": "{框02}{立绘4400}「我也去吧…"
 },
 {
  "id": "004188",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框06}{立绘8544}「お、{码0B}おい {码0B}俺は‥‥",
  "tgt": "{框06}{立绘8544}「喂，喂我……{码0B}おい {码0B}俺は‥‥"
 },
 {
  "id": "004189",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘0403}「オタオタするな‥！\n---\n少し、頭をひやせ。",
  "tgt": "{框05}{立绘0403}「别慌慌张张的‥！\n---\n先冷静冷静。"
 },
 {
  "id": "004190",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘0403}「お前は、このパーティの\nリーダーなのでは\nないのか‥！？\n---\n{立绘0D08}‥{码0B}‥{码0B}‥",
  "tgt": "{框05}{立绘0403}「你不正是这支\n队伍的队长\n吗‥！？\n---\n{立绘0D08}……{码0B}‥{码0B}‥"
 },
 {
  "id": "004191",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框03}{立绘C340}「プカプカ‥",
  "tgt": "{框03}{立绘C340}「浮浮沉沉‥"
 },
 {
  "id": "004192",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框03}{立绘8645}「プカプカ‥\n---\nパブパブの連中が\n言ってたろ‥？\n---\nなるようにしか、ならない\n事だって、あるよ。\nトラちゃん‥\n---\n{立绘C540}‥ですね。",
  "tgt": "{框03}{立绘8645}「浮浮沉沉‥\n---\n小酒馆那帮人\n不是说过吗‥？\n---\n有些事啊\n只能听天由命。\n小虎‥\n---\n{立绘C540}‥是呢。"
 },
 {
  "id": "004193",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4400}「水は、心配なさそうだな‥",
  "tgt": "{立绘4400}「水似乎不用担心…"
 },
 {
  "id": "004194",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框02}{立绘C140}「ええ、それで\n何か 食べ物を\n探そうって‥\n---\n言ってたんです。",
  "tgt": "{框02}{立绘C140}「嗯，所以\n我们商量着\n去找些吃的‥\n---\n就这么说的。"
 },
 {
  "id": "004195",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4300}「プカ‥\n---\nプカ‥",
  "tgt": "{立绘4300}「普卡…\n---\n普卡…"
 },
 {
  "id": "004196",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘0605}「ま、こんな島で\nしばらく休む ってのも\n悪かないね‥\n---\n{立绘4500}ですね、ふふ。",
  "tgt": "{立绘0605}「嘛，在这岛上\n休息一阵子\n也不坏…\n---\n{立绘4500}是呢，呼呼。"
 },
 {
  "id": "004197",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4200}「‥{码0B}‥{码0B}‥",
  "tgt": "{立绘4200}「…{码0B}…{码0B}…"
 },
 {
  "id": "004198",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘0E01}「これは‥\n---\nこの边りで、つりが\nできるって\n事でしょうかね‥",
  "tgt": "{立绘0E01}「这是‥\n---\n这一带可以\n钓鱼\n的意思吗‥"
 },
 {
  "id": "004199",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘0101}「つれました？\n{队员00}‥‥",
  "tgt": "{框05}{立绘0101}「钓到了吗？\n{队员00}……"
 },
 {
  "id": "004200",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘0701}「これで‥\n食べ物も、心配しないで\nよさそうですね‥",
  "tgt": "{框05}{立绘0701}「这样一来‥\n吃的也不\n用发愁了呢‥"
 },
 {
  "id": "004201",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘0101}「じゃ、みんなの所に\n戻りましょうか‥",
  "tgt": "{框05}{立绘0101}「那，回大家\n那里去吧‥"
 },
 {
  "id": "004202",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘4100}「そっちは、つりが\nできそうな場所ですね‥\n---\nつれました、{队员00}？",
  "tgt": "{框05}{立绘4100}「那边看起来\n像是能钓鱼的地方呢…\n---\n钓到了吗，{队员00}？"
 },
 {
  "id": "004203",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘0701}「そうですか‥\n---\n{立绘4100}まだ、つります‥？\nそれとも いったん\n戻りましょうか‥？{引4100}",
  "tgt": "{框05}{立绘0701}「这样啊…\n---\n{立绘4100}还要继续钓…？\n还是先\n回去吧…？{引4100}"
 },
 {
  "id": "004204",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框04}{立绘C040}{码14000C22}まだ、つりをする。\nいったん戻ろう。",
  "tgt": "{框04}{立绘C040}{码14000C22}继续钓鱼。\n先回去吧。"
 },
 {
  "id": "004205",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘0101}「じゃ、がんばって下さいね\n{队员00}‥！",
  "tgt": "{框05}{立绘0101}「那么，加油哦\n{队员00}…！"
 },
 {
  "id": "004206",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘4100}「なんだか、わたし‥‥\n---\n{立绘0701}さかなくさい‥ です。",
  "tgt": "{框05}{立绘4100}「总觉得，我……\n---\n{立绘0701}一身鱼腥味…"
 },
 {
  "id": "004207",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘4100}「長い間、おフロにも\n入ってないしな‥\n---\n水あび、したいですね‥",
  "tgt": "{框05}{立绘4100}「好久没\n泡过澡了…\n---\n好想冲个水啊…"
 },
 {
  "id": "004208",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘0701}「うんうん、じゃなくて\n{队员00}‥\n---\n{立绘0F01}水あび したいから‥\nあっちに行ってて\nくださいよ‥！",
  "tgt": "{框05}{立绘0701}「嗯嗯，不是啦\n{队员00}…\n---\n{立绘0F01}我要冲水…\n请你到那边\n去待着…！"
 },
 {
  "id": "004209",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘0701}「ごめんなさい\n{队员00}‥",
  "tgt": "{框05}{立绘0701}「对不起\n{队员00}…"
 },
 {
  "id": "004210",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框02}{立绘4100}「あの、他の人が\n来ないように\n見はってくださいね‥\n---\n{立绘0701}こっち見たら、いやですよ！",
  "tgt": "{框02}{立绘4100}「那个，请帮我\n看着点\n别让别人过来…\n---\n{立绘0701}被看到的话，多难为情啊！"
 },
 {
  "id": "004211",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框02}{立绘9049}「つめたーい‥\n---\n{队员04}さんも‥‥",
  "tgt": "{框02}{立绘9049}「好凉呀‥\n---\n{队员04}先生也……"
 },
 {
  "id": "004212",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框02}{立绘9149}「気持ちいいですねー‥！",
  "tgt": "{框02}{立绘9149}「真舒服呢‥！"
 },
 {
  "id": "004213",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框02}{立绘9249}「あー‥\n---\n{队员04}さんって\n意外に‥‥",
  "tgt": "{框02}{立绘9249}「啊‥\n---\n{队员04}先生\n意外地……"
 },
 {
  "id": "004214",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框02}{立绘130A}「ふん‥‥\n---\n大きいから どうだと\n言うものでも、ないがな‥",
  "tgt": "{框02}{立绘130A}「哼……\n---\n块头大也不代表\n就怎么了不起‥"
 },
 {
  "id": "004215",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框02}{立绘9449}「ばか、{队员00}\nえっち‥！",
  "tgt": "{框02}{立绘9449}「笨蛋，{队员00}\n好色…！"
 },
 {
  "id": "004216",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘4100}「で‥、水の心配は\nありませんし‥\n---\nおさかなも とれそうだから\nしばらくは\nだいじょうぶです‥",
  "tgt": "{框05}{立绘4100}「而且…水也不用\n担心…\n---\n看起来也能钓到鱼\n暂时\n没有问题…"
 },
 {
  "id": "004217",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框06}{立绘C240}「ああ‥‥\nすまなかったな‥\n---\nあさせが 通れなくなって\nあせってしまって‥",
  "tgt": "{框06}{立绘C240}「啊……\n对不住了‥\n---\n浅滩过不去\n我就急了‥"
 },
 {
  "id": "004218",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘0101}「きっと、すぐに\n通れるように なりますよ‥",
  "tgt": "{框05}{立绘0101}「一定很快\n就能通行了‥"
 },
 {
  "id": "004219",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框06}{立绘C140}「{队员00}‥\nおさかな、とりに\n行きませんか‥？",
  "tgt": "{框06}{立绘C140}「{队员00}…\n要不要去\n钓点鱼…？"
 },
 {
  "id": "004220",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框06}{立绘0101}「兄さま、わたし達\nおさかな とって来ますね。",
  "tgt": "{框06}{立绘0101}「兄长，我们去\n抓鱼回来。"
 },
 {
  "id": "004221",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘0504}「なるように、なる‥\nか‥{码0B}‥{码0B}‥",
  "tgt": "{立绘0504}「顺其自然\n吗……{码0B}‥{码0B}‥"
 },
 {
  "id": "004222",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4400}「私は、今日は いい。\nここに残っている。",
  "tgt": "{立绘4400}「我今天算了。\n留在这里。"
 },
 {
  "id": "004223",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4300}「ここは‥\n---\nいいなあ‥",
  "tgt": "{立绘4300}「这里…\n---\n真好啊…"
 },
 {
  "id": "004224",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4500}「ヒトは、こんな風に\nのんびり‥\n---\n生きられないのかなぁ‥\nって言ってます。",
  "tgt": "{立绘4500}「人类为什么不能\n这样悠闲地…\n---\n生活呢…\n是这么说的。"
 },
 {
  "id": "004225",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4100}「{队员00}‥\n---\n{立绘0E01}{队员00}‥？\nひいてますよ‥！",
  "tgt": "{立绘4100}「{队员00}…\n---\n{立绘0E01}{队员00}…？\n咬钩了哟…！"
 },
 {
  "id": "004226",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘0701}「どうしたんです\n{队员00}‥？\n---\n寢てたんですか‥？",
  "tgt": "{立绘0701}「怎么了\n{队员00}…？\n---\n刚才睡着了…？"
 },
 {
  "id": "004227",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘0A01}「{队员00}‥\nわたしね‥{码0B}‥{码0B}‥\n---\n{立绘4100}わたし‥\n{队员02}の事が\n好きだって、言いましたっけ？",
  "tgt": "{立绘0A01}「{队员00}…\n我呢…{码0B}…{码0B}…\n---\n{立绘4100}我…\n有没有说过\n我喜欢{队员02}来着？"
 },
 {
  "id": "004228",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4100}「でもね‥\n---\n兄さまは、エリーナ姉さまと\n本当に 仲が良くって‥\n---\n子供の時から‥",
  "tgt": "{立绘4100}「但是呢…\n---\n兄长和艾莉娜姐姐\n真的很要好…\n---\n从小就…"
 },
 {
  "id": "004229",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘8741}「ふたりは、いつか\nけっこん するんだろうなー\nって‥\n---\n{立绘8141}思ってたから\n{队员02}兄さま、って\n呼んでたんです。",
  "tgt": "{立绘8741}「我心想你们俩\n早晚\n会结婚‥\n---\n{立绘8141}所以就一直\n喊{队员02}兄长，\n来着。"
 },
 {
  "id": "004230",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘C140}「好き、って言うより\nあこがれ‥ かなぁ‥",
  "tgt": "{立绘C140}「与其说是喜欢\n不如说是憧憬‥吧‥"
 },
 {
  "id": "004231",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘C140}「兄さまは、強くって\n何でもできて‥",
  "tgt": "{立绘C140}「兄长又强壮\n又什么都会‥"
 },
 {
  "id": "004232",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘4100}「でも、兄さまも\nわたしも いっしょ\nだったんですね‥",
  "tgt": "{框05}{立绘4100}「原来，兄长和\n我都是\n一样的呢…"
 },
 {
  "id": "004233",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框02}{立绘4100}「ずっと、旅してきたら‥\n---\n迷ったり、なやんだり\n傷ついたり‥\n---\n{立绘0701}するんですよね\n{队员02}兄さまも‥",
  "tgt": "{框02}{立绘4100}「一直旅行下去的话…\n---\n就会迷茫、烦恼\n受伤…\n---\n{立绘0701}会变成这样的吧\n{队员02}兄长也…"
 },
 {
  "id": "004234",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框02}{立绘4100}「‥‥つれませんね。",
  "tgt": "{框02}{立绘4100}「……没钓到呢。"
 },
 {
  "id": "004235",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框02}{立绘4100}「戻りましょうか‥",
  "tgt": "{框02}{立绘4100}「回去吧…"
 },
 {
  "id": "004236",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4200}「あせっても 仕方が無い\nという事か‥",
  "tgt": "{立绘4200}「就是说着急\n也没用…"
 },
 {
  "id": "004237",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4400}「さかなが とれなかった？\n---\nまあ、当面の心配は\nないと思うが‥",
  "tgt": "{立绘4400}「没钓到鱼？\n---\n嘛，眼前的生计\n应该不愁…"
 },
 {
  "id": "004238",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4300}「すぴー",
  "tgt": "{立绘4300}「呼噜——"
 },
 {
  "id": "004239",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4500}「ま、休めるときには\n休むといいよ‥\n---\nだそうです。",
  "tgt": "{立绘4500}「嘛，能休息的时候\n就好好休息吧…\n---\n是这么说的。"
 },
 {
  "id": "004240",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘1504}「おい、見ろ！\nあさせが‥！",
  "tgt": "{立绘1504}「喂，快看！\n浅滩‥！"
 },
 {
  "id": "004241",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘C140}「あさせが 通れるように\nなったみたいです‥\n---\n行ってみましょう！",
  "tgt": "{立绘C140}「浅滩好像\n能通行了‥\n---\n我们过去吧！"
 },
 {
  "id": "004242",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4200}「意外に早く\n道ができて、よかった‥！\n---\n出発の 用意を\n急がないと‥！",
  "tgt": "{立绘4200}「路开通得\n比想象中快，太好了…！\n---\n得赶紧\n准备出发了…！"
 },
 {
  "id": "004243",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4400}「あちらがわの あさせも\n通れるように\nなっているか‥？",
  "tgt": "{立绘4400}「对岸的浅滩\n是否也\n能通行了呢…？"
 },
 {
  "id": "004244",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4300}「し‥\n---\n出発、か‥",
  "tgt": "{立绘4300}「出…\n---\n发吗…"
 },
 {
  "id": "004245",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘0605}「だから 言ったろ‥\nあせる事は、ないって。\n---\n{立绘4500}ですね、ふふー。",
  "tgt": "{立绘0605}「所以说过了…\n不用着急的。\n---\n{立绘4500}是呢，呼呼…。"
 },
 {
  "id": "004246",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4100}「あさせが‥‥\n---\nこれで、大陸へ\n渡れますね‥！",
  "tgt": "{立绘4100}「浅滩……\n---\n这样就能\n渡到大陆了…！"
 },
 {
  "id": "004247",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{框05}{立绘4100}「兄さま‥、あさせが‥",
  "tgt": "{框05}{立绘4100}「兄长…，浅滩…"
 },
 {
  "id": "004248",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{立绘4200}「ああ、{码0B}出発しよう‥！",
  "tgt": "{立绘4200}「嗯，{码0B}出发吧…！"
 },
 {
  "id": "004249",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "旅の記錄が できます‥{码14000C93}休んでいく\n旅の記錄だけする\nやめておく",
  "tgt": "可以记录旅程…{码14000C93}休息一下\n只记录旅程\n算了"
 },
 {
  "id": "004250",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "中はからっぽだった。",
  "tgt": "里面是空的。"
 },
 {
  "id": "004251",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "{色03}{道具0505}{/色}の\n竜水晶を 手に入れて‥\n---\n『{道具DD04}』の力を\n身につけた！",
  "tgt": "{色03}{道具0505}{/色}获得了{道具DD04}的\n龙水晶‥\n---\n掌握了『"
 },
 {
  "id": "004252",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "つり場は キレイに\nごみは 持ち归りましょう。",
  "tgt": "钓鱼场请保持整洁\n垃圾请随手带走。"
 },
 {
  "id": "004253",
  "file": "WORLD/AREAD001.EMI",
  "seg": 8,
  "src": "旅の記錄が できます‥{码148B0C93}休んでいく\n旅の記錄だけする\nやめておく",
  "tgt": "可记录旅程‥歇一歇再走\n只记录旅程\n先算了{码148B0C93}休んでいく\n旅の記錄だけする\nやめておく"
 },
 {
  "id": "004254",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "だむかりゅう。",
  "tgt": "大坝下游。"
 },
 {
  "id": "004255",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0000}「竜が 暴れてて\nやばいのは 分かるけど‥\n---\nここから 逃げたって\n他に行くところ ねぇしな。",
  "tgt": "{立绘0000}「龙在发狂\n很危险是明白…\n---\n可就算逃出去\n也没别的地方可去啊。"
 },
 {
  "id": "004256",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0101}「暴れてる 竜を\n見張ってるんだ‥\n---\nいよいよ 危なくなったら\nかねを 鳴らすんだけど\n---\n逃げるの 間に合うかね？",
  "tgt": "{立绘0101}「我在盯着\n那条撒野的龙‥\n---\n真到危急关头\n就会敲钟\n---\n可来得及逃吗？"
 },
 {
  "id": "004257",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0202}「泥ン中にはさ‥\n{道具2300}って 金属が\nいっぱい あんだよ‥\n---\n俺たちゃ、こうやって\nそいつを 集めてんのさ。",
  "tgt": "{立绘0202}「泥巴里啊…\n有好多叫\n{道具2300}的金属哦…\n---\n我们就是\n这样收集它们的。"
 },
 {
  "id": "004258",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0303}「どう？ 俺様の\nスーパー浮き袋‥？\n---\nこれさえ あれば‥\n水門が壊れても、安心よ！",
  "tgt": "{立绘0303}「如何？本大爷的\n超级浮袋‥？\n---\n有这个在手‥\n水门坏了也放心！"
 },
 {
  "id": "004259",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框05}{立绘0404}「なに、あんたら‥\nこんな所に、何の用？",
  "tgt": "{框05}{立绘0404}「我说，你们‥\n跑这种地方，干什么？"
 },
 {
  "id": "004260",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「お仕事中、すみません\n---\n私たち、向こう岸に\n渡りたいのですが‥\n---\nどうやって行けば\nよろしいのでしょうか？",
  "tgt": "{框06}{立绘C140}「打扰工作了，抱歉\n---\n我们想到\n对岸去‥\n---\n请问该怎么\n走呢？"
 },
 {
  "id": "004261",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘4240}「‥すまんが\n向こう岸に 渡りたいのだ\n---\nどうやって 行けばよいのか\n教えてもらえんか？",
  "tgt": "{框06}{立绘4240}「‥抱歉\n我们想渡到对岸\n---\n能否告知\n该怎么走？"
 },
 {
  "id": "004262",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘4540}「あのう、{码0B}{队员05}が\n---\n向こう岸に 行きたいと\nそう、言いますが\n---\nどうすれば、{队员05}が\n向こう岸に 行けますか？",
  "tgt": "{框06}{立绘4540}「那个，{码0B}{队员05}\n---\n说是想到\n对岸去\n---\n请问{队员05}\n怎样才能到对岸？"
 },
 {
  "id": "004263",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框05}{立绘0404}「向こう岸‥？\n---\n何で ワザワザこんな\nうす污い所、通るの‥{码0B}‥{码0B}‥{码0B}？\n---\n‥ま、いいか。",
  "tgt": "{框05}{立绘0404}「对岸‥？\n---\n何必特意走这种\n又脏又臭的地方……？\n---\n‥算了。{码0B}‥{码0B}‥{码0B}？\n---\n‥ま、いいか。"
 },
 {
  "id": "004264",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框05}{立绘8404}「向こう岸へ 行くなら\nまず‥‥\n---\n{立绘FFFF}{立绘0404}「上の水門を いったん閉めて\nあっち側へ 渡って‥",
  "tgt": "{框05}{立绘8404}「要去对岸的话\n首先……\n---\n{立绘FFFF}{立绘0404}「先关上上面的水门\n渡到那边‥"
 },
 {
  "id": "004265",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框05}{立绘0404}「あそこの リフトで\nがけの上に 登れば\nいいんだよ‥",
  "tgt": "{框05}{立绘0404}「用那边的升降台\n爬上崖顶\n就行‥"
 },
 {
  "id": "004266",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框05}{立绘0404}「水門を 閉めるための鍵は\n{色02}ロペ{/色}って奴が 持ってるから\n闻いてみれば‥？\n---\n浮き袋もった、目の細い奴。",
  "tgt": "{框05}{立绘0404}「关水门的钥匙\n在叫{色02}罗佩{/色}的家伙手里\n去问问吧…？\n---\n就是拿着浮袋的小眼睛家伙。"
 },
 {
  "id": "004267",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘4100}「あ、{码0B}分かりました\nありがとうございます。",
  "tgt": "{框06}{立绘4100}「啊，{码0B}知道了\n谢谢您。"
 },
 {
  "id": "004268",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0404}「ロペから {道具0105}\n受け取った？\n---\n‥で、終わったら 鍵は\n俺んとこに 持ってきて\n---\nそしたら リフトを\n動かしてやるから。",
  "tgt": "{立绘0404}「从罗佩那儿拿到\n{道具0105}了吗？\n---\n‥用完了把钥匙\n拿回来给我\n---\n我就给你开\n升降台。"
 },
 {
  "id": "004269",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0303}ロペ\n「なに‥ 鍵？\nあるよ‥‥、{码0B}ほら。\n---\n{立绘FFFF} \n  『{道具0105}』を 手に入れた。",
  "tgt": "{立绘0303}罗佩\n「什么‥钥匙？\n有啊……，给。\n---\n{码0B}\n获得了『{立绘FFFF}』。{道具0105}』を 手に入れた。"
 },
 {
  "id": "004270",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0303}「んで、どーすんの、鍵？\n---\n‥{码0B}‥向こう岸に 渡るの？\n‥そうか ふーん\nまぁ、がんばってくれ。",
  "tgt": "{立绘0303}「然后，钥匙干嘛用？\n---\n……要渡到对岸？\n‥这样啊，哦～\n嘛，加油吧。{码0B}‥向こう岸に 渡るの？\n‥そうか ふーん\nまぁ、がんばってくれ。"
 },
 {
  "id": "004271",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0303}「あ‥ 水門しめたら\n鍵、返してね‥",
  "tgt": "{立绘0303}「啊‥关好水门后\n记得还钥匙哦‥"
 },
 {
  "id": "004272",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0202}「しかし、なんで泥ン中には\n竜みたいな‥\n---\nヘンな生き物しか\nいねぇんだろな‥",
  "tgt": "{立绘0202}「不过，为啥泥潭里\n净是些像龙一样的‥\n---\n奇怪的生物\n就只有这些呢‥"
 },
 {
  "id": "004273",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0505}「竜‥？\n---\nへへ、{码0B}そんなモンが恐くて\n{道具2300}拾いなんて\nやってられますかって！",
  "tgt": "{立绘0505}「龙…？\n---\n嘿嘿，{码0B}怕那种东西\n还怎么捡\n{道具2300}啊！"
 },
 {
  "id": "004274",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0303}「あー‥、鍵は\nそこにいる 親方に\n返しておいて。",
  "tgt": "{立绘0303}「啊~，钥匙\n还给那边的\n工头就行。"
 },
 {
  "id": "004275",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0000}「竜って‥\nでかいだけで 危なくない\n生き物だと 思ってたけどな。",
  "tgt": "{立绘0000}「龙这种东西…\n我还以为只是\n块头大并不危险呢。"
 },
 {
  "id": "004276",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0404}「鍵‥、はいいけど\nあそこの‥ リフトの所に\n渡るための橋、あるだろ？\n---\nあれを おろさないと。",
  "tgt": "{立绘0404}「钥匙‥是收下了\n那边升降台处\n不是有座过桥吗？\n---\n得把它放下来。"
 },
 {
  "id": "004277",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框04}{立绘0404}「お、{码0B}戻ったか‥\nじゃ、リフトを動かすか‥\n---\n鍵は 返してもらうよ。",
  "tgt": "{框04}{立绘0404}「哦，回来啦‥\n那，开升降台吧‥\n---\n钥匙要还我哦。{码0B}戻ったか‥\nじゃ、リフトを動かすか‥\n---\n鍵は 返してもらうよ。"
 },
 {
  "id": "004278",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框04}{立绘0404}「おい、ロペ！\n---\nおまえ、上へ行って\n水門、開けてきてくれ！{引1900}",
  "tgt": "{框04}{立绘0404}「喂，罗佩！\n---\n你上去\n把水门打开！{引1900}"
 },
 {
  "id": "004279",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框40}{立绘0303}「うーい‥！",
  "tgt": "{框40}{立绘0303}「好嘞‥！"
 },
 {
  "id": "004280",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框04}{立绘0404}「ああ‥、{码0B}水門が開いてないと\n俺ら 仕事になんねぇから‥\n---\nあんたらの 用がすんだら\nサッサと 開けねぇとな。",
  "tgt": "{框04}{立绘0404}「啊‥，水门不开\n我们就没法干活‥\n---\n你们的事一完\n就得赶紧开门。{码0B}水門が開いてないと\n俺ら 仕事になんねぇから‥\n---\nあんたらの 用がすんだら\nサッサと 開けねぇとな。"
 },
 {
  "id": "004281",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框04}{立绘0404}「と、{码0B}さて‥\nリフトを 動かしま‥",
  "tgt": "{框04}{立绘0404}「那么，来‥\n开动升降台‥{码0B}さて‥\nリフトを 動かしま‥"
 },
 {
  "id": "004282",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0141}「水門が、壊された！\n泥が、あふれるぞーっ！！",
  "tgt": "{立绘0141}「水门，被冲坏了！\n泥浆，要漫出来啦！！"
 },
 {
  "id": "004283",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘0444}「リフト、{码0B}動かしてやろうと\n思ってたけど‥\n---\nどうも‥、それどころじゃ\nなさそうだな‥！",
  "tgt": "{框06}{立绘0444}「升降台，本想\n给你们开的‥\n---\n可现在‥，看来\n顾不上这个了‥！{码0B}動かしてやろうと\n思ってたけど‥\n---\nどうも‥、それどころじゃ\nなさそうだな‥！"
 },
 {
  "id": "004284",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「私たち、向こう岸に\n渡れない‥って事ですか！？",
  "tgt": "{框05}{立绘4100}「你是说我们\n过不了对岸了吗！？"
 },
 {
  "id": "004285",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框05}{立绘4200}「待ってくれ！\n俺たちは、向こう岸に\n行かなければ‥！",
  "tgt": "{框05}{立绘4200}「等一下！\n我们必须去\n对岸…！"
 },
 {
  "id": "004286",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框05}{立绘4500}「うふふふ‥\n---\nリフト動かないと\n向こう岸に 行けないって\n言ってますよ。",
  "tgt": "{框05}{立绘4500}「呜呼呼呼…\n---\n升降台不动的话\n就去不了对岸\n是这么说的哟。"
 },
 {
  "id": "004287",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘0444}「あ、{码0B}そうじゃなくて‥\n俺も、逃げるから\nあんたらを 手伝えない\n---\nだから、自分たちで\nリフト動かしてくれ‥\n---\nコイツを 渡しとくよ。\n---\n{立绘FFFF} \n  『{道具0905}』を もらった！",
  "tgt": "{框06}{立绘0444}「啊，不是那个意思‥\n我也要逃命\n帮不了你们\n---\n所以升降台\n你们自己开‥\n---\n把这个给你们。\n---\n{码0B}\n获得了『{立绘FFFF}』！{道具0905}』を もらった！"
 },
 {
  "id": "004288",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘0444}「それを‥、リフトの手前の\nハコに くっつけて\n何回か ひっぱりゃいいんだ。",
  "tgt": "{框06}{立绘0444}「把它‥，装到升降台前的\n箱子上\n拉上几回就行。"
 },
 {
  "id": "004289",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘0444}「おい、おまえらも\n早いとこ逃げろって！",
  "tgt": "{框06}{立绘0444}「喂，你们也\n赶紧逃吧！"
 },
 {
  "id": "004290",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘0444}「‥って言う感じだから\nまぁ 上手くやりなよ\nじゃあね。",
  "tgt": "{框06}{立绘0444}「‥就是这么回事\n好好干吧\n再见。"
 },
 {
  "id": "004291",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0404}「リフトは、あっちだ！\n---\n泥に 流される前に\n急ぎなよ‥！",
  "tgt": "{立绘0404}「升降台在那边！\n---\n趁没被泥浆冲走\n快去吧‥！"
 },
 {
  "id": "004292",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "リフトは、ここじゃない！",
  "tgt": "升降台不在这里！"
 },
 {
  "id": "004293",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": " \n{码03}は、{道具0905}を使った。",
  "tgt": "\n使用了{码03}。{道具0905}を使った。"
 },
 {
  "id": "004294",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0606}「‥{码0B}‥{码0B}‥下りてきません\n---\n何回も レバーを\n動かさないと‥\nいけないのでしょうか？",
  "tgt": "{立绘0606}「……降不下来\n---\n是不是要\n多扳几次\n扳手才行？{码0B}‥{码0B}‥下りてきません\n---\n何回も レバーを\n動かさないと‥\nいけないのでしょうか？"
 },
 {
  "id": "004295",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0707}「どうした‥！？\n---\nもっと、レバーを\n動かして みてくれ！",
  "tgt": "{立绘0707}「怎么了‥！？\n---\n再多扳几下\n扳手试试！"
 },
 {
  "id": "004296",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘4500}「ふふ‥ 大変ですね\n止まってますよ。\n---\n‥もっと、ガチャガチャしたら\n動きますか？",
  "tgt": "{立绘4500}「呼呼…糟糕了呢\n停下来了哟。\n---\n…再咔嚓咔嚓\n一下会动吗？"
 },
 {
  "id": "004297",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0707}「お、{码0B}いっ、急げ！",
  "tgt": "{立绘0707}「快，快、快跑！{码0B}いっ、急げ！"
 },
 {
  "id": "004298",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0806}「い、いそいでっ！",
  "tgt": "{立绘0806}「快，快点啊！"
 },
 {
  "id": "004299",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0908}「あはははは！\n泥が来ましたよーっ！",
  "tgt": "{立绘0908}「啊哈哈哈！\n泥浆来啦！"
 },
 {
  "id": "004300",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘8A46}「はあ‥‥\n助かりましたね‥？",
  "tgt": "{框06}{立绘8A46}「呼……\n得救了呢‥？"
 },
 {
  "id": "004301",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「‥働いてた方たちは\nだいじょうぶ でしょうか？",
  "tgt": "{框06}{立绘C140}「‥干活的那些人\n不要紧吧？"
 },
 {
  "id": "004302",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「ふぅ‥、助かった！",
  "tgt": "{框06}{立绘C240}「呼‥，得救了！"
 },
 {
  "id": "004303",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘8B47}「働いてた連中も\nうまく逃げた‥か？",
  "tgt": "{框06}{立绘8B47}「干活的那帮家伙\n也顺利逃了‥吗？"
 },
 {
  "id": "004304",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘C540}「助かりましたか‥",
  "tgt": "{框06}{立绘C540}「得救了吗‥"
 },
 {
  "id": "004305",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘C540}「この分だと、あの人たちも\n助かった ことでしょう‥\n---\n弱りますね。",
  "tgt": "{框06}{立绘C540}「照这样看，那些人也\n应该逃出来了‥\n---\n真叫人头疼。"
 },
 {
  "id": "004306",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘0303}「いえ〜〜〜〜ぃ‥",
  "tgt": "{立绘0303}「耶！"
 },
 {
  "id": "004307",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘4100}「よかった‥、あれなら\n無事ですね‥",
  "tgt": "{框06}{立绘4100}「太好了…那个\n平安无事呢…"
 },
 {
  "id": "004308",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘4200}「そうみたいだな‥\nよし、行こうか‥！",
  "tgt": "{立绘4200}「看来是这样…\n好，走吧…！"
 },
 {
  "id": "004309",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「‥{码0B}‥だから、そんなに\n困らなくても いいんですよ\n{队员05}さん？",
  "tgt": "{框06}{立绘C140}「……所以说\n不必这么发愁的\n{码0B}先生？{队员05}さん？"
 },
 {
  "id": "004310",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{立绘4500}「‥困ってましたか？\n---\nふーむ‥\n笑うとき だったですね？",
  "tgt": "{立绘4500}「…是遇到麻烦了吗？\n---\n唔嗯…\n刚才正是该笑的时候呢？"
 },
 {
  "id": "004311",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘8C46}「と、{码0B}とにかく\n行きましょう‥！",
  "tgt": "{框06}{立绘8C46}「总，总之\n走吧‥！{码0B}とにかく\n行きましょう‥！"
 },
 {
  "id": "004312",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘4200}「‥{码0B}‥{码0B}ま、まぁ\nあれは、だいじょうぶだろう",
  "tgt": "{框06}{立绘4200}「…{码0B}…{码0B}嘛，嘛\n那个应该不要紧"
 },
 {
  "id": "004313",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘8B47}「皆、助かったのに\n何を そんなに\n困っているのだ‥？",
  "tgt": "{框06}{立绘8B47}「大家都得救了\n还有什么\n好发愁的‥？"
 },
 {
  "id": "004314",
  "file": "WORLD/AREAD004.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「ま、{码0B}まぁ いいか‥\n行こう‥！",
  "tgt": "{框06}{立绘C240}「罢，罢了‥\n走吧‥！{码0B}まぁ いいか‥\n行こう‥！"
 },
 {
  "id": "004315",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "だむのなか。",
  "tgt": "大坝之中。"
 },
 {
  "id": "004316",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "      {色02}水門開閉装置{/色}\n   管理者以外立ち入り禁止",
  "tgt": "      {色02}水门开闭装置{/色}\n   非管理者禁止入内"
 },
 {
  "id": "004317",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{框05}{立绘C100}「これで、閉じた水門の上を\n通れるわけですね‥？",
  "tgt": "{框05}{立绘C100}「这样就能从\n关上的水门上面过了吧…？"
 },
 {
  "id": "004318",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{框05}{立绘C200}「今ので、水門が閉じて‥\n---\nその上が 通れるように\nなったのだな？",
  "tgt": "{框05}{立绘C200}「刚才的操作把水门关上了…\n---\n上面就可以\n通行了吗？"
 },
 {
  "id": "004319",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{立绘0000}「‥{码0B}‥{码0B}止まっちゃいましたね",
  "tgt": "{立绘0000}「…{码0B}…{码0B}又停了呢"
 },
 {
  "id": "004320",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{立绘0101}「止まっ‥{码0B}たぞ！？",
  "tgt": "{立绘0101}「停‥住了！？{码0B}たぞ！？"
 },
 {
  "id": "004321",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{框01}{立绘0202}「だーれ‥？\n水門、動かしてるの？",
  "tgt": "{框01}{立绘0202}「是谁‥？\n在动水门吗？"
 },
 {
  "id": "004322",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{框05}{立绘0202}「‥水門、{码0B}閉めたいの？",
  "tgt": "{框05}{立绘0202}「‥想关水门？{码0B}閉めたいの？"
 },
 {
  "id": "004323",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{框04}{立绘4240}「あ‥、ああ\nそうしたいのだが、機协が‥",
  "tgt": "{框04}{立绘4240}「啊‥，是的\n正有此意，可机械‥"
 },
 {
  "id": "004324",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{框04}{立绘C140}「ええ、ですが‥\nこの機协が‥",
  "tgt": "{框04}{立绘C140}「嗯，可是‥\n这机械‥"
 },
 {
  "id": "004325",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{框05}{立绘8202}「‥止まっちゃったのね\n---\n最近、カブりぎみで‥\nいちど高速で回せば\n直るのかも しれないけど",
  "tgt": "{框05}{立绘8202}「‥停了呢\n---\n最近它闹脾气‥\n或许用高速转一回\n就能修好"
 },
 {
  "id": "004326",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{框05}{立绘0202}「つまり、{码0B}コツがいるって事\n‥{码0B}‥說明するわ",
  "tgt": "{框05}{立绘0202}「就是说，得有窍门\n……我来说明一下{码0B}コツがいるって事\n‥{码0B}‥說明するわ"
 },
 {
  "id": "004327",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{框05}{立绘0202}「えーと、まず‥ こっちの\n{色02}フライホイール{/色}ってのを\n手動で回すのね‥",
  "tgt": "{框05}{立绘0202}「那个，首先…把这边\n{色02}飞轮{/色}\n用手转起来哦…"
 },
 {
  "id": "004328",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{框05}{立绘0202}「で、ホイールの回転が\n高まったら‥\n---\nこっちの スイッチを入れるの",
  "tgt": "{框05}{立绘0202}「等轮子的转速\n上来了‥\n---\n就按下这边的开关"
 },
 {
  "id": "004329",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{框05}{立绘0202}「回転は‥、水門を\n{色02}閉めるだけ{/色}だったら、それほど\n速くなくって いいけど\n---\n速ければ、速いほど\n機协の調子が よくなるから\n私は、{色04}ありがたい{/色}かな‥",
  "tgt": "{框05}{立绘0202}「转速嘛…如果只是\n{色02}关水门{/色}的话\n不用太快也行\n---\n不过越快\n机器状态就越好\n我可是{色04}求之不得{/色}呢…"
 },
 {
  "id": "004330",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{框21} \n   操作の說明を讀みますか？{码14000C82}はい\nいいえ",
  "tgt": "{框21} \n   要读操作说明吗？{码14000C82}是\n否"
 },
 {
  "id": "004331",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{框21}方向キーを回すと、\n{队员00}を 操作して\nフライホイールを 回転させます。\n---\n方向キーを 速く回せば\nフライホイールは、だんだんと\n加速してゆきます。\n---\nフライホイールの回転する音が\n高くなったら、{色0A}○{/色}ボタンを押して\n機协を始動させてください。\n---\n一定時間をすぎると、加速を\n續けられなくなるので、注意。\n---\n \n  操作のヒントを讀みますか？{码14010C82}はい\nいいえ",
  "tgt": "{框21}转动方向键，\n操控{队员00}\n旋转飞轮。\n---\n方向键转得越快\n飞轮就会\n渐渐加速。\n---\n飞轮的旋转声变高后\n请按{色0A}○{/色}键\n启动机器。\n---\n注意，超过一定时间后\n就无法继续加速了。\n---\n \n  要读操作提示吗？{码14010C82}是\n否"
 },
 {
  "id": "004332",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{框21}方向キーの回転は、最初ゆっくり\nだんだん速くするのがコツ。\n回す方向は、どちらでもOK。\n---\n回転の音が、いちだん高くなると\n機协始動のサイン。\n{色0A}○{/色}ボタンを押して、スイッチオン！\n---\nそこでボタンを押さず、さらに加速して\nスイッチを入れると‥\n何か、好いことが あるかも？\n---\nホイールを回す{队员00}が\n{色02}あせ{/色}をかいたら、疲れてきたサイン。\n無理せずに、{色0A}○{/色}ボタンを！\n---\n \n  もう一度、說明を讀みますか？{码14000C82}讀む\n始める",
  "tgt": "{框21}转动方向键的诀窍是\n开始慢、渐渐加快。\n转向左右都OK。\n---\n旋转声一下子变高\n就是启动机器的信号。\n按{色0A}○{/色}键打开开关！\n---\n若不按键继续加速\n再打开开关的话…\n说不定会有好事？\n---\n转轮的{队员00}\n冒出{色02}汗{/色}就是累了的信号。\n别硬撑，快按{色0A}○{/色}键！\n---\n \n  要再读一次说明吗？{码14000C82}读\n开始"
 },
 {
  "id": "004333",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{框05}{立绘0202}「それじゃ、始めるわよ‥\n---\n一人、ホイールを回して\nもう一人が、こっちで\nスイッチを入れるのよ！",
  "tgt": "{框05}{立绘0202}「那，开始喽‥\n---\n一人转飞轮\n另一人在这边\n按下开关！"
 },
 {
  "id": "004334",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{立绘0202}「‥しっぱい しちゃったわね\n---\nもう少し、速く回さないと\nダメなのよね‥",
  "tgt": "{立绘0202}「‥失败了呢\n---\n还得再转\n快一点才行‥"
 },
 {
  "id": "004335",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{立绘0202}「どうする‥、もう一度\nやってみる？{码14020C82}はい\nいいえ",
  "tgt": "{立绘0202}「怎么办‥，要再\n试一次吗？是\n否{码14020C82}はい\nいいえ"
 },
 {
  "id": "004336",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{立绘0202}「そう、{码0B}それじゃ\nやり方を 說明しましょうか？{码14030C82}はい\nいらない",
  "tgt": "{立绘0202}「这样，那要\n我说明一下方法吗？要\n不用{码0B}それじゃ\nやり方を 說明しましょうか？{码14030C82}はい\nいらない"
 },
 {
  "id": "004337",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{立绘0202}「閉まったみたいね‥",
  "tgt": "{立绘0202}「好像关上了‥"
 },
 {
  "id": "004338",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{立绘0202}「これで、水門の上を\n通ることが できるわね\n---\nどこ行くのか 知らないけど\n気をつけてね",
  "tgt": "{立绘0202}「这样就能\n从水门上过了\n---\n不知道你们去哪\n路上小心"
 },
 {
  "id": "004339",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{立绘0202}「これで、水門の上が\n通れるわね‥、{码0B}それに‥\n---\nおかげで、機协の調子も\nよくなったみたい‥\nどうもありがとう",
  "tgt": "{立绘0202}「这下，水门上\n能通行了‥，而且‥\n---\n托你们的福，机械\n状态也好多了‥\n多谢啦{码0B}それに‥\n---\nおかげで、機协の調子も\nよくなったみたい‥\nどうもありがとう"
 },
 {
  "id": "004340",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{立绘0202}「それで、お礼といっては\nなんだけど‥\n---\nこれ、あげるわ\n何かの たしにして‥！",
  "tgt": "{立绘0202}「这个嘛，说是谢礼\n也不算‥\n---\n这个送你\n说不定用得上‥！"
 },
 {
  "id": "004341",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": " \n『{占位00}』を もらった！",
  "tgt": " \n得到了『{占位00}』！"
 },
 {
  "id": "004342",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{立绘0202}「それじゃ、気をつけてね‥",
  "tgt": "{立绘0202}「那么，路上小心‥"
 },
 {
  "id": "004343",
  "file": "WORLD/AREAD005.EMI",
  "seg": 11,
  "src": "{立绘0202}「早いとこ、渡った方が\nいいわよ‥\n---\n竜、また暴れてるし",
  "tgt": "{立绘0202}「最好趁早\n渡过去‥\n---\n龙又开始撒野了"
 },
 {
  "id": "004344",
  "file": "WORLD/AREAD010.EMI",
  "seg": 11,
  "src": "マルタ",
  "tgt": "玛鲁塔"
 },
 {
  "id": "004345",
  "file": "WORLD/AREAD010.EMI",
  "seg": 11,
  "src": "{色04}まる太の乘り方{/色}\n乘り場へ行き、まる太に向けて\n方向キーを押してください。\n---\nまる太に乘ったら、\n方向キーで前後に移動できます。\n（木目方向には、移動できません）\n---\nまた、移動した結果\n他のまる太や 地面にくっつくと\n乘り移る事ができます。",
  "tgt": "{色04}圆木的乘法{/色}\n走到乘场，朝着圆木\n按方向键。\n---\n乘上圆木后，\n可用方向键前后移动。\n（不能沿木纹方向移动）\n---\n另外，移动后若碰到\n其他圆木或地面\n可以换乘过去。"
 },
 {
  "id": "004346",
  "file": "WORLD/AREAD011.EMI",
  "seg": 11,
  "src": "すいどうきょう",
  "tgt": "水道桥"
 },
 {
  "id": "004347",
  "file": "WORLD/AREAD011.EMI",
  "seg": 11,
  "src": "「修理の 手伝いの人だね。\n今、ゴンドラを動かすよ‥{码14000C92}お願いします\n今はいいです",
  "tgt": "「你就是帮忙修理的人吧。\n我现在开动吊舱哦…{码14000C92}麻烦你了\n现在不用"
 },
 {
  "id": "004348",
  "file": "WORLD/AREAD011.EMI",
  "seg": 11,
  "src": "水が流れている‥\n飛びこみますか？{码14010C92}飛びこむ\nやめておく",
  "tgt": "水在流淌‥\n要跳下去吗？跳下去\n先算了{码14010C92}飛びこむ\nやめておく"
 },
 {
  "id": "004349",
  "file": "WORLD/AREAD011.EMI",
  "seg": 11,
  "src": "「後は、ここをふさげば\n水道橋も完成だよ‥フゥ。",
  "tgt": "「之后只要堵上这里\n水道桥就完工了‥呼。"
 },
 {
  "id": "004350",
  "file": "WORLD/AREAD011.EMI",
  "seg": 11,
  "src": "「はね橋をとめている\nロープがある‥",
  "tgt": "「有根绳子\n拴着吊桥‥"
 },
 {
  "id": "004351",
  "file": "WORLD/AREAD011.EMI",
  "seg": 11,
  "src": "「ほい、ちょっと待ってね‥",
  "tgt": "「好嘞，稍等一下‥"
 },
 {
  "id": "004352",
  "file": "WORLD/AREAD011.EMI",
  "seg": 11,
  "src": "「あ、そう‥\n---\nゴンドラ使うときは\nいつでも言ってよ。",
  "tgt": "「啊，是嘛‥\n---\n要用吊篮的话\n随时喊我。"
 },
 {
  "id": "004353",
  "file": "WORLD/AREAD011.EMI",
  "seg": 11,
  "src": "「この水道橋‥\n軍の建物に つながってる\nもんだから‥\n---\n軍から、修理を\n急がれてるんだ‥\n---\nよろしく賴むよ。",
  "tgt": "「这座水道桥‥\n连着军部的建筑\n所以‥\n---\n军方正催着\n快点修好‥\n---\n就拜托你们了。"
 },
 {
  "id": "004354",
  "file": "WORLD/AREAD012.EMI",
  "seg": 13,
  "src": "おせんぼす。",
  "tgt": "哨所。"
 },
 {
  "id": "004355",
  "file": "WORLD/AREAD012.EMI",
  "seg": 13,
  "src": "{立绘C140}「何か‥、ヘンな音が\nしませんでしたか？",
  "tgt": "{立绘C140}「刚才‥，有没有听到\n什么怪声？"
 },
 {
  "id": "004356",
  "file": "WORLD/AREAD012.EMI",
  "seg": 13,
  "src": "{立绘4500}「呪いは ウラミ、ツラミの\nかたまりなので‥\n---\nヘンな声が 闻こえるのは\n当たり前だそうです。",
  "tgt": "{立绘4500}「诅咒是怨恨、苦楚的\n凝聚体…\n---\n听到奇怪的声音\n是理所当然的。"
 },
 {
  "id": "004357",
  "file": "WORLD/AREAD012.EMI",
  "seg": 13,
  "src": "{立绘4500}「でも、声だけなら\n何もできないので‥\n---\nだいじょうぶだと\n言っていますよ‥\n---\nさあ、行くのですね。",
  "tgt": "{立绘4500}「不过只是声音的话\n什么也做不了…\n---\n没问题\n是这么说的…\n---\n来，走吧。"
 },
 {
  "id": "004358",
  "file": "WORLD/AREAD012.EMI",
  "seg": 13,
  "src": "{立绘0000}「今のは‥、何でしょう‥",
  "tgt": "{立绘0000}「刚才那是…什么…"
 },
 {
  "id": "004359",
  "file": "WORLD/AREAD012.EMI",
  "seg": 13,
  "src": "{框05}{立绘4500}「呪いの邪念が\n形になった 魔物ですね。\n---\nとっても危険だって\n言ってますよ！",
  "tgt": "{框05}{立绘4500}「是诅咒的邪念\n成形的魔物。\n---\n非常危险\n是这么说的哟！"
 },
 {
  "id": "004360",
  "file": "WORLD/AREAD012.EMI",
  "seg": 13,
  "src": "{立绘C140}「き、{码0B}危険だったら\n笑ってないで‥\n---\n逃げないと ダメなんじゃ\nないですか？",
  "tgt": "{立绘C140}「如，如果危险的话\n就别光笑了‥\n---\n不赶紧逃的话\n不行吧？{码0B}危険だったら\n笑ってないで‥\n---\n逃げないと ダメなんじゃ\nないですか？"
 },
 {
  "id": "004361",
  "file": "WORLD/AREAD012.EMI",
  "seg": 13,
  "src": "{框05}{立绘4500}「そのようです。\n---\n‥{码0B}‥笑うところ\nまちがえましたね。",
  "tgt": "{框05}{立绘4500}「似乎是这样。\n---\n…{码0B}…该笑的地方\n笑错了呢。"
 },
 {
  "id": "004362",
  "file": "WORLD/AREAD012.EMI",
  "seg": 13,
  "src": "{框05}{立绘4500}「では、{码0B}逃げますね。",
  "tgt": "{框05}{立绘4500}「那么，{码0B}逃吧。"
 },
 {
  "id": "004363",
  "file": "WORLD/AREAD012.EMI",
  "seg": 13,
  "src": "{立绘8101}「追ってきましたよ。",
  "tgt": "{立绘8101}「被追上来了哦。"
 },
 {
  "id": "004364",
  "file": "WORLD/AREAD012.EMI",
  "seg": 13,
  "src": "{立绘4500}「走ったほうが\nいいと言ってます‥",
  "tgt": "{立绘4500}「他说\n快跑为妙…"
 },
 {
  "id": "004365",
  "file": "WORLD/AREAD012.EMI",
  "seg": 13,
  "src": "{框21}{色0A}○{/色}ボタンを 連打して\n走ってください。",
  "tgt": "{框21}{色0A}请连按○键\n奔跑。{/色}ボタンを 連打して\n走ってください。"
 },
 {
  "id": "004366",
  "file": "WORLD/AREAD012.EMI",
  "seg": 13,
  "src": "{立绘8040}「はあー、{码0B}よかった‥\n---\n助かっ‥‥{延时30}",
  "tgt": "{立绘8040}「哈——，太好了‥\n---\n得救‥‥{码0B}よかった‥\n---\n助かっ‥‥{延时30}"
 },
 {
  "id": "004367",
  "file": "WORLD/AREAD012.EMI",
  "seg": 13,
  "src": "{框03}{立绘4100}「‥た ワケでは\nないんですね、まだ。",
  "tgt": "{框03}{立绘4100}「…现在还没\n逃掉呢。"
 },
 {
  "id": "004368",
  "file": "WORLD/AREAD012.EMI",
  "seg": 13,
  "src": "{立绘8240}「わわっ‥！\n{队员00}！？",
  "tgt": "{立绘8240}「哇哇…！\n{队员00}！？"
 },
 {
  "id": "004369",
  "file": "WORLD/AREAD012.EMI",
  "seg": 13,
  "src": "{框06}{立绘C540}「恨みは、これぐらいでは\n死ねません。\n---\nバラバラになっても\nまた、呪いの中で\n大きくなるそうです‥",
  "tgt": "{框06}{立绘C540}「这点怨恨，是\n死不了的。\n---\n就算被碎尸万段\n据说也会在诅咒中\n再次长大‥"
 },
 {
  "id": "004370",
  "file": "WORLD/AREAD012.EMI",
  "seg": 13,
  "src": "{立绘0300}「なんだか‥\nかわいそうみたい‥\n---\n呪いって、ひどいですね‥",
  "tgt": "{立绘0300}「总觉得…\n挺可怜的…\n---\n诅咒真是可怕呢…"
 },
 {
  "id": "004371",
  "file": "WORLD/AREAD012.EMI",
  "seg": 13,
  "src": "{框06}{立绘8442}「呪いを 作ったのは\nヒトですから‥\n---\nざまあみろ、って\n{队员05}、言ってます。",
  "tgt": "{框06}{立绘8442}「因为制造诅咒的\n正是人类‥\n---\n活该，{队员05}是\n这么说的。"
 },
 {
  "id": "004372",
  "file": "WORLD/AREAD012.EMI",
  "seg": 13,
  "src": "{框06}{立绘C540}「‥では、行きますね。\n---\nそっちに ハシゴが\nあるんですね。",
  "tgt": "{框06}{立绘C540}「‥那我走了。\n---\n梯子\n在那边是吧。"
 },
 {
  "id": "004373",
  "file": "WORLD/AREAD012.EMI",
  "seg": 13,
  "src": "{立绘0402}「また、呪いのキリが\n滿ちてきたので‥\n---\n戻るのは 無理だそうです。",
  "tgt": "{立绘0402}「诅咒的雾又\n变浓了‥\n---\n据说回不去了。"
 },
 {
  "id": "004374",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "くれーたー",
  "tgt": "库雷塔"
 },
 {
  "id": "004375",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{框05}{立绘8040}「たっ、助けてぇっ！！{延时40}",
  "tgt": "{框05}{立绘8040}「救，救命啊！！{延时40}"
 },
 {
  "id": "004376",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{框06}{立绘4100}「わー‥、{码0B}大きな穴‥？",
  "tgt": "{框06}{立绘4100}「哇…，{码0B}好大的洞…？"
 },
 {
  "id": "004377",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{立绘4100}「荷車が‥\n---\nあの商人さん\n落っこちたんですね‥",
  "tgt": "{立绘4100}「货车…\n---\n那位商人先生\n掉下去了呢…"
 },
 {
  "id": "004378",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{框02}{立绘0141}「‥{码0B}‥こんな風に。",
  "tgt": "{框02}{立绘0141}「……就像这样。{码0B}‥こんな風に。"
 },
 {
  "id": "004379",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{框05}{立绘4100}「何か‥、{码0B}いる！？",
  "tgt": "{框05}{立绘4100}「有什么…，{码0B}在！？"
 },
 {
  "id": "004380",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{框05}{立绘4100}「おそって‥{码0B}‥、来ない‥？",
  "tgt": "{框05}{立绘4100}「有东西…{码0B}…、要扑过来…？"
 },
 {
  "id": "004381",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{框05}{立绘4100}「モンスターじゃ‥\nない‥、みたい‥{码0B}‥",
  "tgt": "{框05}{立绘4100}「好像…\n不是…魔物…{码0B}…"
 },
 {
  "id": "004382",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{框02}{立绘4100}「何だろう‥\nふしぎに‥、怖くなかった‥",
  "tgt": "{框02}{立绘4100}「是什么呢…\n不可思议地…、并不害怕…"
 },
 {
  "id": "004383",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{框02}{立绘4100}「‥{码0B}‥ひと！？",
  "tgt": "{框02}{立绘4100}「…{码0B}…人！？"
 },
 {
  "id": "004384",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{框40}{立绘0201}「{特效}わ{码0E}{/特效}\n---\n",
  "tgt": "{框40}{立绘0201}「哇\n---\n{特效}わ{码0E}{/特效}\n---\n"
 },
 {
  "id": "004385",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{立绘8201}「‥{码0B}‥{码0B}‥あのう",
  "tgt": "{立绘8201}「……那个{码0B}‥{码0B}‥あのう"
 },
 {
  "id": "004386",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{立绘8201}「できれば、何か\n着ていただけますか‥？\n---\nそこの、荷車のあたりに\n何かあると思います。",
  "tgt": "{立绘8201}「如果可以的话，能\n穿上点什么吗‥？\n---\n那边的货车附近\n应该有些东西。"
 },
 {
  "id": "004387",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{立绘C100}「そうですか‥\nさっきの 商人さんの\nお仲間じゃ、ないんですね。",
  "tgt": "{立绘C100}「这样啊…\n原来不是刚才那位\n商人先生的同伴。"
 },
 {
  "id": "004388",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{框03}{立绘4100}「どうして こんな\n穴の中に‥？\n---\n落っこちたんですか？\n---\nだいたい‥\nこんな大きな穴、どうやって\nできたんでしょうか？\n---\nそれに、さっきの‥\nモンスター‥、と言うか‥\n---\nそう、{码0B}竜みたいなの！\n見ましたか？\nあれって、何でしょうね？",
  "tgt": "{框03}{立绘4100}「为什么会在\n这样的洞里…？\n---\n是掉下来的吗？\n---\n话说…\n这么大的洞\n是怎么形成的呢？\n---\n还有，刚才那个…\n说是魔物…、又不像…\n---\n对，{码0B}像龙的东西！\n您看到了吗？\n那到底是什么呢？"
 },
 {
  "id": "004389",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{框03}{立绘4100}「あ‥、{码0B}{码0B}{立绘0101}ゴメンなさい\n---\nいっぺんに 闻いても\n分かりませんよね。",
  "tgt": "{框03}{立绘4100}「啊…，{码0B}{码0B}{立绘0101}对不起\n---\n一次问这么多\n您也答不上来呢。"
 },
 {
  "id": "004390",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{框04}{立绘C140}「わたし、ウインディアの\n{队员01} っていいます。\n---\nあなたは‥？",
  "tgt": "{框04}{立绘C140}「我是温迪亚的\n{队员01}。\n---\n你是‥？"
 },
 {
  "id": "004391",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{框04}{立绘8341}「{队员00}‥{码0B}‥、さん？\n---\n‥{码0B}‥{码0B}‥うん、{立绘C140}じゃあ\n{队员00}さん、とにかく\nここから、出ましょう。",
  "tgt": "{框04}{立绘8341}「{队员00}…{码0B}…、先生？\n---\n…{码0B}…{码0B}…嗯，{立绘C140}那么\n{队员00}先生，总之\n先从这里出去吧。"
 },
 {
  "id": "004392",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{框06}{立绘C140}「‥{码0B}‥えーと、それで\n{队员00}さんは\nどちらへ行かれるんです？",
  "tgt": "{框06}{立绘C140}「…{码0B}…那个，请问\n{队员00}先生\n您要去哪里呢？"
 },
 {
  "id": "004393",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{框06}{立绘C140}「分からない‥？\nふーん‥、それって‥\n---\n迷子ですね。",
  "tgt": "{框06}{立绘C140}「不知道‥？\n哦～，那‥\n---\n你是迷路了吧。"
 },
 {
  "id": "004394",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{框06}{立绘C140}「{队员00}さん、{码0B}そういうのを\n迷子って言うんです。\n---\n{立绘8141}「わたしも むかし\nよくなりました‥。",
  "tgt": "{框06}{立绘C140}「{队员00}先生，{码0B}这就叫\n迷路哦。\n---\n{立绘8141}「我以前也\n经常迷路…。"
 },
 {
  "id": "004395",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{框06}{立绘C140}「それじゃ、{队员00}さん\n---\nいっしょに 近くの町まで\n行きましょう‥",
  "tgt": "{框06}{立绘C140}「那么，{队员00}先生\n---\n一起去附近的\n镇上吧…"
 },
 {
  "id": "004396",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{队员00}は\n『{道具0101}』を 受け取った！\n---\n{立绘C140}「この剣を かしてあげます。",
  "tgt": "{队员00}收下了\n『{道具0101}』！\n---\n{立绘C140}「这把剑借给你。"
 },
 {
  "id": "004397",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{框06}{立绘C140}「町へ行くには\nモンスターの出る場所を\n通らないと ダメなので‥",
  "tgt": "{框06}{立绘C140}「要去镇上\n就得穿过魔物出没\n的地方‥"
 },
 {
  "id": "004398",
  "file": "WORLD/AREAD013.EMI",
  "seg": 12,
  "src": "{框06}{立绘4140}「それじゃ、行きましょう\n{队员00}さん‥",
  "tgt": "{框06}{立绘4140}「那么，走吧\n{队员00}先生…"
 },
 {
  "id": "004399",
  "file": "WORLD/AREAD014.EMI",
  "seg": 15,
  "src": "こうていぼしょ！",
  "tgt": "皇帝墓所！"
 },
 {
  "id": "004400",
  "file": "WORLD/AREAD014.EMI",
  "seg": 15,
  "src": "{立绘8000}「時は‥、{码0B}滿ちたか‥。",
  "tgt": "{立绘8000}「时机…，{码0B}已成熟了…。"
 },
 {
  "id": "004401",
  "file": "WORLD/AREAD014.EMI",
  "seg": 15,
  "src": "{框05}{立绘0101}「は、{码0B}しかしながら\n神皇さま‥{码0B}‥{码0B}‥\n---\n誰も、迎えに上がらぬとは\nなにやら 様子が\nおかしゅうございます。",
  "tgt": "{框05}{立绘0101}「是，然而\n神皇陛下……\n---\n竟无人前来迎接\n状况似乎\n有些古怪。{码0B}しかしながら\n神皇さま‥{码0B}‥{码0B}‥\n---\n誰も、迎えに上がらぬとは\nなにやら 様子が\nおかしゅうございます。"
 },
 {
  "id": "004402",
  "file": "WORLD/AREAD014.EMI",
  "seg": 15,
  "src": "{立绘C600}「ヒトどもの する事だ。\nいちいち気にしても\nはじまらん。\n---\nそれよりも‥",
  "tgt": "{立绘C600}「人类干的事。\n一一去计较\n也没完没了。\n---\n比起这个…"
 },
 {
  "id": "004403",
  "file": "WORLD/AREAD014.EMI",
  "seg": 15,
  "src": "{立绘0000}「この気配だ‥。\n---\n遠く‥‥\nまだ、目覺めていないが\nまちがいない‥。",
  "tgt": "{立绘0000}「就是这气息…。\n---\n远方……\n虽尚未觉醒\n但确凿无疑…。"
 },
 {
  "id": "004404",
  "file": "WORLD/AREAD014.EMI",
  "seg": 15,
  "src": "{立绘C600}「オンクー‥！\n我が寢所を護れ。{引0600}",
  "tgt": "{立绘C600}「翁库…！\n护住我的寝所。{引0600}"
 },
 {
  "id": "004405",
  "file": "WORLD/AREAD014.EMI",
  "seg": 15,
  "src": "{框43}{立绘0101}「御意。",
  "tgt": "{框43}{立绘0101}「遵命。"
 },
 {
  "id": "004406",
  "file": "WORLD/AREAD014.EMI",
  "seg": 15,
  "src": "{框04}{立绘8141}「神皇さまは、どちらへ？",
  "tgt": "{框04}{立绘8141}「神皇陛下要去哪里？"
 },
 {
  "id": "004407",
  "file": "WORLD/AREAD014.EMI",
  "seg": 15,
  "src": "{立绘4600}「都へ行く‥\n予定のとおりだ。",
  "tgt": "{立绘4600}「前往帝都…\n按原计划行事。"
 },
 {
  "id": "004408",
  "file": "WORLD/AREAD014.EMI",
  "seg": 15,
  "src": "{立绘C600}「いずれにせよ\n我らは、あの場所に\n向かう事になる‥{延时40}",
  "tgt": "{立绘C600}「无论如何\n我们都终将\n前往那个地方…{延时40}"
 },
 {
  "id": "004409",
  "file": "WORLD/AREAD014.EMI",
  "seg": 15,
  "src": "命にしたがい\nこの場を護っている‥",
  "tgt": "奉命\n守护此地‥"
 },
 {
  "id": "004410",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "ごうもんべや",
  "tgt": "刑讯室"
 },
 {
  "id": "004411",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘C240}「ここだ‥\n---\nここに、エリーナが‥！",
  "tgt": "{立绘C240}「在这里‥\n---\n艾莉娜就在这里‥！"
 },
 {
  "id": "004412",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「{队员00}さんの、おかげ‥{码0B}\n{立绘0000}です‥、ね？",
  "tgt": "{框05}{立绘4100}「都是托{队员00}先生的福…{码0B}\n{立绘0000}是吧…？"
 },
 {
  "id": "004413",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘C240}「よろこぶのは‥\nエリーナを 見つけてからだ。\n---\n行くぞ‥！",
  "tgt": "{立绘C240}「高兴还太早。\n---\n等找到艾莉娜再说‥\n走吧‥！"
 },
 {
  "id": "004414",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "旅の記錄ができます‥{码148B0C93}すこし休もう\n旅の記錄をしよう\n今は用がない",
  "tgt": "可记录旅程‥歇一歇再走\n记录旅程\n现在不需要{码148B0C93}すこし休もう\n旅の記錄をしよう\n今は用がない"
 },
 {
  "id": "004415",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框04}{立绘C540}「ぶくぶく‥\n---\n{队员05}は、いきを\nしないでも、だいじょうぶ\nでも‥\n---\n助けて、ありがとうって\n言ってます！",
  "tgt": "{框04}{立绘C540}「咕噜咕噜‥\n---\n{队员05}说，就算\n不呼吸也没事\n不过‥\n---\n还说谢谢\n你救了他！"
 },
 {
  "id": "004416",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘8141}「誰か来る！？",
  "tgt": "{立绘8141}「有人来了！？"
 },
 {
  "id": "004417",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘0202}「‥それで、いかがです\nニエの様子は？",
  "tgt": "{立绘0202}「‥那么，如何\n妮艾的情况如何？"
 },
 {
  "id": "004418",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框05}「は、{码0B}ユンナさま\n今のところ‥\n---\n成長を 續けています。",
  "tgt": "{框05}「是，云娜大人\n目前‥\n---\n仍在继续成长。{码0B}ユンナさま\n今のところ‥\n---\n成長を 續けています。"
 },
 {
  "id": "004419",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘0202}「やあ、{码0B}それはけっこう。",
  "tgt": "{立绘0202}「呀，那很好。{码0B}それはけっこう。"
 },
 {
  "id": "004420",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘4200}「ちっ、{码0B}まずいな‥",
  "tgt": "{立绘4200}「啧，{码0B}不妙啊…"
 },
 {
  "id": "004421",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘4200}「そっちから‥\nカーテンのうらを 通ろう。\n---\nゆっくりな‥",
  "tgt": "{立绘4200}「从那边…\n穿过窗帘后面走吧。\n---\n慢一点…"
 },
 {
  "id": "004422",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "出ていったら、見つかってしまう！\nカーテンのうらを 通ろう。",
  "tgt": "出去就会被发现！\n从窗帘后面穿过去吧。"
 },
 {
  "id": "004423",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框0C}「それで、ユンナさま‥\nこの調子ですと‥",
  "tgt": "{框0C}「那么，云娜大人‥\n照这个进度‥"
 },
 {
  "id": "004424",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘C140}「よかった、{码0B}見つからなく‥{引1000}",
  "tgt": "{立绘C140}「太好了，没被发现‥{码0B}見つからなく‥{引1000}"
 },
 {
  "id": "004425",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框03}{立绘0202}「見つかってますよ。",
  "tgt": "{框03}{立绘0202}「被发现咯。"
 },
 {
  "id": "004426",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框03}{立绘0202}「やー、{码0B}いけませんな。\n---\nここは、フォウ帝国の\n建物ですよ‥ 東の方？",
  "tgt": "{框03}{立绘0202}「呀—，这可不行啊。\n---\n这里可是福乌帝国的\n建筑哦‥东方那边？{码0B}いけませんな。\n---\nここは、フォウ帝国の\n建物ですよ‥ 東の方？"
 },
 {
  "id": "004427",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框04}{立绘C240}「人を‥ 探しているんだ。",
  "tgt": "{框04}{立绘C240}「我在‥找人。"
 },
 {
  "id": "004428",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框04}{立绘8340}「わたしの、姉さまなんです‥\n---\nエリーナって 言うんです‥\nここに来たって‥！",
  "tgt": "{框04}{立绘8340}「是我的姐姐‥\n---\n她叫艾莉娜‥\n听说来这里了‥！"
 },
 {
  "id": "004429",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框04}{立绘8141}「知っているのか！？",
  "tgt": "{框04}{立绘8141}「你知道她！？"
 },
 {
  "id": "004430",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框03}{立绘0202}「あ、{码0B}ややや！\n近づかないで下さいね‥",
  "tgt": "{框03}{立绘0202}「啊，呀呀呀！\n请不要靠近我哦‥{码0B}ややや！\n近づかないで下さいね‥"
 },
 {
  "id": "004431",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框03}{立绘0202}「エリーナ‥、王女さま‥？\n---\nその方は、確かに\nこの町に、おいででした‥",
  "tgt": "{框03}{立绘0202}「艾莉娜‥，王女殿下‥？\n---\n那位大人确实\n来过这座城‥"
 },
 {
  "id": "004432",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框03}{立绘0202}「おやさしい方で‥\n---\n戦爭で傷ついた人々を\nおみまいなさってたとか‥\nでも‥‥",
  "tgt": "{框03}{立绘0202}「是位很温柔的人‥\n---\n还去探望过战争中\n受伤的人们‥\n不过……"
 },
 {
  "id": "004433",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框05}{立绘0202}「もう、いらっしゃいませんよ\nその方は‥",
  "tgt": "{框05}{立绘0202}「那位大人\n已经不在了哦‥"
 },
 {
  "id": "004434",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框05}{立绘0202}「や、{码0B}残念ですが‥\nウソでは ありません。\n---\nさて‥‥！",
  "tgt": "{框05}{立绘0202}「唉，很遗憾\n但这不是谎话。\n---\n那么……！{码0B}残念ですが‥\nウソでは ありません。\n---\nさて‥‥！"
 },
 {
  "id": "004435",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框05}{立绘0202}「そろそろ、お归り\nいただきましょうか‥\n東の方‥‥",
  "tgt": "{框05}{立绘0202}「差不多该请\n二位回去了‥\n往东边……"
 },
 {
  "id": "004436",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框06}{立绘8440}「兄さま、ここ‥‥{延时40}",
  "tgt": "{框06}{立绘8440}「兄长，这里……{延时40}"
 },
 {
  "id": "004437",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘C240}「そうだ‥\nエリーナを 探しに‥",
  "tgt": "{立绘C240}「对‥\n去找艾莉娜‥"
 },
 {
  "id": "004438",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘8141}「それにしても‥\n---\n軍本部と 言うわりには\nこの気配は‥！？",
  "tgt": "{立绘8141}「话说回来‥\n---\n明明说是军部\n这气氛却‥！？"
 },
 {
  "id": "004439",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「どうして‥‥\n---\n軍の建物に\n魔物が出る‥？",
  "tgt": "{框06}{立绘8141}「为什么……\n---\n军部的建筑里\n会有魔物‥？"
 },
 {
  "id": "004440",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框06}{立绘4200}「ともかく‥\n行ってみるしか、ないか。",
  "tgt": "{框06}{立绘4200}「总之…\n只能去看看了。"
 },
 {
  "id": "004441",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "「魔物が‥‥\n次から、次に‥‥",
  "tgt": "「魔物‥‥\n接二连三‥‥"
 },
 {
  "id": "004442",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "「ううう‥",
  "tgt": "「呜呜呜‥"
 },
 {
  "id": "004443",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "「いきなり、魔物が\nわいてきて‥\n---\nルーン將軍は、部隊をひきいて\nおくへ‥‥",
  "tgt": "「魔物突然\n冒了出来‥\n---\n鲁恩将军已率部队\n去了后方……"
 },
 {
  "id": "004444",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "死んでいる‥‥",
  "tgt": "死了……"
 },
 {
  "id": "004445",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "「ま、魔物が‥、魔物がっ！\n---\nユンナの奴が‥\n呪いの実驗なんか\nしてたからだ‥！",
  "tgt": "「魔，魔物‥，魔物啊！\n---\n都怪云娜那家伙‥\n搞什么诅咒\n实验‥！"
 },
 {
  "id": "004446",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘0101}「何‥{码0B}だ、ここは？\n---\n內臟‥‥？",
  "tgt": "{立绘0101}「这是‥哪里？\n---\n内脏……？{码0B}だ、ここは？\n---\n內臟‥‥？"
 },
 {
  "id": "004447",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "ぶよぶよと、やわらかい‥\n切る事ができるだろうか‥？",
  "tgt": "又软又绵绵的‥\n能切开吗‥？"
 },
 {
  "id": "004448",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘8543}「それは‥\n切る事が、できません‥",
  "tgt": "{立绘8543}「那个‥\n切不开‥"
 },
 {
  "id": "004449",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘0601}「エ‥‥、{码0B}エリーナ！？",
  "tgt": "{立绘0601}「诶……，艾莉娜！？{码0B}エリーナ！？"
 },
 {
  "id": "004450",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框05}{立绘0400}「姉さま！？",
  "tgt": "{框05}{立绘0400}「姐姐！？"
 },
 {
  "id": "004451",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘8543}「{队员02}‥\n{队员01}‥‥！？",
  "tgt": "{立绘8543}「{队员02}‥\n{队员01}……！？"
 },
 {
  "id": "004452",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框05}{立绘4200}「エリーナ！\n---\nエリーナ、そこへ行く‥\nどうすればいい！？",
  "tgt": "{框05}{立绘4200}「艾莉娜！\n---\n艾莉娜，你要去那里…\n我该怎么办！？"
 },
 {
  "id": "004453",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘8543}「道をふさいでいる、それは‥\nふつうの剣では\n切れません。\n---\nそれを 切る事ができるのは\n『{道具5601}』だけです‥",
  "tgt": "{立绘8543}「堵住去路的那个‥\n普通的剑\n切不断。\n---\n能切开它的\n只有『{道具5601}』‥"
 },
 {
  "id": "004454",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘0300}「姉さま、その剣は\nどこにあるのです！？",
  "tgt": "{立绘0300}「姐姐，那把剑\n在哪里！？"
 },
 {
  "id": "004455",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{框06}{立绘8543}「ユンナという男が\n持っているはずです‥\n---\nユンナを 探しなさい。",
  "tgt": "{框06}{立绘8543}「应该在一个叫\n云娜的男人手里‥\n---\n去找云娜吧。"
 },
 {
  "id": "004456",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘0101}「ユンナ‥‥",
  "tgt": "{立绘0101}「云娜……"
 },
 {
  "id": "004457",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘4100}「分かりました、姉さま！\n---\nきっと、その‥\n『{道具5601}』を\n持ってきます‥！",
  "tgt": "{立绘4100}「明白了，姐姐！\n---\n我一定把那把…\n『{道具5601}』\n拿来…！"
 },
 {
  "id": "004458",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘0700}「兄さま‥！\nエリーナ姉さまが‥\n姉さまが！",
  "tgt": "{立绘0700}「兄长…！\n艾莉娜姐姐…\n姐姐她！"
 },
 {
  "id": "004459",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘C240}「ああ‥！\nしかし、今は‥‥\n---\nその、ユンナってやつを\n探し出して‥",
  "tgt": "{立绘C240}「啊‥！\n可是，现在……\n---\n先找出那个\n叫云娜的家伙‥"
 },
 {
  "id": "004460",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘C240}「{道具5601}を\n手に入れるのが、先だ。\n---\n行こう‥！",
  "tgt": "{立绘C240}「拿到{道具5601}\n才是当务之急。\n---\n走吧‥！"
 },
 {
  "id": "004461",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "この剣では、切れない‥\nユンナを見つけ出し\n{道具5601}を 手に入れなくては‥",
  "tgt": "这把剑切不断‥\n必须找到云娜\n拿到{道具5601}"
 },
 {
  "id": "004462",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "「ああ‥？\n---\nユンナってのは、この建物で\n呪いの実驗してた\nやろうだよ‥\n---\nアイツのせいで、ここは\n魔物が あふれちまったんだ！",
  "tgt": "「啊‥？\n---\n云娜就是在\n这座建筑里搞诅咒\n实验的家伙‥\n---\n都怪他，这里\n魔物才泛滥成灾！"
 },
 {
  "id": "004463",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘8340}「邪悪な感じが‥\n強くなってます‥！",
  "tgt": "{立绘8340}「邪恶的气息‥\n变强了‥！"
 },
 {
  "id": "004464",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘8141}「く‥、{码0B}邪悪な気が\n強くなっている‥",
  "tgt": "{立绘8141}「可‥，邪恶的气息\n变强了‥{码0B}邪悪な気が\n強くなっている‥"
 },
 {
  "id": "004465",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘8844}「これは‥\n邪悪な気が 強く‥！？",
  "tgt": "{立绘8844}「这是‥\n邪恶气息很强‥！？"
 },
 {
  "id": "004466",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{立绘8945}「イヤな感じだね‥\n---\n{立绘C540}って言ってますよ。",
  "tgt": "{立绘8945}「感觉真讨厌‥\n---\n{立绘C540}是这么说的。"
 },
 {
  "id": "004467",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "{队员00}は‥\n{道具5601}を かまえた‥",
  "tgt": "{队员00}…\n摆出了{道具5601}的架势…"
 },
 {
  "id": "004468",
  "file": "WORLD/AREAD015.EMI",
  "seg": 11,
  "src": "この剣では、切れない‥！\n---\n{色03}{道具5601}{/色}を 装備しよう。",
  "tgt": "这把剑切不断‥！\n---\n装备{色03}{道具5601}{/色}吧。"
 },
 {
  "id": "004469",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "ごうもんべや",
  "tgt": "刑讯室"
 },
 {
  "id": "004470",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘C240}「ここだ‥\n---\nここに、エリーナが‥！",
  "tgt": "{立绘C240}「在这里‥\n---\n艾莉娜就在这里‥！"
 },
 {
  "id": "004471",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「{队员00}さんの、おかげ‥{码0B}\n{立绘0000}です‥、ね？",
  "tgt": "{框05}{立绘4100}「都是托{队员00}先生的福…{码0B}\n{立绘0000}是吧…？"
 },
 {
  "id": "004472",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘C240}「よろこぶのは‥\nエリーナを 見つけてからだ。\n---\n行くぞ‥！",
  "tgt": "{立绘C240}「高兴还太早。\n---\n等找到艾莉娜再说‥\n走吧‥！"
 },
 {
  "id": "004473",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "旅の記錄ができます‥{码148B0C93}すこし休もう\n旅の記錄をしよう\n今は用がない",
  "tgt": "可记录旅程‥歇一歇再走\n记录旅程\n现在不需要{码148B0C93}すこし休もう\n旅の記錄をしよう\n今は用がない"
 },
 {
  "id": "004474",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框04}{立绘C540}「ぶくぶく‥\n---\n{队员05}は、いきを\nしないでも、だいじょうぶ\nでも‥\n---\n助けて、ありがとうって\n言ってます！",
  "tgt": "{框04}{立绘C540}「咕噜咕噜‥\n---\n{队员05}说，就算\n不呼吸也没事\n不过‥\n---\n还说谢谢\n你救了他！"
 },
 {
  "id": "004475",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘8141}「誰か来る！？",
  "tgt": "{立绘8141}「有人来了！？"
 },
 {
  "id": "004476",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘0202}「‥それで、いかがです\nニエの様子は？",
  "tgt": "{立绘0202}「‥那么，如何\n妮艾的情况如何？"
 },
 {
  "id": "004477",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框05}「は、{码0B}ユンナさま\n今のところ‥\n---\n成長を 續けています。",
  "tgt": "{框05}「是，云娜大人\n目前‥\n---\n仍在继续成长。{码0B}ユンナさま\n今のところ‥\n---\n成長を 續けています。"
 },
 {
  "id": "004478",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘0202}「やあ、{码0B}それはけっこう。",
  "tgt": "{立绘0202}「呀，那很好。{码0B}それはけっこう。"
 },
 {
  "id": "004479",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘4200}「ちっ、{码0B}まずいな‥",
  "tgt": "{立绘4200}「啧，{码0B}不妙啊…"
 },
 {
  "id": "004480",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘4200}「そっちから‥\nカーテンのうらを 通ろう。\n---\nゆっくりな‥",
  "tgt": "{立绘4200}「从那边…\n穿过窗帘后面走吧。\n---\n慢一点…"
 },
 {
  "id": "004481",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "出ていったら、見つかってしまう！\nカーテンのうらを 通ろう。",
  "tgt": "出去就会被发现！\n从窗帘后面穿过去吧。"
 },
 {
  "id": "004482",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框0C}「それで、ユンナさま‥\nこの調子ですと‥",
  "tgt": "{框0C}「那么，云娜大人‥\n照这个进度‥"
 },
 {
  "id": "004483",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘C140}「よかった、{码0B}見つからなく‥{引1000}",
  "tgt": "{立绘C140}「太好了，没被发现‥{码0B}見つからなく‥{引1000}"
 },
 {
  "id": "004484",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框03}{立绘0202}「見つかってますよ。",
  "tgt": "{框03}{立绘0202}「被发现咯。"
 },
 {
  "id": "004485",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框03}{立绘0202}「やー、{码0B}いけませんな。\n---\nここは、フォウ帝国の\n建物ですよ‥ 東の方？",
  "tgt": "{框03}{立绘0202}「呀—，这可不行啊。\n---\n这里可是福乌帝国的\n建筑哦‥东方那边？{码0B}いけませんな。\n---\nここは、フォウ帝国の\n建物ですよ‥ 東の方？"
 },
 {
  "id": "004486",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框04}{立绘C240}「人を‥ 探しているんだ。",
  "tgt": "{框04}{立绘C240}「我在‥找人。"
 },
 {
  "id": "004487",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框04}{立绘8340}「わたしの、姉さまなんです‥\n---\nエリーナって 言うんです‥\nここに来たって‥！",
  "tgt": "{框04}{立绘8340}「是我的姐姐‥\n---\n她叫艾莉娜‥\n听说来这里了‥！"
 },
 {
  "id": "004488",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框04}{立绘8141}「知っているのか！？",
  "tgt": "{框04}{立绘8141}「你知道她！？"
 },
 {
  "id": "004489",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框03}{立绘0202}「あ、{码0B}ややや！\n近づかないで下さいね‥",
  "tgt": "{框03}{立绘0202}「啊，呀呀呀！\n请不要靠近我哦‥{码0B}ややや！\n近づかないで下さいね‥"
 },
 {
  "id": "004490",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框03}{立绘0202}「エリーナ‥、王女さま‥？\n---\nその方は、確かに\nこの町に、おいででした‥",
  "tgt": "{框03}{立绘0202}「艾莉娜‥，王女殿下‥？\n---\n那位大人确实\n来过这座城‥"
 },
 {
  "id": "004491",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框03}{立绘0202}「おやさしい方で‥\n---\n戦爭で傷ついた人々を\nおみまいなさってたとか‥\nでも‥‥",
  "tgt": "{框03}{立绘0202}「是位很温柔的人‥\n---\n还去探望过战争中\n受伤的人们‥\n不过……"
 },
 {
  "id": "004492",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框05}{立绘0202}「もう、いらっしゃいませんよ\nその方は‥",
  "tgt": "{框05}{立绘0202}「那位大人\n已经不在了哦‥"
 },
 {
  "id": "004493",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框05}{立绘0202}「や、{码0B}残念ですが‥\nウソでは ありません。\n---\nさて‥‥！",
  "tgt": "{框05}{立绘0202}「唉，很遗憾\n但这不是谎话。\n---\n那么……！{码0B}残念ですが‥\nウソでは ありません。\n---\nさて‥‥！"
 },
 {
  "id": "004494",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框05}{立绘0202}「そろそろ、お归り\nいただきましょうか‥\n東の方‥‥",
  "tgt": "{框05}{立绘0202}「差不多该请\n二位回去了‥\n往东边……"
 },
 {
  "id": "004495",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框06}{立绘8440}「兄さま、ここ‥‥{延时40}",
  "tgt": "{框06}{立绘8440}「兄长，这里……{延时40}"
 },
 {
  "id": "004496",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘C240}「そうだ‥\nエリーナを 探しに‥",
  "tgt": "{立绘C240}「对‥\n去找艾莉娜‥"
 },
 {
  "id": "004497",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘8141}「それにしても‥\n---\n軍本部と 言うわりには\nこの気配は‥！？",
  "tgt": "{立绘8141}「话说回来‥\n---\n明明说是军部\n这气氛却‥！？"
 },
 {
  "id": "004498",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「どうして‥‥\n---\n軍の建物に\n魔物が出る‥？",
  "tgt": "{框06}{立绘8141}「为什么……\n---\n军部的建筑里\n会有魔物‥？"
 },
 {
  "id": "004499",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框06}{立绘4200}「ともかく‥\n行ってみるしか、ないか。",
  "tgt": "{框06}{立绘4200}「总之…\n只能去看看了。"
 },
 {
  "id": "004500",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "「魔物が‥‥\n次から、次に‥‥",
  "tgt": "「魔物‥‥\n接二连三‥‥"
 },
 {
  "id": "004501",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "「ううう‥",
  "tgt": "「呜呜呜‥"
 },
 {
  "id": "004502",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "「いきなり、魔物が\nわいてきて‥\n---\nルーン將軍は、部隊をひきいて\nおくへ‥‥",
  "tgt": "「魔物突然\n冒了出来‥\n---\n鲁恩将军已率部队\n去了后方……"
 },
 {
  "id": "004503",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "死んでいる‥‥",
  "tgt": "死了……"
 },
 {
  "id": "004504",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "「ま、魔物が‥、魔物がっ！\n---\nユンナの奴が‥\n呪いの実驗なんか\nしてたからだ‥！",
  "tgt": "「魔，魔物‥，魔物啊！\n---\n都怪云娜那家伙‥\n搞什么诅咒\n实验‥！"
 },
 {
  "id": "004505",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘0101}「何‥{码0B}だ、ここは？\n---\n內臟‥‥？",
  "tgt": "{立绘0101}「这是‥哪里？\n---\n内脏……？{码0B}だ、ここは？\n---\n內臟‥‥？"
 },
 {
  "id": "004506",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "ぶよぶよと、やわらかい‥\n切る事ができるだろうか‥？",
  "tgt": "又软又绵绵的‥\n能切开吗‥？"
 },
 {
  "id": "004507",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘8543}「それは‥\n切る事が、できません‥",
  "tgt": "{立绘8543}「那个‥\n切不开‥"
 },
 {
  "id": "004508",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘0601}「エ‥‥、{码0B}エリーナ！？",
  "tgt": "{立绘0601}「诶……，艾莉娜！？{码0B}エリーナ！？"
 },
 {
  "id": "004509",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框05}{立绘0400}「姉さま！？",
  "tgt": "{框05}{立绘0400}「姐姐！？"
 },
 {
  "id": "004510",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘8543}「{队员02}‥\n{队员01}‥‥！？",
  "tgt": "{立绘8543}「{队员02}‥\n{队员01}……！？"
 },
 {
  "id": "004511",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框05}{立绘4200}「エリーナ！\n---\nエリーナ、そこへ行く‥\nどうすればいい！？",
  "tgt": "{框05}{立绘4200}「艾莉娜！\n---\n艾莉娜，你要去那里…\n我该怎么办！？"
 },
 {
  "id": "004512",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘8543}「道をふさいでいる、それは‥\nふつうの剣では\n切れません。\n---\nそれを 切る事ができるのは\n『{道具5601}』だけです‥",
  "tgt": "{立绘8543}「堵住去路的那个‥\n普通的剑\n切不断。\n---\n能切开它的\n只有『{道具5601}』‥"
 },
 {
  "id": "004513",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘0300}「姉さま、その剣は\nどこにあるのです！？",
  "tgt": "{立绘0300}「姐姐，那把剑\n在哪里！？"
 },
 {
  "id": "004514",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{框06}{立绘8543}「ユンナという男が\n持っているはずです‥\n---\nユンナを 探しなさい。",
  "tgt": "{框06}{立绘8543}「应该在一个叫\n云娜的男人手里‥\n---\n去找云娜吧。"
 },
 {
  "id": "004515",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘0101}「ユンナ‥‥",
  "tgt": "{立绘0101}「云娜……"
 },
 {
  "id": "004516",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘4100}「分かりました、姉さま！\n---\nきっと、その‥\n『{道具5601}』を\n持ってきます‥！",
  "tgt": "{立绘4100}「明白了，姐姐！\n---\n我一定把那把…\n『{道具5601}』\n拿来…！"
 },
 {
  "id": "004517",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘0700}「兄さま‥！\nエリーナ姉さまが‥\n姉さまが！",
  "tgt": "{立绘0700}「兄长…！\n艾莉娜姐姐…\n姐姐她！"
 },
 {
  "id": "004518",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘C240}「ああ‥！\nしかし、今は‥‥\n---\nその、ユンナってやつを\n探し出して‥",
  "tgt": "{立绘C240}「啊‥！\n可是，现在……\n---\n先找出那个\n叫云娜的家伙‥"
 },
 {
  "id": "004519",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘C240}「{道具5601}を\n手に入れるのが、先だ。\n---\n行こう‥！",
  "tgt": "{立绘C240}「拿到{道具5601}\n才是当务之急。\n---\n走吧‥！"
 },
 {
  "id": "004520",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "この剣では、切れない‥\nユンナを見つけ出し\n{道具5601}を 手に入れなくては‥",
  "tgt": "这把剑切不断‥\n必须找到云娜\n拿到{道具5601}"
 },
 {
  "id": "004521",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "「ああ‥？\n---\nユンナってのは、この建物で\n呪いの実驗してた\nやろうだよ‥\n---\nアイツのせいで、ここは\n魔物が あふれちまったんだ！",
  "tgt": "「啊‥？\n---\n云娜就是在\n这座建筑里搞诅咒\n实验的家伙‥\n---\n都怪他，这里\n魔物才泛滥成灾！"
 },
 {
  "id": "004522",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘8340}「邪悪な感じが‥\n強くなってます‥！",
  "tgt": "{立绘8340}「邪恶的气息‥\n变强了‥！"
 },
 {
  "id": "004523",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘8141}「く‥、{码0B}邪悪な気が\n強くなっている‥",
  "tgt": "{立绘8141}「可‥，邪恶的气息\n变强了‥{码0B}邪悪な気が\n強くなっている‥"
 },
 {
  "id": "004524",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘8844}「これは‥\n邪悪な気が 強く‥！？",
  "tgt": "{立绘8844}「这是‥\n邪恶气息很强‥！？"
 },
 {
  "id": "004525",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{立绘8945}「イヤな感じだね‥\n---\n{立绘C540}って言ってますよ。",
  "tgt": "{立绘8945}「感觉真讨厌‥\n---\n{立绘C540}是这么说的。"
 },
 {
  "id": "004526",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "{队员00}は‥\n{道具5601}を かまえた‥",
  "tgt": "{队员00}…\n摆出了{道具5601}的架势…"
 },
 {
  "id": "004527",
  "file": "WORLD/AREAD016.EMI",
  "seg": 11,
  "src": "この剣では、切れない‥！\n---\n{色03}{道具5601}{/色}を 装備しよう。",
  "tgt": "这把剑切不断‥！\n---\n装备{色03}{道具5601}{/色}吧。"
 },
 {
  "id": "004528",
  "file": "WORLD/AREAD019.EMI",
  "seg": 8,
  "src": "いのしし",
  "tgt": "野猪"
 },
 {
  "id": "004529",
  "file": "WORLD/AREAD019.EMI",
  "seg": 8,
  "src": "「あー‥ ダメです。\nこの先には 入らない方が\nいいですよ‥",
  "tgt": "「啊—‥不行。\n最好别进\n前面的路‥"
 },
 {
  "id": "004530",
  "file": "WORLD/AREAD019.EMI",
  "seg": 8,
  "src": "「あ、ダメですダメです。\nこの先には 入らない方が‥",
  "tgt": "「啊，不行不行。\n前面别进去‥"
 },
 {
  "id": "004531",
  "file": "WORLD/AREAD019.EMI",
  "seg": 8,
  "src": "「え？\n村長に ご用ですか？\n---\n‥{码0B}‥{码0B}‥困ったな\nどうしよう。",
  "tgt": "「咦？\n你找村长吗？\n---\n……麻烦了\n怎么办。{码0B}‥{码0B}‥困ったな\nどうしよう。"
 },
 {
  "id": "004532",
  "file": "WORLD/AREAD019.EMI",
  "seg": 8,
  "src": "「たしかに‥\nキリア村の村長は\nこの森に 来ていますが‥\n---\n早い話しが、その\n行方不明なのです。",
  "tgt": "「确实‥\n奇莉亚村的村长\n来过这片森林‥\n---\n简单说，他\n失踪了。"
 },
 {
  "id": "004533",
  "file": "WORLD/AREAD019.EMI",
  "seg": 8,
  "src": "「ワケが 分からなく\nなってしまったのです‥",
  "tgt": "「他自己也变得\n不明所以了‥"
 },
 {
  "id": "004534",
  "file": "WORLD/AREAD019.EMI",
  "seg": 8,
  "src": "{框06}{立绘8040}「で‥、村長は？",
  "tgt": "{框06}{立绘8040}「那‥，村长呢？"
 },
 {
  "id": "004535",
  "file": "WORLD/AREAD019.EMI",
  "seg": 8,
  "src": "{框06}{立绘8141}「はあ‥、{码0B}それで\n村長さんは？",
  "tgt": "{框06}{立绘8141}「哈‥，那么\n村长先生呢？{码0B}それで\n村長さんは？"
 },
 {
  "id": "004536",
  "file": "WORLD/AREAD019.EMI",
  "seg": 8,
  "src": "{框05}「うーん‥\n自分のしかけた ワナに\nひっかかってるか‥",
  "tgt": "{框05}「唔‥\n要么是被自己下的\n陷阱困住了‥"
 },
 {
  "id": "004537",
  "file": "WORLD/AREAD019.EMI",
  "seg": 8,
  "src": "{框05}「れいの ケモノに\n捕まってしまったか‥\n---\nどちらかですね。",
  "tgt": "{框05}「要么是被那只\n野兽抓走了‥\n---\n就这两种可能。"
 },
 {
  "id": "004538",
  "file": "WORLD/AREAD019.EMI",
  "seg": 8,
  "src": "{框05}「うーん‥\n探しに行くと言うなら\n止めませんが‥‥\n---\n‥{码0B}‥だったら\nコレを さしあげます。",
  "tgt": "{框05}「唔‥\n你们要去找的话\n我不拦着‥‥\n---\n……那就\n把这个给你们。{码0B}‥だったら\nコレを さしあげます。"
 },
 {
  "id": "004539",
  "file": "WORLD/AREAD019.EMI",
  "seg": 8,
  "src": " \n    {色03}{道具0700}{/色}を もらった！",
  "tgt": " \n    得到了{色03}{道具0700}{/色}！"
 },
 {
  "id": "004540",
  "file": "WORLD/AREAD019.EMI",
  "seg": 8,
  "src": "{框05}「その、{道具0700}を\n森の中の {色02}きりかぶ{/色}に\n置いてみて下さい‥\n---\nケモノを さそい出す事が\nできるハズです。",
  "tgt": "{框05}「请把那个{道具0700}\n放在森林里的{色02}树桩{/色}上\n试试…\n---\n应该能把野兽\n引出来。"
 },
 {
  "id": "004541",
  "file": "WORLD/AREAD019.EMI",
  "seg": 8,
  "src": "{框06}{立绘C140}「それで、そのケモノを\n追いかければ‥{引0F00}",
  "tgt": "{框06}{立绘C140}「那么，追着那只\n野兽去的话‥{引0F00}"
 },
 {
  "id": "004542",
  "file": "WORLD/AREAD019.EMI",
  "seg": 8,
  "src": "{框06}{立绘C240}「ふむ‥、それで\nそのケモノを 追えば‥{引0F00}",
  "tgt": "{框06}{立绘C240}「嗯‥，那\n追着那只野兽去‥{引0F00}"
 },
 {
  "id": "004543",
  "file": "WORLD/AREAD019.EMI",
  "seg": 8,
  "src": "{框03}「ええ、まぁ‥ 村長が\n見つかるかも しれません。",
  "tgt": "{框03}「嗯，嘛‥说不定\n能找到村长。"
 },
 {
  "id": "004544",
  "file": "WORLD/AREAD019.EMI",
  "seg": 8,
  "src": "{框05}「でも‥、{码0B}ワナには\n気をつけてくださいね。\n---\n何せ たくさんあるんで‥",
  "tgt": "{框05}「不过‥，要小心\n陷阱哦。\n---\n毕竟到处都是‥{码0B}ワナには\n気をつけてくださいね。\n---\n何せ たくさんあるんで‥"
 },
 {
  "id": "004545",
  "file": "WORLD/AREAD019.EMI",
  "seg": 8,
  "src": "「{道具0700}が なくなったら\nそこの木に なってるんで‥\n---\n体当たりでも すれば\n手に入りますよ。",
  "tgt": "「{道具0700}用完了\n就长在那棵树上…\n---\n撞一撞\n就能拿到哦。"
 },
 {
  "id": "004546",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "おちるがけー",
  "tgt": "崩落崖"
 },
 {
  "id": "004547",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{立绘C100}「サライの町は‥\n---\nこの、ガケ道を こえた\n所なのです‥",
  "tgt": "{立绘C100}「萨莱镇…\n---\n就在越过这条\n崖道的地方…"
 },
 {
  "id": "004548",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{立绘C140}「日のあるうちに\n急ぎましょうか‥",
  "tgt": "{立绘C140}「趁天还亮\n抓紧赶路吧‥"
 },
 {
  "id": "004549",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{框04}{立绘C140}「道が、とぎれてますね。",
  "tgt": "{框04}{立绘C140}「路，断了呢。"
 },
 {
  "id": "004550",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「でも、だいじょうぶです。\n---\nこんな場所は、ジャンプして\nとびこせるのです。",
  "tgt": "{框06}{立绘C140}「不过，不要紧。\n---\n这种地方，跳一下\n就能越过去。"
 },
 {
  "id": "004551",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「とびこせそうな 場所で\n{色0A}○{/色}ボタンを 押すか‥\n---\nジャンプしたい 方向に\n{色05}方向キー{/色}を いれれば\nいいんです‥\n---\nやってみて下さい。",
  "tgt": "{框06}{立绘C140}「在能跳过去的地方\n按○键‥\n---\n或朝想跳的方向\n推方向键\n就行‥\n---\n请试试看。{色0A}○{/色}ボタンを 押すか‥\n---\nジャンプしたい 方向に\n{色05}方向キー{/色}を いれれば\nいいんです‥\n---\nやってみて下さい。"
 },
 {
  "id": "004552",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{框04}{立绘C140}「‥{码0B}‥{码0B}‥と、いう感じで\nもうひとつ、そっちも\nとびこえちゃいましょう。",
  "tgt": "{框04}{立绘C140}「……就像这样\n那边那个\n也跳过去吧。{码0B}‥{码0B}‥と、いう感じで\nもうひとつ、そっちも\nとびこえちゃいましょう。"
 },
 {
  "id": "004553",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{框04}{立绘C140}「高い所、こわいですか‥？\n---\nわたしたち、ウインディア人は\nわりと 平気なんですけど‥",
  "tgt": "{框04}{立绘C140}「怕高吗‥？\n---\n我们温迪亚人\n倒是不怎么怕‥"
 },
 {
  "id": "004554",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{立绘C140}「ちゃんと、ジャンプできて\nよかったですね‥\n---\nすっごい高いですよ！",
  "tgt": "{立绘C140}「能顺利跳过来\n太好了‥\n---\n这里可高得很哦！"
 },
 {
  "id": "004555",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{立绘C140}「うわー‥{码0B}‥{码0B}‥",
  "tgt": "{立绘C140}「哇——……{码0B}‥{码0B}‥"
 },
 {
  "id": "004556",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{立绘8040}「高い所って‥\n何だか くらくらして\n楽しいですよね？",
  "tgt": "{立绘8040}「站得高高的‥\n总让人头晕目眩\n又很开心呢？"
 },
 {
  "id": "004557",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{立绘8140}「だ、{码0B}だいじょうぶですか\n{队员00}さんっ！？",
  "tgt": "{立绘8140}「没、{码0B}没事吧\n{队员00}先生！？"
 },
 {
  "id": "004558",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{立绘8240}「とび下りてきて\nくれたんですか‥‥？",
  "tgt": "{立绘8240}「你是自己\n跳下来的‥‥？"
 },
 {
  "id": "004559",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{立绘8240}「ケガ‥、しませんでした？\n---\nごめんなさい‥‥\nわたし、翼があるから‥\n---\nちょっとぐらい 高い所から\n落ちても、平気なんです。",
  "tgt": "{立绘8240}「没‥，受伤吧？\n---\n对不起……\n我有翅膀‥\n---\n从稍微高一点的地方\n掉下来，也不碍事。"
 },
 {
  "id": "004560",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{立绘C140}「でも、勇気ありますね\n{队员00}さん、ちょっと‥\n---\n{立绘8340}「カッコよかったですよ。",
  "tgt": "{立绘C140}「不过真有勇气呢\n{队员00}先生，刚才…\n---\n{立绘8340}「真帅气。"
 },
 {
  "id": "004561",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「暗くなってきましたね‥",
  "tgt": "{框06}{立绘C140}「天色暗下来了‥"
 },
 {
  "id": "004562",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「ガケを上がるのは\n明るくなってからの方が\n良さそうですね‥\n---\nどこか、休めそうな場所を\n探しましょう。",
  "tgt": "{框06}{立绘C140}「爬悬崖\n还是等天亮之后\n比较好‥\n---\n找找有没有\n能休息的地方吧。"
 },
 {
  "id": "004563",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "ここから、上がれそうだが‥\n暗くなると危険なので、\n今はやめておこう。",
  "tgt": "这里似乎能爬上去‥\n天黑后很危险，\n现在先算了。"
 },
 {
  "id": "004564",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{框04}{立绘C140}「ここで、休めそうです。",
  "tgt": "{框04}{立绘C140}「这里，能休息了。"
 },
 {
  "id": "004565",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{框04}{立绘C140}「そして‥、こんなときは\n{立绘8340}たき火をするのです。",
  "tgt": "{框04}{立绘C140}「还有‥，这种时候\n{立绘8340}就该生堆篝火。"
 },
 {
  "id": "004566",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{框02}{立绘C140}「‥{码0B}‥で、わたしたち\nお姉様を 探しに行く\nとちゅうなのです。{延时60}",
  "tgt": "{框02}{立绘C140}「……我们\n正在去找姐姐\n的途中。{码0B}‥で、わたしたち\nお姉様を 探しに行く\nとちゅうなのです。{延时60}"
 },
 {
  "id": "004567",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{框04}{立绘C140}「{队员00}さんは\nどこへ‥‥、{码0B}あ‥\n---\n「そうか‥{码0B}\n{立绘8040}迷子でしたね‥。",
  "tgt": "{框04}{立绘C140}「{队员00}先生\n要去哪……，{码0B}啊…\n---\n「原来如此…{码0B}\n{立绘8040}是迷路了啊…。"
 },
 {
  "id": "004568",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{立绘C140}「あした‥、町に着いたら‥\n---\n{立绘8340}「何か、分かりますよ\nきっと‥。",
  "tgt": "{立绘C140}「明天‥，到了镇上‥\n---\n{立绘8340}「一定\n会弄清些什么‥。"
 },
 {
  "id": "004569",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{立绘C100}「ふう‥‥\n何とか、上がってこれました。\n---\n町まで、もう少しの\nはずです‥",
  "tgt": "{立绘C100}「呼……\n总算爬上来了。\n---\n离镇上\n应该不远了…"
 },
 {
  "id": "004570",
  "file": "WORLD/AREAD020.EMI",
  "seg": 11,
  "src": "{立绘0401}もう、下りる必要は\nないだろう‥",
  "tgt": "{立绘0401}已经没有必要\n下去了‥"
 },
 {
  "id": "004571",
  "file": "WORLD/AREAD021.EMI",
  "seg": 11,
  "src": "イノシシのもり",
  "tgt": "野猪之森"
 },
 {
  "id": "004572",
  "file": "WORLD/AREAD021.EMI",
  "seg": 11,
  "src": "きりかぶがある··\n{色03}{道具0700}{/色}を おきますか？{码14000C02}はい\nいいえ",
  "tgt": "有个树桩··\n要放上{色03}{道具0700}{/色}吗？{码14000C02}是\n否"
 },
 {
  "id": "004573",
  "file": "WORLD/AREAD021.EMI",
  "seg": 11,
  "src": "{色03}{道具0700}{/色}を 持っていない！",
  "tgt": "没有{色03}{道具0700}{/色}！"
 },
 {
  "id": "004574",
  "file": "WORLD/AREAD021.EMI",
  "seg": 11,
  "src": "あしあとを 追いかけてみよう！",
  "tgt": "追着脚印走吧！"
 },
 {
  "id": "004575",
  "file": "WORLD/AREAD021.EMI",
  "seg": 11,
  "src": "見うしなってしまった‥‥",
  "tgt": "跟丢了……"
 },
 {
  "id": "004576",
  "file": "WORLD/AREAD021.EMI",
  "seg": 11,
  "src": "\n  {色03}{道具1F01}{/色}を 手に入れた！",
  "tgt": "\n获得了{色03}{道具1F01}{/色}！"
 },
 {
  "id": "004577",
  "file": "WORLD/AREAD021.EMI",
  "seg": 11,
  "src": "「近ごろ、この森のおくに\nタチの悪い けものが\n住み着きまして‥",
  "tgt": "「最近，这片森林深处\n住进了几只\n劣性难驯的野兽‥"
 },
 {
  "id": "004578",
  "file": "WORLD/AREAD021.EMI",
  "seg": 11,
  "src": "「私と、村長とで\nそいつらを やっつけようと\n来たのですが‥\n---\nなにせ 私らにできるのは\nワナを 使う事ぐらいで‥\n---\nなかなか 上手く\nいかないのです‥",
  "tgt": "「我和村长\n本想收拾\n那帮家伙‥\n---\n可我们只会\n用陷阱‥\n---\n怎么也\n不顺利‥"
 },
 {
  "id": "004579",
  "file": "WORLD/AREAD021.EMI",
  "seg": 11,
  "src": "「その內に‥\nワナを しかけすぎて‥",
  "tgt": "「不知不觉‥\n陷阱下得太多‥"
 },
 {
  "id": "004580",
  "file": "WORLD/AREAD021.EMI",
  "seg": 11,
  "src": "{色03}{道具0305}{/色}の\n竜水晶を 手に入れて‥\n---\n『{道具D904}』の力を\n身につけた！",
  "tgt": "{色03}{道具0305}{/色}获得了{道具D904}的\n龙水晶‥\n---\n掌握了『"
 },
 {
  "id": "004581",
  "file": "WORLD/AREAD024.EMI",
  "seg": 11,
  "src": "もえるもりのてまえ",
  "tgt": "燃烧之森前"
 },
 {
  "id": "004582",
  "file": "WORLD/AREAD024.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「おそれながら‥\n神皇帝{队员06}さまと\nお見受けいたします‥‥",
  "tgt": "{框04}{立绘8040}「恕在下冒昧‥\n想来正是\n神皇{队员06}陛下……"
 },
 {
  "id": "004583",
  "file": "WORLD/AREAD024.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「見張りを 行かせました森に\n火柱が立ちましたので‥\n---\nもう、来られるころかと\nお待ちしておりました。",
  "tgt": "{框04}{立绘8040}「派去放哨的森林中\n腾起了火柱‥\n---\n便知陛下将至\n在此恭候。"
 },
 {
  "id": "004584",
  "file": "WORLD/AREAD024.EMI",
  "seg": 11,
  "src": "{框03}{立绘0101}「待っていた‥‥？\n---\nおまえは‥、わたしが\n何なのか‥‥\n分かっているのか？",
  "tgt": "{框03}{立绘0101}「恭候……？\n---\n你可知道‥，我\n究竟\n是什么‥‥"
 },
 {
  "id": "004585",
  "file": "WORLD/AREAD024.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「は‥、{码0B}おそれ多くも\n神皇帝{队员06}さまに\nおかれましては‥\n---\n我らが フォウ帝国を\n築き上げし、初代の\n皇帝さまかと‥",
  "tgt": "{框04}{立绘8040}「是‥，恕在下斗胆\n对神皇{码0B}陛下‥\n---\n您正是筑成我等\n福乌帝国的\n初代皇帝\n陛下{队员06}さまに\nおかれましては‥\n---\n我らが フォウ帝国を\n築き上げし、初代の\n皇帝さまかと‥"
 },
 {
  "id": "004586",
  "file": "WORLD/AREAD024.EMI",
  "seg": 11,
  "src": "{框03}{立绘4600}「その、初代皇帝が\nめでたく 復活なった夜に‥\n---\n殺気をまとって、まみえるが\n今様の礼か‥？",
  "tgt": "{框03}{立绘4600}「初代皇帝\n喜庆复活的今夜…\n---\n你身裹杀气现身\n这就是今夜的贺礼吗…？"
 },
 {
  "id": "004587",
  "file": "WORLD/AREAD024.EMI",
  "seg": 11,
  "src": "{框03}{立绘8040}「時代が‥\n変わったのでございます。\n神皇さま‥{码0B}‥{码0B}‥",
  "tgt": "{框03}{立绘8040}「时代‥\n已然变迁。\n神皇陛下……{码0B}‥{码0B}‥"
 },
 {
  "id": "004588",
  "file": "WORLD/AREAD024.EMI",
  "seg": 11,
  "src": "{框03}{立绘8040}「お疲れの様子‥\n無理も ありますまい‥\n---\n長い眠りから、目覺められ‥\n半身は、いまだ遠く‥",
  "tgt": "{框03}{立绘8040}「看陛下疲惫的模样‥\n也不难理解‥\n---\n自长眠中苏醒‥\n半身尚在远方‥"
 },
 {
  "id": "004589",
  "file": "WORLD/AREAD024.EMI",
  "seg": 11,
  "src": "{框03}{立绘4600}「つまり‥‥\n---\n盟約を、果たす気は\nないのだな？",
  "tgt": "{框03}{立绘4600}「也就是说…\n---\n你无意履行\n盟约了？"
 },
 {
  "id": "004590",
  "file": "WORLD/AREAD024.EMI",
  "seg": 11,
  "src": "{框03}{立绘8040}「おおせの通りで‥。\n---\n神皇さまに おかれては\nいま一度、おやすみ\nいただきたいと‥",
  "tgt": "{框03}{立绘8040}「谨遵圣谕‥。\n---\n恳请神皇陛下\n再度\n安眠‥"
 },
 {
  "id": "004591",
  "file": "WORLD/AREAD024.EMI",
  "seg": 11,
  "src": "{框03}{立绘0202}「おろかな‥、{码0B}とは\n言うまい‥‥\n---\nヒトとは、元来\nそういったものだ‥",
  "tgt": "{框03}{立绘0202}「愚蠢‥，倒也\n不至于‥‥\n---\n人类，本来\n就是这样的东西‥{码0B}とは\n言うまい‥‥\n---\nヒトとは、元来\nそういったものだ‥"
 },
 {
  "id": "004592",
  "file": "WORLD/AREAD024.EMI",
  "seg": 11,
  "src": "{框06}{立绘4600}「だが‥、わが盟約を\nたがえる事は、できぬ‥",
  "tgt": "{框06}{立绘4600}「但是…、我之盟约\n不容违背…"
 },
 {
  "id": "004593",
  "file": "WORLD/AREAD024.EMI",
  "seg": 11,
  "src": "{框06}{立绘4600}「戻って、おまえたちの\n主に、そう伝えよ‥！",
  "tgt": "{框06}{立绘4600}「回去\n告诉你们的主子\n就说我这么说…！"
 },
 {
  "id": "004594",
  "file": "WORLD/AREAD024.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「お逃げになったか‥",
  "tgt": "{框06}{立绘8040}「逃走了吗‥"
 },
 {
  "id": "004595",
  "file": "WORLD/AREAD024.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「‥火を放て。\n---\n力を、取り戻す前に\nしとめるのだ‥。",
  "tgt": "{框06}{立绘8040}「‥放火。\n---\n在他夺回力量前\n将其斩杀‥。"
 },
 {
  "id": "004596",
  "file": "WORLD/AREAD024.EMI",
  "seg": 11,
  "src": "{立绘4600}「ヒトは、我らを賴り\n身勝手に うらぎる‥",
  "tgt": "{立绘4600}「人类依赖我等\n却自私地背叛…"
 },
 {
  "id": "004597",
  "file": "WORLD/AREAD025.EMI",
  "seg": 11,
  "src": "いのししぼす",
  "tgt": "野猪头目"
 },
 {
  "id": "004598",
  "file": "WORLD/AREAD025.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「あ、ひょっとして\n村長さん‥{引0300}",
  "tgt": "{框06}{立绘C140}「啊，该不会\n是村长先生‥{引0300}"
 },
 {
  "id": "004599",
  "file": "WORLD/AREAD025.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「キリア村の、村長は‥{引0300}",
  "tgt": "{框06}{立绘C240}「奇莉亚村的，村长是‥{引0300}"
 },
 {
  "id": "004600",
  "file": "WORLD/AREAD025.EMI",
  "seg": 11,
  "src": "{框43}{立绘8000}「しっ‥！",
  "tgt": "{框43}{立绘8000}「嘘…！"
 },
 {
  "id": "004601",
  "file": "WORLD/AREAD025.EMI",
  "seg": 11,
  "src": "{框02}{立绘0000}「うわははははは！\nやったぞ、ワシのワナだっ！",
  "tgt": "{框02}{立绘0000}「哇哈哈哈哈！\n得手了，是老夫的陷阱！"
 },
 {
  "id": "004602",
  "file": "WORLD/AREAD025.EMI",
  "seg": 11,
  "src": "{框02}{立绘8000}「あんたらも、見たろ？\nまんまと、あのケモノを\nこらしめてやったぞ！\n---\nワシのワナだぞ！\nスゴいだろう！？\nうはははははははは",
  "tgt": "{框02}{立绘8000}「你们也看到了吧？\n把那只野兽\n狠狠整治了一顿！\n---\n是老夫的陷阱！\n厉害吧！？\n哇哈哈哈哈哈哈哈"
 },
 {
  "id": "004603",
  "file": "WORLD/AREAD025.EMI",
  "seg": 11,
  "src": "{框02}{立绘0000}「うはは、ザマぁ見ろ\n思い知ったか、ケモノめ！\n---\nやーい、やーい！\nおまえのかあちゃん\nでべそ！",
  "tgt": "{框02}{立绘0000}「哇哈哈，活该\n知道厉害了吧，畜生！\n---\n羞羞，羞羞！\n你娘是\n凸肚脐！"
 },
 {
  "id": "004604",
  "file": "WORLD/AREAD025.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「‥{码0B}‥{码0B}‥ひょっとして\nかあちゃん？",
  "tgt": "{框04}{立绘8040}「……该不会\n是老太婆？{码0B}‥{码0B}‥ひょっとして\nかあちゃん？"
 },
 {
  "id": "004605",
  "file": "WORLD/AREAD025.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「いやいや\n助かりましたわい。\nところで‥‥",
  "tgt": "{框04}{立绘8040}「哎呀哎呀\n得救了哇。\n话说‥‥"
 },
 {
  "id": "004606",
  "file": "WORLD/AREAD025.EMI",
  "seg": 11,
  "src": "{框45}{立绘8040}「あんたら、だれ？",
  "tgt": "{框45}{立绘8040}「你们，是谁？"
 },
 {
  "id": "004607",
  "file": "WORLD/AREAD025.EMI",
  "seg": 11,
  "src": "{框05}{立绘0101}「あのう‥\nキリア村の、村長さん‥\nですよね？",
  "tgt": "{框05}{立绘0101}「那个‥\n您是奇莉亚村的\n村长先生吧？"
 },
 {
  "id": "004608",
  "file": "WORLD/AREAD025.EMI",
  "seg": 11,
  "src": "{框05}{立绘8040}「ああ、そうだけど‥\n---\nなんだ、わしに用だったのか\n‥じゃ、村へもどって\n話を闻こうか。",
  "tgt": "{框05}{立绘8040}「啊，是啊‥\n---\n怎么，找我有事吗\n‥那，回村再\n细说吧。"
 },
 {
  "id": "004609",
  "file": "WORLD/AREAD026.EMI",
  "seg": 13,
  "src": "よるのもり",
  "tgt": "夜之森"
 },
 {
  "id": "004610",
  "file": "WORLD/AREAD026.EMI",
  "seg": 13,
  "src": "{框40}{立绘0000}「誰だっ！？",
  "tgt": "{框40}{立绘0000}「谁！？"
 },
 {
  "id": "004611",
  "file": "WORLD/AREAD026.EMI",
  "seg": 13,
  "src": "{框06}{立绘C640}「おまえたちは‥{码0B}‥{码0B}‥\n---\nここで‥、何を\nしているのだ？",
  "tgt": "{框06}{立绘C640}「你们……\n---\n在这里‥，在\n做什么？{码0B}‥{码0B}‥\n---\nここで‥、何を\nしているのだ？"
 },
 {
  "id": "004612",
  "file": "WORLD/AREAD026.EMI",
  "seg": 13,
  "src": "{立绘0000}「な‥、{码0B}何だ、きさま！？",
  "tgt": "{立绘0000}「什…，{码0B}什么人，你！？"
 },
 {
  "id": "004613",
  "file": "WORLD/AREAD026.EMI",
  "seg": 13,
  "src": "{框05}{立绘0101}「今夜、『竜』が現れると\n闻いて‥{码0B}‥\n---\nこの边りを\n見回っているのだ。",
  "tgt": "{框05}{立绘0101}「听闻今夜『龙』\n将会现身‥‥\n---\n故而在此附近\n巡视。{码0B}‥\n---\nこの边りを\n見回っているのだ。"
 },
 {
  "id": "004614",
  "file": "WORLD/AREAD026.EMI",
  "seg": 13,
  "src": "{框43}{立绘4600}「‥‥『竜』？{引0600}",
  "tgt": "{框43}{立绘4600}「……『龙』？{引0600}"
 },
 {
  "id": "004615",
  "file": "WORLD/AREAD026.EMI",
  "seg": 13,
  "src": "{框05}{立绘0101}「ただの竜ではなく\n国にわざわいを もたらす\n『忌まわしき竜』だ‥",
  "tgt": "{框05}{立绘0101}「不是寻常的龙\n而是给国家带来灾祸的\n『可憎之龙』‥"
 },
 {
  "id": "004616",
  "file": "WORLD/AREAD026.EMI",
  "seg": 13,
  "src": "{框06}{立绘C640}「竜を‥ どうする？",
  "tgt": "{框06}{立绘C640}「龙‥？你们想如何？"
 },
 {
  "id": "004617",
  "file": "WORLD/AREAD026.EMI",
  "seg": 13,
  "src": "{立绘0000}「わが帝国の 勢力をあげて\n悪しき竜を 退治するのだ。",
  "tgt": "{立绘0000}「振兴我帝国之势力\n讨伐恶龙。"
 },
 {
  "id": "004618",
  "file": "WORLD/AREAD026.EMI",
  "seg": 13,
  "src": "{框06}{立绘8242}「おまえたち、ヒトに‥\n何ができると言うのだ？",
  "tgt": "{框06}{立绘8242}「你们这些人类‥\n又能如何？"
 },
 {
  "id": "004619",
  "file": "WORLD/AREAD026.EMI",
  "seg": 13,
  "src": "{框02}{立绘C640}「わかるか‥？\nこれが、竜だ。",
  "tgt": "{框02}{立绘C640}「明白吗‥？\n这，就是龙。"
 },
 {
  "id": "004620",
  "file": "WORLD/AREAD026.EMI",
  "seg": 13,
  "src": "{框03}{立绘C640}「竜は、理、だ。\n---\nおまえたち、ヒトを產み\n生かし、殺してきた‥\n大いなる、ことわり。\n---\nおまえたちの\nコトバで言えば‥{码0B}‥",
  "tgt": "{框03}{立绘C640}「龙，即是理。\n---\n生育你们人类\n又使其生，使其死‥\n至大的，至理。\n---\n用你们的\n言语来说……{码0B}‥"
 },
 {
  "id": "004621",
  "file": "WORLD/AREAD026.EMI",
  "seg": 13,
  "src": "{立绘C640}「神だ‥",
  "tgt": "{立绘C640}「神‥"
 },
 {
  "id": "004622",
  "file": "WORLD/AREAD026.EMI",
  "seg": 13,
  "src": "{框03}{立绘C640}「‥{码0B}‥{码0B}‥理に 逆らうなどと\nどうして考えるのだ？",
  "tgt": "{框03}{立绘C640}「……为何要想着\n逆理而行？{码0B}‥{码0B}‥理に 逆らうなどと\nどうして考えるのだ？"
 },
 {
  "id": "004623",
  "file": "WORLD/AREAD026.EMI",
  "seg": 13,
  "src": "{立绘8343}「やはり、ヒトは‥{码0B}‥{码0B}‥",
  "tgt": "{立绘8343}「人类，果然……{码0B}‥{码0B}‥"
 },
 {
  "id": "004624",
  "file": "WORLD/AREAD027.EMI",
  "seg": 11,
  "src": "もえるもり！",
  "tgt": "燃烧之森！"
 },
 {
  "id": "004625",
  "file": "WORLD/AREAD027.EMI",
  "seg": 11,
  "src": "{立绘C640}「火攻めか‥\n念の入ったことだ‥",
  "tgt": "{立绘C640}「火攻吗‥\n倒真是用心良苦‥"
 },
 {
  "id": "004626",
  "file": "WORLD/AREAD027.EMI",
  "seg": 11,
  "src": "今、戻ると‥ さっきの連中が\n待ちかまえているだろう‥。",
  "tgt": "现在回去‥刚才那帮家伙\n一定埋伏在那‥。"
 },
 {
  "id": "004627",
  "file": "WORLD/AREAD028.EMI",
  "seg": 11,
  "src": "ハンドルがある‥\n回してみますか？{码14000C93}左に回す\n右に回す\nやめておく",
  "tgt": "有个转轮…\n要转转看吗？{码14000C93}向左转\n向右转\n算了"
 },
 {
  "id": "004628",
  "file": "WORLD/AREAD028.EMI",
  "seg": 11,
  "src": "かじが 道をふさいでいる‥",
  "tgt": "树枝挡住了去路‥"
 },
 {
  "id": "004629",
  "file": "WORLD/AREAD029.EMI",
  "seg": 11,
  "src": "{立绘0000}「その手のモンなら\nここいら边に\nゴロゴロしてるが‥{延时90}",
  "tgt": "{立绘0000}「那种东西\n这附近\n多得是…{延时90}"
 },
 {
  "id": "004630",
  "file": "WORLD/AREAD029.EMI",
  "seg": 11,
  "src": "{立绘0101}探すのをやめますか？{码14000CC2}はい\nいいえ",
  "tgt": "{立绘0101}要停止寻找吗？{码14000CC2}是\n否"
 },
 {
  "id": "004631",
  "file": "WORLD/AREAD029.EMI",
  "seg": 11,
  "src": "{框21}{色0A}○{/色}ボタンを押すと\nスコップで 足もとを\nほり始めます\n---\nスコップは 何回か使うと\n壊れてしまいます\n---\nガラクタを ほってしまうと\n壊れやすくなるので 注意！\n---\n犬が立ち止まった場所には\nアイテムが うまっています\nよく覺えておきましょう\n---\n\n  もう一度、說明を讀みますか？{码14010C82}はい\nいいえ",
  "tgt": "{框21}{色0A}按住○键\n就会用铁锹\n开始挖脚下\n---\n铁锹用几次\n就会坏掉\n---\n挖到破烂就会\n更容易坏，注意！\n---\n狗停下的地方\n埋着道具\n好好记住吧\n---\n\n要再读一次说明吗？是\n否{/色}ボタンを押すと\nスコップで 足もとを\nほり始めます\n---\nスコップは 何回か使うと\n壊れてしまいます\n---\nガラクタを ほってしまうと\n壊れやすくなるので 注意！\n---\n犬が立ち止まった場所には\nアイテムが うまっています\nよく覺えておきましょう\n---\n\n  もう一度、說明を讀みますか？{码14010C82}はい\nいいえ"
 },
 {
  "id": "004632",
  "file": "WORLD/AREAD029.EMI",
  "seg": 11,
  "src": "何もなかった‥",
  "tgt": "什么都没有‥"
 },
 {
  "id": "004633",
  "file": "WORLD/AREAD029.EMI",
  "seg": 11,
  "src": "スコップが壊れてしまった！",
  "tgt": "铁锹坏掉了！"
 },
 {
  "id": "004634",
  "file": "WORLD/AREAD029.EMI",
  "seg": 11,
  "src": "ただの{占位00}だった‥",
  "tgt": "只是个{占位00}而已…"
 },
 {
  "id": "004635",
  "file": "WORLD/AREAD029.EMI",
  "seg": 11,
  "src": "{占位00}を 見つけた！",
  "tgt": "发现了{占位00}！"
 },
 {
  "id": "004636",
  "file": "WORLD/AREAD029.EMI",
  "seg": 11,
  "src": "{框21}\n   操作の說明を讀みますか？{码14010C82}はい\nいいえ",
  "tgt": "{框21}\n要阅读操作说明吗？是\n否{码14010C82}はい\nいいえ"
 },
 {
  "id": "004637",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "おちるがけー",
  "tgt": "崩落崖"
 },
 {
  "id": "004638",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{立绘C100}「サライの町は‥\n---\nこの、ガケ道を こえた\n所なのです‥",
  "tgt": "{立绘C100}「萨莱镇…\n---\n就在越过这条\n崖道的地方…"
 },
 {
  "id": "004639",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{立绘C140}「日のあるうちに\n急ぎましょうか‥",
  "tgt": "{立绘C140}「趁天还亮\n抓紧赶路吧‥"
 },
 {
  "id": "004640",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{框04}{立绘C140}「道が、とぎれてますね。",
  "tgt": "{框04}{立绘C140}「路，断了呢。"
 },
 {
  "id": "004641",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{框06}{立绘C140}「でも、だいじょうぶです。\n---\nこんな場所は、ジャンプして\nとびこせるのです。",
  "tgt": "{框06}{立绘C140}「不过，不要紧。\n---\n这种地方，跳一下\n就能越过去。"
 },
 {
  "id": "004642",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{框06}{立绘C140}「とびこせそうな 場所で\n{色0A}○{/色}ボタンを 押すか‥\n---\nジャンプしたい 方向に\n{色05}方向キー{/色}を いれれば\nいいんです‥\n---\nやってみて下さい。",
  "tgt": "{框06}{立绘C140}「在能跳过去的地方\n按○键‥\n---\n或朝想跳的方向\n推方向键\n就行‥\n---\n请试试看。{色0A}○{/色}ボタンを 押すか‥\n---\nジャンプしたい 方向に\n{色05}方向キー{/色}を いれれば\nいいんです‥\n---\nやってみて下さい。"
 },
 {
  "id": "004643",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{框04}{立绘C140}「‥{码0B}‥{码0B}‥と、いう感じで\nもうひとつ、そっちも\nとびこえちゃいましょう。",
  "tgt": "{框04}{立绘C140}「……就像这样\n那边那个\n也跳过去吧。{码0B}‥{码0B}‥と、いう感じで\nもうひとつ、そっちも\nとびこえちゃいましょう。"
 },
 {
  "id": "004644",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{框04}{立绘C140}「高い所、こわいですか‥？\n---\nわたしたち、ウインディア人は\nわりと 平気なんですけど‥",
  "tgt": "{框04}{立绘C140}「怕高吗‥？\n---\n我们温迪亚人\n倒是不怎么怕‥"
 },
 {
  "id": "004645",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{立绘C140}「ちゃんと、ジャンプできて\nよかったですね‥\n---\nすっごい高いですよ！",
  "tgt": "{立绘C140}「能顺利跳过来\n太好了‥\n---\n这里可高得很哦！"
 },
 {
  "id": "004646",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{立绘C140}「うわー‥{码0B}‥{码0B}‥",
  "tgt": "{立绘C140}「哇——……{码0B}‥{码0B}‥"
 },
 {
  "id": "004647",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{立绘8040}「高い所って‥\n何だか くらくらして\n楽しいですよね？",
  "tgt": "{立绘8040}「站得高高的‥\n总让人头晕目眩\n又很开心呢？"
 },
 {
  "id": "004648",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{立绘8140}「だ、{码0B}だいじょうぶですか\n{队员00}さんっ！？",
  "tgt": "{立绘8140}「没、{码0B}没事吧\n{队员00}先生！？"
 },
 {
  "id": "004649",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{立绘8240}「とび下りてきて\nくれたんですか‥‥？",
  "tgt": "{立绘8240}「你是自己\n跳下来的‥‥？"
 },
 {
  "id": "004650",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{立绘8240}「ケガ‥、しませんでした？\n---\nごめんなさい‥‥\nわたし、翼があるから‥\n---\nちょっとぐらい 高い所から\n落ちても、平気なんです。",
  "tgt": "{立绘8240}「没‥，受伤吧？\n---\n对不起……\n我有翅膀‥\n---\n从稍微高一点的地方\n掉下来，也不碍事。"
 },
 {
  "id": "004651",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{立绘C140}「でも、勇気ありますね\n{队员00}さん、ちょっと‥\n---\n{立绘8340}「カッコよかったですよ。",
  "tgt": "{立绘C140}「不过真有勇气呢\n{队员00}先生，刚才…\n---\n{立绘8340}「真帅气。"
 },
 {
  "id": "004652",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{框06}{立绘C140}「暗くなってきましたね‥",
  "tgt": "{框06}{立绘C140}「天色暗下来了‥"
 },
 {
  "id": "004653",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{框06}{立绘C140}「ガケを上がるのは\n明るくなってからの方が\n良さそうですね‥\n---\nどこか、休めそうな場所を\n探しましょう。",
  "tgt": "{框06}{立绘C140}「爬悬崖\n还是等天亮之后\n比较好‥\n---\n找找有没有\n能休息的地方吧。"
 },
 {
  "id": "004654",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "ここから、上がれそうだが‥\n暗くなると危険なので、\n今はやめておこう。",
  "tgt": "这里似乎能爬上去‥\n天黑后很危险，\n现在先算了。"
 },
 {
  "id": "004655",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{框04}{立绘C140}「ここで、休めそうです。",
  "tgt": "{框04}{立绘C140}「这里，能休息了。"
 },
 {
  "id": "004656",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{框04}{立绘C140}「そして‥、こんなときは\n{立绘8340}たき火をするのです。",
  "tgt": "{框04}{立绘C140}「还有‥，这种时候\n{立绘8340}就该生堆篝火。"
 },
 {
  "id": "004657",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{框02}{立绘C140}「‥{码0B}‥で、わたしたち\nお姉様を 探しに行く\nとちゅうなのです。{延时60}",
  "tgt": "{框02}{立绘C140}「……我们\n正在去找姐姐\n的途中。{码0B}‥で、わたしたち\nお姉様を 探しに行く\nとちゅうなのです。{延时60}"
 },
 {
  "id": "004658",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{框04}{立绘C140}「{队员00}さんは\nどこへ‥‥、{码0B}あ‥\n---\n「そうか‥{码0B}\n{立绘8040}迷子でしたね‥。",
  "tgt": "{框04}{立绘C140}「{队员00}先生\n要去哪……，{码0B}啊…\n---\n「原来如此…{码0B}\n{立绘8040}是迷路了啊…。"
 },
 {
  "id": "004659",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{立绘C140}「あした‥、町に着いたら‥\n---\n{立绘8340}「何か、分かりますよ\nきっと‥。",
  "tgt": "{立绘C140}「明天‥，到了镇上‥\n---\n{立绘8340}「一定\n会弄清些什么‥。"
 },
 {
  "id": "004660",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{立绘C100}「ふう‥‥\n何とか、上がってこれました。\n---\n町まで、もう少しの\nはずです‥",
  "tgt": "{立绘C100}「呼……\n总算爬上来了。\n---\n离镇上\n应该不远了…"
 },
 {
  "id": "004661",
  "file": "WORLD/AREAD030.EMI",
  "seg": 8,
  "src": "{立绘0401}もう、下りる必要は\nないだろう‥",
  "tgt": "{立绘0401}已经没有必要\n下去了‥"
 },
 {
  "id": "004662",
  "file": "WORLD/AREAD031.EMI",
  "seg": 11,
  "src": "イノシシのもり",
  "tgt": "野猪之森"
 },
 {
  "id": "004663",
  "file": "WORLD/AREAD031.EMI",
  "seg": 11,
  "src": "きりかぶがある··\n{色03}{道具0700}{/色}を おきますか？{码14000C02}はい\nいいえ",
  "tgt": "有个树桩··\n要放上{色03}{道具0700}{/色}吗？{码14000C02}是\n否"
 },
 {
  "id": "004664",
  "file": "WORLD/AREAD031.EMI",
  "seg": 11,
  "src": "{色03}{道具0700}{/色}を 持っていない！",
  "tgt": "没有{色03}{道具0700}{/色}！"
 },
 {
  "id": "004665",
  "file": "WORLD/AREAD031.EMI",
  "seg": 11,
  "src": "あしあとを 追いかけてみよう！",
  "tgt": "追着脚印走吧！"
 },
 {
  "id": "004666",
  "file": "WORLD/AREAD031.EMI",
  "seg": 11,
  "src": "見うしなってしまった‥‥",
  "tgt": "跟丢了……"
 },
 {
  "id": "004667",
  "file": "WORLD/AREAD031.EMI",
  "seg": 11,
  "src": "\n  {色03}{道具1F01}{/色}を 手に入れた！",
  "tgt": "\n获得了{色03}{道具1F01}{/色}！"
 },
 {
  "id": "004668",
  "file": "WORLD/AREAD031.EMI",
  "seg": 11,
  "src": "「近ごろ、この森のおくに\nタチの悪い けものが\n住み着きまして‥",
  "tgt": "「最近，这片森林深处\n住进了几只\n劣性难驯的野兽‥"
 },
 {
  "id": "004669",
  "file": "WORLD/AREAD031.EMI",
  "seg": 11,
  "src": "「私と、村長とで\nそいつらを やっつけようと\n来たのですが‥\n---\nなにせ 私らにできるのは\nワナを 使う事ぐらいで‥\n---\nなかなか 上手く\nいかないのです‥",
  "tgt": "「我和村长\n本想收拾\n那帮家伙‥\n---\n可我们只会\n用陷阱‥\n---\n怎么也\n不顺利‥"
 },
 {
  "id": "004670",
  "file": "WORLD/AREAD031.EMI",
  "seg": 11,
  "src": "「その內に‥\nワナを しかけすぎて‥",
  "tgt": "「不知不觉‥\n陷阱下得太多‥"
 },
 {
  "id": "004671",
  "file": "WORLD/AREAD031.EMI",
  "seg": 11,
  "src": "{色03}{道具0305}{/色}の\n竜水晶を 手に入れて‥\n---\n『{道具D904}』の力を\n身につけた！",
  "tgt": "{色03}{道具0305}{/色}获得了{道具D904}的\n龙水晶‥\n---\n掌握了『"
 },
 {
  "id": "004672",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "どろりゅう",
  "tgt": "泥龙"
 },
 {
  "id": "004673",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框03}{立绘C140}「きれい‥{码0B}‥",
  "tgt": "{框03}{立绘C140}「好美……{码0B}‥"
 },
 {
  "id": "004674",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框02}{立绘C240}「ここから‥、東に向かえば\n{色02}キリア{/色}という村がある‥",
  "tgt": "{框02}{立绘C240}「从这里…往东走\n有个叫{色02}奇莉亚{/色}的村子…"
 },
 {
  "id": "004675",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框02}{立绘4200}「その村に‥\n---\n{色02}セネスタの町{/色}への\n抜け道が あるはずだ。",
  "tgt": "{框02}{立绘4200}「那个村子里…\n---\n应该有通往\n{色02}塞内斯塔镇{/色}的\n捷径。"
 },
 {
  "id": "004676",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框04}{立绘C140}「これは‥{码0B}‥",
  "tgt": "{框04}{立绘C140}「这是……{码0B}‥"
 },
 {
  "id": "004677",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框04}{立绘C240}「ダムを こわした\n竜‥、{码0B}なのか‥？",
  "tgt": "{框04}{立绘C240}「就是弄坏大坝的\n那条龙‥，吗‥？{码0B}なのか‥？"
 },
 {
  "id": "004678",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框04}{立绘8040}「こんな、岸ちかくに\n竜が現れるなんてねぇ‥",
  "tgt": "{框04}{立绘8040}「龙竟会现身在\n离岸这么近的地方呐‥"
 },
 {
  "id": "004679",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框43}{立绘8040}「あんたたち‥‥\n竜に かかわって\nしまったねぇ‥",
  "tgt": "{框43}{立绘8040}「你们‥‥\n跟龙扯上\n关系了呐‥"
 },
 {
  "id": "004680",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框43}{立绘0101}「おばあさん‥\n竜のこと、よく\nご存知なんですか？",
  "tgt": "{框43}{立绘0101}「老婆婆‥\n您很了解\n龙的事吗？"
 },
 {
  "id": "004681",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框43}{立绘0202}「‥ダムを おそって\nあふれさせたのは\nこの竜なのか？",
  "tgt": "{框43}{立绘0202}「‥袭击大坝\n使其决堤的\n就是这条龙吗？"
 },
 {
  "id": "004682",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框43}{立绘8040}「竜は、人をおそったり\nしないよ‥‥\n---\n竜は‥、何かを\n伝えたがってるのさ‥",
  "tgt": "{框43}{立绘8040}「龙，是不会袭击\n人类的‥‥\n---\n龙啊‥，是想\n传达些什么‥"
 },
 {
  "id": "004683",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框05}{立绘4100}「竜は、何を\n言いたいのでしょう‥？",
  "tgt": "{框05}{立绘4100}「龙到底\n想说什么呢…？"
 },
 {
  "id": "004684",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框04}{立绘8040}「竜のことは‥\nわしら 人のちえでは\n分からないよ‥\n---\nただ‥、古いうたに\nうたわれる だけだよ‥",
  "tgt": "{框04}{立绘8040}「龙的事‥\n凭我们人类的智慧\n是弄不明白的‥\n---\n只有‥，古歌里\n唱到过‥"
 },
 {
  "id": "004685",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框43}{立绘8040}「あんたたち‥\nわしの うたを\n闻きたいかね‥？\n---\n安くしておくよ？{码14000C12}10ゼニーはらう\n100ゼニーはらう",
  "tgt": "{框43}{立绘8040}「你们啊…\n想不想听\n老身的歌…？\n---\n便宜算你们哦？{码14000C12}付10泽尼\n付100泽尼"
 },
 {
  "id": "004686",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框04}{立绘8040}「ふぇふぇ、ありがとよ\nそれじゃ、うたうかね‥",
  "tgt": "{框04}{立绘8040}「嘿嘿，多谢啦\n那，唱一个‥"
 },
 {
  "id": "004687",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框04}{立绘8040}「また、10ゼニーかい\nあんたたち、ケチだね‥",
  "tgt": "{框04}{立绘8040}「又只给10泽尼啊\n你们，真抠门‥"
 },
 {
  "id": "004688",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框04}{立绘8040}「ほんとに ケチだね\nあんたたちは‥\n---\nでも、レパートリーが\nなくなっちまったよ‥\n---\nしかたない‥\nほんとうの 竜のうたを\nうたおうかね‥",
  "tgt": "{框04}{立绘8040}「你们真是\n抠门到家了‥\n---\n不过，曲目都\n唱光了‥\n---\n没法子‥\n就唱首真正的\n龙之歌吧‥"
 },
 {
  "id": "004689",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框43}{立绘8040}「ふぇふぇ‥\n今のは、竜のうたと\nちがったねぇ‥\n---\n他のを 闻くかね？\n安くしておくよ‥{码14000C12}10ゼニーはらう\n100ゼニーはらう",
  "tgt": "{框43}{立绘8040}「呵呵…\n刚才那首和\n龙之歌不一样呢…\n---\n还要听别的吗？\n便宜算你们哦…{码14000C12}付10泽尼\n付100泽尼"
 },
 {
  "id": "004690",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框81}{色08}どろの うみは\nひろいな\nおおきな ゆうひも\nしずんでくよ{/色}",
  "tgt": "{框81}{色08}泥海辽阔\n无边无际\n大大的夕阳\n也沉入其中{/色}"
 },
 {
  "id": "004691",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框81}{色08}ゆうやけ こやけが\nしずんでく\nどろの うみも\nひがくれる{/色}",
  "tgt": "{框81}{色08}晚霞晚霞\n渐渐西沉\n泥海之上\n暮色四合{/色}"
 },
 {
  "id": "004692",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框81}{色08}ゆうやけ こやけが\nまっかっか\nわしも むかしは\nわかかった{/色}",
  "tgt": "{框81}{色08}晚霞满天\n红彤彤\n老夫从前也\n年轻过{/色}"
 },
 {
  "id": "004693",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框81}{色08}うつろわざるもの\nみちびき\nうつしよ かわりゆく\nそのこえを きくもの\nさだめを みよ{/色}",
  "tgt": "{框81}{色08}不变不易者\n引导之\n倾听这变幻之世的\n声音之人\n看清天命吧{/色}"
 },
 {
  "id": "004694",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框43}{立绘0202}「つまり、どうなんだ\nまるで 分からん！？",
  "tgt": "{框43}{立绘0202}「就是说，到底\n怎么回事！？完全不懂！"
 },
 {
  "id": "004695",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框43}{立绘8040}「竜が 動くとき\n世界も 動く‥‥\n---\nあんたたちは それに\nまきこまれた‥\nって事さね。",
  "tgt": "{框43}{立绘8040}「龙动的时候\n世界也跟着动‥‥\n---\n你们就是被\n卷进了其中‥\n就是这么回事呐。"
 },
 {
  "id": "004696",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框03}{立绘4200}「俺たちは\n先を急ぐのだ‥\n---\n竜などに\nかかわってる、ヒマは\nないのだがな‥\n---\nともかく、礼を言う。",
  "tgt": "{框03}{立绘4200}「我们要\n赶路…\n---\n没闲工夫\n跟什么龙\n纠缠…\n---\n总之，多谢了。"
 },
 {
  "id": "004697",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框03}{立绘0301}「うたを ありがとう\nおばあさん‥",
  "tgt": "{框03}{立绘0301}「谢谢您唱歌\n老婆婆‥"
 },
 {
  "id": "004698",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{框04}{立绘0040}「‥まきこまれたって\nどころじゃないねぇ\n---\n竜を、連れて步いてる‥‥",
  "tgt": "{框04}{立绘0040}「…这不是被卷进来的\n程度了啊\n---\n居然带着龙走路……"
 },
 {
  "id": "004699",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "竜が、消えて行くねぇ‥",
  "tgt": "龙，渐渐消失了呐‥"
 },
 {
  "id": "004700",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "ひとつの時代が、終わるよ",
  "tgt": "一个时代，结束了哟"
 },
 {
  "id": "004701",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "かえるの こども\nかえるじゃ ないよ\nおたま おたま\nおたま おたま\nかえるの こどもは\nお   た   ま ！",
  "tgt": "青蛙的孩子\n不是青蛙哟\n蝌蚪蝌蚪\n蝌蚪蝌蚪\n青蛙的孩子\n是蝌蚪！"
 },
 {
  "id": "004702",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "ぷり ぷり ぷり\nはちの おしり\nしましま おしりに\nちくちく はりはり\nぷり ぷり ぷりん\nはちの おしり",
  "tgt": "屁颠屁颠\n蜜蜂的屁股\n条纹屁股上\n刺人又扎人\n屁颠屁颠儿\n蜜蜂的屁股"
 },
 {
  "id": "004703",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "ちゅうちゅう\nちゅうちゅう\nはなぢる すすれ\nはなぢる ちがうで\nはなの みつやで",
  "tgt": "吮吸吮吸\n吮吸吮吸\n吸的是花蜜\n不是鼻涕哟\n是花蜜呀"
 },
 {
  "id": "004704",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "うつろわざるもの\nみちびき\nうつしよ かわりゆく\nそのこえを きくもの\nさだめを みよ",
  "tgt": "不变不易者\n引导之\n倾听这变幻之世的\n声音之人\n看清天命吧"
 },
 {
  "id": "004705",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0403}「われは ノスト\n泥の海にて、世界を\n見守るもの‥\n---\nアルカイの竜よ\nうつろう者達よ‥\nわれの力が 必要か？{码14010C92}力をかして！\n今は必要ない",
  "tgt": "{立绘0403}「我乃诺斯托\n于泥海之中，\n守护世界之物‥\n---\n阿尔凯之龙啊\n变幻无常之众啊‥\n需要我之力吗？借我力量！\n现在还不需要{码14010C92}力をかして！\n今は必要ない"
 },
 {
  "id": "004706",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0403}「では、世界の行くすえ\n共に 見さだめよう‥",
  "tgt": "{立绘0403}「那就与世界的前途\n一同见证吧‥"
 },
 {
  "id": "004707",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0403}「では、世界の行くすえ\nここにとどまり 見守ろう‥",
  "tgt": "{立绘0403}「那就留在此地\n一同见证世界的前途‥"
 },
 {
  "id": "004708",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "泥竜の力を かりて‥\n『{道具4404}』を 身につけた！",
  "tgt": "借泥龙之力‥\n掌握了『{道具4404}』！"
 },
 {
  "id": "004709",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0403}「シュークと呼ばれる地‥\n---\n森の樹々に かこまれ\nアルカイの竜を 待つもの‥\n---\n更なる力‥求むるなら\nたずねるがいい。",
  "tgt": "{立绘0403}「名为修克之地‥\n---\n被森中林木环绕\n等待阿尔凯之龙之物‥\n---\n若求更强之力‥\n便来相寻吧。"
 },
 {
  "id": "004710",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{色02}アルカイの竜{/色}でなければ\n話すことは できない‥",
  "tgt": "若非{色02}阿尔凯之龙{/色}\n便无话可说…"
 },
 {
  "id": "004711",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}ロペ\n「そうか‥{码0B}\n君らも 無事だったんだ‥\n---\n‥まあ\n良かったんじゃない。\n---\nしばらく ダムにも\n戻れそうに ないし‥\n---\nつりでもして\nぷらぷら してるよ‥\n---\n君らは、つり\nうまいほう？{码14820C92}まだまだです\nきょうみないです",
  "tgt": "{立绘0504}罗佩\n「是吗‥\n你们也都平安啊‥\n---\n‥嘛\n那不是挺好。\n---\n大坝一时半会儿\n也回不去‥\n---\n我就钓钓鱼\n晃晃悠悠啦‥\n---\n你们，钓鱼\n拿手吗？还差得远\n没兴趣{码0B}\n君らも 無事だったんだ‥\n---\n‥まあ\n良かったんじゃない。\n---\nしばらく ダムにも\n戻れそうに ないし‥\n---\nつりでもして\nぷらぷら してるよ‥\n---\n君らは、つり\nうまいほう？{码14820C92}まだまだです\nきょうみないです"
 },
 {
  "id": "004712",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}なら教えるよ。\n‥どうせ、ひまだしね。\n---\nとりあえずは、この\n{色04}さきがけ{/色}という技を\n覺えてみるといい。\n---\nつりの基本は\nとっさのシュンパツ力。\n---\n戦闘に応用すれば\n---\n敵より早く\n行動することも\nできるんじゃ ないの‥\n---\n誰が覺えるの？",
  "tgt": "{立绘0504}那就教你吧。\n…反正我也闲着。\n---\n首先，试着学会\n这个叫{色04}先手{/色}的技能吧。\n---\n钓鱼的基本\n是瞬间的爆发力。\n---\n用于战斗的话\n---\n不就能比敌人\n先一步\n行动了吗…\n---\n谁来学？"
 },
 {
  "id": "004713",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}つりは、実戦\nあるのみかな‥\n---\n取りあえずは\n{色02}{占位00}{/色}\nになったら\n---\nまたフラフラ〜っと\n様子を見に来てよ。",
  "tgt": "{立绘0504}钓鱼嘛\n还是要实战…\n---\n总之等你\n达到{色02}{占位00}{/色}\n之后\n---\n再晃晃悠悠地\n来看看情况吧。"
 },
 {
  "id": "004714",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}じゃーねぇー。",
  "tgt": "{立绘0504}拜拜喽—。"
 },
 {
  "id": "004715",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}じゃーねぇー。",
  "tgt": "{立绘0504}拜拜喽—。"
 },
 {
  "id": "004716",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}ロペ\n「‥ん‥？\n---\n‥ああ、そっか\n君たちか。\n---\nどう？\nなんか、おもしろいこと\nあった？\n---\n",
  "tgt": "{立绘0504}罗佩\n「‥嗯‥？\n---\n‥啊，是嘛\n是你们啊。\n---\n怎么样？\n有没有遇上什么\n有趣的事？\n---\n"
 },
 {
  "id": "004717",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}‥あれ？\n---\nもうそこまで\nつりのウデをあげたんだ‥\nなら、このアイテムでも\nあげるよ\n---\n{色03}{占位01}{/色}を\nもらった！",
  "tgt": "{立绘0504}‥咦？\n---\n已经把钓鱼技术\n练到那一步了啊‥\n那，这个道具\n就送你吧\n---\n得到了\n{色03}{占位01}{/色}！"
 },
 {
  "id": "004718",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}じゃー今度は\n{色02}{占位00}{/色}\nめざして‥\n---\nはげんでくれい。",
  "tgt": "{立绘0504}那这次\n就以{色02}{占位00}{/色}\n为目标…\n---\n好好努力吧。"
 },
 {
  "id": "004719",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}じゃー今度は‥\n---\nと思ったら\nもう、つりマスターなんだ‥\n---\nけっこう\nやるねー‥",
  "tgt": "{立绘0504}那，这次本想‥\n---\n正想说呢\n你们已经成了钓鱼名人‥\n---\n真不错\n挺能干嘛—‥"
 },
 {
  "id": "004720",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}何か用？{码14820C93}教えてください\n教わりません\n何でもないです",
  "tgt": "{立绘0504}有什么事？请教一下\n不想受教\n没什么事{码14820C93}教えてください\n教わりません\n何でもないです"
 },
 {
  "id": "004721",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}他にもある？{码14820C93}教えてください\n教わりません\n何でもないです",
  "tgt": "{立绘0504}还有别的吗？请教一下\n不想受教\n没什么事{码14820C93}教えてください\n教わりません\n何でもないです"
 },
 {
  "id": "004722",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}みんな俺に‥\n教わってるんじゃないの？",
  "tgt": "{立绘0504}大家不都是‥\n跟我学的吗？"
 },
 {
  "id": "004723",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}じゃー、{占位02}に\n{色04}さきがけ{/色}を\n教えるよ。\n---\nがんばってくれ。",
  "tgt": "{立绘0504}那么，把\n{色04}先手{/色}\n教给{占位02}。\n---\n好好努力。"
 },
 {
  "id": "004724",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}じゃー、君たちに\n{色04}さきがけ{/色}を\n教えるよ。\n---\nがんばってくれ。",
  "tgt": "{立绘0504}那么，把\n{色04}先手{/色}\n教给你们。\n---\n好好努力。"
 },
 {
  "id": "004725",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}誰もいないんだ‥\n---\nまあ、いいけどね。",
  "tgt": "{立绘0504}一个人都没有‥\n---\n嘛，也无所谓。"
 },
 {
  "id": "004726",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}‥今教えてる人は\nこの中には\n誰もいないよ。",
  "tgt": "{立绘0504}‥这当中\n没有正在\n受教的人哦。"
 },
 {
  "id": "004727",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}やめちゃうんだ\nふーん‥\n---\n{占位02}は、では\n自分でがんばりなよ。",
  "tgt": "{立绘0504}不学了啊\n哦～‥\n---\n{占位02}那就\n自己加油吧。"
 },
 {
  "id": "004728",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}やめちゃうんだ\nふーん‥\n---\n君たちは、では\n自分でがんばりなよ。",
  "tgt": "{立绘0504}不学了啊\n哦～‥\n---\n那你们\n就自己加油吧。"
 },
 {
  "id": "004729",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}‥誰もやめないの？\n---\nふーん‥\nべつにいいけど‥",
  "tgt": "{立绘0504}‥没人要停？\n---\n哦～‥\n那倒无所谓‥"
 },
 {
  "id": "004730",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}じゃー今度は\n{色02}{占位00}{/色}\nめざして‥\n---\nはげんでくれい。",
  "tgt": "{立绘0504}那这次\n就以{色02}{占位00}{/色}\n为目标…\n---\n好好努力吧。"
 },
 {
  "id": "004731",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "{立绘0504}ロペ\n「‥‥ん？\n---\nなんかよう‥？",
  "tgt": "{立绘0504}罗佩\n「……嗯？\n---\n有什么事‥？"
 },
 {
  "id": "004732",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "RODMAN",
  "tgt": "RODMAN"
 },
 {
  "id": "004733",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "ROD MASTER",
  "tgt": "RODMASTER"
 },
 {
  "id": "004734",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "THE FISH",
  "tgt": "THEFISH"
 },
 {
  "id": "004735",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "スプーン",
  "tgt": "勺饵"
 },
 {
  "id": "004736",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "さおDX",
  "tgt": "竿DX"
 },
 {
  "id": "004737",
  "file": "WORLD/AREAD033.EMI",
  "seg": 13,
  "src": "きわめのさお",
  "tgt": "极致之竿"
 },
 {
  "id": "004738",
  "file": "WORLD/AREAD038.EMI",
  "seg": 11,
  "src": "こうていぼしょ",
  "tgt": "皇帝墓所"
 },
 {
  "id": "004739",
  "file": "WORLD/AREAD038.EMI",
  "seg": 11,
  "src": "{立绘8040}「誰か‥！？",
  "tgt": "{立绘8040}「谁‥！？"
 },
 {
  "id": "004740",
  "file": "WORLD/AREAD038.EMI",
  "seg": 11,
  "src": "{立绘8040}「神聖なる、我が主の\n寢所に‥\nふみ入る者は、誰か？",
  "tgt": "{立绘8040}「擅闯我主\n神圣安眠之所‥\n者是何人？"
 },
 {
  "id": "004741",
  "file": "WORLD/AREAD038.EMI",
  "seg": 11,
  "src": "{立绘8040}「む、この気は‥\nうつろわざるもの‥‥？",
  "tgt": "{立绘8040}「唔，这气息是‥\n不变不易者……？"
 },
 {
  "id": "004742",
  "file": "WORLD/AREAD038.EMI",
  "seg": 11,
  "src": "{立绘8040}「いや‥！\nたとえ、何人であろうと\n通すワケには、いかん！",
  "tgt": "{立绘8040}「不‥！\n不管来者何人\n绝不放行！"
 },
 {
  "id": "004743",
  "file": "WORLD/AREAD038.EMI",
  "seg": 11,
  "src": "上へ行きますか？{码14000C82}はい\nいいえ",
  "tgt": "要上去吗？{码14000C82}是\n否"
 },
 {
  "id": "004744",
  "file": "WORLD/AREAD038.EMI",
  "seg": 11,
  "src": "下へ行きますか？{码14010C82}はい\nいいえ",
  "tgt": "要下去吗？是\n否{码14010C82}はい\nいいえ"
 },
 {
  "id": "004745",
  "file": "WORLD/AREAD038.EMI",
  "seg": 11,
  "src": "道を求むる者、これにて\n鍵を求めよ。",
  "tgt": "寻路之人，于此\n求钥吧。"
 },
 {
  "id": "004746",
  "file": "WORLD/AREAD038.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「神皇さま以外に\nこのオンクーが\nおくれを とるとは‥",
  "tgt": "{框05}{立绘0000}「翁库竟会在\n神皇陛下以外的人面前\n落败…"
 },
 {
  "id": "004747",
  "file": "WORLD/AREAD038.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「お前は‥ 神皇さまの\n求める者、なのだな‥‥\n---\n‥{码0B}‥{码0B}‥ならば、これを\n取るがいい。",
  "tgt": "{框05}{立绘0000}「你…正是神皇陛下\n所寻求之人…\n---\n…{码0B}…{码0B}…那么，收下\n这个吧。"
 },
 {
  "id": "004748",
  "file": "WORLD/AREAD038.EMI",
  "seg": 11,
  "src": "\n  {色03}{道具2905}{/色}を 手に入れた！",
  "tgt": "\n获得了{色03}{道具2905}{/色}！"
 },
 {
  "id": "004749",
  "file": "WORLD/AREAD038.EMI",
  "seg": 11,
  "src": "どうしますか？{码14020C93}先にすすむ\n上に行く\nやめておく",
  "tgt": "怎么办？继续前进\n往上去\n先算了{码14020C93}先にすすむ\n上に行く\nやめておく"
 },
 {
  "id": "004750",
  "file": "WORLD/AREAD038.EMI",
  "seg": 11,
  "src": "どうしますか？{码14030C92}皇帝の墓所へ行く\nやめておく",
  "tgt": "怎么办？前往皇帝墓所\n先算了{码14030C92}皇帝の墓所へ行く\nやめておく"
 },
 {
  "id": "004751",
  "file": "WORLD/AREAD038.EMI",
  "seg": 11,
  "src": "\n   {色03}{道具2A05}{/色}を 手に入れた！",
  "tgt": "\n获得了{色03}{道具2A05}{/色}！"
 },
 {
  "id": "004752",
  "file": "WORLD/AREAD038.EMI",
  "seg": 11,
  "src": "{色03}{道具2A05}{/色}は、音もなく\nくずれさった‥‥",
  "tgt": "{色03}{道具2A05}{/色}悄无声息地\n崩解了……"
 },
 {
  "id": "004753",
  "file": "WORLD/AREAD038.EMI",
  "seg": 11,
  "src": "{打字02}{色02}スイッチ{/色}の前に立つと\nフロアが 光り出します\n光るフロア上の ブロックは‥\n---\n{色0A}○{/色}ボタンで 手前に\n{色0A}×{/色}ボタンで おくに\n転がす事が できます\n---\n同じ色のブロックを 3つ並べて\n道を作ってください。",
  "tgt": "{打字02}站到{色02}开关{/色}前\n地板就会发光\n发光地板上的方块…\n---\n按{色0A}○{/色}键滚向近处\n按{色0A}×{/色}键滚向远处\n---\n请把同色方块\n3个排成一列铺成路。"
 },
 {
  "id": "004754",
  "file": "WORLD/AREAD038.EMI",
  "seg": 11,
  "src": "{色03}{道具2905}{/色}は、音もなく\nくずれさった‥‥",
  "tgt": "{色03}{道具2905}{/色}悄无声息地\n崩解了……"
 },
 {
  "id": "004755",
  "file": "WORLD/AREAD038.EMI",
  "seg": 11,
  "src": "{色02}あかい眼{/色}を ふんではならない‥",
  "tgt": "切不可踩{色02}红眼{/色}…"
 },
 {
  "id": "004756",
  "file": "WORLD/AREAD039.EMI",
  "seg": 11,
  "src": "こうていぼしょ",
  "tgt": "皇帝墓所"
 },
