 },
 {
  "id": "008489",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "建築中です",
  "tgt": "建筑中"
 },
 {
  "id": "008490",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "空き家 まず職業を決めてください",
