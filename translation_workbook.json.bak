  "src": "やめる",
  "tgt": "取消"
 },
 {
  "id": "017288",
  "file": "WORLD/D141BTL.EMI",
  "seg": 5,
  "src": "ひとばんとまって 元気になります",
  "tgt": "住一晚恢复体力"
 },
 {
  "id": "017289",
  "file": "WORLD/D141BTL.EMI",
  "seg": 5,
  "src": "メモリーカードに セーブします",
  "tgt": "存档至存储卡"
 },
 {
  "id": "017290",
  "file": "WORLD/D141BTL.EMI",
  "seg": 5,
  "src": "宿屋を 出ます",
  "tgt": "离开旅店"
 },
 {
