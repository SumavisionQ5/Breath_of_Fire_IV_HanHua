  "seg": 9,
  "src": "{色02}{道具2300}{/色}を 1つ使用してもよろしいですか",
  "tgt": "要使用1个{色02}{道具2300}{/色}吗"
 },
 {
  "id": "001957",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "プレイヤーを選択してください",
