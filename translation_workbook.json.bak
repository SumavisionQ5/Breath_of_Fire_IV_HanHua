  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "{占位01}より",
  "tgt": "来自{占位01}"
 },
 {
  "id": "008668",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "この木で作物をそだてるよう\n良いひりょうをあたえて\nほしいよう",
  "tgt": "用这棵树培育作物哟\n希望能给予\n好肥料哟"
 },
 {
  "id": "008669",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "道具屋です",
  "tgt": "道具屋"
 },
 {
  "id": "008670",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "武器屋です",
  "tgt": "武器屋"
 },
 {
  "id": "008671",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "宿屋です",
  "tgt": "旅店"
 },
 {
  "id": "008672",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "探険家です",
  "tgt": "探险家"
 },
 {
  "id": "008673",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "よう兵です",
  "tgt": "佣兵"
 },
 {
