  "src": "武器屋です",
  "tgt": "武器屋"
 },
 {
  "id": "008011",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "宿屋です",
  "tgt": "旅店"
 },
 {
  "id": "008012",
