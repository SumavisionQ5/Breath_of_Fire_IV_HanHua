  "seg": 9,
  "src": "誰が 新たに師事するのですか",
  "tgt": "让谁重新拜师"
 },
 {
  "id": "001965",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "誰が 師事をやめますか",
  "tgt": "谁停止拜师"
 },
 {
  "id": "001966",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{占位00}に 師事するメンバーを決めて下さい",
  "tgt": "请决定拜{占位00}为师的成员"
 },
 {
  "id": "001967",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{占位00}に 師事しますか",
  "tgt": "要拜{占位00}为师吗"
 },
 {
  "id": "001968",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{占位00}を 誰が受取りますか\n>{色0A}□{/色}：まき物に受取る",
  "tgt": "{占位00}由谁领取\n>{色0A}□{/色}：收入卷轴"
 },
 {
  "id": "001969",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{占位00}を まき物に受取りますか",
  "tgt": "要将{占位00}收入卷轴吗"
 },
 {
  "id": "001970",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "空きがありません スキルをまき物に戻して\n{占位00}を 受取りますか",
  "tgt": "没有空位 将技能收回卷轴后\n领取{占位00}吗"
 },
 {
  "id": "001971",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "このスキルを まき物に戻して\n{占位00}を 受取りますか",
  "tgt": "将此技能收回卷轴后\n领取{占位00}吗"
 },
 {
  "id": "001972",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{色01}EMPTY{/色}",
  "tgt": "{色01}EMPTY{/色}"
 },
 {
  "id": "001973",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{占位00}が 師事をやめますか",
  "tgt": "要让{占位00}停止拜师吗"
 },
 {
  "id": "001974",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{占位00}が 師事をやめますか",
  "tgt": "要让{占位00}停止拜师吗"
 },
 {
  "id": "001975",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{占位01}が {占位00}を\n受け取りますか",
  "tgt": "让{占位01}领取\n{占位00}吗"
 },
 {
  "id": "001976",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "一度に、2人以上の伝承師に\n師事はできません。ほかの伝承師に\n師事していた場合は 上書きされます\n---\n方向キー上下：メンバーの選択\n方向キー左右：前·後衛のきりかえ\n{色0A}○{/色}：決定   {色0A}×{/色}：終了",
  "tgt": "无法同时拜两位以上传承师\n若已拜其他传承师\n将会被覆盖\n---\n方向键上下：选择成员\n方向键左右：切换前·后排\n○：确定×：结束{色0A}○{/色}：決定   {色0A}×{/色}：終了"
 },
 {
  "id": "001977",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "スキルの受け取りは\nリストに空きがなくても、まき物の\nスキルとこうかんして 装備可能です\n---\n方向キー：カーソルの移動\n{色0A}○{/色}：決定\n{色0A}□{/色}：まき物にスキルを受け取る",
  "tgt": "接收技能时\n即使列表没有空位，也可\n与卷轴技能交换后装备\n---\n方向键：移动光标\n○：确定\n□：将技能收入卷轴{色0A}○{/色}：決定\n{色0A}□{/色}：まき物にスキルを受け取る"
 },
 {
  "id": "001978",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "まき物に戻したスキルの装備には\n{色02}{道具2300}{/色}が 必要になります\n---\n方向キー上下\n：まき物に戻すスキルを選択\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "重新装备收回卷轴的技能时\n需要{色02}{道具2300}{/色}\n---\n方向键上下\n：选择收回卷轴的技能\n{色0A}○{/色}：确定  {色0A}×{/色}：取消"
 },
 {
  "id": "001979",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "方向キー：カーソルの移動\n{色0A}○{/色}：決定  {色0A}×{/色}：終了",
  "tgt": "方向键：移动光标\n○：确定×：结束{色0A}○{/色}：決定  {色0A}×{/色}：終了"
 },
 {
  "id": "001980",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{色02}{道具2300}{/色}は、レアな\nアイテムの1つです.スキルの装備は\nしんちょうに行いましょう\n---\n方向キー上下：コマンドを選択\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンプに戻る",
  "tgt": "{色02}{道具2300}{/色}是稀有\n道具之一.装备技能时\n请谨慎操作\n---\n方向键上下：选择指令\n{色0A}○{/色}：确定  {色0A}×{/色}：返回营地"
 },
 {
  "id": "001981",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "方向キー上下：コマンドを選択\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "方向键上下：选择指令\n○：确定×：取消{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "001982",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "方向キー上下：カーソル移動\nL1·L2：ページアップ\nR1·R2：ページダウン\n---\n{色0A}×{/色}：キャンセル",
  "tgt": "方向键上下：移动光标\nL1·L2：上翻页\nR1·R2：下翻页\n---\n×：取消{色0A}×{/色}：キャンセル"
 },
 {
  "id": "001983",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "方向キー：\n  装備スキルをみたいメンバーの選択\n{色0A}○{/色}：決定   {色0A}×{/色}：キャンセル",
  "tgt": "方向键：\n选择要查看装备技能的成员\n○：确定×：取消{色0A}○{/色}：決定   {色0A}×{/色}：キャンセル"
 },
 {
  "id": "001984",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "方向キー上下：カーソル移動\n{色0A}×{/色}：キャンセル",
  "tgt": "方向键上下：移动光标\n×：取消{色0A}×{/色}：キャンセル"
 },
 {
  "id": "001985",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "方向キー上下：カーソル移動\nL1·L2：ページアップ\nR1·R2：ページダウン\n---\n{色0A}○{/色}：決定   {色0A}×{/色}：キャンセル",
  "tgt": "方向键上下：移动光标\nL1·L2：上翻页\nR1·R2：下翻页\n---\n○：确定×：取消{色0A}○{/色}：決定   {色0A}×{/色}：キャンセル"
 },
 {
  "id": "001986",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "誰かが、装備中でも\nそのまま スキルのつけかえが可能です\n（アオ字は装備中のスキルです）\n---\n方向キー：\n  スキルを装備させるメンバーを選択\n{色0A}○{/色}：決定   {色0A}×{/色}：キャンセル",
  "tgt": "即使有人装备中\n也可直接更换技能\n（蓝字为装备中的技能）\n---\n方向键：\n选择要装备技能的成员\n○：确定×：取消{色0A}○{/色}：決定   {色0A}×{/色}：キャンセル"
 },
 {
  "id": "001987",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "方向キー：\n  スキルをはずしたいメンバーの選択\n{色0A}○{/色}：決定   {色0A}×{/色}：キャンセル",
  "tgt": "方向键：\n选择要卸下技能的成员\n○：确定×：取消{色0A}○{/色}：決定   {色0A}×{/色}：キャンセル"
 },
 {
  "id": "001988",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "このモードで\n装備スキルをはすす事ができます\n---\n方向キー上下：カーソル移動\n{色0A}○{/色}：スキルをはずす  {色0A}×{/色}：キャンセル",
  "tgt": "此模式下\n可卸下装备的技能\n---\n方向键上下：移动光标\n○：卸下技能×：取消{色0A}○{/色}：スキルをはずす  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "001989",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "伝承師に会いに行かなくてもキャンプで\n入門/師事やめを行えます。\n---\nただし、スキルやアイテムは\n伝承師に 会わなければ\nもらうことが、できません。\n---\n方向キー上下：コマンドを選択\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンプに戻る",
  "tgt": "无需拜访传承师，在营地\n即可入门/停止拜师。\n---\n但技能和道具\n必须见到传承师\n才能获得。\n---\n方向键上下：选择指令\n○：确定×：返回营地{色0A}○{/色}：決定  {色0A}×{/色}：キャンプに戻る"
 },
 {
  "id": "001990",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "方向キー：カーソルの移動\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "方向键：移动光标\n○：确定×：取消{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "001991",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "メンバーの成長は、\n師事する伝承師により\n大きく変化します。\n---\nニーズに合わせて、強力なメンバーに\nそだてましょう。\n---\nちなみに、ほせいを加えて『0』を\n下回る場合、成長度は『0』になります\n---\n方向キー：カーソル移動\nL1·L2/R1·R2：\n     師事するメンバーのいれかえ\n---\n{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル",
  "tgt": "成员的成长\n会随所拜的传承师\n发生很大变化。\n---\n根据需要，把成员\n培养得更强吧。\n---\n另外，补正后低于『0』时\n成长度将为『0』\n---\n方向键：移动光标\nL1·L2/R1·R2：\n交换拜师成员\n---\n○：确定×：取消{色0A}○{/色}：決定  {色0A}×{/色}：キャンセル"
 },
 {
  "id": "001992",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "方向キー：カーソル移動\n{色0A}○{/色}：次のかだいを見る\n{色0A}×{/色}：キャンセル",
  "tgt": "方向键：移动光标\n○：查看下一道题\n×：取消{色0A}○{/色}：次のかだいを見る\n{色0A}×{/色}：キャンセル"
 },
 {
  "id": "001993",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": " ダミー              ",
  "tgt": "占位"
 },
 {
  "id": "001994",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "COMPLETE",
  "tgt": "COMPLETE"
 },
 {
  "id": "001995",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "NO DATA",
  "tgt": "NODATA"
 },
 {
  "id": "001996",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1010}「{色02}5{/色}ヒット以上のコンボを\nつなげられたら\n---\nまたわしのもとに\n来るがいい。",
  "tgt": "{立绘1010}「若能连出{色02}5{/色}HIT以上的\n连击\n---\n再来老夫\n这里吧。"
 },
 {
  "id": "001997",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1010}「{色02}10{/色}ヒット以上のコンボを\nつなげられたら\n---\nまたわしのもとに\n来るがいい。",
  "tgt": "{立绘1010}「若能连出{色02}10{/色}HIT以上的\n连击\n---\n再来老夫\n这里吧。"
 },
 {
  "id": "001998",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1010}「{色02}15{/色}ヒット以上のコンボを\nつなげられたら\n---\nまたわしのもとに\n来るがいい。",
  "tgt": "{立绘1010}「若能连出{色02}15{/色}HIT以上的\n连击\n---\n再来老夫\n这里吧。"
 },
 {
  "id": "001999",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1010}「{色02}20{/色}ヒット以上のコンボを\nつなげられたら\n---\nまたわしのもとに\n来るがいい。",
  "tgt": "{立绘1010}「若能连出{色02}20{/色}HIT以上的\n连击\n---\n再来老夫\n这里吧。"
 },
 {
  "id": "002000",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1010}「おまえたちはもう、\nわしのすべてをマスターして\nしまった。\n---\nもしかしたら\nおまえたちに\n魔術を教えたことは\n---\nいつか わしにとって最大の\nほこりとなるのかもな。",
  "tgt": "{立绘1010}「你们已经\n将老夫的本领\n全部学会。\n---\n或许\n教你们魔术\n这件事\n---\n有朝一日会成为\n老夫最大的骄傲。"
 },
 {
  "id": "002001",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1111}「ひまな時にでも、また\n会いに来てよ‥\n---\nほかにも、何かあったら\n教えてあげるー。",
  "tgt": "{立绘1111}「有空时\n再来找我吧…\n---\n其他若有什么\n我也可以教你哦。"
 },
 {
  "id": "002002",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1111}「ひまな時にでも、また\n会いに来てよ‥\n---\nほかにも、何かあったら\n教えてあげるー。",
  "tgt": "{立绘1111}「有空时\n再来找我吧…\n---\n其他若有什么\n我也可以教你哦。"
 },
 {
  "id": "002003",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1111}「ひまな時にでも、また\n会いに来てよ‥\n---\nほかにも、何かあったら\n教えてあげるー。",
  "tgt": "{立绘1111}「有空时\n再来找我吧…\n---\n其他若有什么\n我也可以教你哦。"
 },
 {
  "id": "002004",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1111}「ひまな時にでも、また\n会いに来てよ‥\n---\nほかにも、何かあったら\n教えてあげるー。",
  "tgt": "{立绘1111}「有空时\n再来找我吧…\n---\n其他若有什么\n我也可以教你哦。"
 },
 {
  "id": "002005",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1111}「どうも、あなた達に\n教えられるものは‥\n---\n全部、教えちゃったみたいー。\n---\n‥{码0B}‥{码0B}‥それなりに\n楽しかったわよー。\n---\n何か、師匠にでも\nなったみたいでー！",
  "tgt": "{立绘1111}「能教你们的\n东西‥\n---\n好像全都教完了哦。\n---\n……那种感觉\n还挺开心哟。\n---\n仿佛真当上\n了师父一样！{码0B}‥{码0B}‥それなりに\n楽しかったわよー。\n---\n何か、師匠にでも\nなったみたいでー！"
 },
 {
  "id": "002006",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1212}「海のオトコにコトバはいらない\n重要なのは心の一体感！\n---\n{色02}30{/色}以上の\nコンボを出したら\nまたやって来てー。",
  "tgt": "{立绘1212}「海的男人无需言语\n重要的是心意相通！\n---\n打出{色02}30{/色}以上的\n连击后\n再来吧。"
 },
 {
  "id": "002007",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1212}「海のオトコにコトバはいらない\n重要なのは心の一体感！\n---\n{色02}40{/色}以上の\nコンボを出したら\nまたやって来てー。",
  "tgt": "{立绘1212}「海的男人无需言语\n重要的是心意相通！\n---\n打出{色02}40{/色}以上的\n连击后\n再来吧。"
 },
 {
  "id": "002008",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1212}「海のオトコにコトバはいらない\n重要なのは心の一体感！\n---\n{色02}50{/色}以上の\nコンボを出したら\nまたやって来てー。",
  "tgt": "{立绘1212}「海的男人无需言语\n重要的是心意相通！\n---\n打出{色02}50{/色}以上的\n连击后\n再来吧。"
 },
 {
  "id": "002009",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1212}「海のオトコにコトバはいらない\n重要なのは心の一体感！\n---\n{色02}70{/色}以上の\nコンボを出したら\nまたやって来てー。",
  "tgt": "{立绘1212}「海的男人无需言语\n重要的是心意相通！\n---\n打出{色02}70{/色}以上的\n连击后\n再来吧。"
 },
 {
  "id": "002010",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1212}「もう、きみたちは\n海のオトコの中のオトコだ。\n---\nあとは自分たちで\nがんばるんだよー！",
  "tgt": "{立绘1212}「你们已经是\n男人中的男人了。\n---\n剩下的就靠\n你们自己加油吧！"
 },
 {
  "id": "002011",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1313}「世界を旅して\n{色02}70{/色}以上の\nモンスターを\n---\nその目でたしかめて\n来るんだ。\n---\n次の技を教えるのは\nそれからだよ。",
  "tgt": "{立绘1313}「周游世界\n亲眼确认\n{色02}70{/色}种魔物\n---\n之后再\n来找我。\n---\n下一个绝技\n到时再教你。"
 },
 {
  "id": "002012",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1313}「世界を旅して\n{色02}85{/色}以上の\nモンスターを\n---\nその目でたしかめて\n来るんだ。\n---\n次の技を教えるのは\nそれからだよ。",
  "tgt": "{立绘1313}「周游世界\n亲眼确认\n{色02}85{/色}种魔物\n---\n之后再\n来找我。\n---\n下一个绝技\n到时再教你。"
 },
 {
  "id": "002013",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1313}「世界を旅して\n{色02}100{/色}以上の\nモンスターを\n---\nその目でたしかめて\n来るんだ。\n---\n次の技を教えるのは\nそれからだよ。",
  "tgt": "{立绘1313}「周游世界\n亲眼确认\n{色02}100{/色}种魔物\n---\n之后再\n来找我。\n---\n下一个绝技\n到时再教你。"
 },
 {
  "id": "002014",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1313}「いつのまにか\nあんたたちに教えることが\n何もなくなったよ。\n---\nあたしにできるのは\nあとは いのること\nくらいだね‥",
  "tgt": "{立绘1313}「不知不觉\n能教你们的\n已经没有了。\n---\n我能做的\n只剩为你们\n祈祷了…"
 },
 {
  "id": "002015",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1414}「妖精村の人数を\n{色02}8{/色}人以上にしてほしいよう\n---\nそうしたら次の妖精魔法を\n教えてあげるよう",
  "tgt": "{立绘1414}「希望让妖精村的人口\n达到{色02}8{/色}人以上哟\n---\n到时就把下一个\n妖精魔法教你哟"
 },
 {
  "id": "002016",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1414}「妖精村の人数を\n{色02}12{/色}人以上にしてほしいよう\n---\nそうしたら次の妖精魔法を\n教えてあげるよう",
  "tgt": "{立绘1414}「希望让妖精村的人口\n达到{色02}12{/色}人以上哟\n---\n到时就把下一个\n妖精魔法教你哟"
 },
 {
  "id": "002017",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1414}「妖精村の人数を\n{色02}16{/色}人以上にしてほしいよう\n---\nそうしたら次の妖精魔法を\n教えてあげるよう",
  "tgt": "{立绘1414}「希望让妖精村的人口\n达到{色02}16{/色}人以上哟\n---\n到时就把下一个\n妖精魔法教你哟"
 },
 {
  "id": "002018",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1414}「妖精村の人数を\n{色02}20{/色}人以上にしてほしいよう\n---\nそうしたら次の妖精魔法を\n教えてあげるよう",
  "tgt": "{立绘1414}「希望让妖精村的人口\n达到{色02}20{/色}人以上哟\n---\n到时就把下一个\n妖精魔法教你哟"
 },
 {
  "id": "002019",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1414}「もう教えることは\nなにもないけど\n---\n妖精のめんどうだけは\n変わらずみてほしいよう\nやくそくだよう",
  "tgt": "{立绘1414}「虽然已经\n没什么可教的了\n---\n但照顾妖精这件事\n希望你们别变心\n要答应我哟"
 },
 {
  "id": "002020",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1515}「つりポイント{色02}4000{/色}に\nなったら、また来るっぺよ。\n---\nそんときゃ\nオラのとっておきを\nプレゼントすっから。",
  "tgt": "{立绘1515}「钓鱼点数达到\n{色02}4000{/色}后再来咧。\n---\n到时\n俺把看家的\n好东西送你。"
 },
 {
  "id": "002021",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1515}「つりポイント{色02}6000{/色}に\nなったら、また来るっぺよ。\n---\nそんときゃ\nオラのとっておきを\nプレゼントすっから。",
  "tgt": "{立绘1515}「钓鱼点数达到\n{色02}6000{/色}后再来咧。\n---\n到时\n俺把看家的\n好东西送你。"
 },
 {
  "id": "002022",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1515}「つりポイント{色02}9500{/色}に\nなったら、また来るっぺよ。\n---\nそんときゃ\nオラのとっておきを\nプレゼントすっから。",
  "tgt": "{立绘1515}「钓鱼点数达到\n{色02}9500{/色}后再来咧。\n---\n到时\n俺把看家的\n好东西送你。"
 },
 {
  "id": "002023",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1515}「し{码0B}っかし、すんげぇなぁ\nついに、あんちゃんは\nつり、きわめちまったぺか‥\n---\nもう あんちゃんは\n誰もがみとめる\nりっぱなつり名人だっぺ。",
  "tgt": "{立绘1515}「不过真是了不起啊\n大哥你终于\n把钓鱼练到头了…\n---\n如今大哥已是\n人人都佩服的\n钓鱼大名人了。{码0B}っかし、すんげぇなぁ\nついに、あんちゃんは\nつり、きわめちまったぺか‥\n---\nもう あんちゃんは\n誰もがみとめる\nりっぱなつり名人だっぺ。"
 },
 {
  "id": "002024",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1616}「アイテムの種類が\n{色02}80{/色}になったら\nまたきてください。\n---\nこれができたら\nとっておきの 技を\n教えるですよ。",
  "tgt": "{立绘1616}「道具种类达到\n{色02}80{/色}种后\n请再来。\n---\n做到之后\n就把看家的绝技\n教你哟。"
 },
 {
  "id": "002025",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1616}「アイテムの種類が\n{色02}120{/色}になったら\nまたきてください。\n---\nこれができたら\nとっておきの 技を\n教えるですよ。",
  "tgt": "{立绘1616}「道具种类达到\n{色02}120{/色}种后\n请再来。\n---\n做到之后\n就把看家的绝技\n教你哟。"
 },
 {
  "id": "002026",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1616}「もう、ダンナ方に\nおしえることは ないです。\n---\nすてきな ぬすっと人生を\n步んでください‥",
  "tgt": "{立绘1616}「能教各位老板的\n已经没有了。\n---\n愿诸位拥有\n美妙的小偷人生…"
 },
 {
  "id": "002027",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1717}「コンボの 道はふかいのよ‥\n---\n次は、コンボで‥\n{色02}1500{/色}ダメージ以上を\n出してみてよ。\n---\nそうしたら、次の\nスキルを 教えてあげるよ。",
  "tgt": "{立绘1717}「连击之道深得很…\n---\n下次用连击\n打出{色02}1500{/色}以上的\n伤害试试吧。\n---\n做到了\n就教你下个\n技能哟。"
 },
 {
  "id": "002028",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1717}「コンボの 道はふかいのよ‥\n---\n次は、コンボで‥\n{色02}3000{/色}ダメージ以上を\n出してみてよ。\n---\nそうしたら、次の\nスキルを 教えてあげるよ。",
  "tgt": "{立绘1717}「连击之道深得很…\n---\n下次用连击\n打出{色02}3000{/色}以上的\n伤害试试吧。\n---\n做到了\n就教你下个\n技能哟。"
 },
 {
  "id": "002029",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1717}「コンボの 道はふかいのよ‥\n---\n次は、コンボで‥\n{色02}10000{/色}ダメージ以上を\n出してみてよ。\n---\nそうしたら、次の\nスキルを 教えてあげるよ。",
  "tgt": "{立绘1717}「连击之道深得很…\n---\n下次用连击\n打出{色02}10000{/色}以上的\n伤害试试吧。\n---\n做到了\n就教你下个\n技能哟。"
 },
 {
  "id": "002030",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1717}「スゴイわね、あなた達‥\nもう、あたしが\n教えることは ないわ。",
  "tgt": "{立绘1717}「真了不起啊，你们…\n我这里已经\n没什么可教的了。"
 },
 {
  "id": "002031",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1818}「戦いの道はそこなしだ。\n---\nきわめるごとに\nいままで見えなかったものが\n見えてくる。\n---\n{色02}3000{/色}以上の\n一撃を放てたら\n---\nまた来るがいい。",
  "tgt": "{立绘1818}「武道无边。\n---\n每精进一分\n便能看到\n前所未见之物。\n---\n若能放出\n{色02}3000{/色}以上的一击\n---\n便再来吧。"
 },
 {
  "id": "002032",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1818}「戦いの道はそこなしだ。\n---\nきわめるごとに\nいままで見えなかったものが\n見えてくる。\n---\n{色02}5000{/色}以上の\n一撃を放てたら\n---\nまた来るがいい。",
  "tgt": "{立绘1818}「武道无边。\n---\n每精进一分\n便能看到\n前所未见之物。\n---\n若能放出\n{色02}5000{/色}以上的一击\n---\n便再来吧。"
 },
 {
  "id": "002033",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1818}「戦いの道はそこなしだ。\n---\nきわめるごとに\nいままで見えなかったものが\n見えてくる。\n---\n{色02}8000{/色}以上の\n一撃を放てたら\n---\nまた来るがいい。",
  "tgt": "{立绘1818}「武道无边。\n---\n每精进一分\n便能看到\n前所未见之物。\n---\n若能放出\n{色02}8000{/色}以上的一击\n---\n便再来吧。"
 },
 {
  "id": "002034",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1818}「戦いの道はそこなしだ。\n---\nきわめるごとに\nいままで見えなかったものが\n見えてくる。\n---\n{色02}12000{/色}以上の\n一撃を放てたら\n---\nまた来るがいい。",
  "tgt": "{立绘1818}「武道无边。\n---\n每精进一分\n便能看到\n前所未见之物。\n---\n若能放出\n{色02}12000{/色}以上的一击\n---\n便再来吧。"
 },
 {
  "id": "002035",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1818}「さらなる高みを\nもとめるなら、\n---\nあとは自分で こたえを\n見つけるがいい。\n---\nお前なら やれるはずだ。",
  "tgt": "{立绘1818}「若想追求\n更高的境界，\n---\n答案就靠\n你自己去找。\n---\n你应该能做到。"
 },
 {
  "id": "002036",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1919}「旅はまだまだ\n長びきそうですか？\n---\n強くなる分だけ\n人はきずつきやすくなることも\nあります。\n---\nまたいつでも\nたずねてきてください。",
  "tgt": "{立绘1919}「看来旅途\n还很长呢？\n---\n人越是变强\n有时也越容易\n受到伤害。\n---\n随时欢迎\n再来找我。"
 },
 {
  "id": "002037",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1919}「旅はまだまだ\n長びきそうですか？\n---\n強くなる分だけ\n人はきずつきやすくなることも\nあります。\n---\nまたいつでも\nたずねてきてください。",
  "tgt": "{立绘1919}「看来旅途\n还很长呢？\n---\n人越是变强\n有时也越容易\n受到伤害。\n---\n随时欢迎\n再来找我。"
 },
 {
  "id": "002038",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1919}「旅はまだまだ\n長びきそうですか？\n---\n強くなる分だけ\n人はきずつきやすくなることも\nあります。\n---\nまたいつでも\nたずねてきてください。",
  "tgt": "{立绘1919}「看来旅途\n还很长呢？\n---\n人越是变强\n有时也越容易\n受到伤害。\n---\n随时欢迎\n再来找我。"
 },
 {
  "id": "002039",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1919}「旅はまだまだ\n長びきそうですか？\n---\n強くなる分だけ\n人はきずつきやすくなることも\nあります。\n---\nまたいつでも\nたずねてきてください。",
  "tgt": "{立绘1919}「看来旅途\n还很长呢？\n---\n人越是变强\n有时也越容易\n受到伤害。\n---\n随时欢迎\n再来找我。"
 },
 {
  "id": "002040",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1919}「わたしの持っている知しきは\nみんな教えてしまいました。\n---\nあとにできることは\nあたたかく\nむかえることくらいです。\n---\nたびにつかれたら\nいつでもおこしください。",
  "tgt": "{立绘1919}「我所知道的知识\n已经全部教给你们了。\n---\n今后能做的\n只有热情地\n迎接你们了。\n---\n旅途劳顿时\n随时欢迎光临。"
 },
 {
  "id": "002041",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1A1A}「‥戦え！\nオトコは戦うことでのみ\nみがかれる。\n---\nむろんオンナもだ。\n---\nとにかく戦闘回数が\n{色02}300{/色}をこえたら\n次の技をさずけよう。",
  "tgt": "{立绘1A1A}「…战斗！\n男人唯有通过战斗\n才能磨砺。\n---\n女人当然也一样。\n---\n总之战斗次数\n超过{色02}300{/色}后\n便传授你下一招。"
 },
 {
  "id": "002042",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1A1A}「‥戦え！\nオトコは戦うことでのみ\nみがかれる。\n---\nむろんオンナもだ。\n---\nとにかく戦闘回数が\n{色02}400{/色}をこえたら\n次の技をさずけよう。",
  "tgt": "{立绘1A1A}「…战斗！\n男人唯有通过战斗\n才能磨砺。\n---\n女人当然也一样。\n---\n总之战斗次数\n超过{色02}400{/色}后\n便传授你下一招。"
 },
 {
  "id": "002043",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1A1A}「‥戦え！\nオトコは戦うことでのみ\nみがかれる。\n---\nむろんオンナもだ。\n---\nとにかく戦闘回数が\n{色02}500{/色}をこえたら\n次の技をさずけよう。",
  "tgt": "{立绘1A1A}「…战斗！\n男人唯有通过战斗\n才能磨砺。\n---\n女人当然也一样。\n---\n总之战斗次数\n超过{色02}500{/色}后\n便传授你下一招。"
 },
 {
  "id": "002044",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1A1A}「‥戦え！\nオトコは戦うことでのみ\nみがかれる。\n---\nむろんオンナもだ。\n---\nとにかく戦闘回数が\n{色02}600{/色}をこえたら\n次の技をさずけよう。",
  "tgt": "{立绘1A1A}「…战斗！\n男人唯有通过战斗\n才能磨砺。\n---\n女人当然也一样。\n---\n总之战斗次数\n超过{色02}600{/色}后\n便传授你下一招。"
 },
 {
  "id": "002045",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1A1A}「おまえたち、\n---\nオレの技を全部おぼえて\nしまったではないか！\n---\n{码0B}‥まあいい。\nオレの教え方が\nよすぎたのだろう。\n---\nかんしゃをわすれぬように。",
  "tgt": "{立绘1A1A}「你们\n---\n竟然把我的招式\n全部学会了！\n---\n…也罢。\n想必是我\n教得太好了。\n---\n莫要忘了感恩。{码0B}‥まあいい。\nオレの教え方が\nよすぎたのだろう。\n---\nかんしゃをわすれぬように。"
 },
 {
  "id": "002046",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1B1B}「めずらしいお宝\nどんどん持ってきてや。\n---\n{色02}{道具2305}{/色}以上の\nものが手に入ったら、\n---\nまた何か\n教えてあげますわ。",
  "tgt": "{立绘1B1B}「稀奇的宝贝\n尽管拿来吧。\n---\n拿到{色02}{道具2305}{/色}\n以上的东西后\n---\n再教你\n别的本事。"
 },
 {
  "id": "002047",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1B1B}「めずらしいお宝\nどんどん持ってきてや。\n---\n{色02}{道具2505}{/色}以上の\nものが手に入ったら、\n---\nまた何か\n教えてあげますわ。",
  "tgt": "{立绘1B1B}「稀奇的宝贝\n尽管拿来吧。\n---\n拿到{色02}{道具2505}{/色}\n以上的东西后\n---\n再教你\n别的本事。"
 },
 {
  "id": "002048",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1B1B}「めずらしいお宝\nどんどん持ってきてや。\n---\n{色02}{道具2705}{/色}が\n手に入ったら、\n---\nまた何か\n教えてあげますわ。",
  "tgt": "{立绘1B1B}「稀奇的宝贝\n尽管拿来吧。\n---\n拿到{色02}{道具2705}{/色}\n之后\n---\n再教你\n别的本事。"
 },
 {
  "id": "002049",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "{立绘1B1B}「{色03}{道具9604}{/色}で\nワイはもう、品切れですわ。",
  "tgt": "{立绘1B1B}「{色03}{道具9604}{/色}\n我这儿已经，没货了呀。"
 },
