 },
 {
  "id": "008825",
  "file": "WORLD/AREAE027.EMI",
  "seg": 8,
  "src": "妖精の移動を行います",
  "tgt": "进行妖精的移动"
 },
 {
  "id": "008826",
  "file": "WORLD/AREAE027.EMI",
  "seg": 8,
  "src": "妖精のパーソナルデータです",
  "tgt": "妖精的详细资料"
 },
 {
  "id": "008827",
  "file": "WORLD/AREAE027.EMI",
  "seg": 8,
  "src": "この職業はまだ開発されていません",
  "tgt": "该职业尚未开发"
 },
 {
