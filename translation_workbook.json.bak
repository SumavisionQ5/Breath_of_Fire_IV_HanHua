  "src": "テップ",
  "tgt": "特普"
 },
 {
  "id": "016476",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "チュー",
  "tgt": "啾"
 },
 {
  "id": "016477",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "シュラ",
  "tgt": "修拉"
 },
 {
  "id": "016478",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "シャド",
  "tgt": "夏德"
 },
 {
  "id": "016479",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「みんなでいっしょに\nケチャしない？{码14820C82}はい\nいいえ",
  "tgt": "「大家一起\n来跳凯恰舞吗？是\n否{码14820C82}はい\nいいえ"
 },
 {
  "id": "016480",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "また来てよう！",
  "tgt": "再来哟！"
 },
 {
  "id": "016481",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "說明は闻く？{码14820CC2}はい\nいいえ",
  "tgt": "要听说明吗？是\n否{码14820CC2}はい\nいいえ"
 },
 {
  "id": "016482",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "ケチャのリズムに合わせて\nタイミングよくボタンを\n押してよう\n---\nジャストで押すと高得点\nずれてると得点がマイナス\n---\n終了後に合計点数が\nひょうじされるから‥\n---\nもしもそれが一定点数を\n超えていたら、一度だけ\n何かアイテムをあげるよう\n---\nちなみに一番いいものは\n{色02}1500点{/色}であげるよう\n---\n{码0B}‥でもこんな点数を出せた人\nいまだに見たことがないけど\n---\n說明は以上だけど、\nもう一度闻く？{码14820CC2}はい\nいいえ",
  "tgt": "跟着克恰的节奏\n看准时机\n按键哟\n---\n按准得高分\n按偏要扣分\n---\n结束后会显示\n总分……\n---\n要是分数超过\n一定数值，会一次性\n送你一件道具哟\n---\n顺便说一句，最好的东西\n要{色02}1500分{/色}才送哟\n---\n{码0B}……不过打出\n这种分数的人\n至今还没见过\n---\n说明就是这些\n要再听一遍吗？{码14820CC2}是\n否"
 },
 {
  "id": "016483",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "それじゃあ、はじめるよう！",
  "tgt": "那么，开始了哟！"
 },
 {
  "id": "016484",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "どうする？{码14820C93}本番にチャレンジ！\nレッスンする\nやめる",
  "tgt": "怎么做？挑战正式演奏！\n上练习课\n不玩了{码14820C93}本番にチャレンジ！\nレッスンする\nやめる"
 },
 {
  "id": "016485",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "どのレッスンをする？{码14820C15}初心者向き\n少し上手な人向き\nすごく上手な人向き\nスペシャリスト向き\n最後のキメ",
  "tgt": "上哪种练习课？面向新手\n面向稍熟练的人\n面向高手\n面向专家\n最后的压轴{码14820C15}初心者向き\n少し上手な人向き\nすごく上手な人向き\nスペシャリスト向き\n最後のキメ"
 },
 {
  "id": "016486",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "レッスン、スタートよう！",
  "tgt": "练习课，开始哟！"
 },
 {
  "id": "016487",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "それじゃあ、本番だよう！",
  "tgt": "那么，正式演奏开始哟！"
 },
 {
  "id": "016488",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "もう一度チャレンジする？{码14820C93}もう一度！\nレッスンする\nやめる",
  "tgt": "要再挑战一次吗？再来一次！\n上练习课\n不玩了{码14820C93}もう一度！\nレッスンする\nやめる"
 },
 {
  "id": "016489",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「じゃんけん じゃんけん\nカードじゃんけん だよう！\nおおもうけ、確実だよう！",
  "tgt": "「猜拳猜拳\n是卡片猜拳哟！\n大赚一笔，稳稳的哟！"
 },
 {
  "id": "016490",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「どうするの？{码14820C94}プレイする\n說明をきく\nけい品を見る\nやらない",
  "tgt": "「要怎么做？玩一把\n听说明\n看奖品\n不玩了{码14820C94}プレイする\n說明をきく\nけい品を見る\nやらない"
 },
 {
  "id": "016491",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "それじゃあ說明するよう\n---\nこれはカードを使って\nじゃんけんするゲームだよう\n---\nモードは{色03}ノーマル{/色}と{色03}ランダム{/色}の\n2種類\n---\nりょうほう6まいのカードを使って\nじゃんけんするんだけど‥\n---\n{色03}ランダム{/色}は じゃんけんカードが\nてきとうにくばられるから\n\n---\n運が悪いと、すぐに負けちゃうよう\n---\nどちらかのカードがなくなった時点で\nゲームは終了\n---\nそっちのカードがなくなるか\nひきわけだったら\nあたしの勝ち\n---\nあたしのカードが\n先になくなったら\nあなたの勝ち\n---\n勝利した場合は\nのこったカード数に応じて\nポイントをゲット\n---\nポイントとこうかんで\nけい品が手に入るけど‥\n---\nどんなにポイントがあっても\n一度のこうかんで\n全部を うしなってしまうよう\n---\nついでに高いポイントの\nけい品を手に入れるには\n---\n何度もれんぞくして勝って\nポイントをためる必要があるよう\n---\nあとは‥\n---\nもしかしたら妖精の せいかくで\nプレイスタイルに\nとくちょうが出るかもしれないよう\n---\n何度もプレイすると\nそのうち分かるかも\n---\n長くなったけど\n說明はこんなところだよう",
  "tgt": "那么来说明哟\n---\n这是用卡片\n来玩猜拳的游戏哟\n---\n模式有普通和随机\n两种\n---\n双方各用6张卡片\n来玩猜拳‥\n---\n随机模式下猜拳卡片\n是随机分发的\n\n---\n运气不好的话马上就会输掉哟\n---\n任意一方的卡片用完之时\n游戏即告结束\n---\n你那边卡片先用完\n或者打平的话\n就算人家赢\n---\n人家的卡片\n先用完的话\n就算你赢\n---\n获胜的话\n按剩余卡片数量\n获得点数\n---\n用点数交换\n能拿到奖品‥\n---\n但不管攒了多少点数\n交换一次\n就会全部失去哟\n---\n想拿到高点数的\n奖品的话\n---\n需要连胜多次\n攒够点数才行哟\n---\n还有‥\n---\n说不定因为妖精的性格\n玩法上会\n出现特色哟\n---\n多玩几次的话\n或许就会明白了\n---\n说得有点长\n说明就到这里哟{色03}ノーマル{/色}と{色03}ランダム{/色}の\n2種類\n---\nりょうほう6まいのカードを使って\nじゃんけんするんだけど‥\n---\n{色03}ランダム{/色}は じゃんけんカードが\nてきとうにくばられるから\n\n---\n運が悪いと、すぐに負けちゃうよう\n---\nどちらかのカードがなくなった時点で\nゲームは終了\n---\nそっちのカードがなくなるか\nひきわけだったら\nあたしの勝ち\n---\nあたしのカードが\n先になくなったら\nあなたの勝ち\n---\n勝利した場合は\nのこったカード数に応じて\nポイントをゲット\n---\nポイントとこうかんで\nけい品が手に入るけど‥\n---\nどんなにポイントがあっても\n一度のこうかんで\n全部を うしなってしまうよう\n---\nついでに高いポイントの\nけい品を手に入れるには\n---\n何度もれんぞくして勝って\nポイントをためる必要があるよう\n---\nあとは‥\n---\nもしかしたら妖精の せいかくで\nプレイスタイルに\nとくちょうが出るかもしれないよう\n---\n何度もプレイすると\nそのうち分かるかも\n---\n長くなったけど\n說明はこんなところだよう"
 },
 {
  "id": "016492",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "また来てよう",
  "tgt": "再来哟"
 },
 {
  "id": "016493",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{金钱00}りょうきんの\n300ゼニーを いただくよう",
  "tgt": "{金钱00}手续费\n收你300泽尼哟"
 },
 {
  "id": "016494",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「お金が足りないよう\nゲームはさせられないよう！",
  "tgt": "「钱不够哟\n没法让你玩哟！"
 },
 {
  "id": "016495",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "勝負開始だよう！\nどっちが負けても\nうらみっこなしだよう",
  "tgt": "胜负开始哟！\n不管哪边输了\n都不许记仇哟"
 },
 {
  "id": "016496",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "ゲーム、やめちゃうの？\n---\nポイントが残っているのに\nゲームをやめると\n---\nポイントはみんな\nなくなっちゃうよう？{码14820C82}はい\nいいえ",
  "tgt": "游戏不玩了吗？\n---\n还剩着点数\n却不玩了的话\n---\n点数会\n全部消失哟？是\n否{码14820C82}はい\nいいえ"
 },
 {
  "id": "016497",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「今回も いいバトルだったよう！\nまだまだプレイする？{码14820C93}ゲームをプレイする\nけい品とこうかん\nやらない",
  "tgt": "「这次也是场好对决哟！\n还要继续玩吗？玩游戏\n用点数换奖品\n不玩了{码14820C93}ゲームをプレイする\nけい品とこうかん\nやらない"
 },
 {
  "id": "016498",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「‥うーん、負けちゃったよう\n---\n残りカード{占位00}まいだから\n{占位00}ポイントかくとくだよう",
  "tgt": "「……嗯——，输了哟\n---\n剩下的牌有{占位00}张\n所以得{占位00}点数哟"
 },
 {
  "id": "016499",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「へへ、あたしの勝ちだよう！\n---\n悪いけど\nこれでポイントは\nリセットだよう",
  "tgt": "「嘿嘿，是人家赢了哟！\n---\n不好意思\n这下点数\n清零了哟"
 },
 {
  "id": "016500",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「それでこそギャンブラー！\nゲーム續行だよう！",
  "tgt": "「这才像赌徒嘛！\n游戏继续哟！"
 },
 {
  "id": "016501",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "ポイントとそれを\nこうかんする？{码14820C82}はい\nいいえ",
  "tgt": "要用点数\n换奖品吗？是\n否{码14820C82}はい\nいいえ"
 },
 {
  "id": "016502",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "ん？\n---\nどうやらそのアイテムは\nいっぱいだよう",
  "tgt": "嗯？\n---\n那个道具好像\n已经满了哟"
 },
 {
  "id": "016503",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "それではこの{色03}{占位00}{/色}を\nプレゼントするよう\n大事にしてほしいよう",
  "tgt": "那就把这件{色03}{占位00}{/色}\n送给你哟\n请好好珍惜哟"
 },
 {
  "id": "016504",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「今回はどっちのモードで\nプレイする？{码14820C02}ノーマル\nランダム",
  "tgt": "{框44}「这次要用哪种模式\n来玩？普通\n随机{码14820C02}ノーマル\nランダム"
 },
 {
  "id": "016505",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框46}「このカードで\nよろしいですか？{码14820C82}はい\nいいえ",
  "tgt": "{框46}「用这张卡片\n可以吗？是\n否{码14820C82}はい\nいいえ"
 },
 {
  "id": "016506",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「それでは勝負だよう！\n---\nじゃんけーん！\nぽん！",
  "tgt": "{框44}「那么一决胜负哟！\n---\n猜拳——！\n啪！"
 },
 {
  "id": "016507",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「あっ！！",
  "tgt": "{框44}「啊！！"
 },
 {
  "id": "016508",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「‥ま、また負けたよう",
  "tgt": "{框44}「‥又、又输了哟"
 },
 {
  "id": "016509",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「へへへ\nまたあたしの勝ち！",
  "tgt": "{框44}「嘿嘿嘿\n又是人家赢！"
 },
 {
  "id": "016510",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「これじゃあ\nもう勝てないよう‥",
  "tgt": "{框44}「这下\n已经赢不了了哟‥"
 },
 {
  "id": "016511",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「連續で負けると\nへこむよう‥",
  "tgt": "{框44}「连输的话\n会受打击的哟‥"
 },
 {
  "id": "016512",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「へへへ\n---\nこれなら絶対に\nあたしの勝ちだよう",
  "tgt": "{框44}「嘿嘿嘿\n---\n这下绝对是\n人家赢了哟"
 },
 {
  "id": "016513",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「よわいなー\n---\nもう少し\nがんばってほしいよう",
  "tgt": "{框44}「真弱呀——\n---\n希望你\n再加把劲哟"
 },
 {
  "id": "016514",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「なんだか\nいいかんじだよう",
  "tgt": "{框44}「总觉得\n感觉不错哟"
 },
 {
  "id": "016515",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「なんだか\nにやけてくるよう",
  "tgt": "{框44}「不知不觉\n要笑出声了哟"
 },
 {
  "id": "016516",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「次はどうしようかな‥",
  "tgt": "{框44}「下次出什么好呢‥"
 },
 {
  "id": "016517",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「へへん！",
  "tgt": "{框44}「嘿嘿！"
 },
 {
  "id": "016518",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「うーん\n次はどうしようかな‥",
  "tgt": "{框44}「唔嗯\n下次出什么好呢‥"
 },
 {
  "id": "016519",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「えーと‥",
  "tgt": "{框44}「那个‥"
 },
 {
  "id": "016520",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「よく分からないよう‥",
  "tgt": "{框44}「人家也搞不懂了哟‥"
 },
 {
  "id": "016521",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「まだまだ勝負は\nわからないよう！",
  "tgt": "{框44}「胜负还没\n见分晓哟！"
 },
 {
  "id": "016522",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「負けたくないよう！",
  "tgt": "{框44}「不想输哟！"
 },
 {
  "id": "016523",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「がんばるよう！",
  "tgt": "{框44}「加油哟！"
 },
 {
  "id": "016524",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「はぁ‥",
  "tgt": "{框44}「哈啊‥"
 },
 {
  "id": "016525",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「勝てるわけないよう‥",
  "tgt": "{框44}「不可能赢的哟‥"
 },
 {
  "id": "016526",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「あれ？\n---\nあっという間に\n勝っちゃったよう！\n---\nどこか ぐあいでも\nわるかったの？",
  "tgt": "{框44}「咦？\n---\n一眨眼\n就赢了哟！\n---\n是不是哪里\n不舒服呀？"
 },
 {
  "id": "016527",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「やったー！\nあたしの勝ちだよう！",
  "tgt": "{框44}「太棒了！\n人家赢了哟！"
 },
 {
  "id": "016528",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「あたしの勝ちだよう！\n---\nだけどなかなか\nつらかったよう",
  "tgt": "{框44}「人家赢了哟！\n---\n不过打得\n相当艰难哟"
 },
 {
  "id": "016529",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「どうやら\nひきわけ だよう\n---\n{码0B}‥ということは\n残念ながらあたしの\n勝ちだよう！",
  "tgt": "{框44}「看来\n是平局哟\n---\n‥也就是说\n很遗憾算人家\n赢了哟！{码0B}‥ということは\n残念ながらあたしの\n勝ちだよう！"
 },
 {
  "id": "016530",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「‥カードがもうないよう\n---\n今回は\nつめがあまかったよう",
  "tgt": "{框44}「‥卡片已经没了哟\n---\n这次\n是人家手软了哟"
 },
 {
  "id": "016531",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「あああ‥\n---\nま、負けちゃったよう‥",
  "tgt": "{框44}「啊啊啊‥\n---\n输、输掉了哟‥"
 },
 {
  "id": "016532",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「だ、だめだよう‥\n---\n何もかもが\nうらめに出たよう‥",
  "tgt": "{框44}「不、不行了哟‥\n---\n做什么\n都不顺哟‥"
 },
 {
  "id": "016533",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "ソウルリング",
  "tgt": "灵魂戒指"
 },
 {
  "id": "016534",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "10000ゼニー",
  "tgt": "10000泽尼"
 },
 {
  "id": "016535",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "オトシ玉",
  "tgt": "压岁玉"
 },
 {
  "id": "016536",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "1000ゼニー",
  "tgt": "1000泽尼"
 },
 {
  "id": "016537",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "パンプス",
  "tgt": "浅口鞋"
 },
 {
  "id": "016538",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "純元気玉",
  "tgt": "纯元气玉"
 },
 {
  "id": "016539",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「次はグーを出すかも\nしれないよう",
  "tgt": "{框44}「下次说不定\n会出石头哟"
 },
 {
  "id": "016540",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「チョキ‥‥{码0B}{码0B}\nいや、なんでもないよう！",
  "tgt": "{框44}「剪刀‥‥\n不，没什么哟！{码0B}{码0B}\nいや、なんでもないよう！"
 },
 {
  "id": "016541",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「次はパーを出そうかな‥",
  "tgt": "{框44}「下次要不要出布呢‥"
 },
 {
  "id": "016542",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "{框44}「カードの残りを考えると\n次はあれしかないよう",
  "tgt": "{框44}「考虑到剩下的卡片\n下次只能出那个了哟"
 },
 {
  "id": "016543",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "あだなをつける人を選んでください",
  "tgt": "请选择要起外号的人"
 },
 {
  "id": "016544",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "方向キー：カーソル移動\n \n{色0A}○{/色}：決定   {色0A}×{/色}：キャンセル",
  "tgt": "方向键：移动光标\n\n○：确定×：取消{色0A}○{/色}：決定   {色0A}×{/色}：キャンセル"
 },
 {
  "id": "016545",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "まじめ",
  "tgt": "认真"
 },
 {
  "id": "016546",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "ノーマル",
  "tgt": "普通"
 },
 {
  "id": "016547",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "なまけもの",
  "tgt": "懒汉"
 },
 {
  "id": "016548",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "かわりもの",
  "tgt": "怪胎"
 },
 {
  "id": "016549",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "ストリート",
  "tgt": "街道"
 },
 {
  "id": "016550",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "ひろば",
  "tgt": "广场"
 },
 {
  "id": "016551",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "たいじゅ",
  "tgt": "大树"
 },
 {
  "id": "016552",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "みずうみ",
  "tgt": "湖"
 },
 {
  "id": "016553",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "やどなし",
  "tgt": "无旅店"
 },
 {
  "id": "016554",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「じゃんけん じゃんけん\nカードじゃんけん だよう！\n---\n真面目なあたしと\nカードじゃんけん しようよう！",
  "tgt": "「猜拳猜拳\n是卡片猜拳哟！\n---\n来和认真的\n人家玩卡片猜拳吧！"
 },
 {
  "id": "016555",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「じゃんけん じゃんけん\nカードじゃんけん だよう！\n---\nへいぼんなあたしと\nカードじゃんけん しようよう！",
  "tgt": "「猜拳猜拳\n是卡片猜拳哟！\n---\n来和平凡的\n人家玩卡片猜拳吧！"
 },
 {
  "id": "016556",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「じゃんけん じゃんけん\nカードじゃんけん だよう！\n---\n不真面目なあたしと\nカードじゃんけん しようよう！",
  "tgt": "「猜拳猜拳\n是卡片猜拳哟！\n---\n来和不认真的\n人家玩卡片猜拳吧！"
 },
 {
  "id": "016557",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「じゃんけん じゃんけん\nカードじゃんけん だよう！\n---\n変わり者のあたしと\nカードじゃんけん しようよう！",
  "tgt": "「猜拳猜拳\n是卡片猜拳哟！\n---\n来和怪脾气的\n人家玩卡片猜拳吧！"
 },
 {
  "id": "016558",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「かんぺきだよう！\n本番にチャレンジしてもOKよう！",
  "tgt": "「完美了哟！\n可以直接挑战正式演奏了哟！"
 },
 {
  "id": "016559",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「かんぺきだよう！\n今度はもう少しむずかしいのに\nチャレンジしようよう！",
  "tgt": "「完美了哟！\n这次来挑战\n更难一点的吧！"
 },
 {
  "id": "016560",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「おしい！\nもう少し落ち着いて\nやってみようよう",
  "tgt": "「好可惜！\n再沉着些\n慢慢练哟"
 },
 {
  "id": "016561",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「う〜ん‥‥{码0B}{码0B}\nもっとレッスンした方がいいよう",
  "tgt": "「唔～‥‥\n还是多练习练习比较好哟{码0B}{码0B}\nもっとレッスンした方がいいよう"
 },
 {
  "id": "016562",
  "file": "WORLD/AREAS042.EMI",
  "seg": 8,
  "src": "「よくできたので ごほうびに\n{色03}{占位00}{/色}をあげるよう！",
  "tgt": "「表现很好，作为奖励\n把{色03}{占位00}{/色}送给你哟！"
 },
 {
  "id": "016563",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "ていとのまえ",
  "tgt": "帝都门前"
 },
 {
  "id": "016564",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "{框81}\n{色08}    帝都フォウ·門前町{/色}{延时90}",
  "tgt": "{框81}\n帝都福乌·门前町{色08}    帝都フォウ·門前町{/色}{延时90}"
 },
 {
  "id": "016565",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "{框02}「おい、にいさん‥\nどうした、だいじょうぶかい？",
  "tgt": "{框02}「喂，小哥‥\n怎么了，没事吧？"
 },
 {
  "id": "016566",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "{框02}「死んじまいそうな\n顏色じゃないか‥\n---\n平気かい‥！？",
  "tgt": "{框02}「这脸色\n都快不行了‥\n---\n没事吧‥！？"
 },
 {
  "id": "016567",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "{框04}{立绘8040}「ここは‥{码0B}‥\n帝都‥、だな‥？",
  "tgt": "{框04}{立绘8040}「这里是‥‥\n帝都‥、吗‥？{码0B}‥\n帝都‥、だな‥？"
 },
 {
  "id": "016568",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "{框02}「あ、ああ‥\n---\n恐れ多くも、神皇\n{队员06}様の\nお作りになった‥\n---\nフォウ帝国の、都さね‥",
  "tgt": "{框02}「啊、嗯‥\n---\n这里是胆大包天的神皇\n{队员06}大人\n亲手建造的‥\n---\n福乌帝国的都城呀‥"
 },
 {
  "id": "016569",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "「あああ‥\n家が‥、ざいさんが‥",
  "tgt": "「啊啊啊‥\n家‥、财产‥"
 },
 {
  "id": "016570",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "「でっかい イヌみたいな\n魔物が やって来て‥\n---\nその後、いろんな魔物が\nガーって、来たんだよー！",
  "tgt": "「像条大狗一样的\n魔物跑来了‥\n---\n之后，各种魔物\n呼啦啦地全来了哟！"
 },
 {
  "id": "016571",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "「どろぼう‥？\n---\nち、ちがうよ‥！\n逃げようか、どうか\nなやんでるんだよ！",
  "tgt": "「小偷‥？\n---\n不、不是啦‥！\n我正在犹豫\n要不要逃呢！"
 },
 {
  "id": "016572",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "「今んとこ‥\n門の外に 魔物は\n出てこない みたいだよ‥\n---\nま、出てきたら\n出てきた時だね‥",
  "tgt": "「目前‥\n魔物似乎不会\n出城门‥\n---\n嘛，出来了\n再说吧‥"
 },
 {
  "id": "016573",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "{金钱00}「‥こんな時ほど\n武器が 必要だろ？{码14840C94}その通りだな‥\nうん、何か売ろう‥\n武器を下取りしてもらおう\n今は、必要ない",
  "tgt": "{金钱00}「…越是这种时候\n越需要武器吧？{码14840C94}正是…\n嗯，卖点东西…\n折卖武器\n现在不需要"
 },
 {
  "id": "016574",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "{金钱00}「町の人間は、みんな\n逃げてしまったけど‥\n---\nわたしゃ、まだまだ\n商売してるよ！{码14850C93}何か買おう\n持ち物を売ろう\n今は用がない",
  "tgt": "{金钱00}「镇上的人都\n逃光了…\n---\n老汉我\n还照常\n开张！{码14850C93}买点什么\n卖点东西\n现在不用"
 },
 {
  "id": "016575",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "「ここは、都の‥\n門前町でね‥‥\n---\n帝都と いっしょに\nさかえて来たんだけど‥",
  "tgt": "「这里是都城的‥\n门前町‥‥\n---\n是随着帝都\n一起兴盛起来的‥"
 },
 {
  "id": "016576",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "「この門の向こうは\n帝都の、中心部ですが‥\n---\n今は、知ってのとおり\n魔物の すみかです‥‥",
  "tgt": "「这道门那边是\n帝都的中心区‥\n---\n现在正如你所知\n成了魔物的巢穴‥‥"
 },
 {
  "id": "016577",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "「いらっしゃい。\n魔物だか、たたりだか\n知らないけど‥\n---\n{金钱00}お客さんが 来る間は\n商売するよ‥{码14860C93}休む‥{占位00}Z\n記錄だけする\nなにもしない",
  "tgt": "「欢迎光临。\n管它是魔物\n还是作祟…\n---\n{金钱00}有客人来\n就做买卖…{码14860C93}休息…{占位00}Z\n只记录\n什么都不做"
 },
 {
  "id": "016578",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "「と‥\nお金が 足りないよ。",
  "tgt": "「但‥\n你的钱不够哦。"
 },
 {
  "id": "016579",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "「ルーン將軍が‥\n都の中に 入られた\nそうだが‥‥\n---\nだいじょうぶ だろうか‥\nうう‥",
  "tgt": "「听说鲁恩将军‥\n进到都城\n里去了‥‥\n---\n不要紧吗‥\n呜呜‥"
 },
 {
  "id": "016580",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "帝国は、もう 終わりだが‥",
  "tgt": "帝国已经完了，"
 },
 {
  "id": "016581",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "後かたづけが、残っている‥",
  "tgt": "但还有烂摊子要收拾。"
 },
 {
  "id": "016582",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "それじゃあ、ここで‥",
  "tgt": "那么，就在这里‥"
 },
 {
  "id": "016583",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "おわかれですね、{队员04}さん",
  "tgt": "与你分别了，{队员04}小姐"
 },
 {
  "id": "016584",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "ああ‥、ルーン將軍も 探したいし‥",
  "tgt": "是啊‥也想找到鲁恩将军‥"
 },
 {
  "id": "016585",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "あー、{队员04}‥",
  "tgt": "啊——，{队员04}‥"
 },
 {
  "id": "016586",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "色々と、ありがとう‥",
  "tgt": "多谢你种种一切‥"
 },
 {
  "id": "016587",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "わ、私は‥、べつに‥",
  "tgt": "我、我才没有‥"
 },
 {
  "id": "016588",
  "file": "WORLD/AREAS043.EMI",
  "seg": 8,
  "src": "もう、敵じゃないだろ？",
  "tgt": "我们已经不是敌人了吧？"
 },
 {
  "id": "016589",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "ふねのなか",
  "tgt": "船舱内"
 },
 {
  "id": "016590",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「この下が‥、船の底だ‥",
  "tgt": "{框06}{立绘8040}「这下面就是‥、船底‥"
 },
 {
  "id": "016591",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「あんた達には、これから\nその 船の底で‥\n---\n一晚、すごしてもらう‥",
  "tgt": "{框06}{立绘8040}「接下来，你们\n就在那船底‥\n---\n待上一晚吧‥"
 },
 {
  "id": "016592",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「カンタンに 思うかも\nしれんがな‥\n---\n船底は、真っ暗で\nジメジメしてて‥\n---\n何が出るか、わからない\n不気味なところだ‥",
  "tgt": "{框06}{立绘8040}「你们可能觉得\n很简单‥\n---\n但船底又黑\n又潮湿‥\n---\n是个不知道会冒出\n什么东西的阴森地方‥"
 },
 {
  "id": "016593",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「あの、カーンのヤツが\n最初に 来たときも‥\n---\nネを上げたほどの\n恐ろしい しれんだ‥\n---\nやめるんなら、今のうちだぞ‥",
  "tgt": "{框06}{立绘8040}「那个叫卡恩的家伙\n第一次来的时候‥\n---\n也叫苦不迭的\n可怕试炼‥\n---\n想放弃的话，趁现在‥"
 },
 {
  "id": "016594",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘4100}「いえ、{码0B}やります‥！\n---\nだから、船を\n使わせて下さいね‥",
  "tgt": "{立绘4100}「不，{码0B}我来干……！\n---\n所以请让我们\n用船吧……"
 },
 {
  "id": "016595",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘4100}「とは、言ったものの‥",
  "tgt": "{立绘4100}「话虽这么说……"
 },
 {
  "id": "016596",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘4100}「本当に、真っ暗で\nじっとり してて‥\n---\n{立绘0101}気持ち悪いですね‥\n{队员04}さん‥",
  "tgt": "{立绘4100}「真的又黑\n又闷……\n---\n{立绘0101}真不舒服呢……\n{队员04}先生……"
 },
 {
  "id": "016597",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘8141}「な、何か‥\nオバケとか‥\n---\n出たり するんですかね？",
  "tgt": "{立绘8141}「会、会不会‥\n有幽灵‥\n---\n什么的出没呀？"
 },
 {
  "id": "016598",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{框05}{立绘C400}「どうだろうな‥\n---\n暗くて、しめった場所には\n魔のものが つきやすいと\n言われてるがな‥",
  "tgt": "{框05}{立绘C400}「谁知道呢……\n---\n都说黑暗潮湿的地方\n容易招\n魔祟之物……"
 },
 {
  "id": "016599",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{框05}{立绘8242}「船が‥、きしんだ音か？",
  "tgt": "{框05}{立绘8242}「是船‥、吱嘎作响的声音吗？"
 },
 {
  "id": "016600",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘8301}「あー、{码0B}びっくりした‥！",
  "tgt": "{立绘8301}「啊——，吓死我了‥！{码0B}びっくりした‥！"
 },
 {
  "id": "016601",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{框06}{立绘8443}「もう、そろそろ‥\n---\nビビって 逃げ出して\nくるんじゃ ねぇか‥\n兄キ‥？",
  "tgt": "{框06}{立绘8443}「差不多‥\n---\n也该吓得\n逃出来了吧‥\n老哥‥？"
 },
 {
  "id": "016602",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘0501}「も、{码0B}もう出ませんかね‥",
  "tgt": "{立绘0501}「还、还没出来吗‥{码0B}もう出ませんかね‥"
 },
 {
  "id": "016603",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{框05}{立绘C400}「あのていどの 魔物なら‥\n---\nそれほど、恐れることも\nないだろう‥‥",
  "tgt": "{框05}{立绘C400}「那种程度的魔物……\n---\n倒也\n不必怕成那样…………"
 },
 {
  "id": "016604",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{框05}{立绘C400}「むやみに、恐怖してると‥\n---\n戦場では、命取りに\nなるぞ‥‥",
  "tgt": "{框05}{立绘C400}「要是乱吓得不行……\n---\n在战场上\n可是会要命的…………"
 },
 {
  "id": "016605",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘0601}「ふわぁ！",
  "tgt": "{立绘0601}「哇啊！"
 },
 {
  "id": "016606",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘8101}「あの、{码0B}{队员04}さん‥\n---\nちょっと、くすぐったいから‥\nシッポ 動かさないで\nくれませんか‥？",
  "tgt": "{立绘8101}「那个，{码0B}{队员04}‥\n---\n有点痒，所以‥\n能不能别摇\n尾巴呀‥？"
 },
 {
  "id": "016607",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{框05}{立绘8202}「シッポ‥{码0B}‥？\n動かしてないぞ‥",
  "tgt": "{框05}{立绘8202}「尾巴‥‥？\n我没摇呀‥{码0B}‥？\n動かしてないぞ‥"
 },
 {
  "id": "016608",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘4100}「ふう‥‥、{码0B}それにしても‥\n---\n{立绘C100}{队员04}さんが\nいっしょで、よかった‥\n---\n{立绘8701}心強いです。",
  "tgt": "{立绘4100}「呼………，{码0B}话说回来……\n---\n{立绘C100}有{队员04}先生\n在身边，真是太好了……\n---\n{立绘8701}很安心。"
 },
 {
  "id": "016609",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘C100}「よく、あるでしょ‥\n---\nオバケは 平気だけど\nねずみは、怖いとか‥\n---\n{立绘8101}ピーマン、食べられないとか‥\n---\n{立绘C100}{队员04}さん‥\nそういうのって、ないです？",
  "tgt": "{立绘C100}「这种事挺常见的吧……\n---\n比如不怕鬼\n却怕老鼠……\n---\n{立绘8101}比如不吃青椒……\n---\n{立绘C100}{队员04}先生……\n您有这种事吗？"
 },
 {
  "id": "016610",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{框05}{立绘4400}「そうだな‥{码0B}‥\n---\nお化けも、ねずみも\n平気だし‥\n---\nピーマンも、食べるな‥",
  "tgt": "{框05}{立绘4400}「让我想想……{码0B}……\n---\n鬼也好\n老鼠也好，都不怕……\n---\n青椒嘛，也不吃……"
 },
 {
  "id": "016611",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘C440}「{特效}な、{码0E}{/特效}",
  "tgt": "{立绘C440}「什、{特效}な、{码0E}{/特效}"
 },
 {
  "id": "016612",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘0101}「き、闻いた事 あります‥\nたしか‥、フナムシです‥\n---\n{立绘FFFF}{立绘8844}「う、{码0B}うなむじ？",
  "tgt": "{立绘0101}「我、我听说过‥\n没错‥、是海蟑螂‥\n---\n{立绘FFFF}{立绘8844}「海、海螂虫？{码0B}うなむじ？"
 },
 {
  "id": "016613",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘0101}「だ、だいじょうぶですよ‥\n---\nかみついたり、しない\nハズですから‥",
  "tgt": "{立绘0101}「没、没问题的‥\n---\n它应该不会\n咬人才对‥"
 },
 {
  "id": "016614",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘4100}「だいじょうぶですか\n{队员04}さん‥？",
  "tgt": "{立绘4100}「{队员04}先生\n您没事吧……？"
 },
 {
  "id": "016615",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘4100}「これで‥、わたし達\n船に乘せて もらえますよね？",
  "tgt": "{立绘4100}「这下……我们\n能上船了吧？"
 },
 {
  "id": "016616",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{框06}{立绘8445}「う、うんー‥\nジグ兄ちゃんが\n決めてくれるよ‥‥",
  "tgt": "{框06}{立绘8445}「嗯、嗯——‥\n吉格哥哥\n会决定的‥‥"
 },
 {
  "id": "016617",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘4200}「今、向かっているのは\n北方諸島の‥\nリプという町らしい‥\n---\nそこから、あさせを伝って\n西側の大陸に\n上陸できるそうだ。",
  "tgt": "{立绘4200}「现在前往的\n是北方诸岛的……\n一个叫莉普的镇子……\n---\n听说从那里\n可以沿着浅滩\n登上西侧的大陆。"
 },
 {
  "id": "016618",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘4400}「海は、気に入らん。\n---\n銃は、ベトベトになるし\nアレも、いるしな‥",
  "tgt": "{立绘4400}「我讨厌海。\n---\n枪会变得黏糊糊\n那玩意儿，又多……"
 },
 {
  "id": "016619",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘C140}「{队员04}さんと\nわたし‥\n---\nここに、入れられたんです。",
  "tgt": "{立绘C140}「{队员04}‥\n还有我‥\n---\n就是被关在这里的。"
 },
 {
  "id": "016620",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘C140}「ちょっと、怖かったですよ‥\n---\nおばけも、出てきたし\nフナムシも‥",
  "tgt": "{立绘C140}「真的有点吓人呢‥\n---\n又是幽灵出没\n又是海蟑螂的‥"
 },
 {
  "id": "016621",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘0301}「な、何！？",
  "tgt": "{立绘0301}「什、什么！？"
 },
 {
  "id": "016622",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘8541}「何かが、船の底に\nぶつかってる みたいです‥\n---\nジグさんに 報せないと‥！",
  "tgt": "{立绘8541}「好像有什么东西\n在撞船底‥\n---\n得赶紧告诉吉格‥！"
 },
 {
  "id": "016623",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{框05}{立绘0804}「い、{码0B}今の音は\nなな何だ‥\n---\nアレか‥？\nアレが、出たんだ{特效}な{码0E}{/特效}\n！？",
  "tgt": "{框05}{立绘0804}「刚、刚才的声音\n是是是什么‥\n---\n是那家伙‥？\n是那家伙\n出来了吗！？{码0B}今の音は\nなな何だ‥\n---\nアレか‥？\nアレが、出たんだ{特效}な{码0E}{/特效}\n！？"
 },
 {
  "id": "016624",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{框06}{立绘8341}「お、おちついて\n{队员04}さん！\n---\nふ、フナムシじゃ\nありませんから‥！",
  "tgt": "{框06}{立绘8341}「冷、冷静点\n{队员04}！\n---\n不、不是\n海蟑螂‥！"
 },
 {
  "id": "016625",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘C140}「‥‥何かが\n船の底に ぶつかってる\nみたいなんです。\n---\nジグさんに 伝えたほうが\nいいかと思って‥",
  "tgt": "{立绘C140}「‥‥好像有什么东西\n在撞船底，\n的样子。\n---\n我想还是告诉\n吉格比较好‥"
 },
 {
  "id": "016626",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘0202}「わ、分かった‥\nすまなかったな。",
  "tgt": "{立绘0202}「好、好的‥\n抱歉了。"
 },
 {
  "id": "016627",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘4400}「まだ、着かないのか‥\n---\n船だと、遲いのだな。",
  "tgt": "{立绘4400}「还没到吗……\n---\n坐船\n就是慢啊。"
 },
 {
  "id": "016628",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘4200}「今、おおよそ\n半分ぐらいの ところまで\n来ているハズだ‥",
  "tgt": "{立绘4200}「现在应该\n差不多走完\n一半路程了……"
 },
 {
  "id": "016629",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘4300}「ひ‥‥\n---\nま。",
  "tgt": "{立绘4300}「呼………\n---\n嘛。"
 },
 {
  "id": "016630",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘4400}「神の住む、島‥\n---\n竜と 関わると\nいろんな事が、あるな‥",
  "tgt": "{立绘4400}「神栖之岛……\n---\n和龙扯上关系\n真是事事不断啊……"
 },
 {
  "id": "016631",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘4200}「いずれにせよ、風が\n出ないことには‥\n---\n船は 動かないと\n言う事か‥",
  "tgt": "{立绘4200}「总之\n只要风不出来……\n---\n船就开不动\n是吧……"
 },
 {
  "id": "016632",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘4300}「し‥‥\n---\nま。",
  "tgt": "{立绘4300}「是………\n---\n嘛。"
 },
 {
  "id": "016633",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘4100}「竜の化身の人‥\n海で、本体に\n会うだろうって‥\n---\n言ってましたよね。",
  "tgt": "{立绘4100}「那位龙的化身……\n说过在海里\n会见到本体……\n---\n是这么说的吧。"
 },
 {
  "id": "016634",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘4200}「あと、2〜3日で\n目的地に 着くそうだ‥",
  "tgt": "{立绘4200}「听说再有\n两三天\n就到目的地了……"
 },
 {
  "id": "016635",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘0000}「すまなかったな‥\n---\nいつもなら、コースを\nまちがえる事は\nねぇんだけど、なぁ‥",
  "tgt": "{立绘0000}「对不住啊……\n---\n平时我\n是不会弄错\n航线的……"
 },
 {
  "id": "016636",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘4400}「竜の気が、あのような\n魔の物を 呼ぶのか‥？",
  "tgt": "{立绘4400}「龙的气息\n会招来那种\n魔祟之物吗……？"
 },
 {
  "id": "016637",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘4400}「そろそろ、着くようだな‥",
  "tgt": "{立绘4400}「看样子\n快到了……"
 },
 {
  "id": "016638",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘0906}「それにしても\n半身だけで、あれだけの\n魔物に えいきょうするとは‥\n---\n{队员00}は、かなり\n力の強い、うつろわざるもの\nって、事かねぇ‥\n---\n{立绘4500}って、ディースさんが\n言ってますね。\nふふー。",
  "tgt": "{立绘0906}「话说……\n只凭半身\n就能影响那样的魔物……\n---\n{队员00}是\n力量相当强的\n不变不易者……吧……\n---\n{立绘4500}蒂斯大人\n是这么说的哟。\n呼呼——。"
 },
 {
  "id": "016639",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘0403}「もうじき、目的地の\n{色02}リプ村{/色}に 着くよ‥！",
  "tgt": "{立绘0403}「马上就要到目的地\n{色02}莉普村{/色}了哟……！"
 },
 {
  "id": "016640",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘4200}「リプ村から、西大陸まで\nけっこう 遠いらしい‥\n---\n長い旅に なりそうだな‥",
  "tgt": "{立绘4200}「从莉普村到\n西大陆好像挺远…\n---\n看来是场长途旅行啊…"
 },
 {
  "id": "016641",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘0101}「海の風で、べとべと。\nあー、おフロ入りたいな‥",
  "tgt": "{立绘0101}「海风吹得黏糊糊的。\n啊——，好想泡个澡呀‥"
 },
 {
  "id": "016642",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "{立绘0000}「おう、{码0B}そろそろ\nリプの村が、見えるころだぜ‥",
  "tgt": "{立绘0000}「哦，{码0B}差不多\n该望见莉普村了吧……"
 },
 {
  "id": "016643",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "ベッドがある‥\nここなら 休めそうだ。{码14860C93}休んでいこう\n旅の記錄だけする\nやめておく",
  "tgt": "有张床‥\n这里应该能休息。休息吧\n只做旅途记录\n先不休息{码14860C93}休んでいこう\n旅の記錄だけする\nやめておく"
 },
 {
  "id": "016644",
  "file": "WORLD/AREAS044.EMI",
  "seg": 11,
  "src": "ベッドがある‥\nここなら 休めそうだ。{码14000C93}休んでいこう\n旅の記錄だけする\nやめておく",
  "tgt": "有一张床……\n这里似乎能休息。{码14000C93}休息一下\n只记录旅程\n还是算了"
 },
 {
  "id": "016645",
  "file": "WORLD/AREAS045.EMI",
  "seg": 11,
  "src": "にーなたちがるでぃあで\nあてがわれるへや。",
  "tgt": "妮娜她们在鲁迪亚\n被安排的房间。"
 },
 {
  "id": "016646",
  "file": "WORLD/AREAS045.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「{队员00}‥、起きてた？",
  "tgt": "{框05}{立绘4100}「{队员00}……你醒着？"
 },
 {
  "id": "016647",
  "file": "WORLD/AREAS045.EMI",
  "seg": 11,
  "src": "{框05}{立绘C100}「なんだか、すっきりしない\n天気‥‥\n---\n{立绘8000}{队员02}兄さまの\n取り調べは‥\n---\nまだ、續いてるのかな‥",
  "tgt": "{框05}{立绘C100}「总觉得天气\n阴沉沉的………\n---\n{立绘8000}{队员02}哥哥的\n审问……\n---\n还在继续吗……"
 },
 {
  "id": "016648",
  "file": "WORLD/AREAS045.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「ルディアのお城に\n行ってみません？\n---\n兄さまと、面会できるかも\nしれませんし‥",
  "tgt": "{框05}{立绘4100}「要不要去\n卢迪亚城看看？\n---\n说不定能\n和哥哥见面……"
 },
 {
  "id": "016649",
  "file": "WORLD/AREAS045.EMI",
  "seg": 11,
  "src": "{立绘C140}「あ、そうそう‥\nこちら、{队员03}さん。\n---\nわたしたちが 逃げないように\n見はる お役目の人です。",
  "tgt": "{立绘C140}「啊，对了‥\n这位是{队员03}。\n---\n是负责看守\n不让我们逃走的人。"
 },
 {
  "id": "016650",
  "file": "WORLD/AREAS045.EMI",
  "seg": 11,
  "src": "{立绘0100}「兄さまを おいて\n逃げるだなんて‥\n---\nできないんですけどね‥",
  "tgt": "{立绘0100}「丢下哥哥\n自己逃走……\n---\n这种事\n我们是做不出来的……"
 },
 {
  "id": "016651",
  "file": "WORLD/AREAS045.EMI",
  "seg": 11,
  "src": "{立绘4300}「み‥‥\n---\n見はる‥",
  "tgt": "{立绘4300}「看………\n---\n看哨……"
 },
 {
  "id": "016652",
  "file": "WORLD/AREAS045.EMI",
  "seg": 11,
  "src": "{立绘4500}「{队员05}が‥\nヒマだって 言ってます。",
  "tgt": "{立绘4500}「{队员05}说……\n她很闲。"
 },
 {
  "id": "016653",
  "file": "WORLD/AREAS045.EMI",
  "seg": 11,
  "src": "{立绘4300}「ど‥‥‥\n---\nどこ行く‥？\nおれ、ついて行く。",
  "tgt": "{立绘4300}「去…………\n---\n去哪儿……？\n我也去。"
 },
 {
  "id": "016654",
  "file": "WORLD/AREAS045.EMI",
  "seg": 11,
  "src": "\n   ここで夜を待ちますか？{码14000C82}はい\nいいえ",
  "tgt": "\n   要在这里等天黑吗？{码14000C82}是\n否"
 },
 {
  "id": "016655",
  "file": "WORLD/AREAS045.EMI",
  "seg": 11,
  "src": "{立绘4100}「さあ‥{码0B}‥{码0B}‥\n---\n行きましょう‥！",
  "tgt": "{立绘4100}「来……{码0B}……{码0B}……\n---\n走吧……！"
 },
 {
  "id": "016656",
  "file": "WORLD/AREAS045.EMI",
  "seg": 11,
  "src": "ここなら 休めそうだ‥{码148B0C93}休んでいく\n旅の記錄だけする\nやめておく",
  "tgt": "在这里似乎能休息‥休息一下\n只保存旅程记录\n算了{码148B0C93}休んでいく\n旅の記錄だけする\nやめておく"
 },
 {
  "id": "016657",
  "file": "WORLD/AREAS045.EMI",
  "seg": 11,
  "src": "{立绘0201}「運よく 部屋が空いて\n助かったわ‥\n---\n{金钱00}ま、それは さておき\n何か買うておくれ！{码14840C94}買い物をしよう\n何か売ろう\n武器を下取りしてもらおう\n今はやめておく",
  "tgt": "{立绘0201}「运气好，正好有空房\n真是帮大忙了……\n---\n{金钱00}嘛，闲话少说\n买点什么吧！{码14840C94}买点什么\n卖点什么\n武器折价回收\n这次算了"
 },
 {
  "id": "016658",
  "file": "WORLD/AREAS045.EMI",
  "seg": 11,
  "src": "{立绘0302}「ねー、闻いた？\nルディア城から\n逃げ出した、フーレンの族長‥\n---\n{立绘FFFF}{立绘8443}「そのまま\nウインディアまで\n逃げたんですってね！",
  "tgt": "{立绘0302}「喂，听说了吗？\n从鲁迪亚城\n逃出来的弗雷恩族长‥\n---\n{立绘FFFF}{立绘8443}「听说一路\n逃到温迪亚\n去了呢！"
 },
 {
  "id": "016659",
  "file": "WORLD/AREAS045.EMI",
  "seg": 11,
  "src": "{立绘0403}「ウワサだと、その族長を\n助け出したのが\nウインディア王女の‥\n---\n{立绘FFFF}{立绘8342}「いもうと なんでしょ！？\n王家って、スキャンダラスね！",
  "tgt": "{立绘0403}「据传闻，把那族长\n救出来的\n是温迪亚王女的‥\n---\n{立绘FFFF}{立绘8342}「妹妹对吧！？\n王家真是够八卦的呢！"
 },
 {
  "id": "016660",
  "file": "WORLD/AREAS045.EMI",
  "seg": 11,
  "src": "「かーちゃん\nハラへったあ‥",
  "tgt": "「妈——\n我肚子饿了呀‥"
 },
 {
  "id": "016661",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}{立绘0101}セネスタしつない。\n---\n00と01はマーロックのいえ。\n02と03は宿屋。\n04と07はこじいん。",
  "tgt": "{立绘0000}{立绘0101}塞内斯塔室内。\n---\n00和01是马洛克的家。\n02和03是旅店。\n04和07是小教堂。"
 },
 {
  "id": "016662",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "「西側の物を 買ってきて\n商売しようって連中が\nこの町に、集まってるんだ‥",
  "tgt": "「想把西边的货\n买来卖钱的家伙们\n都聚到这镇上来了‥"
 },
 {
  "id": "016663",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0202}{金钱00}「めずらしい西側の武器や‥\n見るだけでも、見てって！{码14840C94}何か買う\n持ち物を売る\n下取りしてもらう\nやめておく",
  "tgt": "{立绘0202}{金钱00}「难得的西方武器店……\n光看看也好，进来看看嘛！{码14840C94}买点什么\n卖掉身上的东西\n折价回收\n这次算了"
 },
 {
  "id": "016664",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0303}「{码0A}\nなうー。",
  "tgt": "{立绘0303}「\n喵呜——。{码0A}\nなうー。"
 },
 {
  "id": "016665",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}「何かご用ですかな‥？\n---\nすみませんが、子供たちに\n食事をさせるまで\n待って下さいな‥",
  "tgt": "{立绘0000}「有什么事吗……？\n---\n不好意思\n要先给孩子们\n做好饭才行……"
 },
 {
  "id": "016666",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0404}「あー、おなかすいた‥\nチノったら、どこを\nうろついてるのかしら",
  "tgt": "{立绘0404}「啊——，肚子饿了‥\n千乃这家伙\n又晃到哪里去了呀"
 },
 {
  "id": "016667",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0505}「このふく、カッコいいだろ？\n---\nウインディアの、王女様に\nもらったんだ！",
  "tgt": "{立绘0505}「这衣服，帅吧？\n---\n是温迪亚的\n王女大人送的！"
 },
 {
  "id": "016668",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0606}「ナーマ、おなかすいた。\n---\nチノが、归ってこないと\nゴハン食べられないの‥",
  "tgt": "{立绘0606}「纳玛，肚子饿了。\n---\n千乃不回来\n就没饭吃呀‥"
 },
 {
  "id": "016669",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0707}「チノは、また 町の中を\n走り回ってるんだわ‥\n---\nまったく、子供なんだから‥",
  "tgt": "{立绘0707}「千乃又在\n镇子里跑来跑去啦‥\n---\n真是的，孩子气‥"
 },
 {
  "id": "016670",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0808}「この間、ウインディアから\n王女様が、おみまいに\n来てくださいました‥\n---\nそして、私たちに\nふくとか、おもちゃを\n下さったのです。",
  "tgt": "{立绘0808}「前几天，温迪亚的\n王女大人\n来慰问我们了‥\n---\n还给了我们\n衣服呀\n玩具呀‥"
 },
 {
  "id": "016671",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0909}「わたしたち、お父さんも\nお母さんも、いないの。\n---\nリタおばあちゃんが\nみんなの お母さんの\nかわりなの。",
  "tgt": "{立绘0909}「我们没有\n爸爸也没有妈妈。\n---\n莉塔奶奶\n就是大家的\n妈妈。"
 },
 {
  "id": "016672",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0A0A}「てへー‥",
  "tgt": "{立绘0A0A}「嘿嘿——‥"
 },
 {
  "id": "016673",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "「おみまいに来た、王女様？\n---\nリタのばあさんなら\n何か知ってるかねぇ‥\n---\nいどの前の家で\n子供たちを 世話してる\nばあさんだよ‥",
  "tgt": "「来慰问的王女大人？\n---\n问莉塔老婆子的\n话兴许知道‥\n---\n就是在井前那家\n照看孩子们的\n老婆子哟‥"
 },
 {
  "id": "016674",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0B0B}旅の記錄をつけますか？{码14890C82}はい\nいいえ",
  "tgt": "{立绘0B0B}要做旅途记录吗？好\n不要{码14890C82}はい\nいいえ"
 },
 {
  "id": "016675",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "からっぽだ‥。\nエリーナの持ってきた物だろうか？",
  "tgt": "是空的‥。\n是艾莉娜带来的东西吗？"
 },
 {
  "id": "016676",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "子供のふくが入っている‥",
  "tgt": "装着小孩的衣服‥"
 },
 {
  "id": "016677",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "おもちゃと、おかしが入っている。",
  "tgt": "装着玩具和点心。"
 },
 {
  "id": "016678",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「戻ったかい‥{码0B}‥\nチノも いっしょだね。",
  "tgt": "{框06}{立绘8040}「回来啦‥‥\n千乃也一起呢。{码0B}‥\nチノも いっしょだね。"
 },
 {
  "id": "016679",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0C0C}「はい、リタさま。\nこちらの方々が‥\n---\nチノを 捕まえるのを\n手伝って下さいました。",
  "tgt": "{立绘0C0C}「是，莉塔大人。\n是各位‥\n---\n帮忙抓住了\n千乃。"
 },
 {
  "id": "016680",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「まあ‥ それはどうも\nありがとうございました。",
  "tgt": "{框06}{立绘8040}「哎呀‥那可真是\n太谢谢你们了。"
 },
 {
  "id": "016681",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「はい、それでは\nみんな そろったので‥\n食事にしましょうね。",
  "tgt": "{框06}{立绘8040}「好，那么\n人齐了‥\n开饭吧。"
 },
 {
  "id": "016682",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「さて、みなさん‥\n---\nその間、上でお話を\nうかがいましょう‥",
  "tgt": "{框06}{立绘8040}「来，各位‥\n---\n在此期间\n就到上面听听谈话吧‥"
 },
 {
  "id": "016683",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「‥{码0B}‥ええ、たしかに。\nエリーナさまは、ここへ\nおいで下さいました。",
  "tgt": "{框05}{立绘0000}「……{码0B}……嗯，确实。\n艾莉娜大人\n来过这里。"
 },
 {
  "id": "016684",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「本当に、おやさしい方で‥\n---\n戦爭で、親をなくした\n子供たちに‥、と\nたくさんの品々を‥",
  "tgt": "{框05}{立绘0000}「真是位温柔的人……\n---\n给战争中失去父母的\n孩子们……\n送来了许多东西……"
 },
 {
  "id": "016685",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘C200}「それで、その後だが‥\n---\nエリーナたちが どこへ\n向かったのか、分からないか？",
  "tgt": "{立绘C200}「那么，在那之后……\n---\n知不知道艾莉娜他们\n去了哪里？"
 },
 {
  "id": "016686",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「それは‥{码0B}‥\n申しわけないのですが‥",
  "tgt": "{框05}{立绘0000}「这个……{码0B}……\n实在抱歉……"
 },
 {
  "id": "016687",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘8D0D}「どんな小さな 手がかりでも\nほしいんです‥！",
  "tgt": "{框06}{立绘8D0D}「哪怕再小的线索\n也想知道呀‥！"
 },
 {
  "id": "016688",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘8E4E}「おれ、知ってるぜ！",
  "tgt": "{框06}{立绘8E4E}「我，我知道哟！"
 },
 {
  "id": "016689",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框45}{立绘0000}「チノ‥",
  "tgt": "{框45}{立绘0000}「奇乃……"
 },
 {
  "id": "016690",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘4100}「チノくん‥、ねえさまが‥\n王女様が、どこへ行ったのか\n知ってるの？",
  "tgt": "{立绘4100}「奇乃……我姐姐……\n你知道公主殿下\n去哪儿了吗？"
 },
 {
  "id": "016691",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘8E4E}「ああ、バィーンと\n知ってるぜ‥、{码0B}でも‥",
  "tgt": "{框06}{立绘8E4E}「嗯，我当然\n知道啦‥，不过‥{码0B}でも‥"
 },
 {
  "id": "016692",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘8E4E}「カンタンには、教えない！\n---\nさっきは、おにごっこで\n捕まったから‥{码0B}‥\n---\n次は、かくれんぼで\nおれたちに 勝ったら\n教えてやるよ！",
  "tgt": "{框06}{立绘8E4E}「可不能轻易告诉你！\n---\n刚才玩抓人\n被你们抓到了‥‥\n---\n下次玩捉迷藏\n赢过我们\n才告诉你哟！{码0B}‥\n---\n次は、かくれんぼで\nおれたちに 勝ったら\n教えてやるよ！"
 },
 {
  "id": "016693",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘0E4E}「おーい、みんなっ\nかくれんぼだぜーっ！！",
  "tgt": "{框06}{立绘0E4E}「喂——，大家\n玩捉迷藏啦——！！"
 },
 {
  "id": "016694",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「も、{码0B}申しわけありません。\nとんだ事に なってしまって‥",
  "tgt": "{框05}{立绘0000}「对，{码0B}对不起。\n竟发生了\n这种事……"
 },
 {
  "id": "016695",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘8F4D}「いえ、{码0B}いいんです。\nでも‥\n---\n{立绘C140}「チノくんが、ねえさまの事\n知っているのなら‥\n---\n何でもいいから\n教えてもらわないと‥！",
  "tgt": "{框06}{立绘8F4D}「不，不用了。\n不过‥\n---\n{码0B}「千乃既然知道\n姐姐的事‥\n---\n不管什么都\n得请他告诉我们‥！{立绘C140}「チノくんが、ねえさまの事\n知っているのなら‥\n---\n何でもいいから\n教えてもらわないと‥！"
 },
 {
  "id": "016696",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「探しに行きましょう。",
  "tgt": "{框06}{立绘C140}「去找人吧。"
 },
 {
  "id": "016697",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0707}「か、{码0B}かくれそこなった\nワケじゃないのよ‥\n---\nかくれんぼ なんて\n子供の遊び、{码0B}しないの。",
  "tgt": "{立绘0707}「才，才不是\n没躲好呢‥\n---\n捉迷藏这种\n小孩游戏，我才不玩。{码0B}かくれそこなった\nワケじゃないのよ‥\n---\nかくれんぼ なんて\n子供の遊び、{码0B}しないの。"
 },
 {
  "id": "016698",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0C0C}「すみません‥\n追いかけたんですけど‥",
  "tgt": "{立绘0C0C}「对不起‥\n虽然追过了‥"
 },
 {
  "id": "016699",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0A0A}「てへへー‥\nみつかったー‥！\n---\n‥{码0B}‥おしえてあげるー。\nルンダはー\n---\nひがしの じょうへきの\nしたにー‥\n---\nかくれるって ゆってたー。",
  "tgt": "{立绘0A0A}「嘿嘿——‥\n被找到啦——！\n---\n‥‥告诉你呀。\n伦达呀\n---\n说是要躲在\n东城墙\n---\n下面呀。{码0B}‥おしえてあげるー。\nルンダはー\n---\nひがしの じょうへきの\nしたにー‥\n---\nかくれるって ゆってたー。"
 },
 {
  "id": "016700",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0A0A}「ルンダ、みつけたー？\n---\nおうちの ひがしでー。",
  "tgt": "{立绘0A0A}「找到伦达了吗？\n---\n在房子的东边呀。"
 },
 {
  "id": "016701",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0909}「あたしの かくれ場所\nヨーンに 闻いたでしょ。",
  "tgt": "{立绘0909}「我的藏身处\n问过约恩了吧。"
 },
 {
  "id": "016702",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0808}「みんな、見つかりましたか？",
  "tgt": "{立绘0808}「大家都找到了吗？"
 },
 {
  "id": "016703",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0606}「ドモタ、見えたでしょ？\n橋の上から、北の方に‥",
  "tgt": "{立绘0606}「多莫塔，看到了吧？\n从桥上朝北那边‥"
 },
 {
  "id": "016704",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0505}「ちゃんと步いてみた？\n---\nずばり、宿屋って\n言ったほうが良かった？",
  "tgt": "{立绘0505}「好好找过了吗？\n---\n干脆说\n在旅店不是更好？"
 },
 {
  "id": "016705",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0404}「また、チノがいないなぁ。",
  "tgt": "{立绘0404}「千乃又不见啦。"
 },
 {
  "id": "016706",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0404}「見つかっちゃった！\n---\n‥もう、みんな見つけた？\n一度 うちに戻って\n数えてみたら？",
  "tgt": "{立绘0404}「被抓到了！\n---\n‥大家，都找到了？\n回一趟我家\n数数看吧？"
 },
 {
  "id": "016707",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0404}「見つけた子は\nうちに戻ってるから‥\n---\n全部で、8人いれば\nいいんだよ。",
  "tgt": "{立绘0404}「被抓到的孩子\n都会回我家‥\n---\n一共齐8个\n就行啦。"
 },
 {
  "id": "016708",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0C0C}「ひょっとして‥\nやっぱり‥{码0B}‥\n---\nチノが、見つかって\nいないのですね？",
  "tgt": "{立绘0C0C}「难道说‥\n果然‥‥\n---\n千乃，还没有\n被抓到呀？{码0B}‥\n---\nチノが、見つかって\nいないのですね？"
 },
 {
  "id": "016709",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0C0C}「ああ‥、{码0B}ご存知のように\nあの子は、逃げたり‥\n---\nかくれたりするのが\nとても 上手なのです。",
  "tgt": "{立绘0C0C}「唉‥，如你们所见\n那孩子逃跑呀‥\n---\n躲藏呀\n特别拿手呀。{码0B}ご存知のように\nあの子は、逃げたり‥\n---\nかくれたりするのが\nとても 上手なのです。"
 },
 {
  "id": "016710",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0505}「チノのやつだったら‥\n---\n地下に かくれるって\n言ってたぜ。",
  "tgt": "{立绘0505}「千乃那家伙‥\n---\n说过要躲在\n地下的。"
 },
 {
  "id": "016711",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8C4C}「チノは、みはりを\nくぐり抜けて‥\n---\n地下へ かくれたのかも\n知れません‥",
  "tgt": "{立绘8C4C}「千乃可能\n穿过哨兵‥\n---\n躲进地下\n去了呀‥"
 },
 {
  "id": "016712",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘4100}「私たち、地下を\n見に行ってきます‥",
  "tgt": "{立绘4100}「我们去\n看看地下……"
 },
 {
  "id": "016713",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8C4C}「本当ですか‥\n助かります！\n---\nそれでは、よろしく\nお願いします。",
  "tgt": "{立绘8C4C}「真的吗‥\n帮大忙了！\n---\n那就拜托\n各位了。"
 },
 {
  "id": "016714",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}「ウインディアから、王女様が\n来られたときは\nみんな おおよろこびで‥\n---\n特に、チノは\nとても はしゃいでました。",
  "tgt": "{立绘0000}「温蒂亚的公主殿下\n来的时候\n大家都高兴得很……\n---\n尤其是奇乃\n闹得特别欢。"
 },
 {
  "id": "016715",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0404}「チノったら、心配だわ‥\n---\nだって、コノコ\nお姉さんだもん。",
  "tgt": "{立绘0404}「千乃真让人担心‥\n---\n毕竟，这家伙\n是姐姐呀。"
 },
 {
  "id": "016716",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0505}「かくれんぼ‥\nおもしろかった？",
  "tgt": "{立绘0505}「捉迷藏‥\n好玩吗？"
 },
 {
  "id": "016717",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0606}「遊んだら、また\nおなかすいた。",
  "tgt": "{立绘0606}「玩完\n肚子又饿了。"
 },
 {
  "id": "016718",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0707}「地下は、危ないって\n言われてるのに‥\n---\nほんと、チノって\n子供なんだから‥！",
  "tgt": "{立绘0707}「都说地下\n很危险了‥\n---\n真是的，千乃\n太孩子气了‥！"
 },
 {
  "id": "016719",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0C0C}「地下の入り口には\n見張りが いますが‥\n---\nきっと‥\n水でも のんでるスキに\n入りこんだんでしょう‥",
  "tgt": "{立绘0C0C}「地下入口\n虽然有人把守‥\n---\n一定是趁他\n喝水发呆时\n溜进去的吧‥"
 },
 {
  "id": "016720",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0808}「地下への入り口は\n城門の上に あるんです。",
  "tgt": "{立绘0808}「地下入口\n就在城门上面。"
 },
 {
  "id": "016721",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0909}「あの見張りの人‥\n---\nときどき、水売りの\nおねえさんと\n話しこんでるよ。",
  "tgt": "{立绘0909}「那个哨兵呀‥\n---\n时不时和\n卖水的大姐姐\n聊得火热哟。"
 },
 {
  "id": "016722",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0A0A}「えへへー‥",
  "tgt": "{立绘0A0A}「嘿嘿——‥"
 },
 {
  "id": "016723",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘4100}「それじゃ、チノくん‥\n---\nねえさま‥、王女様のこと\n教えてくれる？",
  "tgt": "{立绘4100}「那么，奇乃……\n---\n我姐姐……公主殿下的事\n你能告诉我们吗？"
 },
 {
  "id": "016724",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框04}{立绘8E4E}「ああ、やくそくだしな‥",
  "tgt": "{框04}{立绘8E4E}「嗯，说话要算数呀‥"
 },
 {
  "id": "016725",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框04}{立绘8E4E}「あの、きれいな王女様が\nこの町を 出発するとき‥",
  "tgt": "{框04}{立绘8E4E}「那位漂亮的王女大人\n离开这镇子的时候‥"
 },
 {
  "id": "016726",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框03}{立绘4200}「それは、誰だ！？\n---\nどんなヤツだったんだ？",
  "tgt": "{框03}{立绘4200}「那是谁！？\n---\n是什么样的人？"
 },
 {
  "id": "016727",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框04}{立绘8E4E}「‥よく分かんなかったケド\nひとりは、商人の\n{色02}マーロック{/色}だったぜ。",
  "tgt": "{框04}{立绘8E4E}「……虽然没看太清楚\n其中一个是商人\n{色02}马洛克{/色}。"
 },
 {
  "id": "016728",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「{色02}マーロック{/色}さん‥\nと言うのは‥‥\n---\nこの町に 住んでいる\n商人の方で‥\n---\n大きな砂船で\n帝国の方とも 商売を\nしているとか‥",
  "tgt": "{框04}{立绘8040}「{色02}马洛克{/色}\n这位……\n---\n是住在\n这个镇上的商人……\n---\n听说还开着\n大沙船\n和帝国那边做生意……"
 },
 {
  "id": "016729",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框02}{立绘0D0D}「帝国‥！？\n---\nじゃあ、ねえさまは‥\n西側へ‥‥",
  "tgt": "{框02}{立绘0D0D}「帝国‥！？\n---\n那，姐姐是‥\n去了西边‥‥"
 },
 {
  "id": "016730",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框02}{立绘4200}「すまんが‥\nその、マーロックとやらは\nどこにいるんだ‥？",
  "tgt": "{框02}{立绘4200}「不好意思……\n那个马洛克\n人在哪里……？"
 },
 {
  "id": "016731",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框04}{立绘8E4E}「マーロックん家は\n町のまんなかに あるぜ‥\n---\nよーじんぼー ってのが\n家の前に 立ってるんだ。",
  "tgt": "{框04}{立绘8E4E}「马洛克家\n就在镇子正当中‥\n---\n门前立着\n卫兵。"
 },
 {
  "id": "016732",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框02}{立绘4200}「ともかく‥、その\nマーロックに 会ってみる。\n---\nありがとう\n世話をかけた‥",
  "tgt": "{框02}{立绘4200}「总之……\n先去见见\n那个马洛克。\n---\n多谢\n麻烦你了……"
 },
 {
  "id": "016733",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}「ウインディアの王女さん‥？",
  "tgt": "{立绘8141}「温迪亚的王女‥？"
 },
 {
  "id": "016734",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「たしかに‥\n---\nそんな感じの お人を\n砂船に お乘せしました‥",
  "tgt": "{框06}{立绘8141}「确实‥\n---\n那样气派的女士\n我载过她上沙船‥"
 },
 {
  "id": "016735",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框05}{立绘0D0D}「姉さまを‥、どこへ\nさらって行ったんです！",
  "tgt": "{框05}{立绘0D0D}「把姐姐‥带到\n哪里去了！"
 },
 {
  "id": "016736",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}「さらったなんて\nとんでもない！\n---\nワイは 賴まれて‥\nあの人を 西側まで\nおくっただけです！",
  "tgt": "{立绘8141}「说什么绑架\n太不像话了！\n---\n我是受人所托\n把那人送到\n西边而已！"
 },
 {
  "id": "016737",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框05}{立绘4200}「どういう事か‥\n說明してもらおう。",
  "tgt": "{框05}{立绘4200}「把事情的来龙去脉……\n说清楚吧。"
 },
 {
  "id": "016738",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「說明も、何も‥\n---\n帝国さんが、王女さんに‥\n来て欲しいって\n賴んだんですわ。",
  "tgt": "{框06}{立绘8141}「解释什么的‥\n---\n是帝国方面拜托的\n说想请王女\n过去的‥"
 },
 {
  "id": "016739",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框05}{立绘100F}「何だって！？\n---\nどうして、エリーナが\n敵の土地になんか\n行く必要があるんだっ！？",
  "tgt": "{框05}{立绘100F}「你说什么！？\n---\n艾莉娜为什么\n要去敌国的\n地盘！？"
 },
 {
  "id": "016740",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「知りまへんがな‥\n---\nそれより、あんたら‥",
  "tgt": "{框06}{立绘8141}「我怎么知道呀‥\n---\n比起那个，你们‥"
 },
 {
  "id": "016741",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「その王女さん、探すのに‥\n---\nワイに 協力してほしい\nっちゅうんと、ちがうんか？",
  "tgt": "{框06}{立绘8141}「找那位王女\n---\n不是要请我\n帮忙吗？"
 },
 {
  "id": "016742",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「それやったら\nもうちょっと‥\n---\nぎょうぎ良く せんと\nアカンのと、ちゃう？",
  "tgt": "{框06}{立绘8141}「那样的话\n就稍微‥\n---\n懂点规矩\n再来吧？"
 },
 {
  "id": "016743",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「ま、{码0B}そう言う事やったら\n手ェ、かしたらんでも\nないけど‥\n---\nその前に、ちょっと\n働いてもらおかな‥？",
  "tgt": "{框06}{立绘8141}「嘛，既然如此\n我也不必\n帮忙了‥\n---\n不过在那之前\n先请你们干点活‥？{码0B}そう言う事やったら\n手ェ、かしたらんでも\nないけど‥\n---\nその前に、ちょっと\n働いてもらおかな‥？"
 },
 {
  "id": "016744",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框05}{立绘0F0D}「あのう、{码0B}マーロックさん‥\n---\nお手伝いって、わたし\n何を‥{码0B}‥？",
  "tgt": "{框05}{立绘0F0D}「那个，马洛克先生‥\n---\n帮忙的话，我\n要做什么‥‥？{码0B}マーロックさん‥\n---\nお手伝いって、わたし\n何を‥{码0B}‥？"
 },
 {
  "id": "016745",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「なに‥\n---\n連中が‥、盗られた\nワイの商品を 取り返して\n来るまでの間‥\n---\nワイの、身の回りの\nお世話なんかを‥、な。",
  "tgt": "{框06}{立绘8141}「什么呀‥\n---\n在被那帮家伙\n抢走的商品\n找回来之前‥\n---\n先照顾好\n我的起居之类的‥"
 },
 {
  "id": "016746",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框02}{立绘8141}「‥{码0B}‥{码0B}なんやて！？\n---\nほんで、そのまま\nのこのこと、归ってきたんか？",
  "tgt": "{框02}{立绘8141}「‥‥什么！？\n---\n然后就那么\n大摇大摆地回来了？{码0B}‥{码0B}なんやて！？\n---\nほんで、そのまま\nのこのこと、归ってきたんか？"
 },
 {
  "id": "016747",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘4200}「話しが、ちがう‥！\n---\n{立绘110F}先に 悪どい事を\nしたのは、そっちが‥{引5800}",
  "tgt": "{立绘4200}「你说得不对……！\n---\n{立绘110F}先干\n龌龊事的\n是你们……{引5800}"
 },
 {
  "id": "016748",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框02}{立绘8141}「あほか！\n---\nなんぼで 買うても\nワイの物は、ワイの物や‥\n---\n取り戻すんは、当たり前と\n違いまっか‥！？",
  "tgt": "{框02}{立绘8141}「笨蛋！\n---\n就算买回来\n我的东西还是我的‥\n---\n夺回来是\n理所当然的吧‥！？"
 },
 {
  "id": "016749",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框02}{立绘8141}「‥まあ、ええ。",
  "tgt": "{框02}{立绘8141}「‥嘛，算了。"
 },
 {
  "id": "016750",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框02}{立绘8141}「ほな、次は‥\nアタマ使わんでも ええ仕事\nしてもらいましょ‥",
  "tgt": "{框02}{立绘8141}「那么，接下来‥\n干点不用\n动脑子的活吧‥"
 },
 {
  "id": "016751",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框05}{立绘0F0D}「あのう、マーロックさん‥\n---\nわたしは、何を‥‥？",
  "tgt": "{框05}{立绘0F0D}「那个，马洛克先生‥\n---\n我要，做什么‥‥？"
 },
 {
  "id": "016752",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「そやな、とりあえず\n{队员01}はんには‥\n---\nワイのカタでも もんで\nもらいます。",
  "tgt": "{框06}{立绘8141}「这样吧，总之\n先请{队员01}兄‥\n---\n帮我揉揉\n肩膀吧。"
 },
 {
  "id": "016753",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}「んー‥\nカタは もうええわ‥\n---\n次は‥ 足を\nもんでくれまっか？",
  "tgt": "{立绘8141}「嗯～‥\n肩不用揉了‥\n---\n接下来‥帮我\n揉揉脚吧？"
 },
 {
  "id": "016754",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}「よっしゃ、{队员01}はん\n足の次は‥\n---\nコシの方も もんで\nもらいましょか？",
  "tgt": "{立绘8141}「好嘞，{队员01}兄\n揉完脚‥\n---\n腰部也要\n揉揉吧？"
 },
 {
  "id": "016755",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「あー‥\nあちこち もんでもろて\nええ具合や‥\n---\nどや、{队员01}はん\n疲れましたか？",
  "tgt": "{框06}{立绘8141}「啊——‥\n这里那里都揉过\n真舒坦呀‥\n---\n怎么样，{队员01}兄\n累了吗？"
 },
 {
  "id": "016756",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框05}{立绘0F0D}「え、{码0B}あ‥ はい‥？",
  "tgt": "{框05}{立绘0F0D}「诶，啊‥是‥？{码0B}あ‥ はい‥？"
 },
 {
  "id": "016757",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「そーでっか！\nほなら‥‥\n---\n今度は、ワイが\n{特效}もんで{码0E}{/特效}{道具5E98}まひょ！",
  "tgt": "{框06}{立绘8141}「这就对啦！\n那么接下来‥\n---\n这回换我来\n揉{特效}吧！{码0E}{/特效}{道具5E98}まひょ！"
 },
 {
  "id": "016758",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘120D}「マーロックさんに 協力して\n早く、姉さまを\n探しに行きましょう‥！",
  "tgt": "{立绘120D}「配合马洛克先生\n早点去找\n姐姐吧‥！"
 },
 {
  "id": "016759",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0101}「遊んでんと、盗賊を\n探しなはれ‥\n---\nまずは、町の連中に\n話しを闻いたら、よろし。",
  "tgt": "{立绘0101}「别光顾着玩\n快去找盗贼呀‥\n---\n先去问问\n镇上的家伙们就行。"
 },
 {
  "id": "016760",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘4100}「盗賊あいてですから\n気をつけて下さいね。",
  "tgt": "{立绘4100}「对方是盗贼\n请千万小心哦。"
 },
 {
  "id": "016761",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0101}「盗賊 見つけたら\n早よ、追いかけなはれ！\n---\n何しとるんや、ホンマ‥",
  "tgt": "{立绘0101}「找到盗贼\n就赶紧追呀！\n---\n你在磨蹭什么呀，真是的‥"
 },
 {
  "id": "016762",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0F0D}「その人‥、盗賊じゃ\nなかったから‥\n---\n逃がしてあげて\n良かったと 思います。",
  "tgt": "{立绘0F0D}「那人‥\n不是盗贼\n---\n放他走\n我觉得是对的。"
 },
 {
  "id": "016763",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0101}「今度の仕事は\nあほでも できます‥\n---\n砂船のさんばしに\n行ってきなはれ。",
  "tgt": "{立绘0101}「这次的活\n傻瓜都会干‥\n---\n去沙船的\n码头吧。"
 },
 {
  "id": "016764",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘4100}「もも‥、もま‥{码0B}もみ‥\n---\n{立绘130D}な、{码0B}何でもないです\nへいきです！",
  "tgt": "{立绘4100}「按……按……{码0B}按摩……\n---\n{立绘130D}不，{码0B}没什么\n没事的！"
 },
 {
  "id": "016765",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0101}「ええ仕事したら\nおだちん、あげまっせ。",
  "tgt": "{立绘0101}「活干得漂亮\n赏钱，照给。"
 },
 {
  "id": "016766",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0808}「まん中の 箱の中身‥\n気になりませんか？",
  "tgt": "{立绘0808}「正中间箱子里的\n东西‥不想看看吗？"
 },
 {
  "id": "016767",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0A0A}「てへー‥\n---\nおうじょさまに\nあえたぁ？",
  "tgt": "{立绘0A0A}「嘿嘿——‥\n---\n见到\n王女大人了吗？"
 },
 {
  "id": "016768",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0C0C}「ちょっと、チノ\n待ちなさいったら‥！",
  "tgt": "{立绘0C0C}「千乃，说了\n等一下呀‥！"
 },
 {
  "id": "016769",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0909}「ぷぅ‥！\n---\n先生、アタシとも\n遊んでよぉ！",
  "tgt": "{立绘0909}「噗呜‥！\n---\n老师，也陪我\n玩嘛——！"
 },
 {
  "id": "016770",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0404}「チノったら‥\n---\nああやって\nマシィ先生の\n気をひいてるのよ。",
  "tgt": "{立绘0404}「千乃这家伙‥\n---\n就是用这招\n吸引玛希老师\n注意的呢。"
 },
 {
  "id": "016771",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0E0E}「バババババイーン！",
  "tgt": "{立绘0E0E}「拜拜拜拜拜——！"
 },
 {
  "id": "016772",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "「上に泊ってる商人‥\n---\nまさか、このまま\nいすわるつもりじゃ\nないよな‥？",
  "tgt": "「楼上住的商人‥\n---\n该不会打算\n就这样赖着\n不走吧‥？"
 },
 {
  "id": "016773",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0202}{金钱00}「店は かりモンやけど‥\n売りモンは そろってるで！{码14840C94}何か買う\n持ち物を売る\n下取りしてもらう\nやめておく",
  "tgt": "{立绘0202}{金钱00}「店虽然是租的……\n货可是齐全的！{码14840C94}买点什么\n卖掉身上的东西\n折价回收\n这次算了"
 },
 {
  "id": "016774",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0606}「誰か、一人足りない\n気がするの‥？",
  "tgt": "{立绘0606}「总觉得\n少了一个人‥？"
 },
 {
  "id": "016775",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{框21}子供たちは、町の中の\nどこかに かくれています。\n---\n子供たちに、話しかけると\n見つけた事になります‥\n---\n時々、この部屋に戻って\n子供たちの数を\n確認しましょう‥！",
  "tgt": "{框21}孩子们藏在\n镇子的某处。\n---\n跟孩子们搭话\n就算找到了‥\n---\n时常回到这个房间\n确认孩子们\n的数量吧‥！"
 },
 {
  "id": "016776",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0707}「エリーナ様から\nもらった\nわたしの {色03}宝物{/色}‥\n---\nお兄ちゃん達なら\nとっかえて\nあげても いいよ？{码14000C92}取り替えよう！\nやめておこう‥",
  "tgt": "{立绘0707}「这是艾莉娜大人\n送我的\n{色03}宝物{/色}……\n---\n如果是大哥哥们\n换给我\n也不是不行哟？{码14000C92}交换吧！\n还是算了……"
 },
 {
  "id": "016777",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘FFFF}\n {色03}{占位01}{/色}と 取り替えた！\n---\n",
  "tgt": "{立绘FFFF}\n换成了{色03}{占位01}{/色}！\n---\n"
 },
 {
  "id": "016778",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0707}「大事にしてね！",
  "tgt": "{立绘0707}「要好好珍惜哟！"
 },
 {
  "id": "016779",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0707}「みんなには\nナイショだけど‥\n---\nわたし、エリーナ様から\nとっても ステキな{色03}宝物{/色}\nもらったんだ！",
  "tgt": "{立绘0707}「虽然对大家\n是秘密‥\n---\n我从艾莉娜大人那儿\n得到了超棒的\n宝物哟！{色03}宝物{/色}\nもらったんだ！"
 },
 {
  "id": "016780",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "「前の ようじんぼうは\n女、子供あいてに\n負けたらしいが‥\n---\n俺は、ちがうぞ\nためしてみるか？{码14010C92}ためしてみよう！\nいえいえそんな‥",
  "tgt": "「听说上一位卫兵\n输给了女人\n孩子‥\n---\n我可不一样\n要试试吗？要试试！\n不不，算了‥{码14010C92}ためしてみよう！\nいえいえそんな‥"
 },
 {
  "id": "016781",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "「けろろろ‥\n元気があって\nけっこう けっこう！",
  "tgt": "「呱呱呱‥\n有精神\n很好很好！"
 },
 {
  "id": "016782",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "「けろろろ‥\n素直なところが\nけっこう けっこう！",
  "tgt": "「呱呱呱‥\n很听话\n很好很好！"
 },
 {
  "id": "016783",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "「お客人かい‥？\n---\nマーロックさんなら\n戻ってきてるぜ。",
  "tgt": "「是客人吗‥？\n---\n马洛克先生的话\n已经回来了哟。"
 },
 {
  "id": "016784",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{金钱00}「はい、いらっしゃい。\nおとまりなら\n{占位00}ゼニーですけど‥？{码14860C93}とまる\n旅の記錄をする\nやめておく",
  "tgt": "{金钱00}「好，欢迎光临。\n住店的话\n{占位00}泽尼……？{码14860C93}住下\n只记录旅程\n还是算了"
 },
 {
  "id": "016785",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "「すまないね‥\nお金 足りないよ。",
  "tgt": "「很抱歉‥\n钱不够哟。"
 },
 {
  "id": "016786",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}リタ\n「‥エリーナさまのゆくえは\nわかりましたか？\n---\n旅のお役に立ちたいのですが\nここをはなれるわけには\nまいりません。\n---\nよければ、私の持っている\nいくつかの知しきを\nお分けしましょうか？{码14820C92}お願いします\nまたの機会に",
  "tgt": "{立绘0000}莉塔\n「……艾莉娜大人\n的下落\n打听清楚了吗？\n---\n虽然想帮上旅途的忙\n但我不能\n离开这里。\n---\n愿意的话\n就把我知道的\n一些知识分给你们吧？{码14820C92}拜托了\n下次有机会吧"
 },
 {
  "id": "016787",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}‥‥どうやら心の用意は\nできているようですね。\n---\nまずは{色04}かばう{/色}心を\n教えましょう。\n---\nたすけあう気持ちがあれば\nきっと すくわれることが\nあるはずです。",
  "tgt": "{立绘0000}……看来你们\n在心里已经准备好了。\n---\n那就先教你\n{色04}掩护{/色}之心吧。\n---\n只要心怀互助\n就一定能在危难中\n得到救赎。"
 },
 {
  "id": "016788",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}‥戦いは心を\nひへいさせます。\n---\n旅につかれたら\nまた この子たちに\n会いに来てください。",
  "tgt": "{立绘0000}……战斗\n会让心变得冰冷。\n---\n旅途累了的话\n请再来\n见见这些孩子。"
 },
 {
  "id": "016789",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}‥それではまずは\nこの{色04}かばう{/色}を\n教えましょう。\n---\n{码0B}{码0B}‥あら‥？\n---\nどうもこれを身につける\n心の用意が、\n---\nまだ誰にも\nないようです。\n---\nすなおな心\nものを大切にする心、\n---\n{色04}けんやく{/色}の心を\n身につけてから\nふたたび来てください。",
  "tgt": "{立绘0000}……那就先教\n这招{色04}掩护{/色}\n吧。\n---\n{码0B}{码0B}……哎呀……？\n---\n学会这个所需的\n心境……\n---\n你们谁\n都还不具备。\n---\n坦率的心\n珍惜事物的心……\n---\n等学会{色04}节俭{/色}之心后\n请再来\n一次吧。"
 },
 {
  "id": "016790",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}もとめるのではなく\nあたえること。\n---\nその心があなたたちを\nみちびくと\n信じています。",
  "tgt": "{立绘0000}不求索取\n而讲给予。\n---\n我相信这份心\n会指引\n你们前行。"
 },
 {
  "id": "016791",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}リタ\n「これは\nひさしぶりです。\n---\nこどもたちにはもう、\n会ってくれましたか。\n---\nとにかく、あなたたちを\nかんげいします。",
  "tgt": "{立绘0000}莉塔\n「哎呀\n好久不见。\n---\n孩子们\n你们见过了吗。\n---\n总之\n欢迎你们。"
 },
 {
  "id": "016792",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}‥だいぶ無理な旅を\nしたようですね。\n---\nせめてもの かわりに\n私の知っている知しきを\nおゆずりします。\n---\nこの{色03}{占位01}{/色}を\n役立ててください。",
  "tgt": "{立绘0000}……看来这段旅途\n相当辛苦呢。\n---\n作为补偿\n就把我所知的\n知识传给你们。\n---\n请好好\n利用这招{色03}{占位01}{/色}吧。"
 },
 {
  "id": "016793",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}旅はまだまだ\n長引きそうですか？\n---\n強くなる分だけ\n人は傷つきやすくなることも\nあります。\n---\nまたいつでも\nたずねてきてください。",
  "tgt": "{立绘0000}旅途看样子\n还长着呢？\n---\n人越变强\n有时也越容易\n受到伤害。\n---\n随时\n都可以再来找我。"
 },
 {
  "id": "016794",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}‥とうとうこれで\n私の持っている知しきは\nみんな教えてしまいました。\n---\nあとにできることは\nあたたかく\n迎えることくらいです。\n---\n旅につかれたら\nいつでもおこしください。",
  "tgt": "{立绘0000}……到此为止\n我知道的知识\n已经全教给你们了。\n---\n接下来我能做的\n就只剩\n热情地迎接了。\n---\n旅途累了的话\n随时请来。"
 },
 {
  "id": "016795",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}何かしてほしいことは\nありますか？{码14820C93}教えをこいたい\n自分のことは自分でやります\n何でもないです",
  "tgt": "{立绘0000}有什么想\n拜托的事吗？{码14820C93}想求教\n自己的事自己做\n没什么事"
 },
 {
  "id": "016796",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}他にもありますか？{码14820C93}教えをこいたい\n自分のことは自分でやります\n何でもないです",
  "tgt": "{立绘0000}还有别的吗？{码14820C93}想求教\n自己的事自己做\n没什么事"
 },
 {
  "id": "016797",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}‥‥みんなすでに\n教えていますが？",
  "tgt": "{立绘0000}……全都\n已经教过了呀？"
 },
 {
  "id": "016798",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}‥では{占位02}に\n{色04}かばう{/色}心を教えます。\n---\nがんばってください。",
  "tgt": "{立绘0000}……那就教{占位02}\n{色04}掩护{/色}之心。\n---\n请加油。"
 },
 {
  "id": "016799",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}‥では あなたたちに\n{色04}かばう{/色}心を教えます。\n---\nがんばってください。",
  "tgt": "{立绘0000}……那就教你们\n{色04}掩护{/色}之心。\n---\n请加油。"
 },
 {
  "id": "016800",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}どうしたのですか？",
  "tgt": "{立绘0000}怎么了吗？"
 },
 {
  "id": "016801",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}‥今教えてる人は\nこの中には\n誰もいませんよ？",
  "tgt": "{立绘0000}……现在正在\n请教的人\n这里可一个都没有哟？"
 },
 {
  "id": "016802",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}‥人の力に賴ることに\nなれた人間は\n弱いものです。\n---\nだから{占位02}の\n気持ちは分かります。\n---\nただ、あまり無理は\nなさらないように\nして下さい。",
  "tgt": "{立绘0000}……习惯依赖\n他人之力的人\n是软弱的。\n---\n不过{占位02}的\n心情我明白。\n---\n只是请别\n太过于\n勉强自己。"
 },
 {
  "id": "016803",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}‥人の力に賴ることに\nなれた人間は\n弱いものです。\n---\nだから{占位02}の\n気持ちは分かります。\n---\nただ、あまり無理を\nなさらないように\nして下さい。",
  "tgt": "{立绘0000}……习惯依赖\n他人之力的人\n是软弱的。\n---\n不过{占位02}的\n心情我明白。\n---\n只是请别\n太过于\n勉强自己。"
 },
 {
  "id": "016804",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}‥どうしたのですか？",
  "tgt": "{立绘0000}……怎么了吗？"
 },
 {
  "id": "016805",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}旅はまだまだ\n長引きそうですか？\n---\n強くなる分だけ\n人は傷つきやすくなることも\nあります。\n---\nまたいつでも\nたずねてきてください。",
  "tgt": "{立绘0000}旅途看样子\n还长着呢？\n---\n人越变强\n有时也越容易\n受到伤害。\n---\n随时\n都可以再来找我。"
 },
 {
  "id": "016806",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0000}リタ\n「‥‥何かすくいを\nお求めですね？\n---\nあなたのような\n目をした人は\n見たことがないです。",
  "tgt": "{立绘0000}莉塔\n「……您在寻求\n救赎吗？\n---\n您这样的\n眼神的人\n我还从没见过。"
 },
 {
  "id": "016807",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "20",
  "tgt": "20"
 },
 {
  "id": "016808",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "25",
  "tgt": "25"
 },
 {
  "id": "016809",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "30",
  "tgt": "30"
 },
 {
  "id": "016810",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "35",
  "tgt": "35"
 },
 {
  "id": "016811",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "おいのり",
  "tgt": "祈祷"
 },
 {
  "id": "016812",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "神撃",
  "tgt": "神击"
 },
 {
  "id": "016813",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "大防御",
  "tgt": "大防御"
 },
 {
  "id": "016814",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "ベネディクション",
  "tgt": "祝祷"
 },
 {
  "id": "016815",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}マーロック\n「{码0B}‥また、\nあんさんたちかいな‥\n---\nそんなんで\nちゃんと旅\nしてはるんでっか？\n---\nふらふら遊んでんなら\nめずらしい宝でも\nさがしたら どないです？\n---\nいい宝見せてくれたら\n商売のしかたでも\n教えてあげまっせ？{码14820C92}宝を見てもらう\n見せない",
  "tgt": "{立绘8141}马洛克\n「‥又是\n你们几位呀‥\n---\n那副样子\n旅途\n还顺利吗？\n---\n要是整天闲晃\n不如找找\n稀罕宝物如何？\n---\n给我看件好宝\n就连做生意的\n门道也教你哟？拿宝物给看\n不给看{码0B}‥また、\nあんさんたちかいな‥\n---\nそんなんで\nちゃんと旅\nしてはるんでっか？\n---\nふらふら遊んでんなら\nめずらしい宝でも\nさがしたら どないです？\n---\nいい宝見せてくれたら\n商売のしかたでも\n教えてあげまっせ？{码14820C92}宝を見てもらう\n見せない"
 },
 {
  "id": "016816",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}{码0B}{码0B}おおっ！\n---\nあんさんの持っている\nこの宝‥\n---\nこれは、けっこう\nねうちもんでっせ。\n---\nこの色といい、ツヤといい\nヌメヌメした手ざわりといい\nまったく{码0B} たまりまへんわ。\n---\n{码0B}{码0B}‥‥いいもん\n見せてもらいました。\n---\nお礼に\nこの{色04}よくばり{/色}\n教えてあげましょ。\n---\nワイのような金持ちに\nなるための\n基本マインドでっせ。",
  "tgt": "{立绘8141}{码0B}{码0B}哦哦！\n---\n您手里的\n这件宝贝……\n---\n可是相当\n值钱的货哟。\n---\n这色泽，这光泽\n这滑溜溜的手感\n实在{码0B} 让人爱不释手哇。\n---\n{码0B}{码0B}……让我\n大开了眼界。\n---\n作为答谢\n就把这招{色04}贪心{/色}\n教给你吧。\n---\n这是想变成\n我这样的有钱人\n的基本心态哟。"
 },
 {
  "id": "016817",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}めずらしいお宝\nどんどん持ってきてや。\n---\n{色02}{占位00}{/色}以上の\nものが手に入ったら、\n---\nまた何か\n教えてあげますわ。",
  "tgt": "{立绘8141}稀奇的宝贝\n尽管多拿来吧。\n---\n要是弄到了\n比{色02}{占位00}{/色}\n更好的东西……\n---\n我再教你\n点别的。"
 },
 {
  "id": "016818",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}{码0B}{码0B}‥まるでガラクタやな。\n---\n目ぇ、よごされたから\nはんたいに おだちん\nもらいたいくらいですわ。\n---\nせめて\n{色02}{道具2205}{/色}くらいは\n手に入れんと。",
  "tgt": "{立绘8141}{码0B}{码0B}……简直是破烂。\n---\n我的眼睛\n都被弄脏了\n反而想收你\n看货费呢。\n---\n至少\n弄个{色02}{道具2205}{/色}\n来再说吧。"
 },
 {
  "id": "016819",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}お金と時間をムダにしたら\nあきまへん。\n---\nこれ、商売だけでなく\n人生の基本でっせ。",
  "tgt": "{立绘8141}浪费钱和时间\n可不行呀。\n---\n这不仅是做生意\n也是人生的基本哟。"
 },
 {
  "id": "016820",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}マーロック\n「{码0B}‥またですか？\n---\nなんかいいお宝でも\n手に入れたんでっか？\n---\nまっ、いそがしい身やけど\n話あいてくらいなら\nなってあげますわ。",
  "tgt": "{立绘8141}马洛克\n「‥又来了？\n---\n是不是淘到什么\n好宝物啦？\n---\n嘛，我虽然忙\n陪你聊聊\n倒也无妨。{码0B}‥またですか？\n---\nなんかいいお宝でも\n手に入れたんでっか？\n---\nまっ、いそがしい身やけど\n話あいてくらいなら\nなってあげますわ。"
 },
 {
  "id": "016821",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}{码0B}‥ほほう\nこれまた、めずらしい\n一品ですな‥\n---\nなるほど、なるほど‥\n---\n{码0B}‥ははーん‥\nふむむ‥‥\nほう‥‥\n---\n{码0B}{码0B}‥これは、あんさん\nまさにお宝中の\nお宝でっせ！\n---\nいいでしょう！\nこの{色03}{占位01}{/色}\n教えてあげますわ！",
  "tgt": "{立绘8141}{码0B}‥嚯嚯\n这又是件\n稀罕货呀‥\n---\n原来如此，原来如此‥\n---\n‥哈哈——\n嗯嗯‥‥\n哦——‥\n---\n‥这可是你们\n宝中宝的\n宝物哟！\n---\n那好！\n这件{码0B}\n就教给你们！{码0B}{码0B}‥これは、あんさん\nまさにお宝中の\nお宝でっせ！\n---\nいいでしょう！\nこの{色03}{占位01}{/色}\n教えてあげますわ！"
 },
 {
  "id": "016822",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}めずらしいお宝\nどんどん持ってきてや。\n---\n{色02}{占位00}{/色}以上の\nものを見せてくれたら、\n---\nまた何か\n教えてあげますわ。",
  "tgt": "{立绘8141}稀奇的宝贝\n尽管多拿来吧。\n---\n要是能拿出\n比{色02}{占位00}{/色}\n更好的东西……\n---\n我再教你\n点别的。"
 },
 {
  "id": "016823",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}{码0B}‥今教えた\n{色03}{道具9604}{/色}で\nワイはもう、品切れですわ。\n---\nそれにしても\nあんさんたち‥\n---\nなかなかホネのある\n人間ですわ。\n感心しました。\n---\n旅を終えたら\n商売のイロハ、\n---\nワイが直に\n教えてあげます。",
  "tgt": "{立绘8141}{码0B}‥刚教的\n{色03}{道具9604}{/色}\n我已经倾囊相授了。\n---\n话说回来\n你们几位‥\n---\n还真是\n有骨气的人呀。\n佩服佩服。\n---\n旅途结束后\n生意的门道‥\n---\n我亲自\n教给你们。"
 },
 {
  "id": "016824",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}で、どないしたいんです？{码14820C93}教えてほしい\nやめます\n何でもないです",
  "tgt": "{立绘8141}那么，想怎么样？想学\n不学了\n没什么{码14820C93}教えてほしい\nやめます\n何でもないです"
 },
 {
  "id": "016825",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}他にもあるんちゃいます？{码14820C93}教えてほしい\nやめます\n何でもないです",
  "tgt": "{立绘8141}还有别的吧？想学\n不学了\n没什么{码14820C93}教えてほしい\nやめます\n何でもないです"
 },
 {
  "id": "016826",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}{码0B}‥みんなワイから\nならってますよ。",
  "tgt": "{立绘8141}{码0B}‥大家都在\n跟我学哟。"
 },
 {
  "id": "016827",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}{码0B}ほなら{占位02}に\n{色04}よくばり{/色}教えたげます。\n---\nはげんでや。",
  "tgt": "{立绘8141}{码0B}那就教{占位02}\n{色04}贪心{/色}吧。\n---\n好好努力哟。"
 },
 {
  "id": "016828",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}{码0B}ほなら あんたたちに\n{色04}よくばり{/色}教えたげます。\n---\nはげんでや。",
  "tgt": "{立绘8141}{码0B}那就教你们\n{色04}贪心{/色}吧。\n---\n好好努力哟。"
 },
 {
  "id": "016829",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}誰もいないんでっか？\n時間のムダづかいは\nゴメンでっせ。",
  "tgt": "{立绘8141}一个人都没有吗？\n浪费时间\n我可拒绝哟。"
 },
 {
  "id": "016830",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}{码0B}‥誰もワイから\nならってまへんで。",
  "tgt": "{立绘8141}{码0B}‥没有人在\n跟我学呀。"
 },
 {
  "id": "016831",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}{码0B}ほなら{占位02}は\nもう、他人やな。",
  "tgt": "{立绘8141}{码0B}那{占位02}\n就算外人了。"
 },
 {
  "id": "016832",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}{码0B}ほなら あんたたちは\nもう他人やな。",
  "tgt": "{立绘8141}{码0B}那你们\n就算外人了。"
 },
 {
  "id": "016833",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}‥どうしたんでっか？\n時間のムダづかいは\nゴメンでっせ。",
  "tgt": "{立绘8141}‥怎么了？\n浪费时间\n我可拒绝哟。"
 },
 {
  "id": "016834",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}宝、さがしなはれ。\n---\n{色02}{占位00}{/色}以上の\nものを見せてくれたら、\n---\nまた何か\n教えてあげますわ。",
  "tgt": "{立绘8141}快去找宝贝吧。\n---\n要是能拿出\n比{色02}{占位00}{/色}\n更好的东西……\n---\n我再教你\n点别的。"
 },
 {
  "id": "016835",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘8141}マーロック\n「‥‥なんです？\n---\nようじんぼうなら\n今は ぼしゅうして\nないですよ？",
  "tgt": "{立绘8141}马洛克\n「‥‥什么事？\n---\n卫兵的话\n现在可没在\n招募哟？"
 },
 {
  "id": "016836",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "フダつきのお宝",
  "tgt": "带牌宝物"
 },
 {
  "id": "016837",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "生え抜きのお宝",
  "tgt": "嫡传宝物"
 },
 {
  "id": "016838",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "お宝の中のお宝",
  "tgt": "宝中宝"
 },
 {
  "id": "016839",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "おまじない",
  "tgt": "咒语"
 },
 {
  "id": "016840",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "ひとりじめ",
  "tgt": "独占"
 },
 {
  "id": "016841",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "ルーレット",
  "tgt": "轮盘"
 },
 {
  "id": "016842",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0404}「チノを しっかり\n見張ってなきゃ‥\n---\nだって、コノコ\nお姉さんだもん。",
  "tgt": "{立绘0404}「得好好\n盯住千乃才行‥\n---\n毕竟，这家伙\n是姐姐呀。"
 },
 {
  "id": "016843",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0C0C}「チノが なにかと\nごめいわくを\nおかけしました\n---\nエリーナ様に、早く\nお会い できるよう‥\n---\n旅のご無事を\nおいのりしています。",
  "tgt": "{立绘0C0C}「千乃给您\n添了\n种种麻烦‥\n---\n愿您早日\n见到艾莉娜大人‥\n---\n祝旅途\n平安无事。"
 },
 {
  "id": "016844",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0E0E}「チェ‥バビっと\n隱れたのになぁ\n---\nもっと、いい隱れ場所\n見つけなきゃ！",
  "tgt": "{立绘0E0E}「切‥明明藏得\n那么隐蔽\n---\n得找个更棒的\n藏身处！"
 },
 {
  "id": "016845",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0606}「チノを 待ってたら\nもっと\nおなかすいた。",
  "tgt": "{立绘0606}「等千乃的时候\n肚子\n又饿了。"
 },
 {
  "id": "016846",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0808}「王女様に 会ったら\nガッテが、よろしくと\nお伝えください。",
  "tgt": "{立绘0808}「见到王女大人\n请代加特\n问好。"
 },
 {
  "id": "016847",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0909}「あの見張りの人‥\n---\nやっぱり、おねえさんと\n話しこんでたんだ。",
  "tgt": "{立绘0909}「那个哨兵呀‥\n---\n果然在和\n大姐姐聊得火热呢。"
 },
 {
  "id": "016848",
  "file": "WORLD/AREAS046.EMI",
  "seg": 11,
  "src": "{立绘0A0A}「へへー、チノ\n見ぃつけたあ。",
  "tgt": "{立绘0A0A}「嘿嘿——，千乃\n被抓到啦。"
 },
 {
  "id": "016849",
  "file": "WORLD/AREAS047.EMI",
  "seg": 11,
  "src": "にーなたちがるでぃあで\nあてがわれるへや。",
  "tgt": "妮娜她们在鲁迪亚\n被安排的房间。"
 },
 {
  "id": "016850",
  "file": "WORLD/AREAS047.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「{队员00}‥、起きてた？",
  "tgt": "{框05}{立绘4100}「{队员00}……你醒着？"
 },
 {
  "id": "016851",
  "file": "WORLD/AREAS047.EMI",
  "seg": 11,
  "src": "{框05}{立绘C100}「なんだか、すっきりしない\n天気‥‥\n---\n{立绘8000}{队员02}兄さまの\n取り調べは‥\n---\nまだ、續いてるのかな‥",
  "tgt": "{框05}{立绘C100}「总觉得天气\n阴沉沉的………\n---\n{立绘8000}{队员02}哥哥的\n审问……\n---\n还在继续吗……"
 },
 {
  "id": "016852",
  "file": "WORLD/AREAS047.EMI",
  "seg": 11,
  "src": "{框05}{立绘4100}「ルディアのお城に\n行ってみません？\n---\n兄さまと、面会できるかも\nしれませんし‥",
  "tgt": "{框05}{立绘4100}「要不要去\n卢迪亚城看看？\n---\n说不定能\n和哥哥见面……"
 },
 {
  "id": "016853",
  "file": "WORLD/AREAS047.EMI",
  "seg": 11,
  "src": "{立绘C140}「あ、そうそう‥\nこちら、{队员03}さん。\n---\nわたしたちが 逃げないように\n見はる お役目の人です。",
  "tgt": "{立绘C140}「啊，对了‥\n这位是{队员03}。\n---\n是负责看守\n不让我们逃走的人。"
 },
 {
  "id": "016854",
  "file": "WORLD/AREAS047.EMI",
  "seg": 11,
  "src": "{立绘0100}「兄さまを おいて\n逃げるだなんて‥\n---\nできないんですけどね‥",
  "tgt": "{立绘0100}「丢下哥哥\n自己逃走……\n---\n这种事\n我们是做不出来的……"
 },
 {
  "id": "016855",
  "file": "WORLD/AREAS047.EMI",
  "seg": 11,
  "src": "{立绘4300}「み‥‥\n---\n見はる‥",
  "tgt": "{立绘4300}「看………\n---\n看哨……"
 },
 {
  "id": "016856",
  "file": "WORLD/AREAS047.EMI",
  "seg": 11,
  "src": "{立绘4500}「{队员05}が‥\nヒマだって 言ってます。",
  "tgt": "{立绘4500}「{队员05}说……\n她很闲。"
 },
 {
  "id": "016857",
  "file": "WORLD/AREAS047.EMI",
  "seg": 11,
  "src": "{立绘4300}「ど‥‥‥\n---\nどこ行く‥？\nおれ、ついて行く。",
  "tgt": "{立绘4300}「去…………\n---\n去哪儿……？\n我也去。"
 },
 {
  "id": "016858",
  "file": "WORLD/AREAS047.EMI",
  "seg": 11,
  "src": "\n   ここで夜を待ちますか？{码14000C82}はい\nいいえ",
  "tgt": "\n   要在这里等天黑吗？{码14000C82}是\n否"
 },
 {
  "id": "016859",
  "file": "WORLD/AREAS047.EMI",
  "seg": 11,
  "src": "{立绘4100}「さあ‥{码0B}‥{码0B}‥\n---\n行きましょう‥！",
  "tgt": "{立绘4100}「来……{码0B}……{码0B}……\n---\n走吧……！"
 },
 {
  "id": "016860",
  "file": "WORLD/AREAS047.EMI",
  "seg": 11,
  "src": "ここなら 休めそうだ‥{码148B0C93}休んでいく\n旅の記錄だけする\nやめておく",
  "tgt": "在这里似乎能休息‥休息一下\n只保存旅程记录\n算了{码148B0C93}休んでいく\n旅の記錄だけする\nやめておく"
 },
 {
  "id": "016861",
  "file": "WORLD/AREAS047.EMI",
  "seg": 11,
  "src": "{立绘0201}「運よく 部屋が空いて\n助かったわ‥\n---\n{金钱00}ま、それは さておき\n何か買うておくれ！{码14840C94}買い物をしよう\n何か売ろう\n武器を下取りしてもらおう\n今はやめておく",
  "tgt": "{立绘0201}「运气好，正好有空房\n真是帮大忙了……\n---\n{金钱00}嘛，闲话少说\n买点什么吧！{码14840C94}买点什么\n卖点什么\n武器折价回收\n这次算了"
 },
 {
  "id": "016862",
  "file": "WORLD/AREAS047.EMI",
  "seg": 11,
  "src": "{立绘0302}「ねー、闻いた？\nルディア城から\n逃げ出した、フーレンの族長‥\n---\n{立绘FFFF}{立绘8443}「そのまま\nウインディアまで\n逃げたんですってね！",
  "tgt": "{立绘0302}「喂，听说了吗？\n从鲁迪亚城\n逃出来的弗雷恩族长‥\n---\n{立绘FFFF}{立绘8443}「听说一路\n逃到温迪亚\n去了呢！"
 },
 {
  "id": "016863",
  "file": "WORLD/AREAS047.EMI",
  "seg": 11,
  "src": "{立绘0403}「ウワサだと、その族長を\n助け出したのが\nウインディア王女の‥\n---\n{立绘FFFF}{立绘8342}「いもうと なんでしょ！？\n王家って、スキャンダラスね！",
  "tgt": "{立绘0403}「据传闻，把那族长\n救出来的\n是温迪亚王女的‥\n---\n{立绘FFFF}{立绘8342}「妹妹对吧！？\n王家真是够八卦的呢！"
 },
 {
  "id": "016864",
  "file": "WORLD/AREAS047.EMI",
  "seg": 11,
  "src": "「かーちゃん\nハラへったあ‥",
  "tgt": "「妈——\n我肚子饿了呀‥"
 },
 {
  "id": "016865",
  "file": "WORLD/AREAS048.EMI",
  "seg": 8,
  "src": "みこのいえ",
  "tgt": "巫女之家"
 },
 {
  "id": "016866",
  "file": "WORLD/AREAS048.EMI",
  "seg": 8,
  "src": "{立绘0000}「いかにも、わしが\n風のみこじゃ‥\n---\n風竜ラーウィ様の\n声を闻くことが、できる。",
  "tgt": "{立绘0000}「没错，老夫\n就是风神官……\n---\n能听到风龙\n拉维大人的声音。"
 },
 {
  "id": "016867",
  "file": "WORLD/AREAS048.EMI",
  "seg": 8,
  "src": "{立绘0000}「ふーん、お主‥\nりっぱな竜眼じゃが‥\n---\nかたっぽだけじゃな\nめずらしい‥！",
  "tgt": "{立绘0000}「哦——，你……\n有一双出色的龙眼……\n---\n却只有一边\n真是稀奇……！"
 },
 {
  "id": "016868",
  "file": "WORLD/AREAS048.EMI",
  "seg": 8,
  "src": "{立绘0000}「竜眼を 持つ者が\nすべて、竜だと\n言うワケでは、ないが‥\n---\nこやつは、ラーウィ様に\n近い感じが、する‥",
  "tgt": "{立绘0000}「有龙眼的\n也不全\n是龙……\n---\n但这小子\n有种接近拉维大人的感觉……"
 },
 {
  "id": "016869",
  "file": "WORLD/AREAS048.EMI",
  "seg": 8,
  "src": "{立绘0000}「ラーウィ様に\n闻いたことが、ある‥\n---\nなんびゃく年かに、一度\nこの世界に、新たな竜‥\n---\n{色02}アルカイの竜{/色}と、呼ばれる\n竜が現れる、とな。",
  "tgt": "{立绘0000}「老夫\n听拉维大人说过……\n---\n每隔几百年\n这个世界就会\n出现一条新龙……\n---\n就是被称为\n{色02}阿尔凯之龙{/色}的龙。"
 },
 {
  "id": "016870",
  "file": "WORLD/AREAS048.EMI",
  "seg": 8,
  "src": "{立绘0000}「そして、アルカイの竜は‥\n---\n人に、強大な力を\n与えると 言われる‥",
  "tgt": "{立绘0000}「而阿尔凯之龙……\n---\n据说会赐予人\n强大的力量……"
 },
 {
  "id": "016871",
  "file": "WORLD/AREAS048.EMI",
  "seg": 8,
  "src": "{立绘0000}「わしに分かるのは\nここまでじゃ‥\n---\nあとは、お主が\nラーウィ様に、たずねれば\nよかろう‥",
  "tgt": "{立绘0000}「老夫知道的\n就只有这些了……\n---\n其余的\n你自己去问\n拉维大人吧……"
 },
 {
  "id": "016872",
  "file": "WORLD/AREAS048.EMI",
  "seg": 8,
  "src": "{立绘0000}「ウインディア城の\n地下どうくつで‥\n---\n『{道具0705}』を\n手に入れるんじゃ‥",
  "tgt": "{立绘0000}「去温蒂亚城的\n地下洞窟……\n---\n拿到\n『{道具0705}』吧……"
 },
 {
  "id": "016873",
  "file": "WORLD/AREAS048.EMI",
  "seg": 8,
  "src": "{立绘0000}「フエがあれば‥\n{色02}風の塔{/色}に、入る事が\nできる‥",
  "tgt": "{立绘0000}「只要有笛子……\n就能进入\n{色02}风之塔{/色}……"
 },
 {
  "id": "016874",
  "file": "WORLD/AREAS048.EMI",
  "seg": 8,
  "src": "{立绘C140}「あの、やはり{队员00}は\n竜‥なのでしょうか？",
  "tgt": "{立绘C140}「那个，{队员00}\n果然……是龙吗？"
 },
 {
  "id": "016875",
  "file": "WORLD/AREAS048.EMI",
  "seg": 8,
  "src": "{立绘C240}「帝国のねらいは\nその、アルカイの竜の\n力‥というわけか",
  "tgt": "{立绘C240}「帝国的目标\n就是那阿尔凯之龙的\n力量‥吗"
 },
 {
  "id": "016876",
  "file": "WORLD/AREAS048.EMI",
  "seg": 8,
  "src": "{立绘0000}「‥‥なんじゃ？",
  "tgt": "{立绘0000}「…………什么？"
 },
 {
  "id": "016877",
  "file": "WORLD/AREAS048.EMI",
  "seg": 8,
  "src": "{立绘0000}「{队员01}‥\n---\nいい名前じゃろ？\nわしが つけたんじゃよ\n元気にそだつようにね‥",
  "tgt": "{立绘0000}「{队员01}……\n---\n是个好名字吧？\n是老夫起的哟\n愿它健康长大呢……"
 },
 {
  "id": "016878",
  "file": "WORLD/AREAS048.EMI",
  "seg": 8,
  "src": "{立绘0000}「‥‥なんじゃ\n---\nもう わしに用は\nないじゃろ？",
  "tgt": "{立绘0000}「…………什么\n---\n你们没别的事\n要找老夫了吧？"
 },
 {
  "id": "016879",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「たいていばし」",
  "tgt": "「大帝桥"
 },
 {
  "id": "016880",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "{金钱00}「戦爭中に 帝国本土から\n運びこまれた武器だ‥\nどうだい？{码14840C94}何か買おう\n持ち物を売ろう\n武器を下取りしてもらおう\n今は用がない‥",
  "tgt": "{金钱00}「战争时从帝国本土\n运来的武器…\n怎么样？{码14840C94}买点什么\n卖点东西\n折卖武器\n现在不用…"
 },
 {
  "id": "016881",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「ここは、{色02}ハシビトの町{/色}‥\n---\n東と西をつなぐ 大帝橋を\n見張る兵隊の事を\nハシビトって 言うのさ。",
  "tgt": "「这里是{色02}桥民镇{/色}…\n---\n看守连接东西的\n大帝桥的兵\n被称作桥民。"
 },
 {
  "id": "016882",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「でっかい荷物が\n着いたって？\n---\nまた、マーロックの\nヤミ商品かな‥？",
  "tgt": "「说有大件货物\n运到了？\n---\n又是马洛克的\n黑市货吧‥？"
 },
 {
  "id": "016883",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "{金钱00}「いわゆる、横流し品だけど\n買うかい？{码14850C93}何か買おう\n持ち物を売ろう\n今は用がない‥",
  "tgt": "{金钱00}「所谓走私货\n要买吗？{码14850C93}买点什么\n卖点东西\n现在不用"
 },
 {
  "id": "016884",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「そういや、この前\n本土から来た 部隊が\nいたよなぁ‥\n---\n竜を探しに来たって\n言ってたけど‥",
  "tgt": "「说起来，前阵子\n有支本土来的\n部队哟‥\n---\n听说是来找\n龙的‥"
 },
 {
  "id": "016885",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「それより、もっと前に‥\n---\nすげぇ美人が\n西へ、渡って行っただろ？\n---\nあっちの方が 気になるよ。",
  "tgt": "「比起这个，更早之前‥\n---\n有个超正的美人\n朝西边渡过去了吧？\n---\n那边更让人在意呀。"
 },
 {
  "id": "016886",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「早く归って あの子に\n会いたいなあ‥\n---\n転送が終わってしまったら\n今度はいつ归れるか‥",
  "tgt": "「真想早点回去\n见那孩子呀‥\n---\n传送一结束\n下次就不知何时能回去了‥"
 },
 {
  "id": "016887",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「ひさしぶりに、大帝橋の\n転送装置が\n動くらしいんだ‥\n---\n何とか、このチャンスに\n本土へ 归りたいねぇ‥",
  "tgt": "「听说大帝桥的\n传送装置\n难得要启动了‥\n---\n说什么也要趁\n这个机会回本土去‥"
 },
 {
  "id": "016888",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「戦爭が 終わってから‥\n---\n転送装置は、めったに\n動かないからな‥",
  "tgt": "「自从战争结束‥\n---\n传送装置就很少\n启动过了‥"
 },
 {
  "id": "016889",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「ここが‥\n東と西の大陸を結ぶ\n{色02}大帝橋{/色}の、入り口だよ\n---\nところで、{码0B}知ってる‥？{码14000C82}はい\nいいえ",
  "tgt": "「这里…\n就是连接东西大陆的\n{色02}大帝桥{/色}入口…\n---\n话说，{码0B}知道吗…？{码14000C82}是\n否"
 },
 {
  "id": "016890",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「なんだ、知ってるのか‥\n---\nしかし こんな物を作った\n初代皇帝様ってのは\nたいしたお人だよな。",
  "tgt": "「什么嘛，原来你知道啊‥\n---\n不过能造出这种东西的\n初代皇帝陛下\n真是了不起的人物啊。"
 },
 {
  "id": "016891",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「大帝橋って、言うのは\n本当の 橋じゃなくって‥\n---\n魔法の力を 使って\n人や物を パッと\n転送する 装置なんだよ。",
  "tgt": "「所谓大帝桥‥\n并不是真正的桥‥\n---\n而是借助魔法之力\n把人和物嗖地一下\n传送过去的装置。"
 },
 {
  "id": "016892",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「新入りさんかい？\n---\nまあ、とりあえず\n休んでいきなよ{码14860C93}休む\n旅の記錄だけする\n今はやめておく",
  "tgt": "「是新来的吗？\n---\n嘛，总之先\n歇会儿吧休息\n只做旅途记录\n现在还是算了{码14860C93}休む\n旅の記錄だけする\n今はやめておく"
 },
 {
  "id": "016893",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「運ぶ荷物の 中身を\n少し、チョロまかして\n売ってるのさ‥\n---\n良い事じゃ ねえけどな。",
  "tgt": "「就是把运送的货物\n偷一点出来\n卖掉哟‥\n---\n虽然不是什么好事。"
 },
 {
  "id": "016894",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「誰だか知らんが\n大帝橋は 使えんぞ！",
  "tgt": "「不知道是谁干的\n大帝桥用不了啦！"
 },
 {
  "id": "016895",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「あ、隊長殿‥\n---\nひょっとして\n西へお戻りに\nなるんですか？",
  "tgt": "「啊，队长大人‥\n---\n您该不会\n是要回\n西边去吧？"
 },
 {
  "id": "016896",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "{立绘0000}「そのつもり{码0B}だが‥？",
  "tgt": "{立绘0000}「正有此意{码0B}…？"
 },
 {
  "id": "016897",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「でしたら、少し\nお待ちいただく事に\nなりますよ。",
  "tgt": "「那样的话\n就请您\n稍等片刻了。"
 },
 {
  "id": "016898",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「大帝橋の中で\n大暴れした者が\nおりまして‥\n---\n転送装置が、止められて\nしまって‥",
  "tgt": "「有人在大帝桥\n里面\n大闹了一场‥\n---\n传送装置\n被关掉了‥"
 },
 {
  "id": "016899",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「次は いつ動かせるのか\nまったく分からんのです。",
  "tgt": "「下次什么时候能启动\n完全不得而知。"
 },
 {
  "id": "016900",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「まったく、どこの\nバカか知らんが‥\n---\nおかげで ワシまで\n归れんじゃないか。",
  "tgt": "「真是的，不知道是\n哪里的蠢货‥\n---\n害得连老夫\n都回不去了。"
 },
 {
  "id": "016901",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「おお、{队员04}殿‥\n本国に報告かね？\n---\nふーむ‥‥\n---\nこれはまた、マズイ時に\n来たものだ‥",
  "tgt": "「哦，{队员04}阁下‥\n是向本国汇报吗？\n---\n嗯～‥‥\n---\n你来的可真不是\n时候啊‥"
 },
 {
  "id": "016902",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「おい、知ってるか？\n---\n砂漠の北の方には\n泥のない海ってのが\nあるんだと。",
  "tgt": "「喂，你知道吗？\n---\n听说沙漠的北边\n有一片\n没有泥的海哟。"
 },
 {
  "id": "016903",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「へえ、その海って‥\n---\n西の大陸にも\nつながってるのかねえ？",
  "tgt": "「哦～，那片海‥\n---\n和西边的大陆\n也相连着吗？"
 },
 {
  "id": "016904",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "{立绘0101}「西へ行きたいなぁ‥\nねえ？{码14010C92}うん、行きたい\nいや、別に",
  "tgt": "{立绘0101}「好想去西边呀‥\n对吧？嗯，想去\n不，倒也没有{码14010C92}うん、行きたい\nいや、別に"
 },
 {
  "id": "016905",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "{立绘0101}「だよね‥！\n---\nどうにか、西へ渡る方法は\nないかなぁ‥",
  "tgt": "{立绘0101}「我就说吧‥！\n---\n有没有什么办法\n能渡到西边去呢‥"
 },
 {
  "id": "016906",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "{立绘0101}「だよね。\n---\nふつうは、帝国なんかに\n用はないもんね。",
  "tgt": "{立绘0101}「是吧。\n---\n一般人跟帝国\n才没什么打交道呢。"
 },
 {
  "id": "016907",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「こ、これは隊長！\n---\n長旅 ごくろうさまで\nありました！",
  "tgt": "「队、队长！\n---\n长途跋涉\n您辛苦了！"
 },
 {
  "id": "016908",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「ん‥？\n転送装置が 動かないから‥\n---\n軍かんけい以外は ほとんど\nひきはらった はずだぞ‥",
  "tgt": "「嗯‥？\n传送装置动不了‥\n---\n军队相关人员以外\n应该都撤走了才对‥"
 },
 {
  "id": "016909",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「どうぞ、お通りください\n{码0B}{码0B}‥でも 大帝橋は\n使えませんよ？",
  "tgt": "「请进，请进\n‥不过大帝桥\n是用不了的哟？{码0B}{码0B}‥でも 大帝橋は\n使えませんよ？"
 },
 {
  "id": "016910",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「やあ、旅の人‥\n---\n東じゃ めずらしい\n{色03}{占位01}{/色}が\nあるんだが‥\n---\nあんたの 持ってる\n{色03}{占位00}{/色}と‥\nとっかえても いいぜ？{码14020C92}取り替える！\nやめておく‥",
  "tgt": "「哟，旅行的人…\n---\n有件东边少见\n的{色03}{占位01}{/色}…\n---\n想拿你手里\n的{色03}{占位00}{/色}\n换换吗？{码14020C92}交换！\n算了…"
 },
 {
  "id": "016911",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "{色03}{占位01}{/色}を 手に入れた！",
  "tgt": "{色03}{占位01}{/色}得到了"
 },
 {
  "id": "016912",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「どうよ、そんなお宝‥\n見た事ないだろ？",
  "tgt": "「怎么样，这种宝物‥\n没见过吧？"
 },
 {
  "id": "016913",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「あんた達、お宝に\nきょうみは‥{码0B}{码0B}ないみたいだな。",
  "tgt": "「你们对宝物\n好像‥没什么兴趣啊。{码0B}{码0B}ないみたいだな。"
 },
 {
  "id": "016914",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「誰だか知らんが\n大帝橋は 使えないよ‥",
  "tgt": "「不知道是谁干的\n大帝桥用不了‥"
 },
 {
  "id": "016915",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「ちょっと前に\nこの中で 大暴れした\n連中がいてね‥\n---\n転送装置を 止められて\nしまったんだよ‥",
  "tgt": "「不久前有一伙家伙\n在这里面\n大闹了一场‥\n---\n传送装置\n就被关掉了‥"
 },
 {
  "id": "016916",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「ああ、これは\n隊長さま‥\n---\nそんなワケでして、今は\n本土へ 戻れんですよ‥\n---\nまったく、どこのどいつが\nやらかしたのやら‥",
  "tgt": "「啊，这位是\n队长大人‥\n---\n就是这样，我们现在\n回不了本土呀‥\n---\n真是的，到底是\n哪个混蛋干的‥"
 },
 {
  "id": "016917",
  "file": "WORLD/AREAS049.EMI",
  "seg": 8,
  "src": "「まったく‥\n---\n誰が暴れたのか、知らんが\nいいメイワクだよ‥",
  "tgt": "「真是的‥\n---\n不知道是谁闹的\n净添乱‥"
 },
 {
  "id": "016918",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "はかもりのむら",
  "tgt": "守墓之村"
 },
 {
  "id": "016919",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "「おどろいた‥\n---\nお前達、海の方から\n来たのか‥！？",
  "tgt": "「吃惊呀‥\n---\n你们竟是从海上\n来的吗‥！？"
 },
 {
  "id": "016920",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "「ここは、コウシアって\nチンケな村‥\n---\nめったに 誰も来ねぇけど\n来たら、ウチにとめてやる‥\n---\n{金钱00}{占位00}ゼニーで、どうだ？{码14860C93}休んで行く\n記錄だけする\n今は用がない‥",
  "tgt": "「这里是考西亚\n这么个穷村子……\n---\n平时没什么人来\n来了就住我家吧……\n---\n{金钱00}{占位00}泽尼\n怎么样？{码14860C93}住下再走\n只记录旅程\n这次没事……"
 },
 {
  "id": "016921",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "「なんだ、カネ持って\nねえのか‥",
  "tgt": "「什么嘛，身上\n没钱呀‥"
 },
 {
  "id": "016922",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "「へへ‥\nめずらしい物が あんよ\n買っていかんかね‥？{码14840C94}何か買おう\n持ち物を売ろう\n武器を下取りしてもらおう\n今は用がない‥",
  "tgt": "「嘿嘿‥\n有稀罕玩意哟\n不买点走吗‥？买点什么吧\n卖点什么吧\n武器折价换购\n现在用不上‥{码14840C94}何か買おう\n持ち物を売ろう\n武器を下取りしてもらおう\n今は用がない‥"
 },
 {
  "id": "016923",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "「この間、商人が\nこの村に めずらしい物を\n探しに来てね‥\n---\nそれ以来、ここの連中\n商売っけが 出ちゃって‥",
  "tgt": "「前几天有商人\n来村里找\n稀罕玩意‥\n---\n从那以后，这里的家伙\n都做起生意瘾来了‥"
 },
 {
  "id": "016924",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "「ワシも、何か\n売り物に なりそうな\n物を、探そうかのぉ‥\n---\nエン·ジュの遺跡にでも\n行けば‥\n何か あるかのぉ‥",
  "tgt": "「老夫也去找找\n有没有什么\n能卖的东西吧‥\n---\n去恩朱遗迹\n那样的地方‥\n说不定有什么哟‥"
 },
 {
  "id": "016925",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "「遺跡は どこだって？\n---\n{色02}エン·ジュ{/色}の遺跡なら\nシヤン川の 手前を\n東に 行ったところだ。",
  "tgt": "「问遗迹在哪？\n---\n{色02}恩珠{/色}遗迹的话\n过了湘川\n往东走就到。"
 },
 {
  "id": "016926",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "「遺跡に、めずらしい\nお宝があるって？\n---\nうちの ジイさん\nみたいな事 言ってるよ‥",
  "tgt": "「说遗迹里有\n稀罕的宝物？\n---\n跟我家老爷子\n说的一样哟‥"
 },
 {
  "id": "016927",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "「へへ、いらっしゃ‥\nえ、ツボ‥？\n---\nたしかに、わしが作っとるが\nツボが 欲しいのかね？{码14000C82}はい\nいいえ",
  "tgt": "「嘿嘿，欢迎光……\n咦，陶罐……？\n---\n陶罐确实是老夫做的\n你想要？{码14000C82}是\n否"
 },
 {
  "id": "016928",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "「なんだ、そうかい。",
  "tgt": "「这样啊，原来如此。"
 },
 {
  "id": "016929",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "「なら、作ってやろう‥\n---\nただし 時間がかかるから\nまた後で 取りに来てくれ。",
  "tgt": "「那我给你做吧‥\n---\n不过要花点时间\n之后再来取吧。"
 },
 {
  "id": "016930",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "「まだ できてないよ\nまた後で 来てくれ。",
  "tgt": "「还没做好哟\n之后再来吧。"
 },
 {
  "id": "016931",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "「おまたせ、やっと\n出来上がったよ‥\n---\n{金钱00}それじゃあ、{占位00}ゼニーほど\nいただこうかな？{码14010C82}はい\nいいえ",
  "tgt": "「久等了\n总算做好了……\n---\n{金钱00}那就收你\n{占位00}泽尼\n怎么样？{码14010C82}是\n否"
 },
 {
  "id": "016932",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "「へへ、まいどあり！",
  "tgt": "「嘿嘿，多谢惠顾！"
 },
 {
  "id": "016933",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "「‥金持って、出直して\n来てくれ。",
  "tgt": "「‥带上钱\n再来吧。"
 },
 {
  "id": "016934",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "\n  {色03}{道具1405}{/色}を 手に入れた！",
  "tgt": "\n得到了{色03}{道具1405}{/色}！"
 },
 {
  "id": "016935",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "「あんたが 買ったツボ‥\nむかしは、タダで作って\nくれたんだけどね‥\n---\n商人が めずらしがって\n買っていくもんだから‥",
  "tgt": "「你买的罐子‥\n以前可是免费\n做的哟‥\n---\n都怪商人稀罕\n买走了它们‥"
 },
 {
  "id": "016936",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "「ほえー、まだそんな\nお宝が 眠っとったとは‥\n---\nもっと、よく探したら\nよかったのう‥。",
  "tgt": "「哦——，居然还有\n这种宝物睡着呢‥\n---\n早知道就\n好好找找了‥。"
 },
 {
  "id": "016937",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "「あの遺跡、金目の物は\nなかったろ？\n---\n村の連中が、みんな\n持ち出して 商人に\n売っちまったからな‥",
  "tgt": "「那遗迹，没什么\n值钱的东西吧？\n---\n村里的家伙们\n都搬出来\n卖给商人了嘛‥"
 },
 {
  "id": "016938",
  "file": "WORLD/AREAS050.EMI",
  "seg": 8,
  "src": "「へ‥？\n帝都は どっちだって？\n---\nさて、どっちだろう‥\nなんせ、イナカだから‥",
  "tgt": "「诶‥？\n帝都在哪个方向？\n---\n这个嘛，谁知道呢‥\n毕竟是乡下嘛‥"
 },
 {
  "id": "016939",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "きゃんぷよるいべんと\nM046 M047",
  "tgt": "营地夜晚事件\nM046M047"
 },
 {
  "id": "016940",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4200}「まず、ウインディアの\n城の地下で\n{色03}{道具0705}{/色}を 見つけて‥\n---\n次に、それを使って\n{色02}風の塔{/色}に\n入るんだったな‥",
  "tgt": "{立绘4200}「先在温迪亚\n城的地下\n找到{色03}{道具0705}{/色}…\n---\n然后用它\n进入{色02}风之塔{/色}\n没错…"
 },
 {
  "id": "016941",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘C140}「ええ‥\n---\n風の塔には、空高く\n上がるための 装置が\nあるんです。\n---\nその装置を 使えば\nラーウィ様に‥",
  "tgt": "{立绘C140}「嗯‥\n---\n风之塔里，有能\n升上高空的\n装置。\n---\n用那装置就能\n见到拉维大人‥"
 },
 {
  "id": "016942",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘C140}「あれ‥、ところで\n{队员03}さんは？",
  "tgt": "{立绘C140}「咦‥，话说\n{队员03}先生呢？"
 },
 {
  "id": "016943",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘8000}「あいつは‥\nルディアに、やとわれた\n見張りだ‥\n---\n俺達のことを、報せに\n行ったのかも しれない！？",
  "tgt": "{立绘8000}「那家伙…\n是卢迪亚雇的\n眼线…\n---\n说不定是去\n通风报信了！？"
 },
 {
  "id": "016944",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘8141}「そんな‥‥",
  "tgt": "{立绘8141}「怎么会‥‥"
 },
 {
  "id": "016945",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4200}「ともかく‥\n急いだほうが、良さそうだ。",
  "tgt": "{立绘4200}「总之…\n还是抓紧为妙。"
 },
 {
  "id": "016946",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4100}「{队员00}‥\nわたし達、ここで\n待ってます‥\n---\n気をつけて\n行ってきてくださいね。",
  "tgt": "{立绘4100}「{队员00}…\n我们在这里\n等着你…\n---\n路上小心\n早去早回哦。"
 },
 {
  "id": "016947",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘0101}「{队员00}！？",
  "tgt": "{立绘0101}「{队员00}！？"
 },
 {
  "id": "016948",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4500}「竜眼で オームを\nコントロール できますが‥\n---\nなれるまでは\n大変だろうって\n{队员05}、言ってます。",
  "tgt": "{立绘4500}「可以用龙眼\n操控巨鸟…\n---\n但熟练之前\n会很费劲\n{队员05}是这么说的。"
 },
 {
  "id": "016949",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘0101}「でも‥\n---\n步いて探すには\n黄金平野は 大きすぎます‥\n---\n今は、なんとか\n{队员00}に\nがんばってもらうしか‥",
  "tgt": "{立绘0101}「可是…\n---\n步行去找的话\n黄金平原太大了…\n---\n现在只能\n拜托{队员00}\n加油了…"
 },
 {
  "id": "016950",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘0201}「‥{队员00}\nお願いしますね。",
  "tgt": "{立绘0201}「…{队员00}\n拜托了。"
 },
 {
  "id": "016951",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4300}「なぜ‥\n---\n何の得にも\nならない事を‥？",
  "tgt": "{立绘4300}「为什么…\n---\n去管毫无\n好处的事…？"
 },
 {
  "id": "016952",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4300}「そ‥、それで‥\n---\nうまく行くか、どうか‥\n---\n分から‥ないのに！？",
  "tgt": "{立绘4300}「而…、而且…\n---\n成不成…\n---\n都还不…知道！？"
 },
 {
  "id": "016953",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘C140}「得‥、は たしかに\n{立绘8241}ないのかも しれないですね‥",
  "tgt": "{立绘C140}「呃‥，确实\n{立绘8241}或许是没有呢‥"
 },
 {
  "id": "016954",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘C140}「それと‥\n---\nうまく行かないかも\nしれないから‥\n---\n何も しないって言うのは‥",
  "tgt": "{立绘C140}「还有‥\n---\n也许会\n不顺利‥\n---\n所以什么都不做‥"
 },
 {
  "id": "016955",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘C140}「よくないって‥\n---\n{立绘8341}そんな気がします。",
  "tgt": "{立绘C140}「总觉得‥\n---\n{立绘8341}不太妥当。"
 },
 {
  "id": "016956",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘C140}「{队员00}‥\n---\nもうすぐ\n{色02}ウインディア{/色}です。",
  "tgt": "{立绘C140}「{队员00}…\n---\n马上就到\n{色02}温迪亚{/色}了。"
 },
 {
  "id": "016957",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘C140}「私や エリーナ姉様は\nウインディアのお城で\n生まれ そだったんです‥",
  "tgt": "{立绘C140}「我和艾莉娜姐姐\n是在温迪亚的城里\n出生长大的‥"
 },
 {
  "id": "016958",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4200}「すまん、{队员01}‥\n---\nエリーナを\n見つけられないまま\n---\n逃げ归るようなコトに\nなってしまって‥",
  "tgt": "{立绘4200}「抱歉，{队员01}…\n---\n没能找到艾莉娜\n---\n却成了\n落荒而逃…"
 },
 {
  "id": "016959",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘8141}「‥{队员02}兄様が\nまた ルディアに捕まったら\n---\n今度こそ姉様を\n探せなくなってしまいます。",
  "tgt": "{立绘8141}「‥{队员02}哥哥要是\n再被卢迪亚抓住\n---\n就真的再也无法\n寻找姐姐了。"
 },
 {
  "id": "016960",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4200}「‥そうだな\n---\nウインディアに戻れば\n何か、新しい手がかりが\n見つかる 可能性もあるか。",
  "tgt": "{立绘4200}「…也是\n---\n回温迪亚的话\n或许还能找到\n新的线索。"
 },
 {
  "id": "016961",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘0402}「やっと 見つけたよう！",
  "tgt": "{立绘0402}「总算找到了哟！"
 },
 {
  "id": "016962",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘0402}「助けてよう、竜のヒト！\n---\nアタシたち 夢の世界に\nもどれたけど‥",
  "tgt": "{立绘0402}「救救我们哟，龙人！\n---\n我们虽然回到了\n梦的世界‥"
 },
 {
  "id": "016963",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘0402}「夢の世界に来て\n教えてよう‥！{码14000C12}教えてあげる\n教えてあげない",
  "tgt": "{立绘0402}「都到梦的世界了\n就教我吧哟…！{码14000C12}教给你\n不教"
 },
 {
  "id": "016964",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘0502}「そりゃ あんまりだよう\n---\nイジワルしないで\n教えてよう‥！{码14000C12}教えてあげる\n教えてあげない",
  "tgt": "{立绘0502}「那也太狠了哟\n---\n别使坏\n教给我哟…！{码14000C12}教给你\n不教"
 },
 {
  "id": "016965",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘0502}「ヒドイよう、せつないよう\n---\nそんなこと いわずに\n教えてよう‥！{码14000C12}教えてあげる\n教えてあげない",
  "tgt": "{立绘0502}「好过分哟，好难过哟\n---\n别说那种话\n教给我哟…！{码14000C12}教给你\n不教"
 },
 {
  "id": "016966",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘0602}「オニだよう、アクマだよう\n---\nおねがいだから\n教えてよう‥！{码14000C12}教えてあげる\n教えてあげない",
  "tgt": "{立绘0602}「是鬼哟，是魔哟\n---\n求求你\n教给我哟…！{码14000C12}教给你\n不教"
 },
 {
  "id": "016967",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘0702}「ほんと？\n---\nうれしいよう\nおねがいよう。",
  "tgt": "{立绘0702}「真的？\n---\n好高兴哟\n拜托了哟。"
 },
 {
  "id": "016968",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘0502}くらしかたが\nわかんないのよう‥！",
  "tgt": "{立绘0502}不知道\n怎么生活嘛‥！"
 },
 {
  "id": "016969",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4300}「‥{码0B}‥{码0B}‥",
  "tgt": "{立绘4300}「…{码0B}…{码0B}…"
 },
 {
  "id": "016970",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4500}「{队员05}だったら\nもっと 上手に\nオームに乘るって‥\n---\n{队员05}、言ってます。",
  "tgt": "{立绘4500}「{队员05}说\n换他来的话\n巨鸟骑得更好…\n---\n{队员05}是这么说的。"
 },
 {
  "id": "016971",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4100}「フーレンの里に\n戻って‥\n---\n長老さんたちに\n会いましょう。",
  "tgt": "{立绘4100}「回弗雷恩村…\n---\n去见\n长老们吧。"
 },
 {
  "id": "016972",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4100}「{道具0101}を\nもうひとつ‥？",
  "tgt": "{立绘4100}「{道具0101}\n再来一把…？"
 },
 {
  "id": "016973",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4100}「それで 兄さまへの\nおとがめを‥\n---\n少し、かるくできるかも\n知れないんですね‥！\n---\nありがとう、{队员00}！",
  "tgt": "{立绘4100}「这样兄长的\n处罚…\n---\n说不定就能\n减轻一点呢…！\n---\n谢谢你，{队员00}！"
 },
 {
  "id": "016974",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4100}「{色02}グーの火山{/色}の場所は\nフーレンの誰かが\n知ってるでしょうね‥",
  "tgt": "{立绘4100}「{色02}古之火山{/色}的位置\n弗雷恩的族人\n应该有人知道…"
 },
 {
  "id": "016975",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4100}「なら、いそいで\nフーレンの里に\n戻りましょう。",
  "tgt": "{立绘4100}「那就赶快\n回弗雷恩村吧。"
 },
 {
  "id": "016976",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘0803}{码0A}\n「ぴっぴき",
  "tgt": "{立绘0803}{码0A}\n「噼噼叽"
 },
 {
  "id": "016977",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4100}「おかえりなさい\n{队员00}‥‥\n---\n少し休んでいって\nくださいね。{码14860C93}休んで行こう\n旅の記錄だけしておこう\nまだがんばる",
  "tgt": "{立绘4100}「欢迎回来\n{队员00}……\n---\n休息一会儿\n再走吧。{码14860C93}休息一下\n只记录旅程\n继续努力"
 },
 {
  "id": "016978",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4500}「たくさん\n落っこちてきた？\n---\n‥と、{队员05}\nきいてます。",
  "tgt": "{立绘4500}「捡到\n好多东西了？\n---\n…{队员05}\n在问。"
 },
 {
  "id": "016979",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4300}「なぜ{码0B}‥{码0B}‥\n---\nがんばる{码0B}‥{码0B}？",
  "tgt": "{立绘4300}「为什么{码0B}…{码0B}…\n---\n要努力{码0B}…{码0B}？"
 },
 {
  "id": "016980",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "\n     どこへ行こうか？{码14010C93}黄金平野に出発する\n他のところへ行く\nどこにも行かない",
  "tgt": "\n要去哪里？出发去黄金平原\n去别处\n哪儿也不去{码14010C93}黄金平野に出発する\n他のところへ行く\nどこにも行かない"
 },
 {
  "id": "016981",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘C240}「この調子なら‥\n---\n明日には、捨てられた村に\n着けそうだな‥",
  "tgt": "{立绘C240}「照这个速度‥\n---\n明天应该就能到\n被遗弃的村庄了‥"
 },
 {
  "id": "016982",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘C240}「かくれてる 人達が\n帝国のやつらに‥\n---\n見つかって いなければ\nいいんだが‥",
  "tgt": "{立绘C240}「希望躲起来的\n人们‥\n---\n没被帝国的\n家伙们发现‥"
 },
 {
  "id": "016983",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{框02}{立绘0000}「{队员01}‥‥\n---\n{队员05}の事なら\nつめたい 言い方だと\n思うが‥‥\n---\nもともと、ただのヨロイ\nなのだし‥",
  "tgt": "{框02}{立绘0000}「{队员01}……\n---\n要我说{队员05}\n话说得\n是挺冷的……\n---\n毕竟它本来\n就只是副铠甲…"
 },
 {
  "id": "016984",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{框04}{立绘C140}「だったら、兄さま‥\n---\nわたしたちの 知っている\n{队员05}さんは‥\n---\n最初から、いなかったって\nことに なるんでしょうか？",
  "tgt": "{框04}{立绘C140}「那样的话，兄长大人‥\n---\n我们所认识的\n{队员05}先生‥\n---\n是不是从一开始\n就不存在呢？"
 },
 {
  "id": "016985",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{框04}{立绘8941}「そんなのって\nへんですよね‥",
  "tgt": "{框04}{立绘8941}「那样\n太奇怪了吧‥"
 },
 {
  "id": "016986",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{框04}{立绘C140}「あ、ごめんなさい‥\n---\n{立绘8241}今は、チェクの人達の事が\n先決ですよね‥",
  "tgt": "{框04}{立绘C140}「啊，对不起‥\n---\n{立绘8241}现在，切克的人们\n才是最要紧的‥"
 },
 {
  "id": "016987",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4200}「{队员01}‥\n感傷的に なっているようだ。\n---\n分からないでも、ないがな。",
  "tgt": "{立绘4200}「{队员01}…\n好像太多愁善感了。\n---\n也不是不能理解。"
 },
 {
  "id": "016988",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4100}「{队员05}さん、どこへ\n行ってしまったんでしょう‥\n---\n{立绘0901}わたし達が、死んでしまうのと\nどう違うんでしょうね‥",
  "tgt": "{立绘4100}「{队员05}先生\n到底去哪了呢…\n---\n{立绘0901}和我们死去\n又有什么区别呢…"
 },
 {
  "id": "016989",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4300}「せ‥\n---\n戦爭のときは‥\n---\nたくさん、死んだ‥\n---\n悲しむひまは‥\n無かった‥",
  "tgt": "{立绘4300}「战…\n---\n打仗的时候…\n---\n死了很多人…\n---\n连悲伤的\n工夫…都没有"
 },
 {
  "id": "016990",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "今日は、もう休もう‥",
  "tgt": "今天，先休息吧‥"
 },
 {
  "id": "016991",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘C440}「{队员00}だな‥？\n---\nフォウ帝国軍\n{队员04}だ‥",
  "tgt": "{立绘C440}「是{队员00}吧…？\n---\n福乌帝国军\n{队员04}…"
 },
 {
  "id": "016992",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘C440}「おまえが‥\nアルカイの竜で あるという\n調べは、ついている。\n---\n‥いっしょに、来てもらおう。",
  "tgt": "{立绘C440}「已查明‥\n你就是\n阿尔凯之龙。\n---\n‥请跟我们走一趟吧。"
 },
 {
  "id": "016993",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{框05}{立绘4200}「きさま達が、ここに\n来たと言う事は‥\n---\nやはり、かくれていた\n村人たちは‥\n見つかっていたか‥",
  "tgt": "{框05}{立绘4200}「你们来到这里\n就说明…\n---\n藏起来的\n村民果然…\n还是被找到了…"
 },
 {
  "id": "016994",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{框05}{立绘0000}「俺達のことを\n闻き出すのに‥\n---\n村人たちに\n手あらなマネを\nしたんじゃ ないだろうな！？",
  "tgt": "{框05}{立绘0000}「你们为了\n逼问我们的事…\n---\n该不会对\n村民下\n毒手了吧！？"
 },
 {
  "id": "016995",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘8A44}「何の話だ‥？",
  "tgt": "{立绘8A44}「在说什么‥？"
 },
 {
  "id": "016996",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{框05}{立绘0000}「とぼけるな‥\n---\n{队员05}に した事を\n見れば‥‥\n---\n{立绘0B00}きさま達が、どんな\n種類の人間かは、{码0B}分かる！",
  "tgt": "{框05}{立绘0000}「少装蒜…\n---\n看你们对\n{队员05}做过的事…\n---\n{立绘0B00}就知道你们\n是哪种货色，{码0B}一目了然！"
 },
 {
  "id": "016997",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{框05}{立绘4100}「この先の‥\n捨てられた村と、いう場所に‥\n---\nかくれている 人達が\nいるハズなんです‥",
  "tgt": "{框05}{立绘4100}「前面那个…\n叫废村的地方…\n---\n应该藏着\n一些人…"
 },
 {
  "id": "016998",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{框05}{立绘0101}「そこまで行って‥\n---\n村人の無事を\n確認させてください‥！",
  "tgt": "{框05}{立绘0101}「请让我们‥\n---\n去确认村民\n是否平安‥！"
 },
 {
  "id": "016999",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{框06}{立绘8141}「都に、現れたって\n魔物‥\n---\nもう一人の、{队员00}と\n関係あるんでしょうか？",
  "tgt": "{框06}{立绘8141}「帝都出现\n的那种魔物…\n---\n和另一个\n{队员00}有关系吗？"
 },
 {
  "id": "017000",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{框05}{立绘4200}「あるいは、{码0B}そうかもな‥\n---\nそれよりも‥‥",
  "tgt": "{框05}{立绘4200}「说不定，{码0B}还真有…\n---\n比起这个……"
 },
 {
  "id": "017001",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{框05}{立绘4200}「{队员04}隊長さんは\nどうして‥\n---\n俺達を 軍に\n突き出さない‥？\n---\n何か、たくらみでも\nあるのか‥？",
  "tgt": "{框05}{立绘4200}「{队员04}队长\n为什么不…\n---\n把我们扭送\n军中…？\n---\n是有什么\n企图吗…？"
 },
 {
  "id": "017002",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{框06}{立绘8A44}「ちょくせつ、命令をうけた\n將軍のもとへ\n向かっているだけだ‥\n---\nたくらみなど、ない。",
  "tgt": "{框06}{立绘8A44}「我只是奉命\n前往将军\n处而已‥\n---\n并无任何图谋。"
 },
 {
  "id": "017003",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{框05}{立绘0000}「それで、帝都へ‥？\n---\nしかし、都が壊滅したって\n話じゃないか‥\n---\nその將軍とやらも‥",
  "tgt": "{框05}{立绘0000}「所以，要去帝都…？\n---\n可是不是听说\n帝都毁了…\n---\n那位将军也…"
 },
 {
  "id": "017004",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{框06}{立绘8C45}「ルーン様が、かんたんに\n負けたり するものか！\n---\n帝都の軍本部で\n私を 待っていて下さる。",
  "tgt": "{框06}{立绘8C45}「鲁恩大人岂会\n轻易落败！\n---\n请到帝都军本部\n等我的消息。"
 },
 {
  "id": "017005",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4500}「{队员01}‥\nつらいのですか？",
  "tgt": "{立绘4500}「{队员01}…\n难过吗？"
 },
 {
  "id": "017006",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘8901}「どう‥、言ったら\nいいのか‥‥\n---\n姉さまのこと‥",
  "tgt": "{立绘8901}「该‥怎么\n说才好‥‥\n---\n姐姐的事‥"
 },
 {
  "id": "017007",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘8901}「前に、見つからなかった時‥\n---\nもう、あきらめようって\n言われて‥‥\n---\nでも‥、でも‥\n死んだって、闻かされたら‥",
  "tgt": "{立绘8901}「上次，找不到时‥\n---\n有人劝我说\n放弃吧‥‥\n---\n可是‥、可是‥\n若听到的是死讯‥"
 },
 {
  "id": "017008",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{框06}{立绘8D46}「{队员05}が‥\nディース様が、出て行った時‥\n---\nよく分かりませんが\nカラッポに なりましたよ‥\nけれど‥‥",
  "tgt": "{框06}{立绘8D46}「{队员05}‥\n蒂斯大人离开时‥\n---\n虽然不太明白\n它变得空空的‥\n不过‥‥"
 },
 {
  "id": "017009",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘8E01}「はげまして‥\nくれてるんですよね\n{队员05}さん‥？",
  "tgt": "{立绘8E01}「是在‥\n鼓励我吧\n{队员05}先生‥？"
 },
 {
  "id": "017010",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘8E01}「そうですね‥\n---\nわたしは、カラッポじゃ\nないですよね‥\n---\nみんなが いるもの、ね。",
  "tgt": "{立绘8E01}「是啊‥\n---\n我并不是\n空壳对吧‥\n---\n因为大家都在，对吧。"
 },
 {
  "id": "017011",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{框06}{立绘C440}「私が‥‥",
  "tgt": "{框06}{立绘C440}「我‥‥"
 },
 {
  "id": "017012",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{框06}{立绘C440}「私が、彼女でも‥\n---\nお前に 同じ事を\n賴んだと 思うぞ‥",
  "tgt": "{框06}{立绘C440}「我若是她‥\n---\n我想也会向你\n托付同样的事‥"
 },
 {
  "id": "017013",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘C440}「まちがった事は‥\n---\n{立绘8C45}していない、{码0B}と\n私は思う‥‥",
  "tgt": "{立绘C440}「你没有‥\n---\n{立绘8C45}做错，我是\n这么想的‥‥{码0B}と\n私は思う‥‥"
 },
 {
  "id": "017014",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘4300}「お‥‥\n---\n俺も、そう思う。",
  "tgt": "{立绘4300}「哦……\n---\n我也是这么想。"
 },
 {
  "id": "017015",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{立绘0402}「竜のヒト‥\n何か、あったの？\n---\n今日は、遊ばないよね。",
  "tgt": "{立绘0402}「龙人‥\n发生什么事了吗？\n---\n今天，不玩了吗。"
 },
 {
  "id": "017016",
  "file": "WORLD/AREAS051.EMI",
  "seg": 8,
  "src": "{框21}{打字02}ここから しばらく\n{队员00}の 一人旅です‥\n---\n仲間の {色03}スキル{/色}は\nまき物に 戻りました。",
  "tgt": "{框21}{打字02}从这里开始\n{队员00}将独自旅行一段…\n---\n伙伴的{色03}技能{/色}\n已收回卷轴。"
 },
 {
  "id": "017017",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "でんげき屋",
  "tgt": "电气铺"
 },
 {
  "id": "017018",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "{立绘0000}「いらはい いらはい\n宝くじ、買ってーな。",
  "tgt": "{立绘0000}「来吧来吧\n买张彩票嘛。"
 },
 {
  "id": "017019",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "{立绘0000}{金钱00}どうするんや？{码14820C94}宝くじを買う\n說明をきく\n買った宝くじを見る\nさよなら",
  "tgt": "{立绘0000}{金钱00}要怎么做？{码14820C94}买彩票\n听说明\n看已买的彩票\n再见"
 },
 {
  "id": "017020",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "{立绘0000}‥うん？\nにいちゃん、お金が\n足りないようやで。",
  "tgt": "{立绘0000}…嗯？\n大哥，你钱\n不够哟。"
 },
 {
  "id": "017021",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "{立绘0000}{码0B}‥残念やけど\nもう今回分は品切れや。",
  "tgt": "{立绘0000}{码0B}…很遗憾\n这一期的卖完了。"
 },
 {
  "id": "017022",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "{立绘0000}宝くじのナンバーを決めてや。",
  "tgt": "{立绘0000}决定彩票的号码吧。"
 },
 {
  "id": "017023",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "{立绘0000}これでええんか？{码14820C82}はい\nいいえ",
  "tgt": "{立绘0000}这样可以吧？{码14820C82}是\n否"
 },
 {
  "id": "017024",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "{立绘0000}ほい、持っていきなはれ。\n---\n{立绘FFFF}\n    {色03}宝くじ{/色}を手に入れた！",
  "tgt": "{立绘0000}喏，拿好。\n---\n{立绘FFFF}\n    获得了{色03}彩票{/色}！"
 },
 {
  "id": "017025",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "{立绘0000}宝くじは1まい\n300ゼニーや。\n---\n買うさいに好きなナンバーを\n自分で決めることができる。\n---\n買ってしばらくたったら\n当たりをはっぴょうしたる。\n---\n1とうは5本\n2とうは3本\n3とうは1本。\n---\n3とうは3000ゼニー\n2とうでは30000ゼニー、\n---\nそして1とうはなんと\n300000ゼニーや！\n---\nどや？\nこれ買わんで、\n一体何買うんや？",
  "tgt": "{立绘0000}彩票1张\n300泽尼。\n---\n买的时候号码\n可以自己选。\n---\n买过一阵子后\n就会公布中奖。\n---\n1等奖5张\n2等奖3张\n3等奖1张。\n---\n3等奖3000泽尼\n2等奖30000泽尼、\n---\n而1等奖居然是\n300000泽尼！\n---\n怎样？\n不买这个，\n你还能买啥？"
 },
 {
  "id": "017026",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "{立绘0000}{码0B}‥くじは1まいも\n持ってないで。",
  "tgt": "{立绘0000}{码0B}…你连1张\n彩票都没有。"
 },
 {
  "id": "017027",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "{立绘0000}またきてや。",
  "tgt": "{立绘0000}再来啊。"
 },
 {
  "id": "017028",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "{立绘0000}いいところにきたで、ホンマ。\n今回は待ちに待った\n当たりくじのはっぴょうや。\n---\nはたしてあんたのくじは\n当たってるかな？",
  "tgt": "{立绘0000}来得正是时候。\n这次是盼望已久的\n中奖号码公布。\n---\n你的彩票\n到底中没中呢？"
 },
 {
  "id": "017029",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "{立绘0000}では、この宝くじを\nチェックしたる。",
  "tgt": "{立绘0000}那就来\n查查这张彩票。"
 },
 {
  "id": "017030",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "{立绘0000}‥‥{码0B}{码0B}こ、{码0B}これは‥\nえらいことやで！\n---\nに、にいちゃん、\n{码0B}すごい強運の持ち主やで！\n---\n{金钱00}なんと1とう\n300000ゼニーが\n当たっとるやないけ！\n---\nホンマ、こんなことされると\nかなわんで。",
  "tgt": "{立绘0000}……{码0B}{码0B}这、{码0B}这是…\n了不得了！\n---\n大、大哥，\n{码0B}你是超强运的人啊！\n---\n{金钱00}竟然中了1等奖\n300000泽尼\n大奖！\n---\n真是拿你\n没办法。"
 },
 {
  "id": "017031",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "{立绘0000}おおっ！\nにいちゃん、やったな！\n---\n{金钱00}2とう30000ゼニーの\n当たりや！\n---\n宝くじ買って、\nホンマに良かったやろ。",
  "tgt": "{立绘0000}哦哦！\n大哥，中了！\n---\n{金钱00}是2等奖\n30000泽尼！\n---\n买这张彩票\n真是太值了。"
 },
 {
  "id": "017032",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "{立绘0000}{码0B}あた〜りぃ〜。\n---\n{金钱00}3とう3000ゼニーや。\n大事に使ってや。",
  "tgt": "{立绘0000}{码0B}中～奖～啦～。\n---\n{金钱00}是3等奖3000泽尼。\n省着点用啊。"
 },
 {
  "id": "017033",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "{立绘0000}‥‥どうやら外れやな。\nまあ、また次があるで。",
  "tgt": "{立绘0000}……看样子没中。\n嘛，还有下次。"
 },
 {
  "id": "017034",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "{立绘0101}「遠いところ\nよう 来てくれたな！\n---\n{金钱00}他には 売ってへんモン\nいろいろ あるで！{码14840C94}何か買おう\n持ち物を売ろう\n武器を下取りしてもらおう\nまたこんど‥",
  "tgt": "{立绘0101}「大老远\n辛苦你们来了！\n---\n{金钱00}别处买不到的\n货这里有的是！{码14840C94}买点什么\n卖点东西\n折卖武器\n下次再来…"
 },
 {
  "id": "017035",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "{立绘0000}「ああ、それなら\nもっていってもいいで‥\n---\nすっかり サビついて\n売りもんにならへん。",
  "tgt": "{立绘0000}「哦，那种东西\n拿走也行…\n---\n锈得一塌糊涂\n没法卖了。"
 },
 {
  "id": "017036",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "\n   {色03}{道具5301}{/色}を 手に入れた！",
  "tgt": "\n获得了{色03}{道具5301}{/色}！"
 },
 {
  "id": "017037",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "サビついた刀が 置いてある‥",
  "tgt": "放着一把生锈的刀‥"
 },
 {
  "id": "017038",
  "file": "WORLD/AREAS052.EMI",
  "seg": 12,
  "src": "{打字02}   〜アイテム·ショップ〜\n     {色02}『でんげき屋』{/色}\n    この先、15步です",
  "tgt": "{打字02}   ～道具·商店～\n     {色02}『电击屋』{/色}\n    前方15步"
 },
 {
  "id": "017039",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "かんそん",
  "tgt": "寒村"
 },
 {
  "id": "017040",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{立绘0000}「まだ、動かん方が ええ‥\n---\n体じゅう、ひどい\n傷だらけじゃ‥",
  "tgt": "{立绘0000}「你还是\n别乱动的好……\n---\n你浑身都是\n重伤呢……"
 },
 {
  "id": "017041",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{立绘0000}「そのまま、休んでな‥\n---\n今、食べ物を\n持って行くけ。",
  "tgt": "{立绘0000}「你就\n躺着歇着吧……\n---\n我这就\n给你拿吃的去。"
 },
 {
  "id": "017042",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「あれま！",
  "tgt": "{框04}{立绘8040}「哎呀呀！"
 },
 {
  "id": "017043",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「ごめんよー‥\nケムかったろ？\n---\n{立绘8141}うちの かまど\n壊れてんだわ‥！",
  "tgt": "{框04}{立绘8040}「对不住呀——‥\n被烟熏了吧？\n---\n{立绘8141}我家的灶台\n坏掉了呢‥！"
 },
 {
  "id": "017044",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「マミさんの家\nかべが、壊れとるのぉ‥\n---\n教えてやらにゃ‥",
  "tgt": "「玛米家的\n墙，坏了呀‥\n---\n得告诉她才行‥"
 },
 {
  "id": "017045",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「みんな、よく働くよね\n感心しちゃうよ。",
  "tgt": "「大家都很勤快呢\n真让人佩服。"
 },
 {
  "id": "017046",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「あっ！\n---\n今、話しかけねェでけれ\nマメの数、かぞえてんだ‥",
  "tgt": "「啊！\n---\n现在别跟我说话\n我在数豆子呢‥"
 },
 {
  "id": "017047",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「おめ、知ってるぞ‥\nマミさんが、くわえこんだ\nヤロウだべ‥？\n---\n‥ところで、くわえこむって\nどーゆー意味だ？",
  "tgt": "「我认得你！‥\n你就是玛米捡回来\n的那个家伙吧‥？\n---\n‥话说，捡回来\n是什么意思？"
 },
 {
  "id": "017048",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{立绘0202}{码0A}{/色}「きゅー",
  "tgt": "{立绘0202}{码0A}{/色}「啾——"
 },
 {
  "id": "017049",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「つりは、ええのぉ‥",
  "tgt": "「钓鱼呀，妙得很‥"
 },
 {
  "id": "017050",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「はぁ‥？\n変なこと、ききなさるねぇ‥\n---\nここは、{色02}ソン村{/色}‥\n帝都の ずっと東にある\nイナカじゃよ‥？",
  "tgt": "「哈……？\n问这么奇怪的问题……\n---\n这里是{色02}宋村{/色}……\n在帝都东边\n很远的乡下哦……？"
 },
 {
  "id": "017051",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{立绘0303}「お、{码0B}おめぇだな‥！\n---\nマミん家で、やっかいに\nなってるって男は！？",
  "tgt": "{立绘0303}「是，是你呀‥！\n---\n就是寄住在\n玛米家的那个男！？{码0B}おめぇだな‥！\n---\nマミん家で、やっかいに\nなってるって男は！？"
 },
 {
  "id": "017052",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框04}{立绘0303}「おめぇ、何者だ？\nこの村に、よそ者は‥‥{引0E00}",
  "tgt": "{框04}{立绘0303}「你，是什么人？\n这村子里，外乡人‥‥{引0E00}"
 },
 {
  "id": "017053",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「ロンの兄ちゃん！",
  "tgt": "{框05}{立绘0000}「隆哥！"
 },
 {
  "id": "017054",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框04}{立绘8303}「マミ‥、おめぇ‥",
  "tgt": "{框04}{立绘8303}「玛米‥，你‥"
 },
 {
  "id": "017055",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框06}{立绘8000}「あんちゃん\n無理しねぇで‥！",
  "tgt": "{框06}{立绘8000}「大哥\n别硬撑……！"
 },
 {
  "id": "017056",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框06}{立绘8000}「おらの、イトコで\nロンの兄ちゃんって\n言うです‥\n---\nハシビトに 行ってたども\nけがして、戻って来てます‥",
  "tgt": "{框06}{立绘8000}「他是我的表哥\n名叫隆哥……\n---\n之前去了桥民镇\n受伤后就\n回来了……"
 },
 {
  "id": "017057",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框06}{立绘8000}「あの‥、ケガが治るまで\nうちで 世話してるです‥\n---\n{立绘8101}あの‥、よろしく\nお願いします‥！",
  "tgt": "{框06}{立绘8000}「那个……在伤好之前\n就住在我家……\n---\n{立绘8101}那个……\n请多关照……！"
 },
 {
  "id": "017058",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框06}{立绘8000}「さ、行こ‥ あんちゃん。",
  "tgt": "{框06}{立绘8000}「走吧……\n大哥。"
 },
 {
  "id": "017059",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「あやー‥\n地主さまに、バレちまった‥",
  "tgt": "{框06}{立绘8040}「哎呀呀‥\n被地主大人发现啦‥"
 },
 {
  "id": "017060",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框05}{立绘4600}「まずいのか‥？",
  "tgt": "{框05}{立绘4600}「不好吃吗……？"
 },
 {
  "id": "017061",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「やー‥、{码0B}イトコって事に\nしておくから‥\n---\n{立绘8141}心配しねぇで、体を\n治すとええよ‥！",
  "tgt": "{框06}{立绘8040}「呀——，就对外说\n是表亲吧‥\n---\n{码0B}别担心，把身体\n养好就行‥！{立绘8141}心配しねぇで、体を\n治すとええよ‥！"
 },
 {
  "id": "017062",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「さっき、思わず\nイトコだって 言ったけど‥\n---\nおめぇさま、本当は‥",
  "tgt": "{框06}{立绘8040}「刚才一不小心\n说是表亲‥\n---\n其实你，真正的‥"
 },
 {
  "id": "017063",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「いや、何でもねぇ‥",
  "tgt": "{框06}{立绘8040}「不，没什么‥"
 },
 {
  "id": "017064",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框03}{立绘4600}「むかし‥\n---\n{队员06}という、神が\nこの世界に 現れた‥",
  "tgt": "{框03}{立绘4600}「很久以前……\n---\n一位名叫\n{队员06}的神\n出现在这个世界……"
 },
 {
  "id": "017065",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框03}{立绘0404}「そのころ、この地では\n多くの国々が\nたがいに 爭いあっていた。",
  "tgt": "{框03}{立绘0404}「那时，这片大地上\n众多国家\n彼此争战不休。"
 },
 {
  "id": "017066",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框03}{立绘4600}「人々は、{队员06}に‥\n---\n爭いのない、平安な\n世界を 願った‥",
  "tgt": "{框03}{立绘4600}「人们对{队员06}……\n---\n许下了没有争斗、\n和平安宁的\n世界的愿望……"
 },
 {
  "id": "017067",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框03}{立绘4600}「{队员06}は、願いを\n闻き入れて‥\n---\n国々を まとめ\n帝国を築き‥\n自ら、初代皇帝となった。",
  "tgt": "{框03}{立绘4600}「{队员06}听允了\n这个愿望……\n---\n统一各国\n建立帝国……\n自己成为了初代皇帝。"
 },
 {
  "id": "017068",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框03}{立绘4600}「しかし、そこまでで‥\n---\n{队员06}は、力つき‥\n長い眠りに ついた。\n---\n神として‥\n完全では なかったのだ。",
  "tgt": "{框03}{立绘4600}「但也仅止于此……\n---\n{队员06}力竭\n陷入了长眠。\n---\n作为神……\n他还是不完全的。"
 },
 {
  "id": "017069",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框03}{立绘0404}「だが、{队员06}は\nさとっていた‥\nたとえ‥‥",
  "tgt": "{框03}{立绘0404}「但，{队员06}\n早已领悟‥\n即便‥‥"
 },
 {
  "id": "017070",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框03}{立绘0404}「たとえ、神として\n完全だったとしても‥\n---\n人々の 望みを\nかなえる事など\nできないと‥！",
  "tgt": "{框03}{立绘0404}「即便身为神明\n完美无缺‥\n---\n也不可能\n实现人们的\n所有愿望‥！"
 },
 {
  "id": "017071",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框03}{立绘0505}「なぜなら、ヒトは‥{引2100}",
  "tgt": "{框03}{立绘0505}「因为，人类‥{引2100}"
 },
 {
  "id": "017072",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框06}{立绘8000}「あのっ‥！",
  "tgt": "{框06}{立绘8000}「那个……！"
 },
 {
  "id": "017073",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框06}{立绘8000}「あの‥、おら‥\n---\nおめぇさまの 言ってること\nよく分からねぇ、{码0B}けど‥",
  "tgt": "{框06}{立绘8000}「那个……我……\n---\n虽然不太明白\n您说的话\n{码0B}但是……"
 },
 {
  "id": "017074",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框06}{立绘8000}「分からねぇけど‥\n---\nそんな、悲しそうな\n顏されたら‥‥",
  "tgt": "{框06}{立绘8000}「虽然不明白……\n---\n可您露出\n那么悲伤的表情…………"
 },
 {
  "id": "017075",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "休んでいきますか？{码14860C93}休んでいく\n旅の記錄だけする\nやめておく",
  "tgt": "要在此休息吗？休息一下\n只做旅途记录\n还是算了{码14860C93}休んでいく\n旅の記錄だけする\nやめておく"
 },
 {
  "id": "017076",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "ベッドで休みますか？{码148A0C82}休む\n休まない",
  "tgt": "要在床上休息吗？休息\n不休息{码148A0C82}休む\n休まない"
 },
 {
  "id": "017077",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「マミさんなら、下のはたけに\n行ったよ‥\n---\nあの子も よく働くね\n感心しちゃうよ。",
  "tgt": "「玛米的话\n去下面的田里了‥\n---\n那孩子也很勤快\n真让人佩服。"
 },
 {
  "id": "017078",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「おめ、知ってるぞ！\nマミさんの オトコ‥\n---\nじゃなくって、イトコだべ？",
  "tgt": "「我认得你！\n玛米的男人‥\n---\n不对，是表亲吧？"
 },
 {
  "id": "017079",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「おめぇさん‥\nつり、した事あるか？{码14010C82}ある\nない",
  "tgt": "「你‥\n钓过鱼吗？钓过\n没钓过{码14010C82}ある\nない"
 },
 {
  "id": "017080",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「ほ、ほ‥\nやっぱり、つり好きそうな\n顏じゃと 思ったわい。",
  "tgt": "「哦，哦‥\n果然我就觉得\n你是副爱钓鱼的面相呀。"
 },
 {
  "id": "017081",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「はー‥\nつり好きそうな\n感じじゃが、のぉ‥",
  "tgt": "「是吗‥\n虽然一副爱钓鱼的\n模样，但是呀‥"
 },
 {
  "id": "017082",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{立绘0404}「竜の気が‥‥\n高まっている？",
  "tgt": "{立绘0404}「龙的气息‥‥\n在增强吗？"
 },
 {
  "id": "017083",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{立绘4600}「動き始めたと\n言う事か‥？",
  "tgt": "{立绘4600}「你是说\n它开始动了吗……？"
 },
 {
  "id": "017084",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「何か、地なりが\nしたよね‥\n---\nびっくり しちゃったよ。",
  "tgt": "「刚才好像有\n地鸣声呢‥\n---\n吓了我一跳。"
 },
 {
  "id": "017085",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「ん‥？\n---\nマミさんなら、いつも通り\n下のはたけじゃ\nないかねぇ‥",
  "tgt": "「嗯‥？\n---\n玛米的话\n还不是老样子\n在下面的田里吗‥"
 },
 {
  "id": "017086",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「おめ、働いてっか？\n---\nケガ治ったら‥\n働かにゃ、いけんのだぞ。",
  "tgt": "「你，在干活吗？\n---\n伤养好了‥\n可得干活哟。"
 },
 {
  "id": "017087",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{立绘0202}{码0A}{/色}「くふん",
  "tgt": "{立绘0202}{码0A}{/色}「咕吩"
 },
 {
  "id": "017088",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「おめぇさん、今度\nヒマがあったら‥\n---\nつり、してみるがええ‥\n落ち着くから。",
  "tgt": "「你呀，下次\n有空的话‥\n---\n去钓钓鱼挺好‥\n能让人静心。"
 },
 {
  "id": "017089",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「何だか、ゆれたねぇ‥\n---\n何か起きる\n前ぶれだと、ヤダねぇ。",
  "tgt": "「好像晃了一下呢‥\n---\n要是有什么大事的\n前兆，可不妙呀。"
 },
 {
  "id": "017090",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「何じゃろなぁ‥\nさっきの、地鳴りは？",
  "tgt": "「刚才那声\n地鸣，究竟是什么呀‥"
 },
 {
  "id": "017091",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{立绘0404}「やはり、これ以上‥\n---\n関わりを 持つべきでは\nないな‥",
  "tgt": "{立绘0404}「果然，不应再有‥\n---\n更深的\n牵连了呢‥"
 },
 {
  "id": "017092",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「ロンのあんちゃん‥",
  "tgt": "{框06}{立绘8040}「龙家小哥‥"
 },
 {
  "id": "017093",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「地主様の、言ったこと\n気にしねぇでくれ‥\n---\n村の連中は、村が\nひどいことに、ならねぇで\n助かっただよ‥\n---\n{立绘8141}もちろん、おらも\nかんしゃしてる‥",
  "tgt": "{框06}{立绘8040}「地主大人说的话\n你别放在心上‥\n---\n村里人庆幸\n村子没有\n遭了大难‥\n---\n{立绘8141}当然，我也\n心怀感激‥"
 },
 {
  "id": "017094",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框04}{立绘8303}「こ、{码0B}こちらです\n兵隊さま‥‥",
  "tgt": "{框04}{立绘8303}「就，就是这里\n官爷‥‥{码0B}こちらです\n兵隊さま‥‥"
 },
 {
  "id": "017095",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{立绘C640}「突破する‥‥\n---\nいや、{码0B}やりすごせるか？",
  "tgt": "{立绘C640}「强行突破‥‥\n---\n不，能不能蒙混过去？{码0B}やりすごせるか？"
 },
 {
  "id": "017096",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{立绘C640}「何を、しているのだ\n私は‥‥\n---\n{立绘8545}こんな村が、どうなろうと\nやつらを 倒して‥\n---\n突破できるじゃないか‥？",
  "tgt": "{立绘C640}「我，到底在\n做什么‥‥\n---\n{立绘8545}这种村子怎样都好\n打倒那些家伙‥\n---\n不就能突破了吗‥？"
 },
 {
  "id": "017097",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{立绘0606}「この家に、そいつが\nかくまわれて いるのだな？",
  "tgt": "{立绘0606}「那家伙就藏在\n这户人家里吧？"
 },
 {
  "id": "017098",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框02}{立绘8343}「か、かくまうなど‥！\n---\nそんな 悪人だとは\n知りませんで‥！",
  "tgt": "{框02}{立绘8343}「藏，藏匿什么的‥！\n---\n我不知道他是\n那种坏人‥！"
 },
 {
  "id": "017099",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框02}{立绘8343}「む、{码0B}村の者にも‥\n---\n武器に なりそうな物を\n持たせました‥\n---\nきょ、協力しますんで‥\nへへへ‥",
  "tgt": "{框02}{立绘8343}「而且村里人也‥\n---\n配上了像样的\n武器‥\n---\n请多关照呀‥\n嘿嘿嘿‥{码0B}村の者にも‥\n---\n武器に なりそうな物を\n持たせました‥\n---\nきょ、協力しますんで‥\nへへへ‥"
 },
 {
  "id": "017100",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框02}{立绘0303}「マミ‥！？{延时30}",
  "tgt": "{框02}{立绘0303}「玛米‥！？{延时30}"
 },
 {
  "id": "017101",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{立绘8545}「そう、か‥‥\n---\nそうだな‥‥",
  "tgt": "{立绘8545}「这样，啊‥‥\n---\n是啊‥‥"
 },
 {
  "id": "017102",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框02}{立绘8404}「私を かくまった\nお前が‥\n---\n私を 捕まえないと‥\n---\n皆に、しろい目で\n見られてしまうな‥？",
  "tgt": "{框02}{立绘8404}「收留了我的\n你‥\n---\n不把我交出去的话‥\n---\n会被大家\n白眼相待吧‥？"
 },
 {
  "id": "017103",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框04}{立绘8000}「おめぇさまが‥\nふつうの人で、ないって事は\n---\n分かってたです‥",
  "tgt": "{框04}{立绘8000}「您\n不是普通人\n这件事……\n---\n我早就知道……"
 },
 {
  "id": "017104",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框02}{立绘8040}「何かに、追われていても\nここで、ひっそりと\nしていれば‥\n---\nそのうち、ふつうに‥\nいっしょに くらせる‥",
  "tgt": "{框02}{立绘8040}「就算被什么\n追着，只要在这儿\n安安静静地过‥\n---\n总有一天就能\n像平常一样生活‥"
 },
 {
  "id": "017105",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框02}{立绘8141}「そんな‥、{码0B}夢みてぇな事\n考えてました‥！",
  "tgt": "{框02}{立绘8141}「我曾经想着\n那种梦一般的事‥！{码0B}夢みてぇな事\n考えてました‥！"
 },
 {
  "id": "017106",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框02}{立绘8040}「すまねぇ‥\nむり言って ひきとめた\nばっかりに‥！",
  "tgt": "{框02}{立绘8040}「对不住‥\n都怪我硬把你\n留下来‥！"
 },
 {
  "id": "017107",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框02}{立绘8343}「マミ‥！\n何してる、開けねぇか！",
  "tgt": "{框02}{立绘8343}「玛米‥！\n在干什么，快开门呀！"
 },
 {
  "id": "017108",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框02}{立绘0040}「かまどが、壊れてて\nそこから ウラへ出れます‥\n---\n早く‥！",
  "tgt": "{框02}{立绘0040}「灶台破了\n从那里能绕到后头……\n---\n快……！"
 },
 {
  "id": "017109",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框02}{立绘0040}「かまどから、出たら‥\n---\n見つからないように\n森のほこらへ\n行って下さい‥\n---\nほこらのウラに\n抜け穴が あります。",
  "tgt": "{框02}{立绘0040}「从灶台出来后……\n---\n请小心别被发现\n去森林的祠堂……\n---\n祠堂后面\n有一条密道。"
 },
 {
  "id": "017110",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{框02}{立绘0040}「早く‥、行ってくれ！",
  "tgt": "{框02}{立绘0040}「快……快去吧！"
 },
 {
  "id": "017111",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{立绘0101}「へへ‥\n---\nかまど、壊れてるの‥\nこんな時に\n役だっただね‥",
  "tgt": "{立绘0101}「嘿嘿‥\n---\n灶台坏了‥\n这种时候\n反倒派上用场了呢‥"
 },
 {
  "id": "017112",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "かまどのウラの壁が、壊れている。\n無理をすれば、抜けられそうだ‥",
  "tgt": "灶台后面的墙坏了。\n硬闯的话似乎能穿过去‥"
 },
 {
  "id": "017113",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{立绘0707}「この女だけです‥！",
  "tgt": "{立绘0707}「只有这个女人‥！"
 },
 {
  "id": "017114",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{立绘0808}「{队员06}を\nかくまっていた‥\n---\nいっしょに 住んでいたのか？",
  "tgt": "{立绘0808}「你收留了\n{队员06}‥\n---\n还一起住了下来吗？"
 },
 {
  "id": "017115",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{立绘8808}「アスタナに、連れて行け。\n---\n呪砲が、使えるかもしれん‥",
  "tgt": "{立绘8808}「押到阿斯塔纳去。\n---\n咒炮说不定能派上用场‥"
 },
 {
  "id": "017116",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{立绘0303}「お、おらぁ‥\n悪くねぇ‥{码0B}‥{码0B}‥\n---\nマミ‥‥、おめぇが‥‥",
  "tgt": "{立绘0303}「我，我没做\n坏事‥‥‥\n---\n玛米‥‥，你‥‥{码0B}‥{码0B}‥\n---\nマミ‥‥、おめぇが‥‥"
 },
 {
  "id": "017117",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「おめぇさん‥\nつり、した事あるか？{码14010C82}ある\nない",
  "tgt": "「你‥\n钓过鱼吗？钓过\n没钓过{码14010C82}ある\nない"
 },
 {
  "id": "017118",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「ほ、ほ‥\nあんたも、つり好きそうな\n顏じゃと 思ったわい。",
  "tgt": "「哦，哦‥\n果然我就觉得\n你也是副爱钓鱼的面相呀。"
 },
 {
  "id": "017119",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「はー‥\nあんたも、ないんか？\n---\nつり好きそうな\n感じじゃが、のぉ‥",
  "tgt": "「是吗‥\n你也没钓过？\n---\n虽然一副爱钓鱼的\n模样，但是呀‥"
 },
 {
  "id": "017120",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "{立绘0303}「お、{码0B}おめ どうして‥！？\n---\n‥{码0B}‥あ、{码0B}いや。\n---\nよそ者は、あんまり\nこの边に 来ねぇでくれ‥",
  "tgt": "{立绘0303}「你，你怎么在这‥！？\n---\n‥‥啊，没事。\n---\n外乡人尽量\n别来这一带‥{码0B}おめ どうして‥！？\n---\n‥{码0B}‥あ、{码0B}いや。\n---\nよそ者は、あんまり\nこの边に 来ねぇでくれ‥"
 },
 {
  "id": "017121",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「帝都は、化け物に\nおそわれたって 言うし‥\n---\nいったい、なにが\nどうなってるのかねぇ‥",
  "tgt": "「听说帝都被\n怪物袭击了‥\n---\n到底\n出了什么事呀‥"
 },
 {
  "id": "017122",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「おめぇら、知らねだろ‥\n---\nこの村、へーたいが\nいっぱい来たことが、あんだぞ。",
  "tgt": "「你们不知道吧‥\n---\n这村子，以前来过\n好多好多官兵哟。"
 },
 {
  "id": "017123",
  "file": "WORLD/AREAS053.EMI",
  "seg": 11,
  "src": "「あれ、おめぇ‥{码0B}‥{码0B}‥\n---\nいや、ちがうだな‥",
  "tgt": "「咦，你‥‥‥\n---\n不，认错了‥{码0B}‥{码0B}‥\n---\nいや、ちがうだな‥"
 },
 {
  "id": "017124",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "でーすのゆめでーす",
  "tgt": "是蒂斯的梦哟"
 },
 {
  "id": "017125",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘8040}「ちぇっ‥！",
  "tgt": "{立绘8040}「切‥！"
 },
 {
  "id": "017126",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘8040}「せっかく、いい夢みてるのに\n‥ヒトってのは、まったく\nあつかましいね。",
  "tgt": "{立绘8040}「人家好不容易\n做着好梦‥人类\n真是厚脸皮呀。"
 },
 {
  "id": "017127",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘0101}「す、すみません\n{队员05}さん‥\n---\n{立绘4100}あの‥、お闻きしたい事が\nあって‥‥",
  "tgt": "{立绘0101}「对，对不起\n{队员05}……\n---\n{立绘4100}那个……我们\n想请教您一些事…………"
 },
 {
  "id": "017128",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘8040}「は‥\n---\nカミサマ、私達は\nどうすれば いいでしょう‥\nだろ？",
  "tgt": "{立绘8040}「哈‥\n---\n神明大人，\n我们该怎么办才好‥\n是吧？"
 },
 {
  "id": "017129",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘8040}「ったく‥！\n---\nアンタ達、ヒトは\nいつでも、それだ！",
  "tgt": "{立绘8040}「真是的‥！\n---\n你们，人类\n总是这一套！"
 },
 {
  "id": "017130",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘0201}「ご、{码0B}ごめんなさい‥",
  "tgt": "{立绘0201}「对、对不起‥{码0B}ごめんなさい‥"
 },
 {
  "id": "017131",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘8040}「大体‥、神様を\n呼び出さないと いけない\n世界なんてのが‥\n---\nおかしいんだよ\nそもそも‥",
  "tgt": "{立绘8040}「说到底‥、非得\n召唤神明不可的\n这种世界‥\n---\n就很奇怪呀\n从一开始‥"
 },
 {
  "id": "017132",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘8000}「てめぇの世界の ケツぐらい\nてめぇらで ふけってんだ！\n---\n‥{码0B}‥{码0B}‥\n---\nって、グチってても\nしょうがないね‥",
  "tgt": "{立绘8000}「你们那个世界的烂摊子\n就自己擦屁股吧！\n---\n……{码0B}……{码0B}……\n---\n算了，光抱怨\n也没用呢……"
 },
 {
  "id": "017133",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘C240}「あー‥、その‥\n気持ちは 分かるが‥\n---\nこちらも、とまどって\nいるんだ‥",
  "tgt": "{立绘C240}「啊‥、那个‥\n心情我能理解‥\n---\n可我这边\n也很困惑呀‥"
 },
 {
  "id": "017134",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘8000}「ふん‥、ま‥\nできそこないの カミサマを\n2人も 連れてりゃ‥\n---\nとまどうだろうね‥",
  "tgt": "{立绘8000}「哼……嘛……\n带着两个\n半吊子的神……\n---\n是要犯迷糊的……"
 },
 {
  "id": "017135",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘0000}「でも‥\nいいかい、トラちゃん？\n---\nあんた達が、どうなるかは\nその、できそこないの神‥\n---\n{队员00}が、どうするか\nって事なんだ。",
  "tgt": "{立绘0000}「但是……\n听好了，托拉……\n---\n你们的结局如何\n全看那半吊子的神……\n---\n{队员00}会怎么做\n才是关键。"
 },
 {
  "id": "017136",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘0000}「{队员00}は、もともと\n皇帝の かたわれだから‥\n---\n皇帝と、ひとつになって\n帝国のために 力を\n使うべきなんだ。",
  "tgt": "{立绘0000}「{队员00}本来\n就是皇帝的半身……\n---\n就该与皇帝合为一体\n为帝国\n施展力量。"
 },
 {
  "id": "017137",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘8342}「帝国が、神の力を\n手にしたら‥\n---\nまた、戦爭が\n起きるぞ‥！\n---\n{立绘8442}そんな事が、許されるものか！",
  "tgt": "{立绘8342}「帝国要是\n得到神之力‥\n---\n战争\n又会爆发‥！\n---\n{立绘8442}岂能容这种事发生！"
 },
 {
  "id": "017138",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘0000}「どなっても\n仕方ないんだよ‥\n---\nでもね‥",
  "tgt": "{立绘0000}「再怎么哀嚎\n也没用哟……\n---\n不过呢……"
 },
 {
  "id": "017139",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘8040}「{队员00}が\n皇帝の 半身って事は‥\n---\n皇帝が、{队员00}の\n半身って事でも あるんだ。",
  "tgt": "{立绘8040}「{队员00}\n是皇帝的半身……\n---\n反过来说\n皇帝也是{队员00}的\n半身。"
 },
 {
  "id": "017140",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘8040}「半身どうしは、いずれ\n出会う 運命だけど‥\n---\nその時、{队员00}が\n皇帝と 同じくらいの\n力を つけていれば‥",
  "tgt": "{立绘8040}「半身之间\n迟早会相遇……\n---\n到那时，{队员00}\n只要练出了\n和皇帝相当的力量……"
 },
 {
  "id": "017141",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘4100}「あちらの神の\n思うとおりには‥\n---\nならないって‥\nことですか？",
  "tgt": "{立绘4100}「就不会像\n那边的神\n所希望的那样……\n---\n发展了……\n是这个意思吗？"
 },
 {
  "id": "017142",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘8040}「まあ、だいたい\nそんな感じだよ\nひよこちゃん‥",
  "tgt": "{立绘8040}「嘛，大概\n就是这么回事\n小雏鸟‥"
 },
 {
  "id": "017143",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘4100}「あの、じゃ‥\n{队员00}が 力を\nつけるには‥‥",
  "tgt": "{立绘4100}「那个，那么……\n{队员00}要\n变强的话…………"
 },
 {
  "id": "017144",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘8040}「もちろん\nその方法は、あるさ‥\n---\nそのために‥\n---\nあたしも、ぼちぼち\n目を 覺まさないとね。",
  "tgt": "{立绘8040}「当然\n那方法，是有的‥\n---\n为此‥\n---\n我也差不多\n该醒过来了呢。"
 },
 {
  "id": "017145",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘0000}「ん‥\nてなわけで‥\n---\nあたし、起きるから\nアンタたち、夢から\n出て行ってよね。",
  "tgt": "{立绘0000}「嗯……\n就是这样……\n---\n我要起床了\n你们快从\n我的梦里出去吧。"
 },
 {
  "id": "017146",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "「HA HA HA HA！",
  "tgt": "「HAHAHAHA！"
 },
 {
  "id": "017147",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{框02}「FU FU FU FU‥",
  "tgt": "{框02}「FUFUFUFU‥"
 },
 {
  "id": "017148",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘0000}「さっさと行きなって‥\n---\nあたしの 夢の中に\n取り残されたい？",
  "tgt": "{立绘0000}「快点走吧……\n---\n想被困在\n我的梦里吗？"
 },
 {
  "id": "017149",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘0503}「ここは、ディース様の\n夢の中なのデース\n---\n‥シャレではないのデース。",
  "tgt": "{立绘0503}「这里是蒂斯大人的\n梦境之中的说\n---\n‥可不是在开玩笑的说。"
 },
 {
  "id": "017150",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘0503}「夢の中ダカラ‥\n---\nこんなポーズでも\n疲れないデース！",
  "tgt": "{立绘0503}「因为是在梦中‥\n---\n这种姿势也\n不会累的说！"
 },
 {
  "id": "017151",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘0503}「お美しい ディース様\n---\n‥‥まるで\n女神のようデース！",
  "tgt": "{立绘0503}「美丽的蒂斯大人\n---\n‥‥简直\n就像女神的说！"
 },
 {
  "id": "017152",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘0503}「まさに この世は‥\n---\nディース様を中心に\n回っているのデース！",
  "tgt": "{立绘0503}「这个世界正是‥\n---\n以蒂斯大人为中心\n运转的说！"
 },
 {
  "id": "017153",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘0503}「ディース様‥長い間\n閉じこめられてたので\n---\nちょっとハメを\nはずしてるのデース。",
  "tgt": "{立绘0503}「蒂斯大人‥因为被\n关了很久‥\n---\n稍微有点\n放飞自我的说。"
 },
 {
  "id": "017154",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘0503}「OH！ アナタの\nそれ、竜眼デスネ\n---\nそれで夢の中に入って\n来れたデースか？",
  "tgt": "{立绘0503}「OH！你的\n那个，是龙眼呢\n---\n所以才进到\n梦里来的说？"
 },
 {
  "id": "017155",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘0503}「HA HA HA！\n---\nキミより、ボクの方が\nかっこいいデース。",
  "tgt": "{立绘0503}「HAHAHA！\n---\n我可比你\n要帅的说。"
 },
 {
  "id": "017156",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘0503}「{队员05}‥？\n---\nノンノン\nディース様 デース！",
  "tgt": "{立绘0503}「{队员05}‥？\n---\n不不\n是蒂斯大人的说！"
 },
 {
  "id": "017157",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘0503}「顏がみんな同じ？\n---\nこれがディース様の\n好みだからデース\n---\n手抜きではないデース！",
  "tgt": "{立绘0503}「脸都长得一样？\n---\n因为这是蒂斯大人的\n喜好的说\n---\n才不是偷工减料的说！"
 },
 {
  "id": "017158",
  "file": "WORLD/AREAS054.EMI",
  "seg": 11,
  "src": "{立绘0503}「こうして、お仕え\nできるだけで‥\n---\nこのうえなく\nハッピーなのデース！",
  "tgt": "{立绘0503}「光是能这样\n侍奉大人‥\n---\n就无比\nHAPPY的说！"
 },
 {
  "id": "017159",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}妖精ンジョモ\n「勝手に人の家に\n上がっちゃだめよう！\n---\nさっさと出て行ってよう！",
  "tgt": "{立绘0000}妖精恩吉莫\n「不许随便\n闯进别人家哟！\n---\n快点出去哟！"
 },
 {
  "id": "017160",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "「‥つまになったからには\nせめて ふくぐらいは\n着てほしいんだけどね。\n---\nま、しかたないか‥",
  "tgt": "「‥既然都成了妻子\n至少也该穿件\n像样的衣服呀。\n---\n嘛，没办法‥"
 },
 {
  "id": "017161",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}妖精ンジョモ\n「‥‥あっ！\n---\nあんたたちのウワサは\nきいてるよう！\n---\nなんでも妖精村のために\nずいぶんがんばってる\nそうじゃないのよう！\n---\nそんな人を\nてぶらで归すわけには\nいかないよう\n---\n一子そうでんの妖精魔法\n修行してみる？{码14820C92}お願いします\nまたの機会に",
  "tgt": "{立绘0000}妖精恩吉莫\n「……啊！\n---\n你们的传闻\n我听说过了哟！\n---\n说你们为了妖精村\n相当卖力\n是真的吗哟！\n---\n这样的人\n可不能让你们\n空手回去哟\n---\n一子相传的妖精魔法\n要修行试试吗？{码14820C92}拜托了\n下次有机会吧"
 },
 {
  "id": "017162",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}では、まずはこの\n{色04}なきむし{/色}を覺えてよう\n---\n{码0B}{码0B}‥いやだって？\n---\nそんなことをいってると\nろくな大人には\nなれないよう！",
  "tgt": "{立绘0000}那，先记住这招\n{色04}爱哭鬼{/色}吧\n---\n{码0B}{码0B}……说不想要？\n---\n总这么说的话\n将来也成不了\n像样的大人哟！"
 },
 {
  "id": "017163",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}‥もっともっと妖精村の\nめんどうを見てあげてよう\n---\n妖精の人数が\n{色02}{占位00}{/色}人をこえたら、\n---\n次の妖精魔法を\n教えてあげるよう！",
  "tgt": "{立绘0000}……请多关照\n妖精村哟\n---\n妖精的人数\n要是超过{色02}{占位00}{/色}人，\n---\n就把下一个\n妖精魔法教你哟！"
 },
 {
  "id": "017164",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}‥‥うーん\nざんねんだよう\n---\n決心がついたら\nまた来てよう",
  "tgt": "{立绘0000}………嗯——\n真遗憾哟\n---\n下定决心后\n再来吧哟"
 },
 {
  "id": "017165",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}それでは\nさよならだよう",
  "tgt": "{立绘0000}那么\n再见啦哟"
 },
 {
  "id": "017166",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}妖精ンジョモ\n「来る来るとは\nきいていたけど\n---\nなかなか来ないから\n心配したよう！",
  "tgt": "{立绘0000}妖精恩吉莫\n「虽然听说你们\n会来会来\n---\n可迟迟不来\n让人担心哟！"
 },
 {
  "id": "017167",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}‥そうそう！\n{队员00}たちのウワサは\nどんどん とどいてるよう！\n---\nなんでも\nじんじょうでは\nないほどの勢いで、\n---\n妖精村を\nはってんさせてる\nそうじゃないのよう！\n---\nお礼といってはなんだけど\nこの{色03}{占位01}{/色}を\n教えるよう",
  "tgt": "{立绘0000}……对了对了！\n{队员00}你们的传闻\n源源不断地传来哟！\n---\n说是势头\n好得\n不寻常，\n---\n让妖精村\n发展得\n飞快哟！\n---\n虽算不上谢礼\n这招{色03}{占位01}{/色}\n教你哟"
 },
 {
  "id": "017168",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}もっともっと がんばって\n妖精村の人数を\n{色02}{占位00}{/色}人以上にしてほしいよう\n---\nそうしたら次の妖精魔法を\n教えてあげるよう",
  "tgt": "{立绘0000}请更加努力\n让妖精村的人数\n超过{色02}{占位00}{/色}人哟\n---\n到时就把下一个\n妖精魔法教你哟"
 },
 {
  "id": "017169",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}あんたたち\n本当にすごいよう！\n---\n妖精村を\nはってんさせたばかりか\n---\nあたしの妖精魔法も\n全部マスターしちゃったよう\n---\nもう教えることは\nなにもないけど\n---\n妖精のめんどうだけは\n変わらずみてほしいよう\n---\nやくそくだよう！",
  "tgt": "{立绘0000}你们\n真厉害哟！\n---\n不仅让妖精村\n发展起来\n---\n连我的妖精魔法\n也全部学会了哟\n---\n虽然已经\n没什么可教的了\n---\n但请一如既往\n照顾妖精们哟\n---\n约好了哟！"
 },
 {
  "id": "017170",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}今日はどうするの？{码14820C93}修行したい\nやめます\n何でもないです",
  "tgt": "{立绘0000}今天想怎么样？{码14820C93}想修行\n不学了\n没什么事"
 },
 {
  "id": "017171",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}他にもあるの？{码14820C93}修行したい\nやめます\n何でもないです",
  "tgt": "{立绘0000}还有别的吗？{码14820C93}想修行\n不学了\n没什么事"
 },
 {
  "id": "017172",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}‥‥みんなあたしから\nならい中だよう",
  "tgt": "{立绘0000}………大家\n都在跟我学呢哟"
 },
 {
  "id": "017173",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}では{占位02}に\n妖精魔法を教えるよう\n---\nまずはこの{色04}なきむし{/色}を\n覺えてよう",
  "tgt": "{立绘0000}那就教{占位02}\n妖精魔法哟\n---\n先记住这招\n{色04}爱哭鬼{/色}吧"
 },
 {
  "id": "017174",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}では あなたたちに\n妖精魔法を教えるよう\n---\nまずはこの{色04}なきむし{/色}を\n覺えてよう",
  "tgt": "{立绘0000}那就教你们\n妖精魔法哟\n---\n先记住这招\n{色04}爱哭鬼{/色}吧"
 },
 {
  "id": "017175",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}誰もいないの？\nまあ、よく考えてよう",
  "tgt": "{立绘0000}没人吗？\n那就好好想想吧哟"
 },
 {
  "id": "017176",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}‥今教えてる人は\nこの中には\n誰もいないよう",
  "tgt": "{立绘0000}……现在正在\n学的人\n这里一个都没有哟"
 },
 {
  "id": "017177",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}‥‥うーん\nなんだかひどいよう\n---\n{占位02}とはしばらく\n口をききたくないよう",
  "tgt": "{立绘0000}………嗯——\n太过分了哟\n---\n暂时不想和\n{占位02}说话了哟"
 },
 {
  "id": "017178",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}‥‥うーん\nなんだかひどいよう\n---\nあんたたちとはしばらく\n口をききたくないよう",
  "tgt": "{立绘0000}………嗯——\n太过分了哟\n---\n暂时不想和\n你们说话了哟"
 },
 {
  "id": "017179",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}‥どうしたのよう？\n考え中？",
  "tgt": "{立绘0000}……怎么啦哟？\n在想事情？"
 },
 {
  "id": "017180",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}今度は{色02}{占位00}{/色}人以上を\nもくひょうにして\n村をはってんさせてよう\n---\n期待してるよう",
  "tgt": "{立绘0000}这次以超过{色02}{占位00}{/色}人\n为目标\n让村子继续发展哟\n---\n期待着哟"
 },
 {
  "id": "017181",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{立绘0000}妖精ンジョモ\n「‥‥なんかよう？\n---\nユーゴの知り合い？",
  "tgt": "{立绘0000}妖精恩吉莫\n「……什么事哟？\n---\n是尤戈的熟人？"
 },
 {
  "id": "017182",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "8",
  "tgt": "8"
 },
 {
  "id": "017183",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "12",
  "tgt": "12"
 },
 {
  "id": "017184",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "16",
  "tgt": "16"
 },
 {
  "id": "017185",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "20",
  "tgt": "20"
 },
 {
  "id": "017186",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{道具9304}",
  "tgt": "{道具9304}"
 },
 {
  "id": "017187",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{道具9104}",
  "tgt": "{道具9104}"
 },
 {
  "id": "017188",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{道具9204}",
  "tgt": "{道具9204}"
 },
 {
  "id": "017189",
  "file": "WORLD/AREAS055.EMI",
  "seg": 11,
  "src": "{道具9404}",
  "tgt": "{道具9404}"
 },
 {
  "id": "017190",
  "file": "WORLD/AREAS056.EMI",
  "seg": 15,
  "src": "「なにもない‥",
  "tgt": "「什么都没有‥"
 },
 {
  "id": "017191",
  "file": "WORLD/AREAS056.EMI",
  "seg": 15,
  "src": "「船にもどりますか？{码1400775F}\nいいえ",
  "tgt": "「要回船上吗？{码1400775F}\n否"
 },
 {
  "id": "017192",
  "file": "WORLD/AREAS056.EMI",
  "seg": 15,
  "src": "{立绘0000}「われは アビト\n海の深底より、世界を\n見守るもの‥\n---\nアルカイの竜よ\nうつろう者達よ‥\nわれの力が 必要か？{码14010C92}力をかして！\n今は必要ない",
  "tgt": "{立绘0000}「吾乃阿比托\n自深海之底\n守望世界者……\n---\n阿尔凯之龙啊\n无常者们啊……\n需要吾之力吗？{码14010C92}借我力量！\n现在不需要"
 },
 {
  "id": "017193",
  "file": "WORLD/AREAS056.EMI",
  "seg": 15,
  "src": "{立绘0000}「では、世界の行くすえ\n共に 見さだめよう‥",
  "tgt": "{立绘0000}「那么，就一同\n观定世界的归宿…"
 },
 {
  "id": "017194",
  "file": "WORLD/AREAS056.EMI",
  "seg": 15,
  "src": "{立绘0000}「では、世界の行くすえ\n海の深きより 見守ろう‥",
  "tgt": "{立绘0000}「那么，就让吾\n自深海之底\n守望世界的归宿吧……"
 },
 {
  "id": "017195",
  "file": "WORLD/AREAS056.EMI",
  "seg": 15,
  "src": "海竜の力を かりて‥\n『{道具4704}』を 身につけた！",
  "tgt": "借海龙之力‥\n穿上了『{道具4704}』！"
 },
 {
  "id": "017196",
  "file": "WORLD/AREAS056.EMI",
  "seg": 15,
  "src": "変わった草が 生えている‥\nこれが『{道具4C00}』だろうか？",
  "tgt": "长着一株奇怪的草……\n这就是『{道具4C00}』吗？"
 },
 {
  "id": "017197",
  "file": "WORLD/AREAS056.EMI",
  "seg": 15,
  "src": "{打字02}\n   {色03}{道具4C00}{/色}を 手に入れた！",
  "tgt": "{打字02}\n   得到了{色03}{道具4C00}{/色}！"
 },
 {
  "id": "017198",
  "file": "WORLD/AREAS056.EMI",
  "seg": 15,
  "src": "{立绘0000}「ここより西の大陸‥\n---\n地となりて、人知れず\nアルカイの竜を 待つもの‥\n---\n更なる力‥求むるなら\nたずねるがいい。",
  "tgt": "{立绘0000}「此地以西的大陆……\n---\n化为大地，暗中\n等待阿尔凯之龙者……\n---\n若求更强之力……\n便来寻吾。"
 },
 {
  "id": "017199",
  "file": "WORLD/AREAS056.EMI",
  "seg": 15,
  "src": "{色02}アルカイの竜{/色}でなければ\n話すことは できない‥",
  "tgt": "若非{色02}阿尔凯之龙{/色}\n便无话可说…"
 },
 {
  "id": "017200",
  "file": "WORLD/AREAS056.EMI",
  "seg": 15,
  "src": "もう、これいじょう\n必要ないだろう‥",
  "tgt": "这个已经\n不需要了吧‥"
 },
 {
  "id": "017201",
  "file": "WORLD/AREAS057.EMI",
  "seg": 11,
  "src": "狩りマップ！",
  "tgt": "狩猎地图！"
 },
 {
  "id": "017202",
  "file": "WORLD/AREAS057.EMI",
  "seg": 11,
  "src": "{立绘0000}「助けてよう！！",
  "tgt": "{立绘0000}「救命哟！！"
 },
 {
  "id": "017203",
  "file": "WORLD/AREAS057.EMI",
  "seg": 11,
  "src": "{立绘0000}「ひどいよう···",
  "tgt": "{立绘0000}「好过分哟···"
 },
 {
  "id": "017204",
  "file": "WORLD/AREAS057.EMI",
  "seg": 11,
  "src": "{立绘0100}「ありがとう、助かったよう！\n---\nあたし達、狩りに来て\nときどき こんな風に\n逆に おそわれるんだよう‥",
  "tgt": "{立绘0100}「谢谢，得救了哟！\n---\n我们来打猎\n有时反倒会\n被这样袭击哟…"
 },
 {
  "id": "017205",
  "file": "WORLD/AREAS057.EMI",
  "seg": 11,
  "src": "{占位00}を{占位01}コ見つけた！\n---\n妖精にあげますか？{码14000C02}はい\nいいえ",
  "tgt": "找到{占位00}{占位01}个！\n---\n要给妖精吗？{码14000C02}是\n否"
 },
 {
  "id": "017206",
  "file": "WORLD/AREAS057.EMI",
  "seg": 11,
  "src": "{占位00}を{占位01}コ\n妖精にあげた",
  "tgt": "把{占位00}{占位01}个\n给了妖精"
 },
 {
  "id": "017207",
  "file": "WORLD/AREAS057.EMI",
  "seg": 11,
  "src": "外に出ますか？{码14010CC2}はい\nいいえ",
  "tgt": "要出去吗？是\n否{码14010CC2}はい\nいいえ"
 },
 {
  "id": "017208",
  "file": "WORLD/AREAS057.EMI",
  "seg": 11,
  "src": "{立绘0100}「剣とか、てっぽーで\nえものを とってよう！\n---\nダメージを受けた えものは\n動き回るたびに、にくが\nまずくなるから‥\n---\n一気に しとめるのよう！",
  "tgt": "{立绘0100}「用剑啊枪啊\n捕捉猎物哟！\n---\n受伤的猎物\n每挣扎一次肉\n就会变难吃…\n---\n要一口气放倒哟！"
 },
 {
  "id": "017209",
  "file": "WORLD/AREAS058.EMI",
  "seg": 11,
  "src": "狩りマップ！",
  "tgt": "狩猎地图！"
 },
