 },
 {
  "id": "000269",
  "file": "SYSTEM/CAMP.EMI",
  "seg": 9,
  "src": "たべると、体がかるく感じます\n一人の早さを 1上げます",
  "tgt": "吃后感觉身体轻盈\n使1人速度提升1"
 },
 {
  "id": "000270",
  "file": "SYSTEM/CAMP.EMI",
  "seg": 9,
  "src": "あお身のサカナが、アタマに良いみたい\n一人の賢さを 1上げます",
  "tgt": "蓝身鱼似乎补脑\n使1人智慧提升1"
 },
 {
  "id": "000271",
  "file": "SYSTEM/CAMP.EMI",
  "seg": 9,
  "src": "神の国の果実\n全ドラゴンのHPを 全回復",
