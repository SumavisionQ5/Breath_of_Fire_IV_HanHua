 },
 {
  "id": "003006",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 10,
  "src": "さまざまな薬草から調合された ガン薬\n{引2 0D40}",
  "tgt": "由各种药草调制的丸药\n{引2 0D40}"
 },
 {
  "id": "003007",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 10,
  "src": "薬効成分を調整 純度がたかい元気玉\n{引2 0D40}",
  "tgt": "药效成分精调，纯度极高的元气玉\n{引2 0D40}"
 },
 {
  "id": "003008",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 10,
  "src": "生成率5% ハイクオリティな一品\n{引2 EF41}",
  "tgt": "生成率5%的高品质极品\n{引2 EF41}"
 },
 {
  "id": "003009",
