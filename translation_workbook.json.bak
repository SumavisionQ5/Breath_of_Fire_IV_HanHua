  "src": "‥{色0A}×{/色}",
  "tgt": "‥×{色0A}×{/色}"
 },
 {
  "id": "013419",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "‥{色0A}○{/色}",
  "tgt": "‥○{色0A}○{/色}"
 },
 {
  "id": "013420",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "5",
  "tgt": "5"
 },
 {
  "id": "013421",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "1",
  "tgt": "1"
 },
 {
  "id": "013422",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「ふん、ンなこと言って\nごちそうするだけの金‥\nアンタ 持ってるのか？{码14030C92}はい\nいいえ",
  "tgt": "「哼，嘴上说得好听\n请客的钱‥\n你身上有吗？有\n没有{码14030C92}はい\nいいえ"
 },
 {
  "id": "013423",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「ふーん‥{码0B}だったら\nもうちょっと{色03}カネ{/色}持って\n出直してくるんだな！",
  "tgt": "「哼～‥那就\n多带点钱\n再来吧！{码0B}だったら\nもうちょっと{色03}カネ{/色}持って\n出直してくるんだな！"
 },
 {
  "id": "013424",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{占位00}を {占位01}コ\n手に入れた！",
  "tgt": "{占位00}{占位01}个\n到手了！"
 },
 {
  "id": "013425",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「戦爭は、今\nお休みなんだってねぇ‥\n---\nまた始まったら\nヤダねぇ‥",
  "tgt": "「听说战争现在\n休战中呢‥\n---\n要再打起来\n可就讨厌啦‥"
 },
 {
  "id": "013426",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「この町の 近所で\n帝国のやつらを見たって\n話があるんだ‥\n---\nまた、戦爭でも\nおっぱじめる気かな‥",
  "tgt": "「听说有人在\n这镇子附近见过\n帝国的家伙‥\n---\n该不会又想\n挑起战争吧‥"
 },
 {
  "id": "013427",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "\n『{占位00}』を 手に入れた！",
  "tgt": "\n得到了『{占位00}』！"
 },
 {
  "id": "013428",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{金钱00}「いらっしゃい\nお泊りは{占位00}ゼニーですが\n休んで行かれますか？{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく",
  "tgt": "{金钱00}「欢迎光临\n住店{占位00}泽尼\n要休息一下吗？{码14860C93}住下再走\n只记录旅程\n还是算了"
 },
 {
  "id": "013429",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「あら？\nお金が足りませんわよ",
  "tgt": "「哎呀？\n钱不够了哟"
 },
 {
  "id": "013430",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「戦爭になったら\nチャンバや セネスタみたいに\n---\n呪われて しまうのかねぇ\n怖いねぇ‥",
  "tgt": "「真打起仗来\n会像占巴和塞内斯塔\n那样被咒沉吗‥\n---\n好可怕呀‥"
 },
 {
  "id": "013431",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「帝国の軍隊が、町に\n来てるって 話しだ‥\n---\nやっぱ、また戦爭か？",
  "tgt": "「听说帝国的军队\n进镇来了‥\n---\n果然，又要打仗了？"
 },
 {
  "id": "013432",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0B0A}「{特效}{/特效}{码08}ふぅ〜〜〜〜〜〜ぬ！{码0E}\n---\n{码0B}‥{码0B}‥{码0B}今のは アクビだふぬ。",
  "tgt": "{立绘0B0A}「呼——————奴！\n---\n‥‥刚那是打哈欠的说。{特效}{/特效}{码08}ふぅ〜〜〜〜〜〜ぬ！{码0E}\n---\n{码0B}‥{码0B}‥{码0B}今のは アクビだふぬ。"
 },
 {
  "id": "013433",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{码0A}\n---\n「ちちう。",
  "tgt": "{码0A}\n---\n「啾——。"
 },
 {
  "id": "013434",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「{特效}{/特效}\nべ、別に ネズミが\n怖くって{码0E}\n---\n{特效}{/特效}\nおりられない\nわけじゃ‥{码0B}{码0B}{码0B}ないわよ。{码0E}",
  "tgt": "「\n才，才不是\n因为怕老鼠\n---\n\n才待在\n这种地方的。{特效}{/特效}\nべ、別に ネズミが\n怖くって{码0E}\n---\n{特效}{/特效}\nおりられない\nわけじゃ‥{码0B}{码0B}{码0B}ないわよ。{码0E}"
 },
 {
  "id": "013435",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0303}「帝国の 連中が\n暴れていってから‥\n---\nめっきり 客が\n減っちまってね‥",
  "tgt": "{立绘0303}「帝国的家伙们\n来闹过之后‥\n---\n客人就\n一下子少喽‥"
 },
 {
  "id": "013436",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「君は いつかの‥\nずいぶん、たくましく\nなったね。",
  "tgt": "「你是那次的‥\n变得相当\n结实了呢。"
 },
 {
  "id": "013437",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「帝国で、呪砲が\n使われたって‥\n---\n旅の人から 闻いたけど\n本当かねぇ‥？",
  "tgt": "「听说帝国那边\n用了咒炮‥\n---\n是旅行的人说的\n是真的吗‥？"
 },
 {
  "id": "013438",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「この前、帝国兵が\n来たと思ったら\n今度は 呪砲か‥\n---\nやっぱり 戦爭‥\n始まるのかなあ？",
  "tgt": "「前阵子帝国兵\n刚来过\n这回又是咒炮‥\n---\n果然战争‥\n要开始了吗？"
 },
 {
  "id": "013439",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0303}「ここにいた客‥？\n---\nみんな ビビって\n逃げ归っちまったよ‥",
  "tgt": "{立绘0303}「之前在店的客人‥？\n---\n全都吓得\n逃回去了哟‥"
 },
 {
  "id": "013440",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「帝国の エラいさん‥\n顏にケガして、ザマぁなかったよ。",
  "tgt": "「帝国的大人物‥\n脸上挂了彩，真是活该。"
 },
 {
  "id": "013441",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「あの人達‥竜を\n探してたんだって？\n---\n戦爭しに 来たんじゃなくて\nホント、よかったよ。",
  "tgt": "「那些人‥说是\n在找龙？\n---\n不是来打仗的\n真是太好了。"
 },
 {
  "id": "013442",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「帝国のヤツら‥\n---\n暴れるのは、竜を\n捕まえる 時だけに\nして欲しいね‥",
  "tgt": "「帝国的家伙们‥\n---\n拜托他们撒野\n只限定在抓龙的\n时候吧‥"
 },
 {
  "id": "013443",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "かくれざとのおへや",
  "tgt": "隐里之屋"
 },
 {
  "id": "013444",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "「おやおや‥\n村の中、あるいてて\nケガしなかったかい？\n---\nせまい所だけど\n休んでお行きよ‥？{码14860C93}おことばに あまえて‥\n旅の記錄だけしよう\n今はいいです",
  "tgt": "「哎呀哎呀‥\n在村里走来走去\n没受伤吧？\n---\n地方虽小\n就歇歇脚吧‥？承蒙好意‥\n只做旅途记录\n现在不必{码14860C93}おことばに あまえて‥\n旅の記錄だけしよう\n今はいいです"
 },
 {
  "id": "013445",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "「どぅあらうてー。",
  "tgt": "「承蒙款待——。"
 },
 {
  "id": "013446",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "「このワナは‥\nトラばさみって 言ってね\n---\nバネの 弾き具合と\nトゲのするどさが\nポイントさ。",
  "tgt": "「这个陷阱呀‥\n叫捕兽夹\n---\n弹簧的弹力和\n尖刺的锋利度\n是关键。"
 },
 {
  "id": "013447",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "「ここの村長が‥\nワナの大好きな、変わり者で\n村中、ワナだらけでしょ？\n---\n危なっかしいのよ、これが！",
  "tgt": "「这村村长呀‥\n最爱陷阱，是个怪人\n全村到处都是陷阱吧？\n---\n这可真让人提心吊胆！"
 },
 {
  "id": "013448",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "「村長さん、言ってたよ。\n---\n村を 守るには\nワナをしかけるのが\nいちばんだって‥！",
  "tgt": "「村长说过哟‥\n---\n守护村子\n最好的办法\n就是布陷阱‥！"
 },
 {
  "id": "013449",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{立绘0000}「{码0A}{队员B0}ッワー\nヒッカカットルデ、ホンマ！",
  "tgt": "{立绘0000}「{码0A}{队员B0}——哇\n你上钩了哟，真的哟！"
 },
 {
  "id": "013450",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{立绘8040}「{码0A}{/色}オキャクサンヤー！\nアソブカな？\n---\n{立绘FFFF}{立绘0000}「{码0A}{占位72}ニスルネん？\n---\n{立绘FFFF}{立绘8040}「{码0A}{/色}アンタノ マケヤな！\n---\n{立绘FFFF}{立绘0000}「{码0A}{占位72}ンデヤネ{特效}{/特效}\n---\nん{码0E}！？\n---\n{立绘FFFF}{立绘8040}「{码0A}{队员CC}タ、アンタノ マケ！",
  "tgt": "{立绘8040}「{码0A}{/色}客人——哟！\n来玩一把吗？\n---\n{立绘FFFF}{立绘0000}「{码0A}{占位72}不理我吗？\n---\n{立绘FFFF}{立绘8040}「{码0A}{/色}是你输了嘛！\n---\n{立绘FFFF}{立绘0000}「{码0A}{占位72}胡说八道{特效}{/特效}\n---\n嗯{码0E}！？\n---\n{立绘FFFF}{立绘8040}「{码0A}{队员CC}是、是你输了！"
 },
 {
  "id": "013451",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "何だか、よく分からないが‥{码14000C13}村長の事を きいてみよう\n遊んでやろう\n無視しよう",
  "tgt": "也不太明白是怎么回事……{码14000C13}问问村长的事\n陪他玩玩\n无视他"
 },
 {
  "id": "013452",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{立绘8040}「{码0A}{/色}シリマヘンナ{特效}{/特效}\n---\nあ{码0E}‥\n---\n{立绘FFFF}{立绘0000}「{码0A}{占位5E}ソンデ クレヘント\nナニモ イイマヘ{特效}{/特效}\n---\nん{码0E}！\n---\n{立绘FFFF}{立绘8040}「{码0A}{队员AE}ンタノ マケ！",
  "tgt": "{立绘8040}「{码0A}{/色}我不知道呀{特效}{/特效}\n---\n诶{码0E}……\n---\n{立绘FFFF}{立绘0000}「{码0A}{占位5E}那你倒是\n什么都别说呀{特效}{/特效}\n---\n嗯{码0E}！\n---\n{立绘FFFF}{立绘8040}「{码0A}{队员AE}是你输了！"
 },
 {
  "id": "013453",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{立绘8040}「{码0A}{/色}ウレシイナア\nアソンデクレルン{特效}{/特效}\n---\nや{码0E}？{码14010C13}はい\nやだ\n何して遊ぶ？",
  "tgt": "{立绘8040}「好开心呀\n有人陪我玩\n---\n呀？好\n不要\n玩什么好？{码0A}{/色}ウレシイナア\nアソンデクレルン{特效}{/特效}\n---\nや{码0E}？{码14010C13}はい\nやだ\n何して遊ぶ？"
 },
 {
  "id": "013454",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{立绘0000}「{码0A}{占位5F}ケズ イワント\nアソンデクレ ッチュウネ{特效}{/特效}\n---\nん{码0E}\n---\n{立绘FFFF}{立绘8040}「{码0A}{队员AE}ンタノ マケ！",
  "tgt": "{立绘0000}「{码0A}{占位5F}不是说好\n陪我玩吗{特效}{/特效}\n---\n嗯{码0E}\n---\n{立绘FFFF}{立绘8040}「{码0A}{队员AE}是你输了！"
 },
 {
  "id": "013455",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{立绘0000}「{码0A}{队员A6}ーッ！ ハズレー！",
  "tgt": "{立绘0000}「{码0A}{队员A6}——！猜中了！"
 },
 {
  "id": "013456",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{立绘0000}「{码0A}{占位9F}ッテ サッキ\nアソブッテ ユータガ{特效}{/特效}\n---\nな{码0E}！\n---\n{立绘FFFF}{立绘8040}「{码0A}{/色}な、ナンジャソリ{特效}{/特效}\n---\nゃ{码0E}？{码14020C14}すみません\nそっちこそ、何？\nやっぱり遊びます\nやってられません",
  "tgt": "{立绘0000}「{码0A}{占位9F}你刚才\n不是说要玩吗{特效}{/特效}\n---\n呐{码0E}！\n---\n{立绘FFFF}{立绘8040}「{码0A}{/色}你、你在胡说什么{特效}{/特效}\n---\n呀{码0E}？{码14020C14}抱歉\n你那边才奇怪吧\n还是玩吧\n没法陪你玩了"
 },
 {
  "id": "013457",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{立绘8040}「{码0A}{队员AE}ンタノ マケ！",
  "tgt": "{立绘8040}「{码0A}{队员AE}你输了！"
 },
 {
  "id": "013458",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{立绘0000}「{码0A}{占位6A}、{码0B}ス、スバラシ{特效}{/特效}\n---\nい{码0E}！\n---\n{立绘FFFF}{立绘8040}「{码0A}{/色}いヤ ホンマ\nタイシタモンヤ{特效}{/特效}\n---\nで{码0E}！{码14030C15}いや、それほどでも\nありがとう\nえっへん\nでんでんむし\nふでばこ",
  "tgt": "{立绘0000}「{码0A}{占位6A}，{码0B}厉、厉害{特效}{/特效}\n---\n嘿{码0E}！\n---\n{立绘FFFF}{立绘8040}「{码0A}{/色}真是不简单\n有两下子{特效}{/特效}\n---\n嘿{码0E}！{码14030C15}哪，没什么\n谢谢\n哼哼\n蜗牛\n铅笔盒"
 },
 {
  "id": "013459",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{立绘0000}「{码0A}{占位69}？{码0B} シャーナイ{特效}{/特效}\n---\nな{码0E}\n---\n{立绘FFFF}{立绘8040}「{码0A}{/色}なンデモ キイテよ{码14040C12}村長の事を闻く\n何もない",
  "tgt": "{立绘0000}「{码0A}{占位69}？{码0B}真拿你没办法{特效}{/特效}\n---\n呐{码0E}\n---\n{立绘FFFF}{立绘8040}「{码0A}{/色}什么都问你哦{码14040C12}问问村长的事\n没什么"
 },
 {
  "id": "013460",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{立绘FFFF}{立绘0000}「{码0A}{队员B8}ヨカ。\nホナ、 サイナラ。",
  "tgt": "{立绘FFFF}{立绘0000}「{码0A}{队员B8}好嘞。\n那，再见啦。"
 },
 {
  "id": "013461",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{立绘0000}「ソンチョウ ヤッタラ\n{打字02}ニシ{码11}ノ モリニ オル。\n---\nヨウジガ アルンヤッタラ\nソッチ イキ。",
  "tgt": "{立绘0000}「村长的话\n{打字02}他{码11}在西边的森林里。\n---\n有事情的话\n就去找他吧。"
 },
 {
  "id": "013462",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{立绘0000}「{码0A}{/色}ナンヤ？{码14040C12}村長の事を闻く\n何もない",
  "tgt": "{立绘0000}「{码0A}{/色}干什么？{码14040C12}问问村长的事\n没什么"
 },
 {
  "id": "013463",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "どうやら、西にある森に\n行けという事らしい‥",
  "tgt": "看来意思是要我们\n去西边的森林‥"
 },
 {
  "id": "013464",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{立绘0101}「いやー‥\n村が ワナだらけで\nおどろいたかの？",
  "tgt": "{立绘0101}「哎呀～‥\n村里到处是陷阱\n吓到你们了？"
 },
 {
  "id": "013465",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{框03}{立绘0202}「ええ、{码0B}まあ‥",
  "tgt": "{框03}{立绘0202}「嗯，算是‥{码0B}まあ‥"
 },
 {
  "id": "013466",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{框04}{立绘8141}「しかし、これには\n大事なワケが あってな‥",
  "tgt": "{框04}{立绘8141}「不过，这里面\n可有重要的缘由‥"
 },
 {
  "id": "013467",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{框03}{立绘4100}「セネスタへの‥\n抜け道のこと、ですか？",
  "tgt": "{框03}{立绘4100}「是说去塞内斯塔的……\n那条密道吗？"
 },
 {
  "id": "013468",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{框04}{立绘8141}「なんだ、知っておったか‥",
  "tgt": "{框04}{立绘8141}「怎么，早知道了呀‥"
 },
 {
  "id": "013469",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{立绘8141}「そう、ここには\nセネスタへの 抜け道が\nあってな‥",
  "tgt": "{立绘8141}「对，这里有\n通往塞内斯塔的\n密道‥"
 },
 {
  "id": "013470",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{立绘8141}「大戦のときには\nたくさんの人が‥\n---\nセネスタから 抜け道で\n逃げてきたのだ‥",
  "tgt": "{立绘8141}「大战的时候\n有许多人‥\n---\n就是从塞内斯塔\n经由密道逃来的‥"
 },
 {
  "id": "013471",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{框04}{立绘8141}「で、まぁ‥\n戦爭が終わった後も‥\n---\nイザという時に\n安心して 逃げて来れるよう\n抜け道を 守っておるんだ。",
  "tgt": "{框04}{立绘8141}「所以嘛‥\n战争结束后也‥\n---\n为了让人在万一之时\n能安心逃到这里\n一直守着密道呢。"
 },
 {
  "id": "013472",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{框03}{立绘4200}「それで、村長‥\nわれわれは、その抜け道を\n使いたいのだが‥？",
  "tgt": "{框03}{立绘4200}「那么，村长……\n我们想借用\n那条密道……可以吗？"
 },
 {
  "id": "013473",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{框04}{立绘8141}「え‥、うーむ‥{码0B}‥{码0B}‥\n---\nま、いいだろう‥\nあんたら、帝国の連中には\n見えないしな‥",
  "tgt": "{框04}{立绘8141}「诶‥，嗯‥‥‥\n---\n嘛，也行吧‥\n你们这群人\n看着不像帝国的‥{码0B}‥{码0B}‥\n---\nま、いいだろう‥\nあんたら、帝国の連中には\n見えないしな‥"
 },
 {
  "id": "013474",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{框04}{立绘8141}「明日のあさに\n抜け道の 入り口を\n開けさせるんで‥\n---\n今夜は、まあ\n何もないところだが\nこの村で、休んでいきなさい。",
  "tgt": "{框04}{立绘8141}「明天一早\n我会让人打开\n密道入口‥\n---\n今晚嘛，这里虽然\n什么都没有\n就在村里休息吧。"
 },
 {
  "id": "013475",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{立绘0000}「{码0A}{队员CC}タキテチョー！",
  "tgt": "{立绘0000}「{码0A}{队员CC}大英雄——！"
 },
 {
  "id": "013476",
  "file": "WORLD/AREAS005.EMI",
  "seg": 11,
  "src": "{立绘8141}「うん？ {码0B}{码0B}うーむ‥\n---\n新しい ワナが\nもう少しで、思いつき\nそうなんじゃが‥",
  "tgt": "{立绘8141}「嗯？嗯～‥\n---\n新陷阱的点子\n马上就要\n想出来了‥{码0B}{码0B}うーむ‥\n---\n新しい ワナが\nもう少しで、思いつき\nそうなんじゃが‥"
 },
 {
  "id": "013477",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "どんきちしつない",
  "tgt": "团吉室内"
 },
 {
  "id": "013478",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0000}「あら、{码0B}お客さんとは\nめずらしい‥\n---\nぼく、ここのリーダーの\nタブって者です。\n---\n‥今、ごはんだから\nご用があるんなら\nちょっと待ってね。{码14000C12}じゃあ、町でも ぶらつこう\nここで しばらく待とう",
  "tgt": "{立绘0000}「哎呀，{码0B}客人\n真是稀客……\n---\n我是这里的\n领头人，叫塔布。\n---\n……现在正吃饭\n有事的话\n请稍等一下。{码14000C12}那去镇上逛逛\n就在这里等等"
 },
 {
  "id": "013479",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0000}「そうね、何もない所だけど\nひと回りして来てよ。",
  "tgt": "{立绘0000}「也好，这里没什么好玩的\n去转一圈再回来吧。"
 },
 {
  "id": "013480",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0000}「ん、{码0B}ここで待つ？\n町でも おさんぽして\nまた来てくれても、いいよ？{码14010C12}やっぱり町を回ってこよう\nいや、ここで待ちます",
  "tgt": "{立绘0000}「嗯，{码0B}要在这里等？\n也可以去镇上\n散散步再回来哟？{码14010C12}还是去镇上逛逛\n不，就在这里等"
 },
 {
  "id": "013481",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0000}「あ、そう‥\nじゃ、ささっと食べるよ。",
  "tgt": "{立绘0000}「啊，好……\n那我快点吃完。"
 },
 {
  "id": "013482",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0101}「呪いを防ぐ、ヨロイは\nやたら重いから‥\n---\n動き回ると、ハラ減るよ。",
  "tgt": "{立绘0101}「防诅咒的铠甲\n重得要命‥\n---\n一活动就饿了呢。"
 },
 {
  "id": "013483",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0202}「ちょっと、呪いに\nやられたかなぁ‥\n---\n身体の調子、わるいや。",
  "tgt": "{立绘0202}「好像被诅咒\n伤到一点‥\n---\n身体状态，很差呀。"
 },
 {
  "id": "013484",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0303}「あっちの、ナベの前に\n立ってるのが‥\n---\n俺達の、親方だよ\nもぐまぐ。",
  "tgt": "{立绘0303}「站在那边\n锅前面的就是‥\n---\n我们的工头哟\n咕叽咕叽。"
 },
 {
  "id": "013485",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0404}「呪い、ってのは\n悪口みたいな物かな‥\n---\n悪口、言われると\n気分いいもんじゃ、ねぇだろ？\n---\nそれを、ずっと強力にしたのが\n呪いってワケさ‥",
  "tgt": "{立绘0404}「诅咒，就像\n恶语相向差不多吧‥\n---\n被人恶语中伤\n心情肯定好不了吧？\n---\n把那个强力放大\n就是所谓的诅咒‥"
 },
 {
  "id": "013486",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0505}「戦爭で使われた呪いは\nまっ黒な、キリみたいで‥\n---\nその中に、悪靈どもが\nウジャウジャいるんだ‥\n---\nヨロイ無しで、くらったら\nアっと言う間に、死んじまう！",
  "tgt": "{立绘0505}「战争中使用的诅咒\n像漆黑的浓雾‥\n---\n里面挤满了\n恶灵‥\n---\n不穿铠甲吸上一口\n眨眼间就死！"
 },
 {
  "id": "013487",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0606}「女子供の、来るような\n場所じゃないぜ‥\n---\n呪われちまうぞ！？",
  "tgt": "{立绘0606}「可不是女人小孩\n来的地方‥\n---\n会被诅咒的！？"
 },
 {
  "id": "013488",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{框03}{立绘0000}「お待たせ‥\nで、どんなご用です？",
  "tgt": "{框03}{立绘0000}「久等了……\n那么，什么事？"
 },
 {
  "id": "013489",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{框04}{立绘C140}「あの‥、わたしたち\nチャンバの町を\n通り抜けたいんですけど‥\n---\n呪いが消えるまで\n無理なんですか？",
  "tgt": "{框04}{立绘C140}「那个‥，我们\n想穿过\n占巴镇‥\n---\n诅咒不散\n就没办法吗？"
 },
 {
  "id": "013490",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{框03}{立绘0000}「無理ね。\n---\n呪いのキリの中には\n邪悪なものが、たくさんいて‥\n---\n特別なヨロイを 着てないと\n立ち入れないの‥",
  "tgt": "{框03}{立绘0000}「不行。\n---\n诅咒之雾里\n住着许多邪恶的东西……\n---\n不穿上特别的铠甲\n就进不去……"
 },
 {
  "id": "013491",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{框03}{立绘0000}「呪いを 消しおわって\n町が、元どおりになるには‥\n---\nまだ、一年ぐらい\nかかるかな‥",
  "tgt": "{框03}{立绘0000}「要消完诅咒\n让镇子恢复原样……\n---\n还得再花\n一年左右吧……"
 },
 {
  "id": "013492",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{框03}{立绘0000}「でも まあ、{码0B}今すぐ\n通りたいって言うなら‥",
  "tgt": "{框03}{立绘0000}「不过嘛，{码0B}要是想\n马上过去的话……"
 },
 {
  "id": "013493",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{框03}{立绘0000}「仲間の誰かを\nガイドにして、案內させれば‥\n---\n何とか、行けなくもないかな。",
  "tgt": "{框03}{立绘0000}「让同伴中的谁\n当向导带路的话……\n---\n想办法\n也不是过不去。"
 },
 {
  "id": "013494",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{框04}{立绘C140}「つまり、誰かに\nガイドが お願いできれば\nいいんですね‥？{码0B}{码0B}{码0B}{引1200}",
  "tgt": "{框04}{立绘C140}「也就是说\n只要能请到向导\n就可以了‥？{码0B}{码0B}{码0B}{引1200}"
 },
 {
  "id": "013495",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「ま、そう言う事。",
  "tgt": "{框05}{立绘0000}「嘛，就是这么回事。"
 },
 {
  "id": "013496",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0000}「ちなみに、ぼくは\nお役に立てないよ‥\n---\n呪いの中に、連れて行くのは\n危険すぎるからね。",
  "tgt": "{立绘0000}「顺便说一句\n我可帮不上忙哦……\n---\n带进诅咒里\n实在太危险了。"
 },
 {
  "id": "013497",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0404}「呪いの中に入る‥？\nヨロイなしで！？\n---\nだめだめ、そんなの\n死んじまうよ！",
  "tgt": "{立绘0404}「不穿铠甲\n进诅咒区‥？\n---\n不行不行，那样\n会死的哟！"
 },
 {
  "id": "013498",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0505}「たしかに‥、呪いが消えて\n通れる部分もあるけど‥\n---\nでも、やっぱり\nやばいよ‥",
  "tgt": "{立绘0505}「确实‥，诅咒散去\n能走通的地方也有‥\n---\n但还是\n很危险哟‥"
 },
 {
  "id": "013499",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0606}「呪いの中を\n案內してほしいって？\n---\n呪いの怖さを 知らないから\nそんなこと言えるんだ‥",
  "tgt": "{立绘0606}「说要人带路\n穿诅咒区？\n---\n因为不知道诅咒\n多可怕才敢这么说‥"
 },
 {
  "id": "013500",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0707}「ここの人たちは\nみんな、お仕事に\n行ってもうた‥\n---\n{金钱00}わしは、おるすばん\nやねんけど‥\n何か買うてくれるか？{码14840C94}買い物しよう\n何か売ろう\n下取りしてもらおう\nやめておこう",
  "tgt": "{立绘0707}「这里的人都\n出去干活了……\n---\n{金钱00}我是在\n看家呢……\n要不要买点什么？{码14840C94}买点什么\n卖点什么\n折价回收\n这次算了吧"
 },
 {
  "id": "013501",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0707}{金钱00}「やあ、何か買うて‥\n防呪ヨロイは 無いけどな。{码14840C94}買い物しよう\n何か売ろう\n下取りしてもらおう\nやめておこう",
  "tgt": "{立绘0707}{金钱00}「来，买点什么吧……\n不过防咒铠甲\n是没有的。{码14840C94}买点什么\n卖点什么\n折价回收\n这次算了吧"
 },
 {
  "id": "013502",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0404}「え、行くんだ‥！？\n知らないよ‥、どうなっても。",
  "tgt": "{立绘0404}「诶，要去‥！？\n出了事我可不管哟。"
 },
 {
  "id": "013503",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0404}「{队员05}‥、お前\nひきうけた からには\nちゃんとやれよ！？",
  "tgt": "{立绘0404}「{队员05}‥，你\n既然接了\n就要好好干呀！？"
 },
 {
  "id": "013504",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0505}「呪いのキリに、さわったら‥\n---\n毒にやられたり\n頭が変になったり\n大ダメージを受けたり‥\n---\nとにかく、ロクな事ないから\nさわらないようにね！",
  "tgt": "{立绘0505}「碰到诅咒的雾‥\n---\n会中毒\n脑子会变怪\n受大伤害‥\n---\n总之没半点好处\n千万别碰！"
 },
 {
  "id": "013505",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0505}「{队员05}、{码0B}お前は\n呪いが防げるんだから‥\n---\nこの人たちを、ちゃんと\n守ってやれよ。",
  "tgt": "{立绘0505}「{队员05}，你能\n防住诅咒‥\n---\n就好好\n保护这些人哟。{码0B}お前は\n呪いが防げるんだから‥\n---\nこの人たちを、ちゃんと\n守ってやれよ。"
 },
 {
  "id": "013506",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0606}「{队员05}の案內で\n呪いの中に入るって！？\n---\n恐いことするなぁ‥",
  "tgt": "{立绘0606}「由{队员05}带路\n进诅咒区！？\n---\n干吓人的事呀‥"
 },
 {
  "id": "013507",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0606}「おまえって、変な奴だと\n思ってたけど‥\n---\nほんとに、変な事\nひきうけたなぁ‥",
  "tgt": "{立绘0606}「我一直觉得\n你是个怪家伙‥\n---\n没想到真接了\n这么怪的活呀‥"
 },
 {
  "id": "013508",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0808}「町の中心部は\n入り組んでるから‥\n---\n迷わないようにな。",
  "tgt": "{立绘0808}「镇子中心地带\n道路纵横交错‥\n---\n可别迷路了。"
 },
 {
  "id": "013509",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0808}「おい、{队员05}‥\n目の前で、死なれないよう\n気をつけなよ。",
  "tgt": "{立绘0808}「喂，{队员05}‥\n可别让人\n死在眼前呀。"
 },
 {
  "id": "013510",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "「ん、休みたいなら\nベッド‥かしてあげるけど？{码14860C93}休む\n旅の記錄だけする\n今はやめておく",
  "tgt": "「嗯，想休息的话\n床‥可以借你哟？休息\n只做旅途记录\n现在算了{码14860C93}休む\n旅の記錄だけする\n今はやめておく"
 },
 {
  "id": "013511",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0101}「みんな、仕事に\n出かけちまったよ‥\n---\nおれは、{码0B}まあ なんだ\n体調不良ってやつだ‥",
  "tgt": "{立绘0101}「大家\n都出门干活去了‥\n---\n我嘛，算是\n身体不适吧‥{码0B}まあ なんだ\n体調不良ってやつだ‥"
 },
 {
  "id": "013512",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0808}「最近、仕事する気が\nうすれちゃってね‥\n---\nこれも 呪いのせいだよ\nああ、きっとそうさ。",
  "tgt": "{立绘0808}「最近干活的\n劲头都没了‥\n---\n这也是诅咒的错\n唉，肯定是。"
 },
 {
  "id": "013513",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0404}「ここの呪いは\nそうとう手強いな‥\n---\nセネスタでの作業は\nさっさと\nカタがついたんだが‥",
  "tgt": "{立绘0404}「这里的诅咒\n相当难缠呀‥\n---\n在塞内斯塔的活\n早就\n收尾了‥"
 },
 {
  "id": "013514",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0101}「わかったよ、{队员05}\nこれ食ったら\nすぐ仕事に行くって‥",
  "tgt": "{立绘0101}「知道了，{队员05}\n吃完这个\n就马上去干活‥"
 },
 {
  "id": "013515",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0404}「そういや、{队员05}は\nセネスタで 仕事してた時は\nまだいなかったよな？",
  "tgt": "{立绘0404}「说起来，在塞内斯塔\n干活的时候\n{队员05}还没来着？"
 },
 {
  "id": "013516",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0808}「遲かったな {队员05}\n---\n‥町の中心部で\n迷ってたんじゃないのか？",
  "tgt": "{立绘0808}「够慢的呀{队员05}\n---\n‥该不会在\n镇子中心迷路了吧？"
 },
 {
  "id": "013517",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0303}「もうすぐ ここも‥\n---\nセネスタみたいに\n人が戻ってくるよ\nもぐまぐ。",
  "tgt": "{立绘0303}「这里很快也会‥\n---\n像塞内斯塔一样\n人回来的\n咕叽咕叽。"
 },
 {
  "id": "013518",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0909}「ここでの 仕事が\n終わったら\n---\n俺達‥これから\nどうしたら いいんだ？\n---\n{立绘FFFF}{立绘8A4A}「また 戦爭が\n始まっちまえば‥\n---\nいやでも お声が\nかかるって。",
  "tgt": "{立绘0909}「这里的活\n干完之后‥\n---\n我们‥接下来\n该怎么办呀？\n---\n{立绘FFFF}{立绘8A4A}「等战争\n再打起来‥\n---\n自然有人来\n叫我们。"
 },
 {
  "id": "013519",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0000}「あら、ひさしぶり‥\n---\nもうすぐ ここの呪いも\n消えてなくなるよ\n---\n私達も、めでたく\n戦爭の シリぬぐいから\n解放‥ってわけね。",
  "tgt": "{立绘0000}「哎呀，好久不见……\n---\n这里的诅咒\n马上就要消散了\n---\n我们也终于\n能从战争的\n烂摊子里解脱了呢。"
 },
 {
  "id": "013520",
  "file": "WORLD/AREAS007.EMI",
  "seg": 11,
  "src": "{立绘0A0A}「町のおくに、魚みたいな\nバケモンが 出るって話‥\n闻いたか？\n---\n{立绘FFFF}{立绘8949}「ああ、この呪いだ‥\n---\nおかしなモンが\n生まれても\nおかしく ないからな。",
  "tgt": "{立绘0A0A}「听说镇子深处\n出现了像鱼一样的\n怪物‥\n---\n{立绘FFFF}{立绘8949}「嗯，拜这诅咒所赐‥\n---\n就算生出了\n什么怪东西\n也不稀奇呀。"
 },
 {
  "id": "013521",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "どんきちしつない",
  "tgt": "团吉室内"
 },
 {
  "id": "013522",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0000}「あら、{码0B}お客さんとは\nめずらしい‥\n---\nぼく、ここのリーダーの\nタブって者です。\n---\n‥今、ごはんだから\nご用があるんなら\nちょっと待ってね。{码14000C12}じゃあ、町でも ぶらつこう\nここで しばらく待とう",
  "tgt": "{立绘0000}「哎呀，{码0B}客人\n真是稀客……\n---\n我是这里的\n领头人，叫塔布。\n---\n……现在正吃饭\n有事的话\n请稍等一下。{码14000C12}那去镇上逛逛\n就在这里等等"
 },
 {
  "id": "013523",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0000}「そうね、何もない所だけど\nひと回りして来てよ。",
  "tgt": "{立绘0000}「也好，这里没什么好玩的\n去转一圈再回来吧。"
 },
 {
  "id": "013524",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0000}「ん、{码0B}ここで待つ？\n町でも おさんぽして\nまた来てくれても、いいよ？{码14010C12}やっぱり町を回ってこよう\nいや、ここで待ちます",
  "tgt": "{立绘0000}「嗯，{码0B}要在这里等？\n也可以去镇上\n散散步再回来哟？{码14010C12}还是去镇上逛逛\n不，就在这里等"
 },
 {
  "id": "013525",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0000}「あ、そう‥\nじゃ、ささっと食べるよ。",
  "tgt": "{立绘0000}「啊，好……\n那我快点吃完。"
 },
 {
  "id": "013526",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0101}「呪いを防ぐ、ヨロイは\nやたら重いから‥\n---\n動き回ると、ハラ減るよ。",
  "tgt": "{立绘0101}「防诅咒的铠甲\n重得要命‥\n---\n一活动就饿了呢。"
 },
 {
  "id": "013527",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0202}「ちょっと、呪いに\nやられたかなぁ‥\n---\n身体の調子、わるいや。",
  "tgt": "{立绘0202}「好像被诅咒\n伤到一点‥\n---\n身体状态，很差呀。"
 },
 {
  "id": "013528",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0303}「あっちの、ナベの前に\n立ってるのが‥\n---\n俺達の、親方だよ\nもぐまぐ。",
  "tgt": "{立绘0303}「站在那边\n锅前面的就是‥\n---\n我们的工头哟\n咕叽咕叽。"
 },
 {
  "id": "013529",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0404}「呪い、ってのは\n悪口みたいな物かな‥\n---\n悪口、言われると\n気分いいもんじゃ、ねぇだろ？\n---\nそれを、ずっと強力にしたのが\n呪いってワケさ‥",
  "tgt": "{立绘0404}「诅咒，就像\n恶语相向差不多吧‥\n---\n被人恶语中伤\n心情肯定好不了吧？\n---\n把那个强力放大\n就是所谓的诅咒‥"
 },
 {
  "id": "013530",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0505}「戦爭で使われた呪いは\nまっ黒な、キリみたいで‥\n---\nその中に、悪靈どもが\nウジャウジャいるんだ‥\n---\nヨロイ無しで、くらったら\nアっと言う間に、死んじまう！",
  "tgt": "{立绘0505}「战争中使用的诅咒\n像漆黑的浓雾‥\n---\n里面挤满了\n恶灵‥\n---\n不穿铠甲吸上一口\n眨眼间就死！"
 },
 {
  "id": "013531",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0606}「女子供の、来るような\n場所じゃないぜ‥\n---\n呪われちまうぞ！？",
  "tgt": "{立绘0606}「可不是女人小孩\n来的地方‥\n---\n会被诅咒的！？"
 },
 {
  "id": "013532",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{框03}{立绘0000}「お待たせ‥\nで、どんなご用です？",
  "tgt": "{框03}{立绘0000}「久等了……\n那么，什么事？"
 },
 {
  "id": "013533",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{框04}{立绘C140}「あの‥、わたしたち\nチャンバの町を\n通り抜けたいんですけど‥\n---\n呪いが消えるまで\n無理なんですか？",
  "tgt": "{框04}{立绘C140}「那个‥，我们\n想穿过\n占巴镇‥\n---\n诅咒不散\n就没办法吗？"
 },
 {
  "id": "013534",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{框03}{立绘0000}「無理ね。\n---\n呪いのキリの中には\n邪悪なものが、たくさんいて‥\n---\n特別なヨロイを 着てないと\n立ち入れないの‥",
  "tgt": "{框03}{立绘0000}「不行。\n---\n诅咒之雾里\n住着许多邪恶的东西……\n---\n不穿上特别的铠甲\n就进不去……"
 },
 {
  "id": "013535",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{框03}{立绘0000}「呪いを 消しおわって\n町が、元どおりになるには‥\n---\nまだ、一年ぐらい\nかかるかな‥",
  "tgt": "{框03}{立绘0000}「要消完诅咒\n让镇子恢复原样……\n---\n还得再花\n一年左右吧……"
 },
 {
  "id": "013536",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{框03}{立绘0000}「でも まあ、{码0B}今すぐ\n通りたいって言うなら‥",
  "tgt": "{框03}{立绘0000}「不过嘛，{码0B}要是想\n马上过去的话……"
 },
 {
  "id": "013537",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{框03}{立绘0000}「仲間の誰かを\nガイドにして、案內させれば‥\n---\n何とか、行けなくもないかな。",
  "tgt": "{框03}{立绘0000}「让同伴中的谁\n当向导带路的话……\n---\n想办法\n也不是过不去。"
 },
 {
  "id": "013538",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{框04}{立绘C140}「つまり、誰かに\nガイドが お願いできれば\nいいんですね‥？{码0B}{码0B}{码0B}{引1200}",
  "tgt": "{框04}{立绘C140}「也就是说\n只要能请到向导\n就可以了‥？{码0B}{码0B}{码0B}{引1200}"
 },
 {
  "id": "013539",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「ま、そう言う事。",
  "tgt": "{框05}{立绘0000}「嘛，就是这么回事。"
 },
 {
  "id": "013540",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0000}「ちなみに、ぼくは\nお役に立てないよ‥\n---\n呪いの中に、連れて行くのは\n危険すぎるからね。",
  "tgt": "{立绘0000}「顺便说一句\n我可帮不上忙哦……\n---\n带进诅咒里\n实在太危险了。"
 },
 {
  "id": "013541",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0404}「呪いの中に入る‥？\nヨロイなしで！？\n---\nだめだめ、そんなの\n死んじまうよ！",
  "tgt": "{立绘0404}「不穿铠甲\n进诅咒区‥？\n---\n不行不行，那样\n会死的哟！"
 },
 {
  "id": "013542",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0505}「たしかに‥、呪いが消えて\n通れる部分もあるけど‥\n---\nでも、やっぱり\nやばいよ‥",
  "tgt": "{立绘0505}「确实‥，诅咒散去\n能走通的地方也有‥\n---\n但还是\n很危险哟‥"
 },
 {
  "id": "013543",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0606}「呪いの中を\n案內してほしいって？\n---\n呪いの怖さを 知らないから\nそんなこと言えるんだ‥",
  "tgt": "{立绘0606}「说要人带路\n穿诅咒区？\n---\n因为不知道诅咒\n多可怕才敢这么说‥"
 },
 {
  "id": "013544",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0707}「ここの人たちは\nみんな、お仕事に\n行ってもうた‥\n---\n{金钱00}わしは、おるすばん\nやねんけど‥\n何か買うてくれるか？{码14840C94}買い物しよう\n何か売ろう\n下取りしてもらおう\nやめておこう",
  "tgt": "{立绘0707}「这里的人都\n出去干活了……\n---\n{金钱00}我是在\n看家呢……\n要不要买点什么？{码14840C94}买点什么\n卖点什么\n折价回收\n这次算了吧"
 },
 {
  "id": "013545",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0707}{金钱00}「やあ、何か買うて‥\n防呪ヨロイは 無いけどな。{码14840C94}買い物しよう\n何か売ろう\n下取りしてもらおう\nやめておこう",
  "tgt": "{立绘0707}{金钱00}「来，买点什么吧……\n不过防咒铠甲\n是没有的。{码14840C94}买点什么\n卖点什么\n折价回收\n这次算了吧"
 },
 {
  "id": "013546",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0404}「え、行くんだ‥！？\n知らないよ‥、どうなっても。",
  "tgt": "{立绘0404}「诶，要去‥！？\n出了事我可不管哟。"
 },
 {
  "id": "013547",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0404}「{队员05}‥、お前\nひきうけた からには\nちゃんとやれよ！？",
  "tgt": "{立绘0404}「{队员05}‥，你\n既然接了\n就要好好干呀！？"
 },
 {
  "id": "013548",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0505}「呪いのキリに、さわったら‥\n---\n毒にやられたり\n頭が変になったり\n大ダメージを受けたり‥\n---\nとにかく、ロクな事ないから\nさわらないようにね！",
  "tgt": "{立绘0505}「碰到诅咒的雾‥\n---\n会中毒\n脑子会变怪\n受大伤害‥\n---\n总之没半点好处\n千万别碰！"
 },
 {
  "id": "013549",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0505}「{队员05}、{码0B}お前は\n呪いが防げるんだから‥\n---\nこの人たちを、ちゃんと\n守ってやれよ。",
  "tgt": "{立绘0505}「{队员05}，你能\n防住诅咒‥\n---\n就好好\n保护这些人哟。{码0B}お前は\n呪いが防げるんだから‥\n---\nこの人たちを、ちゃんと\n守ってやれよ。"
 },
 {
  "id": "013550",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0606}「{队员05}の案內で\n呪いの中に入るって！？\n---\n恐いことするなぁ‥",
  "tgt": "{立绘0606}「由{队员05}带路\n进诅咒区！？\n---\n干吓人的事呀‥"
 },
 {
  "id": "013551",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0606}「おまえって、変な奴だと\n思ってたけど‥\n---\nほんとに、変な事\nひきうけたなぁ‥",
  "tgt": "{立绘0606}「我一直觉得\n你是个怪家伙‥\n---\n没想到真接了\n这么怪的活呀‥"
 },
 {
  "id": "013552",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0808}「町の中心部は\n入り組んでるから‥\n---\n迷わないようにな。",
  "tgt": "{立绘0808}「镇子中心地带\n道路纵横交错‥\n---\n可别迷路了。"
 },
 {
  "id": "013553",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0808}「おい、{队员05}‥\n目の前で、死なれないよう\n気をつけなよ。",
  "tgt": "{立绘0808}「喂，{队员05}‥\n可别让人\n死在眼前呀。"
 },
 {
  "id": "013554",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "「ん、休みたいなら\nベッド‥かしてあげるけど？{码14860C93}休む\n旅の記錄だけする\n今はやめておく",
  "tgt": "「嗯，想休息的话\n床‥可以借你哟？休息\n只做旅途记录\n现在算了{码14860C93}休む\n旅の記錄だけする\n今はやめておく"
 },
 {
  "id": "013555",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0101}「みんな、仕事に\n出かけちまったよ‥\n---\nおれは、{码0B}まあ なんだ\n体調不良ってやつだ‥",
  "tgt": "{立绘0101}「大家\n都出门干活去了‥\n---\n我嘛，算是\n身体不适吧‥{码0B}まあ なんだ\n体調不良ってやつだ‥"
 },
 {
  "id": "013556",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0808}「最近、仕事する気が\nうすれちゃってね‥\n---\nこれも 呪いのせいだよ\nああ、きっとそうさ。",
  "tgt": "{立绘0808}「最近干活的\n劲头都没了‥\n---\n这也是诅咒的错\n唉，肯定是。"
 },
 {
  "id": "013557",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0404}「ここの呪いは\nそうとう手強いな‥\n---\nセネスタでの作業は\nさっさと\nカタがついたんだが‥",
  "tgt": "{立绘0404}「这里的诅咒\n相当难缠呀‥\n---\n在塞内斯塔的活\n早就\n收尾了‥"
 },
 {
  "id": "013558",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0101}「わかったよ、{队员05}\nこれ食ったら\nすぐ仕事に行くって‥",
  "tgt": "{立绘0101}「知道了，{队员05}\n吃完这个\n就马上去干活‥"
 },
 {
  "id": "013559",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0404}「そういや、{队员05}は\nセネスタで 仕事してた時は\nまだいなかったよな？",
  "tgt": "{立绘0404}「说起来，在塞内斯塔\n干活的时候\n{队员05}还没来着？"
 },
 {
  "id": "013560",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0808}「遲かったな {队员05}\n---\n‥町の中心部で\n迷ってたんじゃないのか？",
  "tgt": "{立绘0808}「够慢的呀{队员05}\n---\n‥该不会在\n镇子中心迷路了吧？"
 },
 {
  "id": "013561",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0303}「もうすぐ ここも‥\n---\nセネスタみたいに\n人が戻ってくるよ\nもぐまぐ。",
  "tgt": "{立绘0303}「这里很快也会‥\n---\n像塞内斯塔一样\n人回来的\n咕叽咕叽。"
 },
 {
  "id": "013562",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0909}「ここでの 仕事が\n終わったら\n---\n俺達‥これから\nどうしたら いいんだ？\n---\n{立绘FFFF}{立绘8A4A}「また 戦爭が\n始まっちまえば‥\n---\nいやでも お声が\nかかるって。",
  "tgt": "{立绘0909}「这里的活\n干完之后‥\n---\n我们‥接下来\n该怎么办呀？\n---\n{立绘FFFF}{立绘8A4A}「等战争\n再打起来‥\n---\n自然有人来\n叫我们。"
 },
 {
  "id": "013563",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0000}「あら、ひさしぶり‥\n---\nもうすぐ ここの呪いも\n消えてなくなるよ\n---\n私達も、めでたく\n戦爭の シリぬぐいから\n解放‥ってわけね。",
  "tgt": "{立绘0000}「哎呀，好久不见……\n---\n这里的诅咒\n马上就要消散了\n---\n我们也终于\n能从战争的\n烂摊子里解脱了呢。"
 },
 {
  "id": "013564",
  "file": "WORLD/AREAS008.EMI",
  "seg": 11,
  "src": "{立绘0A0A}「町のおくに、魚みたいな\nバケモンが 出るって話‥\n闻いたか？\n---\n{立绘FFFF}{立绘8949}「ああ、この呪いだ‥\n---\nおかしなモンが\n生まれても\nおかしく ないからな。",
  "tgt": "{立绘0A0A}「听说镇子深处\n出现了像鱼一样的\n怪物‥\n---\n{立绘FFFF}{立绘8949}「嗯，拜这诅咒所赐‥\n---\n就算生出了\n什么怪东西\n也不稀奇呀。"
 },
 {
  "id": "013565",
  "file": "WORLD/AREAS009.EMI",
  "seg": 11,
  "src": "{立绘8040}「{码0A}\n---\nワンッ！",
  "tgt": "{立绘8040}「\n---\n汪！{码0A}\n---\nワンッ！"
 },
 {
  "id": "013566",
  "file": "WORLD/AREAS009.EMI",
  "seg": 11,
  "src": "{立绘8141}「ホゥ‥\n---\nこんな‥ ガラクタしか\nない所に、何の用だね？",
  "tgt": "{立绘8141}「嚯‥\n---\n到这种‥只有破烂的\n地方来，有何贵干？"
 },
 {
  "id": "013567",
  "file": "WORLD/AREAS009.EMI",
  "seg": 11,
  "src": "{立绘8141}「フム、ホウ‥{码0B} なるほど\n部品を探しに かァ‥\n---\nまあそうだなァ 確かに‥",
  "tgt": "{立绘8141}「嗯，嚯‥原来如此\n是来找零件的呀‥\n---\n嘛，确实也是‥{码0B} なるほど\n部品を探しに かァ‥\n---\nまあそうだなァ 確かに‥"
 },
 {
  "id": "013568",
  "file": "WORLD/AREAS009.EMI",
  "seg": 11,
  "src": "{立绘8141}「そうかい、用があったら\nまた声をかけてくれよ‥",
  "tgt": "{立绘8141}「这样呀，有事\n再叫我一声‥"
 },
 {
  "id": "013569",
  "file": "WORLD/AREAS009.EMI",
  "seg": 11,
  "src": "{立绘8141}「じゃあ 25ゼニー\nいただこうか",
  "tgt": "{立绘8141}「那就收你\n25泽尼吧"
 },
 {
  "id": "013570",
  "file": "WORLD/AREAS009.EMI",
  "seg": 11,
  "src": "{立绘8141}「ありがとうよ、それじゃ\n張り切って探してきてくれ！",
  "tgt": "{立绘8141}「谢啦，那就\n加油去挖吧！"
 },
 {
  "id": "013571",
  "file": "WORLD/AREAS009.EMI",
  "seg": 11,
  "src": "{立绘8141}「なら50ゼニー\nいただくよ",
  "tgt": "{立绘8141}「那就收你\n50泽尼"
 },
 {
  "id": "013572",
  "file": "WORLD/AREAS009.EMI",
  "seg": 11,
  "src": "{立绘8141}「スコップ 壊れちまったか\nまあ、しょうがないなァ‥\n---\nまた 用がある時は\n一声かけてくれ",
  "tgt": "{立绘8141}「铲子坏了吗\n嘛，没法子呀‥\n---\n有事的时候\n再叫我一声"
 },
 {
  "id": "013573",
  "file": "WORLD/AREAS009.EMI",
  "seg": 11,
  "src": "{立绘8040}「{码0A}\n---\nワンッ！",
  "tgt": "{立绘8040}「\n---\n汪！{码0A}\n---\nワンッ！"
 },
 {
  "id": "013574",
  "file": "WORLD/AREAS009.EMI",
  "seg": 11,
  "src": "{立绘8141}「スコップと砂犬‥\nもう一度 かりてみるかい？{金钱00}{码14000C93}スコップだけかりる\nスコップと犬をかりる\nやめておく",
  "tgt": "{立绘8141}「铲子和沙犬……\n要再租一次吗？{金钱00}{码14000C93}只租铲子\n铲子和沙犬都租\n还是算了"
 },
 {
  "id": "013575",
  "file": "WORLD/AREAS009.EMI",
  "seg": 11,
  "src": "「それじゃ、スコップは\n返してもらうよ‥\n---\nまた 用がある時は\n一声かけてくれ",
  "tgt": "「那么，铲子\n还给你‥\n---\n有事的时候\n再叫我一声"
 },
 {
  "id": "013576",
  "file": "WORLD/AREAS009.EMI",
  "seg": 11,
  "src": "{立绘8141}「おいおい 金が足りないよ‥",
  "tgt": "{立绘8141}「喂喂，钱不够哟‥"
 },
 {
  "id": "013577",
  "file": "WORLD/AREAS009.EMI",
  "seg": 11,
  "src": "{立绘8141}「なんせ 砂ん中に\nうまってるもんで‥\n---\nスコップが必要だなァ\nそれに‥\n---\n砂の下を かぎ分ける\nこの犬がいりゃあ‥\n---\nアンタ達の 探してるモンが\n見つかるかもなぁ‥",
  "tgt": "{立绘8141}「毕竟是埋在\n沙子里的东西‥\n---\n需要铲子\n而且‥\n---\n有这只\n能嗅出沙下的狗‥\n---\n你们找的东西\n说不定就能找到呀‥"
 },
 {
  "id": "013578",
  "file": "WORLD/AREAS009.EMI",
  "seg": 11,
  "src": "{立绘8141}「スコップも犬も\n25ゼニーで かしてやるが\n---\nどうするね？{金钱00}{码14000C93}スコップだけかりる\nスコップと犬をかりる\nやめておく",
  "tgt": "{立绘8141}「铲子和沙犬\n都25泽尼租给你\n---\n怎么样？{金钱00}{码14000C93}只租铲子\n铲子和沙犬都租\n还是算了"
 },
 {
  "id": "013579",
  "file": "WORLD/AREAS009.EMI",
  "seg": 11,
  "src": "ウインチがある‥\n動かしてみますか？{码14010C82}動かす\nやめる",
  "tgt": "有绞盘‥\n要操作吗？操作\n算了{码14010C82}動かす\nやめる"
 },
 {
  "id": "013580",
  "file": "WORLD/AREAS009.EMI",
  "seg": 11,
  "src": "     {色02}ウインチ修理中{/色}\n   『いかり』に 乘ると\n    動き出すので 注意！",
  "tgt": "      {色02}绞盘维修中{/色}\n   乘上『锚』后\n    会开始移动，注意！"
 },
 {
  "id": "013581",
  "file": "WORLD/AREAS009.EMI",
  "seg": 11,
  "src": "{立绘8141}「もう あそこにはナンも\nうまっちゃいないだろ‥\n---\nこれ以上 探しても\nムダだと思うがなァ‥",
  "tgt": "{立绘8141}「那边已经\n什么都没埋啦‥\n---\n再挖也是\n白费劲呀‥"
 },
 {
  "id": "013582",
  "file": "WORLD/AREAS009.EMI",
  "seg": 11,
  "src": "\n {色02}イカリ{/色}はすでに 下におりている‥‥",
  "tgt": "\n {色02}锚{/色}已经放到下面了……"
 },
 {
  "id": "013583",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "ぱぶぱぶのむら",
  "tgt": "帕布帕布之村"
 },
 {
  "id": "013584",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "追い出されてしまった‥‥",
  "tgt": "被赶出来了‥‥"
 },
 {
  "id": "013585",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「テミ、ノ！\nトップ、ポミ！！",
  "tgt": "{框04}{立绘8040}「特米，诺！\n特普，波米！！"
 },
 {
  "id": "013586",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「コ、プレチ\nテミ、ノ！",
  "tgt": "{框04}{立绘8040}「科，普雷奇\n特米，诺！"
 },
 {
  "id": "013587",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框06}{立绘0101}「なんだ、さわがしい‥\nポコ 归ったのか‥？",
  "tgt": "{框06}{立绘0101}「好吵啊‥\n波科回来了吗‥？"
 },
 {
  "id": "013588",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框04}{立绘0101}「これは‥\nお客さんでしたか！\n---\nようこそ、どうぞ\nお入りください‥！",
  "tgt": "{框04}{立绘0101}「这是‥\n客人啊！\n---\n欢迎欢迎\n请进‥！"
 },
 {
  "id": "013589",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘8141}「そうですか、旅の方‥\n---\n大陸へ 渡ろうと\nしてるんですね‥",
  "tgt": "{立绘8141}「这样啊，是旅客‥\n---\n是想要渡去\n大陆啊‥"
 },
 {
  "id": "013590",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「こう見えて、わたしも\n探険家でしてね‥\n---\n大陸のほうから、こっちへ\n渡ってきたんですよ。",
  "tgt": "{框06}{立绘8141}「别看我这样\n我也是个探险家‥\n---\n就是从大陆那边\n渡过来的。"
 },
 {
  "id": "013591",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「それで、この地で\nカミさんと 出会って‥\n---\n今は、この村に\n住みついてるんです。",
  "tgt": "{框06}{立绘8141}「后来在这片土地上\n遇到了内人‥\n---\n如今就定居在\n这个村里了。"
 },
 {
  "id": "013592",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「ああ、申し遲れましたね\nわたしは、ベイトといいます‥\n---\nで、この連中は\nこの村の住人で‥\n---\nセン、シャミ、リンポ\nポスケ、ペソ‥\n---\nお客さんが めずらしくて\n集まって来たんです‥",
  "tgt": "{框06}{立绘8141}「啊，忘了自我介绍了\n我叫贝特‥\n---\n而这些家伙\n是村里的居民‥\n---\n森、沙米、林波\n波斯凯、佩索‥\n---\n难得有客人来\n都凑过来了‥"
 },
 {
  "id": "013593",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「そして、つまのポコ‥\n---\nなかなかの 美人でしょう？",
  "tgt": "{框06}{立绘8141}「还有内人波科‥\n---\n相当漂亮吧？"
 },
 {
  "id": "013594",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「ポッコ、ピューイ！\n---\nニ、ワーマ ポト\nピューイ‥！",
  "tgt": "{框06}{立绘8040}「波科，皮尤伊！\n---\n尼，瓦马波托\n皮尤伊‥！"
 },
 {
  "id": "013595",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「あなたの おくさんも\nキレイだって、言ってます。",
  "tgt": "{框06}{立绘8141}「她说你的妻子\n也很漂亮呢。"
 },
 {
  "id": "013596",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框05}{立绘0202}「それは、ともかくとして‥\n---\n大陸へ 渡ることに\nついてだが‥",
  "tgt": "{框05}{立绘0202}「那个暂且不谈‥\n---\n说渡去\n大陆的事吧‥"
 },
 {
  "id": "013597",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框05}{立绘8141}「ああ、そうでした‥！",
  "tgt": "{框05}{立绘8141}「啊，对了‥！"
 },
 {
  "id": "013598",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框05}{立绘8141}「おっしゃる通り‥\n---\nここから、西大陸まで\nあさせを伝って\n步いて行く事が できます‥",
  "tgt": "{框05}{立绘8141}「正如您所说‥\n---\n从这里到西大陆\n可以沿着浅滩\n步行过去‥"
 },
 {
  "id": "013599",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘8141}「しかし、あさせが\n通れるのは‥\n---\n海の水が ひいている\nかぎられた時間\nだけなのです。",
  "tgt": "{立绘8141}「可是，浅滩能通行\n‥\n---\n只有在海水退潮时\n限定的时间\n才行。"
 },
 {
  "id": "013600",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0202}「今は、通れないのか？",
  "tgt": "{立绘0202}「现在是通不过吗？"
 },
 {
  "id": "013601",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「プレチ、スル コ！\n---\nタアン カル\nポッコ カイル ニ。",
  "tgt": "{框06}{立绘8040}「普雷奇，苏鲁科！\n---\n塔安卡尔\n波科卡伊鲁尼。"
 },
 {
  "id": "013602",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘8141}「しばらく、ここに\nおいで下さい‥\n---\n通れる時が 来たら\n案內すると、言ってます。",
  "tgt": "{立绘8141}「请在这里\n待上一段时间‥\n---\n它说等到能通行的时候\n就会来带路。"
 },
 {
  "id": "013603",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0101}「パブパブの連中には\nあさせが 通れる時が\n分かるらしいんです‥\n---\nだから、時が来たら\nポコが 案內してくれますよ。",
  "tgt": "{立绘0101}「帕布帕布人似乎\n能知道浅滩\n何时能通行‥\n---\n所以时候一到\n波科就会来带路的。"
 },
 {
  "id": "013604",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0000}「ポッコ ノル タアン\nパケト ノル ノ。\nプレチ プカプカ‥\n---\n{立绘0101}「いつの事に なるか\n分からないので‥\n---\nぶらぶら していてくれ\nとのことです‥",
  "tgt": "{立绘0000}「波科 诺鲁 塔安\n帕凯托 诺鲁 诺。\n普雷奇 普卡普卡…\n---\n{立绘0101}「说是不知\n要到什么时候…\n---\n让我们\n先随便逛逛…"
 },
 {
  "id": "013605",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0003}「コ、パブパブ\nニ、プレチ。",
  "tgt": "{立绘0003}「科，帕布帕布\n尼，普雷奇。"
 },
 {
  "id": "013606",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0004}「ソンナ、ポミタ‥\nテエルタ、テミ。",
  "tgt": "{立绘0004}「松纳，波米塔…\n泰鲁塔，特米。"
 },
 {
  "id": "013607",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0005}「プレチ、プカプカ！",
  "tgt": "{立绘0005}「普雷奇，普卡普卡！"
 },
 {
  "id": "013608",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0003}{码0A}{码03}「{特效}ウウ‥{码0E}{/特效}\n\n---\n{立绘FFFF}何だか、すごく具合が悪そうだ‥",
  "tgt": "{立绘0003}{码0A}{码03}「{特效}呜呜…{码0E}{/特效}\n\n---\n{立绘FFFF}看起来难受得厉害…"
 },
 {
  "id": "013609",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0004}「パブパブ、タトル\nテミ、ピル！\nテミ、プカプカ！",
  "tgt": "{立绘0004}「帕布帕布，塔托鲁\n特米，皮鲁！\n特米，普卡普卡！"
 },
 {
  "id": "013610",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0006}「タトル、タトル！\nテミ、プカプカ。",
  "tgt": "{立绘0006}「塔托鲁，塔托鲁！\n特米，普卡普卡。"
 },
 {
  "id": "013611",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "‥ベイトさんのノートだ。\nこの村のコトバについて\n書いてあるようだ。{码14000C94}『あ』〜『そ』を見る\n『た』〜『の』を見る\n『は』〜『ろ』を見る\n見ない",
  "tgt": "…是贝特先生的笔记。\n记着这个村子的语言。{码14000C94}看『阿』～『索』\n看『塔』～『诺』\n看『哈』～『罗』\n不看"
 },
 {
  "id": "013612",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{色02}アイン{/色} ‥ 〜の間\n{色02}イシ{/色}  ‥ 東。\n{色02}ウェシ{/色} ‥ 西。\n---\n{色02}カイル{/色} ‥ 案內、教え。\n{色02}コ{/色}   ‥ ここ、これ。\n---\n{色02}サナミ{/色} ‥ 南。\n{色02}サント{/色} ‥ ありがとう。\n{色02}ソンナ{/色} ‥ ごめんなさい。",
  "tgt": "{色02}阿因{/色} … …的中间\n{色02}伊希{/色}  … 东。\n{色02}韦西{/色} … 西。\n---\n{色02}凯鲁{/色} … 向导、教。\n{色02}科{/色}   … 这里、这个。\n---\n{色02}萨纳米{/色} … 南。\n{色02}桑托{/色} … 谢谢。\n{色02}松纳{/色} … 对不起。"
 },
 {
  "id": "013613",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{色02}タアン{/色} ‥ 時間。\n{色02}タトル{/色} ‥ おどる。\n---\n{色02}テミ{/色}  ‥ 悪いやつ。\n{色02}トレジャ{/色}‥ 宝物。\n---\n{色02}ナー{/色}  ‥ 魚。\n{色02}ニ{/色}   ‥ あなた、それ。\n{色02}ノ{/色}   ‥ ちがう、だめ。\n---\n{色02}ノスタ{/色} ‥ 北。",
  "tgt": "{色02}塔安{/色} … 时间。\n{色02}塔托鲁{/色} … 起舞。\n---\n{色02}特米{/色}  … 坏家伙。\n{色02}特雷加{/色}… 宝物。\n---\n{色02}纳{/色}  … 鱼。\n{色02}尼{/色}   … 你、那个。\n{色02}诺{/色}   … 不对、不行。\n---\n{色02}诺斯塔{/色} … 北。"
 },
 {
  "id": "013614",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{色02}パケト{/色} ‥ けれども。\n{色02}パブパブ{/色}‥ わたし達。\n{色02}プレチ{/色} ‥ 友達、いいやつ。\n---\n{色02}プカプカ{/色}‥ のんびり、ゆっくり。\n 『なるようになる』の意味もある。\n---\n{色02}ポト{/色}  ‥ もっと、スゴイ。\n{色02}ミチュ{/色} ‥ ひみつ。\n---\n{色02}リクク{/色} ‥ 薬。\n{色02}ロイ{/色}  ‥ 石、いわ。",
  "tgt": "{色02}帕凯托{/色} … 但是。\n{色02}帕布帕布{/色}… 我们。\n{色02}普雷奇{/色} … 朋友、好家伙。\n---\n{色02}普卡普卡{/色}… 悠哉、慢慢来。\n 也有『船到桥头自然直』的意思。\n---\n{色02}波托{/色}  … 更、厉害。\n{色02}米丘{/色} … 秘密。\n---\n{色02}利库库{/色} … 药。\n{色02}洛伊{/色}  … 石头、岩石。"
 },
 {
  "id": "013615",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0101}「え！？\n具合の悪い人‥？",
  "tgt": "{立绘0101}「诶！？\n身体不舒服的人‥？"
 },
 {
  "id": "013616",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘8347}「ええ、あっちの部屋で\nうずくまって いました‥",
  "tgt": "{立绘8347}「嗯，他一直蜷缩在\n那边的房间里‥"
 },
 {
  "id": "013617",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0101}「実は、{码0B}そうなんです‥\n---\nあの病気は、この边の\n薬草では‥\nどうしようも なくって‥\n---\n薬を 探したんですが‥",
  "tgt": "{立绘0101}「其实，是这样的‥\n---\n那种病，靠附近一带的\n药草是‥\n毫无办法的‥\n---\n虽然我们也找过药‥{码0B}そうなんです‥\n---\nあの病気は、この边の\n薬草では‥\nどうしようも なくって‥\n---\n薬を 探したんですが‥"
 },
 {
  "id": "013618",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘8347}「手に入らなかった‥？\n---\nじゃ、あの人は！？",
  "tgt": "{立绘8347}「没有找到‥？\n---\n那，那个人！？"
 },
 {
  "id": "013619",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0101}「もともと‥、ここの連中は\n死ぬも生きるも\n{色02}プカプカ{/色}‥‥\n---\n{色02}なるように、なる{/色}‥、と\n考えていて‥\n---\n死ぬのが 平気らしいんです\nけれど‥‥",
  "tgt": "{立绘0101}「本来…这里的人\n对死对活\n都是{色02}普卡普卡{/色}……\n---\n抱的是{色02}船到桥头自然直{/色}\n…这种想法…\n---\n似乎对死\n毫不畏惧…"
 },
 {
  "id": "013620",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘C140}「できれば、助けて\nあげたいです‥\n---\n薬は、どこで\n見つかるんでしょう？",
  "tgt": "{立绘C140}「如果可以的话\n真想救他‥\n---\n药要到\n哪里才能找到呢？"
 },
 {
  "id": "013621",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「我々も ここで\nただ、待っているより‥\n---\n少しでも\n力になれた方が‥",
  "tgt": "{框06}{立绘C240}「与其我们在这里\n只是干等‥\n---\n不如多少\n帮上点忙‥"
 },
 {
  "id": "013622",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0101}「そうですね‥\n---\n薬を 探して\nいただけるなら‥\n---\n{色02}リプ{/色}へ、行ってみて\nください‥",
  "tgt": "{立绘0101}「是啊…\n---\n若您愿意\n帮忙找药…\n---\n请去{色02}莉普{/色}\n看看…"
 },
 {
  "id": "013623",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0101}「薬は、海でとれる\nものらしいので‥\n---\nリプで 話が\n闻けると思います。",
  "tgt": "{立绘0101}「药似乎是海里\n出产的东西‥\n---\n到里普应该\n能打听到消息。"
 },
 {
  "id": "013624",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0101}「あの病気の薬は\nリプで 闻いてもらえば\n何か 分かると思います。\n---\nすみませんが、お願いします。",
  "tgt": "{立绘0101}「那种病的药\n到里普去问问\n应该就会有所了解。\n---\n麻烦你们了，拜托了。"
 },
 {
  "id": "013625",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0000}「ポッコ サッチタ、リクク‥\n---\n{立绘0101}「実は、ポコにも\n薬を 探しに\n行ってもらったんです‥\n---\nけど、このとおり\nコトバが 通じないんで‥",
  "tgt": "{立绘0000}「波科 萨奇塔，利库库…\n---\n{立绘0101}「其实，也派波科\n去找过\n药了…\n---\n可是像这样\n语言不通…"
 },
 {
  "id": "013626",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框04}{立绘8141}「薬を、持ってきて\n下さったんですか‥？\n---\nでしたら、彼に\nのませてあげて下さい。",
  "tgt": "{框04}{立绘8141}「药，你们带来了\n是吗‥？\n---\n那样的话，请\n喂给他喝吧。"
 },
 {
  "id": "013627",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{码03}は、モズ草を\n与えた‥‥",
  "tgt": "{码03}将伯劳草\n喂给了他‥‥"
 },
 {
  "id": "013628",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0003}「ウウウ‥‥",
  "tgt": "{立绘0003}「呜呜呜……"
 },
 {
  "id": "013629",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "効いている‥、のだろうか？",
  "tgt": "起作用了‥、吗？"
 },
 {
  "id": "013630",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框02}{立绘0101}「ああ、{码0B}ありがとう‥\n---\nこれで、薬が効くかどうかは\nプカプカ‥\n---\nなるようにしか、なりません。",
  "tgt": "{框02}{立绘0101}「啊，谢谢你们‥\n---\n至于药有没有效\n就是普卡普卡了‥\n---\n只能听天由命了。{码0B}ありがとう‥\n---\nこれで、薬が効くかどうかは\nプカプカ‥\n---\nなるようにしか、なりません。"
 },
 {
  "id": "013631",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框02}{立绘0101}「‥ひと晚、様子を見ましょう\n---\n今日は、お休みください。",
  "tgt": "{框02}{立绘0101}「‥观察一个晚上吧\n---\n今天请先休息。"
 },
 {
  "id": "013632",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「よかった‥\n薬、効いたんですね！？",
  "tgt": "{框06}{立绘C140}「太好了‥\n药起效了！？"
 },
 {
  "id": "013633",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框05}{立绘0003}「サント、リクク！\nピルタ、ピルタ！\n---\nタトル、プカプカ パケト\nリクク、プカプカ！\n---\nニ、プレチ\nパブパブ プカプカ\nニ プカプカ ポト！",
  "tgt": "{框05}{立绘0003}「桑托，利库库！\n皮鲁塔，皮鲁塔！\n---\n塔托鲁，普卡普卡 帕凯托\n利库库，普卡普卡！\n---\n尼，普雷奇\n帕布帕布 普卡普卡\n尼 普卡普卡 波托！"
 },
 {
  "id": "013634",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0101}「おどりでも、よくなった\nかもしれないけど‥\n---\nあなた方が、薬を\n持ってきて くれたのも\nなるべくして、なった事‥\n---\nありがとう、と‥",
  "tgt": "{立绘0101}「说不定是跳舞\n让他好起来的‥\n---\n但你们把药\n带过来这件事\n也是命中注定的‥\n---\n谢谢，谢谢‥"
 },
 {
  "id": "013635",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0006}{码0A}{队员3C}プカプカ、プカプカ！",
  "tgt": "{立绘0006}{码0A}{队员3C}普卡普卡，普卡普卡！"
 },
 {
  "id": "013636",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0101}「プカプカ‥\nなるように、なると言うのは‥\n---\n彼ら、パブパブの\n生き方なのです。\n---\nそれと、みなさんの\n無事をいのる、と言う意味も\nあるのです‥",
  "tgt": "{立绘0101}「普卡普卡‥\n所谓顺其自然‥\n---\n是他们帕布帕布人\n的生存之道。\n---\n同时，也包含着\n祈愿大家\n平安的意思‥"
 },
 {
  "id": "013637",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0004}{码0A}{/色}「ニ、プレチ\nサント プカプカ！",
  "tgt": "{立绘0004}{码0A}{/色}「尼，普雷奇\n桑托 普卡普卡！"
 },
 {
  "id": "013638",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘8447}「とにかく、よくなって\nよかったです‥\n---\n{立绘8547}よろこんで‥\nくれてるんですよ、ね？",
  "tgt": "{立绘8447}「总之，人没事\n就好了‥\n---\n{立绘8547}他很高兴\n对吧？"
 },
 {
  "id": "013639",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0003}{码0A}{色3C}サント、プレチ！\nパブパブ カイン、ミチュ！\n---\nアイン {色02}リプ{/色}、{色02}シューク{/色}\nロイ、ロイ‥\n---\nノスタ、ロイ‥\nポト {色02}トレジャ{/色}！！",
  "tgt": "{立绘0003}{码0A}{色3C}桑托，普雷奇！\n帕布帕布 凯因，米丘！\n---\n阿因 {色02}莉普{/色}、{色02}修克{/色}\n洛伊，洛伊…\n---\n诺斯塔，洛伊…\n波托 {色02}特雷加{/色}！！"
 },
 {
  "id": "013640",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0101}「どうも、ありがとう\nみなさん‥",
  "tgt": "{立绘0101}「多谢\n各位了‥"
 },
 {
  "id": "013641",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「プレチ！ プレチ！",
  "tgt": "{框06}{立绘8040}「普雷奇！普雷奇！"
 },
 {
  "id": "013642",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0000}「プレチ、タアン カル！\nタアン カル！",
  "tgt": "{立绘0000}「普雷奇，塔安 卡鲁！\n塔安 卡鲁！"
 },
 {
  "id": "013643",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘8141}「みなさん、どうやら‥\n---\nあさせを 通れる時が\n来たようです。",
  "tgt": "{立绘8141}「各位，看来‥\n---\n能通过浅滩的时候\n到了。"
 },
 {
  "id": "013644",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0000}「タアン、カル！\nポッコ カイル プレチ！",
  "tgt": "{立绘0000}「塔安，卡鲁！\n波科 凯鲁 普雷奇！"
 },
 {
  "id": "013645",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框05}{立绘0101}「みなさん、急いで\n出発してください‥\n---\nあさせが、渡れる時間は\nかぎられています‥！",
  "tgt": "{框05}{立绘0101}「各位，请赶快\n出发‥\n---\n能渡过浅滩的时间\n是有限的‥！"
 },
 {
  "id": "013646",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「わかりました、ベイトさん\nお世話になりました‥！",
  "tgt": "{框06}{立绘C140}「明白了，贝特先生\n多谢您的照顾‥！"
 },
 {
  "id": "013647",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「わかった‥、世話になった。",
  "tgt": "{框06}{立绘C240}「知道了‥、多谢照顾。"
 },
 {
  "id": "013648",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框06}{立绘C540}「そうするって\n言ってますよ。",
  "tgt": "{框06}{立绘C540}「它说\n就这么办哦。"
 },
 {
  "id": "013649",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框06}{立绘C440}「わかった、そうしよう。",
  "tgt": "{框06}{立绘C440}「明白了，就这么办。"
 },
 {
  "id": "013650",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{框05}{立绘0101}「あさせの場所まで\nポコが、案內します‥\n---\nそれでは、みなさん\nお気をつけて‥！\nプレチ、プカプカ！",
  "tgt": "{框05}{立绘0101}「到浅滩的路上\n波科会带路‥\n---\n那么，各位\n请多保重‥！\n普雷奇、普卡普卡！"
 },
 {
  "id": "013651",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0101}「おや、どうしました？\n---\nあさせを 通るなら\n急いだほうが、いいですよ。",
  "tgt": "{立绘0101}「哎呀，怎么了？\n---\n要过浅滩的话\n还是抓紧点好哦。"
 },
 {
  "id": "013652",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0101}「やあ、みなさん！\n---\nあさせは‥無事に\n通れましたか？",
  "tgt": "{立绘0101}「哟，各位！\n---\n浅滩‥顺利\n过去了吗？"
 },
 {
  "id": "013653",
  "file": "WORLD/AREAS010.EMI",
  "seg": 11,
  "src": "{立绘0000}「アサセ‥{码0B}トオ{码0B}ルタ？\n---\n{立绘0101}「どうです？\n---\n少し 話せるように\nなったんですよ。",
  "tgt": "{立绘0000}「阿萨塞…{码0B}托奥{码0B}鲁塔？\n---\n{立绘0101}「怎么样？\n---\n已经能\n说上几句了哟。"
 },
 {
  "id": "013654",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}{立绘0101}セネスタしつない。\n---\n00と01はマーロックのいえ。\n02と03は宿屋。\n04と07はこじいん。",
  "tgt": "{立绘0000}{立绘0101}塞内斯塔室内。\n---\n00和01是马洛克的家。\n02和03是旅店。\n04和07是小教堂。"
 },
 {
  "id": "013655",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "「西側の物を 買ってきて\n商売しようって連中が\nこの町に、集まってるんだ‥",
  "tgt": "「想把西边的货\n买来卖钱的家伙们\n都聚到这镇上来了‥"
 },
 {
  "id": "013656",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0202}{金钱00}「めずらしい西側の武器や‥\n見るだけでも、見てって！{码14840C94}何か買う\n持ち物を売る\n下取りしてもらう\nやめておく",
  "tgt": "{立绘0202}{金钱00}「难得的西方武器店……\n光看看也好，进来看看嘛！{码14840C94}买点什么\n卖掉身上的东西\n折价回收\n这次算了"
 },
 {
  "id": "013657",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0303}「{码0A}\nなうー。",
  "tgt": "{立绘0303}「\n喵呜——。{码0A}\nなうー。"
 },
 {
  "id": "013658",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}「何かご用ですかな‥？\n---\nすみませんが、子供たちに\n食事をさせるまで\n待って下さいな‥",
  "tgt": "{立绘0000}「有什么事吗……？\n---\n不好意思\n要先给孩子们\n做好饭才行……"
 },
 {
  "id": "013659",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0404}「あー、おなかすいた‥\nチノったら、どこを\nうろついてるのかしら",
  "tgt": "{立绘0404}「啊——，肚子饿了‥\n千乃这家伙\n又晃到哪里去了呀"
 },
 {
  "id": "013660",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0505}「このふく、カッコいいだろ？\n---\nウインディアの、王女様に\nもらったんだ！",
  "tgt": "{立绘0505}「这衣服，帅吧？\n---\n是温迪亚的\n王女大人送的！"
 },
 {
  "id": "013661",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0606}「ナーマ、おなかすいた。\n---\nチノが、归ってこないと\nゴハン食べられないの‥",
  "tgt": "{立绘0606}「纳玛，肚子饿了。\n---\n千乃不回来\n就没饭吃呀‥"
 },
 {
  "id": "013662",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0707}「チノは、また 町の中を\n走り回ってるんだわ‥\n---\nまったく、子供なんだから‥",
  "tgt": "{立绘0707}「千乃又在\n镇子里跑来跑去啦‥\n---\n真是的，孩子气‥"
 },
 {
  "id": "013663",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0808}「この間、ウインディアから\n王女様が、おみまいに\n来てくださいました‥\n---\nそして、私たちに\nふくとか、おもちゃを\n下さったのです。",
  "tgt": "{立绘0808}「前几天，温迪亚的\n王女大人\n来慰问我们了‥\n---\n还给了我们\n衣服呀\n玩具呀‥"
 },
 {
  "id": "013664",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0909}「わたしたち、お父さんも\nお母さんも、いないの。\n---\nリタおばあちゃんが\nみんなの お母さんの\nかわりなの。",
  "tgt": "{立绘0909}「我们没有\n爸爸也没有妈妈。\n---\n莉塔奶奶\n就是大家的\n妈妈。"
 },
 {
  "id": "013665",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0A0A}「てへー‥",
  "tgt": "{立绘0A0A}「嘿嘿——‥"
 },
 {
  "id": "013666",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "「おみまいに来た、王女様？\n---\nリタのばあさんなら\n何か知ってるかねぇ‥\n---\nいどの前の家で\n子供たちを 世話してる\nばあさんだよ‥",
  "tgt": "「来慰问的王女大人？\n---\n问莉塔老婆子的\n话兴许知道‥\n---\n就是在井前那家\n照看孩子们的\n老婆子哟‥"
 },
 {
  "id": "013667",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0B0B}旅の記錄をつけますか？{码14890C82}はい\nいいえ",
  "tgt": "{立绘0B0B}要做旅途记录吗？好\n不要{码14890C82}はい\nいいえ"
 },
 {
  "id": "013668",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "からっぽだ‥。\nエリーナの持ってきた物だろうか？",
  "tgt": "是空的‥。\n是艾莉娜带来的东西吗？"
 },
 {
  "id": "013669",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "子供のふくが入っている‥",
  "tgt": "装着小孩的衣服‥"
 },
 {
  "id": "013670",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "おもちゃと、おかしが入っている。",
  "tgt": "装着玩具和点心。"
 },
 {
  "id": "013671",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「戻ったかい‥{码0B}‥\nチノも いっしょだね。",
  "tgt": "{框06}{立绘8040}「回来啦‥‥\n千乃也一起呢。{码0B}‥\nチノも いっしょだね。"
 },
 {
  "id": "013672",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0C0C}「はい、リタさま。\nこちらの方々が‥\n---\nチノを 捕まえるのを\n手伝って下さいました。",
  "tgt": "{立绘0C0C}「是，莉塔大人。\n是各位‥\n---\n帮忙抓住了\n千乃。"
 },
 {
  "id": "013673",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「まあ‥ それはどうも\nありがとうございました。",
  "tgt": "{框06}{立绘8040}「哎呀‥那可真是\n太谢谢你们了。"
 },
 {
  "id": "013674",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「はい、それでは\nみんな そろったので‥\n食事にしましょうね。",
  "tgt": "{框06}{立绘8040}「好，那么\n人齐了‥\n开饭吧。"
 },
 {
  "id": "013675",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「さて、みなさん‥\n---\nその間、上でお話を\nうかがいましょう‥",
  "tgt": "{框06}{立绘8040}「来，各位‥\n---\n在此期间\n就到上面听听谈话吧‥"
 },
 {
  "id": "013676",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「‥{码0B}‥ええ、たしかに。\nエリーナさまは、ここへ\nおいで下さいました。",
  "tgt": "{框05}{立绘0000}「……{码0B}……嗯，确实。\n艾莉娜大人\n来过这里。"
 },
 {
  "id": "013677",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「本当に、おやさしい方で‥\n---\n戦爭で、親をなくした\n子供たちに‥、と\nたくさんの品々を‥",
  "tgt": "{框05}{立绘0000}「真是位温柔的人……\n---\n给战争中失去父母的\n孩子们……\n送来了许多东西……"
 },
 {
  "id": "013678",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘C200}「それで、その後だが‥\n---\nエリーナたちが どこへ\n向かったのか、分からないか？",
  "tgt": "{立绘C200}「那么，在那之后……\n---\n知不知道艾莉娜他们\n去了哪里？"
 },
 {
  "id": "013679",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「それは‥{码0B}‥\n申しわけないのですが‥",
  "tgt": "{框05}{立绘0000}「这个……{码0B}……\n实在抱歉……"
 },
 {
  "id": "013680",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘8D0D}「どんな小さな 手がかりでも\nほしいんです‥！",
  "tgt": "{框06}{立绘8D0D}「哪怕再小的线索\n也想知道呀‥！"
 },
 {
  "id": "013681",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘8E4E}「おれ、知ってるぜ！",
  "tgt": "{框06}{立绘8E4E}「我，我知道哟！"
 },
 {
  "id": "013682",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框45}{立绘0000}「チノ‥",
  "tgt": "{框45}{立绘0000}「奇乃……"
 },
 {
  "id": "013683",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘4100}「チノくん‥、ねえさまが‥\n王女様が、どこへ行ったのか\n知ってるの？",
  "tgt": "{立绘4100}「奇乃……我姐姐……\n你知道公主殿下\n去哪儿了吗？"
 },
 {
  "id": "013684",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘8E4E}「ああ、バィーンと\n知ってるぜ‥、{码0B}でも‥",
  "tgt": "{框06}{立绘8E4E}「嗯，我当然\n知道啦‥，不过‥{码0B}でも‥"
 },
 {
  "id": "013685",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘8E4E}「カンタンには、教えない！\n---\nさっきは、おにごっこで\n捕まったから‥{码0B}‥\n---\n次は、かくれんぼで\nおれたちに 勝ったら\n教えてやるよ！",
  "tgt": "{框06}{立绘8E4E}「可不能轻易告诉你！\n---\n刚才玩抓人\n被你们抓到了‥‥\n---\n下次玩捉迷藏\n赢过我们\n才告诉你哟！{码0B}‥\n---\n次は、かくれんぼで\nおれたちに 勝ったら\n教えてやるよ！"
 },
 {
  "id": "013686",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘0E4E}「おーい、みんなっ\nかくれんぼだぜーっ！！",
  "tgt": "{框06}{立绘0E4E}「喂——，大家\n玩捉迷藏啦——！！"
 },
 {
  "id": "013687",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「も、{码0B}申しわけありません。\nとんだ事に なってしまって‥",
  "tgt": "{框05}{立绘0000}「对，{码0B}对不起。\n竟发生了\n这种事……"
 },
 {
  "id": "013688",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘8F4D}「いえ、{码0B}いいんです。\nでも‥\n---\n{立绘C140}「チノくんが、ねえさまの事\n知っているのなら‥\n---\n何でもいいから\n教えてもらわないと‥！",
  "tgt": "{框06}{立绘8F4D}「不，不用了。\n不过‥\n---\n{码0B}「千乃既然知道\n姐姐的事‥\n---\n不管什么都\n得请他告诉我们‥！{立绘C140}「チノくんが、ねえさまの事\n知っているのなら‥\n---\n何でもいいから\n教えてもらわないと‥！"
 },
 {
  "id": "013689",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「探しに行きましょう。",
  "tgt": "{框06}{立绘C140}「去找人吧。"
 },
 {
  "id": "013690",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0707}「か、{码0B}かくれそこなった\nワケじゃないのよ‥\n---\nかくれんぼ なんて\n子供の遊び、{码0B}しないの。",
  "tgt": "{立绘0707}「才，才不是\n没躲好呢‥\n---\n捉迷藏这种\n小孩游戏，我才不玩。{码0B}かくれそこなった\nワケじゃないのよ‥\n---\nかくれんぼ なんて\n子供の遊び、{码0B}しないの。"
 },
 {
  "id": "013691",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0C0C}「すみません‥\n追いかけたんですけど‥",
  "tgt": "{立绘0C0C}「对不起‥\n虽然追过了‥"
 },
 {
  "id": "013692",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0A0A}「てへへー‥\nみつかったー‥！\n---\n‥{码0B}‥おしえてあげるー。\nルンダはー\n---\nひがしの じょうへきの\nしたにー‥\n---\nかくれるって ゆってたー。",
  "tgt": "{立绘0A0A}「嘿嘿——‥\n被找到啦——！\n---\n‥‥告诉你呀。\n伦达呀\n---\n说是要躲在\n东城墙\n---\n下面呀。{码0B}‥おしえてあげるー。\nルンダはー\n---\nひがしの じょうへきの\nしたにー‥\n---\nかくれるって ゆってたー。"
 },
 {
  "id": "013693",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0A0A}「ルンダ、みつけたー？\n---\nおうちの ひがしでー。",
  "tgt": "{立绘0A0A}「找到伦达了吗？\n---\n在房子的东边呀。"
 },
 {
  "id": "013694",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0909}「あたしの かくれ場所\nヨーンに 闻いたでしょ。",
  "tgt": "{立绘0909}「我的藏身处\n问过约恩了吧。"
 },
 {
  "id": "013695",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0808}「みんな、見つかりましたか？",
  "tgt": "{立绘0808}「大家都找到了吗？"
 },
 {
  "id": "013696",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0606}「ドモタ、見えたでしょ？\n橋の上から、北の方に‥",
  "tgt": "{立绘0606}「多莫塔，看到了吧？\n从桥上朝北那边‥"
 },
 {
  "id": "013697",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0505}「ちゃんと步いてみた？\n---\nずばり、宿屋って\n言ったほうが良かった？",
  "tgt": "{立绘0505}「好好找过了吗？\n---\n干脆说\n在旅店不是更好？"
 },
 {
  "id": "013698",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0404}「また、チノがいないなぁ。",
  "tgt": "{立绘0404}「千乃又不见啦。"
 },
 {
  "id": "013699",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0404}「見つかっちゃった！\n---\n‥もう、みんな見つけた？\n一度 うちに戻って\n数えてみたら？",
  "tgt": "{立绘0404}「被抓到了！\n---\n‥大家，都找到了？\n回一趟我家\n数数看吧？"
 },
 {
  "id": "013700",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0404}「見つけた子は\nうちに戻ってるから‥\n---\n全部で、8人いれば\nいいんだよ。",
  "tgt": "{立绘0404}「被抓到的孩子\n都会回我家‥\n---\n一共齐8个\n就行啦。"
 },
 {
  "id": "013701",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0C0C}「ひょっとして‥\nやっぱり‥{码0B}‥\n---\nチノが、見つかって\nいないのですね？",
  "tgt": "{立绘0C0C}「难道说‥\n果然‥‥\n---\n千乃，还没有\n被抓到呀？{码0B}‥\n---\nチノが、見つかって\nいないのですね？"
 },
 {
  "id": "013702",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0C0C}「ああ‥、{码0B}ご存知のように\nあの子は、逃げたり‥\n---\nかくれたりするのが\nとても 上手なのです。",
  "tgt": "{立绘0C0C}「唉‥，如你们所见\n那孩子逃跑呀‥\n---\n躲藏呀\n特别拿手呀。{码0B}ご存知のように\nあの子は、逃げたり‥\n---\nかくれたりするのが\nとても 上手なのです。"
 },
 {
  "id": "013703",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0505}「チノのやつだったら‥\n---\n地下に かくれるって\n言ってたぜ。",
  "tgt": "{立绘0505}「千乃那家伙‥\n---\n说过要躲在\n地下的。"
 },
 {
  "id": "013704",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8C4C}「チノは、みはりを\nくぐり抜けて‥\n---\n地下へ かくれたのかも\n知れません‥",
  "tgt": "{立绘8C4C}「千乃可能\n穿过哨兵‥\n---\n躲进地下\n去了呀‥"
 },
 {
  "id": "013705",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘4100}「私たち、地下を\n見に行ってきます‥",
  "tgt": "{立绘4100}「我们去\n看看地下……"
 },
 {
  "id": "013706",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8C4C}「本当ですか‥\n助かります！\n---\nそれでは、よろしく\nお願いします。",
  "tgt": "{立绘8C4C}「真的吗‥\n帮大忙了！\n---\n那就拜托\n各位了。"
 },
 {
  "id": "013707",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}「ウインディアから、王女様が\n来られたときは\nみんな おおよろこびで‥\n---\n特に、チノは\nとても はしゃいでました。",
  "tgt": "{立绘0000}「温蒂亚的公主殿下\n来的时候\n大家都高兴得很……\n---\n尤其是奇乃\n闹得特别欢。"
 },
 {
  "id": "013708",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0404}「チノったら、心配だわ‥\n---\nだって、コノコ\nお姉さんだもん。",
  "tgt": "{立绘0404}「千乃真让人担心‥\n---\n毕竟，这家伙\n是姐姐呀。"
 },
 {
  "id": "013709",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0505}「かくれんぼ‥\nおもしろかった？",
  "tgt": "{立绘0505}「捉迷藏‥\n好玩吗？"
 },
 {
  "id": "013710",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0606}「遊んだら、また\nおなかすいた。",
  "tgt": "{立绘0606}「玩完\n肚子又饿了。"
 },
 {
  "id": "013711",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0707}「地下は、危ないって\n言われてるのに‥\n---\nほんと、チノって\n子供なんだから‥！",
  "tgt": "{立绘0707}「都说地下\n很危险了‥\n---\n真是的，千乃\n太孩子气了‥！"
 },
 {
  "id": "013712",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0C0C}「地下の入り口には\n見張りが いますが‥\n---\nきっと‥\n水でも のんでるスキに\n入りこんだんでしょう‥",
  "tgt": "{立绘0C0C}「地下入口\n虽然有人把守‥\n---\n一定是趁他\n喝水发呆时\n溜进去的吧‥"
 },
 {
  "id": "013713",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0808}「地下への入り口は\n城門の上に あるんです。",
  "tgt": "{立绘0808}「地下入口\n就在城门上面。"
 },
 {
  "id": "013714",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0909}「あの見張りの人‥\n---\nときどき、水売りの\nおねえさんと\n話しこんでるよ。",
  "tgt": "{立绘0909}「那个哨兵呀‥\n---\n时不时和\n卖水的大姐姐\n聊得火热哟。"
 },
 {
  "id": "013715",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0A0A}「えへへー‥",
  "tgt": "{立绘0A0A}「嘿嘿——‥"
 },
 {
  "id": "013716",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘4100}「それじゃ、チノくん‥\n---\nねえさま‥、王女様のこと\n教えてくれる？",
  "tgt": "{立绘4100}「那么，奇乃……\n---\n我姐姐……公主殿下的事\n你能告诉我们吗？"
 },
 {
  "id": "013717",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框04}{立绘8E4E}「ああ、やくそくだしな‥",
  "tgt": "{框04}{立绘8E4E}「嗯，说话要算数呀‥"
 },
 {
  "id": "013718",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框04}{立绘8E4E}「あの、きれいな王女様が\nこの町を 出発するとき‥",
  "tgt": "{框04}{立绘8E4E}「那位漂亮的王女大人\n离开这镇子的时候‥"
 },
 {
  "id": "013719",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框03}{立绘4200}「それは、誰だ！？\n---\nどんなヤツだったんだ？",
  "tgt": "{框03}{立绘4200}「那是谁！？\n---\n是什么样的人？"
 },
 {
  "id": "013720",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框04}{立绘8E4E}「‥よく分かんなかったケド\nひとりは、商人の\n{色02}マーロック{/色}だったぜ。",
  "tgt": "{框04}{立绘8E4E}「……虽然没看太清楚\n其中一个是商人\n{色02}马洛克{/色}。"
 },
 {
  "id": "013721",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「{色02}マーロック{/色}さん‥\nと言うのは‥‥\n---\nこの町に 住んでいる\n商人の方で‥\n---\n大きな砂船で\n帝国の方とも 商売を\nしているとか‥",
  "tgt": "{框04}{立绘8040}「{色02}马洛克{/色}\n这位……\n---\n是住在\n这个镇上的商人……\n---\n听说还开着\n大沙船\n和帝国那边做生意……"
 },
 {
  "id": "013722",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框02}{立绘0D0D}「帝国‥！？\n---\nじゃあ、ねえさまは‥\n西側へ‥‥",
  "tgt": "{框02}{立绘0D0D}「帝国‥！？\n---\n那，姐姐是‥\n去了西边‥‥"
 },
 {
  "id": "013723",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框02}{立绘4200}「すまんが‥\nその、マーロックとやらは\nどこにいるんだ‥？",
  "tgt": "{框02}{立绘4200}「不好意思……\n那个马洛克\n人在哪里……？"
 },
 {
  "id": "013724",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框04}{立绘8E4E}「マーロックん家は\n町のまんなかに あるぜ‥\n---\nよーじんぼー ってのが\n家の前に 立ってるんだ。",
  "tgt": "{框04}{立绘8E4E}「马洛克家\n就在镇子正当中‥\n---\n门前立着\n卫兵。"
 },
 {
  "id": "013725",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框02}{立绘4200}「ともかく‥、その\nマーロックに 会ってみる。\n---\nありがとう\n世話をかけた‥",
  "tgt": "{框02}{立绘4200}「总之……\n先去见见\n那个马洛克。\n---\n多谢\n麻烦你了……"
 },
 {
  "id": "013726",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}「ウインディアの王女さん‥？",
  "tgt": "{立绘8141}「温迪亚的王女‥？"
 },
 {
  "id": "013727",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「たしかに‥\n---\nそんな感じの お人を\n砂船に お乘せしました‥",
  "tgt": "{框06}{立绘8141}「确实‥\n---\n那样气派的女士\n我载过她上沙船‥"
 },
 {
  "id": "013728",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框05}{立绘0D0D}「姉さまを‥、どこへ\nさらって行ったんです！",
  "tgt": "{框05}{立绘0D0D}「把姐姐‥带到\n哪里去了！"
 },
 {
  "id": "013729",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}「さらったなんて\nとんでもない！\n---\nワイは 賴まれて‥\nあの人を 西側まで\nおくっただけです！",
  "tgt": "{立绘8141}「说什么绑架\n太不像话了！\n---\n我是受人所托\n把那人送到\n西边而已！"
 },
 {
  "id": "013730",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框05}{立绘4200}「どういう事か‥\n說明してもらおう。",
  "tgt": "{框05}{立绘4200}「把事情的来龙去脉……\n说清楚吧。"
 },
 {
  "id": "013731",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「說明も、何も‥\n---\n帝国さんが、王女さんに‥\n来て欲しいって\n賴んだんですわ。",
  "tgt": "{框06}{立绘8141}「解释什么的‥\n---\n是帝国方面拜托的\n说想请王女\n过去的‥"
 },
 {
  "id": "013732",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框05}{立绘100F}「何だって！？\n---\nどうして、エリーナが\n敵の土地になんか\n行く必要があるんだっ！？",
  "tgt": "{框05}{立绘100F}「你说什么！？\n---\n艾莉娜为什么\n要去敌国的\n地盘！？"
 },
 {
  "id": "013733",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「知りまへんがな‥\n---\nそれより、あんたら‥",
  "tgt": "{框06}{立绘8141}「我怎么知道呀‥\n---\n比起那个，你们‥"
 },
 {
  "id": "013734",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「その王女さん、探すのに‥\n---\nワイに 協力してほしい\nっちゅうんと、ちがうんか？",
  "tgt": "{框06}{立绘8141}「找那位王女\n---\n不是要请我\n帮忙吗？"
 },
 {
  "id": "013735",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「それやったら\nもうちょっと‥\n---\nぎょうぎ良く せんと\nアカンのと、ちゃう？",
  "tgt": "{框06}{立绘8141}「那样的话\n就稍微‥\n---\n懂点规矩\n再来吧？"
 },
 {
  "id": "013736",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「ま、{码0B}そう言う事やったら\n手ェ、かしたらんでも\nないけど‥\n---\nその前に、ちょっと\n働いてもらおかな‥？",
  "tgt": "{框06}{立绘8141}「嘛，既然如此\n我也不必\n帮忙了‥\n---\n不过在那之前\n先请你们干点活‥？{码0B}そう言う事やったら\n手ェ、かしたらんでも\nないけど‥\n---\nその前に、ちょっと\n働いてもらおかな‥？"
 },
 {
  "id": "013737",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框05}{立绘0F0D}「あのう、{码0B}マーロックさん‥\n---\nお手伝いって、わたし\n何を‥{码0B}‥？",
  "tgt": "{框05}{立绘0F0D}「那个，马洛克先生‥\n---\n帮忙的话，我\n要做什么‥‥？{码0B}マーロックさん‥\n---\nお手伝いって、わたし\n何を‥{码0B}‥？"
 },
 {
  "id": "013738",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「なに‥\n---\n連中が‥、盗られた\nワイの商品を 取り返して\n来るまでの間‥\n---\nワイの、身の回りの\nお世話なんかを‥、な。",
  "tgt": "{框06}{立绘8141}「什么呀‥\n---\n在被那帮家伙\n抢走的商品\n找回来之前‥\n---\n先照顾好\n我的起居之类的‥"
 },
 {
  "id": "013739",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框02}{立绘8141}「‥{码0B}‥{码0B}なんやて！？\n---\nほんで、そのまま\nのこのこと、归ってきたんか？",
  "tgt": "{框02}{立绘8141}「‥‥什么！？\n---\n然后就那么\n大摇大摆地回来了？{码0B}‥{码0B}なんやて！？\n---\nほんで、そのまま\nのこのこと、归ってきたんか？"
 },
 {
  "id": "013740",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘4200}「話しが、ちがう‥！\n---\n{立绘110F}先に 悪どい事を\nしたのは、そっちが‥{引5800}",
  "tgt": "{立绘4200}「你说得不对……！\n---\n{立绘110F}先干\n龌龊事的\n是你们……{引5800}"
 },
 {
  "id": "013741",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框02}{立绘8141}「あほか！\n---\nなんぼで 買うても\nワイの物は、ワイの物や‥\n---\n取り戻すんは、当たり前と\n違いまっか‥！？",
  "tgt": "{框02}{立绘8141}「笨蛋！\n---\n就算买回来\n我的东西还是我的‥\n---\n夺回来是\n理所当然的吧‥！？"
 },
 {
  "id": "013742",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框02}{立绘8141}「‥まあ、ええ。",
  "tgt": "{框02}{立绘8141}「‥嘛，算了。"
 },
 {
  "id": "013743",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框02}{立绘8141}「ほな、次は‥\nアタマ使わんでも ええ仕事\nしてもらいましょ‥",
  "tgt": "{框02}{立绘8141}「那么，接下来‥\n干点不用\n动脑子的活吧‥"
 },
 {
  "id": "013744",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框05}{立绘0F0D}「あのう、マーロックさん‥\n---\nわたしは、何を‥‥？",
  "tgt": "{框05}{立绘0F0D}「那个，马洛克先生‥\n---\n我要，做什么‥‥？"
 },
 {
  "id": "013745",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「そやな、とりあえず\n{队员01}はんには‥\n---\nワイのカタでも もんで\nもらいます。",
  "tgt": "{框06}{立绘8141}「这样吧，总之\n先请{队员01}兄‥\n---\n帮我揉揉\n肩膀吧。"
 },
 {
  "id": "013746",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}「んー‥\nカタは もうええわ‥\n---\n次は‥ 足を\nもんでくれまっか？",
  "tgt": "{立绘8141}「嗯～‥\n肩不用揉了‥\n---\n接下来‥帮我\n揉揉脚吧？"
 },
 {
  "id": "013747",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}「よっしゃ、{队员01}はん\n足の次は‥\n---\nコシの方も もんで\nもらいましょか？",
  "tgt": "{立绘8141}「好嘞，{队员01}兄\n揉完脚‥\n---\n腰部也要\n揉揉吧？"
 },
 {
  "id": "013748",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「あー‥\nあちこち もんでもろて\nええ具合や‥\n---\nどや、{队员01}はん\n疲れましたか？",
  "tgt": "{框06}{立绘8141}「啊——‥\n这里那里都揉过\n真舒坦呀‥\n---\n怎么样，{队员01}兄\n累了吗？"
 },
 {
  "id": "013749",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框05}{立绘0F0D}「え、{码0B}あ‥ はい‥？",
  "tgt": "{框05}{立绘0F0D}「诶，啊‥是‥？{码0B}あ‥ はい‥？"
 },
 {
  "id": "013750",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「そーでっか！\nほなら‥‥\n---\n今度は、ワイが\n{特效}もんで{码0E}{/特效}{道具5E98}まひょ！",
  "tgt": "{框06}{立绘8141}「这就对啦！\n那么接下来‥\n---\n这回换我来\n揉{特效}吧！{码0E}{/特效}{道具5E98}まひょ！"
 },
 {
  "id": "013751",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘120D}「マーロックさんに 協力して\n早く、姉さまを\n探しに行きましょう‥！",
  "tgt": "{立绘120D}「配合马洛克先生\n早点去找\n姐姐吧‥！"
 },
 {
  "id": "013752",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0101}「遊んでんと、盗賊を\n探しなはれ‥\n---\nまずは、町の連中に\n話しを闻いたら、よろし。",
  "tgt": "{立绘0101}「别光顾着玩\n快去找盗贼呀‥\n---\n先去问问\n镇上的家伙们就行。"
 },
 {
  "id": "013753",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘4100}「盗賊あいてですから\n気をつけて下さいね。",
  "tgt": "{立绘4100}「对方是盗贼\n请千万小心哦。"
 },
 {
  "id": "013754",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0101}「盗賊 見つけたら\n早よ、追いかけなはれ！\n---\n何しとるんや、ホンマ‥",
  "tgt": "{立绘0101}「找到盗贼\n就赶紧追呀！\n---\n你在磨蹭什么呀，真是的‥"
 },
 {
  "id": "013755",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0F0D}「その人‥、盗賊じゃ\nなかったから‥\n---\n逃がしてあげて\n良かったと 思います。",
  "tgt": "{立绘0F0D}「那人‥\n不是盗贼\n---\n放他走\n我觉得是对的。"
 },
 {
  "id": "013756",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0101}「今度の仕事は\nあほでも できます‥\n---\n砂船のさんばしに\n行ってきなはれ。",
  "tgt": "{立绘0101}「这次的活\n傻瓜都会干‥\n---\n去沙船的\n码头吧。"
 },
 {
  "id": "013757",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘4100}「もも‥、もま‥{码0B}もみ‥\n---\n{立绘130D}な、{码0B}何でもないです\nへいきです！",
  "tgt": "{立绘4100}「按……按……{码0B}按摩……\n---\n{立绘130D}不，{码0B}没什么\n没事的！"
 },
 {
  "id": "013758",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0101}「ええ仕事したら\nおだちん、あげまっせ。",
  "tgt": "{立绘0101}「活干得漂亮\n赏钱，照给。"
 },
 {
  "id": "013759",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0808}「まん中の 箱の中身‥\n気になりませんか？",
  "tgt": "{立绘0808}「正中间箱子里的\n东西‥不想看看吗？"
 },
 {
  "id": "013760",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0A0A}「てへー‥\n---\nおうじょさまに\nあえたぁ？",
  "tgt": "{立绘0A0A}「嘿嘿——‥\n---\n见到\n王女大人了吗？"
 },
 {
  "id": "013761",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0C0C}「ちょっと、チノ\n待ちなさいったら‥！",
  "tgt": "{立绘0C0C}「千乃，说了\n等一下呀‥！"
 },
 {
  "id": "013762",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0909}「ぷぅ‥！\n---\n先生、アタシとも\n遊んでよぉ！",
  "tgt": "{立绘0909}「噗呜‥！\n---\n老师，也陪我\n玩嘛——！"
 },
 {
  "id": "013763",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0404}「チノったら‥\n---\nああやって\nマシィ先生の\n気をひいてるのよ。",
  "tgt": "{立绘0404}「千乃这家伙‥\n---\n就是用这招\n吸引玛希老师\n注意的呢。"
 },
 {
  "id": "013764",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0E0E}「バババババイーン！",
  "tgt": "{立绘0E0E}「拜拜拜拜拜——！"
 },
 {
  "id": "013765",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "「上に泊ってる商人‥\n---\nまさか、このまま\nいすわるつもりじゃ\nないよな‥？",
  "tgt": "「楼上住的商人‥\n---\n该不会打算\n就这样赖着\n不走吧‥？"
 },
 {
  "id": "013766",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0202}{金钱00}「店は かりモンやけど‥\n売りモンは そろってるで！{码14840C94}何か買う\n持ち物を売る\n下取りしてもらう\nやめておく",
  "tgt": "{立绘0202}{金钱00}「店虽然是租的……\n货可是齐全的！{码14840C94}买点什么\n卖掉身上的东西\n折价回收\n这次算了"
 },
 {
  "id": "013767",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0606}「誰か、一人足りない\n気がするの‥？",
  "tgt": "{立绘0606}「总觉得\n少了一个人‥？"
 },
 {
  "id": "013768",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{框21}子供たちは、町の中の\nどこかに かくれています。\n---\n子供たちに、話しかけると\n見つけた事になります‥\n---\n時々、この部屋に戻って\n子供たちの数を\n確認しましょう‥！",
  "tgt": "{框21}孩子们藏在\n镇子的某处。\n---\n跟孩子们搭话\n就算找到了‥\n---\n时常回到这个房间\n确认孩子们\n的数量吧‥！"
 },
 {
  "id": "013769",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0707}「エリーナ様から\nもらった\nわたしの {色03}宝物{/色}‥\n---\nお兄ちゃん達なら\nとっかえて\nあげても いいよ？{码14000C92}取り替えよう！\nやめておこう‥",
  "tgt": "{立绘0707}「这是艾莉娜大人\n送我的\n{色03}宝物{/色}……\n---\n如果是大哥哥们\n换给我\n也不是不行哟？{码14000C92}交换吧！\n还是算了……"
 },
 {
  "id": "013770",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘FFFF}\n {色03}{占位01}{/色}と 取り替えた！\n---\n",
  "tgt": "{立绘FFFF}\n换成了{色03}{占位01}{/色}！\n---\n"
 },
 {
  "id": "013771",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0707}「大事にしてね！",
  "tgt": "{立绘0707}「要好好珍惜哟！"
 },
 {
  "id": "013772",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0707}「みんなには\nナイショだけど‥\n---\nわたし、エリーナ様から\nとっても ステキな{色03}宝物{/色}\nもらったんだ！",
  "tgt": "{立绘0707}「虽然对大家\n是秘密‥\n---\n我从艾莉娜大人那儿\n得到了超棒的\n宝物哟！{色03}宝物{/色}\nもらったんだ！"
 },
 {
  "id": "013773",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "「前の ようじんぼうは\n女、子供あいてに\n負けたらしいが‥\n---\n俺は、ちがうぞ\nためしてみるか？{码14010C92}ためしてみよう！\nいえいえそんな‥",
  "tgt": "「听说上一位卫兵\n输给了女人\n孩子‥\n---\n我可不一样\n要试试吗？要试试！\n不不，算了‥{码14010C92}ためしてみよう！\nいえいえそんな‥"
 },
 {
  "id": "013774",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "「けろろろ‥\n元気があって\nけっこう けっこう！",
  "tgt": "「呱呱呱‥\n有精神\n很好很好！"
 },
 {
  "id": "013775",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "「けろろろ‥\n素直なところが\nけっこう けっこう！",
  "tgt": "「呱呱呱‥\n很听话\n很好很好！"
 },
 {
  "id": "013776",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "「お客人かい‥？\n---\nマーロックさんなら\n戻ってきてるぜ。",
  "tgt": "「是客人吗‥？\n---\n马洛克先生的话\n已经回来了哟。"
 },
 {
  "id": "013777",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{金钱00}「はい、いらっしゃい。\nおとまりなら\n{占位00}ゼニーですけど‥？{码14860C93}とまる\n旅の記錄をする\nやめておく",
  "tgt": "{金钱00}「好，欢迎光临。\n住店的话\n{占位00}泽尼……？{码14860C93}住下\n只记录旅程\n还是算了"
 },
 {
  "id": "013778",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "「すまないね‥\nお金 足りないよ。",
  "tgt": "「很抱歉‥\n钱不够哟。"
 },
 {
  "id": "013779",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}リタ\n「‥エリーナさまのゆくえは\nわかりましたか？\n---\n旅のお役に立ちたいのですが\nここをはなれるわけには\nまいりません。\n---\nよければ、私の持っている\nいくつかの知しきを\nお分けしましょうか？{码14820C92}お願いします\nまたの機会に",
  "tgt": "{立绘0000}莉塔\n「……艾莉娜大人\n的下落\n打听清楚了吗？\n---\n虽然想帮上旅途的忙\n但我不能\n离开这里。\n---\n愿意的话\n就把我知道的\n一些知识分给你们吧？{码14820C92}拜托了\n下次有机会吧"
 },
 {
  "id": "013780",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}‥‥どうやら心の用意は\nできているようですね。\n---\nまずは{色04}かばう{/色}心を\n教えましょう。\n---\nたすけあう気持ちがあれば\nきっと すくわれることが\nあるはずです。",
  "tgt": "{立绘0000}……看来你们\n在心里已经准备好了。\n---\n那就先教你\n{色04}掩护{/色}之心吧。\n---\n只要心怀互助\n就一定能在危难中\n得到救赎。"
 },
 {
  "id": "013781",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}‥戦いは心を\nひへいさせます。\n---\n旅につかれたら\nまた この子たちに\n会いに来てください。",
  "tgt": "{立绘0000}……战斗\n会让心变得冰冷。\n---\n旅途累了的话\n请再来\n见见这些孩子。"
 },
 {
  "id": "013782",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}‥それではまずは\nこの{色04}かばう{/色}を\n教えましょう。\n---\n{码0B}{码0B}‥あら‥？\n---\nどうもこれを身につける\n心の用意が、\n---\nまだ誰にも\nないようです。\n---\nすなおな心\nものを大切にする心、\n---\n{色04}けんやく{/色}の心を\n身につけてから\nふたたび来てください。",
  "tgt": "{立绘0000}……那就先教\n这招{色04}掩护{/色}\n吧。\n---\n{码0B}{码0B}……哎呀……？\n---\n学会这个所需的\n心境……\n---\n你们谁\n都还不具备。\n---\n坦率的心\n珍惜事物的心……\n---\n等学会{色04}节俭{/色}之心后\n请再来\n一次吧。"
 },
 {
  "id": "013783",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}もとめるのではなく\nあたえること。\n---\nその心があなたたちを\nみちびくと\n信じています。",
  "tgt": "{立绘0000}不求索取\n而讲给予。\n---\n我相信这份心\n会指引\n你们前行。"
 },
 {
  "id": "013784",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}リタ\n「これは\nひさしぶりです。\n---\nこどもたちにはもう、\n会ってくれましたか。\n---\nとにかく、あなたたちを\nかんげいします。",
  "tgt": "{立绘0000}莉塔\n「哎呀\n好久不见。\n---\n孩子们\n你们见过了吗。\n---\n总之\n欢迎你们。"
 },
 {
  "id": "013785",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}‥だいぶ無理な旅を\nしたようですね。\n---\nせめてもの かわりに\n私の知っている知しきを\nおゆずりします。\n---\nこの{色03}{占位01}{/色}を\n役立ててください。",
  "tgt": "{立绘0000}……看来这段旅途\n相当辛苦呢。\n---\n作为补偿\n就把我所知的\n知识传给你们。\n---\n请好好\n利用这招{色03}{占位01}{/色}吧。"
 },
 {
  "id": "013786",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}旅はまだまだ\n長引きそうですか？\n---\n強くなる分だけ\n人は傷つきやすくなることも\nあります。\n---\nまたいつでも\nたずねてきてください。",
  "tgt": "{立绘0000}旅途看样子\n还长着呢？\n---\n人越变强\n有时也越容易\n受到伤害。\n---\n随时\n都可以再来找我。"
 },
 {
  "id": "013787",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}‥とうとうこれで\n私の持っている知しきは\nみんな教えてしまいました。\n---\nあとにできることは\nあたたかく\n迎えることくらいです。\n---\n旅につかれたら\nいつでもおこしください。",
  "tgt": "{立绘0000}……到此为止\n我知道的知识\n已经全教给你们了。\n---\n接下来我能做的\n就只剩\n热情地迎接了。\n---\n旅途累了的话\n随时请来。"
 },
 {
  "id": "013788",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}何かしてほしいことは\nありますか？{码14820C93}教えをこいたい\n自分のことは自分でやります\n何でもないです",
  "tgt": "{立绘0000}有什么想\n拜托的事吗？{码14820C93}想求教\n自己的事自己做\n没什么事"
 },
 {
  "id": "013789",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}他にもありますか？{码14820C93}教えをこいたい\n自分のことは自分でやります\n何でもないです",
  "tgt": "{立绘0000}还有别的吗？{码14820C93}想求教\n自己的事自己做\n没什么事"
 },
 {
  "id": "013790",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}‥‥みんなすでに\n教えていますが？",
  "tgt": "{立绘0000}……全都\n已经教过了呀？"
 },
 {
  "id": "013791",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}‥では{占位02}に\n{色04}かばう{/色}心を教えます。\n---\nがんばってください。",
  "tgt": "{立绘0000}……那就教{占位02}\n{色04}掩护{/色}之心。\n---\n请加油。"
 },
 {
  "id": "013792",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}‥では あなたたちに\n{色04}かばう{/色}心を教えます。\n---\nがんばってください。",
  "tgt": "{立绘0000}……那就教你们\n{色04}掩护{/色}之心。\n---\n请加油。"
 },
 {
  "id": "013793",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}どうしたのですか？",
  "tgt": "{立绘0000}怎么了吗？"
 },
 {
  "id": "013794",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}‥今教えてる人は\nこの中には\n誰もいませんよ？",
  "tgt": "{立绘0000}……现在正在\n请教的人\n这里可一个都没有哟？"
 },
 {
  "id": "013795",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}‥人の力に賴ることに\nなれた人間は\n弱いものです。\n---\nだから{占位02}の\n気持ちは分かります。\n---\nただ、あまり無理は\nなさらないように\nして下さい。",
  "tgt": "{立绘0000}……习惯依赖\n他人之力的人\n是软弱的。\n---\n不过{占位02}的\n心情我明白。\n---\n只是请别\n太过于\n勉强自己。"
 },
 {
  "id": "013796",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}‥人の力に賴ることに\nなれた人間は\n弱いものです。\n---\nだから{占位02}の\n気持ちは分かります。\n---\nただ、あまり無理を\nなさらないように\nして下さい。",
  "tgt": "{立绘0000}……习惯依赖\n他人之力的人\n是软弱的。\n---\n不过{占位02}的\n心情我明白。\n---\n只是请别\n太过于\n勉强自己。"
 },
 {
  "id": "013797",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}‥どうしたのですか？",
  "tgt": "{立绘0000}……怎么了吗？"
 },
 {
  "id": "013798",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}旅はまだまだ\n長引きそうですか？\n---\n強くなる分だけ\n人は傷つきやすくなることも\nあります。\n---\nまたいつでも\nたずねてきてください。",
  "tgt": "{立绘0000}旅途看样子\n还长着呢？\n---\n人越变强\n有时也越容易\n受到伤害。\n---\n随时\n都可以再来找我。"
 },
 {
  "id": "013799",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0000}リタ\n「‥‥何かすくいを\nお求めですね？\n---\nあなたのような\n目をした人は\n見たことがないです。",
  "tgt": "{立绘0000}莉塔\n「……您在寻求\n救赎吗？\n---\n您这样的\n眼神的人\n我还从没见过。"
 },
 {
  "id": "013800",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "20",
  "tgt": "20"
 },
 {
  "id": "013801",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "25",
  "tgt": "25"
 },
 {
  "id": "013802",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "30",
  "tgt": "30"
 },
 {
  "id": "013803",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "35",
  "tgt": "35"
 },
 {
  "id": "013804",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "おいのり",
  "tgt": "祈祷"
 },
 {
  "id": "013805",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "神撃",
  "tgt": "神击"
 },
 {
  "id": "013806",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "大防御",
  "tgt": "大防御"
 },
 {
  "id": "013807",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "ベネディクション",
  "tgt": "祝祷"
 },
 {
  "id": "013808",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}マーロック\n「{码0B}‥また、\nあんさんたちかいな‥\n---\nそんなんで\nちゃんと旅\nしてはるんでっか？\n---\nふらふら遊んでんなら\nめずらしい宝でも\nさがしたら どないです？\n---\nいい宝見せてくれたら\n商売のしかたでも\n教えてあげまっせ？{码14820C92}宝を見てもらう\n見せない",
  "tgt": "{立绘8141}马洛克\n「‥又是\n你们几位呀‥\n---\n那副样子\n旅途\n还顺利吗？\n---\n要是整天闲晃\n不如找找\n稀罕宝物如何？\n---\n给我看件好宝\n就连做生意的\n门道也教你哟？拿宝物给看\n不给看{码0B}‥また、\nあんさんたちかいな‥\n---\nそんなんで\nちゃんと旅\nしてはるんでっか？\n---\nふらふら遊んでんなら\nめずらしい宝でも\nさがしたら どないです？\n---\nいい宝見せてくれたら\n商売のしかたでも\n教えてあげまっせ？{码14820C92}宝を見てもらう\n見せない"
 },
 {
  "id": "013809",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}{码0B}{码0B}おおっ！\n---\nあんさんの持っている\nこの宝‥\n---\nこれは、けっこう\nねうちもんでっせ。\n---\nこの色といい、ツヤといい\nヌメヌメした手ざわりといい\nまったく{码0B} たまりまへんわ。\n---\n{码0B}{码0B}‥‥いいもん\n見せてもらいました。\n---\nお礼に\nこの{色04}よくばり{/色}\n教えてあげましょ。\n---\nワイのような金持ちに\nなるための\n基本マインドでっせ。",
  "tgt": "{立绘8141}{码0B}{码0B}哦哦！\n---\n您手里的\n这件宝贝……\n---\n可是相当\n值钱的货哟。\n---\n这色泽，这光泽\n这滑溜溜的手感\n实在{码0B} 让人爱不释手哇。\n---\n{码0B}{码0B}……让我\n大开了眼界。\n---\n作为答谢\n就把这招{色04}贪心{/色}\n教给你吧。\n---\n这是想变成\n我这样的有钱人\n的基本心态哟。"
 },
 {
  "id": "013810",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}めずらしいお宝\nどんどん持ってきてや。\n---\n{色02}{占位00}{/色}以上の\nものが手に入ったら、\n---\nまた何か\n教えてあげますわ。",
  "tgt": "{立绘8141}稀奇的宝贝\n尽管多拿来吧。\n---\n要是弄到了\n比{色02}{占位00}{/色}\n更好的东西……\n---\n我再教你\n点别的。"
 },
 {
  "id": "013811",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}{码0B}{码0B}‥まるでガラクタやな。\n---\n目ぇ、よごされたから\nはんたいに おだちん\nもらいたいくらいですわ。\n---\nせめて\n{色02}{道具2205}{/色}くらいは\n手に入れんと。",
  "tgt": "{立绘8141}{码0B}{码0B}……简直是破烂。\n---\n我的眼睛\n都被弄脏了\n反而想收你\n看货费呢。\n---\n至少\n弄个{色02}{道具2205}{/色}\n来再说吧。"
 },
 {
  "id": "013812",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}お金と時間をムダにしたら\nあきまへん。\n---\nこれ、商売だけでなく\n人生の基本でっせ。",
  "tgt": "{立绘8141}浪费钱和时间\n可不行呀。\n---\n这不仅是做生意\n也是人生的基本哟。"
 },
 {
  "id": "013813",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}マーロック\n「{码0B}‥またですか？\n---\nなんかいいお宝でも\n手に入れたんでっか？\n---\nまっ、いそがしい身やけど\n話あいてくらいなら\nなってあげますわ。",
  "tgt": "{立绘8141}马洛克\n「‥又来了？\n---\n是不是淘到什么\n好宝物啦？\n---\n嘛，我虽然忙\n陪你聊聊\n倒也无妨。{码0B}‥またですか？\n---\nなんかいいお宝でも\n手に入れたんでっか？\n---\nまっ、いそがしい身やけど\n話あいてくらいなら\nなってあげますわ。"
 },
 {
  "id": "013814",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}{码0B}‥ほほう\nこれまた、めずらしい\n一品ですな‥\n---\nなるほど、なるほど‥\n---\n{码0B}‥ははーん‥\nふむむ‥‥\nほう‥‥\n---\n{码0B}{码0B}‥これは、あんさん\nまさにお宝中の\nお宝でっせ！\n---\nいいでしょう！\nこの{色03}{占位01}{/色}\n教えてあげますわ！",
  "tgt": "{立绘8141}{码0B}‥嚯嚯\n这又是件\n稀罕货呀‥\n---\n原来如此，原来如此‥\n---\n‥哈哈——\n嗯嗯‥‥\n哦——‥\n---\n‥这可是你们\n宝中宝的\n宝物哟！\n---\n那好！\n这件{码0B}\n就教给你们！{码0B}{码0B}‥これは、あんさん\nまさにお宝中の\nお宝でっせ！\n---\nいいでしょう！\nこの{色03}{占位01}{/色}\n教えてあげますわ！"
 },
 {
  "id": "013815",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}めずらしいお宝\nどんどん持ってきてや。\n---\n{色02}{占位00}{/色}以上の\nものを見せてくれたら、\n---\nまた何か\n教えてあげますわ。",
  "tgt": "{立绘8141}稀奇的宝贝\n尽管多拿来吧。\n---\n要是能拿出\n比{色02}{占位00}{/色}\n更好的东西……\n---\n我再教你\n点别的。"
 },
 {
  "id": "013816",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}{码0B}‥今教えた\n{色03}{道具9604}{/色}で\nワイはもう、品切れですわ。\n---\nそれにしても\nあんさんたち‥\n---\nなかなかホネのある\n人間ですわ。\n感心しました。\n---\n旅を終えたら\n商売のイロハ、\n---\nワイが直に\n教えてあげます。",
  "tgt": "{立绘8141}{码0B}‥刚教的\n{色03}{道具9604}{/色}\n我已经倾囊相授了。\n---\n话说回来\n你们几位‥\n---\n还真是\n有骨气的人呀。\n佩服佩服。\n---\n旅途结束后\n生意的门道‥\n---\n我亲自\n教给你们。"
 },
 {
  "id": "013817",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}で、どないしたいんです？{码14820C93}教えてほしい\nやめます\n何でもないです",
  "tgt": "{立绘8141}那么，想怎么样？想学\n不学了\n没什么{码14820C93}教えてほしい\nやめます\n何でもないです"
 },
 {
  "id": "013818",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}他にもあるんちゃいます？{码14820C93}教えてほしい\nやめます\n何でもないです",
  "tgt": "{立绘8141}还有别的吧？想学\n不学了\n没什么{码14820C93}教えてほしい\nやめます\n何でもないです"
 },
 {
  "id": "013819",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}{码0B}‥みんなワイから\nならってますよ。",
  "tgt": "{立绘8141}{码0B}‥大家都在\n跟我学哟。"
 },
 {
  "id": "013820",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}{码0B}ほなら{占位02}に\n{色04}よくばり{/色}教えたげます。\n---\nはげんでや。",
  "tgt": "{立绘8141}{码0B}那就教{占位02}\n{色04}贪心{/色}吧。\n---\n好好努力哟。"
 },
 {
  "id": "013821",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}{码0B}ほなら あんたたちに\n{色04}よくばり{/色}教えたげます。\n---\nはげんでや。",
  "tgt": "{立绘8141}{码0B}那就教你们\n{色04}贪心{/色}吧。\n---\n好好努力哟。"
 },
 {
  "id": "013822",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}誰もいないんでっか？\n時間のムダづかいは\nゴメンでっせ。",
  "tgt": "{立绘8141}一个人都没有吗？\n浪费时间\n我可拒绝哟。"
 },
 {
  "id": "013823",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}{码0B}‥誰もワイから\nならってまへんで。",
  "tgt": "{立绘8141}{码0B}‥没有人在\n跟我学呀。"
 },
 {
  "id": "013824",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}{码0B}ほなら{占位02}は\nもう、他人やな。",
  "tgt": "{立绘8141}{码0B}那{占位02}\n就算外人了。"
 },
 {
  "id": "013825",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}{码0B}ほなら あんたたちは\nもう他人やな。",
  "tgt": "{立绘8141}{码0B}那你们\n就算外人了。"
 },
 {
  "id": "013826",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}‥どうしたんでっか？\n時間のムダづかいは\nゴメンでっせ。",
  "tgt": "{立绘8141}‥怎么了？\n浪费时间\n我可拒绝哟。"
 },
 {
  "id": "013827",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}宝、さがしなはれ。\n---\n{色02}{占位00}{/色}以上の\nものを見せてくれたら、\n---\nまた何か\n教えてあげますわ。",
  "tgt": "{立绘8141}快去找宝贝吧。\n---\n要是能拿出\n比{色02}{占位00}{/色}\n更好的东西……\n---\n我再教你\n点别的。"
 },
 {
  "id": "013828",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘8141}マーロック\n「‥‥なんです？\n---\nようじんぼうなら\n今は ぼしゅうして\nないですよ？",
  "tgt": "{立绘8141}马洛克\n「‥‥什么事？\n---\n卫兵的话\n现在可没在\n招募哟？"
 },
 {
  "id": "013829",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "フダつきのお宝",
  "tgt": "带牌宝物"
 },
 {
  "id": "013830",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "生え抜きのお宝",
  "tgt": "嫡传宝物"
 },
 {
  "id": "013831",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "お宝の中のお宝",
  "tgt": "宝中宝"
 },
 {
  "id": "013832",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "おまじない",
  "tgt": "咒语"
 },
 {
  "id": "013833",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "ひとりじめ",
  "tgt": "独占"
 },
 {
  "id": "013834",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "ルーレット",
  "tgt": "轮盘"
 },
 {
  "id": "013835",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0404}「チノを しっかり\n見張ってなきゃ‥\n---\nだって、コノコ\nお姉さんだもん。",
  "tgt": "{立绘0404}「得好好\n盯住千乃才行‥\n---\n毕竟，这家伙\n是姐姐呀。"
 },
 {
  "id": "013836",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0C0C}「チノが なにかと\nごめいわくを\nおかけしました\n---\nエリーナ様に、早く\nお会い できるよう‥\n---\n旅のご無事を\nおいのりしています。",
  "tgt": "{立绘0C0C}「千乃给您\n添了\n种种麻烦‥\n---\n愿您早日\n见到艾莉娜大人‥\n---\n祝旅途\n平安无事。"
 },
 {
  "id": "013837",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0E0E}「チェ‥バビっと\n隱れたのになぁ\n---\nもっと、いい隱れ場所\n見つけなきゃ！",
  "tgt": "{立绘0E0E}「切‥明明藏得\n那么隐蔽\n---\n得找个更棒的\n藏身处！"
 },
 {
  "id": "013838",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0606}「チノを 待ってたら\nもっと\nおなかすいた。",
  "tgt": "{立绘0606}「等千乃的时候\n肚子\n又饿了。"
 },
 {
  "id": "013839",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0808}「王女様に 会ったら\nガッテが、よろしくと\nお伝えください。",
  "tgt": "{立绘0808}「见到王女大人\n请代加特\n问好。"
 },
 {
  "id": "013840",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0909}「あの見張りの人‥\n---\nやっぱり、おねえさんと\n話しこんでたんだ。",
  "tgt": "{立绘0909}「那个哨兵呀‥\n---\n果然在和\n大姐姐聊得火热呢。"
 },
 {
  "id": "013841",
  "file": "WORLD/AREAS011.EMI",
  "seg": 11,
  "src": "{立绘0A0A}「へへー、チノ\n見ぃつけたあ。",
  "tgt": "{立绘0A0A}「嘿嘿——，千乃\n被抓到啦。"
 },
 {
  "id": "013842",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "ぱぶぱぶのむら",
  "tgt": "帕布帕布之村"
 },
 {
  "id": "013843",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "追い出されてしまった‥‥",
  "tgt": "被赶出来了‥‥"
 },
 {
  "id": "013844",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「テミ、ノ！\nトップ、ポミ！！",
  "tgt": "{框04}{立绘8040}「特米，诺！\n特普，波米！！"
 },
 {
  "id": "013845",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「コ、プレチ\nテミ、ノ！",
  "tgt": "{框04}{立绘8040}「科，普雷奇\n特米，诺！"
 },
 {
  "id": "013846",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框06}{立绘0101}「なんだ、さわがしい‥\nポコ 归ったのか‥？",
  "tgt": "{框06}{立绘0101}「好吵啊‥\n波科回来了吗‥？"
 },
 {
  "id": "013847",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框04}{立绘0101}「これは‥\nお客さんでしたか！\n---\nようこそ、どうぞ\nお入りください‥！",
  "tgt": "{框04}{立绘0101}「这是‥\n客人啊！\n---\n欢迎欢迎\n请进‥！"
 },
 {
  "id": "013848",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘8141}「そうですか、旅の方‥\n---\n大陸へ 渡ろうと\nしてるんですね‥",
  "tgt": "{立绘8141}「这样啊，是旅客‥\n---\n是想要渡去\n大陆啊‥"
 },
 {
  "id": "013849",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「こう見えて、わたしも\n探険家でしてね‥\n---\n大陸のほうから、こっちへ\n渡ってきたんですよ。",
  "tgt": "{框06}{立绘8141}「别看我这样\n我也是个探险家‥\n---\n就是从大陆那边\n渡过来的。"
 },
 {
  "id": "013850",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「それで、この地で\nカミさんと 出会って‥\n---\n今は、この村に\n住みついてるんです。",
  "tgt": "{框06}{立绘8141}「后来在这片土地上\n遇到了内人‥\n---\n如今就定居在\n这个村里了。"
 },
 {
  "id": "013851",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「ああ、申し遲れましたね\nわたしは、ベイトといいます‥\n---\nで、この連中は\nこの村の住人で‥\n---\nセン、シャミ、リンポ\nポスケ、ペソ‥\n---\nお客さんが めずらしくて\n集まって来たんです‥",
  "tgt": "{框06}{立绘8141}「啊，忘了自我介绍了\n我叫贝特‥\n---\n而这些家伙\n是村里的居民‥\n---\n森、沙米、林波\n波斯凯、佩索‥\n---\n难得有客人来\n都凑过来了‥"
 },
 {
  "id": "013852",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「そして、つまのポコ‥\n---\nなかなかの 美人でしょう？",
  "tgt": "{框06}{立绘8141}「还有内人波科‥\n---\n相当漂亮吧？"
 },
 {
  "id": "013853",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「ポッコ、ピューイ！\n---\nニ、ワーマ ポト\nピューイ‥！",
  "tgt": "{框06}{立绘8040}「波科，皮尤伊！\n---\n尼，瓦马波托\n皮尤伊‥！"
 },
 {
  "id": "013854",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「あなたの おくさんも\nキレイだって、言ってます。",
  "tgt": "{框06}{立绘8141}「她说你的妻子\n也很漂亮呢。"
 },
 {
  "id": "013855",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框05}{立绘0202}「それは、ともかくとして‥\n---\n大陸へ 渡ることに\nついてだが‥",
  "tgt": "{框05}{立绘0202}「那个暂且不谈‥\n---\n说渡去\n大陆的事吧‥"
 },
 {
  "id": "013856",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框05}{立绘8141}「ああ、そうでした‥！",
  "tgt": "{框05}{立绘8141}「啊，对了‥！"
 },
 {
  "id": "013857",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框05}{立绘8141}「おっしゃる通り‥\n---\nここから、西大陸まで\nあさせを伝って\n步いて行く事が できます‥",
  "tgt": "{框05}{立绘8141}「正如您所说‥\n---\n从这里到西大陆\n可以沿着浅滩\n步行过去‥"
 },
 {
  "id": "013858",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘8141}「しかし、あさせが\n通れるのは‥\n---\n海の水が ひいている\nかぎられた時間\nだけなのです。",
  "tgt": "{立绘8141}「可是，浅滩能通行\n‥\n---\n只有在海水退潮时\n限定的时间\n才行。"
 },
 {
  "id": "013859",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0202}「今は、通れないのか？",
  "tgt": "{立绘0202}「现在是通不过吗？"
 },
 {
  "id": "013860",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「プレチ、スル コ！\n---\nタアン カル\nポッコ カイル ニ。",
  "tgt": "{框06}{立绘8040}「普雷奇，苏鲁科！\n---\n塔安卡尔\n波科卡伊鲁尼。"
 },
 {
  "id": "013861",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘8141}「しばらく、ここに\nおいで下さい‥\n---\n通れる時が 来たら\n案內すると、言ってます。",
  "tgt": "{立绘8141}「请在这里\n待上一段时间‥\n---\n它说等到能通行的时候\n就会来带路。"
 },
 {
  "id": "013862",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0101}「パブパブの連中には\nあさせが 通れる時が\n分かるらしいんです‥\n---\nだから、時が来たら\nポコが 案內してくれますよ。",
  "tgt": "{立绘0101}「帕布帕布人似乎\n能知道浅滩\n何时能通行‥\n---\n所以时候一到\n波科就会来带路的。"
 },
 {
  "id": "013863",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0000}「ポッコ ノル タアン\nパケト ノル ノ。\nプレチ プカプカ‥\n---\n{立绘0101}「いつの事に なるか\n分からないので‥\n---\nぶらぶら していてくれ\nとのことです‥",
  "tgt": "{立绘0000}「波科 诺鲁 塔安\n帕凯托 诺鲁 诺。\n普雷奇 普卡普卡…\n---\n{立绘0101}「说是不知\n要到什么时候…\n---\n让我们\n先随便逛逛…"
 },
 {
  "id": "013864",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0003}「コ、パブパブ\nニ、プレチ。",
  "tgt": "{立绘0003}「科，帕布帕布\n尼，普雷奇。"
 },
 {
  "id": "013865",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0004}「ソンナ、ポミタ‥\nテエルタ、テミ。",
  "tgt": "{立绘0004}「松纳，波米塔…\n泰鲁塔，特米。"
 },
 {
  "id": "013866",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0005}「プレチ、プカプカ！",
  "tgt": "{立绘0005}「普雷奇，普卡普卡！"
 },
 {
  "id": "013867",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0003}{码0A}{码03}「{特效}ウウ‥{码0E}{/特效}\n\n---\n{立绘FFFF}何だか、すごく具合が悪そうだ‥",
  "tgt": "{立绘0003}{码0A}{码03}「{特效}呜呜…{码0E}{/特效}\n\n---\n{立绘FFFF}看起来难受得厉害…"
 },
 {
  "id": "013868",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0004}「パブパブ、タトル\nテミ、ピル！\nテミ、プカプカ！",
  "tgt": "{立绘0004}「帕布帕布，塔托鲁\n特米，皮鲁！\n特米，普卡普卡！"
 },
 {
  "id": "013869",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0006}「タトル、タトル！\nテミ、プカプカ。",
  "tgt": "{立绘0006}「塔托鲁，塔托鲁！\n特米，普卡普卡。"
 },
 {
  "id": "013870",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "‥ベイトさんのノートだ。\nこの村のコトバについて\n書いてあるようだ。{码14000C94}『あ』〜『そ』を見る\n『た』〜『の』を見る\n『は』〜『ろ』を見る\n見ない",
  "tgt": "…是贝特先生的笔记。\n记着这个村子的语言。{码14000C94}看『阿』～『索』\n看『塔』～『诺』\n看『哈』～『罗』\n不看"
 },
 {
  "id": "013871",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{色02}アイン{/色} ‥ 〜の間\n{色02}イシ{/色}  ‥ 東。\n{色02}ウェシ{/色} ‥ 西。\n---\n{色02}カイル{/色} ‥ 案內、教え。\n{色02}コ{/色}   ‥ ここ、これ。\n---\n{色02}サナミ{/色} ‥ 南。\n{色02}サント{/色} ‥ ありがとう。\n{色02}ソンナ{/色} ‥ ごめんなさい。",
  "tgt": "{色02}阿因{/色} … …的中间\n{色02}伊希{/色}  … 东。\n{色02}韦西{/色} … 西。\n---\n{色02}凯鲁{/色} … 向导、教。\n{色02}科{/色}   … 这里、这个。\n---\n{色02}萨纳米{/色} … 南。\n{色02}桑托{/色} … 谢谢。\n{色02}松纳{/色} … 对不起。"
 },
 {
  "id": "013872",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{色02}タアン{/色} ‥ 時間。\n{色02}タトル{/色} ‥ おどる。\n---\n{色02}テミ{/色}  ‥ 悪いやつ。\n{色02}トレジャ{/色}‥ 宝物。\n---\n{色02}ナー{/色}  ‥ 魚。\n{色02}ニ{/色}   ‥ あなた、それ。\n{色02}ノ{/色}   ‥ ちがう、だめ。\n---\n{色02}ノスタ{/色} ‥ 北。",
  "tgt": "{色02}塔安{/色} … 时间。\n{色02}塔托鲁{/色} … 起舞。\n---\n{色02}特米{/色}  … 坏家伙。\n{色02}特雷加{/色}… 宝物。\n---\n{色02}纳{/色}  … 鱼。\n{色02}尼{/色}   … 你、那个。\n{色02}诺{/色}   … 不对、不行。\n---\n{色02}诺斯塔{/色} … 北。"
 },
 {
  "id": "013873",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{色02}パケト{/色} ‥ けれども。\n{色02}パブパブ{/色}‥ わたし達。\n{色02}プレチ{/色} ‥ 友達、いいやつ。\n---\n{色02}プカプカ{/色}‥ のんびり、ゆっくり。\n 『なるようになる』の意味もある。\n---\n{色02}ポト{/色}  ‥ もっと、スゴイ。\n{色02}ミチュ{/色} ‥ ひみつ。\n---\n{色02}リクク{/色} ‥ 薬。\n{色02}ロイ{/色}  ‥ 石、いわ。",
  "tgt": "{色02}帕凯托{/色} … 但是。\n{色02}帕布帕布{/色}… 我们。\n{色02}普雷奇{/色} … 朋友、好家伙。\n---\n{色02}普卡普卡{/色}… 悠哉、慢慢来。\n 也有『船到桥头自然直』的意思。\n---\n{色02}波托{/色}  … 更、厉害。\n{色02}米丘{/色} … 秘密。\n---\n{色02}利库库{/色} … 药。\n{色02}洛伊{/色}  … 石头、岩石。"
 },
 {
  "id": "013874",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0101}「え！？\n具合の悪い人‥？",
  "tgt": "{立绘0101}「诶！？\n身体不舒服的人‥？"
 },
 {
  "id": "013875",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘8347}「ええ、あっちの部屋で\nうずくまって いました‥",
  "tgt": "{立绘8347}「嗯，他一直蜷缩在\n那边的房间里‥"
 },
 {
  "id": "013876",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0101}「実は、{码0B}そうなんです‥\n---\nあの病気は、この边の\n薬草では‥\nどうしようも なくって‥\n---\n薬を 探したんですが‥",
  "tgt": "{立绘0101}「其实，是这样的‥\n---\n那种病，靠附近一带的\n药草是‥\n毫无办法的‥\n---\n虽然我们也找过药‥{码0B}そうなんです‥\n---\nあの病気は、この边の\n薬草では‥\nどうしようも なくって‥\n---\n薬を 探したんですが‥"
 },
 {
  "id": "013877",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘8347}「手に入らなかった‥？\n---\nじゃ、あの人は！？",
  "tgt": "{立绘8347}「没有找到‥？\n---\n那，那个人！？"
 },
 {
  "id": "013878",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0101}「もともと‥、ここの連中は\n死ぬも生きるも\n{色02}プカプカ{/色}‥‥\n---\n{色02}なるように、なる{/色}‥、と\n考えていて‥\n---\n死ぬのが 平気らしいんです\nけれど‥‥",
  "tgt": "{立绘0101}「本来…这里的人\n对死对活\n都是{色02}普卡普卡{/色}……\n---\n抱的是{色02}船到桥头自然直{/色}\n…这种想法…\n---\n似乎对死\n毫不畏惧…"
 },
 {
  "id": "013879",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘C140}「できれば、助けて\nあげたいです‥\n---\n薬は、どこで\n見つかるんでしょう？",
  "tgt": "{立绘C140}「如果可以的话\n真想救他‥\n---\n药要到\n哪里才能找到呢？"
 },
 {
  "id": "013880",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「我々も ここで\nただ、待っているより‥\n---\n少しでも\n力になれた方が‥",
  "tgt": "{框06}{立绘C240}「与其我们在这里\n只是干等‥\n---\n不如多少\n帮上点忙‥"
 },
 {
  "id": "013881",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0101}「そうですね‥\n---\n薬を 探して\nいただけるなら‥\n---\n{色02}リプ{/色}へ、行ってみて\nください‥",
  "tgt": "{立绘0101}「是啊…\n---\n若您愿意\n帮忙找药…\n---\n请去{色02}莉普{/色}\n看看…"
 },
 {
  "id": "013882",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0101}「薬は、海でとれる\nものらしいので‥\n---\nリプで 話が\n闻けると思います。",
  "tgt": "{立绘0101}「药似乎是海里\n出产的东西‥\n---\n到里普应该\n能打听到消息。"
 },
 {
  "id": "013883",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0101}「あの病気の薬は\nリプで 闻いてもらえば\n何か 分かると思います。\n---\nすみませんが、お願いします。",
  "tgt": "{立绘0101}「那种病的药\n到里普去问问\n应该就会有所了解。\n---\n麻烦你们了，拜托了。"
 },
 {
  "id": "013884",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0000}「ポッコ サッチタ、リクク‥\n---\n{立绘0101}「実は、ポコにも\n薬を 探しに\n行ってもらったんです‥\n---\nけど、このとおり\nコトバが 通じないんで‥",
  "tgt": "{立绘0000}「波科 萨奇塔，利库库…\n---\n{立绘0101}「其实，也派波科\n去找过\n药了…\n---\n可是像这样\n语言不通…"
 },
 {
  "id": "013885",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框04}{立绘8141}「薬を、持ってきて\n下さったんですか‥？\n---\nでしたら、彼に\nのませてあげて下さい。",
  "tgt": "{框04}{立绘8141}「药，你们带来了\n是吗‥？\n---\n那样的话，请\n喂给他喝吧。"
 },
 {
  "id": "013886",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{码03}は、モズ草を\n与えた‥‥",
  "tgt": "{码03}将伯劳草\n喂给了他‥‥"
 },
 {
  "id": "013887",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0003}「ウウウ‥‥",
  "tgt": "{立绘0003}「呜呜呜……"
 },
 {
  "id": "013888",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "効いている‥、のだろうか？",
  "tgt": "起作用了‥、吗？"
 },
 {
  "id": "013889",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框02}{立绘0101}「ああ、{码0B}ありがとう‥\n---\nこれで、薬が効くかどうかは\nプカプカ‥\n---\nなるようにしか、なりません。",
  "tgt": "{框02}{立绘0101}「啊，谢谢你们‥\n---\n至于药有没有效\n就是普卡普卡了‥\n---\n只能听天由命了。{码0B}ありがとう‥\n---\nこれで、薬が効くかどうかは\nプカプカ‥\n---\nなるようにしか、なりません。"
 },
 {
  "id": "013890",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框02}{立绘0101}「‥ひと晚、様子を見ましょう\n---\n今日は、お休みください。",
  "tgt": "{框02}{立绘0101}「‥观察一个晚上吧\n---\n今天请先休息。"
 },
 {
  "id": "013891",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「よかった‥\n薬、効いたんですね！？",
  "tgt": "{框06}{立绘C140}「太好了‥\n药起效了！？"
 },
 {
  "id": "013892",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框05}{立绘0003}「サント、リクク！\nピルタ、ピルタ！\n---\nタトル、プカプカ パケト\nリクク、プカプカ！\n---\nニ、プレチ\nパブパブ プカプカ\nニ プカプカ ポト！",
  "tgt": "{框05}{立绘0003}「桑托，利库库！\n皮鲁塔，皮鲁塔！\n---\n塔托鲁，普卡普卡 帕凯托\n利库库，普卡普卡！\n---\n尼，普雷奇\n帕布帕布 普卡普卡\n尼 普卡普卡 波托！"
 },
 {
  "id": "013893",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0101}「おどりでも、よくなった\nかもしれないけど‥\n---\nあなた方が、薬を\n持ってきて くれたのも\nなるべくして、なった事‥\n---\nありがとう、と‥",
  "tgt": "{立绘0101}「说不定是跳舞\n让他好起来的‥\n---\n但你们把药\n带过来这件事\n也是命中注定的‥\n---\n谢谢，谢谢‥"
 },
 {
  "id": "013894",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0006}{码0A}{队员3C}プカプカ、プカプカ！",
  "tgt": "{立绘0006}{码0A}{队员3C}普卡普卡，普卡普卡！"
 },
 {
  "id": "013895",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0101}「プカプカ‥\nなるように、なると言うのは‥\n---\n彼ら、パブパブの\n生き方なのです。\n---\nそれと、みなさんの\n無事をいのる、と言う意味も\nあるのです‥",
  "tgt": "{立绘0101}「普卡普卡‥\n所谓顺其自然‥\n---\n是他们帕布帕布人\n的生存之道。\n---\n同时，也包含着\n祈愿大家\n平安的意思‥"
 },
 {
  "id": "013896",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0004}{码0A}{/色}「ニ、プレチ\nサント プカプカ！",
  "tgt": "{立绘0004}{码0A}{/色}「尼，普雷奇\n桑托 普卡普卡！"
 },
 {
  "id": "013897",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘8447}「とにかく、よくなって\nよかったです‥\n---\n{立绘8547}よろこんで‥\nくれてるんですよ、ね？",
  "tgt": "{立绘8447}「总之，人没事\n就好了‥\n---\n{立绘8547}他很高兴\n对吧？"
 },
 {
  "id": "013898",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0003}{码0A}{色3C}サント、プレチ！\nパブパブ カイン、ミチュ！\n---\nアイン {色02}リプ{/色}、{色02}シューク{/色}\nロイ、ロイ‥\n---\nノスタ、ロイ‥\nポト {色02}トレジャ{/色}！！",
  "tgt": "{立绘0003}{码0A}{色3C}桑托，普雷奇！\n帕布帕布 凯因，米丘！\n---\n阿因 {色02}莉普{/色}、{色02}修克{/色}\n洛伊，洛伊…\n---\n诺斯塔，洛伊…\n波托 {色02}特雷加{/色}！！"
 },
 {
  "id": "013899",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0101}「どうも、ありがとう\nみなさん‥",
  "tgt": "{立绘0101}「多谢\n各位了‥"
 },
 {
  "id": "013900",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「プレチ！ プレチ！",
  "tgt": "{框06}{立绘8040}「普雷奇！普雷奇！"
 },
 {
  "id": "013901",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0000}「プレチ、タアン カル！\nタアン カル！",
  "tgt": "{立绘0000}「普雷奇，塔安 卡鲁！\n塔安 卡鲁！"
 },
 {
  "id": "013902",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘8141}「みなさん、どうやら‥\n---\nあさせを 通れる時が\n来たようです。",
  "tgt": "{立绘8141}「各位，看来‥\n---\n能通过浅滩的时候\n到了。"
 },
 {
  "id": "013903",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0000}「タアン、カル！\nポッコ カイル プレチ！",
  "tgt": "{立绘0000}「塔安，卡鲁！\n波科 凯鲁 普雷奇！"
 },
 {
  "id": "013904",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框05}{立绘0101}「みなさん、急いで\n出発してください‥\n---\nあさせが、渡れる時間は\nかぎられています‥！",
  "tgt": "{框05}{立绘0101}「各位，请赶快\n出发‥\n---\n能渡过浅滩的时间\n是有限的‥！"
 },
 {
  "id": "013905",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「わかりました、ベイトさん\nお世話になりました‥！",
  "tgt": "{框06}{立绘C140}「明白了，贝特先生\n多谢您的照顾‥！"
 },
 {
  "id": "013906",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「わかった‥、世話になった。",
  "tgt": "{框06}{立绘C240}「知道了‥、多谢照顾。"
 },
 {
  "id": "013907",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框06}{立绘C540}「そうするって\n言ってますよ。",
  "tgt": "{框06}{立绘C540}「它说\n就这么办哦。"
 },
 {
  "id": "013908",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框06}{立绘C440}「わかった、そうしよう。",
  "tgt": "{框06}{立绘C440}「明白了，就这么办。"
 },
 {
  "id": "013909",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{框05}{立绘0101}「あさせの場所まで\nポコが、案內します‥\n---\nそれでは、みなさん\nお気をつけて‥！\nプレチ、プカプカ！",
  "tgt": "{框05}{立绘0101}「到浅滩的路上\n波科会带路‥\n---\n那么，各位\n请多保重‥！\n普雷奇、普卡普卡！"
 },
 {
  "id": "013910",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0101}「おや、どうしました？\n---\nあさせを 通るなら\n急いだほうが、いいですよ。",
  "tgt": "{立绘0101}「哎呀，怎么了？\n---\n要过浅滩的话\n还是抓紧点好哦。"
 },
 {
  "id": "013911",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0101}「やあ、みなさん！\n---\nあさせは‥無事に\n通れましたか？",
  "tgt": "{立绘0101}「哟，各位！\n---\n浅滩‥顺利\n过去了吗？"
 },
 {
  "id": "013912",
  "file": "WORLD/AREAS012.EMI",
  "seg": 11,
  "src": "{立绘0000}「アサセ‥{码0B}トオ{码0B}ルタ？\n---\n{立绘0101}「どうです？\n---\n少し 話せるように\nなったんですよ。",
  "tgt": "{立绘0000}「阿萨塞…{码0B}托奥{码0B}鲁塔？\n---\n{立绘0101}「怎么样？\n---\n已经能\n说上几句了哟。"
 },
 {
  "id": "013913",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "「かたなかじの小屋",
  "tgt": "刀匠小屋"
 },
 {
  "id": "013914",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘0000}「ハイホー！？\nなんだの、アンタら？",
  "tgt": "{立绘0000}「嗨嚯！？\n你们来干什么？"
 },
 {
  "id": "013915",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘8040}「ホー、『{道具0101}』！\n---\nたしかに あの剣は\nワシが 作ったから‥\n---\n同じ物を 作るのは\nムズかしくは ないぞ！",
  "tgt": "{立绘8040}「嚯，『{道具0101}』！\n---\n那把剑确实\n是我打造的‥\n---\n再做一把一样的\n不难！"
 },
 {
  "id": "013916",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘8040}「じゃが、それも\nざいりょうが 手に入らんと\n始まらんがのぉ‥‥",
  "tgt": "{立绘8040}「不过，那也得\n弄到材料\n才能开工呀‥‥"
 },
 {
  "id": "013917",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘0101}「‥ざいりょう？",
  "tgt": "{立绘0101}「‥材料？"
 },
 {
  "id": "013918",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘8040}「ホー！\n『{道具4E00}』と\n呼ばれる‥\n---\nめずらしい 金属でな‥\n---\n妖精の住む 世界で\n見つかるんじゃ‥",
  "tgt": "{立绘8040}「嚯！\n这东西叫\n『{道具4E00}』……\n---\n是种\n稀奇的金属……\n---\n在妖精居住的世界\n才能找到……"
 },
 {
  "id": "013919",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘8040}「じゃが、知ってのとおり\n妖精たちは‥\n---\nワシら 人の眼には\n見えんからのぉ‥",
  "tgt": "{立绘8040}「不过你们也知道\n妖精们‥\n---\n在我们人的眼里\n是看不见的呀‥"
 },
 {
  "id": "013920",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘4500}「{队员05}、見えましたよ。",
  "tgt": "{立绘4500}「{队员05}，看得见了哟。"
 },
 {
  "id": "013921",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘8040}「{道具4E00}は\n妖精の 落し物とも\n呼ばれておってな‥\n---\n黄金と 同じくらい\nものスゴイ物なんじゃ。",
  "tgt": "{立绘8040}「{道具4E00}\n也被叫作\n妖精的遗落之物……\n---\n是和黄金\n一样了不得的东西。"
 },
 {
  "id": "013922",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘4100}「あの、突然すみません。\n---\n実は‥ 作っていただきたい\n物が あるんです。",
  "tgt": "{立绘4100}「那个，突然来访\n真不好意思。\n---\n其实……我们想\n请您\n打造一件东西。"
 },
 {
  "id": "013923",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘8040}「ホー！\nそりゃ、話が早い‥\n---\nだったら、まず\n妖精たちの 所に行って‥\n---\n{道具4E00}を\nもらって来るといい！",
  "tgt": "{立绘8040}「嚯！\n那可好办……\n---\n那就先去\n妖精们那里……\n---\n把{道具4E00}\n要来再说！"
 },
 {
  "id": "013924",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘8040}「ホーウ、これは‥！",
  "tgt": "{立绘8040}「嚯哇，这是‥！"
 },
 {
  "id": "013925",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘8040}「色と言い、ツヤと言い‥\n---\nなんとも リッパな\n{道具4E00} じゃな！",
  "tgt": "{立绘8040}「这色泽，这光泽……\n---\n真是件\n出色的{道具4E00}啊！"
 },
 {
  "id": "013926",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘8040}「これなら、アンタらが\n欲しがっている‥\n---\n{道具0101}を もう一度\n作れるぞい！",
  "tgt": "{立绘8040}「有了这些\n你们想要的‥\n---\n{道具0101}就能\n再打造一把了！"
 },
 {
  "id": "013927",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘8040}「そこで 待っとれ\nあっ、という間に\n作ってやるからの‥\n---\nせーので‥",
  "tgt": "{立绘8040}「在那儿等着吧\n我眨眼间\n就给你们打出来‥\n---\n一、二、三‥"
 },
 {
  "id": "013928",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘8040}「{特效}あ〜〜〜〜〜〜〜〜〜〜〜〜{码0E}{/特效}",
  "tgt": "{立绘8040}「哈——————{特效}あ〜〜〜〜〜〜〜〜〜〜〜〜{码0E}{/特效}"
 },
 {
  "id": "013929",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘8040}「ど、{码0B}どうじゃ‥\n{色02}あっ{/色}、という間に\n出来上がりじゃ！\n---\nほれ、持っていくがいい。",
  "tgt": "{立绘8040}「怎，{码0B}怎么样……\n{色02}转眼{/色}之间\n就打好了！\n---\n拿去用吧。"
 },
 {
  "id": "013930",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘FFFF}\n   {色03}{道具0101}{/色}を手に入れた！",
  "tgt": "{立绘FFFF}\n得到了{色03}{道具0101}{/色}！"
 },
 {
  "id": "013931",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘8040}「ん？\n{道具0101}が、ニセモノ？\n---\nホーホー！\nばか言っちゃ、いかん。\n---\nワシが 作ったんじゃから\n本物じゃ！",
  "tgt": "{立绘8040}「嗯？\n{道具0101}是假货？\n---\n嚯嚯！\n胡说什么呢。\n---\n我打造的\n当然是真货！"
 },
 {
  "id": "013932",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘0201}「ありがとうございます\nおじいさん‥！",
  "tgt": "{立绘0201}「多谢您了\n老爷爷‥！"
 },
 {
  "id": "013933",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘4100}「これで、兄さまを\n助けることが‥\nできるかも しれません‥\n---\nルディアの城に\n戻りましょう！",
  "tgt": "{立绘4100}「这下\n说不定\n就能救哥哥了……\n---\n回卢迪亚城吧！"
 },
 {
  "id": "013934",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘8040}「ハイホー、また来たのう！\n---\n{色03}ざいりょう{/色}に なる物を\n持って来たのなら‥\n---\nワシが ステキな『ヨロイ』を\nこしらえて やろうか？{码14000C92}こしらえて！\nけっこうです",
  "tgt": "{立绘8040}「嗨嚯，又来啦！\n---\n要是带来了\n能当{色03}材料{/色}的东西……\n---\n要不要老夫给你们\n打造一件漂亮的『铠甲』？{码14000C92}拜托打造！\n不必了"
 },
 {
  "id": "013935",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘8040}「ホー、残念じゃの‥\nまた 来とくれ。",
  "tgt": "{立绘8040}「嚯，真遗憾呀‥\n再来吧。"
 },
 {
  "id": "013936",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘8040}「ホー、ざいりょうが\n足りないようじゃの‥\nまた 来とくれ。",
  "tgt": "{立绘8040}「嚯，材料\n好像不够呀‥\n再来吧。"
 },
 {
  "id": "013937",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{立绘8040}「ホホー！ それじゃあ\nざいりょうを 3つ選ぶんじゃ\n同じ物でも かまわんぞ。",
  "tgt": "{立绘8040}「嚯嚯！那就\n选3样材料吧\n一样也没关系哟。"
 },
 {
  "id": "013938",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{框02}{立绘8040}「{色03}{占位00}{/色}と\n{色03}{占位01}{/色}と\n{色03}{占位02}{/色}‥\n---\nこの ざいりょうで\n作るが、いいかのう？{码14010C92}作ってもらう\nやっぱりやめる",
  "tgt": "{框02}{立绘8040}「用{色03}{占位00}{/色}\n{色03}{占位01}{/色}\n{色03}{占位02}{/色}……\n---\n用这些材料打造\n可以吗？{码14010C92}请打造\n还是算了"
 },
 {
  "id": "013939",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "\n {色03}{占位00}{/色}を 手に入れた！",
  "tgt": "\n 得到了{色03}{占位00}{/色}！"
 },
 {
  "id": "013940",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{色02}1つめ{/色}",
  "tgt": "{色02}第1个{/色}"
 },
 {
  "id": "013941",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{色03}2つめ{/色}",
  "tgt": "{色03}第2样{/色}"
 },
 {
  "id": "013942",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "{色04}3つめ{/色}",
  "tgt": "{色04}第3个{/色}"
 },
 {
  "id": "013943",
  "file": "WORLD/AREAS013.EMI",
  "seg": 11,
  "src": "ヨロイの{色03}ざいりょう{/色}を {色02}3つ{/色}選びます",
  "tgt": "选择{色02}3样{/色}铠甲的{色03}材料{/色}"
 },
 {
  "id": "013944",
  "file": "WORLD/AREAS014.EMI",
  "seg": 11,
  "src": "{框21}\n   操作の說明を讀みますか？{码14000C82}はい\nいいえ",
  "tgt": "{框21}\n   要读操作说明吗？{码14000C82}是\n否"
 },
 {
  "id": "013945",
  "file": "WORLD/AREAS014.EMI",
  "seg": 11,
  "src": "{框21}{队员02}を先頭にし、操作して‥\n---\n{色03}ツボ{/色}を {色03}北の立てふだ{/色}の所、\n{色02}タル{/色}を {色02}南の立てふだ{/色}の所に\n運んでいきます。\n---\n{色04}古いタル{/色}は じゃまなので\n{队员05}を先頭にして {色0A}{占位00}{/色}ボタンで\n壊してください。\n---\nはやく、きれいに整理すると\nいいことが あるかも‥？\n---\n{色03}ツボ{/色}と{色02}タル{/色}を 1コづつならべたら\n後は壊しちゃうのも ありかな‥？\n---\nまた、外に出てしまうと\nやり直しになるので 注意！\n---\n\n  もう一度、說明を讀みますか？{码14000C82}はい\nいいえ",
  "tgt": "{框21}让{队员02}打头阵来操作……\n---\n把{色03}陶罐{/色}搬到{色03}北边立牌{/色}处，\n把{色02}木桶{/色}搬到{色02}南边立牌{/色}处。\n---\n{色04}旧木桶{/色}很碍事\n让{队员05}打头阵\n用{色0A}{占位00}{/色}键打碎。\n---\n要是又快又整齐地\n整理好，说不定有好事……？\n---\n把{色03}陶罐{/色}和{色02}木桶{/色}各摆一个后\n其余全打碎，好像也行……？\n---\n另外，一旦走出屋外\n就得重新开始，注意！\n---\n\n  要再读一遍说明吗？{码14000C82}是\n否"
 },
 {
  "id": "013946",
  "file": "WORLD/AREAS014.EMI",
  "seg": 11,
  "src": "{打字02}\n    こちら {色03}ツボ{/色}置き場",
  "tgt": "{打字02}\n这里是罐子放置处{色03}ツボ{/色}置き場"
 },
 {
  "id": "013947",
  "file": "WORLD/AREAS014.EMI",
  "seg": 11,
  "src": "{打字02}\n    こちら {色05}タル{/色}置き場",
  "tgt": "{打字02}\n这里是桶放置处{色05}タル{/色}置き場"
 },
 {
  "id": "013948",
  "file": "WORLD/AREAS014.EMI",
  "seg": 11,
  "src": "{立绘0000}外に出ますか？{码14010CC2}はい\nいいえ",
  "tgt": "{立绘0000}要出去吗？{码14010CC2}是\n否"
 },
 {
  "id": "013949",
  "file": "WORLD/AREAS014.EMI",
  "seg": 11,
  "src": "タイムボーナス",
  "tgt": "时间奖励"
 },
 {
  "id": "013950",
  "file": "WORLD/AREAS014.EMI",
  "seg": 11,
  "src": "{框01}{打字02}     タイムボーナス！     \n      {色02}{占位00}{/色}PTS.\n{码0B}{码0B}{码0B}",
  "tgt": "{框01}{打字02}     时间奖励！     \n      {色02}{占位00}{/色}PTS.\n{码0B}{码0B}{码0B}"
 },
 {
  "id": "013951",
  "file": "WORLD/AREAS014.EMI",
  "seg": 11,
  "src": "「フーム、このタルの\n並べ方といったら\nどうだい‥？\n---\nむこうの ツボなんざ\nおよびもつかんね！",
  "tgt": "「嗯～，这桶\n摆的架势\n如何呀‥？\n---\n那边的罐子\n根本没法比哟！"
 },
 {
  "id": "013952",
  "file": "WORLD/AREAS014.EMI",
  "seg": 11,
  "src": "「クーッ、どうよ？\nこのツボの 並びっぷり‥\n---\nあっちの タルが\nかすんで見えるぜ！",
  "tgt": "「咕——，如何？\n这罐子摆的架势‥\n---\n那边的桶\n都看不清了！"
 },
 {
  "id": "013953",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}ふーれんしつない",
  "tgt": "{立绘0000}福莲室内"
 },
 {
  "id": "013954",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「族長さま‥\n何か、事件に\nまきこまれてるってねぇ‥",
  "tgt": "「族长大人‥\n听说被卷进了\n什么事件呀‥"
 },
 {
  "id": "013955",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「{队员02}さま\n敵国で、捕まったって\n話しだねぇ‥\n---\nこりゃ、また\n戦になるねぇ‥",
  "tgt": "「{队员02}大人\n在敌国被捕了\n听说了呀‥\n---\n这下又要\n打仗了呢‥"
 },
 {
  "id": "013956",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「{队员02}さまは‥\n---\n行方不明になった\nウインディアの王女様を\n探しに行かれたのよ‥\n---\n何か、ロマンチック‥！",
  "tgt": "「{队员02}大人‥\n---\n是去找失踪的\n温迪亚王女大人\n才出的事哟‥\n---\n总觉得好浪漫‥！"
 },
 {
  "id": "013957",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「001Aにへんこうです。",
  "tgt": "「已切换为001A。"
 },
 {
  "id": "013958",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0101}「ん‥？\nわいの仲間、どこにでも\nおるってか？\n---\n{金钱00}わいらの一族は\n商売による、世界セーフクを\n狙っとるからな！{码14840C94}じゃ、買い物してあげよう\nふーん、何か売ってやるか\nなら、武器の下取りでも‥\n世界セーフクに協力しない",
  "tgt": "{立绘0101}「嗯……？\n你是说我的同伙\n哪儿都有？\n---\n{金钱00}我们这一族\n正瞄准靠生意\n称霸世界呢！{码14840C94}那，让你买点东西\n哼——，卖你点什么吧\n那就，武器折价回收……\n不协助称霸世界"
 },
 {
  "id": "013959",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「フーレンの一族は\nすごく強いので 有名だから‥\n---\n弟子になろうと、旅してくる\n人もいるんだって。",
  "tgt": "「弗雷恩一族\n以强大出名‥\n---\n所以也有人为了拜师\n远道而来呢。"
 },
 {
  "id": "013960",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}「カンちゃん、見なかった？\nあたしの弟子‥",
  "tgt": "{立绘0000}「看见小坎了吗？\n我的弟子……"
 },
 {
  "id": "013961",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘8242}「ふーむ‥\n{队员02}が そんな事に‥",
  "tgt": "{立绘8242}「嗯～‥\n{队员02}竟出了这种事‥"
 },
 {
  "id": "013962",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘8343}「ルディアめ‥\nフーレンを あまく見おって！\n---\nこうなれば、もう\n戦爭じゃ！",
  "tgt": "{立绘8343}「鲁迪亚那厮‥\n竟小看弗雷恩！\n---\n事已至此\n只能开战了！"
 },
 {
  "id": "013963",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘8444}「そうじゃ！",
  "tgt": "{立绘8444}「正是！"
 },
 {
  "id": "013964",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘8242}「まて、まて‥\nうかつな事を 言うでない\n---\nそうでなくても、フーレンは\n皆、血の気が\n多いんじゃから‥",
  "tgt": "{立绘8242}「等等，等等‥\n别口出轻率之言\n---\n弗雷恩人本就\n个个血气\n旺盛‥"
 },
 {
  "id": "013965",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘8444}「そうじゃ！",
  "tgt": "{立绘8444}「正是！"
 },
 {
  "id": "013966",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘8343}「ふん‥、じゃあ\nどうすると言うんじゃ‥\n---\nわざわざ、{队员01}さんが\n若の身を案じて\n報せてくれたのに‥",
  "tgt": "{立绘8343}「哼‥，那你说\n怎么办‥\n---\n{队员01}先生特意\n为少爷的安危\n来报信呀‥"
 },
 {
  "id": "013967",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘8444}「そうじゃ！\nそれにしても‥\n---\n{队员01}ちゃん\n大きくなったのぉ‥！\n---\n前に見たときは\nこぉーんな、チビで‥",
  "tgt": "{立绘8444}「正是！\n话说回来‥\n---\n{队员01}丫头\n都长这么大了呀‥！\n---\n上次见的时候\n还是这么小的小不点‥"
 },
 {
  "id": "013968",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘8242}「い、いや‥\nそれは さておき‥\n---\nどうしたもんじゃ‥",
  "tgt": "{立绘8242}「不，不‥\n先不说这个‥\n---\n这事怎么办呀‥"
 },
 {
  "id": "013969",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘8343}「うむぅ‥、こんなときに\n{色02}ターボさま{/色}が\nいらっしゃれば、のぉ‥",
  "tgt": "{立绘8343}「唔嗯……这种时候\n要是{色02}塔博大人{/色}\n还在就好了……"
 },
 {
  "id": "013970",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘4100}「ターボさま‥、って？",
  "tgt": "{立绘4100}「塔博大人……是指？"
 },
 {
  "id": "013971",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘8444}「なくなった、前の族長の\nおくさま‥\n---\n{队员02}の、母上じゃ。",
  "tgt": "{立绘8444}「是已故的前任族长\n夫人‥\n---\n{队员02}的母亲呀。"
 },
 {
  "id": "013972",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘8343}「若が‥、{队员02}が\n族長になった後‥\n---\nターボさまは\n里を はなれて‥\n---\n{色02}黄金平野{/色}に\n移り住まれたんじゃ。",
  "tgt": "{立绘8343}「自从{队员02}\n当上族长之后……\n---\n塔博大人\n就离开了村子……\n---\n移居到了\n{色02}黄金平原{/色}。"
 },
 {
  "id": "013973",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘8444}「さすらいの旅じゃ。",
  "tgt": "{立绘8444}「四处游历去了。"
 },
 {
  "id": "013974",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘8242}「ターボさまなら、何か\nよい考えが‥\nあったかも しれんが‥\n---\nワシらでは‥‥",
  "tgt": "{立绘8242}「塔博大人在的话\n也许会有\n好主意‥\n---\n光靠我们‥‥"
 },
 {
  "id": "013975",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘8444}「もう少し 若ければ\nうまに乘って‥\n---\nターボ様を 探しに\n行ったんじゃが、なあ‥",
  "tgt": "{立绘8444}「要是再年轻几岁\n就骑马\n---\n去找塔博大人\n了呀，唉‥"
 },
 {
  "id": "013976",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0202}「ターボさまなら、何か\n{队员02}を 救う\nよい手を、考えるじゃろうな‥",
  "tgt": "{立绘0202}「塔博大人的话\n定会想出救{队员02}的\n好办法吧‥"
 },
 {
  "id": "013977",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0303}「ターボさまは、今ごろ\n黄金平野で\nひとり旅じゃ‥‥\n---\n黄金平野に 行くなら\n---\nうまが いるなぁ‥",
  "tgt": "{立绘0303}「塔博大人如今\n大概正在黄金平原\n独自旅行‥‥\n---\n要去黄金平原的话\n---\n得有马呀‥"
 },
 {
  "id": "013978",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0404}「わしらじゃと\nすぐに、戦のことばかり\n考えてしまうんじゃ‥",
  "tgt": "{立绘0404}「换成我们\n满脑子\n就只剩打仗了‥"
 },
 {
  "id": "013979",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「休んでお行き、旅の人{码14860C93}ひと休みしよう\n記錄だけしよう\n今はやめておこう",
  "tgt": "住一晚再走吧，旅行的人休息一下\n只做记录\n现在算了{码14860C93}ひと休みしよう\n記錄だけしよう\n今はやめておこう"
 },
 {
  "id": "013980",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「金が足らん。",
  "tgt": "「钱不够。"
 },
 {
  "id": "013981",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0404}「ふむ、なるほど\n{道具0101}のニセモノを‥\n---\nその手が あったか\nさすがはターボさまじゃ！",
  "tgt": "{立绘0404}「唔，原来如此\n{道具0101}的假货‥\n---\n竟有这种办法\n不愧是塔博大人呀！"
 },
 {
  "id": "013982",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0303}「この一件は、もう\nおぬしらに まかす他\nないわい‥\n---\nお願いしますぞ‥！",
  "tgt": "{立绘0303}「这件事\n就只能拜托\n你们了‥\n---\n拜托了呀‥！"
 },
 {
  "id": "013983",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0202}「{色02}グーの火山{/色}に\n行くにはな‥\n---\nまず、黄金平野を\nずっと{色02}東{/色}にすすみ‥\n---\n大きな岩が 見えたら\n次に、{色02}南{/色}にすすむ‥\n---\n遠くに見える けむりの\nのぼる山が{色02}グーの火山{/色}じゃ。",
  "tgt": "{立绘0202}「要去{色02}古之火山{/色}的话……\n---\n先沿着黄金平原\n一直往{色02}东{/色}走……\n---\n看见大石头后\n接着往{色02}南{/色}走……\n---\n远处冒烟的那座山\n就是{色02}古之火山{/色}。"
 },
 {
  "id": "013984",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}「カンちゃんねー\nもっと 修行するんだって\n飛び出して いっちゃった‥\n---\n別に 強くなんなくても\nいいのになー",
  "tgt": "{立绘0000}「小坎那家伙\n说要好好修行\n就跑出去了……\n---\n其实\n不变强也没关系呀——"
 },
 {
  "id": "013985",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{框02}{立绘0000}「だーめよ カンちゃん\nケンカしたりしちゃ‥\n---\nアンタ 弱いんだから。",
  "tgt": "{框02}{立绘0000}「不行哟，小坎\n不许跟人吵架……\n---\n你可是很弱的。"
 },
 {
  "id": "013986",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘8545}「ふぬー！？\n---\nし、師匠‥オレって\nよ、{码0B}弱いんですか‥？",
  "tgt": "{立绘8545}「呜奴——！？\n---\n师，师父‥我很\n弱吗‥？{码0B}弱いんですか‥？"
 },
 {
  "id": "013987",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{框02}{立绘0000}「うん、まあ‥\nちょっと‥、まあまあ‥",
  "tgt": "{框02}{立绘0000}「嗯，算……\n还算……一般吧……"
 },
 {
  "id": "013988",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{框02}{立绘0000}「まあ、ここで‥\nわたしの 手伝いを\nしてれば‥‥\n---\nそのうち それなりには\nなると思うけど、{码0B}ね。",
  "tgt": "{框02}{立绘0000}「嘛，在这儿……\n帮我打打杂的话……\n---\n我想你迟早\n也能有\n几分出息，{码0B}吧。"
 },
 {
  "id": "013989",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘4100}「そうですね‥\nターボ様に お会いすれば‥\n---\nなんとか なるかも\nしれないって 事ですか‥",
  "tgt": "{立绘4100}「也就是说……\n只要见到塔博大人……\n---\n说不定就\n有办法\n解决了吗……"
 },
 {
  "id": "013990",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0202}「ともかく、ありがとうよ‥\n---\n今後のことは、わしらも\n協力するが‥\n---\nやはり、ターボ様に\n話した方が、よかろうて‥",
  "tgt": "{立绘0202}「总之，多谢了‥\n---\n今后的事\n我们也会协助‥\n---\n但还是该跟塔博大人\n说一声呀‥"
 },
 {
  "id": "013991",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0202}「これ、{队员02}\nそんな事では、族長として‥\n---\n‥いや、{码0B}とにかく無事で\nよかったわい。\n---\nターボ様にも、きちんと\n話しておくんじゃぞ‥",
  "tgt": "{立绘0202}「喂，{队员02}\n那样可当不了族长呀‥\n---\n‥不，总之平安\n就好。\n---\n也要跟塔博大人\n好好说清楚哟‥{码0B}とにかく無事で\nよかったわい。\n---\nターボ様にも、きちんと\n話しておくんじゃぞ‥"
 },
 {
  "id": "013992",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0303}「ルディアめ‥！\n---\n連合の長だか、何だか\n知らんが‥\n---\n我らの族長を\nかどわかすとは‥！",
  "tgt": "{立绘0303}「鲁迪亚那厮‥！\n---\n什么联军首领\n管他是谁‥\n---\n竟敢拐走\n我们的族长‥！"
 },
 {
  "id": "013993",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0303}「若、{码0B}ルディアに\nリベンジするんなら‥\n---\nワシも 共にゆくぞ！",
  "tgt": "{立绘0303}「少爷，要去\n鲁迪亚报仇的话‥\n---\n我也同去！{码0B}ルディアに\nリベンジするんなら‥\n---\nワシも 共にゆくぞ！"
 },
 {
  "id": "013994",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0404}「若を、助け出したか‥\n---\nルディアの出方が\nもんだいじゃが‥\n---\nまずは、めでたいわい。",
  "tgt": "{立绘0404}「把少爷救出来了呀‥\n---\n鲁迪亚会怎么出招\n是个问题‥\n---\n但总之，可喜可贺呀。"
 },
 {
  "id": "013995",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0404}「おお、{队员02}！\n---\nよかったのぉ‥！",
  "tgt": "{立绘0404}「哦，{队员02}！\n---\n太好了呀‥！"
 },
 {
  "id": "013996",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「族長さま、無事で\nよかったよ‥\n---\n事件とやらは\n解決したのかねぇ？",
  "tgt": "「族长大人没事\n太好了‥\n---\n那个事件\n解决了吗？"
 },
 {
  "id": "013997",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「{队员02}さま、归って\nきなすったねぇ‥\n---\nこれで 戦にならずに\nすむかねぇ‥",
  "tgt": "「{队员02}大人回来\n了呀‥\n---\n这样就不会\n打起来了吧‥"
 },
 {
  "id": "013998",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「{队员02}さま‥\n---\n仲間の方が ルディアから\n助け出したんですってね\n---\n何か、ドラマチック‥！",
  "tgt": "「{队员02}大人‥\n---\n是伙伴们从鲁迪亚\n救出来的呢\n---\n总觉得好戏剧‥！"
 },
 {
  "id": "013999",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「コワイ顏した 大男を\n見かけたけど‥\n---\nあの人も 弟子入りしに\n来たのかな？",
  "tgt": "「见到了一个\n面相凶恶的大汉‥\n---\n那人也是来\n拜师的吗？"
 },
 {
  "id": "014000",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0202}「ふむ‥‥\n---\nウインディアまで\n竜に会いに‥、か。\n---\nともかく、この地に\nとどまって おるよりは\n安全かもしれん‥",
  "tgt": "{立绘0202}「唔‥‥\n---\n去温迪亚\n见龙‥，吗。\n---\n总之，总比\n留在此地\n安全吧‥"
 },
 {
  "id": "014001",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0202}「ウインディアで、竜に会い‥\n---\n{队员00}どのの事が\n何か、分かれば‥\n---\nルディアの追求を\nかわせるかも‥、と\n言う事じゃな。",
  "tgt": "{立绘0202}「在温蒂亚见过龙……\n---\n只要能弄清\n一点{队员00}大人的事……\n---\n说不定就能\n搪塞过去\n卢迪亚的追究……是这样吧。"
 },
 {
  "id": "014002",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0303}「帝国との条約で\nここも、中立地に\nされたら‥\n---\nいや、そんな事は\n許さんわい！",
  "tgt": "{立绘0303}「跟帝国的条约要是\n把这里也划成\n中立地‥\n---\n哼，那种事\n我绝不答应！"
 },
 {
  "id": "014003",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0303}「若！\nわしの めん玉の\nくろい內は‥\n---\n帝国からも、ルディアからも\nこの里を 守るから\n安心なされよ！",
  "tgt": "{立绘0303}「少爷！\n我这眼珠\n里的黑瞳‥\n---\n无论帝国还是鲁迪亚\n都会守护这山寨\n放心吧！"
 },
 {
  "id": "014004",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0404}「ふむ‥？\n---\n遺跡を通って ウインディアへ\n行くのか‥？\n---\n遺跡は、黄金平野の\n東のはしじゃ‥",
  "tgt": "{立绘0404}「唔‥？\n---\n要穿过遗迹\n去温迪亚吗‥？\n---\n遗迹在黄金平原的\n东端呀‥"
 },
 {
  "id": "014005",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0404}「ふむ‥？\n---\n遺跡を通って ウインディアへ\n行くのか‥？\n---\n遺跡は、黄金平野の\n東のはしじゃ‥",
  "tgt": "{立绘0404}「唔‥？\n---\n要穿过遗迹\n去温迪亚吗‥？\n---\n遗迹在黄金平原的\n东端呀‥"
 },
 {
  "id": "014006",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0202}「むう‥、神‥\nアルカイの竜‥？\n---\nそれは、もう ワシらが\n手助けできるような\n話では、ないのぉ‥",
  "tgt": "{立绘0202}「唔～，神‥\n阿尔凯之龙‥？\n---\n那已经不是\n我们能帮上忙的\n事情了呀‥"
 },
 {
  "id": "014007",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0202}「むう‥、神‥\nアルカイの竜‥？\n---\nそれは、もう ワシらが\n手助けできるような\n話では、ないのぉ‥",
  "tgt": "{立绘0202}「唔～，神‥\n阿尔凯之龙‥？\n---\n那已经不是\n我们能帮上忙的\n事情了呀‥"
 },
 {
  "id": "014008",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0303}「竜‥‥？\n---\nふむ‥、{码0B}黄金平野には\n草竜様が おるが‥",
  "tgt": "{立绘0303}「龙‥‥？\n---\n唔‥，黄金平原\n有草龙大人‥{码0B}黄金平野には\n草竜様が おるが‥"
 },
 {
  "id": "014009",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0303}「竜‥‥？\n---\nふむ‥、{码0B}黄金平野には\n草竜様が おるが‥",
  "tgt": "{立绘0303}「龙‥‥？\n---\n唔‥，黄金平原\n有草龙大人‥{码0B}黄金平野には\n草竜様が おるが‥"
 },
 {
  "id": "014010",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0404}「二人の神？\nアルカイの竜？\n---\nよく分からんが‥\nとにかく 強いと\nいう事じゃな？",
  "tgt": "{立绘0404}「两位神明？\n阿尔凯之龙？\n---\n搞不太懂‥\n总之就是很强\n对吧？"
 },
 {
  "id": "014011",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0404}「二人の神？\nアルカイの竜？\n---\nよく分からんが‥\nとにかく 強いと\nいう事じゃな？",
  "tgt": "{立绘0404}「两位神明？\n阿尔凯之龙？\n---\n搞不太懂‥\n总之就是很强\n对吧？"
 },
 {
  "id": "014012",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「{队员02}さま‥今度は\nウインディアの方に\nお出かけに なったとか\n---\nおいそがしい 人だねぇ‥",
  "tgt": "「{队员02}大人这回\n又去了温迪亚\n那边呀\n---\n真是个大忙人呢‥"
 },
 {
  "id": "014013",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「人を 一人探すのに‥\nどうして みんな\nジャマするの？",
  "tgt": "「不过是找一个人‥\n为什么大家\n都要妨碍呀？"
 },
 {
  "id": "014014",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「{队员02}さま達を\n追いかけて、帝国も\n来てるそうだねぇ‥\n---\nエラい事に\nなっちまったねぇ‥",
  "tgt": "「听说帝国也\n追着{队员02}大人\n他们来了‥\n---\n事情变得\n严重了呢‥"
 },
 {
  "id": "014015",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「ここにいた商人‥？\n---\nこの家が 自分の店だ\nなんて、言いだすから\nたたき出して やったよ！\n---\nそれはそうと‥\n休んでお行き、旅の人{码14860C93}ひと休みしよう\n記錄だけしよう\n今はやめておこう",
  "tgt": "「之前在的商人‥？\n---\n竟说这房子\n是他自己的店\n被我轰出去了！\n---\n话说回来‥\n住一晚再走吧，旅行的人休息一下\n只做记录\n现在算了{码14860C93}ひと休みしよう\n記錄だけしよう\n今はやめておこう"
 },
 {
  "id": "014016",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「おれのシッポ\n---\nふまないで くれよ‥",
  "tgt": "「我的尾巴\n---\n别踩哟‥"
 },
 {
  "id": "014017",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「セネスタからの\n長旅で、つかれちゃった\n{特效}{/特效}{码08}ふわわわぁ‥{码0E}",
  "tgt": "「从塞内斯塔过来\n一路辛苦，累坏了\n呼哇哇哇‥{特效}{/特效}{码08}ふわわわぁ‥{码0E}"
 },
 {
  "id": "014018",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0101}「ん‥？\nなんで、こんなトコに\nおるってか？\n---\n{金钱00}ま、世界セーフクも\n楽やない ちゅうことや！{码14840C94}じゃ、買い物してあげよう\nふーん、何か売ってやるか\nなら、武器の下取りでも‥\n世界セーフクに協力しない",
  "tgt": "{立绘0101}「嗯……？\n你是问我\n怎么在这种地方？\n---\n{金钱00}嘛，就是说\n称霸世界\n也不轻松呀！{码14840C94}那，让你买点东西\n哼——，卖你点什么吧\n那就，武器折价回收……\n不协助称霸世界"
 },
 {
  "id": "014019",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}「あー、いそがしい！\n---\nカンちゃん、今ごろ\nどこで 何やってんだろ‥？",
  "tgt": "{立绘0000}「啊——好忙！\n---\n小坎现在\n在哪儿干嘛呢……？"
 },
 {
  "id": "014020",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}ウナ\n「あなた達が\nイジめたから‥\n---\nカンちゃん 逃げちゃった‥\n---\nどうしてくれるのよ！？{码14820C92}すいません‥\nそんなの、知りません",
  "tgt": "{立绘0000}乌娜\n「你们\n欺负了他……\n---\n小坎\n才跑掉的……\n---\n你们打算怎么办！？{码14820C92}对不起……\n那种事我们不知道"
 },
 {
  "id": "014021",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}‥{码0B}‥{码0B}‥\n---\nじゃ、代わりに\nあんた達を きたえても\nいいって事ね‥\n---\nよし！ じゃ、この‥\n{色04}全力{/色}を おぼえて\nいきなさいよ‥！\n---\nよく外れるけど‥\n当たったら スゴイんだから！\n---\n‥誰がおぼえる？",
  "tgt": "{立绘0000}……{码0B}……{码0B}……\n---\n那就换成\n把你们调教\n一番也行是吧……\n---\n好！那，这招……\n给我把{色04}全力{/色}\n记住咯……！\n---\n虽然经常落空……\n但打中了可是很痛的！\n---\n……谁要学？"
 },
 {
  "id": "014022",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}戦いの中で\n自分を 高めるの‥\n---\nコンボによるダメージで\n{色02}{占位00}{/色}以上を出したら\nまた、おいでよ。",
  "tgt": "{立绘0000}在战斗中\n提升自己……\n---\n连击伤害要是\n超过{色02}{占位00}{/色}\n就再来找我。"
 },
 {
  "id": "014023",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}‥{码0B}‥{码0B}‥\n---\nでもねー‥‥\n---\n{色02}コンボ{/色}で、{色02}1000{/色}ダメージも\n出せない連中に\nやられたんじゃ‥\n---\nカンちゃんも\nうかばれないね‥",
  "tgt": "{立绘0000}……{码0B}……{码0B}……\n---\n不过呢——……\n---\n被{色02}连击{/色}打出\n{色02}1000{/色}伤害的家伙\n打倒了的话……\n---\n小坎\n也没法成佛呢……"
 },
 {
  "id": "014024",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}‥{码0B}‥{码0B}‥ばいばい。",
  "tgt": "{立绘0000}……{码0B}……{码0B}……拜拜。"
 },
 {
  "id": "014025",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}ウナ\n「‥あ、どう？\n---\n戦ってる？",
  "tgt": "{立绘0000}……啊，怎么样？\n---\n在战斗吗？"
 },
 {
  "id": "014026",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}ふーん‥、どうやら\nけっこう コンボを\n決めてるみたいね‥\n---\nよーし、{码0B}いいわ‥\nこの、{色03}{占位01}{/色}を\n教えてあげる！",
  "tgt": "{立绘0000}哦——，看样子\n你们挺会\n打连击的嘛……\n---\n好——，{码0B}行……\n这招{色03}{占位01}{/色}\n教给你！"
 },
 {
  "id": "014027",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}コンボの 道は\n深いのよ‥\n---\n次は、コンボで‥\n{色02}{占位00}{/色}ダメージ以上を\n出してみてよ。\n---\nそうしたら、次の\nスキルを 教えてあげるよ。",
  "tgt": "{立绘0000}连击之道\n深着呢……\n---\n下次用连击\n打出超过\n{色02}{占位00}{/色}的伤害试试。\n---\n到时再教你\n下一个技能。"
 },
 {
  "id": "014028",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}‥{码0B}‥{码0B}‥\nスゴイわね、あなた達‥\n---\nカンちゃんじゃ こうは\nいかなかった かもね‥\n---\nもう、あたしが\n教えることは ないわ。",
  "tgt": "{立绘0000}……{码0B}……{码0B}……\n你们真厉害……\n---\n换成小坎\n恐怕就不行了吧……\n---\n我\n已经没什么可教的了。"
 },
 {
  "id": "014029",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}ところで 何か用？{码14820C93}弟子になります！\nもう、やめます‥\n何でもないです",
  "tgt": "{立绘0000}话说，有事吗？{码14820C93}我要当弟子！\n不学了……\n没什么事"
 },
 {
  "id": "014030",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}他に、何かある？{码14820C93}弟子になります！\nもう、やめます‥\n何でもないです",
  "tgt": "{立绘0000}还有别的事吗？{码14820C93}我要当弟子！\n不学了……\n没什么事"
 },
 {
  "id": "014031",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}あら‥‥\n---\nみんな あたしの\n弟子じゃない！？",
  "tgt": "{立绘0000}哎呀……\n---\n怎么全是\n我的弟子！？"
 },
 {
  "id": "014032",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}じゃ、{占位02}に\n{色04}全力{/色}を 教えるね。\n---\n実戦を つみ重ねて\nあなただけの コンボを\n決めてね！",
  "tgt": "{立绘0000}那就教{占位02}\n{色04}全力{/色}吧。\n---\n在实战中不断磨练\n打出属于你自己的\n连击哟！"
 },
 {
  "id": "014033",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}じゃ、あなたたちに\n{色04}全力{/色}を 教えるね。\n---\n実戦を つみ重ねて\nすごいコンボを 決めてね！",
  "tgt": "{立绘0000}那就教你们\n{色04}全力{/色}吧。\n---\n在实战中不断磨练\n打出厉害的连击哟！"
 },
 {
  "id": "014034",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}誰も あたしに\n学ばないのか‥\n---\n何だか、ちょっと\nがっかりね‥‥",
  "tgt": "{立绘0000}没人\n愿意跟我学吗……\n---\n总觉得\n有点失望…………"
 },
 {
  "id": "014035",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}あら‥‥\n---\nあたしが めんどうみてる人は\n誰も いないじゃない！\n---\nからかわないでよね！",
  "tgt": "{立绘0000}哎呀……\n---\n我照看的人\n一个都没有嘛！\n---\n别耍我哟！"
 },
 {
  "id": "014036",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}そうか、残念ね‥\n---\nカンちゃんに つづいて\n{占位02}も‥\nいなくなっちゃうのか‥",
  "tgt": "{立绘0000}这样啊，真遗憾……\n---\n继小坎之后\n{占位02}\n也要走了吗……"
 },
 {
  "id": "014037",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}そうか‥‥\n---\nカンちゃんに つづいて\nあなたたちも‥\n---\nいなくなるのは\n少し、残念ね‥",
  "tgt": "{立绘0000}这样啊……\n---\n继小坎之后\n你们也要……\n---\n走的话\n还真有点遗憾呢……"
 },
 {
  "id": "014038",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}ふー‥‥\n---\nやめるとか、やめないとか\nはっきりしないね‥！\n---\nカンちゃんは、もっと\nはっきり してたよ！",
  "tgt": "{立绘0000}呼………\n---\n学还是不学\n倒是给个准话呀……！\n---\n小坎都比你\n果断多了！"
 },
 {
  "id": "014039",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}基本は、戦い！\n---\nコンボのダメージで\n{色02}{占位00}{/色}以上を出したら\nまた、おいで！",
  "tgt": "{立绘0000}基础就是战斗！\n---\n连击伤害要是\n超过{色02}{占位00}{/色}\n就再来！"
 },
 {
  "id": "014040",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0000}ウナ\n「あなた、もしかしたら‥\n---\nこの世で 一番強くない？\n---\nあたしの目に\n狂いがなければの話だけど‥",
  "tgt": "{立绘0000}乌娜\n「你该不会……\n---\n是世上最强的吧？\n---\n前提是\n我的眼光没看走眼……"
 },
 {
  "id": "014041",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "1500",
  "tgt": "1500"
 },
 {
  "id": "014042",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "3000",
  "tgt": "3000"
 },
 {
  "id": "014043",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "10000",
  "tgt": "10000"
 },
 {
  "id": "014044",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "ぶんどり",
  "tgt": "掠夺"
 },
 {
  "id": "014045",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "スーパーコンボ",
  "tgt": "超级连击"
 },
 {
  "id": "014046",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "あばれる",
  "tgt": "撒野"
 },
 {
  "id": "014047",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "{立绘0606}「また、お会いしましたね\nみなさーん！\n---\n今日も、みなさんに\n旅の お役立ち情報を\nおとどけしますねー！{码14000C95}つながる技\nコンボのヒット数\nコンボの追加効果\n変化する敵\n話を闻かない",
  "tgt": "{立绘0606}「我们又见面啦\n各位——！\n---\n今天也为大家\n送上旅途的\n实用情报哟——！{码14000C95}可连接的技能\n连击的命中数\n连击的追加效果\n会变化的敌人\n不听"
 },
 {
  "id": "014048",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「コンボで 技をつなげる時‥\n---\n火から風、風から水\n水から土、土から火‥\n---\nという感じで、技の属性に\n注意して つなげると‥\n---\nより強力な 技が\n出るんだ‥！\n---\nいろいろ、ためしてみてね！\n---\n{引2 7600}",
  "tgt": "「用连击连招时‥\n---\n火接风、风接水\n水接土、土接火‥\n---\n注意招式的属性\n这样连下去‥\n---\n就能放出\n更强的招式‥！\n---\n各种都试试吧！\n---\n{引2 7600}"
 },
 {
  "id": "014049",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「ヒット数は、とにかく‥\n---\n出現した 敵の数が\n多いほど、上がりやすいよ‥\n---\nさらに、同じ属性の\n技を つなげると‥\n---\nつながる度に ヒット数が\nひとつずつ 追加されるよ！\n---\n{引2 7600}",
  "tgt": "「命中数嘛‥\n---\n出现的敌人越多\n就越容易涨哟‥\n---\n还有，连相同的\n属性招式‥\n---\n每连一招\n命中数就会多一哟！\n---\n{引2 7600}"
 },
 {
  "id": "014050",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「回復や、ステータスを\nアップさせる技をつなぐと‥\n---\nそれぞれの 効果が\nちょっとだけ、追加されて\nつながるんだ‥！\n---\nだから、{色02}{道具2C04}{/色}と\n{色02}{道具2704}{/色}とで‥\n---\n防御力を 上げながら\n少しだけ、HPを\n回復する‥\n---\nなんてことが できるんだ‥\nちょっと、おトクだね！\n---\n{引2 7600}",
  "tgt": "「把回复技和能力\n提升技连接起来……\n---\n各自的效果\n会稍微追加\n再连接起来……！\n---\n所以用{色02}{道具2C04}{/色}接\n{色02}{道具2704}{/色}……\n---\n就能一边提升防御力\n一边稍微回复\nHP……\n---\n能做到这种事……\n很划算吧！\n---\n{引2 7600}"
 },
 {
  "id": "014051",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「{色02}ウド{/色}とか\n{色02}ファイアードレイク{/色}って\nモンスターを 知ってる？\n---\nやつらに、火の属性の\n技をかけると‥、なんと\nパワーアップ するんだ！\n---\nけれど、そうやって倒すと\nその分 たくさんのEXPが\nもらえるんだよ！\n---\nそんなモンスターは、他にも\nいるから‥\n探してみてね！\n---\n{引2 7600}",
  "tgt": "「{色02}乌多{/色}\n{色02}火蜥龙{/色}\n这类魔物知道吗？\n---\n对它们使用\n火属性技能的话……它们\n竟然会力量提升！\n---\n不过用这办法打倒\n就能获得相应\n大量的EXP哟！\n---\n那样的魔物还有\n其他……\n找找看吧！\n---\n{引2 7600}"
 },
 {
  "id": "014052",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「あら、そう‥\nじゃあーねー！",
  "tgt": "「哎呀，这样呀‥\n那就拜拜！"
 },
 {
  "id": "014053",
  "file": "WORLD/AREAS015.EMI",
  "seg": 11,
  "src": "「他に、何か闻きたい？{码14000C95}つながる技\nコンボのヒット数\nコンボの追加効果\n変化する敵\n話を闻かない",
  "tgt": "「还想听什么？{码14000C95}可连接的技能\n连击的命中数\n连击的追加效果\n会变化的敌人\n不听"
 },
 {
  "id": "014054",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}ふーれんしつない",
  "tgt": "{立绘0000}福莲室内"
 },
 {
  "id": "014055",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「族長さま‥\n何か、事件に\nまきこまれてるってねぇ‥",
  "tgt": "「族长大人‥\n听说被卷进了\n什么事件呀‥"
 },
 {
  "id": "014056",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「{队员02}さま\n敵国で、捕まったって\n話しだねぇ‥\n---\nこりゃ、また\n戦になるねぇ‥",
  "tgt": "「{队员02}大人\n在敌国被捕了\n听说了呀‥\n---\n这下又要\n打仗了呢‥"
 },
 {
  "id": "014057",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「{队员02}さまは‥\n---\n行方不明になった\nウインディアの王女様を\n探しに行かれたのよ‥\n---\n何か、ロマンチック‥！",
  "tgt": "「{队员02}大人‥\n---\n是去找失踪的\n温迪亚王女大人\n才出的事哟‥\n---\n总觉得好浪漫‥！"
 },
 {
  "id": "014058",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「001Aにへんこうです。",
  "tgt": "「已切换为001A。"
 },
 {
  "id": "014059",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0101}「ん‥？\nわいの仲間、どこにでも\nおるってか？\n---\n{金钱00}わいらの一族は\n商売による、世界セーフクを\n狙っとるからな！{码14840C94}じゃ、買い物してあげよう\nふーん、何か売ってやるか\nなら、武器の下取りでも‥\n世界セーフクに協力しない",
  "tgt": "{立绘0101}「嗯……？\n你是说我的同伙\n哪儿都有？\n---\n{金钱00}我们这一族\n正瞄准靠生意\n称霸世界呢！{码14840C94}那，让你买点东西\n哼——，卖你点什么吧\n那就，武器折价回收……\n不协助称霸世界"
 },
 {
  "id": "014060",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「フーレンの一族は\nすごく強いので 有名だから‥\n---\n弟子になろうと、旅してくる\n人もいるんだって。",
  "tgt": "「弗雷恩一族\n以强大出名‥\n---\n所以也有人为了拜师\n远道而来呢。"
 },
 {
  "id": "014061",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}「カンちゃん、見なかった？\nあたしの弟子‥",
  "tgt": "{立绘0000}「看见小坎了吗？\n我的弟子……"
 },
 {
  "id": "014062",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘8242}「ふーむ‥\n{队员02}が そんな事に‥",
  "tgt": "{立绘8242}「嗯～‥\n{队员02}竟出了这种事‥"
 },
 {
  "id": "014063",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘8343}「ルディアめ‥\nフーレンを あまく見おって！\n---\nこうなれば、もう\n戦爭じゃ！",
  "tgt": "{立绘8343}「鲁迪亚那厮‥\n竟小看弗雷恩！\n---\n事已至此\n只能开战了！"
 },
 {
  "id": "014064",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘8444}「そうじゃ！",
  "tgt": "{立绘8444}「正是！"
 },
 {
  "id": "014065",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘8242}「まて、まて‥\nうかつな事を 言うでない\n---\nそうでなくても、フーレンは\n皆、血の気が\n多いんじゃから‥",
  "tgt": "{立绘8242}「等等，等等‥\n别口出轻率之言\n---\n弗雷恩人本就\n个个血气\n旺盛‥"
 },
 {
  "id": "014066",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘8444}「そうじゃ！",
  "tgt": "{立绘8444}「正是！"
 },
 {
  "id": "014067",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘8343}「ふん‥、じゃあ\nどうすると言うんじゃ‥\n---\nわざわざ、{队员01}さんが\n若の身を案じて\n報せてくれたのに‥",
  "tgt": "{立绘8343}「哼‥，那你说\n怎么办‥\n---\n{队员01}先生特意\n为少爷的安危\n来报信呀‥"
 },
 {
  "id": "014068",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘8444}「そうじゃ！\nそれにしても‥\n---\n{队员01}ちゃん\n大きくなったのぉ‥！\n---\n前に見たときは\nこぉーんな、チビで‥",
  "tgt": "{立绘8444}「正是！\n话说回来‥\n---\n{队员01}丫头\n都长这么大了呀‥！\n---\n上次见的时候\n还是这么小的小不点‥"
 },
 {
  "id": "014069",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘8242}「い、いや‥\nそれは さておき‥\n---\nどうしたもんじゃ‥",
  "tgt": "{立绘8242}「不，不‥\n先不说这个‥\n---\n这事怎么办呀‥"
 },
 {
  "id": "014070",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘8343}「うむぅ‥、こんなときに\n{色02}ターボさま{/色}が\nいらっしゃれば、のぉ‥",
  "tgt": "{立绘8343}「唔嗯……这种时候\n要是{色02}塔博大人{/色}\n还在就好了……"
 },
 {
  "id": "014071",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘4100}「ターボさま‥、って？",
  "tgt": "{立绘4100}「塔博大人……是指？"
 },
 {
  "id": "014072",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘8444}「なくなった、前の族長の\nおくさま‥\n---\n{队员02}の、母上じゃ。",
  "tgt": "{立绘8444}「是已故的前任族长\n夫人‥\n---\n{队员02}的母亲呀。"
 },
 {
  "id": "014073",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘8343}「若が‥、{队员02}が\n族長になった後‥\n---\nターボさまは\n里を はなれて‥\n---\n{色02}黄金平野{/色}に\n移り住まれたんじゃ。",
  "tgt": "{立绘8343}「自从{队员02}\n当上族长之后……\n---\n塔博大人\n就离开了村子……\n---\n移居到了\n{色02}黄金平原{/色}。"
 },
 {
  "id": "014074",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘8444}「さすらいの旅じゃ。",
  "tgt": "{立绘8444}「四处游历去了。"
 },
 {
  "id": "014075",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘8242}「ターボさまなら、何か\nよい考えが‥\nあったかも しれんが‥\n---\nワシらでは‥‥",
  "tgt": "{立绘8242}「塔博大人在的话\n也许会有\n好主意‥\n---\n光靠我们‥‥"
 },
 {
  "id": "014076",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘8444}「もう少し 若ければ\nうまに乘って‥\n---\nターボ様を 探しに\n行ったんじゃが、なあ‥",
  "tgt": "{立绘8444}「要是再年轻几岁\n就骑马\n---\n去找塔博大人\n了呀，唉‥"
 },
 {
  "id": "014077",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0202}「ターボさまなら、何か\n{队员02}を 救う\nよい手を、考えるじゃろうな‥",
  "tgt": "{立绘0202}「塔博大人的话\n定会想出救{队员02}的\n好办法吧‥"
 },
 {
  "id": "014078",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0303}「ターボさまは、今ごろ\n黄金平野で\nひとり旅じゃ‥‥\n---\n黄金平野に 行くなら\n---\nうまが いるなぁ‥",
  "tgt": "{立绘0303}「塔博大人如今\n大概正在黄金平原\n独自旅行‥‥\n---\n要去黄金平原的话\n---\n得有马呀‥"
 },
 {
  "id": "014079",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0404}「わしらじゃと\nすぐに、戦のことばかり\n考えてしまうんじゃ‥",
  "tgt": "{立绘0404}「换成我们\n满脑子\n就只剩打仗了‥"
 },
 {
  "id": "014080",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「休んでお行き、旅の人{码14860C93}ひと休みしよう\n記錄だけしよう\n今はやめておこう",
  "tgt": "住一晚再走吧，旅行的人休息一下\n只做记录\n现在算了{码14860C93}ひと休みしよう\n記錄だけしよう\n今はやめておこう"
 },
 {
  "id": "014081",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「金が足らん。",
  "tgt": "「钱不够。"
 },
 {
  "id": "014082",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0404}「ふむ、なるほど\n{道具0101}のニセモノを‥\n---\nその手が あったか\nさすがはターボさまじゃ！",
  "tgt": "{立绘0404}「唔，原来如此\n{道具0101}的假货‥\n---\n竟有这种办法\n不愧是塔博大人呀！"
 },
 {
  "id": "014083",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0303}「この一件は、もう\nおぬしらに まかす他\nないわい‥\n---\nお願いしますぞ‥！",
  "tgt": "{立绘0303}「这件事\n就只能拜托\n你们了‥\n---\n拜托了呀‥！"
 },
 {
  "id": "014084",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0202}「{色02}グーの火山{/色}に\n行くにはな‥\n---\nまず、黄金平野を\nずっと{色02}東{/色}にすすみ‥\n---\n大きな岩が 見えたら\n次に、{色02}南{/色}にすすむ‥\n---\n遠くに見える けむりの\nのぼる山が{色02}グーの火山{/色}じゃ。",
  "tgt": "{立绘0202}「要去{色02}古之火山{/色}的话……\n---\n先沿着黄金平原\n一直往{色02}东{/色}走……\n---\n看见大石头后\n接着往{色02}南{/色}走……\n---\n远处冒烟的那座山\n就是{色02}古之火山{/色}。"
 },
 {
  "id": "014085",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}「カンちゃんねー\nもっと 修行するんだって\n飛び出して いっちゃった‥\n---\n別に 強くなんなくても\nいいのになー",
  "tgt": "{立绘0000}「小坎那家伙\n说要好好修行\n就跑出去了……\n---\n其实\n不变强也没关系呀——"
 },
 {
  "id": "014086",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{框02}{立绘0000}「だーめよ カンちゃん\nケンカしたりしちゃ‥\n---\nアンタ 弱いんだから。",
  "tgt": "{框02}{立绘0000}「不行哟，小坎\n不许跟人吵架……\n---\n你可是很弱的。"
 },
 {
  "id": "014087",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘8545}「ふぬー！？\n---\nし、師匠‥オレって\nよ、{码0B}弱いんですか‥？",
  "tgt": "{立绘8545}「呜奴——！？\n---\n师，师父‥我很\n弱吗‥？{码0B}弱いんですか‥？"
 },
 {
  "id": "014088",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{框02}{立绘0000}「うん、まあ‥\nちょっと‥、まあまあ‥",
  "tgt": "{框02}{立绘0000}「嗯，算……\n还算……一般吧……"
 },
 {
  "id": "014089",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{框02}{立绘0000}「まあ、ここで‥\nわたしの 手伝いを\nしてれば‥‥\n---\nそのうち それなりには\nなると思うけど、{码0B}ね。",
  "tgt": "{框02}{立绘0000}「嘛，在这儿……\n帮我打打杂的话……\n---\n我想你迟早\n也能有\n几分出息，{码0B}吧。"
 },
 {
  "id": "014090",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘4100}「そうですね‥\nターボ様に お会いすれば‥\n---\nなんとか なるかも\nしれないって 事ですか‥",
  "tgt": "{立绘4100}「也就是说……\n只要见到塔博大人……\n---\n说不定就\n有办法\n解决了吗……"
 },
 {
  "id": "014091",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0202}「ともかく、ありがとうよ‥\n---\n今後のことは、わしらも\n協力するが‥\n---\nやはり、ターボ様に\n話した方が、よかろうて‥",
  "tgt": "{立绘0202}「总之，多谢了‥\n---\n今后的事\n我们也会协助‥\n---\n但还是该跟塔博大人\n说一声呀‥"
 },
 {
  "id": "014092",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0202}「これ、{队员02}\nそんな事では、族長として‥\n---\n‥いや、{码0B}とにかく無事で\nよかったわい。\n---\nターボ様にも、きちんと\n話しておくんじゃぞ‥",
  "tgt": "{立绘0202}「喂，{队员02}\n那样可当不了族长呀‥\n---\n‥不，总之平安\n就好。\n---\n也要跟塔博大人\n好好说清楚哟‥{码0B}とにかく無事で\nよかったわい。\n---\nターボ様にも、きちんと\n話しておくんじゃぞ‥"
 },
 {
  "id": "014093",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0303}「ルディアめ‥！\n---\n連合の長だか、何だか\n知らんが‥\n---\n我らの族長を\nかどわかすとは‥！",
  "tgt": "{立绘0303}「鲁迪亚那厮‥！\n---\n什么联军首领\n管他是谁‥\n---\n竟敢拐走\n我们的族长‥！"
 },
 {
  "id": "014094",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0303}「若、{码0B}ルディアに\nリベンジするんなら‥\n---\nワシも 共にゆくぞ！",
  "tgt": "{立绘0303}「少爷，要去\n鲁迪亚报仇的话‥\n---\n我也同去！{码0B}ルディアに\nリベンジするんなら‥\n---\nワシも 共にゆくぞ！"
 },
 {
  "id": "014095",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0404}「若を、助け出したか‥\n---\nルディアの出方が\nもんだいじゃが‥\n---\nまずは、めでたいわい。",
  "tgt": "{立绘0404}「把少爷救出来了呀‥\n---\n鲁迪亚会怎么出招\n是个问题‥\n---\n但总之，可喜可贺呀。"
 },
 {
  "id": "014096",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0404}「おお、{队员02}！\n---\nよかったのぉ‥！",
  "tgt": "{立绘0404}「哦，{队员02}！\n---\n太好了呀‥！"
 },
 {
  "id": "014097",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「族長さま、無事で\nよかったよ‥\n---\n事件とやらは\n解決したのかねぇ？",
  "tgt": "「族长大人没事\n太好了‥\n---\n那个事件\n解决了吗？"
 },
 {
  "id": "014098",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「{队员02}さま、归って\nきなすったねぇ‥\n---\nこれで 戦にならずに\nすむかねぇ‥",
  "tgt": "「{队员02}大人回来\n了呀‥\n---\n这样就不会\n打起来了吧‥"
 },
 {
  "id": "014099",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「{队员02}さま‥\n---\n仲間の方が ルディアから\n助け出したんですってね\n---\n何か、ドラマチック‥！",
  "tgt": "「{队员02}大人‥\n---\n是伙伴们从鲁迪亚\n救出来的呢\n---\n总觉得好戏剧‥！"
 },
 {
  "id": "014100",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「コワイ顏した 大男を\n見かけたけど‥\n---\nあの人も 弟子入りしに\n来たのかな？",
  "tgt": "「见到了一个\n面相凶恶的大汉‥\n---\n那人也是来\n拜师的吗？"
 },
 {
  "id": "014101",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0202}「ふむ‥‥\n---\nウインディアまで\n竜に会いに‥、か。\n---\nともかく、この地に\nとどまって おるよりは\n安全かもしれん‥",
  "tgt": "{立绘0202}「唔‥‥\n---\n去温迪亚\n见龙‥，吗。\n---\n总之，总比\n留在此地\n安全吧‥"
 },
 {
  "id": "014102",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0202}「ウインディアで、竜に会い‥\n---\n{队员00}どのの事が\n何か、分かれば‥\n---\nルディアの追求を\nかわせるかも‥、と\n言う事じゃな。",
  "tgt": "{立绘0202}「在温蒂亚见过龙……\n---\n只要能弄清\n一点{队员00}大人的事……\n---\n说不定就能\n搪塞过去\n卢迪亚的追究……是这样吧。"
 },
 {
  "id": "014103",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0303}「帝国との条約で\nここも、中立地に\nされたら‥\n---\nいや、そんな事は\n許さんわい！",
  "tgt": "{立绘0303}「跟帝国的条约要是\n把这里也划成\n中立地‥\n---\n哼，那种事\n我绝不答应！"
 },
 {
  "id": "014104",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0303}「若！\nわしの めん玉の\nくろい內は‥\n---\n帝国からも、ルディアからも\nこの里を 守るから\n安心なされよ！",
  "tgt": "{立绘0303}「少爷！\n我这眼珠\n里的黑瞳‥\n---\n无论帝国还是鲁迪亚\n都会守护这山寨\n放心吧！"
 },
 {
  "id": "014105",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0404}「ふむ‥？\n---\n遺跡を通って ウインディアへ\n行くのか‥？\n---\n遺跡は、黄金平野の\n東のはしじゃ‥",
  "tgt": "{立绘0404}「唔‥？\n---\n要穿过遗迹\n去温迪亚吗‥？\n---\n遗迹在黄金平原的\n东端呀‥"
 },
 {
  "id": "014106",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0404}「ふむ‥？\n---\n遺跡を通って ウインディアへ\n行くのか‥？\n---\n遺跡は、黄金平野の\n東のはしじゃ‥",
  "tgt": "{立绘0404}「唔‥？\n---\n要穿过遗迹\n去温迪亚吗‥？\n---\n遗迹在黄金平原的\n东端呀‥"
 },
 {
  "id": "014107",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0202}「むう‥、神‥\nアルカイの竜‥？\n---\nそれは、もう ワシらが\n手助けできるような\n話では、ないのぉ‥",
  "tgt": "{立绘0202}「唔～，神‥\n阿尔凯之龙‥？\n---\n那已经不是\n我们能帮上忙的\n事情了呀‥"
 },
 {
  "id": "014108",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0202}「むう‥、神‥\nアルカイの竜‥？\n---\nそれは、もう ワシらが\n手助けできるような\n話では、ないのぉ‥",
  "tgt": "{立绘0202}「唔～，神‥\n阿尔凯之龙‥？\n---\n那已经不是\n我们能帮上忙的\n事情了呀‥"
 },
 {
  "id": "014109",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0303}「竜‥‥？\n---\nふむ‥、{码0B}黄金平野には\n草竜様が おるが‥",
  "tgt": "{立绘0303}「龙‥‥？\n---\n唔‥，黄金平原\n有草龙大人‥{码0B}黄金平野には\n草竜様が おるが‥"
 },
 {
  "id": "014110",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0303}「竜‥‥？\n---\nふむ‥、{码0B}黄金平野には\n草竜様が おるが‥",
  "tgt": "{立绘0303}「龙‥‥？\n---\n唔‥，黄金平原\n有草龙大人‥{码0B}黄金平野には\n草竜様が おるが‥"
 },
 {
  "id": "014111",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0404}「二人の神？\nアルカイの竜？\n---\nよく分からんが‥\nとにかく 強いと\nいう事じゃな？",
  "tgt": "{立绘0404}「两位神明？\n阿尔凯之龙？\n---\n搞不太懂‥\n总之就是很强\n对吧？"
 },
 {
  "id": "014112",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0404}「二人の神？\nアルカイの竜？\n---\nよく分からんが‥\nとにかく 強いと\nいう事じゃな？",
  "tgt": "{立绘0404}「两位神明？\n阿尔凯之龙？\n---\n搞不太懂‥\n总之就是很强\n对吧？"
 },
 {
  "id": "014113",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「{队员02}さま‥今度は\nウインディアの方に\nお出かけに なったとか\n---\nおいそがしい 人だねぇ‥",
  "tgt": "「{队员02}大人这回\n又去了温迪亚\n那边呀\n---\n真是个大忙人呢‥"
 },
 {
  "id": "014114",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「人を 一人探すのに‥\nどうして みんな\nジャマするの？",
  "tgt": "「不过是找一个人‥\n为什么大家\n都要妨碍呀？"
 },
 {
  "id": "014115",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「{队员02}さま達を\n追いかけて、帝国も\n来てるそうだねぇ‥\n---\nエラい事に\nなっちまったねぇ‥",
  "tgt": "「听说帝国也\n追着{队员02}大人\n他们来了‥\n---\n事情变得\n严重了呢‥"
 },
 {
  "id": "014116",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「ここにいた商人‥？\n---\nこの家が 自分の店だ\nなんて、言いだすから\nたたき出して やったよ！\n---\nそれはそうと‥\n休んでお行き、旅の人{码14860C93}ひと休みしよう\n記錄だけしよう\n今はやめておこう",
  "tgt": "「之前在的商人‥？\n---\n竟说这房子\n是他自己的店\n被我轰出去了！\n---\n话说回来‥\n住一晚再走吧，旅行的人休息一下\n只做记录\n现在算了{码14860C93}ひと休みしよう\n記錄だけしよう\n今はやめておこう"
 },
 {
  "id": "014117",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「おれのシッポ\n---\nふまないで くれよ‥",
  "tgt": "「我的尾巴\n---\n别踩哟‥"
 },
 {
  "id": "014118",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「セネスタからの\n長旅で、つかれちゃった\n{特效}{/特效}{码08}ふわわわぁ‥{码0E}",
  "tgt": "「从塞内斯塔过来\n一路辛苦，累坏了\n呼哇哇哇‥{特效}{/特效}{码08}ふわわわぁ‥{码0E}"
 },
 {
  "id": "014119",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0101}「ん‥？\nなんで、こんなトコに\nおるってか？\n---\n{金钱00}ま、世界セーフクも\n楽やない ちゅうことや！{码14840C94}じゃ、買い物してあげよう\nふーん、何か売ってやるか\nなら、武器の下取りでも‥\n世界セーフクに協力しない",
  "tgt": "{立绘0101}「嗯……？\n你是问我\n怎么在这种地方？\n---\n{金钱00}嘛，就是说\n称霸世界\n也不轻松呀！{码14840C94}那，让你买点东西\n哼——，卖你点什么吧\n那就，武器折价回收……\n不协助称霸世界"
 },
 {
  "id": "014120",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}「あー、いそがしい！\n---\nカンちゃん、今ごろ\nどこで 何やってんだろ‥？",
  "tgt": "{立绘0000}「啊——好忙！\n---\n小坎现在\n在哪儿干嘛呢……？"
 },
 {
  "id": "014121",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}ウナ\n「あなた達が\nイジめたから‥\n---\nカンちゃん 逃げちゃった‥\n---\nどうしてくれるのよ！？{码14820C92}すいません‥\nそんなの、知りません",
  "tgt": "{立绘0000}乌娜\n「你们\n欺负了他……\n---\n小坎\n才跑掉的……\n---\n你们打算怎么办！？{码14820C92}对不起……\n那种事我们不知道"
 },
 {
  "id": "014122",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}‥{码0B}‥{码0B}‥\n---\nじゃ、代わりに\nあんた達を きたえても\nいいって事ね‥\n---\nよし！ じゃ、この‥\n{色04}全力{/色}を おぼえて\nいきなさいよ‥！\n---\nよく外れるけど‥\n当たったら スゴイんだから！\n---\n‥誰がおぼえる？",
  "tgt": "{立绘0000}……{码0B}……{码0B}……\n---\n那就换成\n把你们调教\n一番也行是吧……\n---\n好！那，这招……\n给我把{色04}全力{/色}\n记住咯……！\n---\n虽然经常落空……\n但打中了可是很痛的！\n---\n……谁要学？"
 },
 {
  "id": "014123",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}戦いの中で\n自分を 高めるの‥\n---\nコンボによるダメージで\n{色02}{占位00}{/色}以上を出したら\nまた、おいでよ。",
  "tgt": "{立绘0000}在战斗中\n提升自己……\n---\n连击伤害要是\n超过{色02}{占位00}{/色}\n就再来找我。"
 },
 {
  "id": "014124",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}‥{码0B}‥{码0B}‥\n---\nでもねー‥‥\n---\n{色02}コンボ{/色}で、{色02}1000{/色}ダメージも\n出せない連中に\nやられたんじゃ‥\n---\nカンちゃんも\nうかばれないね‥",
  "tgt": "{立绘0000}……{码0B}……{码0B}……\n---\n不过呢——……\n---\n被{色02}连击{/色}打出\n{色02}1000{/色}伤害的家伙\n打倒了的话……\n---\n小坎\n也没法成佛呢……"
 },
 {
  "id": "014125",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}‥{码0B}‥{码0B}‥ばいばい。",
  "tgt": "{立绘0000}……{码0B}……{码0B}……拜拜。"
 },
 {
  "id": "014126",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}ウナ\n「‥あ、どう？\n---\n戦ってる？",
  "tgt": "{立绘0000}……啊，怎么样？\n---\n在战斗吗？"
 },
 {
  "id": "014127",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}ふーん‥、どうやら\nけっこう コンボを\n決めてるみたいね‥\n---\nよーし、{码0B}いいわ‥\nこの、{色03}{占位01}{/色}を\n教えてあげる！",
  "tgt": "{立绘0000}哦——，看样子\n你们挺会\n打连击的嘛……\n---\n好——，{码0B}行……\n这招{色03}{占位01}{/色}\n教给你！"
 },
 {
  "id": "014128",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}コンボの 道は\n深いのよ‥\n---\n次は、コンボで‥\n{色02}{占位00}{/色}ダメージ以上を\n出してみてよ。\n---\nそうしたら、次の\nスキルを 教えてあげるよ。",
  "tgt": "{立绘0000}连击之道\n深着呢……\n---\n下次用连击\n打出超过\n{色02}{占位00}{/色}的伤害试试。\n---\n到时再教你\n下一个技能。"
 },
 {
  "id": "014129",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}‥{码0B}‥{码0B}‥\nスゴイわね、あなた達‥\n---\nカンちゃんじゃ こうは\nいかなかった かもね‥\n---\nもう、あたしが\n教えることは ないわ。",
  "tgt": "{立绘0000}……{码0B}……{码0B}……\n你们真厉害……\n---\n换成小坎\n恐怕就不行了吧……\n---\n我\n已经没什么可教的了。"
 },
 {
  "id": "014130",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}ところで 何か用？{码14820C93}弟子になります！\nもう、やめます‥\n何でもないです",
  "tgt": "{立绘0000}话说，有事吗？{码14820C93}我要当弟子！\n不学了……\n没什么事"
 },
 {
  "id": "014131",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}他に、何かある？{码14820C93}弟子になります！\nもう、やめます‥\n何でもないです",
  "tgt": "{立绘0000}还有别的事吗？{码14820C93}我要当弟子！\n不学了……\n没什么事"
 },
 {
  "id": "014132",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}あら‥‥\n---\nみんな あたしの\n弟子じゃない！？",
  "tgt": "{立绘0000}哎呀……\n---\n怎么全是\n我的弟子！？"
 },
 {
  "id": "014133",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}じゃ、{占位02}に\n{色04}全力{/色}を 教えるね。\n---\n実戦を つみ重ねて\nあなただけの コンボを\n決めてね！",
  "tgt": "{立绘0000}那就教{占位02}\n{色04}全力{/色}吧。\n---\n在实战中不断磨练\n打出属于你自己的\n连击哟！"
 },
 {
  "id": "014134",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}じゃ、あなたたちに\n{色04}全力{/色}を 教えるね。\n---\n実戦を つみ重ねて\nすごいコンボを 決めてね！",
  "tgt": "{立绘0000}那就教你们\n{色04}全力{/色}吧。\n---\n在实战中不断磨练\n打出厉害的连击哟！"
 },
 {
  "id": "014135",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}誰も あたしに\n学ばないのか‥\n---\n何だか、ちょっと\nがっかりね‥‥",
  "tgt": "{立绘0000}没人\n愿意跟我学吗……\n---\n总觉得\n有点失望…………"
 },
 {
  "id": "014136",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}あら‥‥\n---\nあたしが めんどうみてる人は\n誰も いないじゃない！\n---\nからかわないでよね！",
  "tgt": "{立绘0000}哎呀……\n---\n我照看的人\n一个都没有嘛！\n---\n别耍我哟！"
 },
 {
  "id": "014137",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}そうか、残念ね‥\n---\nカンちゃんに つづいて\n{占位02}も‥\nいなくなっちゃうのか‥",
  "tgt": "{立绘0000}这样啊，真遗憾……\n---\n继小坎之后\n{占位02}\n也要走了吗……"
 },
 {
  "id": "014138",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}そうか‥‥\n---\nカンちゃんに つづいて\nあなたたちも‥\n---\nいなくなるのは\n少し、残念ね‥",
  "tgt": "{立绘0000}这样啊……\n---\n继小坎之后\n你们也要……\n---\n走的话\n还真有点遗憾呢……"
 },
 {
  "id": "014139",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}ふー‥‥\n---\nやめるとか、やめないとか\nはっきりしないね‥！\n---\nカンちゃんは、もっと\nはっきり してたよ！",
  "tgt": "{立绘0000}呼………\n---\n学还是不学\n倒是给个准话呀……！\n---\n小坎都比你\n果断多了！"
 },
 {
  "id": "014140",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}基本は、戦い！\n---\nコンボのダメージで\n{色02}{占位00}{/色}以上を出したら\nまた、おいで！",
  "tgt": "{立绘0000}基础就是战斗！\n---\n连击伤害要是\n超过{色02}{占位00}{/色}\n就再来！"
 },
 {
  "id": "014141",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0000}ウナ\n「あなた、もしかしたら‥\n---\nこの世で 一番強くない？\n---\nあたしの目に\n狂いがなければの話だけど‥",
  "tgt": "{立绘0000}乌娜\n「你该不会……\n---\n是世上最强的吧？\n---\n前提是\n我的眼光没看走眼……"
 },
 {
  "id": "014142",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "1500",
  "tgt": "1500"
 },
 {
  "id": "014143",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "3000",
  "tgt": "3000"
 },
 {
  "id": "014144",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "10000",
  "tgt": "10000"
 },
 {
  "id": "014145",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "ぶんどり",
  "tgt": "掠夺"
 },
 {
  "id": "014146",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "スーパーコンボ",
  "tgt": "超级连击"
 },
 {
  "id": "014147",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "あばれる",
  "tgt": "撒野"
 },
 {
  "id": "014148",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "{立绘0606}「また、お会いしましたね\nみなさーん！\n---\n今日も、みなさんに\n旅の お役立ち情報を\nおとどけしますねー！{码14000C95}つながる技\nコンボのヒット数\nコンボの追加効果\n変化する敵\n話を闻かない",
  "tgt": "{立绘0606}「我们又见面啦\n各位——！\n---\n今天也为大家\n送上旅途的\n实用情报哟——！{码14000C95}可连接的技能\n连击的命中数\n连击的追加效果\n会变化的敌人\n不听"
 },
 {
  "id": "014149",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「コンボで 技をつなげる時‥\n---\n火から風、風から水\n水から土、土から火‥\n---\nという感じで、技の属性に\n注意して つなげると‥\n---\nより強力な 技が\n出るんだ‥！\n---\nいろいろ、ためしてみてね！\n---\n{引2 7600}",
  "tgt": "「用连击连招时‥\n---\n火接风、风接水\n水接土、土接火‥\n---\n注意招式的属性\n这样连下去‥\n---\n就能放出\n更强的招式‥！\n---\n各种都试试吧！\n---\n{引2 7600}"
 },
 {
  "id": "014150",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「ヒット数は、とにかく‥\n---\n出現した 敵の数が\n多いほど、上がりやすいよ‥\n---\nさらに、同じ属性の\n技を つなげると‥\n---\nつながる度に ヒット数が\nひとつずつ 追加されるよ！\n---\n{引2 7600}",
  "tgt": "「命中数嘛‥\n---\n出现的敌人越多\n就越容易涨哟‥\n---\n还有，连相同的\n属性招式‥\n---\n每连一招\n命中数就会多一哟！\n---\n{引2 7600}"
 },
 {
  "id": "014151",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「回復や、ステータスを\nアップさせる技をつなぐと‥\n---\nそれぞれの 効果が\nちょっとだけ、追加されて\nつながるんだ‥！\n---\nだから、{色02}{道具2C04}{/色}と\n{色02}{道具2704}{/色}とで‥\n---\n防御力を 上げながら\n少しだけ、HPを\n回復する‥\n---\nなんてことが できるんだ‥\nちょっと、おトクだね！\n---\n{引2 7600}",
  "tgt": "「把回复技和能力\n提升技连接起来……\n---\n各自的效果\n会稍微追加\n再连接起来……！\n---\n所以用{色02}{道具2C04}{/色}接\n{色02}{道具2704}{/色}……\n---\n就能一边提升防御力\n一边稍微回复\nHP……\n---\n能做到这种事……\n很划算吧！\n---\n{引2 7600}"
 },
 {
  "id": "014152",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「{色02}ウド{/色}とか\n{色02}ファイアードレイク{/色}って\nモンスターを 知ってる？\n---\nやつらに、火の属性の\n技をかけると‥、なんと\nパワーアップ するんだ！\n---\nけれど、そうやって倒すと\nその分 たくさんのEXPが\nもらえるんだよ！\n---\nそんなモンスターは、他にも\nいるから‥\n探してみてね！\n---\n{引2 7600}",
  "tgt": "「{色02}乌多{/色}\n{色02}火蜥龙{/色}\n这类魔物知道吗？\n---\n对它们使用\n火属性技能的话……它们\n竟然会力量提升！\n---\n不过用这办法打倒\n就能获得相应\n大量的EXP哟！\n---\n那样的魔物还有\n其他……\n找找看吧！\n---\n{引2 7600}"
 },
 {
  "id": "014153",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「あら、そう‥\nじゃあーねー！",
  "tgt": "「哎呀，这样呀‥\n那就拜拜！"
 },
 {
  "id": "014154",
  "file": "WORLD/AREAS016.EMI",
  "seg": 11,
  "src": "「他に、何か闻きたい？{码14000C95}つながる技\nコンボのヒット数\nコンボの追加効果\n変化する敵\n話を闻かない",
  "tgt": "「还想听什么？{码14000C95}可连接的技能\n连击的命中数\n连击的追加效果\n会变化的敌人\n不听"
 },
 {
  "id": "014155",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}うぃんでぃあのへや",
  "tgt": "{立绘0000}温蒂亚的房间"
 },
 {
  "id": "014156",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{金钱00}「こんにちは、旅の方\n{占位00}ゼニーですけど\n休んで行かれます？{码14860C93}休む\n旅の記錄だけする\n今はやめておく",
  "tgt": "{金钱00}「您好，旅人\n{占位00}泽尼\n要休息吗？{码14860C93}休息\n只记录旅程\n这次先不了"
 },
 {
  "id": "014157",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「すみませんが\nお金が、足りないようです。",
  "tgt": "「很抱歉\n钱，好像不够。"
 },
 {
  "id": "014158",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「今は、旅してるけど‥\n---\n{金钱00}そのうち、店を持つんだ。\nりっぱな 武器屋さ！{码14840C94}装備品を買う\n持ち物を売る\n装備品の下取り\n今は用がない",
  "tgt": "「现在还在旅行……\n---\n{金钱00}迟早要开自己的店。\n成为像样的武器商人！{码14840C94}购买装备\n卖掉身上的东西\n装备折价回收\n这次没事"
 },
 {
  "id": "014159",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「いなくなった、エリーナ様を\n探して‥\n---\n{队员01}様まで\n出ていっちまったって\n話しだねぇ‥\n---\n王様も、さぞや\nご心配だろうねぇ‥",
  "tgt": "「为了寻找失踪的\n艾莉娜大人‥\n---\n连{队员01}大人\n都亲自出马了\n听说了吗‥\n---\n国王也一定\n非常担心吧‥"
 },
 {
  "id": "014160",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「ボクも‥\nおねいちんが、いなくなったら\n探しに行くー。",
  "tgt": "「我也要‥\n姐姐不见了的话\n就去找——。"
 },
 {
  "id": "014161",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「ばかね‥\nわたしは、いなくならないの。",
  "tgt": "「笨蛋‥\n我才不会不见呢。"
 },
 {
  "id": "014162",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「ここは、へいわだね‥\nけど、かすかに におうね\n---\n戦のにおいが‥",
  "tgt": "「这里很和平呢‥\n不过呢，隐约闻得到\n---\n战争的气味‥"
 },
 {
  "id": "014163",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「ウインディアの女性は\nきれいだね‥\n---\nウチのかみさんも\nそりゃ、かわいかったよ‥",
  "tgt": "「温迪亚的女性\n真漂亮呀‥\n---\n我家那位\n当年也是可爱得很哟‥"
 },
 {
  "id": "014164",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0101}{码0A}",
  "tgt": "{立绘0101}{码0A}"
 },
 {
  "id": "014165",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「デブぼっちゃんが\nこれ以上 太らないように‥\n---\n食器を ぜんぶ\nかくしちゃいました‥！",
  "tgt": "「为了不让胖少爷\n继续胖下去‥\n---\n把餐具全都\n藏起来了‥！"
 },
 {
  "id": "014166",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{码0A}\n「ちう",
  "tgt": "{码0A}\n「啾"
 },
 {
  "id": "014167",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「ふあはぁ〜〜\nはやぐ、食ぁべたいよぉう‥！",
  "tgt": "「呼啊哈——～\n好想吃东西呀——‥！"
 },
 {
  "id": "014168",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「うう、おいたわしや\nおぼっちゃま‥\n---\n食器が見つかるまでの\nごしんぼうです‥！",
  "tgt": "「呜呜，少爷真是\n可怜呀‥\n---\n在找到餐具之前\n就忍忍吧‥！"
 },
 {
  "id": "014169",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「{道具1701}も、{道具4F03}も\n{道具4501}も、{道具3603}も\n{道具4D00}も‥\n---\nみーんな、無くなって\nしまったデスよ。",
  "tgt": "「{道具1701}也好，{道具4F03}也好\n{道具4501}也好，{道具3603}也好\n{道具4D00}也好……\n---\n全都\n没有了哟。"
 },
 {
  "id": "014170",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "おちゃづけだ‥\n{道具1701}が あれば\n食べられるだろう‥",
  "tgt": "茶泡饭呀‥\n有{道具1701}的话\n就能吃了吧‥"
 },
 {
  "id": "014171",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "たこやきだ‥\n{道具3603}が あれば\n食べられるだろう‥",
  "tgt": "章鱼烧呀‥\n有{道具3603}的话\n就能吃了吧‥"
 },
 {
  "id": "014172",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "スパゲッティだ‥\n{道具4501}が あれば\n食べられるだろう‥",
  "tgt": "意大利面呀‥\n有{道具4501}的话\n就能吃了吧‥"
 },
 {
  "id": "014173",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "プリンだ‥\n{道具4F03}が あれば\n食べられるだろう‥",
  "tgt": "布丁呀‥\n有{道具4F03}的话\n就能吃了吧‥"
 },
 {
  "id": "014174",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "クリームソーダだ‥\n{道具4D00}が あれば\nのめるだろう‥",
  "tgt": "是奶油苏打啊……\n要是有{道具4D00}\n就能喝了吧……"
 },
 {
  "id": "014175",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「ウチの子は、キビシく\nしつけて おるから\nマナーが、良いんじゃ‥\n---\n決して、手づかみで\n食事をしたり、せんぞ。",
  "tgt": "「我家孩子管教得\n很严，所以\n礼仪很好哟‥\n---\n绝不会用手\n抓着吃饭的。"
 },
 {
  "id": "014176",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「{队员01}様、お戻りに\nなったってねぇ‥\n---\n王様も、さぞかし およろこびに\nなったろうねぇ‥",
  "tgt": "「听说{队员01}大人\n回来了呢‥\n---\n国王也一定\n非常高兴吧‥"
 },
 {
  "id": "014177",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「ボクも‥\nおねいちんが、もどってきたら\nおよろこぶー。",
  "tgt": "「我也要‥\n姐姐回来的话\n就开心——。"
 },
 {
  "id": "014178",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「ばかね‥\nわたしは、いなくなって\nないでしょ。",
  "tgt": "「笨蛋‥\n我才没有\n不见呢。"
 },
 {
  "id": "014179",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「この近くで、ルディア兵\nらしき姿を見たよ\nいよいよ、におってきたね‥\n---\n戦のにおいだ‥",
  "tgt": "「在这附近见到了\n像是鲁迪亚兵的身影\n越来越有味道了‥\n---\n战争的气味‥"
 },
 {
  "id": "014180",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「におったのになぁ\nヘンだなぁ‥",
  "tgt": "「明明闻到了呀\n真奇怪呀‥"
 },
 {
  "id": "014181",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「{队员01}様、また\nエリーナ様を さがしに\n出て行ったらしいねぇ‥\n---\n今度こそ\n見つかるといいねぇ‥",
  "tgt": "「听说{队员01}大人\n又去找\n艾莉娜大人了‥\n---\n但愿这回\n能找到呀‥"
 },
 {
  "id": "014182",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「ボクも‥\nまた、おねいちんを\n探しに行くー",
  "tgt": "「我也要‥\n再去找\n姐姐——"
 },
 {
  "id": "014183",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「だから‥\nわたしは いなくならないって。",
  "tgt": "「所以啦‥\n我才不会不见呢。"
 },
 {
  "id": "014184",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「あーあ‥せっかく\n食器を かくしたのに‥！",
  "tgt": "「唉——‥好不容易\n藏好的餐具呀‥！"
 },
 {
  "id": "014185",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「おお、あなたがお持ちの\nそれは まさしく‥\n---\n{引2 2000}",
  "tgt": "「哦，你手里拿的\n那件正是‥‥\n---\n{引2 2000}"
 },
 {
  "id": "014186",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "そうですか、ではその‥\n---\n",
  "tgt": "是这样呀，那这件‥\n---\n"
 },
 {
  "id": "014187",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{色03}{占位00}{/色}‥！\n---\nそれを‥{色03}{占位01}{/色}\n{占位02}まいと、こうかんしては\nいただけないでしょうか？{码14000CC2}はい\nいいえ",
  "tgt": "{色03}{占位00}{/色}……！\n---\n能不能用{色03}{占位01}{/色}\n{占位02}个\n和您交换呢？{码14000CC2}是\n否"
 },
 {
  "id": "014188",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "そうですか、また食器を\n見つけた時はぜひ‥",
  "tgt": "是这样呀，再找到\n餐具时务必‥"
 },
 {
  "id": "014189",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "おお、ありがたい‥！\n---\nこれでおぼっちゃまに\nお食事を めしあがって\nいだだけます。",
  "tgt": "哦，太感谢了‥！\n---\n这样就能让\n少爷用上餐具\n用餐了。"
 },
 {
  "id": "014190",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{色03}{占位01}{/色}を\n{占位02}まい 手に入れた！",
  "tgt": "{色03}{占位01}{/色}得到了{占位02}\n"
 },
 {
  "id": "014191",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「ふあはぁ〜〜\nもっど、食ぁべたいよぉう‥！",
  "tgt": "「呼啊哈——～\n还、还想吃呀——‥！"
 },
 {
  "id": "014192",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「もう、ざいりょうが\nぜーんぶ なくなって\nしまったデスよ‥",
  "tgt": "「材料已经\n全——都\n用光了呀‥"
 },
 {
  "id": "014193",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「うう、おいたわしや\nおぼっちゃま‥\n---\n次のお食事が できるまでの\nごしんぼうです‥！",
  "tgt": "「呜呜，少爷真是\n可怜呀‥\n---\n在下次用餐之前\n就忍忍吧‥！"
 },
 {
  "id": "014194",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "ううむ、それは残念‥",
  "tgt": "唔嗯，那真遗憾‥"
 },
 {
  "id": "014195",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「あら、あなたも\nうらないに来たの？{码14010C00}はい\nいいえ",
  "tgt": "「哎呀，你也是\n来占卜的吗？{码14010C00}是\n否"
 },
 {
  "id": "014196",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「じゃあ教えてあげる、あのね\nここから 外に出た時に‥\n---\n風車の {色02}あかいハネ{/色}が\n二人の頭の上で 止まると‥\n---\nその二人は、必ず結ばれるって\n伝說があるのよー\nロマンチックでしょ？{码14020C00}はい\nいいえ",
  "tgt": "「那就告诉你吧\n从这里出去的时候……\n---\n要是风车的{色02}红翅膀{/色}\n正好停在两人头顶上……\n---\n传说这两人\n就一定会结成连理哟\n很浪漫吧？{码14020C00}是\n否"
 },
 {
  "id": "014197",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「あ、そ‥",
  "tgt": "「哦，是吗‥"
 },
 {
  "id": "014198",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「アナタ達も\nうらなってみてねー。",
  "tgt": "「你们也来\n占个卜嘛——。"
 },
 {
  "id": "014199",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「運命の人が\n見つかるといいねー。",
  "tgt": "「能找到命中注定的\n人就太好啦——。"
 },
 {
  "id": "014200",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "『ハウ トウ ユーズ ツマヨウジ』\n{码0B}{码0B}と、書かれた本がある。",
  "tgt": "有一本书，写着\n『如何使用牙签』。{码0B}{码0B}と、書かれた本がある。"
 },
 {
  "id": "014201",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "『食事からはじめる 子供のしつけ』\n{码0B}{码0B}‥本のタイトルだ。",
  "tgt": "『从吃饭开始的孩子管教』\n‥是书名。{码0B}{码0B}‥本のタイトルだ。"
 },
 {
  "id": "014202",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "本がある、タイトルは\n{码0B}{码0B}『ダイエットハード·3』‥",
  "tgt": "有一本书，书名是\n『减肥硬汉·3』‥{码0B}{码0B}『ダイエットハード·3』‥"
 },
 {
  "id": "014203",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「えっ、ウチのかみさん？\n---\nまた外で 立ち話でも\nしてるんじゃ ないかなあ？",
  "tgt": "「诶，我家那位？\n---\n是不是又在外面\n站着聊天呢呀？"
 },
 {
  "id": "014204",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「{队员01}様も\nエリーナ様も‥\n---\n早く お城に戻って\n王様を、安心させて\nあげて欲しいねぇ‥",
  "tgt": "「{队员01}大人和\n艾莉娜大人‥\n---\n真希望他们快点\n回到王城\n让国王安心呀‥"
 },
 {
  "id": "014205",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0202}「くーっ、他の商人に\n先こされてもうた‥",
  "tgt": "{立绘0202}「哼——，被别的商人\n抢先一步啦‥"
 },
 {
  "id": "014206",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "「うちの おとうと\n見ませんでした‥？\n---\nわたしが おつかいに\n行ってる間に\nいなく なっちゃって‥",
  "tgt": "「见到我弟弟\n了吗？\n---\n我去跑腿的工夫\n他就\n不见了‥"
 },
 {
  "id": "014207",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}モモ\n「ねえねえ‥\n---\nなんで、わたしって\nこんな所に いるのかなぁ‥\n---\n部屋で 実驗してて\n爆発した ところまでは\n覺えてるんだけどー‥‥\n---\n‥{码0B}‥{码0B}‥ま、いっか。\n---\nところで、あなた達‥\nわたしの 話しあいてに\nならないー？{码14820C92}なってみようかな\nやめておきます",
  "tgt": "{立绘0000}桃桃\n「呐呐……\n---\n我为什么会\n在这种地方呢……\n---\n在房间里做实验\n然后爆炸了\n我记得到这里为止……\n---\n……{码0B}……{码0B}……算了。\n---\n话说，你们……\n愿意听\n我说话吗——？{码14820C92}当你的听众吧\n不必了"
 },
 {
  "id": "014208",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}ありがとうー‥！\n---\nわたし、こう見えても\nけっこう、旅したり\nしてるからー‥\n---\n色々、役に立つ話も\nできると思うのー‥\n---\nで、{码0B}とりあえずは この\n{色04}のんびり{/色}を\n教えてあげる。\n---\nこれで少しは\nリラックスしてみてー。",
  "tgt": "{立绘0000}谢谢——！\n---\n我别看这样\n其实也去过\n不少地方——……\n---\n我想有用的闲谈\n我也能讲不少——……\n---\n那{码0B}就先教给你\n{色04}悠闲{/色}\n吧。\n---\n试着用这个\n放松放松——。"
 },
 {
  "id": "014209",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}「じゃあ、またー‥\nひまな時にでも 来てね。\n---\n他に何か 教えられる事が\nあったら‥\n---\n教えてあげるわ。",
  "tgt": "{立绘0000}「那么，再见——……\n有空再来玩啊。\n---\n要是还有\n什么能教你的……\n---\n我会教给你的。"
 },
 {
  "id": "014210",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}「あ、{码0B}そう‥\n---\nま、いっか‥\nまた遊びに来てねー。",
  "tgt": "{立绘0000}「啊，{码0B}这样……\n---\n算了……\n再来玩哟——。"
 },
 {
  "id": "014211",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}ばいばい。",
  "tgt": "{立绘0000}拜拜。"
 },
 {
  "id": "014212",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}モモ\n「あ、来てくれたのー‥\n---\nちょうど ヒマだったし\nうれしいわねー。",
  "tgt": "{立绘0000}桃桃\n「啊，你来啦——……\n---\n正好闲着呢\n真开心——。"
 },
 {
  "id": "014213",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}そういえば‥\nこんな技、知ってるー？\n---\n‥{码0B}‥{码0B}‥{码0B}って\n知ってるワケ、ないか。\n---\nじゃ、はい！\nこの、{色03}{占位01}{/色}を\n教えてあげる。",
  "tgt": "{立绘0000}说起来……\n这样的技艺，你知道吗——？\n---\n……{码0B}……{码0B}……{码0B}也\n对哦，你不可能知道。\n---\n那，给你！\n这招{色03}{占位01}{/色}\n教给你。"
 },
 {
  "id": "014214",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}ひまな時にでも、また\n会いに来てよ‥\n---\n他にも、何かあったら\n教えてあげるー。",
  "tgt": "{立绘0000}有空的时候\n再来找我玩啊……\n---\n要是还有别的什么\n我再教你——。"
 },
 {
  "id": "014215",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}どうも、あなた達に\n教えられるものは‥\n---\n全部、教えちゃったみたいー。\n---\n‥{码0B}‥{码0B}‥それなりに\n楽しかったわよー。\n---\n何か、師匠にでも\nなったみたいでー！",
  "tgt": "{立绘0000}看来能教给\n你们的东西……\n---\n好像\n全教完了——。\n---\n……{码0B}……{码0B}……还挺\n开心的哟——。\n---\n感觉就像\n当了回师父——！"
 },
 {
  "id": "014216",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}今日はどうするのー？{码14820C93}教えてください\nいいです\n何でもないです",
  "tgt": "{立绘0000}今天怎么样——？{码14820C93}请教我\n不用了\n没什么事"
 },
 {
  "id": "014217",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}ほかにはー？{码14820C93}教えてください\nいいです\n何でもないです",
  "tgt": "{立绘0000}还有别的吗——？{码14820C93}请教我\n不用了\n没什么事"
 },
 {
  "id": "014218",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}‥新しく教える人は\nいないみたいよ。",
  "tgt": "{立绘0000}……看来\n没有新的人要教哟。"
 },
 {
  "id": "014219",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}‥じゃ、{占位02}に\nこの {色04}のんびり{/色}を\n教えてあげるね。",
  "tgt": "{立绘0000}……那就教{占位02}\n这招{色04}悠闲{/色}\n吧。"
 },
 {
  "id": "014220",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}じゃ、あなたたちに\nこの {色04}のんびり{/色}を\n教えてあげるね。",
  "tgt": "{立绘0000}那就教你们\n这招{色04}悠闲{/色}\n吧。"
 },
 {
  "id": "014221",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}‥なによー？",
  "tgt": "{立绘0000}……怎么啦——？"
 },
 {
  "id": "014222",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}‥あれー？\n---\nわたし、誰かに何か\n教えてたっけ‥？",
  "tgt": "{立绘0000}……咦——？\n---\n我是不是\n教过谁\n什么东西来着……？"
 },
 {
  "id": "014223",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}‥じゃ、{占位02}は\nやめちゃうのねー。",
  "tgt": "{立绘0000}……那\n{占位02}就\n不学了吗——。"
 },
 {
  "id": "014224",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}‥じゃ あなたたち\nやめちゃうのねー。",
  "tgt": "{立绘0000}……那你们\n就不学了吗——。"
 },
 {
  "id": "014225",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}‥なによー？",
  "tgt": "{立绘0000}……怎么啦——？"
 },
 {
  "id": "014226",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}なんだか、わたしって\n場違いじゃ なーい？\n---\nどーも、違う世界に\n迷いこんだような\n気がするのよねー‥",
  "tgt": "{立绘0000}总觉得\n我是不是\n很格格不入——？\n---\n总觉得像是\n误入了\n别的世界似的——……"
 },
 {
  "id": "014227",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "{立绘0000}モモ\n「‥‥なーに？\n---\n道先を知りたいなら\nたぶんわたしの方が\nわからないわよー。",
  "tgt": "{立绘0000}桃桃\n「……什——么？\n---\n要是想问路的话\n多半我\n比你们还不认路哟——。"
 },
 {
  "id": "014228",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "25",
  "tgt": "25"
 },
 {
  "id": "014229",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "30",
  "tgt": "30"
 },
 {
  "id": "014230",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "40",
  "tgt": "40"
 },
 {
  "id": "014231",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "50",
  "tgt": "50"
 },
 {
  "id": "014232",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "スプレー",
  "tgt": "喷雾"
 },
 {
  "id": "014233",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "草むしり",
  "tgt": "拔草"
 },
 {
  "id": "014234",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "オラクル",
  "tgt": "神谕"
 },
 {
  "id": "014235",
  "file": "WORLD/AREAS017.EMI",
  "seg": 11,
  "src": "からにこもる",
  "tgt": "藏入壳中"
 },
 {
  "id": "014236",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}うぃんでぃあのへや",
  "tgt": "{立绘0000}温蒂亚的房间"
 },
 {
  "id": "014237",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{金钱00}「こんにちは、旅の方\n{占位00}ゼニーですけど\n休んで行かれます？{码14860C93}休む\n旅の記錄だけする\n今はやめておく",
  "tgt": "{金钱00}「您好，旅人\n{占位00}泽尼\n要休息吗？{码14860C93}休息\n只记录旅程\n这次先不了"
 },
 {
  "id": "014238",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「すみませんが\nお金が、足りないようです。",
  "tgt": "「很抱歉\n钱，好像不够。"
 },
 {
  "id": "014239",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「今は、旅してるけど‥\n---\n{金钱00}そのうち、店を持つんだ。\nりっぱな 武器屋さ！{码14840C94}装備品を買う\n持ち物を売る\n装備品の下取り\n今は用がない",
  "tgt": "「现在还在旅行……\n---\n{金钱00}迟早要开自己的店。\n成为像样的武器商人！{码14840C94}购买装备\n卖掉身上的东西\n装备折价回收\n这次没事"
 },
 {
  "id": "014240",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「いなくなった、エリーナ様を\n探して‥\n---\n{队员01}様まで\n出ていっちまったって\n話しだねぇ‥\n---\n王様も、さぞや\nご心配だろうねぇ‥",
  "tgt": "「为了寻找失踪的\n艾莉娜大人‥\n---\n连{队员01}大人\n都亲自出马了\n听说了吗‥\n---\n国王也一定\n非常担心吧‥"
 },
 {
  "id": "014241",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「ボクも‥\nおねいちんが、いなくなったら\n探しに行くー。",
  "tgt": "「我也要‥\n姐姐不见了的话\n就去找——。"
 },
 {
  "id": "014242",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「ばかね‥\nわたしは、いなくならないの。",
  "tgt": "「笨蛋‥\n我才不会不见呢。"
 },
 {
  "id": "014243",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「ここは、へいわだね‥\nけど、かすかに におうね\n---\n戦のにおいが‥",
  "tgt": "「这里很和平呢‥\n不过呢，隐约闻得到\n---\n战争的气味‥"
 },
 {
  "id": "014244",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「ウインディアの女性は\nきれいだね‥\n---\nウチのかみさんも\nそりゃ、かわいかったよ‥",
  "tgt": "「温迪亚的女性\n真漂亮呀‥\n---\n我家那位\n当年也是可爱得很哟‥"
 },
 {
  "id": "014245",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0101}{码0A}",
  "tgt": "{立绘0101}{码0A}"
 },
 {
  "id": "014246",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「デブぼっちゃんが\nこれ以上 太らないように‥\n---\n食器を ぜんぶ\nかくしちゃいました‥！",
  "tgt": "「为了不让胖少爷\n继续胖下去‥\n---\n把餐具全都\n藏起来了‥！"
 },
 {
  "id": "014247",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{码0A}\n「ちう",
  "tgt": "{码0A}\n「啾"
 },
 {
  "id": "014248",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「ふあはぁ〜〜\nはやぐ、食ぁべたいよぉう‥！",
  "tgt": "「呼啊哈——～\n好想吃东西呀——‥！"
 },
 {
  "id": "014249",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「うう、おいたわしや\nおぼっちゃま‥\n---\n食器が見つかるまでの\nごしんぼうです‥！",
  "tgt": "「呜呜，少爷真是\n可怜呀‥\n---\n在找到餐具之前\n就忍忍吧‥！"
 },
 {
  "id": "014250",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「{道具1701}も、{道具4F03}も\n{道具4501}も、{道具3603}も\n{道具4D00}も‥\n---\nみーんな、無くなって\nしまったデスよ。",
  "tgt": "「{道具1701}也好，{道具4F03}也好\n{道具4501}也好，{道具3603}也好\n{道具4D00}也好……\n---\n全都\n没有了哟。"
 },
 {
  "id": "014251",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "おちゃづけだ‥\n{道具1701}が あれば\n食べられるだろう‥",
  "tgt": "茶泡饭呀‥\n有{道具1701}的话\n就能吃了吧‥"
 },
 {
  "id": "014252",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "たこやきだ‥\n{道具3603}が あれば\n食べられるだろう‥",
  "tgt": "章鱼烧呀‥\n有{道具3603}的话\n就能吃了吧‥"
 },
 {
  "id": "014253",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "スパゲッティだ‥\n{道具4501}が あれば\n食べられるだろう‥",
  "tgt": "意大利面呀‥\n有{道具4501}的话\n就能吃了吧‥"
 },
 {
  "id": "014254",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "プリンだ‥\n{道具4F03}が あれば\n食べられるだろう‥",
  "tgt": "布丁呀‥\n有{道具4F03}的话\n就能吃了吧‥"
 },
 {
  "id": "014255",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "クリームソーダだ‥\n{道具4D00}が あれば\nのめるだろう‥",
  "tgt": "是奶油苏打啊……\n要是有{道具4D00}\n就能喝了吧……"
 },
 {
  "id": "014256",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「ウチの子は、キビシく\nしつけて おるから\nマナーが、良いんじゃ‥\n---\n決して、手づかみで\n食事をしたり、せんぞ。",
  "tgt": "「我家孩子管教得\n很严，所以\n礼仪很好哟‥\n---\n绝不会用手\n抓着吃饭的。"
 },
 {
  "id": "014257",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「{队员01}様、お戻りに\nなったってねぇ‥\n---\n王様も、さぞかし およろこびに\nなったろうねぇ‥",
  "tgt": "「听说{队员01}大人\n回来了呢‥\n---\n国王也一定\n非常高兴吧‥"
 },
 {
  "id": "014258",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「ボクも‥\nおねいちんが、もどってきたら\nおよろこぶー。",
  "tgt": "「我也要‥\n姐姐回来的话\n就开心——。"
 },
 {
  "id": "014259",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「ばかね‥\nわたしは、いなくなって\nないでしょ。",
  "tgt": "「笨蛋‥\n我才没有\n不见呢。"
 },
 {
  "id": "014260",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「この近くで、ルディア兵\nらしき姿を見たよ\nいよいよ、におってきたね‥\n---\n戦のにおいだ‥",
  "tgt": "「在这附近见到了\n像是鲁迪亚兵的身影\n越来越有味道了‥\n---\n战争的气味‥"
 },
 {
  "id": "014261",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「におったのになぁ\nヘンだなぁ‥",
  "tgt": "「明明闻到了呀\n真奇怪呀‥"
 },
 {
  "id": "014262",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「{队员01}様、また\nエリーナ様を さがしに\n出て行ったらしいねぇ‥\n---\n今度こそ\n見つかるといいねぇ‥",
  "tgt": "「听说{队员01}大人\n又去找\n艾莉娜大人了‥\n---\n但愿这回\n能找到呀‥"
 },
 {
  "id": "014263",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「ボクも‥\nまた、おねいちんを\n探しに行くー",
  "tgt": "「我也要‥\n再去找\n姐姐——"
 },
 {
  "id": "014264",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「だから‥\nわたしは いなくならないって。",
  "tgt": "「所以啦‥\n我才不会不见呢。"
 },
 {
  "id": "014265",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「あーあ‥せっかく\n食器を かくしたのに‥！",
  "tgt": "「唉——‥好不容易\n藏好的餐具呀‥！"
 },
 {
  "id": "014266",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「おお、あなたがお持ちの\nそれは まさしく‥\n---\n{引2 2000}",
  "tgt": "「哦，你手里拿的\n那件正是‥‥\n---\n{引2 2000}"
 },
 {
  "id": "014267",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "そうですか、ではその‥\n---\n",
  "tgt": "是这样呀，那这件‥\n---\n"
 },
 {
  "id": "014268",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{色03}{占位00}{/色}‥！\n---\nそれを‥{色03}{占位01}{/色}\n{占位02}まいと、こうかんしては\nいただけないでしょうか？{码14000CC2}はい\nいいえ",
  "tgt": "{色03}{占位00}{/色}……！\n---\n能不能用{色03}{占位01}{/色}\n{占位02}个\n和您交换呢？{码14000CC2}是\n否"
 },
 {
  "id": "014269",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "そうですか、また食器を\n見つけた時はぜひ‥",
  "tgt": "是这样呀，再找到\n餐具时务必‥"
 },
 {
  "id": "014270",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "おお、ありがたい‥！\n---\nこれでおぼっちゃまに\nお食事を めしあがって\nいだだけます。",
  "tgt": "哦，太感谢了‥！\n---\n这样就能让\n少爷用上餐具\n用餐了。"
 },
 {
  "id": "014271",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{色03}{占位01}{/色}を\n{占位02}まい 手に入れた！",
  "tgt": "{色03}{占位01}{/色}得到了{占位02}\n"
 },
 {
  "id": "014272",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「ふあはぁ〜〜\nもっど、食ぁべたいよぉう‥！",
  "tgt": "「呼啊哈——～\n还、还想吃呀——‥！"
 },
 {
  "id": "014273",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「もう、ざいりょうが\nぜーんぶ なくなって\nしまったデスよ‥",
  "tgt": "「材料已经\n全——都\n用光了呀‥"
 },
 {
  "id": "014274",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「うう、おいたわしや\nおぼっちゃま‥\n---\n次のお食事が できるまでの\nごしんぼうです‥！",
  "tgt": "「呜呜，少爷真是\n可怜呀‥\n---\n在下次用餐之前\n就忍忍吧‥！"
 },
 {
  "id": "014275",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "ううむ、それは残念‥",
  "tgt": "唔嗯，那真遗憾‥"
 },
 {
  "id": "014276",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「あら、あなたも\nうらないに来たの？{码14010C00}はい\nいいえ",
  "tgt": "「哎呀，你也是\n来占卜的吗？{码14010C00}是\n否"
 },
 {
  "id": "014277",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「じゃあ教えてあげる、あのね\nここから 外に出た時に‥\n---\n風車の {色02}あかいハネ{/色}が\n二人の頭の上で 止まると‥\n---\nその二人は、必ず結ばれるって\n伝說があるのよー\nロマンチックでしょ？{码14020C00}はい\nいいえ",
  "tgt": "「那就告诉你吧\n从这里出去的时候……\n---\n要是风车的{色02}红翅膀{/色}\n正好停在两人头顶上……\n---\n传说这两人\n就一定会结成连理哟\n很浪漫吧？{码14020C00}是\n否"
 },
 {
  "id": "014278",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「あ、そ‥",
  "tgt": "「哦，是吗‥"
 },
 {
  "id": "014279",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「アナタ達も\nうらなってみてねー。",
  "tgt": "「你们也来\n占个卜嘛——。"
 },
 {
  "id": "014280",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「運命の人が\n見つかるといいねー。",
  "tgt": "「能找到命中注定的\n人就太好啦——。"
 },
 {
  "id": "014281",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "『ハウ トウ ユーズ ツマヨウジ』\n{码0B}{码0B}と、書かれた本がある。",
  "tgt": "有一本书，写着\n『如何使用牙签』。{码0B}{码0B}と、書かれた本がある。"
 },
 {
  "id": "014282",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "『食事からはじめる 子供のしつけ』\n{码0B}{码0B}‥本のタイトルだ。",
  "tgt": "『从吃饭开始的孩子管教』\n‥是书名。{码0B}{码0B}‥本のタイトルだ。"
 },
 {
  "id": "014283",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "本がある、タイトルは\n{码0B}{码0B}『ダイエットハード·3』‥",
  "tgt": "有一本书，书名是\n『减肥硬汉·3』‥{码0B}{码0B}『ダイエットハード·3』‥"
 },
 {
  "id": "014284",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「えっ、ウチのかみさん？\n---\nまた外で 立ち話でも\nしてるんじゃ ないかなあ？",
  "tgt": "「诶，我家那位？\n---\n是不是又在外面\n站着聊天呢呀？"
 },
 {
  "id": "014285",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「{队员01}様も\nエリーナ様も‥\n---\n早く お城に戻って\n王様を、安心させて\nあげて欲しいねぇ‥",
  "tgt": "「{队员01}大人和\n艾莉娜大人‥\n---\n真希望他们快点\n回到王城\n让国王安心呀‥"
 },
 {
  "id": "014286",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0202}「くーっ、他の商人に\n先こされてもうた‥",
  "tgt": "{立绘0202}「哼——，被别的商人\n抢先一步啦‥"
 },
 {
  "id": "014287",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "「うちの おとうと\n見ませんでした‥？\n---\nわたしが おつかいに\n行ってる間に\nいなく なっちゃって‥",
  "tgt": "「见到我弟弟\n了吗？\n---\n我去跑腿的工夫\n他就\n不见了‥"
 },
 {
  "id": "014288",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}モモ\n「ねえねえ‥\n---\nなんで、わたしって\nこんな所に いるのかなぁ‥\n---\n部屋で 実驗してて\n爆発した ところまでは\n覺えてるんだけどー‥‥\n---\n‥{码0B}‥{码0B}‥ま、いっか。\n---\nところで、あなた達‥\nわたしの 話しあいてに\nならないー？{码14820C92}なってみようかな\nやめておきます",
  "tgt": "{立绘0000}桃桃\n「呐呐……\n---\n我为什么会\n在这种地方呢……\n---\n在房间里做实验\n然后爆炸了\n我记得到这里为止……\n---\n……{码0B}……{码0B}……算了。\n---\n话说，你们……\n愿意听\n我说话吗——？{码14820C92}当你的听众吧\n不必了"
 },
 {
  "id": "014289",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}ありがとうー‥！\n---\nわたし、こう見えても\nけっこう、旅したり\nしてるからー‥\n---\n色々、役に立つ話も\nできると思うのー‥\n---\nで、{码0B}とりあえずは この\n{色04}のんびり{/色}を\n教えてあげる。\n---\nこれで少しは\nリラックスしてみてー。",
  "tgt": "{立绘0000}谢谢——！\n---\n我别看这样\n其实也去过\n不少地方——……\n---\n我想有用的闲谈\n我也能讲不少——……\n---\n那{码0B}就先教给你\n{色04}悠闲{/色}\n吧。\n---\n试着用这个\n放松放松——。"
 },
 {
  "id": "014290",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}「じゃあ、またー‥\nひまな時にでも 来てね。\n---\n他に何か 教えられる事が\nあったら‥\n---\n教えてあげるわ。",
  "tgt": "{立绘0000}「那么，再见——……\n有空再来玩啊。\n---\n要是还有\n什么能教你的……\n---\n我会教给你的。"
 },
 {
  "id": "014291",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}「あ、{码0B}そう‥\n---\nま、いっか‥\nまた遊びに来てねー。",
  "tgt": "{立绘0000}「啊，{码0B}这样……\n---\n算了……\n再来玩哟——。"
 },
 {
  "id": "014292",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}ばいばい。",
  "tgt": "{立绘0000}拜拜。"
 },
 {
  "id": "014293",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}モモ\n「あ、来てくれたのー‥\n---\nちょうど ヒマだったし\nうれしいわねー。",
  "tgt": "{立绘0000}桃桃\n「啊，你来啦——……\n---\n正好闲着呢\n真开心——。"
 },
 {
  "id": "014294",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}そういえば‥\nこんな技、知ってるー？\n---\n‥{码0B}‥{码0B}‥{码0B}って\n知ってるワケ、ないか。\n---\nじゃ、はい！\nこの、{色03}{占位01}{/色}を\n教えてあげる。",
  "tgt": "{立绘0000}说起来……\n这样的技艺，你知道吗——？\n---\n……{码0B}……{码0B}……{码0B}也\n对哦，你不可能知道。\n---\n那，给你！\n这招{色03}{占位01}{/色}\n教给你。"
 },
 {
  "id": "014295",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}ひまな時にでも、また\n会いに来てよ‥\n---\n他にも、何かあったら\n教えてあげるー。",
  "tgt": "{立绘0000}有空的时候\n再来找我玩啊……\n---\n要是还有别的什么\n我再教你——。"
 },
 {
  "id": "014296",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}どうも、あなた達に\n教えられるものは‥\n---\n全部、教えちゃったみたいー。\n---\n‥{码0B}‥{码0B}‥それなりに\n楽しかったわよー。\n---\n何か、師匠にでも\nなったみたいでー！",
  "tgt": "{立绘0000}看来能教给\n你们的东西……\n---\n好像\n全教完了——。\n---\n……{码0B}……{码0B}……还挺\n开心的哟——。\n---\n感觉就像\n当了回师父——！"
 },
 {
  "id": "014297",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}今日はどうするのー？{码14820C93}教えてください\nいいです\n何でもないです",
  "tgt": "{立绘0000}今天怎么样——？{码14820C93}请教我\n不用了\n没什么事"
 },
 {
  "id": "014298",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}ほかにはー？{码14820C93}教えてください\nいいです\n何でもないです",
  "tgt": "{立绘0000}还有别的吗——？{码14820C93}请教我\n不用了\n没什么事"
 },
 {
  "id": "014299",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}‥新しく教える人は\nいないみたいよ。",
  "tgt": "{立绘0000}……看来\n没有新的人要教哟。"
 },
 {
  "id": "014300",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}‥じゃ、{占位02}に\nこの {色04}のんびり{/色}を\n教えてあげるね。",
  "tgt": "{立绘0000}……那就教{占位02}\n这招{色04}悠闲{/色}\n吧。"
 },
 {
  "id": "014301",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}じゃ、あなたたちに\nこの {色04}のんびり{/色}を\n教えてあげるね。",
  "tgt": "{立绘0000}那就教你们\n这招{色04}悠闲{/色}\n吧。"
 },
 {
  "id": "014302",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}‥なによー？",
  "tgt": "{立绘0000}……怎么啦——？"
 },
 {
  "id": "014303",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}‥あれー？\n---\nわたし、誰かに何か\n教えてたっけ‥？",
  "tgt": "{立绘0000}……咦——？\n---\n我是不是\n教过谁\n什么东西来着……？"
 },
 {
  "id": "014304",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}‥じゃ、{占位02}は\nやめちゃうのねー。",
  "tgt": "{立绘0000}……那\n{占位02}就\n不学了吗——。"
 },
 {
  "id": "014305",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}‥じゃ あなたたち\nやめちゃうのねー。",
  "tgt": "{立绘0000}……那你们\n就不学了吗——。"
 },
 {
  "id": "014306",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}‥なによー？",
  "tgt": "{立绘0000}……怎么啦——？"
 },
 {
  "id": "014307",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}なんだか、わたしって\n場違いじゃ なーい？\n---\nどーも、違う世界に\n迷いこんだような\n気がするのよねー‥",
  "tgt": "{立绘0000}总觉得\n我是不是\n很格格不入——？\n---\n总觉得像是\n误入了\n别的世界似的——……"
 },
 {
  "id": "014308",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "{立绘0000}モモ\n「‥‥なーに？\n---\n道先を知りたいなら\nたぶんわたしの方が\nわからないわよー。",
  "tgt": "{立绘0000}桃桃\n「……什——么？\n---\n要是想问路的话\n多半我\n比你们还不认路哟——。"
 },
 {
  "id": "014309",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "25",
  "tgt": "25"
 },
 {
  "id": "014310",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "30",
  "tgt": "30"
 },
 {
  "id": "014311",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "40",
  "tgt": "40"
 },
 {
  "id": "014312",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "50",
  "tgt": "50"
 },
 {
  "id": "014313",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "スプレー",
  "tgt": "喷雾"
 },
 {
  "id": "014314",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "草むしり",
  "tgt": "拔草"
 },
 {
  "id": "014315",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "オラクル",
  "tgt": "神谕"
 },
 {
  "id": "014316",
  "file": "WORLD/AREAS018.EMI",
  "seg": 11,
  "src": "からにこもる",
  "tgt": "藏入壳中"
 },
 {
  "id": "014317",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}うぃんでぃあのへや",
  "tgt": "{立绘0000}温蒂亚的房间"
 },
 {
  "id": "014318",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{金钱00}「こんにちは、旅の方\n{占位00}ゼニーですけど\n休んで行かれます？{码14860C93}休む\n旅の記錄だけする\n今はやめておく",
  "tgt": "{金钱00}「您好，旅人\n{占位00}泽尼\n要休息吗？{码14860C93}休息\n只记录旅程\n这次先不了"
 },
 {
  "id": "014319",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「すみませんが\nお金が、足りないようです。",
  "tgt": "「很抱歉\n钱，好像不够。"
 },
 {
  "id": "014320",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「今は、旅してるけど‥\n---\n{金钱00}そのうち、店を持つんだ。\nりっぱな 武器屋さ！{码14840C94}装備品を買う\n持ち物を売る\n装備品の下取り\n今は用がない",
  "tgt": "「现在还在旅行……\n---\n{金钱00}迟早要开自己的店。\n成为像样的武器商人！{码14840C94}购买装备\n卖掉身上的东西\n装备折价回收\n这次没事"
 },
 {
  "id": "014321",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「いなくなった、エリーナ様を\n探して‥\n---\n{队员01}様まで\n出ていっちまったって\n話しだねぇ‥\n---\n王様も、さぞや\nご心配だろうねぇ‥",
  "tgt": "「为了寻找失踪的\n艾莉娜大人‥\n---\n连{队员01}大人\n都亲自出马了\n听说了吗‥\n---\n国王也一定\n非常担心吧‥"
 },
 {
  "id": "014322",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「ボクも‥\nおねいちんが、いなくなったら\n探しに行くー。",
  "tgt": "「我也要‥\n姐姐不见了的话\n就去找——。"
 },
 {
  "id": "014323",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「ばかね‥\nわたしは、いなくならないの。",
  "tgt": "「笨蛋‥\n我才不会不见呢。"
 },
 {
  "id": "014324",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「ここは、へいわだね‥\nけど、かすかに におうね\n---\n戦のにおいが‥",
  "tgt": "「这里很和平呢‥\n不过呢，隐约闻得到\n---\n战争的气味‥"
 },
 {
  "id": "014325",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「ウインディアの女性は\nきれいだね‥\n---\nウチのかみさんも\nそりゃ、かわいかったよ‥",
  "tgt": "「温迪亚的女性\n真漂亮呀‥\n---\n我家那位\n当年也是可爱得很哟‥"
 },
 {
  "id": "014326",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0101}{码0A}",
  "tgt": "{立绘0101}{码0A}"
 },
 {
  "id": "014327",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「デブぼっちゃんが\nこれ以上 太らないように‥\n---\n食器を ぜんぶ\nかくしちゃいました‥！",
  "tgt": "「为了不让胖少爷\n继续胖下去‥\n---\n把餐具全都\n藏起来了‥！"
 },
 {
  "id": "014328",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{码0A}\n「ちう",
  "tgt": "{码0A}\n「啾"
 },
 {
  "id": "014329",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「ふあはぁ〜〜\nはやぐ、食ぁべたいよぉう‥！",
  "tgt": "「呼啊哈——～\n好想吃东西呀——‥！"
 },
 {
  "id": "014330",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「うう、おいたわしや\nおぼっちゃま‥\n---\n食器が見つかるまでの\nごしんぼうです‥！",
  "tgt": "「呜呜，少爷真是\n可怜呀‥\n---\n在找到餐具之前\n就忍忍吧‥！"
 },
 {
  "id": "014331",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「{道具1701}も、{道具4F03}も\n{道具4501}も、{道具3603}も\n{道具4D00}も‥\n---\nみーんな、無くなって\nしまったデスよ。",
  "tgt": "「{道具1701}也好，{道具4F03}也好\n{道具4501}也好，{道具3603}也好\n{道具4D00}也好……\n---\n全都\n没有了哟。"
 },
 {
  "id": "014332",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "おちゃづけだ‥\n{道具1701}が あれば\n食べられるだろう‥",
  "tgt": "茶泡饭呀‥\n有{道具1701}的话\n就能吃了吧‥"
 },
 {
  "id": "014333",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "たこやきだ‥\n{道具3603}が あれば\n食べられるだろう‥",
  "tgt": "章鱼烧呀‥\n有{道具3603}的话\n就能吃了吧‥"
 },
 {
  "id": "014334",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "スパゲッティだ‥\n{道具4501}が あれば\n食べられるだろう‥",
  "tgt": "意大利面呀‥\n有{道具4501}的话\n就能吃了吧‥"
 },
 {
  "id": "014335",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "プリンだ‥\n{道具4F03}が あれば\n食べられるだろう‥",
  "tgt": "布丁呀‥\n有{道具4F03}的话\n就能吃了吧‥"
 },
 {
  "id": "014336",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "クリームソーダだ‥\n{道具4D00}が あれば\nのめるだろう‥",
  "tgt": "是奶油苏打啊……\n要是有{道具4D00}\n就能喝了吧……"
 },
 {
  "id": "014337",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「ウチの子は、キビシく\nしつけて おるから\nマナーが、良いんじゃ‥\n---\n決して、手づかみで\n食事をしたり、せんぞ。",
  "tgt": "「我家孩子管教得\n很严，所以\n礼仪很好哟‥\n---\n绝不会用手\n抓着吃饭的。"
 },
 {
  "id": "014338",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「{队员01}様、お戻りに\nなったってねぇ‥\n---\n王様も、さぞかし およろこびに\nなったろうねぇ‥",
  "tgt": "「听说{队员01}大人\n回来了呢‥\n---\n国王也一定\n非常高兴吧‥"
 },
 {
  "id": "014339",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「ボクも‥\nおねいちんが、もどってきたら\nおよろこぶー。",
  "tgt": "「我也要‥\n姐姐回来的话\n就开心——。"
 },
 {
  "id": "014340",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「ばかね‥\nわたしは、いなくなって\nないでしょ。",
  "tgt": "「笨蛋‥\n我才没有\n不见呢。"
 },
 {
  "id": "014341",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「この近くで、ルディア兵\nらしき姿を見たよ\nいよいよ、におってきたね‥\n---\n戦のにおいだ‥",
  "tgt": "「在这附近见到了\n像是鲁迪亚兵的身影\n越来越有味道了‥\n---\n战争的气味‥"
 },
 {
  "id": "014342",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「におったのになぁ\nヘンだなぁ‥",
  "tgt": "「明明闻到了呀\n真奇怪呀‥"
 },
 {
  "id": "014343",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「{队员01}様、また\nエリーナ様を さがしに\n出て行ったらしいねぇ‥\n---\n今度こそ\n見つかるといいねぇ‥",
  "tgt": "「听说{队员01}大人\n又去找\n艾莉娜大人了‥\n---\n但愿这回\n能找到呀‥"
 },
 {
  "id": "014344",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「ボクも‥\nまた、おねいちんを\n探しに行くー",
  "tgt": "「我也要‥\n再去找\n姐姐——"
 },
 {
  "id": "014345",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「だから‥\nわたしは いなくならないって。",
  "tgt": "「所以啦‥\n我才不会不见呢。"
 },
 {
  "id": "014346",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「あーあ‥せっかく\n食器を かくしたのに‥！",
  "tgt": "「唉——‥好不容易\n藏好的餐具呀‥！"
 },
 {
  "id": "014347",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「おお、あなたがお持ちの\nそれは まさしく‥\n---\n{引2 2000}",
  "tgt": "「哦，你手里拿的\n那件正是‥‥\n---\n{引2 2000}"
 },
 {
  "id": "014348",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "そうですか、ではその‥\n---\n",
  "tgt": "是这样呀，那这件‥\n---\n"
 },
 {
  "id": "014349",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{色03}{占位00}{/色}‥！\n---\nそれを‥{色03}{占位01}{/色}\n{占位02}まいと、こうかんしては\nいただけないでしょうか？{码14000CC2}はい\nいいえ",
  "tgt": "{色03}{占位00}{/色}……！\n---\n能不能用{色03}{占位01}{/色}\n{占位02}个\n和您交换呢？{码14000CC2}是\n否"
 },
 {
  "id": "014350",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "そうですか、また食器を\n見つけた時はぜひ‥",
  "tgt": "是这样呀，再找到\n餐具时务必‥"
 },
 {
  "id": "014351",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "おお、ありがたい‥！\n---\nこれでおぼっちゃまに\nお食事を めしあがって\nいだだけます。",
  "tgt": "哦，太感谢了‥！\n---\n这样就能让\n少爷用上餐具\n用餐了。"
 },
 {
  "id": "014352",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{色03}{占位01}{/色}を\n{占位02}まい 手に入れた！",
  "tgt": "{色03}{占位01}{/色}得到了{占位02}\n"
 },
 {
  "id": "014353",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「ふあはぁ〜〜\nもっど、食ぁべたいよぉう‥！",
  "tgt": "「呼啊哈——～\n还、还想吃呀——‥！"
 },
 {
  "id": "014354",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「もう、ざいりょうが\nぜーんぶ なくなって\nしまったデスよ‥",
  "tgt": "「材料已经\n全——都\n用光了呀‥"
 },
 {
  "id": "014355",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「うう、おいたわしや\nおぼっちゃま‥\n---\n次のお食事が できるまでの\nごしんぼうです‥！",
  "tgt": "「呜呜，少爷真是\n可怜呀‥\n---\n在下次用餐之前\n就忍忍吧‥！"
 },
 {
  "id": "014356",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "ううむ、それは残念‥",
  "tgt": "唔嗯，那真遗憾‥"
 },
 {
  "id": "014357",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「あら、あなたも\nうらないに来たの？{码14010C00}はい\nいいえ",
  "tgt": "「哎呀，你也是\n来占卜的吗？{码14010C00}是\n否"
 },
 {
  "id": "014358",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「じゃあ教えてあげる、あのね\nここから 外に出た時に‥\n---\n風車の {色02}あかいハネ{/色}が\n二人の頭の上で 止まると‥\n---\nその二人は、必ず結ばれるって\n伝說があるのよー\nロマンチックでしょ？{码14020C00}はい\nいいえ",
  "tgt": "「那就告诉你吧\n从这里出去的时候……\n---\n要是风车的{色02}红翅膀{/色}\n正好停在两人头顶上……\n---\n传说这两人\n就一定会结成连理哟\n很浪漫吧？{码14020C00}是\n否"
 },
 {
  "id": "014359",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「あ、そ‥",
  "tgt": "「哦，是吗‥"
 },
 {
  "id": "014360",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「アナタ達も\nうらなってみてねー。",
  "tgt": "「你们也来\n占个卜嘛——。"
 },
 {
  "id": "014361",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「運命の人が\n見つかるといいねー。",
  "tgt": "「能找到命中注定的\n人就太好啦——。"
 },
 {
  "id": "014362",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "『ハウ トウ ユーズ ツマヨウジ』\n{码0B}{码0B}と、書かれた本がある。",
  "tgt": "有一本书，写着\n『如何使用牙签』。{码0B}{码0B}と、書かれた本がある。"
 },
 {
  "id": "014363",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "『食事からはじめる 子供のしつけ』\n{码0B}{码0B}‥本のタイトルだ。",
  "tgt": "『从吃饭开始的孩子管教』\n‥是书名。{码0B}{码0B}‥本のタイトルだ。"
 },
 {
  "id": "014364",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "本がある、タイトルは\n{码0B}{码0B}『ダイエットハード·3』‥",
  "tgt": "有一本书，书名是\n『减肥硬汉·3』‥{码0B}{码0B}『ダイエットハード·3』‥"
 },
 {
  "id": "014365",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「えっ、ウチのかみさん？\n---\nまた外で 立ち話でも\nしてるんじゃ ないかなあ？",
  "tgt": "「诶，我家那位？\n---\n是不是又在外面\n站着聊天呢呀？"
 },
 {
  "id": "014366",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「{队员01}様も\nエリーナ様も‥\n---\n早く お城に戻って\n王様を、安心させて\nあげて欲しいねぇ‥",
  "tgt": "「{队员01}大人和\n艾莉娜大人‥\n---\n真希望他们快点\n回到王城\n让国王安心呀‥"
 },
 {
  "id": "014367",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0202}「くーっ、他の商人に\n先こされてもうた‥",
  "tgt": "{立绘0202}「哼——，被别的商人\n抢先一步啦‥"
 },
 {
  "id": "014368",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "「うちの おとうと\n見ませんでした‥？\n---\nわたしが おつかいに\n行ってる間に\nいなく なっちゃって‥",
  "tgt": "「见到我弟弟\n了吗？\n---\n我去跑腿的工夫\n他就\n不见了‥"
 },
 {
  "id": "014369",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}モモ\n「ねえねえ‥\n---\nなんで、わたしって\nこんな所に いるのかなぁ‥\n---\n部屋で 実驗してて\n爆発した ところまでは\n覺えてるんだけどー‥‥\n---\n‥{码0B}‥{码0B}‥ま、いっか。\n---\nところで、あなた達‥\nわたしの 話しあいてに\nならないー？{码14820C92}なってみようかな\nやめておきます",
  "tgt": "{立绘0000}桃桃\n「呐呐……\n---\n我为什么会\n在这种地方呢……\n---\n在房间里做实验\n然后爆炸了\n我记得到这里为止……\n---\n……{码0B}……{码0B}……算了。\n---\n话说，你们……\n愿意听\n我说话吗——？{码14820C92}当你的听众吧\n不必了"
 },
 {
  "id": "014370",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}ありがとうー‥！\n---\nわたし、こう見えても\nけっこう、旅したり\nしてるからー‥\n---\n色々、役に立つ話も\nできると思うのー‥\n---\nで、{码0B}とりあえずは この\n{色04}のんびり{/色}を\n教えてあげる。\n---\nこれで少しは\nリラックスしてみてー。",
  "tgt": "{立绘0000}谢谢——！\n---\n我别看这样\n其实也去过\n不少地方——……\n---\n我想有用的闲谈\n我也能讲不少——……\n---\n那{码0B}就先教给你\n{色04}悠闲{/色}\n吧。\n---\n试着用这个\n放松放松——。"
 },
 {
  "id": "014371",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}「じゃあ、またー‥\nひまな時にでも 来てね。\n---\n他に何か 教えられる事が\nあったら‥\n---\n教えてあげるわ。",
  "tgt": "{立绘0000}「那么，再见——……\n有空再来玩啊。\n---\n要是还有\n什么能教你的……\n---\n我会教给你的。"
 },
 {
  "id": "014372",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}「あ、{码0B}そう‥\n---\nま、いっか‥\nまた遊びに来てねー。",
  "tgt": "{立绘0000}「啊，{码0B}这样……\n---\n算了……\n再来玩哟——。"
 },
 {
  "id": "014373",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}ばいばい。",
  "tgt": "{立绘0000}拜拜。"
 },
 {
  "id": "014374",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}モモ\n「あ、来てくれたのー‥\n---\nちょうど ヒマだったし\nうれしいわねー。",
  "tgt": "{立绘0000}桃桃\n「啊，你来啦——……\n---\n正好闲着呢\n真开心——。"
 },
 {
  "id": "014375",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}そういえば‥\nこんな技、知ってるー？\n---\n‥{码0B}‥{码0B}‥{码0B}って\n知ってるワケ、ないか。\n---\nじゃ、はい！\nこの、{色03}{占位01}{/色}を\n教えてあげる。",
  "tgt": "{立绘0000}说起来……\n这样的技艺，你知道吗——？\n---\n……{码0B}……{码0B}……{码0B}也\n对哦，你不可能知道。\n---\n那，给你！\n这招{色03}{占位01}{/色}\n教给你。"
 },
 {
  "id": "014376",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}ひまな時にでも、また\n会いに来てよ‥\n---\n他にも、何かあったら\n教えてあげるー。",
  "tgt": "{立绘0000}有空的时候\n再来找我玩啊……\n---\n要是还有别的什么\n我再教你——。"
 },
 {
  "id": "014377",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}どうも、あなた達に\n教えられるものは‥\n---\n全部、教えちゃったみたいー。\n---\n‥{码0B}‥{码0B}‥それなりに\n楽しかったわよー。\n---\n何か、師匠にでも\nなったみたいでー！",
  "tgt": "{立绘0000}看来能教给\n你们的东西……\n---\n好像\n全教完了——。\n---\n……{码0B}……{码0B}……还挺\n开心的哟——。\n---\n感觉就像\n当了回师父——！"
 },
 {
  "id": "014378",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}今日はどうするのー？{码14820C93}教えてください\nいいです\n何でもないです",
  "tgt": "{立绘0000}今天怎么样——？{码14820C93}请教我\n不用了\n没什么事"
 },
 {
  "id": "014379",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}ほかにはー？{码14820C93}教えてください\nいいです\n何でもないです",
  "tgt": "{立绘0000}还有别的吗——？{码14820C93}请教我\n不用了\n没什么事"
 },
 {
  "id": "014380",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}‥新しく教える人は\nいないみたいよ。",
  "tgt": "{立绘0000}……看来\n没有新的人要教哟。"
 },
 {
  "id": "014381",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}‥じゃ、{占位02}に\nこの {色04}のんびり{/色}を\n教えてあげるね。",
  "tgt": "{立绘0000}……那就教{占位02}\n这招{色04}悠闲{/色}\n吧。"
 },
 {
  "id": "014382",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}じゃ、あなたたちに\nこの {色04}のんびり{/色}を\n教えてあげるね。",
  "tgt": "{立绘0000}那就教你们\n这招{色04}悠闲{/色}\n吧。"
 },
 {
  "id": "014383",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}‥なによー？",
  "tgt": "{立绘0000}……怎么啦——？"
 },
 {
  "id": "014384",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}‥あれー？\n---\nわたし、誰かに何か\n教えてたっけ‥？",
  "tgt": "{立绘0000}……咦——？\n---\n我是不是\n教过谁\n什么东西来着……？"
 },
 {
  "id": "014385",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}‥じゃ、{占位02}は\nやめちゃうのねー。",
  "tgt": "{立绘0000}……那\n{占位02}就\n不学了吗——。"
 },
 {
  "id": "014386",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}‥じゃ あなたたち\nやめちゃうのねー。",
  "tgt": "{立绘0000}……那你们\n就不学了吗——。"
 },
 {
  "id": "014387",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}‥なによー？",
  "tgt": "{立绘0000}……怎么啦——？"
 },
 {
  "id": "014388",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}なんだか、わたしって\n場違いじゃ なーい？\n---\nどーも、違う世界に\n迷いこんだような\n気がするのよねー‥",
  "tgt": "{立绘0000}总觉得\n我是不是\n很格格不入——？\n---\n总觉得像是\n误入了\n别的世界似的——……"
 },
 {
  "id": "014389",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "{立绘0000}モモ\n「‥‥なーに？\n---\n道先を知りたいなら\nたぶんわたしの方が\nわからないわよー。",
  "tgt": "{立绘0000}桃桃\n「……什——么？\n---\n要是想问路的话\n多半我\n比你们还不认路哟——。"
 },
 {
  "id": "014390",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "25",
  "tgt": "25"
 },
 {
  "id": "014391",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "30",
  "tgt": "30"
 },
 {
  "id": "014392",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "40",
  "tgt": "40"
 },
 {
  "id": "014393",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "50",
  "tgt": "50"
 },
 {
  "id": "014394",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "スプレー",
  "tgt": "喷雾"
 },
 {
  "id": "014395",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "草むしり",
  "tgt": "拔草"
 },
 {
  "id": "014396",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "オラクル",
  "tgt": "神谕"
 },
 {
  "id": "014397",
  "file": "WORLD/AREAS019.EMI",
  "seg": 11,
  "src": "からにこもる",
  "tgt": "藏入壳中"
 },
 {
  "id": "014398",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}ふーれんしつない",
  "tgt": "{立绘0000}福莲室内"
 },
 {
  "id": "014399",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「族長さま‥\n何か、事件に\nまきこまれてるってねぇ‥",
  "tgt": "「族长大人‥\n听说被卷进了\n什么事件呀‥"
 },
 {
  "id": "014400",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「{队员02}さま\n敵国で、捕まったって\n話しだねぇ‥\n---\nこりゃ、また\n戦になるねぇ‥",
  "tgt": "「{队员02}大人\n在敌国被捕了\n听说了呀‥\n---\n这下又要\n打仗了呢‥"
 },
 {
  "id": "014401",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「{队员02}さまは‥\n---\n行方不明になった\nウインディアの王女様を\n探しに行かれたのよ‥\n---\n何か、ロマンチック‥！",
  "tgt": "「{队员02}大人‥\n---\n是去找失踪的\n温迪亚王女大人\n才出的事哟‥\n---\n总觉得好浪漫‥！"
 },
 {
  "id": "014402",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「001Aにへんこうです。",
  "tgt": "「已切换为001A。"
 },
 {
  "id": "014403",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0101}「ん‥？\nわいの仲間、どこにでも\nおるってか？\n---\n{金钱00}わいらの一族は\n商売による、世界セーフクを\n狙っとるからな！{码14840C94}じゃ、買い物してあげよう\nふーん、何か売ってやるか\nなら、武器の下取りでも‥\n世界セーフクに協力しない",
  "tgt": "{立绘0101}「嗯……？\n你是说我的同伙\n哪儿都有？\n---\n{金钱00}我们这一族\n正瞄准靠生意\n称霸世界呢！{码14840C94}那，让你买点东西\n哼——，卖你点什么吧\n那就，武器折价回收……\n不协助称霸世界"
 },
 {
  "id": "014404",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「フーレンの一族は\nすごく強いので 有名だから‥\n---\n弟子になろうと、旅してくる\n人もいるんだって。",
  "tgt": "「弗雷恩一族\n以强大出名‥\n---\n所以也有人为了拜师\n远道而来呢。"
 },
 {
  "id": "014405",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}「カンちゃん、見なかった？\nあたしの弟子‥",
  "tgt": "{立绘0000}「看见小坎了吗？\n我的弟子……"
 },
 {
  "id": "014406",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘8242}「ふーむ‥\n{队员02}が そんな事に‥",
  "tgt": "{立绘8242}「嗯～‥\n{队员02}竟出了这种事‥"
 },
 {
  "id": "014407",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘8343}「ルディアめ‥\nフーレンを あまく見おって！\n---\nこうなれば、もう\n戦爭じゃ！",
  "tgt": "{立绘8343}「鲁迪亚那厮‥\n竟小看弗雷恩！\n---\n事已至此\n只能开战了！"
 },
 {
  "id": "014408",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘8444}「そうじゃ！",
  "tgt": "{立绘8444}「正是！"
 },
 {
  "id": "014409",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘8242}「まて、まて‥\nうかつな事を 言うでない\n---\nそうでなくても、フーレンは\n皆、血の気が\n多いんじゃから‥",
  "tgt": "{立绘8242}「等等，等等‥\n别口出轻率之言\n---\n弗雷恩人本就\n个个血气\n旺盛‥"
 },
 {
  "id": "014410",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘8444}「そうじゃ！",
  "tgt": "{立绘8444}「正是！"
 },
 {
  "id": "014411",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘8343}「ふん‥、じゃあ\nどうすると言うんじゃ‥\n---\nわざわざ、{队员01}さんが\n若の身を案じて\n報せてくれたのに‥",
  "tgt": "{立绘8343}「哼‥，那你说\n怎么办‥\n---\n{队员01}先生特意\n为少爷的安危\n来报信呀‥"
 },
 {
  "id": "014412",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘8444}「そうじゃ！\nそれにしても‥\n---\n{队员01}ちゃん\n大きくなったのぉ‥！\n---\n前に見たときは\nこぉーんな、チビで‥",
  "tgt": "{立绘8444}「正是！\n话说回来‥\n---\n{队员01}丫头\n都长这么大了呀‥！\n---\n上次见的时候\n还是这么小的小不点‥"
 },
 {
  "id": "014413",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘8242}「い、いや‥\nそれは さておき‥\n---\nどうしたもんじゃ‥",
  "tgt": "{立绘8242}「不，不‥\n先不说这个‥\n---\n这事怎么办呀‥"
 },
 {
  "id": "014414",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘8343}「うむぅ‥、こんなときに\n{色02}ターボさま{/色}が\nいらっしゃれば、のぉ‥",
  "tgt": "{立绘8343}「唔嗯……这种时候\n要是{色02}塔博大人{/色}\n还在就好了……"
 },
 {
  "id": "014415",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘4100}「ターボさま‥、って？",
  "tgt": "{立绘4100}「塔博大人……是指？"
 },
 {
  "id": "014416",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘8444}「なくなった、前の族長の\nおくさま‥\n---\n{队员02}の、母上じゃ。",
  "tgt": "{立绘8444}「是已故的前任族长\n夫人‥\n---\n{队员02}的母亲呀。"
 },
 {
  "id": "014417",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘8343}「若が‥、{队员02}が\n族長になった後‥\n---\nターボさまは\n里を はなれて‥\n---\n{色02}黄金平野{/色}に\n移り住まれたんじゃ。",
  "tgt": "{立绘8343}「自从{队员02}\n当上族长之后……\n---\n塔博大人\n就离开了村子……\n---\n移居到了\n{色02}黄金平原{/色}。"
 },
 {
  "id": "014418",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘8444}「さすらいの旅じゃ。",
  "tgt": "{立绘8444}「四处游历去了。"
 },
 {
  "id": "014419",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘8242}「ターボさまなら、何か\nよい考えが‥\nあったかも しれんが‥\n---\nワシらでは‥‥",
  "tgt": "{立绘8242}「塔博大人在的话\n也许会有\n好主意‥\n---\n光靠我们‥‥"
 },
 {
  "id": "014420",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘8444}「もう少し 若ければ\nうまに乘って‥\n---\nターボ様を 探しに\n行ったんじゃが、なあ‥",
  "tgt": "{立绘8444}「要是再年轻几岁\n就骑马\n---\n去找塔博大人\n了呀，唉‥"
 },
 {
  "id": "014421",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0202}「ターボさまなら、何か\n{队员02}を 救う\nよい手を、考えるじゃろうな‥",
  "tgt": "{立绘0202}「塔博大人的话\n定会想出救{队员02}的\n好办法吧‥"
 },
 {
  "id": "014422",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0303}「ターボさまは、今ごろ\n黄金平野で\nひとり旅じゃ‥‥\n---\n黄金平野に 行くなら\n---\nうまが いるなぁ‥",
  "tgt": "{立绘0303}「塔博大人如今\n大概正在黄金平原\n独自旅行‥‥\n---\n要去黄金平原的话\n---\n得有马呀‥"
 },
 {
  "id": "014423",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0404}「わしらじゃと\nすぐに、戦のことばかり\n考えてしまうんじゃ‥",
  "tgt": "{立绘0404}「换成我们\n满脑子\n就只剩打仗了‥"
 },
 {
  "id": "014424",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「休んでお行き、旅の人{码14860C93}ひと休みしよう\n記錄だけしよう\n今はやめておこう",
  "tgt": "住一晚再走吧，旅行的人休息一下\n只做记录\n现在算了{码14860C93}ひと休みしよう\n記錄だけしよう\n今はやめておこう"
 },
 {
  "id": "014425",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「金が足らん。",
  "tgt": "「钱不够。"
 },
 {
  "id": "014426",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0404}「ふむ、なるほど\n{道具0101}のニセモノを‥\n---\nその手が あったか\nさすがはターボさまじゃ！",
  "tgt": "{立绘0404}「唔，原来如此\n{道具0101}的假货‥\n---\n竟有这种办法\n不愧是塔博大人呀！"
 },
 {
  "id": "014427",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0303}「この一件は、もう\nおぬしらに まかす他\nないわい‥\n---\nお願いしますぞ‥！",
  "tgt": "{立绘0303}「这件事\n就只能拜托\n你们了‥\n---\n拜托了呀‥！"
 },
 {
  "id": "014428",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0202}「{色02}グーの火山{/色}に\n行くにはな‥\n---\nまず、黄金平野を\nずっと{色02}東{/色}にすすみ‥\n---\n大きな岩が 見えたら\n次に、{色02}南{/色}にすすむ‥\n---\n遠くに見える けむりの\nのぼる山が{色02}グーの火山{/色}じゃ。",
  "tgt": "{立绘0202}「要去{色02}古之火山{/色}的话……\n---\n先沿着黄金平原\n一直往{色02}东{/色}走……\n---\n看见大石头后\n接着往{色02}南{/色}走……\n---\n远处冒烟的那座山\n就是{色02}古之火山{/色}。"
 },
 {
  "id": "014429",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}「カンちゃんねー\nもっと 修行するんだって\n飛び出して いっちゃった‥\n---\n別に 強くなんなくても\nいいのになー",
  "tgt": "{立绘0000}「小坎那家伙\n说要好好修行\n就跑出去了……\n---\n其实\n不变强也没关系呀——"
 },
 {
  "id": "014430",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{框02}{立绘0000}「だーめよ カンちゃん\nケンカしたりしちゃ‥\n---\nアンタ 弱いんだから。",
  "tgt": "{框02}{立绘0000}「不行哟，小坎\n不许跟人吵架……\n---\n你可是很弱的。"
 },
 {
  "id": "014431",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘8545}「ふぬー！？\n---\nし、師匠‥オレって\nよ、{码0B}弱いんですか‥？",
  "tgt": "{立绘8545}「呜奴——！？\n---\n师，师父‥我很\n弱吗‥？{码0B}弱いんですか‥？"
 },
 {
  "id": "014432",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{框02}{立绘0000}「うん、まあ‥\nちょっと‥、まあまあ‥",
  "tgt": "{框02}{立绘0000}「嗯，算……\n还算……一般吧……"
 },
 {
  "id": "014433",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{框02}{立绘0000}「まあ、ここで‥\nわたしの 手伝いを\nしてれば‥‥\n---\nそのうち それなりには\nなると思うけど、{码0B}ね。",
  "tgt": "{框02}{立绘0000}「嘛，在这儿……\n帮我打打杂的话……\n---\n我想你迟早\n也能有\n几分出息，{码0B}吧。"
 },
 {
  "id": "014434",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘4100}「そうですね‥\nターボ様に お会いすれば‥\n---\nなんとか なるかも\nしれないって 事ですか‥",
  "tgt": "{立绘4100}「也就是说……\n只要见到塔博大人……\n---\n说不定就\n有办法\n解决了吗……"
 },
 {
  "id": "014435",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0202}「ともかく、ありがとうよ‥\n---\n今後のことは、わしらも\n協力するが‥\n---\nやはり、ターボ様に\n話した方が、よかろうて‥",
  "tgt": "{立绘0202}「总之，多谢了‥\n---\n今后的事\n我们也会协助‥\n---\n但还是该跟塔博大人\n说一声呀‥"
 },
 {
  "id": "014436",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0202}「これ、{队员02}\nそんな事では、族長として‥\n---\n‥いや、{码0B}とにかく無事で\nよかったわい。\n---\nターボ様にも、きちんと\n話しておくんじゃぞ‥",
  "tgt": "{立绘0202}「喂，{队员02}\n那样可当不了族长呀‥\n---\n‥不，总之平安\n就好。\n---\n也要跟塔博大人\n好好说清楚哟‥{码0B}とにかく無事で\nよかったわい。\n---\nターボ様にも、きちんと\n話しておくんじゃぞ‥"
 },
 {
  "id": "014437",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0303}「ルディアめ‥！\n---\n連合の長だか、何だか\n知らんが‥\n---\n我らの族長を\nかどわかすとは‥！",
  "tgt": "{立绘0303}「鲁迪亚那厮‥！\n---\n什么联军首领\n管他是谁‥\n---\n竟敢拐走\n我们的族长‥！"
 },
 {
  "id": "014438",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0303}「若、{码0B}ルディアに\nリベンジするんなら‥\n---\nワシも 共にゆくぞ！",
  "tgt": "{立绘0303}「少爷，要去\n鲁迪亚报仇的话‥\n---\n我也同去！{码0B}ルディアに\nリベンジするんなら‥\n---\nワシも 共にゆくぞ！"
 },
 {
  "id": "014439",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0404}「若を、助け出したか‥\n---\nルディアの出方が\nもんだいじゃが‥\n---\nまずは、めでたいわい。",
  "tgt": "{立绘0404}「把少爷救出来了呀‥\n---\n鲁迪亚会怎么出招\n是个问题‥\n---\n但总之，可喜可贺呀。"
 },
 {
  "id": "014440",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0404}「おお、{队员02}！\n---\nよかったのぉ‥！",
  "tgt": "{立绘0404}「哦，{队员02}！\n---\n太好了呀‥！"
 },
 {
  "id": "014441",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「族長さま、無事で\nよかったよ‥\n---\n事件とやらは\n解決したのかねぇ？",
  "tgt": "「族长大人没事\n太好了‥\n---\n那个事件\n解决了吗？"
 },
 {
  "id": "014442",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「{队员02}さま、归って\nきなすったねぇ‥\n---\nこれで 戦にならずに\nすむかねぇ‥",
  "tgt": "「{队员02}大人回来\n了呀‥\n---\n这样就不会\n打起来了吧‥"
 },
 {
  "id": "014443",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「{队员02}さま‥\n---\n仲間の方が ルディアから\n助け出したんですってね\n---\n何か、ドラマチック‥！",
  "tgt": "「{队员02}大人‥\n---\n是伙伴们从鲁迪亚\n救出来的呢\n---\n总觉得好戏剧‥！"
 },
 {
  "id": "014444",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「コワイ顏した 大男を\n見かけたけど‥\n---\nあの人も 弟子入りしに\n来たのかな？",
  "tgt": "「见到了一个\n面相凶恶的大汉‥\n---\n那人也是来\n拜师的吗？"
 },
 {
  "id": "014445",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0202}「ふむ‥‥\n---\nウインディアまで\n竜に会いに‥、か。\n---\nともかく、この地に\nとどまって おるよりは\n安全かもしれん‥",
  "tgt": "{立绘0202}「唔‥‥\n---\n去温迪亚\n见龙‥，吗。\n---\n总之，总比\n留在此地\n安全吧‥"
 },
 {
  "id": "014446",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0202}「ウインディアで、竜に会い‥\n---\n{队员00}どのの事が\n何か、分かれば‥\n---\nルディアの追求を\nかわせるかも‥、と\n言う事じゃな。",
  "tgt": "{立绘0202}「在温蒂亚见过龙……\n---\n只要能弄清\n一点{队员00}大人的事……\n---\n说不定就能\n搪塞过去\n卢迪亚的追究……是这样吧。"
 },
 {
  "id": "014447",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0303}「帝国との条約で\nここも、中立地に\nされたら‥\n---\nいや、そんな事は\n許さんわい！",
  "tgt": "{立绘0303}「跟帝国的条约要是\n把这里也划成\n中立地‥\n---\n哼，那种事\n我绝不答应！"
 },
 {
  "id": "014448",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0303}「若！\nわしの めん玉の\nくろい內は‥\n---\n帝国からも、ルディアからも\nこの里を 守るから\n安心なされよ！",
  "tgt": "{立绘0303}「少爷！\n我这眼珠\n里的黑瞳‥\n---\n无论帝国还是鲁迪亚\n都会守护这山寨\n放心吧！"
 },
 {
  "id": "014449",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0404}「ふむ‥？\n---\n遺跡を通って ウインディアへ\n行くのか‥？\n---\n遺跡は、黄金平野の\n東のはしじゃ‥",
  "tgt": "{立绘0404}「唔‥？\n---\n要穿过遗迹\n去温迪亚吗‥？\n---\n遗迹在黄金平原的\n东端呀‥"
 },
 {
  "id": "014450",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0404}「ふむ‥？\n---\n遺跡を通って ウインディアへ\n行くのか‥？\n---\n遺跡は、黄金平野の\n東のはしじゃ‥",
  "tgt": "{立绘0404}「唔‥？\n---\n要穿过遗迹\n去温迪亚吗‥？\n---\n遗迹在黄金平原的\n东端呀‥"
 },
 {
  "id": "014451",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0202}「むう‥、神‥\nアルカイの竜‥？\n---\nそれは、もう ワシらが\n手助けできるような\n話では、ないのぉ‥",
  "tgt": "{立绘0202}「唔～，神‥\n阿尔凯之龙‥？\n---\n那已经不是\n我们能帮上忙的\n事情了呀‥"
 },
 {
  "id": "014452",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0202}「むう‥、神‥\nアルカイの竜‥？\n---\nそれは、もう ワシらが\n手助けできるような\n話では、ないのぉ‥",
  "tgt": "{立绘0202}「唔～，神‥\n阿尔凯之龙‥？\n---\n那已经不是\n我们能帮上忙的\n事情了呀‥"
 },
 {
  "id": "014453",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0303}「竜‥‥？\n---\nふむ‥、{码0B}黄金平野には\n草竜様が おるが‥",
  "tgt": "{立绘0303}「龙‥‥？\n---\n唔‥，黄金平原\n有草龙大人‥{码0B}黄金平野には\n草竜様が おるが‥"
 },
 {
  "id": "014454",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0303}「竜‥‥？\n---\nふむ‥、{码0B}黄金平野には\n草竜様が おるが‥",
  "tgt": "{立绘0303}「龙‥‥？\n---\n唔‥，黄金平原\n有草龙大人‥{码0B}黄金平野には\n草竜様が おるが‥"
 },
 {
  "id": "014455",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0404}「二人の神？\nアルカイの竜？\n---\nよく分からんが‥\nとにかく 強いと\nいう事じゃな？",
  "tgt": "{立绘0404}「两位神明？\n阿尔凯之龙？\n---\n搞不太懂‥\n总之就是很强\n对吧？"
 },
 {
  "id": "014456",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0404}「二人の神？\nアルカイの竜？\n---\nよく分からんが‥\nとにかく 強いと\nいう事じゃな？",
  "tgt": "{立绘0404}「两位神明？\n阿尔凯之龙？\n---\n搞不太懂‥\n总之就是很强\n对吧？"
 },
 {
  "id": "014457",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「{队员02}さま‥今度は\nウインディアの方に\nお出かけに なったとか\n---\nおいそがしい 人だねぇ‥",
  "tgt": "「{队员02}大人这回\n又去了温迪亚\n那边呀\n---\n真是个大忙人呢‥"
 },
 {
  "id": "014458",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「人を 一人探すのに‥\nどうして みんな\nジャマするの？",
  "tgt": "「不过是找一个人‥\n为什么大家\n都要妨碍呀？"
 },
 {
  "id": "014459",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「{队员02}さま達を\n追いかけて、帝国も\n来てるそうだねぇ‥\n---\nエラい事に\nなっちまったねぇ‥",
  "tgt": "「听说帝国也\n追着{队员02}大人\n他们来了‥\n---\n事情变得\n严重了呢‥"
 },
 {
  "id": "014460",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「ここにいた商人‥？\n---\nこの家が 自分の店だ\nなんて、言いだすから\nたたき出して やったよ！\n---\nそれはそうと‥\n休んでお行き、旅の人{码14860C93}ひと休みしよう\n記錄だけしよう\n今はやめておこう",
  "tgt": "「之前在的商人‥？\n---\n竟说这房子\n是他自己的店\n被我轰出去了！\n---\n话说回来‥\n住一晚再走吧，旅行的人休息一下\n只做记录\n现在算了{码14860C93}ひと休みしよう\n記錄だけしよう\n今はやめておこう"
 },
 {
  "id": "014461",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「おれのシッポ\n---\nふまないで くれよ‥",
  "tgt": "「我的尾巴\n---\n别踩哟‥"
 },
 {
  "id": "014462",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「セネスタからの\n長旅で、つかれちゃった\n{特效}{/特效}{码08}ふわわわぁ‥{码0E}",
  "tgt": "「从塞内斯塔过来\n一路辛苦，累坏了\n呼哇哇哇‥{特效}{/特效}{码08}ふわわわぁ‥{码0E}"
 },
 {
  "id": "014463",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0101}「ん‥？\nなんで、こんなトコに\nおるってか？\n---\n{金钱00}ま、世界セーフクも\n楽やない ちゅうことや！{码14840C94}じゃ、買い物してあげよう\nふーん、何か売ってやるか\nなら、武器の下取りでも‥\n世界セーフクに協力しない",
  "tgt": "{立绘0101}「嗯……？\n你是问我\n怎么在这种地方？\n---\n{金钱00}嘛，就是说\n称霸世界\n也不轻松呀！{码14840C94}那，让你买点东西\n哼——，卖你点什么吧\n那就，武器折价回收……\n不协助称霸世界"
 },
 {
  "id": "014464",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}「あー、いそがしい！\n---\nカンちゃん、今ごろ\nどこで 何やってんだろ‥？",
  "tgt": "{立绘0000}「啊——好忙！\n---\n小坎现在\n在哪儿干嘛呢……？"
 },
 {
  "id": "014465",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}ウナ\n「あなた達が\nイジめたから‥\n---\nカンちゃん 逃げちゃった‥\n---\nどうしてくれるのよ！？{码14820C92}すいません‥\nそんなの、知りません",
  "tgt": "{立绘0000}乌娜\n「你们\n欺负了他……\n---\n小坎\n才跑掉的……\n---\n你们打算怎么办！？{码14820C92}对不起……\n那种事我们不知道"
 },
 {
  "id": "014466",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}‥{码0B}‥{码0B}‥\n---\nじゃ、代わりに\nあんた達を きたえても\nいいって事ね‥\n---\nよし！ じゃ、この‥\n{色04}全力{/色}を おぼえて\nいきなさいよ‥！\n---\nよく外れるけど‥\n当たったら スゴイんだから！\n---\n‥誰がおぼえる？",
  "tgt": "{立绘0000}……{码0B}……{码0B}……\n---\n那就换成\n把你们调教\n一番也行是吧……\n---\n好！那，这招……\n给我把{色04}全力{/色}\n记住咯……！\n---\n虽然经常落空……\n但打中了可是很痛的！\n---\n……谁要学？"
 },
 {
  "id": "014467",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}戦いの中で\n自分を 高めるの‥\n---\nコンボによるダメージで\n{色02}{占位00}{/色}以上を出したら\nまた、おいでよ。",
  "tgt": "{立绘0000}在战斗中\n提升自己……\n---\n连击伤害要是\n超过{色02}{占位00}{/色}\n就再来找我。"
 },
 {
  "id": "014468",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}‥{码0B}‥{码0B}‥\n---\nでもねー‥‥\n---\n{色02}コンボ{/色}で、{色02}1000{/色}ダメージも\n出せない連中に\nやられたんじゃ‥\n---\nカンちゃんも\nうかばれないね‥",
  "tgt": "{立绘0000}……{码0B}……{码0B}……\n---\n不过呢——……\n---\n被{色02}连击{/色}打出\n{色02}1000{/色}伤害的家伙\n打倒了的话……\n---\n小坎\n也没法成佛呢……"
 },
 {
  "id": "014469",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}‥{码0B}‥{码0B}‥ばいばい。",
  "tgt": "{立绘0000}……{码0B}……{码0B}……拜拜。"
 },
 {
  "id": "014470",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}ウナ\n「‥あ、どう？\n---\n戦ってる？",
  "tgt": "{立绘0000}……啊，怎么样？\n---\n在战斗吗？"
 },
 {
  "id": "014471",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}ふーん‥、どうやら\nけっこう コンボを\n決めてるみたいね‥\n---\nよーし、{码0B}いいわ‥\nこの、{色03}{占位01}{/色}を\n教えてあげる！",
  "tgt": "{立绘0000}哦——，看样子\n你们挺会\n打连击的嘛……\n---\n好——，{码0B}行……\n这招{色03}{占位01}{/色}\n教给你！"
 },
 {
  "id": "014472",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}コンボの 道は\n深いのよ‥\n---\n次は、コンボで‥\n{色02}{占位00}{/色}ダメージ以上を\n出してみてよ。\n---\nそうしたら、次の\nスキルを 教えてあげるよ。",
  "tgt": "{立绘0000}连击之道\n深着呢……\n---\n下次用连击\n打出超过\n{色02}{占位00}{/色}的伤害试试。\n---\n到时再教你\n下一个技能。"
 },
 {
  "id": "014473",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}‥{码0B}‥{码0B}‥\nスゴイわね、あなた達‥\n---\nカンちゃんじゃ こうは\nいかなかった かもね‥\n---\nもう、あたしが\n教えることは ないわ。",
  "tgt": "{立绘0000}……{码0B}……{码0B}……\n你们真厉害……\n---\n换成小坎\n恐怕就不行了吧……\n---\n我\n已经没什么可教的了。"
 },
 {
  "id": "014474",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}ところで 何か用？{码14820C93}弟子になります！\nもう、やめます‥\n何でもないです",
  "tgt": "{立绘0000}话说，有事吗？{码14820C93}我要当弟子！\n不学了……\n没什么事"
 },
 {
  "id": "014475",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}他に、何かある？{码14820C93}弟子になります！\nもう、やめます‥\n何でもないです",
  "tgt": "{立绘0000}还有别的事吗？{码14820C93}我要当弟子！\n不学了……\n没什么事"
 },
 {
  "id": "014476",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}あら‥‥\n---\nみんな あたしの\n弟子じゃない！？",
  "tgt": "{立绘0000}哎呀……\n---\n怎么全是\n我的弟子！？"
 },
 {
  "id": "014477",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}じゃ、{占位02}に\n{色04}全力{/色}を 教えるね。\n---\n実戦を つみ重ねて\nあなただけの コンボを\n決めてね！",
  "tgt": "{立绘0000}那就教{占位02}\n{色04}全力{/色}吧。\n---\n在实战中不断磨练\n打出属于你自己的\n连击哟！"
 },
 {
  "id": "014478",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}じゃ、あなたたちに\n{色04}全力{/色}を 教えるね。\n---\n実戦を つみ重ねて\nすごいコンボを 決めてね！",
  "tgt": "{立绘0000}那就教你们\n{色04}全力{/色}吧。\n---\n在实战中不断磨练\n打出厉害的连击哟！"
 },
 {
  "id": "014479",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}誰も あたしに\n学ばないのか‥\n---\n何だか、ちょっと\nがっかりね‥‥",
  "tgt": "{立绘0000}没人\n愿意跟我学吗……\n---\n总觉得\n有点失望…………"
 },
 {
  "id": "014480",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}あら‥‥\n---\nあたしが めんどうみてる人は\n誰も いないじゃない！\n---\nからかわないでよね！",
  "tgt": "{立绘0000}哎呀……\n---\n我照看的人\n一个都没有嘛！\n---\n别耍我哟！"
 },
 {
  "id": "014481",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}そうか、残念ね‥\n---\nカンちゃんに つづいて\n{占位02}も‥\nいなくなっちゃうのか‥",
  "tgt": "{立绘0000}这样啊，真遗憾……\n---\n继小坎之后\n{占位02}\n也要走了吗……"
 },
 {
  "id": "014482",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}そうか‥‥\n---\nカンちゃんに つづいて\nあなたたちも‥\n---\nいなくなるのは\n少し、残念ね‥",
  "tgt": "{立绘0000}这样啊……\n---\n继小坎之后\n你们也要……\n---\n走的话\n还真有点遗憾呢……"
 },
 {
  "id": "014483",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}ふー‥‥\n---\nやめるとか、やめないとか\nはっきりしないね‥！\n---\nカンちゃんは、もっと\nはっきり してたよ！",
  "tgt": "{立绘0000}呼………\n---\n学还是不学\n倒是给个准话呀……！\n---\n小坎都比你\n果断多了！"
 },
 {
  "id": "014484",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}基本は、戦い！\n---\nコンボのダメージで\n{色02}{占位00}{/色}以上を出したら\nまた、おいで！",
  "tgt": "{立绘0000}基础就是战斗！\n---\n连击伤害要是\n超过{色02}{占位00}{/色}\n就再来！"
 },
 {
  "id": "014485",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0000}ウナ\n「あなた、もしかしたら‥\n---\nこの世で 一番強くない？\n---\nあたしの目に\n狂いがなければの話だけど‥",
  "tgt": "{立绘0000}乌娜\n「你该不会……\n---\n是世上最强的吧？\n---\n前提是\n我的眼光没看走眼……"
 },
 {
  "id": "014486",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "1500",
  "tgt": "1500"
 },
 {
  "id": "014487",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "3000",
  "tgt": "3000"
 },
 {
  "id": "014488",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "10000",
  "tgt": "10000"
 },
 {
  "id": "014489",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "ぶんどり",
  "tgt": "掠夺"
 },
 {
  "id": "014490",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "スーパーコンボ",
  "tgt": "超级连击"
 },
 {
  "id": "014491",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "あばれる",
  "tgt": "撒野"
 },
 {
  "id": "014492",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "{立绘0606}「また、お会いしましたね\nみなさーん！\n---\n今日も、みなさんに\n旅の お役立ち情報を\nおとどけしますねー！{码14000C95}つながる技\nコンボのヒット数\nコンボの追加効果\n変化する敵\n話を闻かない",
  "tgt": "{立绘0606}「我们又见面啦\n各位——！\n---\n今天也为大家\n送上旅途的\n实用情报哟——！{码14000C95}可连接的技能\n连击的命中数\n连击的追加效果\n会变化的敌人\n不听"
 },
 {
  "id": "014493",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「コンボで 技をつなげる時‥\n---\n火から風、風から水\n水から土、土から火‥\n---\nという感じで、技の属性に\n注意して つなげると‥\n---\nより強力な 技が\n出るんだ‥！\n---\nいろいろ、ためしてみてね！\n---\n{引2 7600}",
  "tgt": "「用连击连招时‥\n---\n火接风、风接水\n水接土、土接火‥\n---\n注意招式的属性\n这样连下去‥\n---\n就能放出\n更强的招式‥！\n---\n各种都试试吧！\n---\n{引2 7600}"
 },
 {
  "id": "014494",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「ヒット数は、とにかく‥\n---\n出現した 敵の数が\n多いほど、上がりやすいよ‥\n---\nさらに、同じ属性の\n技を つなげると‥\n---\nつながる度に ヒット数が\nひとつずつ 追加されるよ！\n---\n{引2 7600}",
  "tgt": "「命中数嘛‥\n---\n出现的敌人越多\n就越容易涨哟‥\n---\n还有，连相同的\n属性招式‥\n---\n每连一招\n命中数就会多一哟！\n---\n{引2 7600}"
 },
 {
  "id": "014495",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「回復や、ステータスを\nアップさせる技をつなぐと‥\n---\nそれぞれの 効果が\nちょっとだけ、追加されて\nつながるんだ‥！\n---\nだから、{色02}{道具2C04}{/色}と\n{色02}{道具2704}{/色}とで‥\n---\n防御力を 上げながら\n少しだけ、HPを\n回復する‥\n---\nなんてことが できるんだ‥\nちょっと、おトクだね！\n---\n{引2 7600}",
  "tgt": "「把回复技和能力\n提升技连接起来……\n---\n各自的效果\n会稍微追加\n再连接起来……！\n---\n所以用{色02}{道具2C04}{/色}接\n{色02}{道具2704}{/色}……\n---\n就能一边提升防御力\n一边稍微回复\nHP……\n---\n能做到这种事……\n很划算吧！\n---\n{引2 7600}"
 },
 {
  "id": "014496",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「{色02}ウド{/色}とか\n{色02}ファイアードレイク{/色}って\nモンスターを 知ってる？\n---\nやつらに、火の属性の\n技をかけると‥、なんと\nパワーアップ するんだ！\n---\nけれど、そうやって倒すと\nその分 たくさんのEXPが\nもらえるんだよ！\n---\nそんなモンスターは、他にも\nいるから‥\n探してみてね！\n---\n{引2 7600}",
  "tgt": "「{色02}乌多{/色}\n{色02}火蜥龙{/色}\n这类魔物知道吗？\n---\n对它们使用\n火属性技能的话……它们\n竟然会力量提升！\n---\n不过用这办法打倒\n就能获得相应\n大量的EXP哟！\n---\n那样的魔物还有\n其他……\n找找看吧！\n---\n{引2 7600}"
 },
 {
  "id": "014497",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「あら、そう‥\nじゃあーねー！",
  "tgt": "「哎呀，这样呀‥\n那就拜拜！"
 },
 {
  "id": "014498",
  "file": "WORLD/AREAS020.EMI",
  "seg": 11,
  "src": "「他に、何か闻きたい？{码14000C95}つながる技\nコンボのヒット数\nコンボの追加効果\n変化する敵\n話を闻かない",
  "tgt": "「还想听什么？{码14000C95}可连接的技能\n连击的命中数\n连击的追加效果\n会变化的敌人\n不听"
 },
 {
  "id": "014499",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「たいほーのまちあすたな」",
  "tgt": "「大炮之镇阿斯塔纳」"
 },
 {
  "id": "014500",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「フォウ帝国軍 御用達の\n武器ばかりだよ‥{码14840C94}何か買おう\n持ち物を売ろう\n武器を下取りしてもらおう\n今は用がない‥",
  "tgt": "「全是福乌帝国军队\n专用的武器‥要买点什么\n卖掉随身物品\n以旧换新武器\n现在不需要‥{码14840C94}何か買おう\n持ち物を売ろう\n武器を下取りしてもらおう\n今は用がない‥"
 },
 {
  "id": "014501",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「軍の人間ではないようだが‥\n何か ご入用かな？{码14850C93}何か買おう\n持ち物を売ろう\n今は用がない‥",
  "tgt": "「看来不是军中之人‥\n有何贵干吗？要买点什么\n卖掉随身物品\n现在不需要‥{码14850C93}何か買おう\n持ち物を売ろう\n今は用がない‥"
 },
 {
  "id": "014502",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「え、人探し‥？\n---\nでも ここは\n軍の建物だから‥\n---\nあんたらが 探してるような\n人は いないと\n思うなー‥",
  "tgt": "「诶，找人‥？\n---\n不过这里可是\n军队的建筑‥\n---\n你们要找的那种人\n这里可没有\n哦——‥"
 },
 {
  "id": "014503",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「どうだい、この大砲‥\n呪砲って 言うんだ。\n---\n戦爭のときは、こいつで\n敵の町を ヅドンと\n呪ってたんだって！",
  "tgt": "「怎么样，这门大炮‥\n它叫咒炮。\n---\n打仗的时候，就是用它\n轰隆一声把敌人的城镇\n咒个稀烂的！"
 },
 {
  "id": "014504",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「ここは、アスタナ‥\n呪砲の町だ。\n---\n呪砲は、重要な兵器なので\nこの町には、兵が\nたくさんいるのだ。",
  "tgt": "「这里是阿斯塔纳‥\n咒炮之镇。\n---\n咒炮是重要兵器\n所以镇上驻扎着\n大量士兵。"
 },
 {
  "id": "014505",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「わたしの彼、ハシビトなの\n早く归ってこないかな‥",
  "tgt": "「我男朋友是桥守\n怎么还不回来呀‥"
 },
 {
  "id": "014506",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「何だか、見かけない\n連中だな‥\n---\nま、帝国は 大きいから‥\n中には ヘンな奴も\nいるよな。",
  "tgt": "「总觉得是些\n眼生的家伙‥\n---\n嘛，帝国这么大‥\n里面有些怪人\n也不稀奇。"
 },
 {
  "id": "014507",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「近所に、{色02}水道橋{/色}って\n橋があってね‥\n---\nこの町の水は、その橋で\n運んできてるんだ。",
  "tgt": "「附近有座桥\n叫{色02}水道桥{/色}…\n---\n这个镇的水\n就是靠那座桥运来的。"
 },
 {
  "id": "014508",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「うん‥？\nあんたら、人探しかい‥\n---\nそうだね‥、何せ\n軍の建物は、人の出入りが\nはげしいからねぇ‥",
  "tgt": "「嗯‥？\n你们在找人吗‥\n---\n也是‥毕竟\n军队的建筑\n人来人往很频繁嘛‥"
 },
 {
  "id": "014509",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「呪砲を使うには\n水が いっぱい\nいるらしくって‥\n---\nこの、軍の建物には\n水道橋が つながってるんだ。",
  "tgt": "「听说用咒炮\n得用掉好多\n好多水‥\n---\n所以这座军队建筑\n连通着水道桥。"
 },
 {
  "id": "014510",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「足りないよ‥ゼニー。",
  "tgt": "「钱不够哟‥。"
 },
 {
  "id": "014511",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「カネが 足りんようだが‥",
  "tgt": "「你的钱似乎不够‥"
 },
 {
  "id": "014512",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「おカネが ないんじゃ\n泊められないねぇ‥",
  "tgt": "「没钱的话\n可留宿不了呀‥"
 },
 {
  "id": "014513",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "{立绘0000}「‥呪砲弾、装てん！",
  "tgt": "{立绘0000}「…咒炮弹，装填！"
 },
 {
  "id": "014514",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "{立绘8040}「撃てっ！！",
  "tgt": "{立绘8040}「开炮！！"
 },
 {
  "id": "014515",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「こないだは、突然\n呪砲が ぶっぱなされたし‥\n---\n今度は、難民が\nやって来るし‥\n---\nどうなっちまったんだ\nこの国は‥",
  "tgt": "「前几天咒炮\n突然被发射了一通‥\n---\n这回难民又\n涌过来了‥\n---\n这国家到底\n怎么了‥"
 },
 {
  "id": "014516",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「あんた達も、都から\n逃げてきたの‥？\n---\n何が起きてるの？",
  "tgt": "「你们也是从帝都\n逃出来的‥？\n---\n那边出什么事了？"
 },
 {
  "id": "014517",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「都に、魔物が\n現れたって\n本当かい‥？",
  "tgt": "「魔物出现在\n帝都的传闻\n是真的吗‥？"
 },
 {
  "id": "014518",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「怖かったよーっ‥",
  "tgt": "「吓死我了——‥"
 },
 {
  "id": "014519",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「都に、魔物が現れて‥\n---\n何がなんだか\n分からなくなって\n逃げて来たんです‥",
  "tgt": "「魔物出现在帝都‥\n---\n我们稀里糊涂\n搞不清状况\n就逃到这儿来了‥"
 },
 {
  "id": "014520",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「帝都の手前で\n軍の守備隊が\nがんばってる らしいね‥\n---\nでも、都を滅ぼすような\n魔物に 勝てるのかな‥",
  "tgt": "「听说军队守备队\n在帝都前方\n拼命抵挡着‥\n---\n可打得赢那种\n能灭掉帝都的魔物吗‥"
 },
 {
  "id": "014521",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「この大砲、ちょっと前に\nヅドンと いっぱつ\nぶちかましたんだ‥！\n---\nかっちょ良かったぜ！",
  "tgt": "「这门大炮前不久\n轰隆一声\n开了张‥！\n---\n帅呆了！"
 },
 {
  "id": "014522",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「あれー‥、あんた\nどっかで 会わなかったっけ？\n---\n‥{码0B}‥{码0B}‥いや、気のせいだよね。\n---\nここは、軍の建物だから‥\nかわい子ちゃんが いるワケ\nないもんねー。",
  "tgt": "「哎呀～，你是不是\n在哪儿见过呀？\n---\n‥‥‥不，是我看错了。\n---\n这里可是军队的建筑‥\n怎么可能有小美人\n待在这儿嘛——。{码0B}‥{码0B}‥いや、気のせいだよね。\n---\nここは、軍の建物だから‥\nかわい子ちゃんが いるワケ\nないもんねー。"
 },
 {
  "id": "014523",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「ここって、時々\n何だか分からない\n人達が 来るんだよ‥\n---\nま、オレ達 したっぱには\n関係ない‥\n軍事機密って ヤツだね。",
  "tgt": "「这里时不时会来些\n莫名其妙搞不清\n来路的人‥\n---\n嘛，跟我们这些\n小兵没关系‥\n这就是所谓的军事机密吧。"
 },
 {
  "id": "014524",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「この間、呪砲が\n発射されたんだ‥\n---\n休戦中だってのに\nどこを 呪撃したんだろう‥",
  "tgt": "「不久前咒炮\n发射过了‥\n---\n明明是停战期\n咒击了哪里呢‥"
 },
 {
  "id": "014525",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「帝都の魔物‥\n怖いよなー‥\n---\n調べに行けって\n命令されたら、オレ\n逃げちゃうね。",
  "tgt": "「帝都的魔物‥\n真吓人呀——‥\n---\n要是命令我去调查\n我肯定\n撒腿就跑。"
 },
 {
  "id": "014526",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "{立绘4400}「こちらに、ルーン將軍が\nいらっしゃると\n闻いたが‥？",
  "tgt": "{立绘4400}「听说卢恩将军\n在这里…？"
 },
 {
  "id": "014527",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "{立绘8141}「はっ。\n將軍に ご用でしたら\n隊長どの‥",
  "tgt": "{立绘8141}「是。\n找将军有事的话\n请找队长‥"
 },
 {
  "id": "014528",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "{框06}{立绘8141}「ここを 抜けて‥\nおかの上の建物に\nいらして下さい。",
  "tgt": "{框06}{立绘8141}「请穿过这里‥\n到丘上的\n建筑去吧。"
 },
 {
  "id": "014529",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "{框06}{立绘8242}「おい、どうするんだ？",
  "tgt": "{框06}{立绘8242}「喂，怎么办？"
 },
 {
  "id": "014530",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "{框06}{立绘8242}「おとなしく、ついて行って‥\n---\n{队员00}を やつらに\nひき渡すのか‥？",
  "tgt": "{框06}{立绘8242}「乖乖跟他们走…\n---\n把{队员00}交到\n他们手里吗…？"
 },
 {
  "id": "014531",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "{框05}{立绘0303}「最初から、私は\nそのつもりだと\n言っている‥",
  "tgt": "{框05}{立绘0303}「我说了\n我一开始\n就是这么打算的‥"
 },
 {
  "id": "014532",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "{立绘4100}「どちらにしても、兄さま‥\n---\n帝都の様子が 分からないと\nもう一人の、{队员00}‥\n---\n初代皇帝の事も\n分かりません‥",
  "tgt": "{立绘4100}「无论如何，兄长…\n---\n不了解帝都的情况\n另一个{队员00}…\n---\n和初代皇帝\n的事也无从知晓…"
 },
 {
  "id": "014533",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "{立绘0404}「それに‥\n彼らが、{队员00}を\n手に入れたからと言って‥\n---\n{立绘4100}どうにか できるって\nものじゃ、ないって事‥\n---\n{队员04}さんも\n気づいてると 思います。",
  "tgt": "{立绘0404}「况且…\n就算他们\n得到了{队员00}…\n---\n{立绘4100}也不是\n想怎样就能怎样…\n---\n{队员04}先生\n应该也明白。"
 },
 {
  "id": "014534",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "{立绘4100}「それに、兄さま\nこう思いません‥？\n---\n{立绘0504}{队员00}がいるから\nわたし達‥\nだいじょうぶだ、って？",
  "tgt": "{立绘4100}「还有，兄长\n你不觉得吗…？\n---\n{立绘0504}只要有{队员00}\n我们就\n没事了，这样？"
 },
 {
  "id": "014535",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「ルーン將軍は\nここを抜けた先に\nいらっしゃいます。",
  "tgt": "「卢恩将军\n就在穿过这里的\n前方。"
 },
 {
  "id": "014536",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「んー‥\nさっきの 翼の生えた子‥\n---\nどこかで 見たような‥‥",
  "tgt": "「嗯～‥\n刚才那个长翅膀的孩子‥\n---\n好像在哪儿见过‥‥"
 },
 {
  "id": "014537",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「あれ‥、君さ‥\nおかの上の建物に\nいなかったっけ？",
  "tgt": "「诶‥，你是不是‥\n在丘上的建筑\n出现过？"
 },
 {
  "id": "014538",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「はあ、ユンナ‥様ですか？\n---\n帝都から お戻りに\nなるはず なんですが‥\n---\nこのさわぎで、どこかに\n足止めされて いるのかも‥",
  "tgt": "「啊，尤娜‥大人吗？\n---\n她本应从帝都\n回来‥\n---\n这么闹腾，说不定在\n哪儿被绊住了‥"
 },
 {
  "id": "014539",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「ユンナ様って、何か\nブキミなんだよな‥\n---\n呪いの事とか\nいろいろ やってるし‥",
  "tgt": "「尤娜大人总觉得\n阴森森的‥\n---\n又是研究诅咒\n又是搞各种名堂‥"
 },
 {
  "id": "014540",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「ユンナ様は、どこかって？\n---\nうーん‥\n帝都と、この町の間の\nどこかじゃ ないかな。",
  "tgt": "「尤娜大人在哪？\n---\n嗯～‥\n大概在帝都和\n这镇子之间的某处吧。"
 },
 {
  "id": "014541",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「ユンナって、あの\n気味悪い人だろ‥\n---\n軍の、エライさんの‥",
  "tgt": "「尤娜？就是那个\n瘆人的家伙吧‥\n---\n军队里的大人物‥"
 },
 {
  "id": "014542",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「闻きました‥？\n---\nなんでも、残った兵力を\nかき集めて‥\n---\n帝都に 攻めのぼるって\n話ですね。",
  "tgt": "「听说了吗‥？\n---\n据说要把残余兵力\n集结起来‥\n---\n要攻打帝都\n是这么说的。"
 },
 {
  "id": "014543",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「將軍様のひとりが\n兵力を 集めて‥\n---\n帝都へ 向かわれたとか‥",
  "tgt": "「听说一位将军大人\n正在集结兵力‥\n---\n朝帝都进发‥"
 },
 {
  "id": "014544",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「都の魔物も‥\n---\n呪砲で、ヅドンと\nやったら いいのにね。",
  "tgt": "「帝都的魔物‥\n---\n用咒炮轰隆\n轰掉不就好了嘛。"
 },
 {
  "id": "014545",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「大変だね、兵隊さんは‥\n---\n今度は 帝都で\n魔物と 戦だよ‥",
  "tgt": "「当兵的真辛苦呀‥\n---\n这回又要去帝都\n和魔物打仗了‥"
 },
 {
  "id": "014546",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "{立绘0605}「ごめんなぁ、来たばかりで\n荷物の整理も\nできてないんや‥\n---\n出てるモンだけでも\n見てってや。{码14850C93}トレードしよう\nけいひんをこうかんしよう\nやめておこう",
  "tgt": "{立绘0605}「对不住呀，我才刚来\n货都还没\n整理好呢‥\n---\n就看看摆出来的\n这些吧。来交易吧\n交换纪念品\n还是算了吧{码14850C93}トレードしよう\nけいひんをこうかんしよう\nやめておこう"
 },
 {
  "id": "014547",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "{金钱00}「おや、兵隊さん以外の\nお客なんて めずらしいね‥\n---\n泊ってくなら\n{占位00}ゼニーだよ。{码14860C93}泊って行く\n旅の記錄だけする\nやめておく",
  "tgt": "{金钱00}「哟，除了当兵的\n还会来客人，稀奇…\n---\n要住的话\n{占位00}泽尼。{码14860C93}住一晚\n只记录旅程\n算了"
 },
 {
  "id": "014548",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「あんた、お金\n持ってないでしょ‥",
  "tgt": "「你身上\n没带钱吧‥"
 },
 {
  "id": "014549",
  "file": "WORLD/AREAS021.EMI",
  "seg": 8,
  "src": "「南の、ダンの関にも‥\n---\n難民が いっぱい\nやって来てるって\n話だね‥",
  "tgt": "「听说南边的丹之关‥\n---\n也涌来了好多\n好多难民\n听说是这样‥"
 },
 {
  "id": "014550",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「たいほーのまちあすたな」",
  "tgt": "「大炮之镇阿斯塔纳」"
 },
 {
  "id": "014551",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「フォウ帝国軍 御用達の\n武器ばかりだよ‥{码14840C94}何か買おう\n持ち物を売ろう\n武器を下取りしてもらおう\n今は用がない‥",
  "tgt": "「全是福乌帝国军队\n专用的武器‥要买点什么\n卖掉随身物品\n以旧换新武器\n现在不需要‥{码14840C94}何か買おう\n持ち物を売ろう\n武器を下取りしてもらおう\n今は用がない‥"
 },
 {
  "id": "014552",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「軍の人間ではないようだが‥\n何か ご入用かな？{码14850C93}何か買おう\n持ち物を売ろう\n今は用がない‥",
  "tgt": "「看来不是军中之人‥\n有何贵干吗？要买点什么\n卖掉随身物品\n现在不需要‥{码14850C93}何か買おう\n持ち物を売ろう\n今は用がない‥"
 },
 {
  "id": "014553",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「え、人探し‥？\n---\nでも ここは\n軍の建物だから‥\n---\nあんたらが 探してるような\n人は いないと\n思うなー‥",
  "tgt": "「诶，找人‥？\n---\n不过这里可是\n军队的建筑‥\n---\n你们要找的那种人\n这里可没有\n哦——‥"
 },
 {
  "id": "014554",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「どうだい、この大砲‥\n呪砲って 言うんだ。\n---\n戦爭のときは、こいつで\n敵の町を ヅドンと\n呪ってたんだって！",
  "tgt": "「怎么样，这门大炮‥\n它叫咒炮。\n---\n打仗的时候，就是用它\n轰隆一声把敌人的城镇\n咒个稀烂的！"
 },
 {
  "id": "014555",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「ここは、アスタナ‥\n呪砲の町だ。\n---\n呪砲は、重要な兵器なので\nこの町には、兵が\nたくさんいるのだ。",
  "tgt": "「这里是阿斯塔纳‥\n咒炮之镇。\n---\n咒炮是重要兵器\n所以镇上驻扎着\n大量士兵。"
 },
 {
  "id": "014556",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「わたしの彼、ハシビトなの\n早く归ってこないかな‥",
  "tgt": "「我男朋友是桥守\n怎么还不回来呀‥"
 },
 {
  "id": "014557",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「何だか、見かけない\n連中だな‥\n---\nま、帝国は 大きいから‥\n中には ヘンな奴も\nいるよな。",
  "tgt": "「总觉得是些\n眼生的家伙‥\n---\n嘛，帝国这么大‥\n里面有些怪人\n也不稀奇。"
 },
 {
  "id": "014558",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「近所に、{色02}水道橋{/色}って\n橋があってね‥\n---\nこの町の水は、その橋で\n運んできてるんだ。",
  "tgt": "「附近有座桥\n叫{色02}水道桥{/色}…\n---\n这个镇的水\n就是靠那座桥运来的。"
 },
 {
  "id": "014559",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「うん‥？\nあんたら、人探しかい‥\n---\nそうだね‥、何せ\n軍の建物は、人の出入りが\nはげしいからねぇ‥",
  "tgt": "「嗯‥？\n你们在找人吗‥\n---\n也是‥毕竟\n军队的建筑\n人来人往很频繁嘛‥"
 },
 {
  "id": "014560",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「呪砲を使うには\n水が いっぱい\nいるらしくって‥\n---\nこの、軍の建物には\n水道橋が つながってるんだ。",
  "tgt": "「听说用咒炮\n得用掉好多\n好多水‥\n---\n所以这座军队建筑\n连通着水道桥。"
 },
 {
  "id": "014561",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「足りないよ‥ゼニー。",
  "tgt": "「钱不够哟‥。"
 },
 {
  "id": "014562",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「カネが 足りんようだが‥",
  "tgt": "「你的钱似乎不够‥"
 },
 {
  "id": "014563",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「おカネが ないんじゃ\n泊められないねぇ‥",
  "tgt": "「没钱的话\n可留宿不了呀‥"
 },
 {
  "id": "014564",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "{立绘0000}「‥呪砲弾、装てん！",
  "tgt": "{立绘0000}「…咒炮弹，装填！"
 },
 {
  "id": "014565",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "{立绘8040}「撃てっ！！",
  "tgt": "{立绘8040}「开炮！！"
 },
 {
  "id": "014566",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「こないだは、突然\n呪砲が ぶっぱなされたし‥\n---\n今度は、難民が\nやって来るし‥\n---\nどうなっちまったんだ\nこの国は‥",
  "tgt": "「前几天咒炮\n突然被发射了一通‥\n---\n这回难民又\n涌过来了‥\n---\n这国家到底\n怎么了‥"
 },
 {
  "id": "014567",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「あんた達も、都から\n逃げてきたの‥？\n---\n何が起きてるの？",
  "tgt": "「你们也是从帝都\n逃出来的‥？\n---\n那边出什么事了？"
 },
 {
  "id": "014568",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「都に、魔物が\n現れたって\n本当かい‥？",
  "tgt": "「魔物出现在\n帝都的传闻\n是真的吗‥？"
 },
 {
  "id": "014569",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「怖かったよーっ‥",
  "tgt": "「吓死我了——‥"
 },
 {
  "id": "014570",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「都に、魔物が現れて‥\n---\n何がなんだか\n分からなくなって\n逃げて来たんです‥",
  "tgt": "「魔物出现在帝都‥\n---\n我们稀里糊涂\n搞不清状况\n就逃到这儿来了‥"
 },
 {
  "id": "014571",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「帝都の手前で\n軍の守備隊が\nがんばってる らしいね‥\n---\nでも、都を滅ぼすような\n魔物に 勝てるのかな‥",
  "tgt": "「听说军队守备队\n在帝都前方\n拼命抵挡着‥\n---\n可打得赢那种\n能灭掉帝都的魔物吗‥"
 },
 {
  "id": "014572",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「この大砲、ちょっと前に\nヅドンと いっぱつ\nぶちかましたんだ‥！\n---\nかっちょ良かったぜ！",
  "tgt": "「这门大炮前不久\n轰隆一声\n开了张‥！\n---\n帅呆了！"
 },
 {
  "id": "014573",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「あれー‥、あんた\nどっかで 会わなかったっけ？\n---\n‥{码0B}‥{码0B}‥いや、気のせいだよね。\n---\nここは、軍の建物だから‥\nかわい子ちゃんが いるワケ\nないもんねー。",
  "tgt": "「哎呀～，你是不是\n在哪儿见过呀？\n---\n‥‥‥不，是我看错了。\n---\n这里可是军队的建筑‥\n怎么可能有小美人\n待在这儿嘛——。{码0B}‥{码0B}‥いや、気のせいだよね。\n---\nここは、軍の建物だから‥\nかわい子ちゃんが いるワケ\nないもんねー。"
 },
 {
  "id": "014574",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「ここって、時々\n何だか分からない\n人達が 来るんだよ‥\n---\nま、オレ達 したっぱには\n関係ない‥\n軍事機密って ヤツだね。",
  "tgt": "「这里时不时会来些\n莫名其妙搞不清\n来路的人‥\n---\n嘛，跟我们这些\n小兵没关系‥\n这就是所谓的军事机密吧。"
 },
 {
  "id": "014575",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「この間、呪砲が\n発射されたんだ‥\n---\n休戦中だってのに\nどこを 呪撃したんだろう‥",
  "tgt": "「不久前咒炮\n发射过了‥\n---\n明明是停战期\n咒击了哪里呢‥"
 },
 {
  "id": "014576",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「帝都の魔物‥\n怖いよなー‥\n---\n調べに行けって\n命令されたら、オレ\n逃げちゃうね。",
  "tgt": "「帝都的魔物‥\n真吓人呀——‥\n---\n要是命令我去调查\n我肯定\n撒腿就跑。"
 },
 {
  "id": "014577",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "{立绘4400}「こちらに、ルーン將軍が\nいらっしゃると\n闻いたが‥？",
  "tgt": "{立绘4400}「听说卢恩将军\n在这里…？"
 },
 {
  "id": "014578",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "{立绘8141}「はっ。\n將軍に ご用でしたら\n隊長どの‥",
  "tgt": "{立绘8141}「是。\n找将军有事的话\n请找队长‥"
 },
 {
  "id": "014579",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "{框06}{立绘8141}「ここを 抜けて‥\nおかの上の建物に\nいらして下さい。",
  "tgt": "{框06}{立绘8141}「请穿过这里‥\n到丘上的\n建筑去吧。"
 },
 {
  "id": "014580",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "{框06}{立绘8242}「おい、どうするんだ？",
  "tgt": "{框06}{立绘8242}「喂，怎么办？"
 },
 {
  "id": "014581",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "{框06}{立绘8242}「おとなしく、ついて行って‥\n---\n{队员00}を やつらに\nひき渡すのか‥？",
  "tgt": "{框06}{立绘8242}「乖乖跟他们走…\n---\n把{队员00}交到\n他们手里吗…？"
 },
 {
  "id": "014582",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "{框05}{立绘0303}「最初から、私は\nそのつもりだと\n言っている‥",
  "tgt": "{框05}{立绘0303}「我说了\n我一开始\n就是这么打算的‥"
 },
 {
  "id": "014583",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "{立绘4100}「どちらにしても、兄さま‥\n---\n帝都の様子が 分からないと\nもう一人の、{队员00}‥\n---\n初代皇帝の事も\n分かりません‥",
  "tgt": "{立绘4100}「无论如何，兄长…\n---\n不了解帝都的情况\n另一个{队员00}…\n---\n和初代皇帝\n的事也无从知晓…"
 },
 {
  "id": "014584",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "{立绘0404}「それに‥\n彼らが、{队员00}を\n手に入れたからと言って‥\n---\n{立绘4100}どうにか できるって\nものじゃ、ないって事‥\n---\n{队员04}さんも\n気づいてると 思います。",
  "tgt": "{立绘0404}「况且…\n就算他们\n得到了{队员00}…\n---\n{立绘4100}也不是\n想怎样就能怎样…\n---\n{队员04}先生\n应该也明白。"
 },
 {
  "id": "014585",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "{立绘4100}「それに、兄さま\nこう思いません‥？\n---\n{立绘0504}{队员00}がいるから\nわたし達‥\nだいじょうぶだ、って？",
  "tgt": "{立绘4100}「还有，兄长\n你不觉得吗…？\n---\n{立绘0504}只要有{队员00}\n我们就\n没事了，这样？"
 },
 {
  "id": "014586",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「ルーン將軍は\nここを抜けた先に\nいらっしゃいます。",
  "tgt": "「卢恩将军\n就在穿过这里的\n前方。"
 },
 {
  "id": "014587",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「んー‥\nさっきの 翼の生えた子‥\n---\nどこかで 見たような‥‥",
  "tgt": "「嗯～‥\n刚才那个长翅膀的孩子‥\n---\n好像在哪儿见过‥‥"
 },
 {
  "id": "014588",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「あれ‥、君さ‥\nおかの上の建物に\nいなかったっけ？",
  "tgt": "「诶‥，你是不是‥\n在丘上的建筑\n出现过？"
 },
 {
  "id": "014589",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「はあ、ユンナ‥様ですか？\n---\n帝都から お戻りに\nなるはず なんですが‥\n---\nこのさわぎで、どこかに\n足止めされて いるのかも‥",
  "tgt": "「啊，尤娜‥大人吗？\n---\n她本应从帝都\n回来‥\n---\n这么闹腾，说不定在\n哪儿被绊住了‥"
 },
 {
  "id": "014590",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「ユンナ様って、何か\nブキミなんだよな‥\n---\n呪いの事とか\nいろいろ やってるし‥",
  "tgt": "「尤娜大人总觉得\n阴森森的‥\n---\n又是研究诅咒\n又是搞各种名堂‥"
 },
 {
  "id": "014591",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「ユンナ様は、どこかって？\n---\nうーん‥\n帝都と、この町の間の\nどこかじゃ ないかな。",
  "tgt": "「尤娜大人在哪？\n---\n嗯～‥\n大概在帝都和\n这镇子之间的某处吧。"
 },
 {
  "id": "014592",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「ユンナって、あの\n気味悪い人だろ‥\n---\n軍の、エライさんの‥",
  "tgt": "「尤娜？就是那个\n瘆人的家伙吧‥\n---\n军队里的大人物‥"
 },
 {
  "id": "014593",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「闻きました‥？\n---\nなんでも、残った兵力を\nかき集めて‥\n---\n帝都に 攻めのぼるって\n話ですね。",
  "tgt": "「听说了吗‥？\n---\n据说要把残余兵力\n集结起来‥\n---\n要攻打帝都\n是这么说的。"
 },
 {
  "id": "014594",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「將軍様のひとりが\n兵力を 集めて‥\n---\n帝都へ 向かわれたとか‥",
  "tgt": "「听说一位将军大人\n正在集结兵力‥\n---\n朝帝都进发‥"
 },
 {
  "id": "014595",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「都の魔物も‥\n---\n呪砲で、ヅドンと\nやったら いいのにね。",
  "tgt": "「帝都的魔物‥\n---\n用咒炮轰隆\n轰掉不就好了嘛。"
 },
 {
  "id": "014596",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「大変だね、兵隊さんは‥\n---\n今度は 帝都で\n魔物と 戦だよ‥",
  "tgt": "「当兵的真辛苦呀‥\n---\n这回又要去帝都\n和魔物打仗了‥"
 },
 {
  "id": "014597",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "{立绘0605}「ごめんなぁ、来たばかりで\n荷物の整理も\nできてないんや‥\n---\n出てるモンだけでも\n見てってや。{码14850C93}トレードしよう\nけいひんをこうかんしよう\nやめておこう",
  "tgt": "{立绘0605}「对不住呀，我才刚来\n货都还没\n整理好呢‥\n---\n就看看摆出来的\n这些吧。来交易吧\n交换纪念品\n还是算了吧{码14850C93}トレードしよう\nけいひんをこうかんしよう\nやめておこう"
 },
 {
  "id": "014598",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "{金钱00}「おや、兵隊さん以外の\nお客なんて めずらしいね‥\n---\n泊ってくなら\n{占位00}ゼニーだよ。{码14860C93}泊って行く\n旅の記錄だけする\nやめておく",
  "tgt": "{金钱00}「哟，除了当兵的\n还会来客人，稀奇…\n---\n要住的话\n{占位00}泽尼。{码14860C93}住一晚\n只记录旅程\n算了"
 },
 {
  "id": "014599",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「あんた、お金\n持ってないでしょ‥",
  "tgt": "「你身上\n没带钱吧‥"
 },
 {
  "id": "014600",
  "file": "WORLD/AREAS022.EMI",
  "seg": 8,
  "src": "「南の、ダンの関にも‥\n---\n難民が いっぱい\nやって来てるって\n話だね‥",
  "tgt": "「听说南边的丹之关‥\n---\n也涌来了好多\n好多难民\n听说是这样‥"
 },
 {
  "id": "014601",
  "file": "WORLD/AREAS023.EMI",
  "seg": 11,
  "src": "たいほうのなか",
  "tgt": "大炮内部"
 },
 {
  "id": "014602",
  "file": "WORLD/AREAS023.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「や、ニエの用意は\nよろしいですか‥？",
  "tgt": "{框04}{立绘8040}「呀，祭品\n准备好了吗‥？"
 },
 {
  "id": "014603",
  "file": "WORLD/AREAS023.EMI",
  "seg": 11,
  "src": "{框03}「へえ、ユンナ様‥\nいつでも いけます。",
  "tgt": "{框03}「是，尤娜大人‥\n随时可以。"
 },
 {
  "id": "014604",
  "file": "WORLD/AREAS023.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「よろしい。",
  "tgt": "{框04}{立绘8040}「很好。"
 },
 {
  "id": "014605",
  "file": "WORLD/AREAS023.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「いつでも 発射できますよ\nヨム將軍‥",
  "tgt": "{框04}{立绘8040}「随时都能发射哟\n约姆将军‥"
 },
 {
  "id": "014606",
  "file": "WORLD/AREAS023.EMI",
  "seg": 11,
  "src": "{框03}{立绘8141}「よし‥、呪砲発射用意！\n---\n呪撃目標は‥‥",
  "tgt": "{框03}{立绘8141}「好‥，咒炮发射准备！\n---\n咒击目标是‥‥"
 },
 {
  "id": "014607",
  "file": "WORLD/AREAS023.EMI",
  "seg": 11,
  "src": "{框04}{立绘8141}「大陸南部、ソマの森！",
  "tgt": "{框04}{立绘8141}「大陆南部，索马之森！"
 },
 {
  "id": "014608",
  "file": "WORLD/AREAS023.EMI",
  "seg": 11,
  "src": "「ここ、{码0B}ニエを 呪いの弾に\n変える場所なんだ‥\n---\nなんだか、うすっ気味悪いよね。",
  "tgt": "「这里，是把祭品变成\n诅咒之弹的地方‥\n---\n总让人觉得瘆得慌呢。{码0B}ニエを 呪いの弾に\n変える場所なんだ‥\n---\nなんだか、うすっ気味悪いよね。"
 },
 {
  "id": "014609",
  "file": "WORLD/AREAS023.EMI",
  "seg": 11,
  "src": "「呪砲はっしゃー、{码0B}ぼーん！\n---\nなんてね‥",
  "tgt": "「咒炮发射——，轰！\n---\n开玩笑啦‥{码0B}ぼーん！\n---\nなんてね‥"
 },
 {
  "id": "014610",
  "file": "WORLD/AREAS024.EMI",
  "seg": 11,
  "src": "たいほうのなか",
  "tgt": "大炮内部"
 },
 {
  "id": "014611",
  "file": "WORLD/AREAS024.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「や、ニエの用意は\nよろしいですか‥？",
  "tgt": "{框04}{立绘8040}「呀，祭品\n准备好了吗‥？"
 },
 {
  "id": "014612",
  "file": "WORLD/AREAS024.EMI",
  "seg": 11,
  "src": "{框03}「へえ、ユンナ様‥\nいつでも いけます。",
  "tgt": "{框03}「是，尤娜大人‥\n随时可以。"
 },
 {
  "id": "014613",
  "file": "WORLD/AREAS024.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「よろしい。",
  "tgt": "{框04}{立绘8040}「很好。"
 },
 {
  "id": "014614",
  "file": "WORLD/AREAS024.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「いつでも 発射できますよ\nヨム將軍‥",
  "tgt": "{框04}{立绘8040}「随时都能发射哟\n约姆将军‥"
 },
 {
  "id": "014615",
  "file": "WORLD/AREAS024.EMI",
  "seg": 11,
  "src": "{框03}{立绘8141}「よし‥、呪砲発射用意！\n---\n呪撃目標は‥‥",
  "tgt": "{框03}{立绘8141}「好‥，咒炮发射准备！\n---\n咒击目标是‥‥"
 },
 {
  "id": "014616",
  "file": "WORLD/AREAS024.EMI",
  "seg": 11,
  "src": "{框04}{立绘8141}「大陸南部、ソマの森！",
  "tgt": "{框04}{立绘8141}「大陆南部，索马之森！"
 },
 {
  "id": "014617",
  "file": "WORLD/AREAS024.EMI",
  "seg": 11,
  "src": "「ここ、{码0B}ニエを 呪いの弾に\n変える場所なんだ‥\n---\nなんだか、うすっ気味悪いよね。",
  "tgt": "「这里，是把祭品变成\n诅咒之弹的地方‥\n---\n总让人觉得瘆得慌呢。{码0B}ニエを 呪いの弾に\n変える場所なんだ‥\n---\nなんだか、うすっ気味悪いよね。"
 },
 {
  "id": "014618",
  "file": "WORLD/AREAS024.EMI",
  "seg": 11,
  "src": "「呪砲はっしゃー、{码0B}ぼーん！\n---\nなんてね‥",
  "tgt": "「咒炮发射——，轰！\n---\n开玩笑啦‥{码0B}ぼーん！\n---\nなんてね‥"
 },
 {
  "id": "014619",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}みなとまちしゅーく",
  "tgt": "{立绘0000}港镇修克"
 },
 {
  "id": "014620",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「おや、港町シュークへ\nようこそ‥\n---\nここは、世界でもめずらしい\n泥じゃない海に\n面した町ですよ。",
  "tgt": "「哟，欢迎来到\n港镇休克‥\n---\n这里是世上少有的\n面朝非泥之海的\n城镇哟。"
 },
 {
  "id": "014621",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「オレのとーちゃんは\n海の男なんだぞ‥\n---\nここで、とーちゃんの\n船を 待ってるんだ。",
  "tgt": "「我爸可是\n大海男儿哟‥\n---\n我在这儿\n等爸爸的船回来。"
 },
 {
  "id": "014622",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「ん‥\nその船が、誰のかって？\n---\n持ち主は、酒場にでも\nいるだろうよ。",
  "tgt": "「嗯‥\n问那船是谁的？\n---\n船主大概\n在酒馆里吧。"
 },
 {
  "id": "014623",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「関所が、しまってて‥\nシュークに 入るのが\nムズかしいって 話だけど‥\n---\n出るのは だいじょうぶかな‥",
  "tgt": "「听说关所关闭了‥\n很难进到\n休克来‥\n---\n出去倒没问题吧‥"
 },
 {
  "id": "014624",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「泥の海は、つり\nできないだろ‥\n---\nここは、できるんだぜ！",
  "tgt": "「泥之海没法\n钓鱼吧‥\n---\n这儿可是能钓的！"
 },
 {
  "id": "014625",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「この海‥\nずっと西の方にまで\nつづいてるんだって‥",
  "tgt": "「这片海‥\n听说一直延伸到\n遥远的西边呢‥"
 },
 {
  "id": "014626",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0101}{码0A}",
  "tgt": "{立绘0101}{码0A}"
 },
 {
  "id": "014627",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「この町の 男どもは‥\n---\nほとんど 船に乘って\n出はらってるんだ‥",
  "tgt": "「这镇上的男人‥\n---\n几乎都上船\n出海去了‥"
 },
 {
  "id": "014628",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「ねー、よその国には\n砂の上を 走る船が\nあるって 本当？\n---\nこの町にあるのは\n海の上を 走る船だよ。",
  "tgt": "「呐，别的国家有\n在沙子上跑的船\n是真的吗？\n---\n这镇上有的\n是在海上跑的船哟。"
 },
 {
  "id": "014629",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「あーん！？\n---\nおれっちの船に 乘りたい？",
  "tgt": "{立绘0202}「啊——嗯！？\n---\n想坐我的船？"
 },
 {
  "id": "014630",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}「船に、乘りたいー？\n---\nだったらー、ジグ兄ちゃんと\n話してみてよ‥",
  "tgt": "{立绘0000}「想坐船——？\n---\n那就去和\n吉格老大聊聊吧……"
 },
 {
  "id": "014631",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0003}「港に とまってる船？\n---\nああ、オレたち兄弟の\n船だぜ‥！\nカッコいいだろ？",
  "tgt": "{立绘0003}「港里停的那艘船？\n---\n啊，那是我们\n兄弟俩的船……！\n很帅气吧？"
 },
 {
  "id": "014632",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「んん‥\n船を 探してるのか‥\n---\nだったら、あそこの\n男たちに 話してみなされ‥",
  "tgt": "「嗯嗯‥\n在找船呀‥\n---\n那去跟那边的\n男人们谈谈吧‥"
 },
 {
  "id": "014633",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「はいはい、いらっしゃい。\n---\n{金钱00}{占位00}ゼニー ですけど‥\nお休みになりますか？{码14860C93}休んで行く\n旅の記錄だけする\n今は、やめておく",
  "tgt": "「好好，欢迎光临。\n---\n{金钱00}{占位00}泽尼……\n要住下休息吗？{码14860C93}住下再走\n只记录旅程\n这次先不了"
 },
 {
  "id": "014634",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「おや‥、お金が\n足りないみたいだよ。",
  "tgt": "「哎呀‥，钱\n好像不够哟。"
 },
 {
  "id": "014635",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「はるばる海を 渡ってきた\nめずらしい物が、あるよ‥！{码14840C94}買物をしよう\n何か売ろう\n武器を下取りしてもらおう\n今は、やめておく",
  "tgt": "「有远渡重洋而来的\n稀罕玩意哟‥！买点什么吧\n卖点什么吧\n武器折价换购\n现在，还是算了{码14840C94}買物をしよう\n何か売ろう\n武器を下取りしてもらおう\n今は、やめておく"
 },
 {
  "id": "014636",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「おいおい\nどこの誰とも 分からない\n連中を 乘せるほど‥\n---\n安い船じゃ、ねぇぜ‥？",
  "tgt": "{立绘0202}「喂喂\n我的船可没便宜到\n搭载来历不明的人‥\n---\n不是吗‥？"
 },
 {
  "id": "014637",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「それに‥、だ‥\n---\n{色02}水神さま{/色}の お許しも\nないヤツが‥\n---\n海に出ちゃ、いけねぇ‥\nさ、归った 归った！",
  "tgt": "{立绘0202}「而且……听好了……\n---\n没得到\n{色02}水神大人{/色}许可的家伙……\n---\n不许出海……\n快回去，快回去！"
 },
 {
  "id": "014638",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「おれたち、船乘りは\nみんな‥\n---\n{色02}水神さま{/色}の お許しを\nもらって 海に出てるんだ‥\n---\n許しが ないやつを\n船に 乘せるワケにゃ\nいかないね。",
  "tgt": "{立绘0202}「我们这些船员\n人人都是……\n---\n得到{色02}水神大人{/色}的\n许可才出海的……\n---\n没许可的家伙\n可不能\n让他上船。"
 },
 {
  "id": "014639",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「ん、水神さま‥？\n---\nそっちの道が\n{色02}水神のほこら{/色}に\n通じてるけどね。",
  "tgt": "「嗯，水神大人……？\n---\n那条路\n通往\n{色02}水神祠{/色}。"
 },
 {
  "id": "014640",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「んん‥！？\n---\n水神さまの、ほこらに\n参って来たって？",
  "tgt": "{立绘0202}「嗯嗯‥！？\n---\n你说是去参拜过\n水神大人的祠堂？"
 },
 {
  "id": "014641",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「おおっ、こりゃ\n{色03}{道具1205}{/色} じゃねぇか！\n---\nこれを 持ってるって事は‥\n水神さまが、お出ましに\nなったって事か！？",
  "tgt": "{立绘0202}「哦哦，这不是\n{色03}{道具1205}{/色}吗！\n---\n带着这个，就是说‥\n水神大人\n现身了吗！？"
 },
 {
  "id": "014642",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「ふーん‥、こりゃ\n水神さまの おみちびきって\nヤツかな‥‥",
  "tgt": "{立绘0202}「哦～，看来这就是\n水神大人的\n指引吧‥‥"
 },
 {
  "id": "014643",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「よし、いいだろう‥\n船に 乘せてやるぜ‥！",
  "tgt": "{立绘0202}「好，行呀‥\n就让你们上船‥！"
 },
 {
  "id": "014644",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「お、{码0B}おい‥ ちょっと待て。\n---\nひょっとして、この\nおねえちゃん達も\n船に 乘る気か？",
  "tgt": "{立绘0202}「喂，喂‥等等。\n---\n该不会，这几位\n小姐姐也\n想上船吧？{码0B}おい‥ ちょっと待て。\n---\nひょっとして、この\nおねえちゃん達も\n船に 乘る気か？"
 },
 {
  "id": "014645",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{框06}{立绘8344}「そのつもりだが‥\n何か、マズいのか‥？",
  "tgt": "{框06}{立绘8344}「是有这个打算‥\n有什么问题吗‥？"
 },
 {
  "id": "014646",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「ああ‥\n---\n女は、船に‥\n乘っけちゃ いけないんだ！",
  "tgt": "{立绘0202}「哎呀‥\n---\n女人是不许\n上船的！"
 },
 {
  "id": "014647",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「ムカシっから‥\nそういう決まりに\nなってるんだよ‥！",
  "tgt": "{立绘0202}「打很早以前‥\n就有这样的\n规矩了‥！"
 },
 {
  "id": "014648",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「まあ、{码0B}そういうワケで‥\n---\nあんた達は、ここで\n待ってもらうしか‥",
  "tgt": "{立绘0202}「嘛，就是这么回事‥\n---\n你们只好\n在这儿等着了‥{码0B}そういうワケで‥\n---\nあんた達は、ここで\n待ってもらうしか‥"
 },
 {
  "id": "014649",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘C140}「あの、あの‥\n何とか なりませんか？\n---\n{立绘8445}少しぐらい、大変でも‥\nわたし、平気です。",
  "tgt": "{立绘C140}「那个，那个‥\n能不能想想办法呢？\n---\n{立绘8445}就算苦一点‥\n我，也不在乎。"
 },
 {
  "id": "014650",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「だめ、だめ‥\n---\n大体、海ってのは\n男のモンなんだ‥！\n---\n船乘りは、根性がいるし‥\nうでっぷしだって‥",
  "tgt": "{立绘0202}「不行，不行‥\n---\n再说，大海就是\n男人的东西‥！\n---\n当船夫得有骨气‥\n还得有好身手‥"
 },
 {
  "id": "014651",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{框03}{立绘0506}「{特效}そのとおりっ{码0E}{/特效}{码03}",
  "tgt": "{框03}{立绘0506}「说得对{特效}そのとおりっ{码0E}{/特效}{码03}"
 },
 {
  "id": "014652",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{框05}{立绘0506}「ふっ、はあ〜〜っ！\nまた、会ったな‥‥\n---\n二度までも、お前たちに\nやぶれた後‥\n---\nふたたび 旅に出て‥\nここで、『海の男』の修行を\nしていたのだっ！",
  "tgt": "{框05}{立绘0506}「呼，哈啊——！\n又见面了‥‥\n---\n两度败给你们\n之后‥\n---\n我便再度踏上旅途‥\n在此修行\n『大海男儿』之道！"
 },
 {
  "id": "014653",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{框05}{立绘0506}「いいか‥\n船乘りは、男の中の男！\n---\n真の{色02}漢{/色}にしか\nつとまらぬ ものなり！\n---\n今から、お前たちを\nコテンパンにして‥\n---\nそれを 身をもって\n教えてくれるわ！",
  "tgt": "{框05}{立绘0506}「听好了……\n船员是男人中的男人！\n---\n唯真正的{色02}汉子{/色}\n方能胜任！\n---\n现在就把你们\n打得落花流水……\n---\n让你们\n亲身体会这句话！"
 },
 {
  "id": "014654",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「あんた達‥\nカーンの 知り合い‥？\n---\nちょっと前に、ここへ来て‥\n船で 働かして\nやってるんだけど‥",
  "tgt": "{立绘0202}「你们‥\n认识卡恩‥？\n---\n他不久前来这儿‥\n我让他在船上\n干活呢‥"
 },
 {
  "id": "014655",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{框06}{立绘C440}「‥おい。",
  "tgt": "{框06}{立绘C440}「‥喂。"
 },
 {
  "id": "014656",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{框06}{立绘C440}「さっき、うでっぷしが\nどうとか 言ってたが‥\n---\nあいつを 倒せば\nいいって事か？",
  "tgt": "{框06}{立绘C440}「刚才你说\n身手如何的‥\n---\n把那家伙打倒\n就行了吧？"
 },
 {
  "id": "014657",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「え‥、{码0B}うう‥、あ？",
  "tgt": "{立绘0202}「诶‥，呃‥，啊？{码0B}うう‥、あ？"
 },
 {
  "id": "014658",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{框03}{立绘0606}「べふっ",
  "tgt": "{框03}{立绘0606}「噗嘎"
 },
 {
  "id": "014659",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{框06}{立绘C440}「‥{码0B}‥{码0B}‥どうだ？",
  "tgt": "{框06}{立绘C440}「‥‥‥如何？{码0B}‥{码0B}‥どうだ？"
 },
 {
  "id": "014660",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「ど、{码0B}どうも こうも‥\n---\n大体‥、おれが言ってる\nうでっぷし ってのは‥\n---\nたとえば、あの‥\nマストの てっぺんで\n決闘するとか‥",
  "tgt": "{立绘0202}「怎，怎么个如何‥\n---\n再说了‥，我说的\n身手呀‥\n---\n比如说，那个‥\n爬到桅杆顶上\n决斗什么的‥{码0B}どうも こうも‥\n---\n大体‥、おれが言ってる\nうでっぷし ってのは‥\n---\nたとえば、あの‥\nマストの てっぺんで\n決闘するとか‥"
 },
 {
  "id": "014661",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘C140}「あ、はい‥\n---\nじゃ、わたし‥\nそれ、やります。",
  "tgt": "{立绘C140}「啊，好的‥\n---\n那，我‥\n来试试那个。"
 },
 {
  "id": "014662",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「あー‥{码0B}‥\n---\nあんた達が、強いってのは\nまぁ、分かったよ‥",
  "tgt": "{立绘0202}「啊——‥‥\n---\n你们很强这一点\n嘛，我算是明白了‥{码0B}‥\n---\nあんた達が、強いってのは\nまぁ、分かったよ‥"
 },
 {
  "id": "014663",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「でも、やっぱり‥\n---\n海の キビシさは\nこんなものじゃ‥",
  "tgt": "{立绘0202}「不过，毕竟‥\n---\n大海的严酷\n可不止这样‥"
 },
 {
  "id": "014664",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘8745}「そんな‥‥\n---\nだったら、他に何でも\nためして下さい‥\n---\nわたし達、平気ですから！",
  "tgt": "{立绘8745}「怎么会‥‥\n---\n那就随便出什么\n考验我们吧‥\n---\n我们，都不怕的！"
 },
 {
  "id": "014665",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「うーん‥‥\n---\nそうまで 言うんなら\nもう少し‥\n---\nキビシさを 教えて\nやっても いいけど‥",
  "tgt": "{立绘0202}「嗯——‥‥\n---\n既然都说到这份上\n就再让你们‥\n---\n尝尝更严酷的\n味道也行‥"
 },
 {
  "id": "014666",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「ただし！\n今度は、ハンパじゃないから‥\n---\nどうしても って言うのなら\n心のじゅんびを してから\n来るんだ‥",
  "tgt": "{立绘0202}「不过！\n这回可不是闹着玩的‥\n---\n真想上的话\n就做好心理准备\n再来吧‥"
 },
 {
  "id": "014667",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「じゃ、じゅんびができたら\n俺に 話しかけてくれ‥\n---\nま、やめといた方が\nいいと思うけどな‥",
  "tgt": "{立绘0202}「准备好了\n就来叫我一声‥\n---\n嘛，我还是觉得\n别逞强为好‥"
 },
 {
  "id": "014668",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「何だ‥、本当に\nやる気なのか‥？{码14000C82}はい\n後で",
  "tgt": "{立绘0202}「怎么……\n你当真\n想打吗……？{码14000C82}是\n等会再说"
 },
 {
  "id": "014669",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「ま、やめておいた方が\n身のためだぜ‥",
  "tgt": "{立绘0202}「嘛，还是算了吧\n这才是为你们好‥"
 },
 {
  "id": "014670",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}「ツネキチ〜〜！\n女の子に、やられたからって\nイジけて ないで‥\n---\n早く あがってきなよー。",
  "tgt": "{立绘0000}「常吉～～！\n别因为输给了\n小姑娘就\n垂头丧气的……\n---\n快上来吧——。"
 },
 {
  "id": "014671",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「わたしは‥\n---\n苦勞してまで、船に\n乘ろうなんて\n思いませんけどね。",
  "tgt": "「我嘛‥\n---\n可不觉得\n值得吃那么多苦\n去上船呢。"
 },
 {
  "id": "014672",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「オレは、大きくなったら\n海の男に なるんだぞ！",
  "tgt": "「我长大了\n也要当大海男儿！"
 },
 {
  "id": "014673",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「んー、女が船に\n乘れない理由？\n---\nさて、どうしてかね‥\nしきたり ってやつだね。",
  "tgt": "「嗯～，女人不许上船\n的理由？\n---\n这个嘛，为什么呢‥\n就是老规矩啦。"
 },
 {
  "id": "014674",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「船乘りに なるために\nウデだめし‥\n---\nよくやるよ‥",
  "tgt": "「为了当船夫\n来比试身手‥\n---\n真敢做呀‥"
 },
 {
  "id": "014675",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「どうだい‥\n船には 乘せてもらえる事に\nなったかね？",
  "tgt": "「怎么样‥\n说好让你们\n上船了吗？"
 },
 {
  "id": "014676",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「そうか‥‥\n---\nやっぱり、あきらめる気は\nないんだな‥",
  "tgt": "{立绘0202}「这样啊‥‥\n---\n果然还是\n不肯放弃呀‥"
 },
 {
  "id": "014677",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「よし、{码0B}じゃあ‥\n---\nおねえちゃん達には\nこっちに 来てもらおう‥",
  "tgt": "{立绘0202}「好，那么‥\n---\n就叫小姐姐们\n到这边来吧‥{码0B}じゃあ‥\n---\nおねえちゃん達には\nこっちに 来てもらおう‥"
 },
 {
  "id": "014678",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘C240}「さて‥‥\n---\n{队员01}たちは\nだいじょうぶ だろうかな？",
  "tgt": "{立绘C240}「接下来‥‥\n---\n{队员01}他们\n不要紧吧？"
 },
 {
  "id": "014679",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘C240}「‥見に行こう。",
  "tgt": "{立绘C240}「‥去看看吧。"
 },
 {
  "id": "014680",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「そこに とまってる船‥\nひと晚中、さわがしかったけど\n何やってたんだろ？",
  "tgt": "「停在那边的船‥\n吵吵了一整晚\n到底在干什么呢？"
 },
 {
  "id": "014681",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「この海、ずーと\nひろがってるんだけど‥\n---\nやっぱり はじっこは\n泥の海に なってるんだって。",
  "tgt": "「这片海一直\n延伸下去‥\n---\n但据说尽头果然还是\n变成了泥之海。"
 },
 {
  "id": "014682",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「ここで のんでた\n3人は‥\n---\nジグ、クランク、ツネキチって\n船乘りの 兄弟だよ。",
  "tgt": "「在这喝着酒\n的三个人‥\n---\n是吉格、库兰克、常吉\n这船夫三兄弟哟。"
 },
 {
  "id": "014683",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「あの、ねぇちゃん達\n大したモンだぜ‥\n---\nとうとう、一晚\nガマンしやがった‥！",
  "tgt": "{立绘0202}「那几位小姐姐\n真是了不起‥\n---\n居然真的\n忍了一整晚‥！"
 },
 {
  "id": "014684",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘4100}「{队员00}、{码0B}兄さま！",
  "tgt": "{立绘4100}「{队员00}，{码0B}哥哥！"
 },
 {
  "id": "014685",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{框06}{立绘C240}「隊長さん‥\n顏色が、悪いじゃないか‥\n---\n怖かったのか？",
  "tgt": "{框06}{立绘C240}「队长‥\n脸色不太好呀‥\n---\n害怕了吗？"
 },
 {
  "id": "014686",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘8807}「な、{码0B}何ともない！",
  "tgt": "{立绘8807}「没、没事！{码0B}何ともない！"
 },
 {
  "id": "014687",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{框06}{立绘8242}「まったく‥‥\n---\nウデっぷしと言い\nどきょうと言い\n大したモンだよ‥",
  "tgt": "{框06}{立绘8242}「真是的‥‥\n---\n论身手\n论胆量\n都非同小可呀‥"
 },
 {
  "id": "014688",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘4100}「これで、わたし達\n船に 乘れますね\n{立绘0905}ジグさん‥？",
  "tgt": "{立绘4100}「这下\n我们能上船了吧\n{立绘0905}吉格先生……？"
 },
 {
  "id": "014689",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{框06}{立绘8242}「いや‥‥\n最後に、もう一つだけ‥",
  "tgt": "{框06}{立绘8242}「不‥‥\n最后，还有一件事‥"
 },
 {
  "id": "014690",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{框06}{立绘8242}「船乘りが\n何か ヘマをすると‥\n---\nこれで、けつを\nたたくのが 決まりだ‥",
  "tgt": "{框06}{立绘8242}「船夫要是\n搞砸了什么‥\n---\n就要用这个\n打屁股，这是规矩‥"
 },
 {
  "id": "014691",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{框06}{立绘8242}「つまり‥、いつでも\n{色02}けつパン{/色}を 食らう\nカクゴが なければ‥\n---\n船に、乘ることは できない。\nそうだな‥？",
  "tgt": "{框06}{立绘8242}「也就是说……\n要是没有随时\n挨{色02}屁股开花{/色}的觉悟……\n---\n就别想上船。\n是吧……？"
 },
 {
  "id": "014692",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{框06}{立绘8242}「と、いうワケで\n最後に、あんた達の\nカクゴを 見たい‥\n---\n{色02}けつ{/色}を 出して\nもらおうか、ねえちゃん‥？",
  "tgt": "{框06}{立绘8242}「所以\n最后想见识\n你们的觉悟……\n---\n把{色02}屁股{/色}露出来吧\n大姐姐……？"
 },
 {
  "id": "014693",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0A05}「け、{码0B}け‥{码0B}‥{码0B}‥\n---\nおっ‥{码0B} おしり‥\n出さないと、ダメですか！？",
  "tgt": "{立绘0A05}「屁，屁‥‥‥\n---\n露‥露屁股‥\n不做就不行吗！？{码0B}け‥{码0B}‥{码0B}‥\n---\nおっ‥{码0B} おしり‥\n出さないと、ダメですか！？"
 },
 {
  "id": "014694",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{框06}{立绘8043}「そ、{码0B}そうだ！\n男は、生けつだ！",
  "tgt": "{框06}{立绘8043}「就、就是！\n男人才是祭品！{码0B}そうだ！\n男は、生けつだ！"
 },
 {
  "id": "014695",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{框06}{立绘8242}「‥‥な、{码0B}できねぇだろ？\n---\nあきらめて、るすばん‥",
  "tgt": "{框06}{立绘8242}「‥‥看，做不到吧？\n---\n死心吧，看家去‥{码0B}できねぇだろ？\n---\nあきらめて、るすばん‥"
 },
 {
  "id": "014696",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{框05}{立绘4400}「しりを 出せば\nよいのだろう‥？",
  "tgt": "{框05}{立绘4400}「把屁股\n露出来就行了吧……？"
 },
 {
  "id": "014697",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{框06}{立绘8242}「わ、{码0B}分かった！\n---\nあんた達の、カクゴは\n分かったから‥\nふくを 着てくれ！！",
  "tgt": "{框06}{立绘8242}「明，明白了！\n---\n你们的觉悟\n我见识到了‥\n快把衣服穿上！！{码0B}分かった！\n---\nあんた達の、カクゴは\n分かったから‥\nふくを 着てくれ！！"
 },
 {
  "id": "014698",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「いやー‥、負けたよ\nあんた達には‥\n---\nああ言えば、あきらめて\nくれると 思ったんだが‥",
  "tgt": "{立绘0202}「哎呀——，输了\n彻底输了‥\n---\n本以为这么一说\n你们就会死心的‥"
 },
 {
  "id": "014699",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{框06}{立绘C140}「じゃ、今度こそ‥",
  "tgt": "{框06}{立绘C140}「那，这次真的‥"
 },
 {
  "id": "014700",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「ああ‥\nそこまで カクゴが\n決まってれば‥\n---\nもう、しきたりが\nどうとか‥\n言ってる場合じゃ、ねぇな。",
  "tgt": "{立绘0202}「唉‥\n觉悟都下到\n这份上了‥\n---\n老规矩什么的\n也就没资格\n再说了。"
 },
 {
  "id": "014701",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「船を 出してやるよ‥\n---\n用意ができたら\nおれに、声をかけて\nくれよな？",
  "tgt": "{立绘0202}「船就借给你们‥\n---\n准备好了\n就喊我一声\n行吗？"
 },
 {
  "id": "014702",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「ん‥、用意は\nいいのか？{码14010C82}はい\nまだ",
  "tgt": "{立绘0202}「嗯‥，准备\n好了吗？好了\n还没{码14010C82}はい\nまだ"
 },
 {
  "id": "014703",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「そうかい‥、じゃ\n出発の用意が 整ったら\n言ってくれ。",
  "tgt": "{立绘0202}「这样啊‥，那\n准备好了\n再告诉我。"
 },
 {
  "id": "014704",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}「いつでも、船を出す\n用意は できてるよー‥",
  "tgt": "{立绘0000}「随时都能\n开船哟——……"
 },
 {
  "id": "014705",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}「あんたら、すごいねぇ‥\n---\nきっと、りっぱな\n船乘りに なれるよー！",
  "tgt": "{立绘0000}「你们真厉害呢……\n---\n一定能成为\n了不起的船员哟——！"
 },
 {
  "id": "014706",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「そうか‥、{码0B}よし。\nじゃあ、出発しよう！",
  "tgt": "{立绘0202}「这样啊‥，好。\n那就出发吧！{码0B}よし。\nじゃあ、出発しよう！"
 },
 {
  "id": "014707",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「ツネキチ、クランク！\n船を出すぜ！！",
  "tgt": "{立绘0202}「常吉、库兰克！\n开船喽！！"
 },
 {
  "id": "014708",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「ほらみたことか\nおじょうちゃん‥\n---\nこれ以上 やったって\nムダだよ、あきらめな！",
  "tgt": "{立绘0202}「看见了吧\n小姑娘‥\n---\n再折腾也是\n白费，快放弃吧！"
 },
 {
  "id": "014709",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「どうだい、あの\nおじょうちゃんも\nもう こりただろ‥？",
  "tgt": "{立绘0202}「怎么样，那位\n小姑娘也该\n长记性了吧‥？"
 },
 {
  "id": "014710",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「なんだって‥また\n決闘するってのかい？{码14020C82}はい\nいいえ",
  "tgt": "{立绘0202}「什么‥还要\n再决斗吗？要\n不要{码14020C82}はい\nいいえ"
 },
 {
  "id": "014711",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「そうだよな\nやめといた方が いい‥",
  "tgt": "{立绘0202}「就是嘛\n还是算了吧‥"
 },
 {
  "id": "014712",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「しょうがねえなあ‥\nツネキチ、じゅんびしな！",
  "tgt": "{立绘0202}「真拿你们没办法‥\n常吉，做好准备！"
 },
 {
  "id": "014713",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0003}「い、いつでも\n勝負してやるぞー！",
  "tgt": "{立绘0003}「随……随时\n奉陪到底——！"
 },
 {
  "id": "014714",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}「うーん、やっぱり\n女の子に 船乘りは\n無理かなあ‥",
  "tgt": "{立绘0000}「嗯——，果然\n小姑娘还是\n当不了船员吧……"
 },
 {
  "id": "014715",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0202}「どうした‥\n船を 使いたいのか？{码14030C82}はい\nいいえ",
  "tgt": "{立绘0202}「怎么了‥\n要用船吗？要\n不要{码14030C82}はい\nいいえ"
 },
 {
  "id": "014716",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「荷物を 整理してたら\n{色03}お宝{/色}が 出てきたんだ‥\n---\nよかったら、キミの\n{色03}{占位00}{/色}と\n取り替えないか？{码14040C92}取り替える！\nやめておく‥",
  "tgt": "「整理行李的时候\n翻出了一样{色03}宝物{/色}……\n---\n可以的话\n要不要用你的\n{色03}{占位00}{/色}\n跟我换？{码14040C92}换！\n还是算了……"
 },
 {
  "id": "014717",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "\n {色03}{占位01}{/色}と 取り替えた！\n---\n",
  "tgt": "\n换成了{色03}{占位01}{/色}！\n---\n"
 },
 {
  "id": "014718",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「古い物だけど\nいい品だろう‥？",
  "tgt": "「虽然是老物件\n但算是好货吧‥？"
 },
 {
  "id": "014719",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「いくら かたづけても\nガラクタばかり‥\n---\nなにか、{色03}お宝{/色}でも\n出てこないかな？",
  "tgt": "「收拾了半天\n全是破烂‥\n---\n能不能翻出\n什么宝物呢？{色03}お宝{/色}でも\n出てこないかな？"
 },
 {
  "id": "014720",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "「お客さん、お買い物なら\nカウンターで どうぞ。",
  "tgt": "「客人，要买东西\n请到柜台这边。"
 },
 {
  "id": "014721",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "まずは、二人の様子を\n見に行こう‥",
  "tgt": "先去看看\n两人的情况吧‥"
 },
 {
  "id": "014722",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}クランク\n「ひさしぶりー！\n---\n海旅にはもう\nなれた？\n---\n水神さまがみとめた\n君たちなら\nモンダイないとは思うけど、\n---\nもし良かったら\n俺たち海の男の\n生活術を教えるよー？{码14820C92}教えてもらう\nえんりょする",
  "tgt": "{立绘0000}库兰克\n「好久不见——！\n---\n海上旅行\n习惯了吗？\n---\n如果是被\n水神大人认可的人\n应该没什么问题……\n---\n要是愿意的话\n就把我们海上男儿的\n生活术教给你吧？{码14820C92}请教我\n还是算了吧"
 },
 {
  "id": "014723",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}{码0B}どうやら\nだいぶ海の男らしく\nなったねー。\n---\nこれならきっと\n俺たちの技や術を\n覺えられるはずだよ。\n---\n手始めはこの\n{色04}おいうち{/色}だ。\n---\nどんな敵にも\n情けをかけないきびしさ。\n---\nその強さが海の男には\n必要なんだ。",
  "tgt": "{立绘0000}{码0B}看样子\n你已经很有\n海上男儿的模样了。\n---\n这样的话\n肯定学得会\n我们的技艺。\n---\n先从这招\n{色04}追击{/色}开始。\n---\n无论对什么敌人\n都绝不留情的狠劲。\n---\n海上男儿\n就需要这份强悍。"
 },
 {
  "id": "014724",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}‥うーんと、\nどうしたらいいのかな‥\n---\n‥とりあえず今度は\n{色02}{占位00}{/色}以上の\nコンボを出してみてー。\n---\nそうしたらまた、\n何か教えてあげるよ。",
  "tgt": "{立绘0000}……嗯——\n该怎么办呢……\n---\n……总之这次\n先打出超过\n{色02}{占位00}{/色}的\n连击试试——。\n---\n到时我再\n教你点别的。"
 },
 {
  "id": "014725",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}{码0B}よーし、では\n海の男の基本を教えるよ。\n---\n{码0B}‥‥と思ったけど、\nどうもまだ海の男らしい\n一体感が感じられないねー。\n---\nそうだな‥\nうーんと‥{码0B}\nコンボ{码0B}って知ってるかい？\n---\nあれを{色02}25{/色}HIT以上\n出すくらいになれば、\n---\nきっと海の男に\n近づけると思うよ。",
  "tgt": "{立绘0000}{码0B}好——那\n就教你海上男儿的基本功。\n---\n{码0B}……话虽如此，\n总觉得你们还缺少\n海上男儿的那种一体感。\n---\n这样吧……\n嗯——{码0B}\n连击{码0B}，你知道吗？\n---\n等你能打出\n{色02}25{/色}HIT以上，\n---\n我想你就离\n海上男儿\n不远了。"
 },
 {
  "id": "014726",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}またねー。",
  "tgt": "{立绘0000}回头见——。"
 },
 {
  "id": "014727",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}クランク\n「今日はいい風が\nふいてるねー。\n---\nこんな日は\nアイツのことを\n思い出すよ。\n---\nところでどう？\nあれから海の男の\n一体感はつかめた？",
  "tgt": "{立绘0000}库兰克\n「今天的风\n吹得正舒服——。\n---\n这样的日子\n就会想起\n那家伙。\n---\n话说怎么样？\n那之后有没有\n找到海上男儿的一体感？"
 },
 {
  "id": "014728",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}{码0B}‥ああっっ！\n今のアイコンタクト！\n---\nどうやら君たち\nかなりのレベルに\nたっしたようだねー。\n---\nよーし、それなら\n海の男だけが知っている、\n---\nこの{色03}{占位01}{/色}を\n教えてあげるよー。",
  "tgt": "{立绘0000}{码0B}……啊啊！\n刚才的眼神交流！\n---\n看来你们\n已经达到\n相当高的水平了。\n---\n好——那\n就把只有海上男儿才知道的\n---\n这招{色03}{占位01}{/色}\n教给你们。"
 },
 {
  "id": "014729",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}今度は{色02}{占位00}{/色}以上の\nコンボを出してみてー。\n---\nそうしたらまた、\n何か教えてあげるよ！",
  "tgt": "{立绘0000}这次\n打出超过{色02}{占位00}{/色}的\n连击试试——。\n---\n到时我再\n教你点别的！"
 },
 {
  "id": "014730",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}{码0B}‥いつのまにか君たち、\n---\n海の男そのものに\nなっているじゃないか！\n---\n教えようにも\nもう、教えることが\nなにもないよ。\n---\nあとは自分たちで\nがんばるんだよー！",
  "tgt": "{立绘0000}{码0B}……不知不觉，\n---\n你们已经\n俨然是\n海上男儿了嘛！\n---\n我想教\n也没什么可教的了。\n---\n接下来\n就靠自己努力——！"
 },
 {
  "id": "014731",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}で、どうするんだい？{码14820C93}教えてほしい\nやめます\n何でもないです",
  "tgt": "{立绘0000}那么，怎么样？{码14820C93}想学\n不学了\n没什么事"
 },
 {
  "id": "014732",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}他にはー？{码14820C93}教えてほしい\nやめます\n何でもないです",
  "tgt": "{立绘0000}还有别的吗——？{码14820C93}想学\n不学了\n没什么事"
 },
 {
  "id": "014733",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}{码0B}‥みんなすでに\n海の男だよ。",
  "tgt": "{立绘0000}{码0B}……你们\n都已经是\n海上男儿了。"
 },
 {
  "id": "014734",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}{码0B}では{占位02}に\n{色04}おいうち{/色}を教えるよー！\n---\nこれで海の男の\nなかま入りだ。",
  "tgt": "{立绘0000}{码0B}那就教{占位02}\n{色04}追击{/色}吧——！\n---\n这样就算\n加入海上男儿了。"
 },
 {
  "id": "014735",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}{码0B}では 君たちに\n{色04}おいうち{/色}を教えるよー！\n---\nこれで海の男の\nなかま入りだ。",
  "tgt": "{立绘0000}{码0B}那就教你们\n{色04}追击{/色}吧——！\n---\n这样就算\n加入海上男儿了。"
 },
 {
  "id": "014736",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}誰もいないのー？\nま、いいけど。",
  "tgt": "{立绘0000}没人吗——？\n算了，也行。"
 },
 {
  "id": "014737",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}{码0B}‥海の男は\nいないよ。",
  "tgt": "{立绘0000}{码0B}……没有\n海上男儿哦。"
 },
 {
  "id": "014738",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}{码0B}うーん、\nそれでは{占位02}は\n---\nもう海の男じゃないよ。",
  "tgt": "{立绘0000}{码0B}嗯——，\n那{占位02}\n---\n就不算海上男儿了。"
 },
 {
  "id": "014739",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}{码0B}うーん、\nそれでは君たちは\n---\nもう海の男じゃないよ。",
  "tgt": "{立绘0000}{码0B}嗯——，\n那你们\n---\n就不算海上男儿了。"
 },
 {
  "id": "014740",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}‥どうしたのー？\nま、いいけど。",
  "tgt": "{立绘0000}……怎么啦——？\n算了，也行。"
 },
 {
  "id": "014741",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}海の男にコトバはいらない\n重要なのは心の一体感！\n---\n{色02}{占位00}{/色}以上の\nコンボを出したら\nまたやって来てー。",
  "tgt": "{立绘0000}海上男儿不需要言语\n重要的是心意相通！\n---\n打出超过\n{色02}{占位00}{/色}的连击\n再来找我——。"
 },
 {
  "id": "014742",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "{立绘0000}クランク\n「‥‥知らない人は\nふねには乘せられないよ。",
  "tgt": "{立绘0000}库兰克\n「……不认识的人\n可不能让他上船哦。"
 },
 {
  "id": "014743",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "30",
  "tgt": "30"
 },
 {
  "id": "014744",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "40",
  "tgt": "40"
 },
 {
  "id": "014745",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "50",
  "tgt": "50"
 },
 {
  "id": "014746",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "70",
  "tgt": "70"
 },
 {
  "id": "014747",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "メガホン",
  "tgt": "喇叭"
 },
 {
  "id": "014748",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "くうき撃ち",
  "tgt": "空气击"
 },
 {
  "id": "014749",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "せんぎり",
  "tgt": "千斩"
 },
 {
  "id": "014750",
  "file": "WORLD/AREAS025.EMI",
  "seg": 8,
  "src": "滅殺",
  "tgt": "灭杀"
 },
 {
  "id": "014751",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "うぃんでぃあのおしろ",
  "tgt": "温迪亚城"
 },
 {
  "id": "014752",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「このリフトは\n風車の力を 利用して\n動かしています。",
  "tgt": "「这座升降机\n是利用风车之力\n驱动的。"
 },
 {
  "id": "014753",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「見はらし、いいでしょ‥\n---\n運が良ければ‥\n風竜さまの 飛んでる姿を\n見る事も できますよ。",
  "tgt": "「视野很好吧‥\n---\n运气好的话‥\n还能看到风龙大人\n飞翔的身影哦。"
 },
 {
  "id": "014754",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「こんな高い所に、住んでて\n怖くないのかな‥",
  "tgt": "「住在这种高处\n不会害怕吗‥"
 },
 {
  "id": "014755",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「我々、ウインディア人は\n高いのが、平気なのです。\n---\nと言うか、高い所は\nむっちゃ好きなのです。",
  "tgt": "「我们温迪亚人\n不怕高的地方。\n---\n不如说，高的地方\n我们超喜欢。"
 },
 {
  "id": "014756",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「おれだって、高いの\n怖かないや‥！",
  "tgt": "「我也不怕\n高的地方‥！"
 },
 {
  "id": "014757",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「ここは、ろうやです。\n---\n見ても、おもしろいって\nものじゃ ありませんよ。",
  "tgt": "「这里是牢房。\n---\n看了也没有什么\n意思哦。"
 },
 {
  "id": "014758",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「ああ、エリーナさま‥\n---\nああ、{码0B}{队员01}さま‥\n---\nお二人とも、美しい‥！\n---\n二人から、同時に\n愛を告げられたら‥\nぼくは、どうしよう？",
  "tgt": "「啊，艾莉娜大人‥\n---\n啊，{码0B}{队员01}大人‥\n---\n二位都如此美丽‥！\n---\n要是两人同时\n向我告白‥\n我该怎么办？"
 },
 {
  "id": "014759",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「この先、いっぱんの方は\nごえんりょ下さい。",
  "tgt": "「前方普通人\n请回避。"
 },
 {
  "id": "014760",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「この先、いっぱんの‥\n---\nえ、{队员01}さま！？",
  "tgt": "「前方普通人‥\n---\n咦，{队员01}大人！？"
 },
 {
  "id": "014761",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「この先は‥\nあ、{码0B}あら‥？\n---\n{队员01}さま！",
  "tgt": "「前方是‥\n啊、哎呀‥？\n---\n{码0B}大人！{队员01}さま！"
 },
 {
  "id": "014762",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「{队员01}さま‥！\nよくぞ お戻り下さいました！",
  "tgt": "「{队员01}大人‥！\n您平安回来了！"
 },
 {
  "id": "014763",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「おお、{码0B}おかえりなさいませ\n{队员01}さまっ！",
  "tgt": "「哦哦，欢迎回来\n{码0B}大人！{队员01}さまっ！"
 },
 {
  "id": "014764",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「王様が、お待ちでございます\nさ、どうぞ‥！",
  "tgt": "「国王正等着您\n请进‥！"
 },
 {
  "id": "014765",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「皆、心配しておりました\nさ、どうぞ‥！",
  "tgt": "「大家都很担心您\n快请‥！"
 },
 {
  "id": "014766",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「王様は、もちろん\n私達みんな‥\n---\n{队员01}さまの\nお归りを 待っていたのです。",
  "tgt": "「不用说国王\n我们大家‥\n---\n都在等着\n{队员01}大人回来。"
 },
 {
  "id": "014767",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「やー‥\n{队员01}さまの\nお归りだー‥！",
  "tgt": "「呀——‥\n{队员01}大人\n回来啦‥！"
 },
 {
  "id": "014768",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「王のお部屋ですぞ‥\nおひかえなされ。",
  "tgt": "「这是王之房间‥\n不得无礼。"
 },
 {
  "id": "014769",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「こっ、{码0B}これは\n{队员01}さま！？",
  "tgt": "「这、这不是\n{码0B}大人！？{队员01}さま！？"
 },
 {
  "id": "014770",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「どうぞ中へ‥！\n王さまに お顏を\n見せてあげて下さい！",
  "tgt": "「请进‥！\n快去拜见\n国王陛下吧！"
 },
 {
  "id": "014771",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「なんだね、君たち‥？",
  "tgt": "「你们几个，有何事‥？"
 },
 {
  "id": "014772",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「なんと、{队员01}様！\nお戻りでしたか‥！",
  "tgt": "「什么，{队员01}大人！\n您回来了‥！"
 },
 {
  "id": "014773",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「エリーナさま‥{码0B}‥\n---\nもう、お戻りに\nならないのですか‥‥",
  "tgt": "「艾莉娜大人‥‥\n---\n她再也\n回不来了吗‥‥{码0B}‥\n---\nもう、お戻りに\nならないのですか‥‥"
 },
 {
  "id": "014774",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「いじょうなーし。",
  "tgt": "「一切正常。"
 },
 {
  "id": "014775",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「戦爭のころは\n連日、ここで\nかいぎが 開かれてました。\n---\nでも、戦爭の話し合いなんて\n無いほうが、いいですわ。",
  "tgt": "「战争那阵子\n天天都在这里\n开会。\n---\n不过，开战事的会议\n还是别开的好。"
 },
 {
  "id": "014776",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「この先は、許可なく\nお通しできません。",
  "tgt": "「前方未经许可\n不得通行。"
 },
 {
  "id": "014777",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「ルディアから‥、そなた達が\n捕まったとの 報せが\nあった時には‥\n---\nどうしたものかと\n思ったものだ‥",
  "tgt": "{框04}{立绘8040}「当听闻你们‥在\n卢迪亚\n被捕的消息时‥\n---\n我也曾不知\n如何是好‥"
 },
 {
  "id": "014778",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「姉を探すと、出ていった\n娘が‥\n---\n敵国で、捕らえられて\nいたとは‥！",
  "tgt": "{框04}{立绘8040}「出门寻找姐姐的\n女儿‥\n---\n竟被敌人\n抓走了‥！"
 },
 {
  "id": "014779",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「申しわけありません\nウインディアの王よ‥\n---\n私が ついていながら‥",
  "tgt": "{框06}{立绘C240}「实在抱歉\n温迪亚的王啊‥\n---\n明明有我在身边‥"
 },
 {
  "id": "014780",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{框04}{立绘0040}「いや、それはもう\nよいのだ‥\n---\nそれよりも‥\n{队员02}どのには\nかんしゃしておる‥",
  "tgt": "{框04}{立绘0040}「不，那已经\n不必了…\n---\n比起这个…\n要感谢\n{队员02}大人…"
 },
 {
  "id": "014781",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「あのとおり‥\nルディアは 体面ばかりを\n気にかけて‥\n---\nエリーナの、そうさくを\n許そうとしない‥",
  "tgt": "{框04}{立绘8040}「你也看到了‥\n卢迪亚只顾\n体面‥\n---\n不肯允许\n搜救艾莉娜‥"
 },
 {
  "id": "014782",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{框04}{立绘0040}「それを、あなたは\nやってくれた‥\n---\n族長という 自らの\n立場がありながら‥\n---\n中々、できる事ではない。",
  "tgt": "{框04}{立绘0040}「那件事\n是你做的…\n---\n明知自己身为\n族长的立场…\n---\n却仍做出此举\n实属难得。"
 },
 {
  "id": "014783",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「それよりも‥\nこの先、どうする？\n---\nいずれ、ここにも\nルディアの手が回ろう‥\n---\nむろん、ウインディアとしては\n全力をあげて、そなた達を\nかばう つもりだが‥",
  "tgt": "{框04}{立绘8040}「先不谈这个‥\n今后有何打算？\n---\n迟早卢迪亚的手\n也会伸到这里‥\n---\n当然，温迪亚打算\n倾尽全力\n庇护你们‥"
 },
 {
  "id": "014784",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{框03}{立绘4100}「それですが、父さま‥\n---\nルディアの手が 回る前に\nやっておきたい事が\nあります‥",
  "tgt": "{框03}{立绘4100}「可是，父亲…\n---\n趁卢迪亚的人\n还没找来\n有件事想做…"
 },
 {
  "id": "014785",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{框03}{立绘4100}「わたし達、{色02}風竜{/色}さまに\nお会いして‥\n---\n闻きたいことが、あるんです。",
  "tgt": "{框03}{立绘4100}「我们想拜见\n{色02}风龙{/色}大人…\n---\n有话想问。"
 },
 {
  "id": "014786",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「ふーむ‥、しかし‥\n風竜のことは‥\n---\n王と言えども、何とも‥",
  "tgt": "{框06}{立绘8040}「唔姆‥只是‥\n风龙之事‥\n---\n即便是王，也无能为力‥"
 },
 {
  "id": "014787",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{框06}{立绘4200}「竜の事が‥\n帝国の 探すものの事が\n分かれば‥\n---\n何か、手が打てるのでは\nないかと思うのです。",
  "tgt": "{框06}{立绘4200}「若能弄清龙…\n帝国追寻之物的\n真相…\n---\n或许就能\n想出对策。"
 },
 {
  "id": "014788",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「ふむ‥、わかった。\n---\nならば、東の森に住む\n{色02}風のみこ{/色}に 会うがよい。\n---\n風竜につかえる、みこだ。",
  "tgt": "{框06}{立绘8040}「唔…，知道了。\n---\n那就去见住在\n东边森林的{色02}风之巫女{/色}。\n---\n她是侍奉风龙的巫女。"
 },
 {
  "id": "014789",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「この事、わしの方から\nことづけておく‥\n---\n今日は ゆっくり休み\n明日、出立すると よかろう。",
  "tgt": "{框06}{立绘8040}「此事我会亲自\n派人转告‥\n---\n今日好好休息\n明日启程为佳。"
 },
 {
  "id": "014790",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{立绘8040}「みこの住む森は、東だ。\n---\nルディアが、何か言ってきたら\nごまかしておくから\n心配するな‥",
  "tgt": "{立绘8040}「巫女所居森林在东边。\n---\n卢迪亚若来问起\n我会先敷衍过去\n不必担心‥"
 },
 {
  "id": "014791",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「{队员01}さまを\nかばわねば ならないし‥\n---\nルディアとの 関係も\n悪くできない‥\n---\n難しい お立場ですな\n王様は‥",
  "tgt": "「既要庇护\n{队员01}大人‥\n---\n又不能与卢迪亚\n交恶‥\n---\n国王的处境\n真是为难啊‥"
 },
 {
  "id": "014792",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「エリーナさまの事‥\n誰よりも 心配で\nいらっしゃるのに‥\n---\n人前では、そのことを\n決して口にされない‥\n---\nつらい お立場です\n王様は‥！",
  "tgt": "「明明比谁都\n担心艾莉娜大人\n却从不表露‥\n---\n在人前绝口\n不提此事‥\n---\n王的位置\n真是煎熬啊‥！"
 },
 {
  "id": "014793",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{立绘0000}「ふむ、みこどのが\nそう言われるのなら‥\n---\n{道具0705}\n持って行くがいい！",
  "tgt": "{立绘0000}「唔，既然\n巫女大人这么说…\n---\n就拿上\n{道具0705}去吧！"
 },
 {
  "id": "014794",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「{道具0705}は\n風竜をまつる 風の塔に\n入るための、大切な神具‥\n---\nこの{色02}城の地下{/色}に\nほかんして ございます。",
  "tgt": "「{道具0705}是进入\n供奉风龙的风之塔的\n重要神器…\n---\n保管在这座\n{色02}城的地下{/色}。"
 },
 {
  "id": "014795",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「風竜は‥\n---\nラーウィ様は、人とまみえぬ\n竜の中にあって‥\n---\n人語を解し、語ることをする\nめずらしい存在なのです。",
  "tgt": "「风龙‥\n---\n拉维大人虽身为\n不现于人前的龙‥\n---\n却通人言、会说话\n实属罕见的存在。"
 },
 {
  "id": "014796",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{立绘0000}「地下に入れるよう\nすぐに、取り計らおう‥\n---\nさあ、行け‥！",
  "tgt": "{立绘0000}「我马上去安排\n放你们进地下…\n---\n去吧…！"
 },
 {
  "id": "014797",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「すでに お話は\nうかがっております\nさあ、どうぞ！",
  "tgt": "「事情我们已经\n有所耳闻\n快请进！"
 },
 {
  "id": "014798",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「風の塔って、この城よりも\nずっと 高いそうですよ‥\n---\nもー、たまりませんね！",
  "tgt": "「听说风之塔比\n这座城还要高得多‥\n---\n啊——受不了啦！"
 },
 {
  "id": "014799",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「みこ様は もう長いこと\nカスクの森に住まわれて‥\n---\n風竜様と お会いする時以外\nほとんど、姿をお見せに\nならないのです。",
  "tgt": "「巫女大人在卡斯库\n森林住了很久‥\n---\n除了会见风龙大人\n几乎从不\n现身。"
 },
 {
  "id": "014800",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{立绘0000}「ふむ‥、フエを\n手にしたのなら‥\n---\n城の北にある\n{色02}風の塔{/色}へと 行くがよい。\n---\nそこで、風竜に\nまみえる事が、できよう‥",
  "tgt": "{立绘0000}「唔…，若已\n拿到笛子…\n---\n就去城北的\n{色02}风之塔{/色}吧。\n---\n在那里\n便可见到\n风龙…"
 },
 {
  "id": "014801",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「城の近边では ルディアの\n兵を見た、との話も闻きます\n---\nここに、手が回る前に\nお急ぎなされ。",
  "tgt": "「据说城附近也有人\n见过卢迪亚的士兵\n---\n趁他们的手还没伸到\n请快动身。"
 },
 {
  "id": "014802",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「みこ様が、最後に\nお城へ いらしたのは\n---\n{队员01}様が\nお生まれになった\n時だそうですよ‥",
  "tgt": "「巫女大人最后一次\n来城堡‥\n---\n据说是在\n{队员01}大人\n出生之时哦‥"
 },
 {
  "id": "014803",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「風竜さまを\n近くで 見るには‥\n---\n北の、風の塔から\nさらに高く 上がらないと\nだめなんですよね‥",
  "tgt": "「想近距离\n看风龙大人‥\n---\n就得从北边的\n风之塔再往上爬\n才行呢‥"
 },
 {
  "id": "014804",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「ふぅ、エリーナ様には\nいいなずけの ルディア王子が‥\n---\nはぁ、{队员01}様には\n次期王女としての立場が‥\n---\n道ならぬ愛と\n身分違いの愛\nぼくは、どちらを選べば‥？",
  "tgt": "「唉，艾莉娜大人有\n未婚夫卢迪亚王子‥\n---\n呼，{队员01}大人又有\n下任王女的身份‥\n---\n不伦之爱与\n身份悬殊之爱\n我该选哪个‥？"
 },
 {
  "id": "014805",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「はぁ、{队员01}様の\n愛にこたえることは‥\n---\nウインディアの王として\n国を治めること‥\n---\nぼくに、それが\nできるだろうか‥？",
  "tgt": "「呼，回应{队员01}大人\n的爱意‥\n---\n与作为温迪亚的王\n治理国家‥\n---\n我究竟能不能\n做到啊‥？"
 },
 {
  "id": "014806",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「ふぅ、エリーナ様の\n愛にこたえることは‥\n---\nルディアを敵に回す\nということ‥\n---\nぼくに、エリーナ様を\n守り抜けるだろうか‥？",
  "tgt": "「唉，回应艾莉娜大人\n的爱意‥\n---\n意味着与卢迪亚\n为敌‥\n---\n我究竟能不能\n守护住艾莉娜大人‥？"
 },
 {
  "id": "014807",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "強風に、押し戻される！{延时16}",
  "tgt": "被强风推了回来！{延时16}"
 },
 {
  "id": "014808",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "\n  {色03}{道具0705}{/色}を 手に入れた！",
  "tgt": "\n获得了{色03}{道具0705}{/色}！"
 },
 {
  "id": "014809",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{立绘8040}「ふむう‥‥？\n---\n帝国初代皇帝の\n半身‥？\n---\nルディアや、帝国が\nやっきになる 理由も\nわかるが‥\n---\nなんとも 大きな話だな！",
  "tgt": "{立绘8040}「唔姆‥‥？\n---\n帝国初代皇帝的\n半身‥？\n---\n卢迪亚和帝国为何\n如此执着\n也能理解‥\n---\n真是不得了的大事啊！"
 },
 {
  "id": "014810",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{立绘8040}「{队员01}よ‥\n---\nこと、ここに いたっては\n我が助力の\nおよぶべくも、ない‥\n---\n強くなったな\nいつの間にか‥‥",
  "tgt": "{立绘8040}「{队员01}啊‥\n---\n事到如今\n我的帮助\n已无济于事了‥\n---\n变强了啊\n不知不觉间‥‥"
 },
 {
  "id": "014811",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「お归りが 遲いので\n心配しておりました‥\n---\nラーウィ様には お会い\nできましたかな？",
  "tgt": "「回来得晚了\n我们都很担心‥\n---\n见到拉维\n大人了吗？"
 },
 {
  "id": "014812",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「あのように 言っては\nおられても、やはり\n---\n{队员01}様が\n心配で ならないのです‥\n---\n王様のためにも 早く\nお戻りください‥！",
  "tgt": "「话虽那样说\n可我们还是‥\n---\n担心{队员01}大人\n担心得不行‥\n---\n为了国王也请\n早点回来‥！"
 },
 {
  "id": "014813",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「{队员01}様のこと‥\n---\nくれぐれも よろしく\nお願いしますぞ‥",
  "tgt": "「{队员01}大人的事‥\n---\n一切就拜托\n各位了‥"
 },
 {
  "id": "014814",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「エリーナ様も 戻られず‥\nこの上、{队员01}様に\n何かあっては‥",
  "tgt": "「艾莉娜大人还没回来‥\n要是{队员01}大人\n再出什么事‥"
 },
 {
  "id": "014815",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「{队员01}様と\nエリーナ様の お部屋‥\n---\nいつ 戻ってらしても\nよいよう‥\n---\nキレイに そうじして\n待っております。",
  "tgt": "「{队员01}大人和\n艾莉娜大人的房间‥\n---\n随时回来\n都可以‥\n---\n我们会打扫得\n干干净净恭候。"
 },
 {
  "id": "014816",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「しかし、竜というのは\n変なものですね‥\n---\nラーウィ様なんて\nあんなに 大きいのが\n空に 浮かんでいるなんて！",
  "tgt": "「不过，龙这种生物\n真是奇妙啊‥\n---\n拉维大人那么\n庞大的身躯\n竟浮在空中！"
 },
 {
  "id": "014817",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「ルディアの連中は\nあきらめたのか‥\n---\n最近は この边りで\n見なくなりましたねぇ‥",
  "tgt": "「卢迪亚那帮人\n死心了吗‥\n---\n最近这一带\n都见不着他们了呢‥"
 },
 {
  "id": "014818",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「家族で 食事をかこむ事が\nなくなってから‥\n---\n王様、さみしそうに\nしていらっしゃいます‥",
  "tgt": "「自从不再一家人\n围桌用饭‥\n---\n国王就总显得\n很寂寞‥"
 },
 {
  "id": "014819",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「やや、また何か\nご用ですか？",
  "tgt": "「哟哟，又有什么\n事吗？"
 },
 {
  "id": "014820",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「ああ、{队员01}様と\n結ばれれば‥\n---\nこの城が、町が、民が\n全て ぼくの物に！\n---\nウフ‥、フフフ‥",
  "tgt": "「啊，只要和{队员01}大人\n结为连理‥\n---\n这座城、这镇子、还有子民\n全都归我！\n---\n呼‥、呵呵呵‥"
 },
 {
  "id": "014821",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「風の塔に\n行かれたんですか？\n---\nどうです、高かったでしょ\nいやあ うらやましいなぁ‥",
  "tgt": "「您去了\n风之塔吗？\n---\n如何，很高吧\n真让人羡慕啊‥"
 },
 {
  "id": "014822",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「ここ、空気がうすくて‥\nちょっと 休ませて。",
  "tgt": "「这里空气稀薄‥\n让我歇会儿。"
 },
 {
  "id": "014823",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「水を くみ上げたり\nリフトを 動かしたり‥\n---\n風を利用するだけで\n便利に なるもんだ。",
  "tgt": "「抽水啊\n驱动升降机啊‥\n---\n光是利用风\n就能方便这么多。"
 },
 {
  "id": "014824",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「えー‥\nすでに ご存知と\n思いますが‥\n---\nこの下は、ろうやですよ。",
  "tgt": "「嗯——‥\n想必诸位\n已经知道‥\n---\n这下面是牢房哦。"
 },
 {
  "id": "014825",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「けしきは 美しいし\n空気は おいしいし‥\n---\nなかなか、归る気に\nならないのよね。",
  "tgt": "「风景美丽\n空气清新‥\n---\n让人根本\n不想回去呢。"
 },
 {
  "id": "014826",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{立绘0000}「もはや、そなた達の\nかかわった事は‥\n---\n世界を 動かしかねん\n大事と なっているようだな‥",
  "tgt": "{立绘0000}「你们卷入之事…\n---\n似乎已成了\n足以撼动世界的\n大事…"
 },
 {
  "id": "014827",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "{立绘0000}「戻ったか、{队员01}‥\n---\nいつか、エリーナも\nそのように ひょっこりと‥\n---\n戻るような、気がしてな‥",
  "tgt": "{立绘0000}「回来了啊，{队员01}…\n---\n总觉得艾莉娜\n总有一天也会这样\n---\n突然回来…"
 },
 {
  "id": "014828",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「私は まつり事にしか\nきょうみが ないのですが‥\n---\n今、なにやら世界が\nただならぬ動きを しているのは\n分かりますぞ‥",
  "tgt": "「老朽只对祭祀\n之事有兴趣‥\n---\n不过，如今世界似有\n不同寻常的动向\n老朽知道‥"
 },
 {
  "id": "014829",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「私は まつり事にしか\nきょうみが ないのですが‥\n---\n今、なにやら世界が\nただならぬ動きを しているのは\n分かりますぞ‥",
  "tgt": "「老朽只对祭祀\n之事有兴趣‥\n---\n不过，如今世界似有\n不同寻常的动向\n老朽知道‥"
 },
 {
  "id": "014830",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「{队员01}様のこと\nよろしく お願いいたします‥",
  "tgt": "「{队员01}大人\n就拜托各位了‥"
 },
 {
  "id": "014831",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「{队员01}様‥\n---\nずいぶんと しっかり\nされましたな‥\n---\n姉の エリーナ様に\nにてこられた‥！",
  "tgt": "「{队员01}大人‥\n---\n您变得\n沉稳可靠多了‥\n---\n和姐姐艾莉娜大人\n一模一样了‥！"
 },
 {
  "id": "014832",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「フ、フハハハハ！\n---\n見ろ‥！\n人が、ごみのようだ‥！",
  "tgt": "「呼、呼哈哈哈！\n---\n看啊‥！\n人小得像蝼蚁‥！"
 },
 {
  "id": "014833",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「お城に 忍びこんだ\nコソドロが、捕まってます\n---\n近づかないほうが\nいいですよ‥",
  "tgt": "「潜入王城的\n小偷已经被抓\n---\n最好不要\n靠近哦‥"
 },
 {
  "id": "014834",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「ヘヘ、ドジふんじまった\n---\nけど‥{色03}お宝{/色}はしっかりと\n持ってきたぜ！\n---\nどうだい‥あんたの\n{色03}{占位00}{/色}と\n取り替えてみねえか？{码14000C92}取り替える！\nやめておく‥",
  "tgt": "「嘿嘿，摔了个大跟头\n---\n但…{色03}宝贝{/色}\n可好好带回来了！\n---\n怎么样…用你的\n{色03}{占位00}{/色}\n换换看？{码14000C92}交换！\n算了…"
 },
 {
  "id": "014835",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "\n {色03}{占位01}{/色}と 取り替えた！\n---\n",
  "tgt": "\n换成了{色03}{占位01}{/色}！\n---\n"
 },
 {
  "id": "014836",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「なんでも、ここの\n王様の 宝物らしいぜ‥！",
  "tgt": "「据说好像是这里\n国王的宝物‥！"
 },
 {
  "id": "014837",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "「ドジはふんでも\n{色03}お宝{/色}は 手放さないのが\n一流ってもんだ‥！",
  "tgt": "「就算栽跟头\n宝物也绝不撒手\n这才叫一流‥！{色03}お宝{/色}は 手放さないのが\n一流ってもんだ‥！"
 },
 {
  "id": "014838",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "どこからともなく、ふく風で\n風車がまわっている‥",
  "tgt": "不知从何处吹来的风\n正推动着风车‥"
 },
 {
  "id": "014839",
  "file": "WORLD/AREAS026.EMI",
  "seg": 11,
  "src": "強風に、押し戻される！\nかべの くぼみに隱れて\n風を やりすごそう。{延时60}",
  "tgt": "被强风推了回来！\n躲进墙上的凹处\n等风头过去吧。{延时60}"
 },
 {
  "id": "014840",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "うぃんでぃあのおしろ",
  "tgt": "温迪亚城"
 },
 {
  "id": "014841",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「このリフトは\n風車の力を 利用して\n動かしています。",
  "tgt": "「这座升降机\n是利用风车之力\n驱动的。"
 },
 {
  "id": "014842",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「見はらし、いいでしょ‥\n---\n運が良ければ‥\n風竜さまの 飛んでる姿を\n見る事も できますよ。",
  "tgt": "「视野很好吧‥\n---\n运气好的话‥\n还能看到风龙大人\n飞翔的身影哦。"
 },
 {
  "id": "014843",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「こんな高い所に、住んでて\n怖くないのかな‥",
  "tgt": "「住在这种高处\n不会害怕吗‥"
 },
 {
  "id": "014844",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「我々、ウインディア人は\n高いのが、平気なのです。\n---\nと言うか、高い所は\nむっちゃ好きなのです。",
  "tgt": "「我们温迪亚人\n不怕高的地方。\n---\n不如说，高的地方\n我们超喜欢。"
 },
 {
  "id": "014845",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「おれだって、高いの\n怖かないや‥！",
  "tgt": "「我也不怕\n高的地方‥！"
 },
 {
  "id": "014846",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「ここは、ろうやです。\n---\n見ても、おもしろいって\nものじゃ ありませんよ。",
  "tgt": "「这里是牢房。\n---\n看了也没有什么\n意思哦。"
 },
 {
  "id": "014847",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「ああ、エリーナさま‥\n---\nああ、{码0B}{队员01}さま‥\n---\nお二人とも、美しい‥！\n---\n二人から、同時に\n愛を告げられたら‥\nぼくは、どうしよう？",
  "tgt": "「啊，艾莉娜大人‥\n---\n啊，{码0B}{队员01}大人‥\n---\n二位都如此美丽‥！\n---\n要是两人同时\n向我告白‥\n我该怎么办？"
 },
 {
  "id": "014848",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「この先、いっぱんの方は\nごえんりょ下さい。",
  "tgt": "「前方普通人\n请回避。"
 },
 {
  "id": "014849",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「この先、いっぱんの‥\n---\nえ、{队员01}さま！？",
  "tgt": "「前方普通人‥\n---\n咦，{队员01}大人！？"
 },
 {
  "id": "014850",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「この先は‥\nあ、{码0B}あら‥？\n---\n{队员01}さま！",
  "tgt": "「前方是‥\n啊、哎呀‥？\n---\n{码0B}大人！{队员01}さま！"
 },
 {
  "id": "014851",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「{队员01}さま‥！\nよくぞ お戻り下さいました！",
  "tgt": "「{队员01}大人‥！\n您平安回来了！"
 },
 {
  "id": "014852",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「おお、{码0B}おかえりなさいませ\n{队员01}さまっ！",
  "tgt": "「哦哦，欢迎回来\n{码0B}大人！{队员01}さまっ！"
 },
 {
  "id": "014853",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「王様が、お待ちでございます\nさ、どうぞ‥！",
  "tgt": "「国王正等着您\n请进‥！"
 },
 {
  "id": "014854",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「皆、心配しておりました\nさ、どうぞ‥！",
  "tgt": "「大家都很担心您\n快请‥！"
 },
 {
  "id": "014855",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「王様は、もちろん\n私達みんな‥\n---\n{队员01}さまの\nお归りを 待っていたのです。",
  "tgt": "「不用说国王\n我们大家‥\n---\n都在等着\n{队员01}大人回来。"
 },
 {
  "id": "014856",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「やー‥\n{队员01}さまの\nお归りだー‥！",
  "tgt": "「呀——‥\n{队员01}大人\n回来啦‥！"
 },
 {
  "id": "014857",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「王のお部屋ですぞ‥\nおひかえなされ。",
  "tgt": "「这是王之房间‥\n不得无礼。"
 },
 {
  "id": "014858",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「こっ、{码0B}これは\n{队员01}さま！？",
  "tgt": "「这、这不是\n{码0B}大人！？{队员01}さま！？"
 },
 {
  "id": "014859",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「どうぞ中へ‥！\n王さまに お顏を\n見せてあげて下さい！",
  "tgt": "「请进‥！\n快去拜见\n国王陛下吧！"
 },
 {
  "id": "014860",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「なんだね、君たち‥？",
  "tgt": "「你们几个，有何事‥？"
 },
 {
  "id": "014861",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「なんと、{队员01}様！\nお戻りでしたか‥！",
  "tgt": "「什么，{队员01}大人！\n您回来了‥！"
 },
 {
  "id": "014862",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「エリーナさま‥{码0B}‥\n---\nもう、お戻りに\nならないのですか‥‥",
  "tgt": "「艾莉娜大人‥‥\n---\n她再也\n回不来了吗‥‥{码0B}‥\n---\nもう、お戻りに\nならないのですか‥‥"
 },
 {
  "id": "014863",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「いじょうなーし。",
  "tgt": "「一切正常。"
 },
 {
  "id": "014864",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「戦爭のころは\n連日、ここで\nかいぎが 開かれてました。\n---\nでも、戦爭の話し合いなんて\n無いほうが、いいですわ。",
  "tgt": "「战争那阵子\n天天都在这里\n开会。\n---\n不过，开战事的会议\n还是别开的好。"
 },
 {
  "id": "014865",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「この先は、許可なく\nお通しできません。",
  "tgt": "「前方未经许可\n不得通行。"
 },
 {
  "id": "014866",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「ルディアから‥、そなた達が\n捕まったとの 報せが\nあった時には‥\n---\nどうしたものかと\n思ったものだ‥",
  "tgt": "{框04}{立绘8040}「当听闻你们‥在\n卢迪亚\n被捕的消息时‥\n---\n我也曾不知\n如何是好‥"
 },
 {
  "id": "014867",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「姉を探すと、出ていった\n娘が‥\n---\n敵国で、捕らえられて\nいたとは‥！",
  "tgt": "{框04}{立绘8040}「出门寻找姐姐的\n女儿‥\n---\n竟被敌人\n抓走了‥！"
 },
 {
  "id": "014868",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「申しわけありません\nウインディアの王よ‥\n---\n私が ついていながら‥",
  "tgt": "{框06}{立绘C240}「实在抱歉\n温迪亚的王啊‥\n---\n明明有我在身边‥"
 },
 {
  "id": "014869",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{框04}{立绘0040}「いや、それはもう\nよいのだ‥\n---\nそれよりも‥\n{队员02}どのには\nかんしゃしておる‥",
  "tgt": "{框04}{立绘0040}「不，那已经\n不必了…\n---\n比起这个…\n要感谢\n{队员02}大人…"
 },
 {
  "id": "014870",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「あのとおり‥\nルディアは 体面ばかりを\n気にかけて‥\n---\nエリーナの、そうさくを\n許そうとしない‥",
  "tgt": "{框04}{立绘8040}「你也看到了‥\n卢迪亚只顾\n体面‥\n---\n不肯允许\n搜救艾莉娜‥"
 },
 {
  "id": "014871",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{框04}{立绘0040}「それを、あなたは\nやってくれた‥\n---\n族長という 自らの\n立場がありながら‥\n---\n中々、できる事ではない。",
  "tgt": "{框04}{立绘0040}「那件事\n是你做的…\n---\n明知自己身为\n族长的立场…\n---\n却仍做出此举\n实属难得。"
 },
 {
  "id": "014872",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「それよりも‥\nこの先、どうする？\n---\nいずれ、ここにも\nルディアの手が回ろう‥\n---\nむろん、ウインディアとしては\n全力をあげて、そなた達を\nかばう つもりだが‥",
  "tgt": "{框04}{立绘8040}「先不谈这个‥\n今后有何打算？\n---\n迟早卢迪亚的手\n也会伸到这里‥\n---\n当然，温迪亚打算\n倾尽全力\n庇护你们‥"
 },
 {
  "id": "014873",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{框03}{立绘4100}「それですが、父さま‥\n---\nルディアの手が 回る前に\nやっておきたい事が\nあります‥",
  "tgt": "{框03}{立绘4100}「可是，父亲…\n---\n趁卢迪亚的人\n还没找来\n有件事想做…"
 },
 {
  "id": "014874",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{框03}{立绘4100}「わたし達、{色02}風竜{/色}さまに\nお会いして‥\n---\n闻きたいことが、あるんです。",
  "tgt": "{框03}{立绘4100}「我们想拜见\n{色02}风龙{/色}大人…\n---\n有话想问。"
 },
 {
  "id": "014875",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「ふーむ‥、しかし‥\n風竜のことは‥\n---\n王と言えども、何とも‥",
  "tgt": "{框06}{立绘8040}「唔姆‥只是‥\n风龙之事‥\n---\n即便是王，也无能为力‥"
 },
 {
  "id": "014876",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{框06}{立绘4200}「竜の事が‥\n帝国の 探すものの事が\n分かれば‥\n---\n何か、手が打てるのでは\nないかと思うのです。",
  "tgt": "{框06}{立绘4200}「若能弄清龙…\n帝国追寻之物的\n真相…\n---\n或许就能\n想出对策。"
 },
 {
  "id": "014877",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「ふむ‥、わかった。\n---\nならば、東の森に住む\n{色02}風のみこ{/色}に 会うがよい。\n---\n風竜につかえる、みこだ。",
  "tgt": "{框06}{立绘8040}「唔…，知道了。\n---\n那就去见住在\n东边森林的{色02}风之巫女{/色}。\n---\n她是侍奉风龙的巫女。"
 },
 {
  "id": "014878",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「この事、わしの方から\nことづけておく‥\n---\n今日は ゆっくり休み\n明日、出立すると よかろう。",
  "tgt": "{框06}{立绘8040}「此事我会亲自\n派人转告‥\n---\n今日好好休息\n明日启程为佳。"
 },
 {
  "id": "014879",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{立绘8040}「みこの住む森は、東だ。\n---\nルディアが、何か言ってきたら\nごまかしておくから\n心配するな‥",
  "tgt": "{立绘8040}「巫女所居森林在东边。\n---\n卢迪亚若来问起\n我会先敷衍过去\n不必担心‥"
 },
 {
  "id": "014880",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「{队员01}さまを\nかばわねば ならないし‥\n---\nルディアとの 関係も\n悪くできない‥\n---\n難しい お立場ですな\n王様は‥",
  "tgt": "「既要庇护\n{队员01}大人‥\n---\n又不能与卢迪亚\n交恶‥\n---\n国王的处境\n真是为难啊‥"
 },
 {
  "id": "014881",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「エリーナさまの事‥\n誰よりも 心配で\nいらっしゃるのに‥\n---\n人前では、そのことを\n決して口にされない‥\n---\nつらい お立場です\n王様は‥！",
  "tgt": "「明明比谁都\n担心艾莉娜大人\n却从不表露‥\n---\n在人前绝口\n不提此事‥\n---\n王的位置\n真是煎熬啊‥！"
 },
 {
  "id": "014882",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{立绘0000}「ふむ、みこどのが\nそう言われるのなら‥\n---\n{道具0705}\n持って行くがいい！",
  "tgt": "{立绘0000}「唔，既然\n巫女大人这么说…\n---\n就拿上\n{道具0705}去吧！"
 },
 {
  "id": "014883",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「{道具0705}は\n風竜をまつる 風の塔に\n入るための、大切な神具‥\n---\nこの{色02}城の地下{/色}に\nほかんして ございます。",
  "tgt": "「{道具0705}是进入\n供奉风龙的风之塔的\n重要神器…\n---\n保管在这座\n{色02}城的地下{/色}。"
 },
 {
  "id": "014884",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「風竜は‥\n---\nラーウィ様は、人とまみえぬ\n竜の中にあって‥\n---\n人語を解し、語ることをする\nめずらしい存在なのです。",
  "tgt": "「风龙‥\n---\n拉维大人虽身为\n不现于人前的龙‥\n---\n却通人言、会说话\n实属罕见的存在。"
 },
 {
  "id": "014885",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{立绘0000}「地下に入れるよう\nすぐに、取り計らおう‥\n---\nさあ、行け‥！",
  "tgt": "{立绘0000}「我马上去安排\n放你们进地下…\n---\n去吧…！"
 },
 {
  "id": "014886",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「すでに お話は\nうかがっております\nさあ、どうぞ！",
  "tgt": "「事情我们已经\n有所耳闻\n快请进！"
 },
 {
  "id": "014887",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「風の塔って、この城よりも\nずっと 高いそうですよ‥\n---\nもー、たまりませんね！",
  "tgt": "「听说风之塔比\n这座城还要高得多‥\n---\n啊——受不了啦！"
 },
 {
  "id": "014888",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「みこ様は もう長いこと\nカスクの森に住まわれて‥\n---\n風竜様と お会いする時以外\nほとんど、姿をお見せに\nならないのです。",
  "tgt": "「巫女大人在卡斯库\n森林住了很久‥\n---\n除了会见风龙大人\n几乎从不\n现身。"
 },
 {
  "id": "014889",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{立绘0000}「ふむ‥、フエを\n手にしたのなら‥\n---\n城の北にある\n{色02}風の塔{/色}へと 行くがよい。\n---\nそこで、風竜に\nまみえる事が、できよう‥",
  "tgt": "{立绘0000}「唔…，若已\n拿到笛子…\n---\n就去城北的\n{色02}风之塔{/色}吧。\n---\n在那里\n便可见到\n风龙…"
 },
 {
  "id": "014890",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「城の近边では ルディアの\n兵を見た、との話も闻きます\n---\nここに、手が回る前に\nお急ぎなされ。",
  "tgt": "「据说城附近也有人\n见过卢迪亚的士兵\n---\n趁他们的手还没伸到\n请快动身。"
 },
 {
  "id": "014891",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「みこ様が、最後に\nお城へ いらしたのは\n---\n{队员01}様が\nお生まれになった\n時だそうですよ‥",
  "tgt": "「巫女大人最后一次\n来城堡‥\n---\n据说是在\n{队员01}大人\n出生之时哦‥"
 },
 {
  "id": "014892",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「風竜さまを\n近くで 見るには‥\n---\n北の、風の塔から\nさらに高く 上がらないと\nだめなんですよね‥",
  "tgt": "「想近距离\n看风龙大人‥\n---\n就得从北边的\n风之塔再往上爬\n才行呢‥"
 },
 {
  "id": "014893",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「ふぅ、エリーナ様には\nいいなずけの ルディア王子が‥\n---\nはぁ、{队员01}様には\n次期王女としての立場が‥\n---\n道ならぬ愛と\n身分違いの愛\nぼくは、どちらを選べば‥？",
  "tgt": "「唉，艾莉娜大人有\n未婚夫卢迪亚王子‥\n---\n呼，{队员01}大人又有\n下任王女的身份‥\n---\n不伦之爱与\n身份悬殊之爱\n我该选哪个‥？"
 },
 {
  "id": "014894",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「はぁ、{队员01}様の\n愛にこたえることは‥\n---\nウインディアの王として\n国を治めること‥\n---\nぼくに、それが\nできるだろうか‥？",
  "tgt": "「呼，回应{队员01}大人\n的爱意‥\n---\n与作为温迪亚的王\n治理国家‥\n---\n我究竟能不能\n做到啊‥？"
 },
 {
  "id": "014895",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「ふぅ、エリーナ様の\n愛にこたえることは‥\n---\nルディアを敵に回す\nということ‥\n---\nぼくに、エリーナ様を\n守り抜けるだろうか‥？",
  "tgt": "「唉，回应艾莉娜大人\n的爱意‥\n---\n意味着与卢迪亚\n为敌‥\n---\n我究竟能不能\n守护住艾莉娜大人‥？"
 },
 {
  "id": "014896",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "強風に、押し戻される！{延时16}",
  "tgt": "被强风推了回来！{延时16}"
 },
 {
  "id": "014897",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "\n  {色03}{道具0705}{/色}を 手に入れた！",
  "tgt": "\n获得了{色03}{道具0705}{/色}！"
 },
 {
  "id": "014898",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{立绘8040}「ふむう‥‥？\n---\n帝国初代皇帝の\n半身‥？\n---\nルディアや、帝国が\nやっきになる 理由も\nわかるが‥\n---\nなんとも 大きな話だな！",
  "tgt": "{立绘8040}「唔姆‥‥？\n---\n帝国初代皇帝的\n半身‥？\n---\n卢迪亚和帝国为何\n如此执着\n也能理解‥\n---\n真是不得了的大事啊！"
 },
 {
  "id": "014899",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{立绘8040}「{队员01}よ‥\n---\nこと、ここに いたっては\n我が助力の\nおよぶべくも、ない‥\n---\n強くなったな\nいつの間にか‥‥",
  "tgt": "{立绘8040}「{队员01}啊‥\n---\n事到如今\n我的帮助\n已无济于事了‥\n---\n变强了啊\n不知不觉间‥‥"
 },
 {
  "id": "014900",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「お归りが 遲いので\n心配しておりました‥\n---\nラーウィ様には お会い\nできましたかな？",
  "tgt": "「回来得晚了\n我们都很担心‥\n---\n见到拉维\n大人了吗？"
 },
 {
  "id": "014901",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「あのように 言っては\nおられても、やはり\n---\n{队员01}様が\n心配で ならないのです‥\n---\n王様のためにも 早く\nお戻りください‥！",
  "tgt": "「话虽那样说\n可我们还是‥\n---\n担心{队员01}大人\n担心得不行‥\n---\n为了国王也请\n早点回来‥！"
 },
 {
  "id": "014902",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「{队员01}様のこと‥\n---\nくれぐれも よろしく\nお願いしますぞ‥",
  "tgt": "「{队员01}大人的事‥\n---\n一切就拜托\n各位了‥"
 },
 {
  "id": "014903",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「エリーナ様も 戻られず‥\nこの上、{队员01}様に\n何かあっては‥",
  "tgt": "「艾莉娜大人还没回来‥\n要是{队员01}大人\n再出什么事‥"
 },
 {
  "id": "014904",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「{队员01}様と\nエリーナ様の お部屋‥\n---\nいつ 戻ってらしても\nよいよう‥\n---\nキレイに そうじして\n待っております。",
  "tgt": "「{队员01}大人和\n艾莉娜大人的房间‥\n---\n随时回来\n都可以‥\n---\n我们会打扫得\n干干净净恭候。"
 },
 {
  "id": "014905",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「しかし、竜というのは\n変なものですね‥\n---\nラーウィ様なんて\nあんなに 大きいのが\n空に 浮かんでいるなんて！",
  "tgt": "「不过，龙这种生物\n真是奇妙啊‥\n---\n拉维大人那么\n庞大的身躯\n竟浮在空中！"
 },
 {
  "id": "014906",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「ルディアの連中は\nあきらめたのか‥\n---\n最近は この边りで\n見なくなりましたねぇ‥",
  "tgt": "「卢迪亚那帮人\n死心了吗‥\n---\n最近这一带\n都见不着他们了呢‥"
 },
 {
  "id": "014907",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「家族で 食事をかこむ事が\nなくなってから‥\n---\n王様、さみしそうに\nしていらっしゃいます‥",
  "tgt": "「自从不再一家人\n围桌用饭‥\n---\n国王就总显得\n很寂寞‥"
 },
 {
  "id": "014908",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「やや、また何か\nご用ですか？",
  "tgt": "「哟哟，又有什么\n事吗？"
 },
 {
  "id": "014909",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「ああ、{队员01}様と\n結ばれれば‥\n---\nこの城が、町が、民が\n全て ぼくの物に！\n---\nウフ‥、フフフ‥",
  "tgt": "「啊，只要和{队员01}大人\n结为连理‥\n---\n这座城、这镇子、还有子民\n全都归我！\n---\n呼‥、呵呵呵‥"
 },
 {
  "id": "014910",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「風の塔に\n行かれたんですか？\n---\nどうです、高かったでしょ\nいやあ うらやましいなぁ‥",
  "tgt": "「您去了\n风之塔吗？\n---\n如何，很高吧\n真让人羡慕啊‥"
 },
 {
  "id": "014911",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「ここ、空気がうすくて‥\nちょっと 休ませて。",
  "tgt": "「这里空气稀薄‥\n让我歇会儿。"
 },
 {
  "id": "014912",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「水を くみ上げたり\nリフトを 動かしたり‥\n---\n風を利用するだけで\n便利に なるもんだ。",
  "tgt": "「抽水啊\n驱动升降机啊‥\n---\n光是利用风\n就能方便这么多。"
 },
 {
  "id": "014913",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「えー‥\nすでに ご存知と\n思いますが‥\n---\nこの下は、ろうやですよ。",
  "tgt": "「嗯——‥\n想必诸位\n已经知道‥\n---\n这下面是牢房哦。"
 },
 {
  "id": "014914",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「けしきは 美しいし\n空気は おいしいし‥\n---\nなかなか、归る気に\nならないのよね。",
  "tgt": "「风景美丽\n空气清新‥\n---\n让人根本\n不想回去呢。"
 },
 {
  "id": "014915",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{立绘0000}「もはや、そなた達の\nかかわった事は‥\n---\n世界を 動かしかねん\n大事と なっているようだな‥",
  "tgt": "{立绘0000}「你们卷入之事…\n---\n似乎已成了\n足以撼动世界的\n大事…"
 },
 {
  "id": "014916",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "{立绘0000}「戻ったか、{队员01}‥\n---\nいつか、エリーナも\nそのように ひょっこりと‥\n---\n戻るような、気がしてな‥",
  "tgt": "{立绘0000}「回来了啊，{队员01}…\n---\n总觉得艾莉娜\n总有一天也会这样\n---\n突然回来…"
 },
 {
  "id": "014917",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「私は まつり事にしか\nきょうみが ないのですが‥\n---\n今、なにやら世界が\nただならぬ動きを しているのは\n分かりますぞ‥",
  "tgt": "「老朽只对祭祀\n之事有兴趣‥\n---\n不过，如今世界似有\n不同寻常的动向\n老朽知道‥"
 },
 {
  "id": "014918",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「私は まつり事にしか\nきょうみが ないのですが‥\n---\n今、なにやら世界が\nただならぬ動きを しているのは\n分かりますぞ‥",
  "tgt": "「老朽只对祭祀\n之事有兴趣‥\n---\n不过，如今世界似有\n不同寻常的动向\n老朽知道‥"
 },
 {
  "id": "014919",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「{队员01}様のこと\nよろしく お願いいたします‥",
  "tgt": "「{队员01}大人\n就拜托各位了‥"
 },
 {
  "id": "014920",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「{队员01}様‥\n---\nずいぶんと しっかり\nされましたな‥\n---\n姉の エリーナ様に\nにてこられた‥！",
  "tgt": "「{队员01}大人‥\n---\n您变得\n沉稳可靠多了‥\n---\n和姐姐艾莉娜大人\n一模一样了‥！"
 },
 {
  "id": "014921",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「フ、フハハハハ！\n---\n見ろ‥！\n人が、ごみのようだ‥！",
  "tgt": "「呼、呼哈哈哈！\n---\n看啊‥！\n人小得像蝼蚁‥！"
 },
 {
  "id": "014922",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「お城に 忍びこんだ\nコソドロが、捕まってます\n---\n近づかないほうが\nいいですよ‥",
  "tgt": "「潜入王城的\n小偷已经被抓\n---\n最好不要\n靠近哦‥"
 },
 {
  "id": "014923",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「ヘヘ、ドジふんじまった\n---\nけど‥{色03}お宝{/色}はしっかりと\n持ってきたぜ！\n---\nどうだい‥あんたの\n{色03}{占位00}{/色}と\n取り替えてみねえか？{码14000C92}取り替える！\nやめておく‥",
  "tgt": "「嘿嘿，摔了个大跟头\n---\n但…{色03}宝贝{/色}\n可好好带回来了！\n---\n怎么样…用你的\n{色03}{占位00}{/色}\n换换看？{码14000C92}交换！\n算了…"
 },
 {
  "id": "014924",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "\n {色03}{占位01}{/色}と 取り替えた！\n---\n",
  "tgt": "\n换成了{色03}{占位01}{/色}！\n---\n"
 },
 {
  "id": "014925",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「なんでも、ここの\n王様の 宝物らしいぜ‥！",
  "tgt": "「据说好像是这里\n国王的宝物‥！"
 },
 {
  "id": "014926",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "「ドジはふんでも\n{色03}お宝{/色}は 手放さないのが\n一流ってもんだ‥！",
  "tgt": "「就算栽跟头\n宝物也绝不撒手\n这才叫一流‥！{色03}お宝{/色}は 手放さないのが\n一流ってもんだ‥！"
 },
 {
  "id": "014927",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "どこからともなく、ふく風で\n風車がまわっている‥",
  "tgt": "不知从何处吹来的风\n正推动着风车‥"
 },
 {
  "id": "014928",
  "file": "WORLD/AREAS027.EMI",
  "seg": 11,
  "src": "強風に、押し戻される！\nかべの くぼみに隱れて\n風を やりすごそう。{延时60}",
  "tgt": "被强风推了回来！\n躲进墙上的凹处\n等风头过去吧。{延时60}"
 },
 {
  "id": "014929",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "うぃんでぃあのおしろ",
  "tgt": "温迪亚城"
 },
 {
  "id": "014930",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「このリフトは\n風車の力を 利用して\n動かしています。",
  "tgt": "「这座升降机\n是利用风车之力\n驱动的。"
 },
 {
  "id": "014931",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「見はらし、いいでしょ‥\n---\n運が良ければ‥\n風竜さまの 飛んでる姿を\n見る事も できますよ。",
  "tgt": "「视野很好吧‥\n---\n运气好的话‥\n还能看到风龙大人\n飞翔的身影哦。"
 },
 {
  "id": "014932",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「こんな高い所に、住んでて\n怖くないのかな‥",
  "tgt": "「住在这种高处\n不会害怕吗‥"
 },
 {
  "id": "014933",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「我々、ウインディア人は\n高いのが、平気なのです。\n---\nと言うか、高い所は\nむっちゃ好きなのです。",
  "tgt": "「我们温迪亚人\n不怕高的地方。\n---\n不如说，高的地方\n我们超喜欢。"
 },
 {
  "id": "014934",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「おれだって、高いの\n怖かないや‥！",
  "tgt": "「我也不怕\n高的地方‥！"
 },
 {
  "id": "014935",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「ここは、ろうやです。\n---\n見ても、おもしろいって\nものじゃ ありませんよ。",
  "tgt": "「这里是牢房。\n---\n看了也没有什么\n意思哦。"
 },
 {
  "id": "014936",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「ああ、エリーナさま‥\n---\nああ、{码0B}{队员01}さま‥\n---\nお二人とも、美しい‥！\n---\n二人から、同時に\n愛を告げられたら‥\nぼくは、どうしよう？",
  "tgt": "「啊，艾莉娜大人‥\n---\n啊，{码0B}{队员01}大人‥\n---\n二位都如此美丽‥！\n---\n要是两人同时\n向我告白‥\n我该怎么办？"
 },
 {
  "id": "014937",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「この先、いっぱんの方は\nごえんりょ下さい。",
  "tgt": "「前方普通人\n请回避。"
 },
 {
  "id": "014938",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「この先、いっぱんの‥\n---\nえ、{队员01}さま！？",
  "tgt": "「前方普通人‥\n---\n咦，{队员01}大人！？"
 },
 {
  "id": "014939",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「この先は‥\nあ、{码0B}あら‥？\n---\n{队员01}さま！",
  "tgt": "「前方是‥\n啊、哎呀‥？\n---\n{码0B}大人！{队员01}さま！"
 },
 {
  "id": "014940",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「{队员01}さま‥！\nよくぞ お戻り下さいました！",
  "tgt": "「{队员01}大人‥！\n您平安回来了！"
 },
 {
  "id": "014941",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「おお、{码0B}おかえりなさいませ\n{队员01}さまっ！",
  "tgt": "「哦哦，欢迎回来\n{码0B}大人！{队员01}さまっ！"
 },
 {
  "id": "014942",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「王様が、お待ちでございます\nさ、どうぞ‥！",
  "tgt": "「国王正等着您\n请进‥！"
 },
 {
  "id": "014943",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「皆、心配しておりました\nさ、どうぞ‥！",
  "tgt": "「大家都很担心您\n快请‥！"
 },
 {
  "id": "014944",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「王様は、もちろん\n私達みんな‥\n---\n{队员01}さまの\nお归りを 待っていたのです。",
  "tgt": "「不用说国王\n我们大家‥\n---\n都在等着\n{队员01}大人回来。"
 },
 {
  "id": "014945",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「やー‥\n{队员01}さまの\nお归りだー‥！",
  "tgt": "「呀——‥\n{队员01}大人\n回来啦‥！"
 },
 {
  "id": "014946",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「王のお部屋ですぞ‥\nおひかえなされ。",
  "tgt": "「这是王之房间‥\n不得无礼。"
 },
 {
  "id": "014947",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「こっ、{码0B}これは\n{队员01}さま！？",
  "tgt": "「这、这不是\n{码0B}大人！？{队员01}さま！？"
 },
 {
  "id": "014948",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「どうぞ中へ‥！\n王さまに お顏を\n見せてあげて下さい！",
  "tgt": "「请进‥！\n快去拜见\n国王陛下吧！"
 },
 {
  "id": "014949",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「なんだね、君たち‥？",
  "tgt": "「你们几个，有何事‥？"
 },
 {
  "id": "014950",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「なんと、{队员01}様！\nお戻りでしたか‥！",
  "tgt": "「什么，{队员01}大人！\n您回来了‥！"
 },
 {
  "id": "014951",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「エリーナさま‥{码0B}‥\n---\nもう、お戻りに\nならないのですか‥‥",
  "tgt": "「艾莉娜大人‥‥\n---\n她再也\n回不来了吗‥‥{码0B}‥\n---\nもう、お戻りに\nならないのですか‥‥"
 },
 {
  "id": "014952",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「いじょうなーし。",
  "tgt": "「一切正常。"
 },
 {
  "id": "014953",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「戦爭のころは\n連日、ここで\nかいぎが 開かれてました。\n---\nでも、戦爭の話し合いなんて\n無いほうが、いいですわ。",
  "tgt": "「战争那阵子\n天天都在这里\n开会。\n---\n不过，开战事的会议\n还是别开的好。"
 },
 {
  "id": "014954",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「この先は、許可なく\nお通しできません。",
  "tgt": "「前方未经许可\n不得通行。"
 },
 {
  "id": "014955",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{框04}{立绘8040}「ルディアから‥、そなた達が\n捕まったとの 報せが\nあった時には‥\n---\nどうしたものかと\n思ったものだ‥",
  "tgt": "{框04}{立绘8040}「当听闻你们‥在\n卢迪亚\n被捕的消息时‥\n---\n我也曾不知\n如何是好‥"
 },
 {
  "id": "014956",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{框04}{立绘8040}「姉を探すと、出ていった\n娘が‥\n---\n敵国で、捕らえられて\nいたとは‥！",
  "tgt": "{框04}{立绘8040}「出门寻找姐姐的\n女儿‥\n---\n竟被敌人\n抓走了‥！"
 },
 {
  "id": "014957",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{框06}{立绘C240}「申しわけありません\nウインディアの王よ‥\n---\n私が ついていながら‥",
  "tgt": "{框06}{立绘C240}「实在抱歉\n温迪亚的王啊‥\n---\n明明有我在身边‥"
 },
 {
  "id": "014958",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{框04}{立绘0040}「いや、それはもう\nよいのだ‥\n---\nそれよりも‥\n{队员02}どのには\nかんしゃしておる‥",
  "tgt": "{框04}{立绘0040}「不，那已经\n不必了…\n---\n比起这个…\n要感谢\n{队员02}大人…"
 },
 {
  "id": "014959",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{框04}{立绘8040}「あのとおり‥\nルディアは 体面ばかりを\n気にかけて‥\n---\nエリーナの、そうさくを\n許そうとしない‥",
  "tgt": "{框04}{立绘8040}「你也看到了‥\n卢迪亚只顾\n体面‥\n---\n不肯允许\n搜救艾莉娜‥"
 },
 {
  "id": "014960",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{框04}{立绘0040}「それを、あなたは\nやってくれた‥\n---\n族長という 自らの\n立場がありながら‥\n---\n中々、できる事ではない。",
  "tgt": "{框04}{立绘0040}「那件事\n是你做的…\n---\n明知自己身为\n族长的立场…\n---\n却仍做出此举\n实属难得。"
 },
 {
  "id": "014961",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{框04}{立绘8040}「それよりも‥\nこの先、どうする？\n---\nいずれ、ここにも\nルディアの手が回ろう‥\n---\nむろん、ウインディアとしては\n全力をあげて、そなた達を\nかばう つもりだが‥",
  "tgt": "{框04}{立绘8040}「先不谈这个‥\n今后有何打算？\n---\n迟早卢迪亚的手\n也会伸到这里‥\n---\n当然，温迪亚打算\n倾尽全力\n庇护你们‥"
 },
 {
  "id": "014962",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{框03}{立绘4100}「それですが、父さま‥\n---\nルディアの手が 回る前に\nやっておきたい事が\nあります‥",
  "tgt": "{框03}{立绘4100}「可是，父亲…\n---\n趁卢迪亚的人\n还没找来\n有件事想做…"
 },
 {
  "id": "014963",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{框03}{立绘4100}「わたし達、{色02}風竜{/色}さまに\nお会いして‥\n---\n闻きたいことが、あるんです。",
  "tgt": "{框03}{立绘4100}「我们想拜见\n{色02}风龙{/色}大人…\n---\n有话想问。"
 },
 {
  "id": "014964",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{框06}{立绘8040}「ふーむ‥、しかし‥\n風竜のことは‥\n---\n王と言えども、何とも‥",
  "tgt": "{框06}{立绘8040}「唔姆‥只是‥\n风龙之事‥\n---\n即便是王，也无能为力‥"
 },
 {
  "id": "014965",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{框06}{立绘4200}「竜の事が‥\n帝国の 探すものの事が\n分かれば‥\n---\n何か、手が打てるのでは\nないかと思うのです。",
  "tgt": "{框06}{立绘4200}「若能弄清龙…\n帝国追寻之物的\n真相…\n---\n或许就能\n想出对策。"
 },
 {
  "id": "014966",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{框06}{立绘8040}「ふむ‥、わかった。\n---\nならば、東の森に住む\n{色02}風のみこ{/色}に 会うがよい。\n---\n風竜につかえる、みこだ。",
  "tgt": "{框06}{立绘8040}「唔…，知道了。\n---\n那就去见住在\n东边森林的{色02}风之巫女{/色}。\n---\n她是侍奉风龙的巫女。"
 },
 {
  "id": "014967",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{框06}{立绘8040}「この事、わしの方から\nことづけておく‥\n---\n今日は ゆっくり休み\n明日、出立すると よかろう。",
  "tgt": "{框06}{立绘8040}「此事我会亲自\n派人转告‥\n---\n今日好好休息\n明日启程为佳。"
 },
 {
  "id": "014968",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{立绘8040}「みこの住む森は、東だ。\n---\nルディアが、何か言ってきたら\nごまかしておくから\n心配するな‥",
  "tgt": "{立绘8040}「巫女所居森林在东边。\n---\n卢迪亚若来问起\n我会先敷衍过去\n不必担心‥"
 },
 {
  "id": "014969",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「{队员01}さまを\nかばわねば ならないし‥\n---\nルディアとの 関係も\n悪くできない‥\n---\n難しい お立場ですな\n王様は‥",
  "tgt": "「既要庇护\n{队员01}大人‥\n---\n又不能与卢迪亚\n交恶‥\n---\n国王的处境\n真是为难啊‥"
 },
 {
  "id": "014970",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「エリーナさまの事‥\n誰よりも 心配で\nいらっしゃるのに‥\n---\n人前では、そのことを\n決して口にされない‥\n---\nつらい お立場です\n王様は‥！",
  "tgt": "「明明比谁都\n担心艾莉娜大人\n却从不表露‥\n---\n在人前绝口\n不提此事‥\n---\n王的位置\n真是煎熬啊‥！"
 },
 {
  "id": "014971",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{立绘0000}「ふむ、みこどのが\nそう言われるのなら‥\n---\n{道具0705}\n持って行くがいい！",
  "tgt": "{立绘0000}「唔，既然\n巫女大人这么说…\n---\n就拿上\n{道具0705}去吧！"
 },
 {
  "id": "014972",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「{道具0705}は\n風竜をまつる 風の塔に\n入るための、大切な神具‥\n---\nこの{色02}城の地下{/色}に\nほかんして ございます。",
  "tgt": "「{道具0705}是进入\n供奉风龙的风之塔的\n重要神器…\n---\n保管在这座\n{色02}城的地下{/色}。"
 },
 {
  "id": "014973",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「風竜は‥\n---\nラーウィ様は、人とまみえぬ\n竜の中にあって‥\n---\n人語を解し、語ることをする\nめずらしい存在なのです。",
  "tgt": "「风龙‥\n---\n拉维大人虽身为\n不现于人前的龙‥\n---\n却通人言、会说话\n实属罕见的存在。"
 },
 {
  "id": "014974",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{立绘0000}「地下に入れるよう\nすぐに、取り計らおう‥\n---\nさあ、行け‥！",
  "tgt": "{立绘0000}「我马上去安排\n放你们进地下…\n---\n去吧…！"
 },
 {
  "id": "014975",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「すでに お話は\nうかがっております\nさあ、どうぞ！",
  "tgt": "「事情我们已经\n有所耳闻\n快请进！"
 },
 {
  "id": "014976",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「風の塔って、この城よりも\nずっと 高いそうですよ‥\n---\nもー、たまりませんね！",
  "tgt": "「听说风之塔比\n这座城还要高得多‥\n---\n啊——受不了啦！"
 },
 {
  "id": "014977",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「みこ様は もう長いこと\nカスクの森に住まわれて‥\n---\n風竜様と お会いする時以外\nほとんど、姿をお見せに\nならないのです。",
  "tgt": "「巫女大人在卡斯库\n森林住了很久‥\n---\n除了会见风龙大人\n几乎从不\n现身。"
 },
 {
  "id": "014978",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{立绘0000}「ふむ‥、フエを\n手にしたのなら‥\n---\n城の北にある\n{色02}風の塔{/色}へと 行くがよい。\n---\nそこで、風竜に\nまみえる事が、できよう‥",
  "tgt": "{立绘0000}「唔…，若已\n拿到笛子…\n---\n就去城北的\n{色02}风之塔{/色}吧。\n---\n在那里\n便可见到\n风龙…"
 },
 {
  "id": "014979",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「城の近边では ルディアの\n兵を見た、との話も闻きます\n---\nここに、手が回る前に\nお急ぎなされ。",
  "tgt": "「据说城附近也有人\n见过卢迪亚的士兵\n---\n趁他们的手还没伸到\n请快动身。"
 },
 {
  "id": "014980",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「みこ様が、最後に\nお城へ いらしたのは\n---\n{队员01}様が\nお生まれになった\n時だそうですよ‥",
  "tgt": "「巫女大人最后一次\n来城堡‥\n---\n据说是在\n{队员01}大人\n出生之时哦‥"
 },
 {
  "id": "014981",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「風竜さまを\n近くで 見るには‥\n---\n北の、風の塔から\nさらに高く 上がらないと\nだめなんですよね‥",
  "tgt": "「想近距离\n看风龙大人‥\n---\n就得从北边的\n风之塔再往上爬\n才行呢‥"
 },
 {
  "id": "014982",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「ふぅ、エリーナ様には\nいいなずけの ルディア王子が‥\n---\nはぁ、{队员01}様には\n次期王女としての立場が‥\n---\n道ならぬ愛と\n身分違いの愛\nぼくは、どちらを選べば‥？",
  "tgt": "「唉，艾莉娜大人有\n未婚夫卢迪亚王子‥\n---\n呼，{队员01}大人又有\n下任王女的身份‥\n---\n不伦之爱与\n身份悬殊之爱\n我该选哪个‥？"
 },
 {
  "id": "014983",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「はぁ、{队员01}様の\n愛にこたえることは‥\n---\nウインディアの王として\n国を治めること‥\n---\nぼくに、それが\nできるだろうか‥？",
  "tgt": "「呼，回应{队员01}大人\n的爱意‥\n---\n与作为温迪亚的王\n治理国家‥\n---\n我究竟能不能\n做到啊‥？"
 },
 {
  "id": "014984",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「ふぅ、エリーナ様の\n愛にこたえることは‥\n---\nルディアを敵に回す\nということ‥\n---\nぼくに、エリーナ様を\n守り抜けるだろうか‥？",
  "tgt": "「唉，回应艾莉娜大人\n的爱意‥\n---\n意味着与卢迪亚\n为敌‥\n---\n我究竟能不能\n守护住艾莉娜大人‥？"
 },
 {
  "id": "014985",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "強風に、押し戻される！{延时16}",
  "tgt": "被强风推了回来！{延时16}"
 },
 {
  "id": "014986",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "\n  {色03}{道具0705}{/色}を 手に入れた！",
  "tgt": "\n获得了{色03}{道具0705}{/色}！"
 },
 {
  "id": "014987",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{立绘8040}「ふむう‥‥？\n---\n帝国初代皇帝の\n半身‥？\n---\nルディアや、帝国が\nやっきになる 理由も\nわかるが‥\n---\nなんとも 大きな話だな！",
  "tgt": "{立绘8040}「唔姆‥‥？\n---\n帝国初代皇帝的\n半身‥？\n---\n卢迪亚和帝国为何\n如此执着\n也能理解‥\n---\n真是不得了的大事啊！"
 },
 {
  "id": "014988",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{立绘8040}「{队员01}よ‥\n---\nこと、ここに いたっては\n我が助力の\nおよぶべくも、ない‥\n---\n強くなったな\nいつの間にか‥‥",
  "tgt": "{立绘8040}「{队员01}啊‥\n---\n事到如今\n我的帮助\n已无济于事了‥\n---\n变强了啊\n不知不觉间‥‥"
 },
 {
  "id": "014989",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「お归りが 遲いので\n心配しておりました‥\n---\nラーウィ様には お会い\nできましたかな？",
  "tgt": "「回来得晚了\n我们都很担心‥\n---\n见到拉维\n大人了吗？"
 },
 {
  "id": "014990",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「あのように 言っては\nおられても、やはり\n---\n{队员01}様が\n心配で ならないのです‥\n---\n王様のためにも 早く\nお戻りください‥！",
  "tgt": "「话虽那样说\n可我们还是‥\n---\n担心{队员01}大人\n担心得不行‥\n---\n为了国王也请\n早点回来‥！"
 },
 {
  "id": "014991",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「{队员01}様のこと‥\n---\nくれぐれも よろしく\nお願いしますぞ‥",
  "tgt": "「{队员01}大人的事‥\n---\n一切就拜托\n各位了‥"
 },
 {
  "id": "014992",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「エリーナ様も 戻られず‥\nこの上、{队员01}様に\n何かあっては‥",
  "tgt": "「艾莉娜大人还没回来‥\n要是{队员01}大人\n再出什么事‥"
 },
 {
  "id": "014993",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「{队员01}様と\nエリーナ様の お部屋‥\n---\nいつ 戻ってらしても\nよいよう‥\n---\nキレイに そうじして\n待っております。",
  "tgt": "「{队员01}大人和\n艾莉娜大人的房间‥\n---\n随时回来\n都可以‥\n---\n我们会打扫得\n干干净净恭候。"
 },
 {
  "id": "014994",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「しかし、竜というのは\n変なものですね‥\n---\nラーウィ様なんて\nあんなに 大きいのが\n空に 浮かんでいるなんて！",
  "tgt": "「不过，龙这种生物\n真是奇妙啊‥\n---\n拉维大人那么\n庞大的身躯\n竟浮在空中！"
 },
 {
  "id": "014995",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「ルディアの連中は\nあきらめたのか‥\n---\n最近は この边りで\n見なくなりましたねぇ‥",
  "tgt": "「卢迪亚那帮人\n死心了吗‥\n---\n最近这一带\n都见不着他们了呢‥"
 },
 {
  "id": "014996",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「家族で 食事をかこむ事が\nなくなってから‥\n---\n王様、さみしそうに\nしていらっしゃいます‥",
  "tgt": "「自从不再一家人\n围桌用饭‥\n---\n国王就总显得\n很寂寞‥"
 },
 {
  "id": "014997",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「やや、また何か\nご用ですか？",
  "tgt": "「哟哟，又有什么\n事吗？"
 },
 {
  "id": "014998",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「ああ、{队员01}様と\n結ばれれば‥\n---\nこの城が、町が、民が\n全て ぼくの物に！\n---\nウフ‥、フフフ‥",
  "tgt": "「啊，只要和{队员01}大人\n结为连理‥\n---\n这座城、这镇子、还有子民\n全都归我！\n---\n呼‥、呵呵呵‥"
 },
 {
  "id": "014999",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「風の塔に\n行かれたんですか？\n---\nどうです、高かったでしょ\nいやあ うらやましいなぁ‥",
  "tgt": "「您去了\n风之塔吗？\n---\n如何，很高吧\n真让人羡慕啊‥"
 },
 {
  "id": "015000",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「ここ、空気がうすくて‥\nちょっと 休ませて。",
  "tgt": "「这里空气稀薄‥\n让我歇会儿。"
 },
 {
  "id": "015001",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「水を くみ上げたり\nリフトを 動かしたり‥\n---\n風を利用するだけで\n便利に なるもんだ。",
  "tgt": "「抽水啊\n驱动升降机啊‥\n---\n光是利用风\n就能方便这么多。"
 },
 {
  "id": "015002",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「えー‥\nすでに ご存知と\n思いますが‥\n---\nこの下は、ろうやですよ。",
  "tgt": "「嗯——‥\n想必诸位\n已经知道‥\n---\n这下面是牢房哦。"
 },
 {
  "id": "015003",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「けしきは 美しいし\n空気は おいしいし‥\n---\nなかなか、归る気に\nならないのよね。",
  "tgt": "「风景美丽\n空气清新‥\n---\n让人根本\n不想回去呢。"
 },
 {
  "id": "015004",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{立绘0000}「もはや、そなた達の\nかかわった事は‥\n---\n世界を 動かしかねん\n大事と なっているようだな‥",
  "tgt": "{立绘0000}「你们卷入之事…\n---\n似乎已成了\n足以撼动世界的\n大事…"
 },
 {
  "id": "015005",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "{立绘0000}「戻ったか、{队员01}‥\n---\nいつか、エリーナも\nそのように ひょっこりと‥\n---\n戻るような、気がしてな‥",
  "tgt": "{立绘0000}「回来了啊，{队员01}…\n---\n总觉得艾莉娜\n总有一天也会这样\n---\n突然回来…"
 },
 {
  "id": "015006",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「私は まつり事にしか\nきょうみが ないのですが‥\n---\n今、なにやら世界が\nただならぬ動きを しているのは\n分かりますぞ‥",
  "tgt": "「老朽只对祭祀\n之事有兴趣‥\n---\n不过，如今世界似有\n不同寻常的动向\n老朽知道‥"
 },
 {
  "id": "015007",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「私は まつり事にしか\nきょうみが ないのですが‥\n---\n今、なにやら世界が\nただならぬ動きを しているのは\n分かりますぞ‥",
  "tgt": "「老朽只对祭祀\n之事有兴趣‥\n---\n不过，如今世界似有\n不同寻常的动向\n老朽知道‥"
 },
 {
  "id": "015008",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「{队员01}様のこと\nよろしく お願いいたします‥",
  "tgt": "「{队员01}大人\n就拜托各位了‥"
 },
 {
  "id": "015009",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「{队员01}様‥\n---\nずいぶんと しっかり\nされましたな‥\n---\n姉の エリーナ様に\nにてこられた‥！",
  "tgt": "「{队员01}大人‥\n---\n您变得\n沉稳可靠多了‥\n---\n和姐姐艾莉娜大人\n一模一样了‥！"
 },
 {
  "id": "015010",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「フ、フハハハハ！\n---\n見ろ‥！\n人が、ごみのようだ‥！",
  "tgt": "「呼、呼哈哈哈！\n---\n看啊‥！\n人小得像蝼蚁‥！"
 },
 {
  "id": "015011",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「お城に 忍びこんだ\nコソドロが、捕まってます\n---\n近づかないほうが\nいいですよ‥",
  "tgt": "「潜入王城的\n小偷已经被抓\n---\n最好不要\n靠近哦‥"
 },
 {
  "id": "015012",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「ヘヘ、ドジふんじまった\n---\nけど‥{色03}お宝{/色}はしっかりと\n持ってきたぜ！\n---\nどうだい‥あんたの\n{色03}{占位00}{/色}と\n取り替えてみねえか？{码14000C92}取り替える！\nやめておく‥",
  "tgt": "「嘿嘿，摔了个大跟头\n---\n但…{色03}宝贝{/色}\n可好好带回来了！\n---\n怎么样…用你的\n{色03}{占位00}{/色}\n换换看？{码14000C92}交换！\n算了…"
 },
 {
  "id": "015013",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "\n {色03}{占位01}{/色}と 取り替えた！\n---\n",
  "tgt": "\n换成了{色03}{占位01}{/色}！\n---\n"
 },
 {
  "id": "015014",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「なんでも、ここの\n王様の 宝物らしいぜ‥！",
  "tgt": "「据说好像是这里\n国王的宝物‥！"
 },
 {
  "id": "015015",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "「ドジはふんでも\n{色03}お宝{/色}は 手放さないのが\n一流ってもんだ‥！",
  "tgt": "「就算栽跟头\n宝物也绝不撒手\n这才叫一流‥！{色03}お宝{/色}は 手放さないのが\n一流ってもんだ‥！"
 },
 {
  "id": "015016",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "どこからともなく、ふく風で\n風車がまわっている‥",
  "tgt": "不知从何处吹来的风\n正推动着风车‥"
 },
 {
  "id": "015017",
  "file": "WORLD/AREAS028.EMI",
  "seg": 8,
  "src": "強風に、押し戻される！\nかべの くぼみに隱れて\n風を やりすごそう。{延时60}",
  "tgt": "被强风推了回来！\n躲进墙上的凹处\n等风头过去吧。{延时60}"
 },
 {
  "id": "015018",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "ゆうぼくみんのむら",
  "tgt": "游牧民之村"
 },
 {
  "id": "015019",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "「あら、こんな\nへんぴな所に、ようこそ‥",
  "tgt": "「哎呀，欢迎来到\n这么偏僻的地方‥"
 },
 {
  "id": "015020",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "「なんだか、都に\n魔物が 現れたって\nウワサだね‥\n---\nあんた、知ってたかね‥",
  "tgt": "「好像都城里\n冒出了魔物的\n传闻呢‥\n---\n你，听说了吗‥"
 },
 {
  "id": "015021",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "「え、都に 行きたいの？\n---\nこの村で、帝都へ\n行った事 あるのは‥\n---\nそのテントに 住んでる\nジッちゃんだけだよ。",
  "tgt": "「诶，想去都城？\n---\n这村里，去过\n帝都的‥\n---\n只有住那个帐篷的\n吉吉了。"
 },
 {
  "id": "015022",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "「戦爭で使う ウマやオームを\n捕まえて、帝国軍に\n売るんだ‥\n---\n時々、魔物なんかも\n狩ってるぜ。",
  "tgt": "「把战争中用的马和\n奥姆抓来卖给\n帝国军‥\n---\n偶尔也猎猎\n魔物什么的。"
 },
 {
  "id": "015023",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘0000}{码0A}",
  "tgt": "{立绘0000}{码0A}"
 },
 {
  "id": "015024",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘0101}{码0A}\n---\n「ぴっぴき！",
  "tgt": "{立绘0101}{码0A}\n---\n「噼噼叽！"
 },
 {
  "id": "015025",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "「ああ、旅の方‥\n---\nそうですか、帝都へ‥",
  "tgt": "「啊，是旅客啊‥\n---\n这样啊，去帝都‥"
 },
 {
  "id": "015026",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "「でしたら、ジッちゃんに\n話を闻くのが\nいいんですけど‥",
  "tgt": "「那样的话，去打听\n吉吉的事\n比较好‥"
 },
 {
  "id": "015027",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "「少し前に、大事にしてた\nニワトリの コッコちゃんが\n逃げてしまって‥\n---\nそれ以来、ずっと\n放心してるんです‥",
  "tgt": "「不久前，他心爱的\n母鸡科科\n跑掉了‥\n---\n从那以后，他一直\n失魂落魄的‥"
 },
 {
  "id": "015028",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘0202}「うーむ、うーむ‥\nコッコちゃーん。",
  "tgt": "{立绘0202}「唔姆、唔姆‥\n科科——。"
 },
 {
  "id": "015029",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘0302}「ありがとうよ\nワシの コッコちゃんを\n捕まえてくれて‥",
  "tgt": "{立绘0302}「多谢啦\n帮我抓回了\n我的科科‥"
 },
 {
  "id": "015030",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘0302}「それで、帝都へ\n行きたいんじゃな‥？",
  "tgt": "{立绘0302}「那么，你是想去\n帝都吧‥？"
 },
 {
  "id": "015031",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘0302}「ふむ、だったら‥\n---\nずっと東へ 行って\n{色02}ダンの関{/色}を 通るのが\n早いが‥\n---\n今は 通れんかも\n知れんな‥",
  "tgt": "{立绘0302}「唔，那样的话…\n---\n一直往东\n过{色02}丹之关{/色}\n最近…\n---\n不过现在\n可能过不去…"
 },
 {
  "id": "015032",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘0302}「都で、何か\nあったらしくて‥\n---\n関を 閉めておると\n言う話じゃ‥",
  "tgt": "{立绘0302}「都城里好像\n出了什么事‥\n---\n据说关口\n都关了‥"
 },
 {
  "id": "015033",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘0403}「それじゃ、帝都へは‥？",
  "tgt": "{立绘0403}「那要怎么去帝都‥？"
 },
 {
  "id": "015034",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘0302}「うーん‥\n---\n北東に、{色02}皇帝墓所{/色}と\n呼ばれる場所が\nあるんじゃが‥",
  "tgt": "{立绘0302}「嗯…\n---\n东北方向\n有个叫{色02}皇帝墓所{/色}\n的地方…"
 },
 {
  "id": "015035",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘4200}「初代皇帝の、墓‥！？",
  "tgt": "{立绘4200}「初代皇帝的墓…！？"
 },
 {
  "id": "015036",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘0302}「ああ、そうじゃ‥\n---\nそこから、アスタナ方面に\n抜ける道が あるんじゃ。",
  "tgt": "{立绘0302}「啊，对了‥\n---\n从那里有条小路\n能通往阿斯塔纳方向。"
 },
 {
  "id": "015037",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘4100}「分かりました‥！\nありがとう、行ってみます。",
  "tgt": "{立绘4100}「明白了…！\n谢谢，我去看看。"
 },
 {
  "id": "015038",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘0202}「ああ、ところで‥\n---\nおじょうちゃん、どこかで\n会った事、なかったかね？",
  "tgt": "{立绘0202}「啊，话说‥\n---\n小姑娘，我们是不是\n在哪里见过？"
 },
 {
  "id": "015039",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘0503}「え、わたし‥？\n---\n{立绘0603}いえ、{码0B}ないです\nおじいさん‥",
  "tgt": "{立绘0503}「诶，我‥？\n---\n{立绘0603}不，没有\n老爷爷‥{码0B}ないです\nおじいさん‥"
 },
 {
  "id": "015040",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘0302}「ふーん‥\nまあ、ええ‥\n---\n{色02}皇帝の墓所{/色}は\n魔物が 多いから\n気をつけてな。",
  "tgt": "{立绘0302}「哦…\n嘛，行…\n---\n{色02}皇帝墓所{/色}\n魔物多\n路上小心。"
 },
 {
  "id": "015041",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "「んー？\n墓所の、抜け道‥？\n---\nああ、ジッちゃんと\nアスタナに 魔物を\n売りに行ったとき‥\n---\nそんな話を 闻いたな。",
  "tgt": "「唔——？\n墓所的小路‥？\n---\n啊，和吉吉去\n阿斯塔纳卖魔物的\n时候‥\n---\n听说过这事。"
 },
 {
  "id": "015042",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{金钱00}「いらっしゃい‥\nゆっくり 見てってよ。{码14840C94}何か買おう\n持ち物を売ろう\n武器を下取りしてもらおう\n今は用がない‥",
  "tgt": "{金钱00}「欢迎光临…\n慢慢看吧。{码14840C94}买点什么\n卖点东西\n折卖武器\n现在不用…"
 },
 {
  "id": "015043",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "「とー、とっとっと‥",
  "tgt": "「咕——、咕咕咕‥"
 },
 {
  "id": "015044",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘0704}{码0A}{队员3C}こっけ。",
  "tgt": "{立绘0704}{码0A}{队员3C}咯咔。"
 },
 {
  "id": "015045",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘0704}{码0A}{色3C}けっこ。",
  "tgt": "{立绘0704}{码0A}{色3C}结婚。"
 },
 {
  "id": "015046",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘0704}{码0A}{码03}「くっく。",
  "tgt": "{立绘0704}{码0A}{码03}「咕咕。"
 },
 {
  "id": "015047",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘0805}{码0A}\n「スープー‥",
  "tgt": "{立绘0805}{码0A}\n「咕噜——‥"
 },
 {
  "id": "015048",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "「ジッちゃんの ニワトリ‥\n---\n『さく』を作って、追いこもうと\nしたんですけど\n逃げ足が 速くって‥\n---\nまだ、{色02}西の平原{/色}に行けば\nいるんじゃないかしら？",
  "tgt": "「老爷爷的鸡…\n---\n做了『栅栏』想把它们\n赶进去\n可它们跑得太快…\n---\n去{色02}西边平原{/色}\n应该还有吧？"
 },
 {
  "id": "015049",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "「トリさんに、おヨもだちが\nできたの‥\n---\nおれいに、アタシの\nたからもヨ‥あげユ！",
  "tgt": "「小鸟交到\n新朋友了‥\n---\n作为谢礼，我的\n宝物也‥送给哟你！"
 },
 {
  "id": "015050",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "\n  {色03}{占位00}{/色}を もらった！",
  "tgt": "\n  收下了{色03}{占位00}{/色}！"
 },
 {
  "id": "015051",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "「トリさんに、おヨもだちが\nできたの‥ありがとう",
  "tgt": "「小鸟交到\n新朋友了‥谢谢"
 },
 {
  "id": "015052",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "「皇帝のお墓の\n近くの 森でね‥\n---\nこの前、おっきな火事が\nあったんだよ！",
  "tgt": "「皇帝陵墓\n附近的森林里‥\n---\n前几天，着了\n一场大火呢！"
 },
 {
  "id": "015053",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "「皇帝様の お墓参り？\n---\n帝都に行くんじゃ\nなかったのかい‥？",
  "tgt": "「去拜谒皇帝陵墓？\n---\n不是要去\n帝都的吗‥？"
 },
 {
  "id": "015054",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘0704}{码0A}{/色}「けこ。",
  "tgt": "{立绘0704}{码0A}{/色}「咔咯。"
 },
 {
  "id": "015055",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘0302}「{色02}皇帝の墓所{/色}で\n魔物を 捕まえて‥\n---\nアスタナまで、売りに\n行った事が あってな‥\n---\nその時、抜け道を\n見つけたんじゃ。",
  "tgt": "{立绘0302}「在{色02}皇帝墓所{/色}\n抓过魔物…\n---\n还运到阿斯塔纳\n卖过…\n---\n那时发现了\n一条捷径。"
 },
 {
  "id": "015056",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "「ありがとう、旅の人\n---\nおかげで ジッちゃんも\n元気になりました。",
  "tgt": "「谢谢，旅客\n---\n多亏了你，吉吉也\n打起精神了。"
 },
 {
  "id": "015057",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{立绘0906}{码0A}\n「こっこ。",
  "tgt": "{立绘0906}{码0A}\n「咯咯。"
 },
 {
  "id": "015058",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{框21}{打字02}色違いのニワトリ‥{色02}コッコちゃん{/色}を\n追いかけて、真ん中にある\n{色03}さく{/色}の中に 追いこみます。\n---\n{色02}コッコちゃん{/色}を 追いこむと\nさくの入り口が 閉まって\nゲームクリア！\n---\nこの時、他のニワトリも\nまとめて 捕まえると‥\nあとで良い事があるかも？\n---\n\n  もう一度、說明を讀みますか？{码14000C82}はい\nいいえ",
  "tgt": "{框21}{打字02}追赶异色的鸡…{色02}科科鸡{/色}\n把它赶进中间的\n{色03}栅栏{/色}里。\n---\n赶进{色02}科科鸡{/色}后\n栅栏入口就会关闭\n游戏过关！\n---\n这时若把其他鸡\n也一并赶进去…\n之后说不定有好事？\n---\n\n  要再读一次说明吗？{码14000C82}是\n否"
 },
 {
  "id": "015059",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "\n ゲームを中止して 外に出ますか？{码14010CC2}はい\nいいえ",
  "tgt": "\n要中止游戏出去吗？是\n否{码14010CC2}はい\nいいえ"
 },
 {
  "id": "015060",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "\n  {色02}コッコちゃん{/色}を 捕まえた！",
  "tgt": "\n  抓住了{色02}科科鸡{/色}！"
 },
 {
  "id": "015061",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "      BONUS！\n     {色02}{占位00}{/色}PTS",
  "tgt": "      BONUS！\n     {色02}{占位00}{/色}PTS"
 },
 {
  "id": "015062",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "「なんにも ないけど\n休んで 行きな‥\n---\n{金钱00}泊まってくなら\n{占位00}ゼニーだよ。{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく",
  "tgt": "「虽没什么可招待的\n歇脚再走吧…\n---\n{金钱00}要住的话\n{占位00}泽尼。{码14860C93}住一晚\n只记录旅程\n算了"
 },
 {
  "id": "015063",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "「わるいねえ‥\nお金が 足りないよ。",
  "tgt": "「抱歉啊‥\n钱不够哦。"
 },
 {
  "id": "015064",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "{框21}{打字02}野生の ブタを追いかけて\n真ん中にある {色03}さく{/色}の中に\n追いこみます。\n---\n{色02}親ブタ{/色}を 追いこむと\nさくの入り口が 閉まって\nゲームクリア！\n---\nこの時、他のブタも\nまとめて 捕まえると‥\nあとで良い事があるかも？\n---\n\n  もう一度、說明を讀みますか？{码14020C82}はい\nいいえ",
  "tgt": "{框21}{打字02}追赶野猪\n把它们赶进中间的\n{色03}栅栏{/色}里。\n---\n赶进{色02}母猪{/色}后\n栅栏入口就会关闭\n游戏过关！\n---\n这时若把其他猪\n也一并赶进去…\n之后说不定有好事？\n---\n\n  要再读一次说明吗？{码14020C82}是\n否"
 },
 {
  "id": "015065",
  "file": "WORLD/AREAS029.EMI",
  "seg": 11,
  "src": "\n    {色02}親ブタ{/色}を 捕まえた！",
  "tgt": "\n    抓住了{色02}母猪{/色}！"
 },
 {
  "id": "015066",
  "file": "WORLD/AREAS030.EMI",
  "seg": 11,
  "src": "{立绘0000}{立绘0101}{立绘0202}{立绘0303}{立绘0404}{立绘0505}{立绘0606}{立绘0707}{立绘0808}{立绘0909}{立绘0A0A}{立绘0B0B}{立绘0C0C}{立绘0D0D}{立绘0E0E}{立绘0F0F}",
  "tgt": "{立绘0000}{立绘0101}{立绘0202}{立绘0303}{立绘0404}{立绘0505}{立绘0606}{立绘0707}{立绘0808}{立绘0909}{立绘0A0A}{立绘0B0B}{立绘0C0C}{立绘0D0D}{立绘0E0E}{立绘0F0F}"
 },
 {
  "id": "015067",
  "file": "WORLD/AREAS030.EMI",
  "seg": 11,
  "src": "ねぶくろだ",
  "tgt": "睡袋呀"
 },
 {
  "id": "015068",
  "file": "WORLD/AREAS030.EMI",
  "seg": 11,
  "src": "休む",
  "tgt": "休息"
 },
 {
  "id": "015069",
  "file": "WORLD/AREAS030.EMI",
  "seg": 11,
  "src": "やめておく",
  "tgt": "还是算了"
 },
 {
  "id": "015070",
  "file": "WORLD/AREAS030.EMI",
  "seg": 11,
  "src": "日記だ",
  "tgt": "日记呀"
 },
 {
  "id": "015071",
  "file": "WORLD/AREAS030.EMI",
  "seg": 11,
  "src": "{框8A}{码14820C82}はい\nいいえ",
  "tgt": "{框8A}{码14820C82}是\n否"
 },
 {
  "id": "015072",
  "file": "WORLD/AREAS030.EMI",
  "seg": 11,
  "src": "{框88}{码14820C82}はい\nいいえ",
  "tgt": "{框88}{码14820C82}是\n否"
 },
 {
  "id": "015073",
  "file": "WORLD/AREAS030.EMI",
  "seg": 11,
  "src": "どちらのまき物を見ますか？",
