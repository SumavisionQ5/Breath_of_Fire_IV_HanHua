 {
  "id": "002062",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "さきがけ：敵よりも早く、行動できる",
  "tgt": "先锋：可先于敌人行动"
 },
 {
  "id": "002063",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "のんびり：目をはなすと‥",
  "tgt": "悠闲：视线一移开‥"
 },
 {
  "id": "002064",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "おいうち：コンボ時、弱っている敵にトドメをさす",
  "tgt": "追击：连击时给虚弱之敌最后一击"
 },
 {
  "id": "002065",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "かんさつ：攻撃を見切る（ラーニング率UP）",
  "tgt": "观察：看破攻击（学习率UP）"
 },
 {
  "id": "002066",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "なきむし：反撃がでたら「必殺」になる",
