  "src": "{色03}醉い{/色}",
  "tgt": "{色03}醉意{/色}"
 },
 {
  "id": "013412",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "あっさり食事",
  "tgt": "清淡餐食"
 },
 {
