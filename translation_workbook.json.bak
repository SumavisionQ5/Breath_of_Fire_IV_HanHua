  "seg": 11,
  "src": "こってり食事",
  "tgt": "浓味餐食"
 },
 {
  "id": "013415",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "きついお酒",
  "tgt": "烈酒"
 },
 {
