  "file": "WORLD/D141BTL.EMI",
  "seg": 5,
  "src": "方向キー上下：コマンドを選択\n \n{色0A}○{/色}：決定  {色0A}×{/色}：宿屋を出る",
  "tgt": "方向键上下：选择指令\n\n○：确定×：离开旅店{色0A}○{/色}：決定  {色0A}×{/色}：宿屋を出る"
 },
 {
  "id": "017292",
  "file": "WORLD/D141BTL.EMI",
  "seg": 5,
  "src": "{框01}{打字02} \n    {色02}セーブ{/色}しますか？{码11}{码14820C82}はい\nいいえ",
  "tgt": "{框01}{打字02} \n    要{色02}存档{/色}吗？{码11}{码14820C82}是\n否"
 },
 {
  "id": "017293",
  "file": "WORLD/D141BTL.EMI",
  "seg": 5,
  "src": "{框06}{立绘C140}「ここでは、ムリみたい‥",
  "tgt": "{框06}{立绘C140}「这里好像不行‥"
 },
 {
  "id": "017294",
  "file": "WORLD/D141BTL.EMI",
  "seg": 5,
  "src": "\n{色03}{占位00}{/色} を手に入れた！",
  "tgt": "\n获得{色03}{占位00}{/色}！"
 },
 {
  "id": "017295",
  "file": "WORLD/D141BTL.EMI",
  "seg": 5,
  "src": "\n  いたい！ケムシにさされた‥",
  "tgt": "\n好痛！被毛毛虫刺了‥"
 },
 {
  "id": "017296",
  "file": "WORLD/D141BTL.EMI",
  "seg": 5,
  "src": "{色03}{占位00}{/色} を手に入れた！\nしかし、持ち物がいっぱいだ！",
  "tgt": "获得{色03}{占位00}{/色}！\n但是，行李已满！"
 },
 {
  "id": "017297",
  "file": "WORLD/D141BTL.EMI",
  "seg": 5,
  "src": "「こわせそうだ‥",
  "tgt": "「好像能打破‥"
 },
 {
  "id": "017298",
  "file": "WORLD/D141BTL.EMI",
  "seg": 5,
  "src": "\n  {占位00}ゼニー を手に入れた！",
  "tgt": "\n  获得{占位00}泽尼！"
 },
 {
  "id": "017299",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "るでぃあのおしろのなか",
  "tgt": "卢迪亚城内"
 },
 {
  "id": "017300",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框04}{立绘8040}「休戦中の 敵国に\nしのびこんで‥\n---\n発見されて\n送り返されるなどと‥\n---\n武人として、族長として\n許されることでは、ない！",
  "tgt": "{框04}{立绘8040}「停战期间\n潜入敌国‥\n---\n被对方发现\n遣送回来‥\n---\n作为武人、作为族长\n这都不可原谅！"
 },
 {
  "id": "017301",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框04}{立绘8040}「その上‥、{队员02}‥\n---\nそなたは 我が連合の\n『あかし』である‥\n---\n{色03}{道具0101}{/色}を\n無くしたとも闻く‥",
  "tgt": "{框04}{立绘8040}「而且‥{队员02}\n---\n你是我联合的\n『见证』啊‥\n---\n听闻你连{色03}{道具0101}{/色}\n都弄丢了‥"
 },
 {
  "id": "017302",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框04}{立绘8040}「そなた ひとりの\nかるはずみな 行いが‥\n---\n連合すべてにとって\n不利となることを\nわきまえぬか‥！",
  "tgt": "{框04}{立绘8040}「你一个人的\n轻率之举‥\n---\n会给整个联合\n带来多么不利的\n后果，你心中无数吗‥！"
 },
 {
  "id": "017303",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框03}{立绘4200}「そのような 体面ばかり\n気になさるが‥",
  "tgt": "{框03}{立绘4200}「您只在意\n那种体面…"
 },
 {
  "id": "017304",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框03}{立绘0101}「一国の 王女が‥\n---\n{立绘0201}「エリーナが、現に\n帝国に 連れさられて\nいるのですよ！？",
  "tgt": "{框03}{立绘0101}「堂堂一国之公主‥\n---\n{立绘0201}「可艾莉娜现在\n正被帝国\n掳走啊！？"
 },
 {
  "id": "017305",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框04}{立绘8040}「我らは、ひとりの王女より\n連合の国々と、その民を\n守らねば ならんのだ！",
  "tgt": "{框04}{立绘8040}「我们必须守护的是\n整个联合诸国与其子民\n而非一位公主！"
 },
 {
  "id": "017306",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}「ただ今‥ {队员02}さまは\n取り調べ中で‥\n---\n誰も ここを通すワケには\nいかないのです‥！",
  "tgt": "{立绘0302}「现在‥{队员02}大人\n正在接受调查‥\n---\n谁都不能\n放行‥！"
 },
 {
  "id": "017307",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘0403}「その、にいさ‥\n{队员02}さまにとって\n大事な お話なんです！\n---\n実は、{道具0101}が‥{引0900}",
  "tgt": "{立绘0403}「那个、哥哥‥\n我有要事要告诉\n{队员02}大人啊！\n---\n其实，{道具0101}它‥{引0900}"
 },
 {
  "id": "017308",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框04}{立绘8040}「{道具0101}は、ここにある！",
  "tgt": "{框04}{立绘8040}「{道具0101}就在这里！"
 },
 {
  "id": "017309",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框06}{立绘8040}「先ほど‥、帝国より\nとどけられた。",
  "tgt": "{框06}{立绘8040}「方才‥帝国\n送还了它。"
 },
 {
  "id": "017310",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框06}{立绘8040}「ヤツらは、これをタテに‥\n---\n我らに 不利な\n休戦の条約を\n持ち出してきたぞ！",
  "tgt": "{框06}{立绘8040}「他们正以此要挟‥\n---\n向我们提出了\n条件不利的\n停战条约！"
 },
 {
  "id": "017311",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框03}{立绘0403}「しかし、それは\n姉さまを‥",
  "tgt": "{框03}{立绘0403}「可是，那样\n姐姐大人她‥"
 },
 {
  "id": "017312",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框06}{立绘8040}「もはや、女子供の\n口をはさむ 話ではない！",
  "tgt": "{框06}{立绘8040}「此事已容不得\n妇孺插嘴！"
 },
 {
  "id": "017313",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框06}{立绘0040}「‥{队员02}の しょばつ\nかるくはないと、心得よ！",
  "tgt": "{框06}{立绘0040}「…{队员02}的处罚\n不会轻，记住了！"
 },
 {
  "id": "017314",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框03}{立绘0403}「そんな‥、{码0B}兄さま‥",
  "tgt": "{框03}{立绘0403}「怎么会‥哥哥‥{码0B}兄さま‥"
 },
 {
  "id": "017315",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框03}{立绘0504}「こりゃ、{队员03}‥\nちゃんと 見はらんか！\n---\nニセモノの 剣など\n作らせおって‥！",
  "tgt": "{框03}{立绘0504}「好你个{队员03}‥\n让你好好看守！\n---\n竟让人仿造\n假剑‥！"
 },
 {
  "id": "017316",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框06}{立绘C340}「み‥",
  "tgt": "{框06}{立绘C340}「我‥"
 },
 {
  "id": "017317",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框06}{立绘C340}「見はれと、言われたけど‥\n---\n止めろ、とは‥\n---\n言われて‥、ない‥",
  "tgt": "{框06}{立绘C340}「虽然您让我看守‥\n---\n可没说过\n---\n要阻止‥啊‥"
 },
 {
  "id": "017318",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框03}{立绘0504}「くー‥‥\n---\nつ、次は 何かあったら\nすぐに 報せるんだ‥\n分かったな？",
  "tgt": "{框03}{立绘0504}「哼——‥‥\n---\n下、下次再出事\n要立刻上报‥\n听见没有？"
 },
 {
  "id": "017319",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框02}{立绘0302}「ただ今、重要なお調べの\n最中です‥\n---\n何人の、面会も\n許されません。",
  "tgt": "{框02}{立绘0302}「现在正值重要\n调查之中‥\n---\n任何人的会面\n都不允许。"
 },
 {
  "id": "017320",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框03}{立绘8544}「そういう事です\n{队员01}どの‥",
  "tgt": "{框03}{立绘8544}「正是如此\n{队员01}大人‥"
 },
 {
  "id": "017321",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框03}{立绘8544}「{队员02}どのは\n一族の、長‥\n---\nあなたのように\n見はりを つけただけで\n許されるものでは、ない。",
  "tgt": "{框03}{立绘8544}「{队员02}大人\n乃一族之长‥\n---\n不像你那样\n派个人看守\n就能了事的。"
 },
 {
  "id": "017322",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框06}{立绘8544}「残念ですが\nおひきとり願うほか\nありません‥\n---\n{队员03}、しっかり\nお見はりせよ！",
  "tgt": "{框06}{立绘8544}「遗憾得很\n只能请您\n回去了‥\n---\n{队员03}，打起精神\n好好看守！"
 },
 {
  "id": "017323",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}「申しわけありませんが\nお通しできません。\n---\n{立绘FFFF}",
  "tgt": "{立绘0302}「非常抱歉\n不能放您过去。\n---\n{立绘FFFF}"
 },
 {
  "id": "017324",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘8645}「{队员02}さまの\n取り調べは‥\n何日かかるか、分かりません。\n---\n町の‥ お部屋で\nお待ち下さい。",
  "tgt": "{立绘8645}「对{队员02}大人的\n调查‥\n不知要花多少天。\n---\n请在镇上的‥客房\n稍候。"
 },
 {
  "id": "017325",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}「いいなずけの、エリーナ様が\n行方不明だってのに‥\n---\nまったく、おエラ方の\n考えることは、分からんね‥",
  "tgt": "{立绘0302}「未婚夫的艾莉娜大人\n下落不明‥\n---\n大人物们的想法\n真让人搞不懂‥"
 },
 {
  "id": "017326",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘8645}「{队员02}も\n気の毒になぁ‥",
  "tgt": "{立绘8645}「{队员02}也\n真可怜啊‥"
 },
 {
  "id": "017327",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}「すみませんが‥\n通すわけには、いきません。",
  "tgt": "{立绘0302}「抱歉‥\n我们不能放行。"
 },
 {
  "id": "017328",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘C140}「しっかり 見はってますね‥",
  "tgt": "{立绘C140}「看得真紧啊‥"
 },
 {
  "id": "017329",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘8443}「わけを話して お願いしても\nだめでしょうね‥",
  "tgt": "{立绘8443}「就算说明缘由\n去求情也没用吧‥"
 },
 {
  "id": "017330",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘8645}「ンフー‥ンフー‥ン{码0B}プフー‥",
  "tgt": "{立绘8645}「呼呼—‥呼呼—‥噗呼—‥{码0B}プフー‥"
 },
 {
  "id": "017331",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{框20}\n    {色02}けいびへい{/色}を倒せ！\n---\nチャンスは{色02}1ターン{/色}\n仲間を 呼ばれる前に\n素早く 倒そう！\n---\nコンボアタックを使うと\n有利に戦えます。",
  "tgt": "{框20}\n    打倒{色02}警卫兵{/色}！\n---\n机会只有{色02}1回合{/色}\n趁他还没叫帮手\n迅速放倒！\n---\n用连击攻击\n能占得先机。"
 },
 {
  "id": "017332",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘0702}「ウーン‥イタタ‥",
  "tgt": "{立绘0702}「唔嗯‥哎哟‥"
 },
 {
  "id": "017333",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘0702}「{特效}{/特效}\n---\nヒ{码0E}、ヒエーッ！\n---\nた、大変だーっ！",
  "tgt": "{立绘0702}「\n---\n咿、咿呀！\n---\n大、大事不好啦！{特效}{/特效}\n---\nヒ{码0E}、ヒエーッ！\n---\nた、大変だーっ！"
 },
 {
  "id": "017334",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}「ウ‥グゥム‥‥",
  "tgt": "{立绘0302}「唔‥咕噜姆‥‥"
 },
 {
  "id": "017335",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}「{特效}{/特效}\n---\nウ{码0E}、ウヘェーッ！\n---\nお、おたすけーっ！",
  "tgt": "{立绘0302}「\n---\n呜、呜哇呀！\n---\n救、救命啊！{特效}{/特效}\n---\nウ{码0E}、ウヘェーッ！\n---\nお、おたすけーっ！"
 },
 {
  "id": "017336",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}「{特效}{/特效}{码08}クルクルクル{码0E}‥",
  "tgt": "{立绘0302}「咕噜咕噜咕噜‥{特效}{/特效}{码08}クルクルクル{码0E}‥"
 },
 {
  "id": "017337",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}「{特效}{/特效}\n---\nホ{码0E}、ホエーッ！\n---\nだ、誰かーっ！",
  "tgt": "{立绘0302}「\n---\n吼、吼嗷！\n---\n来、来人啊！{特效}{/特效}\n---\nホ{码0E}、ホエーッ！\n---\nだ、誰かーっ！"
 },
 {
  "id": "017338",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}「スピー‥スピー‥{码0B}ップピー‥",
  "tgt": "{立绘0302}「呼咝‥呼咝‥噗咝—‥{码0B}ップピー‥"
 },
 {
  "id": "017339",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘C140}「{队员03}さん‥\n---\n止めないんですか？",
  "tgt": "{立绘C140}「{队员03}先生‥\n---\n不阻止他们吗？"
 },
 {
  "id": "017340",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘4300}「報せろ、と‥\n---\n言われた‥、けど‥\n---\n止めろとは‥‥\n---\n言って、ない。",
  "tgt": "{立绘4300}「让我去报告…\n---\n是说了…，但是…\n---\n阻止你们的话…\n---\n没说。"
 },
 {
  "id": "017341",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘C140}「‥{码0B}‥{码0B}‥\n---\n{立绘FFFF}{立绘8843}やさしいんですね。",
  "tgt": "{立绘C140}「‥‥‥\n---\n{码0B}原来你很温柔啊。{码0B}‥\n---\n{立绘FFFF}{立绘8843}やさしいんですね。"
 },
 {
  "id": "017342",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}「連合どうしで、何やら\nもめてるらしい‥\n---\n今度、戦爭が始まったら\n負けちまうかもな。",
  "tgt": "{立绘0302}「听说联盟之间\n好像起了什么争执‥\n---\n这次要是开战\n说不定我们就输了呢。"
 },
 {
  "id": "017343",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘8645}「まあ、いろいろと\n取り込んでる‥ってことだ\n---\nすまんが、ここを通す\nワケには いかないよ。",
  "tgt": "{立绘8645}「也就是说，最近\n诸事缠身‥\n---\n抱歉，这里\n不能放你过去。"
 },
 {
  "id": "017344",
  "file": "WORLD/D141BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}{立绘8645}「ただいま 城內は\n  立ち入り禁止です！",
  "tgt": "{立绘0302}{立绘8645}「目前城内\n禁止进入！"
 },
 {
  "id": "017345",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "何かないかな？",
  "tgt": "有什么好东西吗？"
 },
 {
  "id": "017346",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "何もない！",
  "tgt": "什么都没有！"
 },
 {
  "id": "017347",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "{色03}{占位00}{/色}を {占位01}コ\n手に入れた",
  "tgt": "获得{色03}{占位00}{/色} {占位01}个"
 },
 {
  "id": "017348",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "{色03}{占位00}{/色}を {占位01}コ\n見つけた\n---\nしかし、持ち物がいっぱいだ！",
  "tgt": "找到{色03}{占位00}{/色} {占位01}个\n---\n但是，行李已满！"
 },
 {
  "id": "017349",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "{色03}{占位00}ゼニー{/色} を手に入れた！",
  "tgt": "获得{色03}{占位00}泽尼{/色}！"
 },
 {
  "id": "017350",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "{色03}{占位00}{/色}を {占位01}コ\n見つけた\n---\nしかし、すべては拾えない！\n持てる分だけ拾いますか？\n{色02}ふたたび拾うことはできません{/色}{码14830C02}はい\nいいえ",
  "tgt": "找到{色03}{占位00}{/色} {占位01}个\n---\n但是，无法全部拾取！\n只拾取拿得下的部分吗？\n{色02}无法再次拾取{/色}{码14830C02}是\n否"
 },
 {
  "id": "017351",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "買う",
  "tgt": "购买"
 },
 {
  "id": "017352",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "売る",
  "tgt": "出售"
 },
 {
  "id": "017353",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "下取り",
  "tgt": "以旧换新"
 },
 {
  "id": "017354",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "やめる",
  "tgt": "取消"
 },
 {
  "id": "017355",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "アイテムを 買います",
  "tgt": "购买道具"
 },
 {
  "id": "017356",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "装備を 買います",
  "tgt": "购买装备"
 },
 {
  "id": "017357",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "持ち物を 売ります",
  "tgt": "出售随身物品"
 },
 {
  "id": "017358",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "装備を 下取りします",
  "tgt": "装备以旧换新"
 },
 {
  "id": "017359",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "ショップを 出ます",
  "tgt": "离开商店"
 },
 {
  "id": "017360",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "方向キー上下：コマンドを選択\n \n{色0A}○{/色}：決定  {色0A}×{/色}：ショップを出る",
  "tgt": "方向键上下：选择指令\n\n○：确定×：离开商店{色0A}○{/色}：決定  {色0A}×{/色}：ショップを出る"
 },
 {
  "id": "017361",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "とまる",
  "tgt": "投宿"
 },
 {
  "id": "017362",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "セーブ",
  "tgt": "存档"
 },
 {
  "id": "017363",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "やめる",
  "tgt": "取消"
 },
 {
  "id": "017364",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "ひとばんとまって 元気になります",
  "tgt": "住一晚恢复体力"
 },
 {
  "id": "017365",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "メモリーカードに セーブします",
  "tgt": "存档至存储卡"
 },
 {
  "id": "017366",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "宿屋を 出ます",
  "tgt": "离开旅店"
 },
 {
  "id": "017367",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "方向キー上下：コマンドを選択\n \n{色0A}○{/色}：決定  {色0A}×{/色}：宿屋を出る",
  "tgt": "方向键上下：选择指令\n\n○：确定×：离开旅店{色0A}○{/色}：決定  {色0A}×{/色}：宿屋を出る"
 },
 {
  "id": "017368",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "{框01}{打字02} \n    {色02}セーブ{/色}しますか？{码11}{码14820C82}はい\nいいえ",
  "tgt": "{框01}{打字02} \n    要{色02}存档{/色}吗？{码11}{码14820C82}是\n否"
 },
 {
  "id": "017369",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "{框06}{立绘C140}「ここでは、ムリみたい‥",
  "tgt": "{框06}{立绘C140}「这里好像不行‥"
 },
 {
  "id": "017370",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "\n{色03}{占位00}{/色} を手に入れた！",
  "tgt": "\n获得{色03}{占位00}{/色}！"
 },
 {
  "id": "017371",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "\n  いたい！ケムシにさされた‥",
  "tgt": "\n好痛！被毛毛虫刺了‥"
 },
 {
  "id": "017372",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "{色03}{占位00}{/色} を手に入れた！\nしかし、持ち物がいっぱいだ！",
  "tgt": "获得{色03}{占位00}{/色}！\n但是，行李已满！"
 },
 {
  "id": "017373",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "「こわせそうだ‥",
  "tgt": "「好像能打破‥"
 },
 {
  "id": "017374",
  "file": "WORLD/D142BTL.EMI",
  "seg": 5,
  "src": "\n  {占位00}ゼニー を手に入れた！",
  "tgt": "\n  获得{占位00}泽尼！"
 },
 {
  "id": "017375",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "るでぃあのおしろのなか",
  "tgt": "卢迪亚城内"
 },
 {
  "id": "017376",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框04}{立绘8040}「休戦中の 敵国に\nしのびこんで‥\n---\n発見されて\n送り返されるなどと‥\n---\n武人として、族長として\n許されることでは、ない！",
  "tgt": "{框04}{立绘8040}「停战期间\n潜入敌国‥\n---\n被对方发现\n遣送回来‥\n---\n作为武人、作为族长\n这都不可原谅！"
 },
 {
  "id": "017377",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框04}{立绘8040}「その上‥、{队员02}‥\n---\nそなたは 我が連合の\n『あかし』である‥\n---\n{色03}{道具0101}{/色}を\n無くしたとも闻く‥",
  "tgt": "{框04}{立绘8040}「而且‥{队员02}\n---\n你是我联合的\n『见证』啊‥\n---\n听闻你连{色03}{道具0101}{/色}\n都弄丢了‥"
 },
 {
  "id": "017378",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框04}{立绘8040}「そなた ひとりの\nかるはずみな 行いが‥\n---\n連合すべてにとって\n不利となることを\nわきまえぬか‥！",
  "tgt": "{框04}{立绘8040}「你一个人的\n轻率之举‥\n---\n会给整个联合\n带来多么不利的\n后果，你心中无数吗‥！"
 },
 {
  "id": "017379",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框03}{立绘4200}「そのような 体面ばかり\n気になさるが‥",
  "tgt": "{框03}{立绘4200}「您只在意\n那种体面…"
 },
 {
  "id": "017380",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框03}{立绘0101}「一国の 王女が‥\n---\n{立绘0201}「エリーナが、現に\n帝国に 連れさられて\nいるのですよ！？",
  "tgt": "{框03}{立绘0101}「堂堂一国之公主‥\n---\n{立绘0201}「可艾莉娜现在\n正被帝国\n掳走啊！？"
 },
 {
  "id": "017381",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框04}{立绘8040}「我らは、ひとりの王女より\n連合の国々と、その民を\n守らねば ならんのだ！",
  "tgt": "{框04}{立绘8040}「我们必须守护的是\n整个联合诸国与其子民\n而非一位公主！"
 },
 {
  "id": "017382",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}「ただ今‥ {队员02}さまは\n取り調べ中で‥\n---\n誰も ここを通すワケには\nいかないのです‥！",
  "tgt": "{立绘0302}「现在‥{队员02}大人\n正在接受调查‥\n---\n谁都不能\n放行‥！"
 },
 {
  "id": "017383",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘0403}「その、にいさ‥\n{队员02}さまにとって\n大事な お話なんです！\n---\n実は、{道具0101}が‥{引0900}",
  "tgt": "{立绘0403}「那个、哥哥‥\n我有要事要告诉\n{队员02}大人啊！\n---\n其实，{道具0101}它‥{引0900}"
 },
 {
  "id": "017384",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框04}{立绘8040}「{道具0101}は、ここにある！",
  "tgt": "{框04}{立绘8040}「{道具0101}就在这里！"
 },
 {
  "id": "017385",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框06}{立绘8040}「先ほど‥、帝国より\nとどけられた。",
  "tgt": "{框06}{立绘8040}「方才‥帝国\n送还了它。"
 },
 {
  "id": "017386",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框06}{立绘8040}「ヤツらは、これをタテに‥\n---\n我らに 不利な\n休戦の条約を\n持ち出してきたぞ！",
  "tgt": "{框06}{立绘8040}「他们正以此要挟‥\n---\n向我们提出了\n条件不利的\n停战条约！"
 },
 {
  "id": "017387",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框03}{立绘0403}「しかし、それは\n姉さまを‥",
  "tgt": "{框03}{立绘0403}「可是，那样\n姐姐大人她‥"
 },
 {
  "id": "017388",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框06}{立绘8040}「もはや、女子供の\n口をはさむ 話ではない！",
  "tgt": "{框06}{立绘8040}「此事已容不得\n妇孺插嘴！"
 },
 {
  "id": "017389",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框06}{立绘0040}「‥{队员02}の しょばつ\nかるくはないと、心得よ！",
  "tgt": "{框06}{立绘0040}「…{队员02}的处罚\n不会轻，记住了！"
 },
 {
  "id": "017390",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框03}{立绘0403}「そんな‥、{码0B}兄さま‥",
  "tgt": "{框03}{立绘0403}「怎么会‥哥哥‥{码0B}兄さま‥"
 },
 {
  "id": "017391",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框03}{立绘0504}「こりゃ、{队员03}‥\nちゃんと 見はらんか！\n---\nニセモノの 剣など\n作らせおって‥！",
  "tgt": "{框03}{立绘0504}「好你个{队员03}‥\n让你好好看守！\n---\n竟让人仿造\n假剑‥！"
 },
 {
  "id": "017392",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框06}{立绘C340}「み‥",
  "tgt": "{框06}{立绘C340}「我‥"
 },
 {
  "id": "017393",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框06}{立绘C340}「見はれと、言われたけど‥\n---\n止めろ、とは‥\n---\n言われて‥、ない‥",
  "tgt": "{框06}{立绘C340}「虽然您让我看守‥\n---\n可没说过\n---\n要阻止‥啊‥"
 },
 {
  "id": "017394",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框03}{立绘0504}「くー‥‥\n---\nつ、次は 何かあったら\nすぐに 報せるんだ‥\n分かったな？",
  "tgt": "{框03}{立绘0504}「哼——‥‥\n---\n下、下次再出事\n要立刻上报‥\n听见没有？"
 },
 {
  "id": "017395",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框02}{立绘0302}「ただ今、重要なお調べの\n最中です‥\n---\n何人の、面会も\n許されません。",
  "tgt": "{框02}{立绘0302}「现在正值重要\n调查之中‥\n---\n任何人的会面\n都不允许。"
 },
 {
  "id": "017396",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框03}{立绘8544}「そういう事です\n{队员01}どの‥",
  "tgt": "{框03}{立绘8544}「正是如此\n{队员01}大人‥"
 },
 {
  "id": "017397",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框03}{立绘8544}「{队员02}どのは\n一族の、長‥\n---\nあなたのように\n見はりを つけただけで\n許されるものでは、ない。",
  "tgt": "{框03}{立绘8544}「{队员02}大人\n乃一族之长‥\n---\n不像你那样\n派个人看守\n就能了事的。"
 },
 {
  "id": "017398",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框06}{立绘8544}「残念ですが\nおひきとり願うほか\nありません‥\n---\n{队员03}、しっかり\nお見はりせよ！",
  "tgt": "{框06}{立绘8544}「遗憾得很\n只能请您\n回去了‥\n---\n{队员03}，打起精神\n好好看守！"
 },
 {
  "id": "017399",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}「申しわけありませんが\nお通しできません。\n---\n{立绘FFFF}",
  "tgt": "{立绘0302}「非常抱歉\n不能放您过去。\n---\n{立绘FFFF}"
 },
 {
  "id": "017400",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘8645}「{队员02}さまの\n取り調べは‥\n何日かかるか、分かりません。\n---\n町の‥ お部屋で\nお待ち下さい。",
  "tgt": "{立绘8645}「对{队员02}大人的\n调查‥\n不知要花多少天。\n---\n请在镇上的‥客房\n稍候。"
 },
 {
  "id": "017401",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}「いいなずけの、エリーナ様が\n行方不明だってのに‥\n---\nまったく、おエラ方の\n考えることは、分からんね‥",
  "tgt": "{立绘0302}「未婚夫的艾莉娜大人\n下落不明‥\n---\n大人物们的想法\n真让人搞不懂‥"
 },
 {
  "id": "017402",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘8645}「{队员02}も\n気の毒になぁ‥",
  "tgt": "{立绘8645}「{队员02}也\n真可怜啊‥"
 },
 {
  "id": "017403",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}「すみませんが‥\n通すわけには、いきません。",
  "tgt": "{立绘0302}「抱歉‥\n我们不能放行。"
 },
 {
  "id": "017404",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘C140}「しっかり 見はってますね‥",
  "tgt": "{立绘C140}「看得真紧啊‥"
 },
 {
  "id": "017405",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘8443}「わけを話して お願いしても\nだめでしょうね‥",
  "tgt": "{立绘8443}「就算说明缘由\n去求情也没用吧‥"
 },
 {
  "id": "017406",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘8645}「ンフー‥ンフー‥ン{码0B}プフー‥",
  "tgt": "{立绘8645}「呼呼—‥呼呼—‥噗呼—‥{码0B}プフー‥"
 },
 {
  "id": "017407",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{框20}\n    {色02}けいびへい{/色}を倒せ！\n---\nチャンスは{色02}1ターン{/色}\n仲間を 呼ばれる前に\n素早く 倒そう！\n---\nコンボアタックを使うと\n有利に戦えます。",
  "tgt": "{框20}\n    打倒{色02}警卫兵{/色}！\n---\n机会只有{色02}1回合{/色}\n趁他还没叫帮手\n迅速放倒！\n---\n用连击攻击\n能占得先机。"
 },
 {
  "id": "017408",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘0702}「ウーン‥イタタ‥",
  "tgt": "{立绘0702}「唔嗯‥哎哟‥"
 },
 {
  "id": "017409",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘0702}「{特效}{/特效}\n---\nヒ{码0E}、ヒエーッ！\n---\nた、大変だーっ！",
  "tgt": "{立绘0702}「\n---\n咿、咿呀！\n---\n大、大事不好啦！{特效}{/特效}\n---\nヒ{码0E}、ヒエーッ！\n---\nた、大変だーっ！"
 },
 {
  "id": "017410",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}「ウ‥グゥム‥‥",
  "tgt": "{立绘0302}「唔‥咕噜姆‥‥"
 },
 {
  "id": "017411",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}「{特效}{/特效}\n---\nウ{码0E}、ウヘェーッ！\n---\nお、おたすけーっ！",
  "tgt": "{立绘0302}「\n---\n呜、呜哇呀！\n---\n救、救命啊！{特效}{/特效}\n---\nウ{码0E}、ウヘェーッ！\n---\nお、おたすけーっ！"
 },
 {
  "id": "017412",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}「{特效}{/特效}{码08}クルクルクル{码0E}‥",
  "tgt": "{立绘0302}「咕噜咕噜咕噜‥{特效}{/特效}{码08}クルクルクル{码0E}‥"
 },
 {
  "id": "017413",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}「{特效}{/特效}\n---\nホ{码0E}、ホエーッ！\n---\nだ、誰かーっ！",
  "tgt": "{立绘0302}「\n---\n吼、吼嗷！\n---\n来、来人啊！{特效}{/特效}\n---\nホ{码0E}、ホエーッ！\n---\nだ、誰かーっ！"
 },
 {
  "id": "017414",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}「スピー‥スピー‥{码0B}ップピー‥",
  "tgt": "{立绘0302}「呼咝‥呼咝‥噗咝—‥{码0B}ップピー‥"
 },
 {
  "id": "017415",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘C140}「{队员03}さん‥\n---\n止めないんですか？",
  "tgt": "{立绘C140}「{队员03}先生‥\n---\n不阻止他们吗？"
 },
 {
  "id": "017416",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘4300}「報せろ、と‥\n---\n言われた‥、けど‥\n---\n止めろとは‥‥\n---\n言って、ない。",
  "tgt": "{立绘4300}「让我去报告…\n---\n是说了…，但是…\n---\n阻止你们的话…\n---\n没说。"
 },
 {
  "id": "017417",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘C140}「‥{码0B}‥{码0B}‥\n---\n{立绘FFFF}{立绘8843}やさしいんですね。",
  "tgt": "{立绘C140}「‥‥‥\n---\n{码0B}原来你很温柔啊。{码0B}‥\n---\n{立绘FFFF}{立绘8843}やさしいんですね。"
 },
 {
  "id": "017418",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}「連合どうしで、何やら\nもめてるらしい‥\n---\n今度、戦爭が始まったら\n負けちまうかもな。",
  "tgt": "{立绘0302}「听说联盟之间\n好像起了什么争执‥\n---\n这次要是开战\n说不定我们就输了呢。"
 },
 {
  "id": "017419",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘8645}「まあ、いろいろと\n取り込んでる‥ってことだ\n---\nすまんが、ここを通す\nワケには いかないよ。",
  "tgt": "{立绘8645}「也就是说，最近\n诸事缠身‥\n---\n抱歉，这里\n不能放你过去。"
 },
 {
  "id": "017420",
  "file": "WORLD/D142BTL.EMI",
  "seg": 19,
  "src": "{立绘0302}{立绘8645}「ただいま 城內は\n  立ち入り禁止です！",
  "tgt": "{立绘0302}{立绘8645}「目前城内\n禁止进入！"
 },
 {
  "id": "017421",
  "file": "WORLD/D143END.EMI",
  "seg": 9,
  "src": "あそんでくれてありがとう",
  "tgt": "感谢游玩"
 },
 {
  "id": "017422",
  "file": "WORLD/D143END.EMI",
  "seg": 9,
  "src": "ブレス オブ ファイアⅣを\n最後まで 遊んでいただき\nありがとうございます。\n---\n本データを セーブして\n最後の戦いの前から\nプレイする事ができます。\n---\nデータを セーブしますか？{码14000C02}はい\nいいえ",
  "tgt": "感谢您将《龙战士Ⅳ》\n玩到了\n最后。\n---\n保存本存档后\n可以从最后的\n战斗前继续游玩。\n---\n要保存存档吗？{码14000C02}是\n否"
 },
 {
  "id": "017423",
  "file": "WORLD/D143END.EMI",
  "seg": 9,
  "src": "データを セーブせずに\nタイトル画面に 戻ってよいですか？{码14010C42}はい\nいいえ",
  "tgt": "不保存数据\n就回到标题画面可以吗？是\n否{码14010C42}はい\nいいえ"
 },
 {
  "id": "017424",
  "file": "WORLD/D152BTL.EMI",
  "seg": 5,
  "src": "何かないかな？",
  "tgt": "有什么好东西吗？"
 },
 {
  "id": "017425",
  "file": "WORLD/D152BTL.EMI",
  "seg": 5,
  "src": "何もない！",
  "tgt": "什么都没有！"
 },
 {
  "id": "017426",
  "file": "WORLD/D152BTL.EMI",
  "seg": 5,
  "src": "{色03}{占位00}{/色}を {占位01}コ\n手に入れた",
  "tgt": "获得{色03}{占位00}{/色} {占位01}个"
 },
 {
  "id": "017427",
  "file": "WORLD/D152BTL.EMI",
  "seg": 5,
  "src": "{色03}{占位00}{/色}を {占位01}コ\n見つけた\n---\nしかし、持ち物がいっぱいだ！",
  "tgt": "找到{色03}{占位00}{/色} {占位01}个\n---\n但是，行李已满！"
 },
 {
