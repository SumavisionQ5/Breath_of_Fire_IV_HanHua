  "src": "{道具6F04}",
  "tgt": "{道具6F04}"
 },
 {
  "id": "015651",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "きょうどうたいのしつない",
  "tgt": "共同体室内"
 },
 {
  "id": "015652",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框8A}{码14820C82}はい\nいいえ",
  "tgt": "{框8A}{码14820C82}是\n否"
 },
 {
  "id": "015653",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{框88}{码14820C82}はい\nいいえ",
  "tgt": "{框88}{码14820C82}是\n否"
 },
 {
  "id": "015654",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{码14000C92}「仕事のことだけど\n「最近どう？",
  "tgt": "{码14000C92}「关于工作\n「最近怎么样？"
 },
 {
  "id": "015655",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「つかれた体での旅は\nキケンだよう\n---\n泊まってく？{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく",
  "tgt": "「疲惫的身体\n赶路可危险哟\n---\n要住下吗？住下\n只做旅途记录\n先不住{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく"
 },
 {
  "id": "015656",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「泊まる？{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく",
  "tgt": "「要住宿吗？住下\n只做旅途记录\n先不住{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく"
 },
 {
  "id": "015657",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「サービス業は気を使うから\nタイヘンなのよう\n---\n泊まる？{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく",
  "tgt": "「服务业要处处留心\n所以很辛苦的哟\n---\n要住宿吗？住下\n只做旅途记录\n先不住{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく"
 },
 {
  "id": "015658",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「この村でいちばん\nセイケツな宿屋だよう\n---\n泊まってく？{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく",
  "tgt": "「这可是村里\n最干净的旅店哟\n---\n要住下吗？住下\n只做旅途记录\n先不住{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく"
 },
 {
  "id": "015659",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「{队员00}のことは なんでも\n知ってるよう\n---\nんっとねー今まで{占位00}回\nモンスターにあってるよう\n---\nあとねー宿屋にとまったのは\n{占位01}回でしょ\nキャンプが{占位02}回\n---\nで、今まで\n{占位03}ゼニーもうけてるよ\n---\n‥えっストーカーじゃないよ\nほんとだよう",
  "tgt": "「关于{队员00}的事\n我什么都知道哟\n---\n嗯——到现在为止\n遇到过{占位00}次魔物哟\n---\n还有呢——住旅店\n住了{占位01}次吧\n露营了{占位02}次\n---\n然后，到现在\n赚了{占位03}泽尼哟\n---\n……咦？我才不是跟踪狂呢\n真的是哟"
 },
 {
  "id": "015660",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「今まで{占位00}回\nタンスを調べてるよう\n---\nで、宝物は{占位01}こ\n手に入れてるよう\n---\nつりはね···\n{占位02}回やってるよう",
  "tgt": "「到现在为止\n翻过{占位00}次柜子哟\n---\n然后，得到了\n{占位01}个宝物哟\n---\n钓鱼的话···\n钓过{占位02}次哟"
 },
 {
  "id": "015661",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{金钱00}「いらっしゃいだよう\nまじめな道具屋だよう{码14850C93}買う\n売る\nやめる",
  "tgt": "{金钱00}「欢迎光临哟\n是认真的道具店哟{码14850C93}买\n卖\n算了"
 },
 {
  "id": "015662",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{金钱00}「いらっしゃいだよう\nふつうの道具屋だよう{码14850C93}買う\n売る\nやめる",
  "tgt": "{金钱00}「欢迎光临哟\n是普通的道具店哟{码14850C93}买\n卖\n算了"
 },
 {
  "id": "015663",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{金钱00}「はやく遊びに行きたいから\nさっさと買い物すませてよう{码14850C93}買う\n売る\nやめる",
  "tgt": "{金钱00}「我想快点去玩\n赶紧买完哟{码14850C93}买\n卖\n算了"
 },
 {
  "id": "015664",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{金钱00}「いらっしゃいだよう\nいい道具なら、ここだよう{码14850C93}買う\n売る\nやめる",
  "tgt": "{金钱00}「欢迎光临哟\n好道具就在这里哟{码14850C93}买\n卖\n算了"
 },
 {
  "id": "015665",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「‥‥‥‥\nなーんであたしが\n道具屋なのよう！\n---\nジミなシゴトなんて\nしたくないのよう！",
  "tgt": "「‥‥‥‥\n为什么偏偏是我\n在当道具屋呀！\n---\n朴素的工作\n人家才不想干呢！"
 },
 {
  "id": "015666",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「道具っていっても\nいろいろあるのよう",
  "tgt": "「说是道具\n其实五花八门哟"
 },
 {
  "id": "015667",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「にぎやかなほうが\nめずらしい品物も\n手に入れやすいのよう",
  "tgt": "「热闹一点的话\n稀罕的货色\n也更容易到手哟"
 },
 {
  "id": "015668",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「いらっしゃい\nいつもありがとよう",
  "tgt": "「欢迎光临\n一直多谢惠顾哟"
 },
 {
  "id": "015669",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「ふーっ\nヒマだよう",
  "tgt": "「呼——\n闲得慌哟"
 },
 {
  "id": "015670",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「あたしたちの腹の中に\n品物をおいてるのよう\n---\n{码0B}ウソだよう！",
  "tgt": "「道具都放在\n我们的肚子里哟\n---\n骗你的哟！{码0B}ウソだよう！"
 },
 {
  "id": "015671",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「何してる？って\nあたしたちはバイヤー\nなのよう",
  "tgt": "「你问在干嘛？\n我们呀是\n采购员哟"
 },
 {
  "id": "015672",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「ごめんよう\nおまけしてあげたいんだけど‥",
  "tgt": "「对不起哟\n本来想给你优惠的‥"
 },
 {
  "id": "015673",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{金钱00}「あきんど なのよう！\nまじめな武器屋なのよう\n何か 買ってよう{码14840C94}買う\n売る\n下取り\nやめる",
  "tgt": "{金钱00}「是商人哟！\n是认真的武器店哟\n买点什么吧哟{码14840C94}买\n卖\n折价\n算了"
 },
 {
  "id": "015674",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{金钱00}「あきんど なのよう！\nふつうの武器屋なのよう\n何か 買ってよう{码14840C94}買う\n売る\n下取り\nやめる",
  "tgt": "{金钱00}「是商人哟！\n是普通的武器店哟\n买点什么吧哟{码14840C94}买\n卖\n折价\n算了"
 },
 {
  "id": "015675",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{金钱00}「武器を売ってるけど\n早く仕事終わらせて\n遊びたいよう{码14840C94}買う\n売る\n下取り\nやめる",
  "tgt": "{金钱00}「虽然卖着武器\n但我想快点干完活\n去玩哟{码14840C94}买\n卖\n折价\n算了"
 },
 {
  "id": "015676",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{金钱00}「あきんど なのよう！\nいい武器そろえてるから\n何か 買ってよう{码14840C94}買う\n売る\n下取り\nやめる",
  "tgt": "{金钱00}「是商人哟！\n好武器备齐了\n买点什么吧哟{码14840C94}买\n卖\n折价\n算了"
 },
 {
  "id": "015677",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「あたし‥‥\n---\n武器屋ってスキじゃないんだ\nほんとは",
  "tgt": "「人家‥‥\n---\n其实才不喜欢\n开武器屋呢"
 },
 {
  "id": "015678",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「ためし斬りしてみる？\n---\n‥あ、あたしを‥\nそんな目であたしを\n見ないでよう！",
  "tgt": "「要试斩一下吗？\n---\n‥别、别把我‥\n别用那种眼神\n看人家啦！"
 },
 {
  "id": "015679",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「にぎやかなほうが\nいいものが\n手に入りやすいのよう",
  "tgt": "「热闹一点的话\n好东西\n也更容易到手哟"
 },
 {
  "id": "015680",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「いらっしゃい\nこれからもひいきにしてよう",
  "tgt": "「欢迎光临\n今后也请多多关照哟"
 },
 {
  "id": "015681",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「あたし、武器をとぐシゴト\n---\nいいシゴトをしたときは\nためしてみたくなるのよう",
  "tgt": "「人家呀，磨武器的活儿\n---\n干得漂亮的时候\n就想试试刀锋哟"
 },
 {
  "id": "015682",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「ナイフのマルのみできる？",
  "tgt": "「小刀只做圆刃吗？"
 },
 {
  "id": "015683",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「ウエポンフェチって\nちょっとこわいよね",
  "tgt": "「武器控什么的\n有点可怕呢"
 },
 {
  "id": "015684",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「きゃうん\n今日もきてくれて\nありがとよう",
  "tgt": "「呀呜\n今天也谢谢\n你光临哟"
 },
 {
  "id": "015685",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「あちこちに探険に行って\nいろいろな物を探してくるよう\n---\n探険に行く？{码14820C82}はい\nやめる",
  "tgt": "「我们会去各地探险\n找来各种各样的东西哟\n---\n要去探险吗？是\n不去了{码14820C82}はい\nやめる"
 },
 {
  "id": "015686",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「あちこちに探険に行って\nいろいろな物をひろってくるよう\n---\n探険に行く？{码14820C82}はい\nやめる",
  "tgt": "「我们会去各地探险\n捡来各种各样的东西哟\n---\n要去探险吗？是\n不去了{码14820C82}はい\nやめる"
 },
 {
  "id": "015687",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「あちこちに探険に行って\nいろいろな物をぱちってくるよう\n---\n探険に行く？{码14820C82}はい\nやめる",
  "tgt": "「我们会去各地探险\n顺手拿回各种东西哟\n---\n要去探险吗？是\n不去了{码14820C82}はい\nやめる"
 },
 {
  "id": "015688",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「あちこちに探険に行くよう\nアイテムはそのオマケね\n---\n探険に行く？{码14820C82}はい\nやめる",
  "tgt": "「我们要去各地探险哟\n道具只是附带品呢\n---\n要去探险吗？是\n不去了{码14820C82}はい\nやめる"
 },
 {
  "id": "015689",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "どこを探険しよう？",
  "tgt": "去哪里探险呢？"
 },
 {
  "id": "015690",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "{占位00}\nでいいのね？{码14820C82}はい\nいいえ",
  "tgt": "{占位00}\n这样可以吗？{码14820C82}是\n否"
 },
 {
  "id": "015691",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "がんばってくるよう！",
  "tgt": "我们会加油的哟！"
 },
 {
  "id": "015692",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "またきてよう",
  "tgt": "再来哟"
 },
 {
  "id": "015693",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「がんばって、すてきなものを\n探してくるよう！\n---\nそれとも、探険やめる？{码14820C93}行き先を変更する\n探険をやめる\nやめない",
  "tgt": "「我们会加油\n找来棒棒的东西哟！\n---\n还是说，不探险了？变更目的地\n取消探险\n继续探险{码14820C93}行き先を変更する\n探険をやめる\nやめない"
 },
 {
  "id": "015694",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「遠くに探険に行くなんて\nドキドキするよう\n---\nやっぱり、探険やめる？{码14820C93}行き先を変更する\n探険をやめる\nやめない",
  "tgt": "「要去那么远的地方探险\n真是让人心跳加速哟\n---\n还是说，不探险了？变更目的地\n取消探险\n继续探险{码14820C93}行き先を変更する\n探険をやめる\nやめない"
 },
 {
  "id": "015695",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「あたしが死んだら\n{队员00}のせいだよう\n---\n探険やめていい？{码14820C93}行き先を変更する\n探険をやめる\nやめちゃダメ",
  "tgt": "「我要是死了\n可都是{队员00}的错哟\n---\n可以停止探险吗？{码14820C93}更改目的地\n停止探险\n不许停"
 },
 {
  "id": "015696",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「今、探険のじゅんび中だよう\nいそがしいのよう\n---\nやっぱり、探険やめる？{码14820C93}行き先を変更する\n探険をやめる\nやめない",
  "tgt": "「现在正在准备探险哟\n忙着呢\n---\n还是说，不探险了？变更目的地\n取消探险\n继续探险{码14820C93}行き先を変更する\n探険をやめる\nやめない"
 },
 {
  "id": "015697",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
  "src": "「それじゃあ、探険は中止するよう",
  "tgt": "「那么，这次探险就中止了哟"
 },
 {
  "id": "015698",
  "file": "WORLD/AREAS041.EMI",
  "seg": 8,
