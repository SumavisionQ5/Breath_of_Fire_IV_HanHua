 },
 {
  "id": "015107",
  "file": "WORLD/AREAS030.EMI",
  "seg": 11,
  "src": "{立绘1A1A}カーン",
  "tgt": "{立绘1A1A}卡恩"
 },
 {
  "id": "015108",
  "file": "WORLD/AREAS030.EMI",
  "seg": 11,
  "src": "{立绘1B1B}マーロック",
  "tgt": "{立绘1B1B}马洛克"
 },
 {
  "id": "015109",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}みなとまちしゅーく",
  "tgt": "{立绘0000}港镇修克"
 },
 {
  "id": "015110",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「おや、港町シュークへ\nようこそ‥\n---\nここは、世界でもめずらしい\n泥じゃない海に\n面した町ですよ。",
  "tgt": "「哟，欢迎来到\n港镇休克‥\n---\n这里是世上少有的\n面朝非泥之海的\n城镇哟。"
 },
 {
  "id": "015111",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「オレのとーちゃんは\n海の男なんだぞ‥\n---\nここで、とーちゃんの\n船を 待ってるんだ。",
  "tgt": "「我爸可是\n大海男儿哟‥\n---\n我在这儿\n等爸爸的船回来。"
 },
 {
  "id": "015112",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「ん‥\nその船が、誰のかって？\n---\n持ち主は、酒場にでも\nいるだろうよ。",
  "tgt": "「嗯‥\n问那船是谁的？\n---\n船主大概\n在酒馆里吧。"
 },
 {
  "id": "015113",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「関所が、しまってて‥\nシュークに 入るのが\nムズかしいって 話だけど‥\n---\n出るのは だいじょうぶかな‥",
  "tgt": "「听说关所关闭了‥\n很难进到\n休克来‥\n---\n出去倒没问题吧‥"
 },
 {
  "id": "015114",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「泥の海は、つり\nできないだろ‥\n---\nここは、できるんだぜ！",
  "tgt": "「泥之海没法\n钓鱼吧‥\n---\n这儿可是能钓的！"
 },
 {
  "id": "015115",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「この海‥\nずっと西の方にまで\nつづいてるんだって‥",
  "tgt": "「这片海‥\n听说一直延伸到\n遥远的西边呢‥"
 },
 {
  "id": "015116",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0101}{码0A}",
  "tgt": "{立绘0101}{码0A}"
 },
 {
  "id": "015117",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「この町の 男どもは‥\n---\nほとんど 船に乘って\n出はらってるんだ‥",
  "tgt": "「这镇上的男人‥\n---\n几乎都上船\n出海去了‥"
 },
 {
  "id": "015118",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「ねー、よその国には\n砂の上を 走る船が\nあるって 本当？\n---\nこの町にあるのは\n海の上を 走る船だよ。",
  "tgt": "「呐，别的国家有\n在沙子上跑的船\n是真的吗？\n---\n这镇上有的\n是在海上跑的船哟。"
 },
 {
  "id": "015119",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「あーん！？\n---\nおれっちの船に 乘りたい？",
  "tgt": "{立绘0202}「啊——嗯！？\n---\n想坐我的船？"
 },
 {
  "id": "015120",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}「船に、乘りたいー？\n---\nだったらー、ジグ兄ちゃんと\n話してみてよ‥",
  "tgt": "{立绘0000}「想坐船——？\n---\n那就去和\n吉格老大聊聊吧……"
 },
 {
  "id": "015121",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0003}「港に とまってる船？\n---\nああ、オレたち兄弟の\n船だぜ‥！\nカッコいいだろ？",
  "tgt": "{立绘0003}「港里停的那艘船？\n---\n啊，那是我们\n兄弟俩的船……！\n很帅气吧？"
 },
 {
  "id": "015122",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「んん‥\n船を 探してるのか‥\n---\nだったら、あそこの\n男たちに 話してみなされ‥",
  "tgt": "「嗯嗯‥\n在找船呀‥\n---\n那去跟那边的\n男人们谈谈吧‥"
 },
 {
  "id": "015123",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「はいはい、いらっしゃい。\n---\n{金钱00}{占位00}ゼニー ですけど‥\nお休みになりますか？{码14860C93}休んで行く\n旅の記錄だけする\n今は、やめておく",
  "tgt": "「好好，欢迎光临。\n---\n{金钱00}{占位00}泽尼……\n要住下休息吗？{码14860C93}住下再走\n只记录旅程\n这次先不了"
 },
 {
  "id": "015124",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「おや‥、お金が\n足りないみたいだよ。",
  "tgt": "「哎呀‥，钱\n好像不够哟。"
 },
 {
  "id": "015125",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「はるばる海を 渡ってきた\nめずらしい物が、あるよ‥！{码14840C94}買物をしよう\n何か売ろう\n武器を下取りしてもらおう\n今は、やめておく",
  "tgt": "「有远渡重洋而来的\n稀罕玩意哟‥！买点什么吧\n卖点什么吧\n武器折价换购\n现在，还是算了{码14840C94}買物をしよう\n何か売ろう\n武器を下取りしてもらおう\n今は、やめておく"
 },
 {
  "id": "015126",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「おいおい\nどこの誰とも 分からない\n連中を 乘せるほど‥\n---\n安い船じゃ、ねぇぜ‥？",
  "tgt": "{立绘0202}「喂喂\n我的船可没便宜到\n搭载来历不明的人‥\n---\n不是吗‥？"
 },
 {
  "id": "015127",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「それに‥、だ‥\n---\n{色02}水神さま{/色}の お許しも\nないヤツが‥\n---\n海に出ちゃ、いけねぇ‥\nさ、归った 归った！",
  "tgt": "{立绘0202}「而且……听好了……\n---\n没得到\n{色02}水神大人{/色}许可的家伙……\n---\n不许出海……\n快回去，快回去！"
 },
 {
  "id": "015128",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「おれたち、船乘りは\nみんな‥\n---\n{色02}水神さま{/色}の お許しを\nもらって 海に出てるんだ‥\n---\n許しが ないやつを\n船に 乘せるワケにゃ\nいかないね。",
  "tgt": "{立绘0202}「我们这些船员\n人人都是……\n---\n得到{色02}水神大人{/色}的\n许可才出海的……\n---\n没许可的家伙\n可不能\n让他上船。"
 },
 {
  "id": "015129",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「ん、水神さま‥？\n---\nそっちの道が\n{色02}水神のほこら{/色}に\n通じてるけどね。",
  "tgt": "「嗯，水神大人……？\n---\n那条路\n通往\n{色02}水神祠{/色}。"
 },
 {
  "id": "015130",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「んん‥！？\n---\n水神さまの、ほこらに\n参って来たって？",
  "tgt": "{立绘0202}「嗯嗯‥！？\n---\n你说是去参拜过\n水神大人的祠堂？"
 },
 {
  "id": "015131",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「おおっ、こりゃ\n{色03}{道具1205}{/色} じゃねぇか！\n---\nこれを 持ってるって事は‥\n水神さまが、お出ましに\nなったって事か！？",
  "tgt": "{立绘0202}「哦哦，这不是\n{色03}{道具1205}{/色}吗！\n---\n带着这个，就是说‥\n水神大人\n现身了吗！？"
 },
 {
  "id": "015132",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「ふーん‥、こりゃ\n水神さまの おみちびきって\nヤツかな‥‥",
  "tgt": "{立绘0202}「哦～，看来这就是\n水神大人的\n指引吧‥‥"
 },
 {
  "id": "015133",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「よし、いいだろう‥\n船に 乘せてやるぜ‥！",
  "tgt": "{立绘0202}「好，行呀‥\n就让你们上船‥！"
 },
 {
  "id": "015134",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「お、{码0B}おい‥ ちょっと待て。\n---\nひょっとして、この\nおねえちゃん達も\n船に 乘る気か？",
  "tgt": "{立绘0202}「喂，喂‥等等。\n---\n该不会，这几位\n小姐姐也\n想上船吧？{码0B}おい‥ ちょっと待て。\n---\nひょっとして、この\nおねえちゃん達も\n船に 乘る気か？"
 },
 {
  "id": "015135",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{框06}{立绘8344}「そのつもりだが‥\n何か、マズいのか‥？",
  "tgt": "{框06}{立绘8344}「是有这个打算‥\n有什么问题吗‥？"
 },
 {
  "id": "015136",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「ああ‥\n---\n女は、船に‥\n乘っけちゃ いけないんだ！",
  "tgt": "{立绘0202}「哎呀‥\n---\n女人是不许\n上船的！"
 },
 {
  "id": "015137",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「ムカシっから‥\nそういう決まりに\nなってるんだよ‥！",
  "tgt": "{立绘0202}「打很早以前‥\n就有这样的\n规矩了‥！"
 },
 {
  "id": "015138",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「まあ、{码0B}そういうワケで‥\n---\nあんた達は、ここで\n待ってもらうしか‥",
  "tgt": "{立绘0202}「嘛，就是这么回事‥\n---\n你们只好\n在这儿等着了‥{码0B}そういうワケで‥\n---\nあんた達は、ここで\n待ってもらうしか‥"
 },
 {
  "id": "015139",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘C140}「あの、あの‥\n何とか なりませんか？\n---\n{立绘8445}少しぐらい、大変でも‥\nわたし、平気です。",
  "tgt": "{立绘C140}「那个，那个‥\n能不能想想办法呢？\n---\n{立绘8445}就算苦一点‥\n我，也不在乎。"
 },
 {
  "id": "015140",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「だめ、だめ‥\n---\n大体、海ってのは\n男のモンなんだ‥！\n---\n船乘りは、根性がいるし‥\nうでっぷしだって‥",
  "tgt": "{立绘0202}「不行，不行‥\n---\n再说，大海就是\n男人的东西‥！\n---\n当船夫得有骨气‥\n还得有好身手‥"
 },
 {
  "id": "015141",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{框03}{立绘0506}「{特效}そのとおりっ{码0E}{/特效}{码03}",
  "tgt": "{框03}{立绘0506}「说得对{特效}そのとおりっ{码0E}{/特效}{码03}"
 },
 {
  "id": "015142",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{框05}{立绘0506}「ふっ、はあ〜〜っ！\nまた、会ったな‥‥\n---\n二度までも、お前たちに\nやぶれた後‥\n---\nふたたび 旅に出て‥\nここで、『海の男』の修行を\nしていたのだっ！",
  "tgt": "{框05}{立绘0506}「呼，哈啊——！\n又见面了‥‥\n---\n两度败给你们\n之后‥\n---\n我便再度踏上旅途‥\n在此修行\n『大海男儿』之道！"
 },
 {
  "id": "015143",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{框05}{立绘0506}「いいか‥\n船乘りは、男の中の男！\n---\n真の{色02}漢{/色}にしか\nつとまらぬ ものなり！\n---\n今から、お前たちを\nコテンパンにして‥\n---\nそれを 身をもって\n教えてくれるわ！",
  "tgt": "{框05}{立绘0506}「听好了……\n船员是男人中的男人！\n---\n唯真正的{色02}汉子{/色}\n方能胜任！\n---\n现在就把你们\n打得落花流水……\n---\n让你们\n亲身体会这句话！"
 },
 {
  "id": "015144",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「あんた達‥\nカーンの 知り合い‥？\n---\nちょっと前に、ここへ来て‥\n船で 働かして\nやってるんだけど‥",
  "tgt": "{立绘0202}「你们‥\n认识卡恩‥？\n---\n他不久前来这儿‥\n我让他在船上\n干活呢‥"
 },
 {
  "id": "015145",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{框06}{立绘C440}「‥おい。",
  "tgt": "{框06}{立绘C440}「‥喂。"
 },
 {
  "id": "015146",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{框06}{立绘C440}「さっき、うでっぷしが\nどうとか 言ってたが‥\n---\nあいつを 倒せば\nいいって事か？",
  "tgt": "{框06}{立绘C440}「刚才你说\n身手如何的‥\n---\n把那家伙打倒\n就行了吧？"
 },
 {
  "id": "015147",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「え‥、{码0B}うう‥、あ？",
  "tgt": "{立绘0202}「诶‥，呃‥，啊？{码0B}うう‥、あ？"
 },
 {
  "id": "015148",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{框03}{立绘0606}「べふっ",
  "tgt": "{框03}{立绘0606}「噗嘎"
 },
 {
  "id": "015149",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{框06}{立绘C440}「‥{码0B}‥{码0B}‥どうだ？",
  "tgt": "{框06}{立绘C440}「‥‥‥如何？{码0B}‥{码0B}‥どうだ？"
 },
 {
  "id": "015150",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「ど、{码0B}どうも こうも‥\n---\n大体‥、おれが言ってる\nうでっぷし ってのは‥\n---\nたとえば、あの‥\nマストの てっぺんで\n決闘するとか‥",
  "tgt": "{立绘0202}「怎，怎么个如何‥\n---\n再说了‥，我说的\n身手呀‥\n---\n比如说，那个‥\n爬到桅杆顶上\n决斗什么的‥{码0B}どうも こうも‥\n---\n大体‥、おれが言ってる\nうでっぷし ってのは‥\n---\nたとえば、あの‥\nマストの てっぺんで\n決闘するとか‥"
 },
 {
  "id": "015151",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘C140}「あ、はい‥\n---\nじゃ、わたし‥\nそれ、やります。",
  "tgt": "{立绘C140}「啊，好的‥\n---\n那，我‥\n来试试那个。"
 },
 {
  "id": "015152",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「あー‥{码0B}‥\n---\nあんた達が、強いってのは\nまぁ、分かったよ‥",
  "tgt": "{立绘0202}「啊——‥‥\n---\n你们很强这一点\n嘛，我算是明白了‥{码0B}‥\n---\nあんた達が、強いってのは\nまぁ、分かったよ‥"
 },
 {
  "id": "015153",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「でも、やっぱり‥\n---\n海の キビシさは\nこんなものじゃ‥",
  "tgt": "{立绘0202}「不过，毕竟‥\n---\n大海的严酷\n可不止这样‥"
 },
 {
  "id": "015154",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘8745}「そんな‥‥\n---\nだったら、他に何でも\nためして下さい‥\n---\nわたし達、平気ですから！",
  "tgt": "{立绘8745}「怎么会‥‥\n---\n那就随便出什么\n考验我们吧‥\n---\n我们，都不怕的！"
 },
 {
  "id": "015155",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「うーん‥‥\n---\nそうまで 言うんなら\nもう少し‥\n---\nキビシさを 教えて\nやっても いいけど‥",
  "tgt": "{立绘0202}「嗯——‥‥\n---\n既然都说到这份上\n就再让你们‥\n---\n尝尝更严酷的\n味道也行‥"
 },
 {
  "id": "015156",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「ただし！\n今度は、ハンパじゃないから‥\n---\nどうしても って言うのなら\n心のじゅんびを してから\n来るんだ‥",
  "tgt": "{立绘0202}「不过！\n这回可不是闹着玩的‥\n---\n真想上的话\n就做好心理准备\n再来吧‥"
 },
 {
  "id": "015157",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「じゃ、じゅんびができたら\n俺に 話しかけてくれ‥\n---\nま、やめといた方が\nいいと思うけどな‥",
  "tgt": "{立绘0202}「准备好了\n就来叫我一声‥\n---\n嘛，我还是觉得\n别逞强为好‥"
 },
 {
  "id": "015158",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「何だ‥、本当に\nやる気なのか‥？{码14000C82}はい\n後で",
  "tgt": "{立绘0202}「怎么……\n你当真\n想打吗……？{码14000C82}是\n等会再说"
 },
 {
  "id": "015159",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「ま、やめておいた方が\n身のためだぜ‥",
  "tgt": "{立绘0202}「嘛，还是算了吧\n这才是为你们好‥"
 },
 {
  "id": "015160",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}「ツネキチ〜〜！\n女の子に、やられたからって\nイジけて ないで‥\n---\n早く あがってきなよー。",
  "tgt": "{立绘0000}「常吉～～！\n别因为输给了\n小姑娘就\n垂头丧气的……\n---\n快上来吧——。"
 },
 {
  "id": "015161",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「わたしは‥\n---\n苦勞してまで、船に\n乘ろうなんて\n思いませんけどね。",
  "tgt": "「我嘛‥\n---\n可不觉得\n值得吃那么多苦\n去上船呢。"
 },
 {
  "id": "015162",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「オレは、大きくなったら\n海の男に なるんだぞ！",
  "tgt": "「我长大了\n也要当大海男儿！"
 },
 {
  "id": "015163",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「んー、女が船に\n乘れない理由？\n---\nさて、どうしてかね‥\nしきたり ってやつだね。",
  "tgt": "「嗯～，女人不许上船\n的理由？\n---\n这个嘛，为什么呢‥\n就是老规矩啦。"
 },
 {
  "id": "015164",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「船乘りに なるために\nウデだめし‥\n---\nよくやるよ‥",
  "tgt": "「为了当船夫\n来比试身手‥\n---\n真敢做呀‥"
 },
 {
  "id": "015165",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「どうだい‥\n船には 乘せてもらえる事に\nなったかね？",
  "tgt": "「怎么样‥\n说好让你们\n上船了吗？"
 },
 {
  "id": "015166",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「そうか‥‥\n---\nやっぱり、あきらめる気は\nないんだな‥",
  "tgt": "{立绘0202}「这样啊‥‥\n---\n果然还是\n不肯放弃呀‥"
 },
 {
  "id": "015167",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「よし、{码0B}じゃあ‥\n---\nおねえちゃん達には\nこっちに 来てもらおう‥",
  "tgt": "{立绘0202}「好，那么‥\n---\n就叫小姐姐们\n到这边来吧‥{码0B}じゃあ‥\n---\nおねえちゃん達には\nこっちに 来てもらおう‥"
 },
 {
  "id": "015168",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘C240}「さて‥‥\n---\n{队员01}たちは\nだいじょうぶ だろうかな？",
  "tgt": "{立绘C240}「接下来‥‥\n---\n{队员01}他们\n不要紧吧？"
 },
 {
  "id": "015169",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘C240}「‥見に行こう。",
  "tgt": "{立绘C240}「‥去看看吧。"
 },
 {
  "id": "015170",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「そこに とまってる船‥\nひと晚中、さわがしかったけど\n何やってたんだろ？",
  "tgt": "「停在那边的船‥\n吵吵了一整晚\n到底在干什么呢？"
 },
 {
  "id": "015171",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「この海、ずーと\nひろがってるんだけど‥\n---\nやっぱり はじっこは\n泥の海に なってるんだって。",
  "tgt": "「这片海一直\n延伸下去‥\n---\n但据说尽头果然还是\n变成了泥之海。"
 },
 {
  "id": "015172",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「ここで のんでた\n3人は‥\n---\nジグ、クランク、ツネキチって\n船乘りの 兄弟だよ。",
  "tgt": "「在这喝着酒\n的三个人‥\n---\n是吉格、库兰克、常吉\n这船夫三兄弟哟。"
 },
 {
  "id": "015173",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「あの、ねぇちゃん達\n大したモンだぜ‥\n---\nとうとう、一晚\nガマンしやがった‥！",
  "tgt": "{立绘0202}「那几位小姐姐\n真是了不起‥\n---\n居然真的\n忍了一整晚‥！"
 },
 {
  "id": "015174",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘4100}「{队员00}、{码0B}兄さま！",
  "tgt": "{立绘4100}「{队员00}，{码0B}哥哥！"
 },
 {
  "id": "015175",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「隊長さん‥\n顏色が、悪いじゃないか‥\n---\n怖かったのか？",
  "tgt": "{框06}{立绘C240}「队长‥\n脸色不太好呀‥\n---\n害怕了吗？"
 },
 {
  "id": "015176",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘8807}「な、{码0B}何ともない！",
  "tgt": "{立绘8807}「没、没事！{码0B}何ともない！"
 },
 {
  "id": "015177",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{框06}{立绘8242}「まったく‥‥\n---\nウデっぷしと言い\nどきょうと言い\n大したモンだよ‥",
  "tgt": "{框06}{立绘8242}「真是的‥‥\n---\n论身手\n论胆量\n都非同小可呀‥"
 },
 {
  "id": "015178",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘4100}「これで、わたし達\n船に 乘れますね\n{立绘0905}ジグさん‥？",
  "tgt": "{立绘4100}「这下\n我们能上船了吧\n{立绘0905}吉格先生……？"
 },
 {
  "id": "015179",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{框06}{立绘8242}「いや‥‥\n最後に、もう一つだけ‥",
  "tgt": "{框06}{立绘8242}「不‥‥\n最后，还有一件事‥"
 },
 {
  "id": "015180",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{框06}{立绘8242}「船乘りが\n何か ヘマをすると‥\n---\nこれで、けつを\nたたくのが 決まりだ‥",
  "tgt": "{框06}{立绘8242}「船夫要是\n搞砸了什么‥\n---\n就要用这个\n打屁股，这是规矩‥"
 },
 {
  "id": "015181",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{框06}{立绘8242}「つまり‥、いつでも\n{色02}けつパン{/色}を 食らう\nカクゴが なければ‥\n---\n船に、乘ることは できない。\nそうだな‥？",
  "tgt": "{框06}{立绘8242}「也就是说……\n要是没有随时\n挨{色02}屁股开花{/色}的觉悟……\n---\n就别想上船。\n是吧……？"
 },
 {
  "id": "015182",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{框06}{立绘8242}「と、いうワケで\n最後に、あんた達の\nカクゴを 見たい‥\n---\n{色02}けつ{/色}を 出して\nもらおうか、ねえちゃん‥？",
  "tgt": "{框06}{立绘8242}「所以\n最后想见识\n你们的觉悟……\n---\n把{色02}屁股{/色}露出来吧\n大姐姐……？"
 },
 {
  "id": "015183",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0A05}「け、{码0B}け‥{码0B}‥{码0B}‥\n---\nおっ‥{码0B} おしり‥\n出さないと、ダメですか！？",
  "tgt": "{立绘0A05}「屁，屁‥‥‥\n---\n露‥露屁股‥\n不做就不行吗！？{码0B}け‥{码0B}‥{码0B}‥\n---\nおっ‥{码0B} おしり‥\n出さないと、ダメですか！？"
 },
 {
  "id": "015184",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{框06}{立绘8043}「そ、{码0B}そうだ！\n男は、生けつだ！",
  "tgt": "{框06}{立绘8043}「就、就是！\n男人才是祭品！{码0B}そうだ！\n男は、生けつだ！"
 },
 {
  "id": "015185",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{框06}{立绘8242}「‥‥な、{码0B}できねぇだろ？\n---\nあきらめて、るすばん‥",
  "tgt": "{框06}{立绘8242}「‥‥看，做不到吧？\n---\n死心吧，看家去‥{码0B}できねぇだろ？\n---\nあきらめて、るすばん‥"
 },
 {
  "id": "015186",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{框05}{立绘4400}「しりを 出せば\nよいのだろう‥？",
  "tgt": "{框05}{立绘4400}「把屁股\n露出来就行了吧……？"
 },
 {
  "id": "015187",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{框06}{立绘8242}「わ、{码0B}分かった！\n---\nあんた達の、カクゴは\n分かったから‥\nふくを 着てくれ！！",
  "tgt": "{框06}{立绘8242}「明，明白了！\n---\n你们的觉悟\n我见识到了‥\n快把衣服穿上！！{码0B}分かった！\n---\nあんた達の、カクゴは\n分かったから‥\nふくを 着てくれ！！"
 },
 {
  "id": "015188",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「いやー‥、負けたよ\nあんた達には‥\n---\nああ言えば、あきらめて\nくれると 思ったんだが‥",
  "tgt": "{立绘0202}「哎呀——，输了\n彻底输了‥\n---\n本以为这么一说\n你们就会死心的‥"
 },
 {
  "id": "015189",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「じゃ、今度こそ‥",
  "tgt": "{框06}{立绘C140}「那，这次真的‥"
 },
 {
  "id": "015190",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「ああ‥\nそこまで カクゴが\n決まってれば‥\n---\nもう、しきたりが\nどうとか‥\n言ってる場合じゃ、ねぇな。",
  "tgt": "{立绘0202}「唉‥\n觉悟都下到\n这份上了‥\n---\n老规矩什么的\n也就没资格\n再说了。"
 },
 {
  "id": "015191",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「船を 出してやるよ‥\n---\n用意ができたら\nおれに、声をかけて\nくれよな？",
  "tgt": "{立绘0202}「船就借给你们‥\n---\n准备好了\n就喊我一声\n行吗？"
 },
 {
  "id": "015192",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「ん‥、用意は\nいいのか？{码14010C82}はい\nまだ",
  "tgt": "{立绘0202}「嗯‥，准备\n好了吗？好了\n还没{码14010C82}はい\nまだ"
 },
 {
  "id": "015193",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「そうかい‥、じゃ\n出発の用意が 整ったら\n言ってくれ。",
  "tgt": "{立绘0202}「这样啊‥，那\n准备好了\n再告诉我。"
 },
 {
  "id": "015194",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}「いつでも、船を出す\n用意は できてるよー‥",
  "tgt": "{立绘0000}「随时都能\n开船哟——……"
 },
 {
  "id": "015195",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}「あんたら、すごいねぇ‥\n---\nきっと、りっぱな\n船乘りに なれるよー！",
  "tgt": "{立绘0000}「你们真厉害呢……\n---\n一定能成为\n了不起的船员哟——！"
 },
 {
  "id": "015196",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「そうか‥、{码0B}よし。\nじゃあ、出発しよう！",
  "tgt": "{立绘0202}「这样啊‥，好。\n那就出发吧！{码0B}よし。\nじゃあ、出発しよう！"
 },
 {
  "id": "015197",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「ツネキチ、クランク！\n船を出すぜ！！",
  "tgt": "{立绘0202}「常吉、库兰克！\n开船喽！！"
 },
 {
  "id": "015198",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「ほらみたことか\nおじょうちゃん‥\n---\nこれ以上 やったって\nムダだよ、あきらめな！",
  "tgt": "{立绘0202}「看见了吧\n小姑娘‥\n---\n再折腾也是\n白费，快放弃吧！"
 },
 {
  "id": "015199",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「どうだい、あの\nおじょうちゃんも\nもう こりただろ‥？",
  "tgt": "{立绘0202}「怎么样，那位\n小姑娘也该\n长记性了吧‥？"
 },
 {
  "id": "015200",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「なんだって‥また\n決闘するってのかい？{码14020C82}はい\nいいえ",
  "tgt": "{立绘0202}「什么‥还要\n再决斗吗？要\n不要{码14020C82}はい\nいいえ"
 },
 {
  "id": "015201",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「そうだよな\nやめといた方が いい‥",
  "tgt": "{立绘0202}「就是嘛\n还是算了吧‥"
 },
 {
  "id": "015202",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「しょうがねえなあ‥\nツネキチ、じゅんびしな！",
  "tgt": "{立绘0202}「真拿你们没办法‥\n常吉，做好准备！"
 },
 {
  "id": "015203",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0003}「い、いつでも\n勝負してやるぞー！",
  "tgt": "{立绘0003}「随……随时\n奉陪到底——！"
 },
 {
  "id": "015204",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}「うーん、やっぱり\n女の子に 船乘りは\n無理かなあ‥",
  "tgt": "{立绘0000}「嗯——，果然\n小姑娘还是\n当不了船员吧……"
 },
 {
  "id": "015205",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0202}「どうした‥\n船を 使いたいのか？{码14030C82}はい\nいいえ",
  "tgt": "{立绘0202}「怎么了‥\n要用船吗？要\n不要{码14030C82}はい\nいいえ"
 },
 {
  "id": "015206",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「荷物を 整理してたら\n{色03}お宝{/色}が 出てきたんだ‥\n---\nよかったら、キミの\n{色03}{占位00}{/色}と\n取り替えないか？{码14040C92}取り替える！\nやめておく‥",
  "tgt": "「整理行李的时候\n翻出了一样{色03}宝物{/色}……\n---\n可以的话\n要不要用你的\n{色03}{占位00}{/色}\n跟我换？{码14040C92}换！\n还是算了……"
 },
 {
  "id": "015207",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "\n {色03}{占位01}{/色}と 取り替えた！\n---\n",
  "tgt": "\n换成了{色03}{占位01}{/色}！\n---\n"
 },
 {
  "id": "015208",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「古い物だけど\nいい品だろう‥？",
  "tgt": "「虽然是老物件\n但算是好货吧‥？"
 },
 {
  "id": "015209",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「いくら かたづけても\nガラクタばかり‥\n---\nなにか、{色03}お宝{/色}でも\n出てこないかな？",
  "tgt": "「收拾了半天\n全是破烂‥\n---\n能不能翻出\n什么宝物呢？{色03}お宝{/色}でも\n出てこないかな？"
 },
 {
  "id": "015210",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "「お客さん、お買い物なら\nカウンターで どうぞ。",
  "tgt": "「客人，要买东西\n请到柜台这边。"
 },
 {
  "id": "015211",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "まずは、二人の様子を\n見に行こう‥",
  "tgt": "先去看看\n两人的情况吧‥"
 },
 {
  "id": "015212",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}クランク\n「ひさしぶりー！\n---\n海旅にはもう\nなれた？\n---\n水神さまがみとめた\n君たちなら\nモンダイないとは思うけど、\n---\nもし良かったら\n俺たち海の男の\n生活術を教えるよー？{码14820C92}教えてもらう\nえんりょする",
  "tgt": "{立绘0000}库兰克\n「好久不见——！\n---\n海上旅行\n习惯了吗？\n---\n如果是被\n水神大人认可的人\n应该没什么问题……\n---\n要是愿意的话\n就把我们海上男儿的\n生活术教给你吧？{码14820C92}请教我\n还是算了吧"
 },
 {
  "id": "015213",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}{码0B}どうやら\nだいぶ海の男らしく\nなったねー。\n---\nこれならきっと\n俺たちの技や術を\n覺えられるはずだよ。\n---\n手始めはこの\n{色04}おいうち{/色}だ。\n---\nどんな敵にも\n情けをかけないきびしさ。\n---\nその強さが海の男には\n必要なんだ。",
  "tgt": "{立绘0000}{码0B}看样子\n你已经很有\n海上男儿的模样了。\n---\n这样的话\n肯定学得会\n我们的技艺。\n---\n先从这招\n{色04}追击{/色}开始。\n---\n无论对什么敌人\n都绝不留情的狠劲。\n---\n海上男儿\n就需要这份强悍。"
 },
 {
  "id": "015214",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}‥うーんと、\nどうしたらいいのかな‥\n---\n‥とりあえず今度は\n{色02}{占位00}{/色}以上の\nコンボを出してみてー。\n---\nそうしたらまた、\n何か教えてあげるよ。",
  "tgt": "{立绘0000}……嗯——\n该怎么办呢……\n---\n……总之这次\n先打出超过\n{色02}{占位00}{/色}的\n连击试试——。\n---\n到时我再\n教你点别的。"
 },
 {
  "id": "015215",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}{码0B}よーし、では\n海の男の基本を教えるよ。\n---\n{码0B}‥‥と思ったけど、\nどうもまだ海の男らしい\n一体感が感じられないねー。\n---\nそうだな‥\nうーんと‥{码0B}\nコンボ{码0B}って知ってるかい？\n---\nあれを{色02}25{/色}HIT以上\n出すくらいになれば、\n---\nきっと海の男に\n近づけると思うよ。",
  "tgt": "{立绘0000}{码0B}好——那\n就教你海上男儿的基本功。\n---\n{码0B}……话虽如此，\n总觉得你们还缺少\n海上男儿的那种一体感。\n---\n这样吧……\n嗯——{码0B}\n连击{码0B}，你知道吗？\n---\n等你能打出\n{色02}25{/色}HIT以上，\n---\n我想你就离\n海上男儿\n不远了。"
 },
 {
  "id": "015216",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}またねー。",
  "tgt": "{立绘0000}回头见——。"
 },
 {
  "id": "015217",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}クランク\n「今日はいい風が\nふいてるねー。\n---\nこんな日は\nアイツのことを\n思い出すよ。\n---\nところでどう？\nあれから海の男の\n一体感はつかめた？",
  "tgt": "{立绘0000}库兰克\n「今天的风\n吹得正舒服——。\n---\n这样的日子\n就会想起\n那家伙。\n---\n话说怎么样？\n那之后有没有\n找到海上男儿的一体感？"
 },
 {
  "id": "015218",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}{码0B}‥ああっっ！\n今のアイコンタクト！\n---\nどうやら君たち\nかなりのレベルに\nたっしたようだねー。\n---\nよーし、それなら\n海の男だけが知っている、\n---\nこの{色03}{占位01}{/色}を\n教えてあげるよー。",
  "tgt": "{立绘0000}{码0B}……啊啊！\n刚才的眼神交流！\n---\n看来你们\n已经达到\n相当高的水平了。\n---\n好——那\n就把只有海上男儿才知道的\n---\n这招{色03}{占位01}{/色}\n教给你们。"
 },
 {
  "id": "015219",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}今度は{色02}{占位00}{/色}以上の\nコンボを出してみてー。\n---\nそうしたらまた、\n何か教えてあげるよ！",
  "tgt": "{立绘0000}这次\n打出超过{色02}{占位00}{/色}的\n连击试试——。\n---\n到时我再\n教你点别的！"
 },
 {
  "id": "015220",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}{码0B}‥いつのまにか君たち、\n---\n海の男そのものに\nなっているじゃないか！\n---\n教えようにも\nもう、教えることが\nなにもないよ。\n---\nあとは自分たちで\nがんばるんだよー！",
  "tgt": "{立绘0000}{码0B}……不知不觉，\n---\n你们已经\n俨然是\n海上男儿了嘛！\n---\n我想教\n也没什么可教的了。\n---\n接下来\n就靠自己努力——！"
 },
 {
  "id": "015221",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}で、どうするんだい？{码14820C93}教えてほしい\nやめます\n何でもないです",
  "tgt": "{立绘0000}那么，怎么样？{码14820C93}想学\n不学了\n没什么事"
 },
 {
  "id": "015222",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}他にはー？{码14820C93}教えてほしい\nやめます\n何でもないです",
  "tgt": "{立绘0000}还有别的吗——？{码14820C93}想学\n不学了\n没什么事"
 },
 {
  "id": "015223",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}{码0B}‥みんなすでに\n海の男だよ。",
  "tgt": "{立绘0000}{码0B}……你们\n都已经是\n海上男儿了。"
 },
 {
  "id": "015224",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}{码0B}では{占位02}に\n{色04}おいうち{/色}を教えるよー！\n---\nこれで海の男の\nなかま入りだ。",
  "tgt": "{立绘0000}{码0B}那就教{占位02}\n{色04}追击{/色}吧——！\n---\n这样就算\n加入海上男儿了。"
 },
 {
  "id": "015225",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}{码0B}では 君たちに\n{色04}おいうち{/色}を教えるよー！\n---\nこれで海の男の\nなかま入りだ。",
  "tgt": "{立绘0000}{码0B}那就教你们\n{色04}追击{/色}吧——！\n---\n这样就算\n加入海上男儿了。"
 },
 {
  "id": "015226",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}誰もいないのー？\nま、いいけど。",
  "tgt": "{立绘0000}没人吗——？\n算了，也行。"
 },
 {
  "id": "015227",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}{码0B}‥海の男は\nいないよ。",
  "tgt": "{立绘0000}{码0B}……没有\n海上男儿哦。"
 },
 {
  "id": "015228",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}{码0B}うーん、\nそれでは{占位02}は\n---\nもう海の男じゃないよ。",
  "tgt": "{立绘0000}{码0B}嗯——，\n那{占位02}\n---\n就不算海上男儿了。"
 },
 {
  "id": "015229",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}{码0B}うーん、\nそれでは君たちは\n---\nもう海の男じゃないよ。",
  "tgt": "{立绘0000}{码0B}嗯——，\n那你们\n---\n就不算海上男儿了。"
 },
 {
  "id": "015230",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}‥どうしたのー？\nま、いいけど。",
  "tgt": "{立绘0000}……怎么啦——？\n算了，也行。"
 },
 {
  "id": "015231",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}海の男にコトバはいらない\n重要なのは心の一体感！\n---\n{色02}{占位00}{/色}以上の\nコンボを出したら\nまたやって来てー。",
  "tgt": "{立绘0000}海上男儿不需要言语\n重要的是心意相通！\n---\n打出超过\n{色02}{占位00}{/色}的连击\n再来找我——。"
 },
 {
  "id": "015232",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "{立绘0000}クランク\n「‥‥知らない人は\nふねには乘せられないよ。",
  "tgt": "{立绘0000}库兰克\n「……不认识的人\n可不能让他上船哦。"
 },
 {
  "id": "015233",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "30",
  "tgt": "30"
 },
 {
  "id": "015234",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "40",
  "tgt": "40"
 },
 {
  "id": "015235",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "50",
  "tgt": "50"
 },
 {
  "id": "015236",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "70",
  "tgt": "70"
 },
 {
  "id": "015237",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "メガホン",
  "tgt": "喇叭"
 },
 {
  "id": "015238",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "くうき撃ち",
  "tgt": "空气击"
 },
 {
  "id": "015239",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "せんぎり",
  "tgt": "千斩"
 },
 {
  "id": "015240",
  "file": "WORLD/AREAS031.EMI",
  "seg": 11,
  "src": "滅殺",
  "tgt": "灭杀"
 },
 {
  "id": "015241",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "えりーなべや\nえす032と033",
  "tgt": "艾莉娜屋\nS032和033"
 },
 {
  "id": "015242",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框02}{立绘8040}「や、来られましたね。",
  "tgt": "{框02}{立绘8040}「呀，你们来了呀。"
 },
 {
  "id": "015243",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框04}{立绘8141}「きさま‥！\nエリーナは‥‥！？",
  "tgt": "{框04}{立绘8141}「你这家伙‥！\n艾莉娜‥‥！？"
 },
 {
  "id": "015244",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框02}{立绘0000}「何度も申しますが‥\nその方は、もう\nいらっしゃいませんよ‥\n---\nその 名残でしたら\nこの部屋に\nありますが‥‥",
  "tgt": "{框02}{立绘0000}「我说过很多次了……\n那位\n已经不在了……\n---\n要说他留下的\n痕迹，这房间里\n倒是有…………"
 },
 {
  "id": "015245",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框03}{立绘0202}「ルーン將軍は\nどうされた‥？",
  "tgt": "{框03}{立绘0202}「卢恩将军\n怎么样了‥？"
 },
 {
  "id": "015246",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框02}{立绘8040}「や、{队员04}隊長\nひと足ちがい でしたな‥\n---\n將軍は、先ほど\n帝都へ 向かわれました。",
  "tgt": "{框02}{立绘8040}「呀，{队员04}队长\n您晚了一步呀‥\n---\n将军方才已经\n朝帝都去了。"
 },
 {
  "id": "015247",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框03}{立绘0202}「何‥\nどう言う事だ？",
  "tgt": "{框03}{立绘0202}「什么‥\n怎么回事？"
 },
 {
  "id": "015248",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框02}{立绘8040}「ルーン將軍のような\n古い方には‥\n---\n私の考えが\n分かって いただけない\nようでして‥",
  "tgt": "{框02}{立绘8040}「像卢恩将军那样的\n老派人物‥\n---\n似乎\n理解不了\n我的想法呢‥"
 },
 {
  "id": "015249",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框04}{立绘8341}「それよりも‥\n---\nエリーナが いないと言うのは\nどういう事なんだ！？",
  "tgt": "{框04}{立绘8341}「比起这个‥\n---\n说艾莉娜不见了\n是怎么回事！？"
 },
 {
  "id": "015250",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框02}{立绘0000}「や、{码0B}爭う気は\nありませんよ‥\n---\nどうぞ、ご自分で\nお確かめ下さい‥",
  "tgt": "{框02}{立绘0000}「不，{码0B}我\n没有争斗的意思……\n---\n请\n自行确认吧……"
 },
 {
  "id": "015251",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框04}{立绘C240}「ま、待て！",
  "tgt": "{框04}{立绘C240}「等，等等！"
 },
 {
  "id": "015252",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘8403}「来て‥、{码0B}くれましたね‥",
  "tgt": "{立绘8403}「你们‥，来了呀‥{码0B}くれましたね‥"
 },
 {
  "id": "015253",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「エリーナ‥‥\nやっと‥、会えた‥！",
  "tgt": "{框06}{立绘C240}「艾莉娜‥‥\n终于‥，见到了‥！"
 },
 {
  "id": "015254",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框06}{立绘8544}「いっしょに‥\n归りましょう、姉さま！",
  "tgt": "{框06}{立绘8544}「一起‥\n回去吧，姐姐大人！"
 },
 {
  "id": "015255",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘0605}「来てくれて、ありがとう\n{队员01}‥、{队员02}‥\n---\nですが‥‥",
  "tgt": "{立绘0605}「谢谢你们能来\n{队员01}‥、{队员02}‥\n---\n但是‥‥"
 },
 {
  "id": "015256",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘0605}「ですが、私は‥\n---\nここから、動くことが\nできません‥",
  "tgt": "{立绘0605}「但是，我‥\n---\n已经无法从这里\n动身了‥"
 },
 {
  "id": "015257",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框06}{立绘8744}「ど、どうしてです\n姉さま‥！？\n---\n今だったら、帝国は\nこんらんしていて‥\n逃げ出すのは、かんたんです！",
  "tgt": "{框06}{立绘8744}「为，为什么呀\n姐姐大人‥！？\n---\n现在帝国\n正一片混乱‥\n逃出去很简单呀！"
 },
 {
  "id": "015258",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框06}{立绘C240}「行こう、エリーナ‥\n---\nだいじょうぶだ\n俺たちが ついてる‥",
  "tgt": "{框06}{立绘C240}「走吧，艾莉娜‥\n---\n没事的\n有我们陪着‥"
 },
 {
  "id": "015259",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘8605}「今‥‥\n世界が 大きく動こうと\nしていますね‥\n---\n{立绘8403}あなた達が、その\n大きな流れの中に いるのが\n分かります‥",
  "tgt": "{立绘8605}「如今‥‥\n世界正要\n大规模变动呢‥\n---\n{立绘8403}我知道，你们\n正身处那股\n巨大的洪流之中‥"
 },
 {
  "id": "015260",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框06}{立绘8341}「エリーナ‥？",
  "tgt": "{框06}{立绘8341}「艾莉娜‥？"
 },
 {
  "id": "015261",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘8605}「旅を 續けてください‥\n行くべきところへ‥！",
  "tgt": "{立绘8605}「请继续你们的旅途吧‥\n去该去的地方‥！"
 },
 {
  "id": "015262",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框06}{立绘8844}「姉さま‥‥",
  "tgt": "{框06}{立绘8844}「姐姐大人‥‥"
 },
 {
  "id": "015263",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘0605}「{队员01}‥\n---\nしばらく、{队员02}と\n二人に してもらえる？",
  "tgt": "{立绘0605}「{队员01}‥\n---\n能让我和{队员02}\n单独待一会儿吗？"
 },
 {
  "id": "015264",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘0403}「ありがとう、{队员01}\nそれと‥‥",
  "tgt": "{立绘0403}「谢谢你，{队员01}\n还有‥‥"
 },
 {
  "id": "015265",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘8605}「{队员00}さん‥\n---\n『{道具5601}』を\n置いて行って\n下さいませんか‥？",
  "tgt": "{立绘8605}「{队员00}……\n---\n能否把\n『{道具5601}』\n留在这里……？"
 },
 {
  "id": "015266",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘8403}「ありがとうございます‥",
  "tgt": "{立绘8403}「谢谢你们‥"
 },
 {
  "id": "015267",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘4200}「すまないが‥\n---\nしばらく、外で\n待っていてくれ‥",
  "tgt": "{立绘4200}「不好意思……\n---\n先在外面\n等一会儿吧……"
 },
 {
  "id": "015268",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「そういえば‥‥\n---\n{立绘8944}姉さま、どうして\n{队员00}の名前\n知ってたのかしら‥？",
  "tgt": "{框06}{立绘C140}「说起来……\n---\n{立绘8944}姐姐为什么\n知道{队员00}\n的名字呢……？"
 },
 {
  "id": "015269",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框03}{立绘4500}「ディース様が‥\n---\n{立绘0A06}「竜みたいな\n気配がするよ‥\n---\n{立绘0B07}「‥って言ってます。",
  "tgt": "{框03}{立绘4500}「蒂斯大人……\n---\n{立绘0A06}「感觉到了\n龙一样的气息……\n---\n{立绘0B07}「……是这么说的。"
 },
 {
  "id": "015270",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框06}{立绘8341}「エリーナ‥、一体‥‥",
  "tgt": "{框06}{立绘8341}「艾莉娜‥，到底‥‥"
 },
 {
  "id": "015271",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘8605}「{队员02}‥‥\n---\nあなた達が、今‥\n世界を動かす 大きな\n流れの中に あると‥\n---\n言いましたよね‥",
  "tgt": "{立绘8605}「{队员02}‥‥\n---\n你们刚才说‥\n自己正身处推动世界的\n巨大洪流之中‥\n---\n对吧‥"
 },
 {
  "id": "015272",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘8605}「流れの一つは\n{队员00}さん‥\n---\n{立绘0605}そして、{码0B}もう一つの\nうつろわざるもの‥",
  "tgt": "{立绘8605}「潮流之一\n是{队员00}……\n---\n{立绘0605}而另一个{码0B}\n不变不易者……"
 },
 {
  "id": "015273",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘8605}「ふたつは 出会い\nそこで‥‥\n---\nあなた達の、旅の意味が\n問われるでしょう‥",
  "tgt": "{立绘8605}「另一股则是相遇\n在那里‥‥\n---\n你们旅途的\n意义将受到考验‥"
 },
 {
  "id": "015274",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框06}{立绘8341}「エリーナ‥\nどうしたって 言うんだ？\n---\nどうして、そんな事が\n分かるんだ‥？\n---\nそれに‥\nここを 動けないって\n言うのは‥‥",
  "tgt": "{框06}{立绘8341}「艾莉娜‥\n你到底怎么了？\n---\n这种事\n你怎么会知道‥？\n---\n还有‥\n说自己动不了\n是怎么回事‥‥"
 },
 {
  "id": "015275",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘8605}「{队员02}‥\nよく闻いて ください‥\n---\n私は‥{码0B}‥{码0B}‥",
  "tgt": "{立绘8605}「{队员02}‥\n请好好听着‥\n---\n我‥‥‥{码0B}‥{码0B}‥"
 },
 {
  "id": "015276",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「うつろわざるもの‥\nですよ。",
  "tgt": "{框05}{立绘0000}「是不变不易者……\n哟。"
 },
 {
  "id": "015277",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「彼女は‥\n私の 作り上げた\nうつろわざるもの‥‥",
  "tgt": "{框05}{立绘0000}「她是……\n我造出来的\n不变不易者…………"
 },
 {
  "id": "015278",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框06}{立绘8341}「作った‥ だと？\n---\n何を言っている？",
  "tgt": "{框06}{立绘8341}「造出来的‥？\n---\n你在说什么？"
 },
 {
  "id": "015279",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「や、そうです‥‥\n---\nエリーナさんを 呪砲の\nニエに 使おうと\n思いまして‥",
  "tgt": "{框05}{立绘0000}「不，就是这样……\n---\n我正想把艾莉娜\n用作咒炮的\n祭品……"
 },
 {
  "id": "015280",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「ニエだと‥\nきさまっ！？",
  "tgt": "{框06}{立绘8141}「祭品‥\n你这家伙！？"
 },
 {
  "id": "015281",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「ええ、ご存知のとおり‥\n---\nニエは‥、目標と関係が\n深い方が、よいですから‥\n---\n東側で 人気の高い\nエリーナ様は‥\n呪砲弾に ぴったりです。",
  "tgt": "{框05}{立绘0000}「嗯，您也知道……\n---\n祭品……跟目标\n关系越深越好……\n---\n在东边人气很高的\n艾莉娜大人……\n正适合当咒炮弹。"
 },
 {
  "id": "015282",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「ただ‥、もんだいが\nありまして‥‥",
  "tgt": "{框05}{立绘0000}「只是……还有个\n问题…………"
 },
 {
  "id": "015283",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘0000}「ニエに、苦痛をあたえて\n呪いにするんですが‥\n---\n苦痛を あたえすぎると\nニエが 死んでしまいます。\n---\nそこで‥‥",
  "tgt": "{立绘0000}「要对祭品施加痛苦\n化为诅咒……\n---\n可要是施加的痛苦太多\n祭品就会死掉。\n---\n于是…………"
 },
 {
  "id": "015284",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘0000}「私は、彼女に‥\n---\nかんたんには 死ぬことのない\n身体を‥\n作って さしあげたのです！",
  "tgt": "{立绘0000}「我给她……\n---\n打造了一副\n轻易死不掉的\n身体！"
 },
 {
  "id": "015285",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框06}{立绘8C41}「うっ‥{延时30}",
  "tgt": "{框06}{立绘8C41}「呜‥{延时30}"
 },
 {
  "id": "015286",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框02}{立绘C140}「‥{码0B}‥{码0B}‥\n---\nそれで、姉さまは\nルディアの王子様と\nこんやく したんですけど‥\n---\n{立绘8D44}{队员02}兄さまが\n止めてたら‥\n今ごろは‥‥",
  "tgt": "{框02}{立绘C140}「‥‥‥\n---\n后来，姐姐就\n和鲁迪亚王子\n订婚了‥\n---\n{码0B}要是{码0B}兄长\n当时阻止了‥\n现在就‥‥{立绘8D44}{队员02}兄さまが\n止めてたら‥\n今ごろは‥‥"
 },
 {
  "id": "015287",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框02}{立绘C140}「それにしても、長いですね‥\n---\nふたりで、何を\n話してるんでしょう‥？",
  "tgt": "{框02}{立绘C140}「话说回来，好慢呀‥\n---\n两个人\n在聊什么呢‥？"
 },
 {
  "id": "015288",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘8C41}「ううわあああ‥！{延时40}",
  "tgt": "{立绘8C41}「呜哇啊啊‥！{延时40}"
 },
 {
  "id": "015289",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「や、いかがです？\n---\nたくさんの 魔物を\n魔術的に つなぎあわせた\n力作ですよ‥",
  "tgt": "{框05}{立绘0000}「如何，还满意吗？\n---\n这是把众多魔物\n用魔术缝合起来的\n力作哟……"
 },
 {
  "id": "015290",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「ただ、ちょっと\n大きく 作りすぎましたね‥\n---\n皆さんが 通ってきた\n大きな內臟‥\n---\nあれ、彼女の\n內臟なんですよ。",
  "tgt": "{框05}{立绘0000}「只是，做得\n稍微有点太大了呢……\n---\n各位一路穿过的\n那些大内脏……\n---\n那些，全是\n她的内脏哟。"
 },
 {
  "id": "015291",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「どんなに苦痛を 与えても\n死なない、ニエ‥\n---\nうつろわざるもの‥\nなんですよ、つまり。",
  "tgt": "{框05}{立绘0000}「无论施加多少痛苦\n都不会死的祭品……\n---\n换言之\n就是不变不易者……哟。"
 },
 {
  "id": "015292",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「や、{码0B}や‥\n---\nそうです、私は‥\n神を 作り上げたんです！",
  "tgt": "{框05}{立绘0000}「不，{码0B}……\n---\n没错，我……\n造出了一个神！"
 },
 {
  "id": "015293",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「キサマ‥\n殺してやる！！",
  "tgt": "{框06}{立绘8141}「你这家伙‥\n我要杀了你！！"
 },
 {
  "id": "015294",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「や、いけませんね。\n---\n神を 作ることができる\nこの私を、殺すなんて‥！",
  "tgt": "{框06}{立绘8040}「呀，那可不行呢。\n---\n竟然想杀\n能造出神的我‥！"
 },
 {
  "id": "015295",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「私は、これから‥\n---\nこの技術を 使って\n世界を 変えてゆかねば\nなりませんから、{码0B}ね‥！",
  "tgt": "{框06}{立绘8040}「我从今往后‥\n---\n还要用这项技术\n去改变世界，\n你懂的‥！{码0B}ね‥！"
 },
 {
  "id": "015296",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘8645}「{队员02}‥",
  "tgt": "{立绘8645}「{队员02}‥"
 },
 {
  "id": "015297",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘8645}「{队员02}‥\n---\nもう、{码0B}いいのです。",
  "tgt": "{立绘8645}「{队员02}‥\n---\n已经，可以了。{码0B}いいのです。"
 },
 {
  "id": "015298",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框05}{立绘C240}「エリーナ‥‥、俺は‥\n---\nお前に‥‥\n---\n何も‥‥‥",
  "tgt": "{框05}{立绘C240}「艾莉娜‥‥，我‥\n---\n对你‥‥\n---\n什么都没‥‥‥"
 },
 {
  "id": "015299",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘8645}「そこに‥\n{道具5601}が、あります。",
  "tgt": "{立绘8645}「那里‥\n有{道具5601}。"
 },
 {
  "id": "015300",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘8645}「楽に‥‥\nして下さい、{队员02}‥",
  "tgt": "{立绘8645}「请让我‥‥\n解脱吧，{队员02}‥"
 },
 {
  "id": "015301",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{框05}{立绘0301}「で、{码0B}{码0B}できない‥\n---\nお、{码0B}俺は‥‥\n俺は‥、{码0B}お前のことを‥",
  "tgt": "{框05}{立绘0301}「做，做不到‥\n---\n我，我‥‥\n我‥，对你‥‥{码0B}{码0B}できない‥\n---\nお、{码0B}俺は‥‥\n俺は‥、{码0B}お前のことを‥"
 },
 {
  "id": "015302",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘8443}「知っています。\n---\nだから、あなたに\n賴むのです、{队员02}‥",
  "tgt": "{立绘8443}「我知道。\n---\n所以才拜托\n你呀，{队员02}‥"
 },
 {
  "id": "015303",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘8443}「{队员02}‥\n---\n最後に、あなたに会えて\nよかった‥‥",
  "tgt": "{立绘8443}「{队员02}‥\n---\n最后能见到你\n真是太好了‥‥"
 },
 {
  "id": "015304",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "兄さまは、何も",
  "tgt": "兄长什么"
 },
 {
  "id": "015305",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "話してくれませんでした‥",
  "tgt": "都没有告诉我‥"
 },
 {
  "id": "015306",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "けれども、姉さまが",
  "tgt": "但，姐姐大人"
 },
 {
  "id": "015307",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "もう、戻らないのだと言うことが",
  "tgt": "已经不会再回来了——"
 },
 {
  "id": "015308",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "分かりました‥",
  "tgt": "我明白了‥"
 },
 {
  "id": "015309",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "うつろわざるものを めぐる",
  "tgt": "围绕不变不易者的"
 },
 {
  "id": "015310",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "私たちの旅は‥",
  "tgt": "我们的旅途‥"
 },
 {
  "id": "015311",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "終わりに さしかかっていました‥",
  "tgt": "已渐渐走向终结‥"
 },
 {
  "id": "015312",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘0E08}「思いあがって いたのだ‥",
  "tgt": "{立绘0E08}「是我太过傲慢了‥"
 },
 {
  "id": "015313",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "{立绘0E08}「自分達の手で\n神を 作り上げ‥\n---\n古い神々を\n退けようなどと‥",
  "tgt": "{立绘0E08}「妄想用自己的手\n造出神明‥\n---\n把古老的神明们\n赶下台‥"
 },
 {
  "id": "015314",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "考えるべきでは、なかった。",
  "tgt": "这种想法，本不该有。"
 },
 {
  "id": "015315",
  "file": "WORLD/AREAS032.EMI",
  "seg": 11,
  "src": "今、戻れば つらくなる\nだけだろう‥",
  "tgt": "现在回去\n也只会痛苦吧‥"
 },
 {
  "id": "015316",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "えりーなべや\nえす032と033",
  "tgt": "艾莉娜屋\nS032和033"
 },
 {
  "id": "015317",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框02}{立绘8040}「や、来られましたね。",
  "tgt": "{框02}{立绘8040}「呀，你们来了呀。"
 },
 {
  "id": "015318",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框04}{立绘8141}「きさま‥！\nエリーナは‥‥！？",
  "tgt": "{框04}{立绘8141}「你这家伙‥！\n艾莉娜‥‥！？"
 },
 {
  "id": "015319",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框02}{立绘0000}「何度も申しますが‥\nその方は、もう\nいらっしゃいませんよ‥\n---\nその 名残でしたら\nこの部屋に\nありますが‥‥",
  "tgt": "{框02}{立绘0000}「我说过很多次了……\n那位\n已经不在了……\n---\n要说他留下的\n痕迹，这房间里\n倒是有…………"
 },
 {
  "id": "015320",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框03}{立绘0202}「ルーン將軍は\nどうされた‥？",
  "tgt": "{框03}{立绘0202}「卢恩将军\n怎么样了‥？"
 },
 {
  "id": "015321",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框02}{立绘8040}「や、{队员04}隊長\nひと足ちがい でしたな‥\n---\n將軍は、先ほど\n帝都へ 向かわれました。",
  "tgt": "{框02}{立绘8040}「呀，{队员04}队长\n您晚了一步呀‥\n---\n将军方才已经\n朝帝都去了。"
 },
 {
  "id": "015322",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框03}{立绘0202}「何‥\nどう言う事だ？",
  "tgt": "{框03}{立绘0202}「什么‥\n怎么回事？"
 },
 {
  "id": "015323",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框02}{立绘8040}「ルーン將軍のような\n古い方には‥\n---\n私の考えが\n分かって いただけない\nようでして‥",
  "tgt": "{框02}{立绘8040}「像卢恩将军那样的\n老派人物‥\n---\n似乎\n理解不了\n我的想法呢‥"
 },
 {
  "id": "015324",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框04}{立绘8341}「それよりも‥\n---\nエリーナが いないと言うのは\nどういう事なんだ！？",
  "tgt": "{框04}{立绘8341}「比起这个‥\n---\n说艾莉娜不见了\n是怎么回事！？"
 },
 {
  "id": "015325",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框02}{立绘0000}「や、{码0B}爭う気は\nありませんよ‥\n---\nどうぞ、ご自分で\nお確かめ下さい‥",
  "tgt": "{框02}{立绘0000}「不，{码0B}我\n没有争斗的意思……\n---\n请\n自行确认吧……"
 },
 {
  "id": "015326",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框04}{立绘C240}「ま、待て！",
  "tgt": "{框04}{立绘C240}「等，等等！"
 },
 {
  "id": "015327",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘8403}「来て‥、{码0B}くれましたね‥",
  "tgt": "{立绘8403}「你们‥，来了呀‥{码0B}くれましたね‥"
 },
 {
  "id": "015328",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框06}{立绘C240}「エリーナ‥‥\nやっと‥、会えた‥！",
  "tgt": "{框06}{立绘C240}「艾莉娜‥‥\n终于‥，见到了‥！"
 },
 {
  "id": "015329",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框06}{立绘8544}「いっしょに‥\n归りましょう、姉さま！",
  "tgt": "{框06}{立绘8544}「一起‥\n回去吧，姐姐大人！"
 },
 {
  "id": "015330",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘0605}「来てくれて、ありがとう\n{队员01}‥、{队员02}‥\n---\nですが‥‥",
  "tgt": "{立绘0605}「谢谢你们能来\n{队员01}‥、{队员02}‥\n---\n但是‥‥"
 },
 {
  "id": "015331",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘0605}「ですが、私は‥\n---\nここから、動くことが\nできません‥",
  "tgt": "{立绘0605}「但是，我‥\n---\n已经无法从这里\n动身了‥"
 },
 {
  "id": "015332",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框06}{立绘8744}「ど、どうしてです\n姉さま‥！？\n---\n今だったら、帝国は\nこんらんしていて‥\n逃げ出すのは、かんたんです！",
  "tgt": "{框06}{立绘8744}「为，为什么呀\n姐姐大人‥！？\n---\n现在帝国\n正一片混乱‥\n逃出去很简单呀！"
 },
 {
  "id": "015333",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框06}{立绘C240}「行こう、エリーナ‥\n---\nだいじょうぶだ\n俺たちが ついてる‥",
  "tgt": "{框06}{立绘C240}「走吧，艾莉娜‥\n---\n没事的\n有我们陪着‥"
 },
 {
  "id": "015334",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘8605}「今‥‥\n世界が 大きく動こうと\nしていますね‥\n---\n{立绘8403}あなた達が、その\n大きな流れの中に いるのが\n分かります‥",
  "tgt": "{立绘8605}「如今‥‥\n世界正要\n大规模变动呢‥\n---\n{立绘8403}我知道，你们\n正身处那股\n巨大的洪流之中‥"
 },
 {
  "id": "015335",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框06}{立绘8341}「エリーナ‥？",
  "tgt": "{框06}{立绘8341}「艾莉娜‥？"
 },
 {
  "id": "015336",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘8605}「旅を 續けてください‥\n行くべきところへ‥！",
  "tgt": "{立绘8605}「请继续你们的旅途吧‥\n去该去的地方‥！"
 },
 {
  "id": "015337",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框06}{立绘8844}「姉さま‥‥",
  "tgt": "{框06}{立绘8844}「姐姐大人‥‥"
 },
 {
  "id": "015338",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘0605}「{队员01}‥\n---\nしばらく、{队员02}と\n二人に してもらえる？",
  "tgt": "{立绘0605}「{队员01}‥\n---\n能让我和{队员02}\n单独待一会儿吗？"
 },
 {
  "id": "015339",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘0403}「ありがとう、{队员01}\nそれと‥‥",
  "tgt": "{立绘0403}「谢谢你，{队员01}\n还有‥‥"
 },
 {
  "id": "015340",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘8605}「{队员00}さん‥\n---\n『{道具5601}』を\n置いて行って\n下さいませんか‥？",
  "tgt": "{立绘8605}「{队员00}……\n---\n能否把\n『{道具5601}』\n留在这里……？"
 },
 {
  "id": "015341",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘8403}「ありがとうございます‥",
  "tgt": "{立绘8403}「谢谢你们‥"
 },
 {
  "id": "015342",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘4200}「すまないが‥\n---\nしばらく、外で\n待っていてくれ‥",
  "tgt": "{立绘4200}「不好意思……\n---\n先在外面\n等一会儿吧……"
 },
 {
  "id": "015343",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框06}{立绘C140}「そういえば‥‥\n---\n{立绘8944}姉さま、どうして\n{队员00}の名前\n知ってたのかしら‥？",
  "tgt": "{框06}{立绘C140}「说起来……\n---\n{立绘8944}姐姐为什么\n知道{队员00}\n的名字呢……？"
 },
 {
  "id": "015344",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框03}{立绘4500}「ディース様が‥\n---\n{立绘0A06}「竜みたいな\n気配がするよ‥\n---\n{立绘0B07}「‥って言ってます。",
  "tgt": "{框03}{立绘4500}「蒂斯大人……\n---\n{立绘0A06}「感觉到了\n龙一样的气息……\n---\n{立绘0B07}「……是这么说的。"
 },
 {
  "id": "015345",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框06}{立绘8341}「エリーナ‥、一体‥‥",
  "tgt": "{框06}{立绘8341}「艾莉娜‥，到底‥‥"
 },
 {
  "id": "015346",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘8605}「{队员02}‥‥\n---\nあなた達が、今‥\n世界を動かす 大きな\n流れの中に あると‥\n---\n言いましたよね‥",
  "tgt": "{立绘8605}「{队员02}‥‥\n---\n你们刚才说‥\n自己正身处推动世界的\n巨大洪流之中‥\n---\n对吧‥"
 },
 {
  "id": "015347",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘8605}「流れの一つは\n{队员00}さん‥\n---\n{立绘0605}そして、{码0B}もう一つの\nうつろわざるもの‥",
  "tgt": "{立绘8605}「潮流之一\n是{队员00}……\n---\n{立绘0605}而另一个{码0B}\n不变不易者……"
 },
 {
  "id": "015348",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘8605}「ふたつは 出会い\nそこで‥‥\n---\nあなた達の、旅の意味が\n問われるでしょう‥",
  "tgt": "{立绘8605}「另一股则是相遇\n在那里‥‥\n---\n你们旅途的\n意义将受到考验‥"
 },
 {
  "id": "015349",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框06}{立绘8341}「エリーナ‥\nどうしたって 言うんだ？\n---\nどうして、そんな事が\n分かるんだ‥？\n---\nそれに‥\nここを 動けないって\n言うのは‥‥",
  "tgt": "{框06}{立绘8341}「艾莉娜‥\n你到底怎么了？\n---\n这种事\n你怎么会知道‥？\n---\n还有‥\n说自己动不了\n是怎么回事‥‥"
 },
 {
  "id": "015350",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘8605}「{队员02}‥\nよく闻いて ください‥\n---\n私は‥{码0B}‥{码0B}‥",
  "tgt": "{立绘8605}「{队员02}‥\n请好好听着‥\n---\n我‥‥‥{码0B}‥{码0B}‥"
 },
 {
  "id": "015351",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框05}{立绘0000}「うつろわざるもの‥\nですよ。",
  "tgt": "{框05}{立绘0000}「是不变不易者……\n哟。"
 },
 {
  "id": "015352",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框05}{立绘0000}「彼女は‥\n私の 作り上げた\nうつろわざるもの‥‥",
  "tgt": "{框05}{立绘0000}「她是……\n我造出来的\n不变不易者…………"
 },
 {
  "id": "015353",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框06}{立绘8341}「作った‥ だと？\n---\n何を言っている？",
  "tgt": "{框06}{立绘8341}「造出来的‥？\n---\n你在说什么？"
 },
 {
  "id": "015354",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框05}{立绘0000}「や、そうです‥‥\n---\nエリーナさんを 呪砲の\nニエに 使おうと\n思いまして‥",
  "tgt": "{框05}{立绘0000}「不，就是这样……\n---\n我正想把艾莉娜\n用作咒炮的\n祭品……"
 },
 {
  "id": "015355",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框06}{立绘8141}「ニエだと‥\nきさまっ！？",
  "tgt": "{框06}{立绘8141}「祭品‥\n你这家伙！？"
 },
 {
  "id": "015356",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框05}{立绘0000}「ええ、ご存知のとおり‥\n---\nニエは‥、目標と関係が\n深い方が、よいですから‥\n---\n東側で 人気の高い\nエリーナ様は‥\n呪砲弾に ぴったりです。",
  "tgt": "{框05}{立绘0000}「嗯，您也知道……\n---\n祭品……跟目标\n关系越深越好……\n---\n在东边人气很高的\n艾莉娜大人……\n正适合当咒炮弹。"
 },
 {
  "id": "015357",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框05}{立绘0000}「ただ‥、もんだいが\nありまして‥‥",
  "tgt": "{框05}{立绘0000}「只是……还有个\n问题…………"
 },
 {
  "id": "015358",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘0000}「ニエに、苦痛をあたえて\n呪いにするんですが‥\n---\n苦痛を あたえすぎると\nニエが 死んでしまいます。\n---\nそこで‥‥",
  "tgt": "{立绘0000}「要对祭品施加痛苦\n化为诅咒……\n---\n可要是施加的痛苦太多\n祭品就会死掉。\n---\n于是…………"
 },
 {
  "id": "015359",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘0000}「私は、彼女に‥\n---\nかんたんには 死ぬことのない\n身体を‥\n作って さしあげたのです！",
  "tgt": "{立绘0000}「我给她……\n---\n打造了一副\n轻易死不掉的\n身体！"
 },
 {
  "id": "015360",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框06}{立绘8C41}「うっ‥{延时30}",
  "tgt": "{框06}{立绘8C41}「呜‥{延时30}"
 },
 {
  "id": "015361",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框02}{立绘C140}「‥{码0B}‥{码0B}‥\n---\nそれで、姉さまは\nルディアの王子様と\nこんやく したんですけど‥\n---\n{立绘8D44}{队员02}兄さまが\n止めてたら‥\n今ごろは‥‥",
  "tgt": "{框02}{立绘C140}「‥‥‥\n---\n后来，姐姐就\n和鲁迪亚王子\n订婚了‥\n---\n{码0B}要是{码0B}兄长\n当时阻止了‥\n现在就‥‥{立绘8D44}{队员02}兄さまが\n止めてたら‥\n今ごろは‥‥"
 },
 {
  "id": "015362",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框02}{立绘C140}「それにしても、長いですね‥\n---\nふたりで、何を\n話してるんでしょう‥？",
  "tgt": "{框02}{立绘C140}「话说回来，好慢呀‥\n---\n两个人\n在聊什么呢‥？"
 },
 {
  "id": "015363",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘8C41}「ううわあああ‥！{延时40}",
  "tgt": "{立绘8C41}「呜哇啊啊‥！{延时40}"
 },
 {
  "id": "015364",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框05}{立绘0000}「や、いかがです？\n---\nたくさんの 魔物を\n魔術的に つなぎあわせた\n力作ですよ‥",
  "tgt": "{框05}{立绘0000}「如何，还满意吗？\n---\n这是把众多魔物\n用魔术缝合起来的\n力作哟……"
 },
 {
  "id": "015365",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框05}{立绘0000}「ただ、ちょっと\n大きく 作りすぎましたね‥\n---\n皆さんが 通ってきた\n大きな內臟‥\n---\nあれ、彼女の\n內臟なんですよ。",
  "tgt": "{框05}{立绘0000}「只是，做得\n稍微有点太大了呢……\n---\n各位一路穿过的\n那些大内脏……\n---\n那些，全是\n她的内脏哟。"
 },
 {
  "id": "015366",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框05}{立绘0000}「どんなに苦痛を 与えても\n死なない、ニエ‥\n---\nうつろわざるもの‥\nなんですよ、つまり。",
  "tgt": "{框05}{立绘0000}「无论施加多少痛苦\n都不会死的祭品……\n---\n换言之\n就是不变不易者……哟。"
 },
 {
  "id": "015367",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框05}{立绘0000}「や、{码0B}や‥\n---\nそうです、私は‥\n神を 作り上げたんです！",
  "tgt": "{框05}{立绘0000}「不，{码0B}……\n---\n没错，我……\n造出了一个神！"
 },
 {
  "id": "015368",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框06}{立绘8141}「キサマ‥\n殺してやる！！",
  "tgt": "{框06}{立绘8141}「你这家伙‥\n我要杀了你！！"
 },
 {
  "id": "015369",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框06}{立绘8040}「や、いけませんね。\n---\n神を 作ることができる\nこの私を、殺すなんて‥！",
  "tgt": "{框06}{立绘8040}「呀，那可不行呢。\n---\n竟然想杀\n能造出神的我‥！"
 },
 {
  "id": "015370",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框06}{立绘8040}「私は、これから‥\n---\nこの技術を 使って\n世界を 変えてゆかねば\nなりませんから、{码0B}ね‥！",
  "tgt": "{框06}{立绘8040}「我从今往后‥\n---\n还要用这项技术\n去改变世界，\n你懂的‥！{码0B}ね‥！"
 },
 {
  "id": "015371",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘8645}「{队员02}‥",
  "tgt": "{立绘8645}「{队员02}‥"
 },
 {
  "id": "015372",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘8645}「{队员02}‥\n---\nもう、{码0B}いいのです。",
  "tgt": "{立绘8645}「{队员02}‥\n---\n已经，可以了。{码0B}いいのです。"
 },
 {
  "id": "015373",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框05}{立绘C240}「エリーナ‥‥、俺は‥\n---\nお前に‥‥\n---\n何も‥‥‥",
  "tgt": "{框05}{立绘C240}「艾莉娜‥‥，我‥\n---\n对你‥‥\n---\n什么都没‥‥‥"
 },
 {
  "id": "015374",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘8645}「そこに‥\n{道具5601}が、あります。",
  "tgt": "{立绘8645}「那里‥\n有{道具5601}。"
 },
 {
  "id": "015375",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘8645}「楽に‥‥\nして下さい、{队员02}‥",
  "tgt": "{立绘8645}「请让我‥‥\n解脱吧，{队员02}‥"
 },
 {
  "id": "015376",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{框05}{立绘0301}「で、{码0B}{码0B}できない‥\n---\nお、{码0B}俺は‥‥\n俺は‥、{码0B}お前のことを‥",
  "tgt": "{框05}{立绘0301}「做，做不到‥\n---\n我，我‥‥\n我‥，对你‥‥{码0B}{码0B}できない‥\n---\nお、{码0B}俺は‥‥\n俺は‥、{码0B}お前のことを‥"
 },
 {
  "id": "015377",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘8443}「知っています。\n---\nだから、あなたに\n賴むのです、{队员02}‥",
  "tgt": "{立绘8443}「我知道。\n---\n所以才拜托\n你呀，{队员02}‥"
 },
 {
  "id": "015378",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘8443}「{队员02}‥\n---\n最後に、あなたに会えて\nよかった‥‥",
  "tgt": "{立绘8443}「{队员02}‥\n---\n最后能见到你\n真是太好了‥‥"
 },
 {
  "id": "015379",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "兄さまは、何も",
  "tgt": "兄长什么"
 },
 {
  "id": "015380",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "話してくれませんでした‥",
  "tgt": "都没有告诉我‥"
 },
 {
  "id": "015381",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "けれども、姉さまが",
  "tgt": "但，姐姐大人"
 },
 {
  "id": "015382",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "もう、戻らないのだと言うことが",
  "tgt": "已经不会再回来了——"
 },
 {
  "id": "015383",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "分かりました‥",
  "tgt": "我明白了‥"
 },
 {
  "id": "015384",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "うつろわざるものを めぐる",
  "tgt": "围绕不变不易者的"
 },
 {
  "id": "015385",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "私たちの旅は‥",
  "tgt": "我们的旅途‥"
 },
 {
  "id": "015386",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "終わりに さしかかっていました‥",
  "tgt": "已渐渐走向终结‥"
 },
 {
  "id": "015387",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘0E08}「思いあがって いたのだ‥",
  "tgt": "{立绘0E08}「是我太过傲慢了‥"
 },
 {
  "id": "015388",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "{立绘0E08}「自分達の手で\n神を 作り上げ‥\n---\n古い神々を\n退けようなどと‥",
  "tgt": "{立绘0E08}「妄想用自己的手\n造出神明‥\n---\n把古老的神明们\n赶下台‥"
 },
 {
  "id": "015389",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "考えるべきでは、なかった。",
  "tgt": "这种想法，本不该有。"
 },
 {
  "id": "015390",
  "file": "WORLD/AREAS033.EMI",
  "seg": 12,
  "src": "今、戻れば つらくなる\nだけだろう‥",
  "tgt": "现在回去\n也只会痛苦吧‥"
 },
 {
  "id": "015391",
  "file": "WORLD/AREAS034.EMI",
  "seg": 11,
  "src": "しぇどのへや",
  "tgt": "谢德的房间"
 },
 {
  "id": "015392",
  "file": "WORLD/AREAS034.EMI",
  "seg": 11,
  "src": "{框03}{立绘0000}「‥風の塔？",
  "tgt": "{框03}{立绘0000}「……风之塔？"
 },
 {
  "id": "015393",
  "file": "WORLD/AREAS034.EMI",
  "seg": 11,
  "src": "{框03}{立绘0000}「そこへ行けば\n確実に、『竜』を‥\n---\n捕らえる事が できると\n言うわけだな。",
  "tgt": "{框03}{立绘0000}「只要去了那里\n就一定能……\n---\n抓到『龙』……\n是这个意思吧。"
 },
 {
  "id": "015394",
  "file": "WORLD/AREAS034.EMI",
  "seg": 11,
  "src": "{框03}{立绘0000}「ふん‥、ごくろう‥\n---\nそれを持って\nどこへなと行け‥！",
  "tgt": "{框03}{立绘0000}「哼……辛苦了……\n---\n拿着它\n爱去哪去哪……！"
 },
 {
  "id": "015395",
  "file": "WORLD/AREAS034.EMI",
  "seg": 11,
  "src": "{框02}「イゴーリさま‥\n行かせて、よろしいので？",
  "tgt": "{框02}「伊戈尔大人‥\n我可以走了吗？"
 },
 {
  "id": "015396",
  "file": "WORLD/AREAS034.EMI",
  "seg": 11,
  "src": "{框03}{立绘0000}「捨ておけ‥\n---\n金のことしか 頭に無い\nつまらん者だ‥\nそれより‥‥",
  "tgt": "{框03}{立绘0000}「扔了吧……\n---\n满脑子只有钱\n的无趣之徒……\n比起这个…………"
 },
 {
  "id": "015397",
  "file": "WORLD/AREAS034.EMI",
  "seg": 11,
  "src": "{框03}{立绘0000}「やはり、あのコゾウが\n竜であった‥\n---\n帝国より先に‥\n我がルディアが、竜を\n手に入れるのだ‥！",
  "tgt": "{框03}{立绘0000}「那小子\n果然是龙……\n---\n要赶在帝国之前……\n让我们卢迪亚\n把龙弄到手……！"
 },
 {
  "id": "015398",
  "file": "WORLD/AREAS034.EMI",
  "seg": 11,
  "src": "「今、砂船は全部\nではらってるから‥\n---\n仕事が無いんだよね\nふはぁーむ。",
  "tgt": "「现在，沙船全都\n派出去了‥\n---\n没有活儿干呢\n哈啊——姆。"
 },
 {
  "id": "015399",
  "file": "WORLD/AREAS034.EMI",
  "seg": 11,
  "src": "「砂船を 探してるの？\n---\nふーん‥、まあ\nあるには あるけど\n安くないよ？",
  "tgt": "「在找沙船？\n---\n嗯‥，嘛\n有倒是有\n可不便宜哟？"
 },
 {
  "id": "015400",
  "file": "WORLD/AREAS034.EMI",
  "seg": 11,
  "src": "「お金が ないなら‥\n---\n商人の 船に\n乘せてもらえるよう\n賴んでみたら？\n---\nちょうど、今\n砂船が 来てるハズだよ。",
  "tgt": "「要是没有钱的话‥\n---\n去求求商人\n让你们\n搭个便船怎么样？\n---\n正好，现在\n应该有沙船来着。"
 },
 {
  "id": "015401",
  "file": "WORLD/AREAS034.EMI",
  "seg": 11,
  "src": "「え、砂船を\n買いたいって‥？",
  "tgt": "「诶，想买\n沙船‥？"
 },
 {
  "id": "015402",
  "file": "WORLD/AREAS034.EMI",
  "seg": 11,
  "src": "「ん！？\nこの、{道具2B05}は‥\n---\nいち‥{码0B}じゅう‥{码0B}ひゃく‥{码0B}{码0B}\nほへーっ！？",
  "tgt": "「嗯！？\n这个，{道具2B05}是‥\n---\n一‥十‥百‥\n嚯诶——！？{码0B}じゅう‥{码0B}ひゃく‥{码0B}{码0B}\nほへーっ！？"
 },
 {
  "id": "015403",
  "file": "WORLD/AREAS034.EMI",
  "seg": 11,
  "src": "「わかった‥\nこれなら、じゅうぶんだ。\n---\nそれじゃ さっそく\n用意するから\n外で待っててよ。",
  "tgt": "「明白了‥\n这些就足够了。\n---\n那这就\n去准备，\n在外面等着哟。"
 },
 {
  "id": "015404",
  "file": "WORLD/AREAS034.EMI",
  "seg": 11,
  "src": "「うーん、だめだね‥\n---\nそんなもんじゃ\nいちばん小さい 砂船も\n買えないね。",
  "tgt": "「唔嗯，不行呢‥\n---\n这点钱的话\n连最小的沙船\n都买不起呢。"
 },
 {
  "id": "015405",
  "file": "WORLD/AREAS034.EMI",
  "seg": 11,
  "src": "「便乘を 賴むんなら\n急いだ方が、いいよ。\n---\n砂船は、いっぺん出ちゃうと\nなかなか 归って来ないから。",
  "tgt": "「要搭便船的话\n最好抓紧哟。\n---\n沙船一旦开走\n可就不轻易回来了。"
 },
 {
  "id": "015406",
  "file": "WORLD/AREAS034.EMI",
  "seg": 11,
  "src": "「やあ、砂船の操作\n闻きに来たの‥？{码14000C82}はい\nいいえ",
  "tgt": "「哟，是来听\n沙船操作的……？{码14000C82}是\n否"
 },
 {
  "id": "015407",
  "file": "WORLD/AREAS034.EMI",
  "seg": 11,
  "src": "{框21}方向キーの{色02}左右{/色}で\n砂船の すすむ方向を\nコントロールします。\n---\n{色0A}○{/色}ボタンはアクセル‥\n押している間 加速し\n放せば ゆっくり減速します。\n---\n{色0A}×{/色}ボタンがブレーキ‥\n押せば、すぐに減速できます。\n---\nまた、コースにある砂山は\n上に乘っかる事で\nジャンプも出来ます。\n---\nもう一度說明を讀みますか？{码14010C82}はい\nいいえ",
  "tgt": "{框21}用方向键的{色02}左右{/色}\n控制沙船的\n前进方向。\n---\n{色0A}○{/色}键是油门……\n按住期间加速\n松开则缓缓减速。\n---\n{色0A}×{/色}键是刹车……\n按下即可立即减速。\n---\n另外，赛道上的沙山\n从上面冲过去\n还能起跳。\n---\n要再读一遍说明吗？{码14010C82}是\n否"
 },
 {
  "id": "015408",
  "file": "WORLD/AREAS034.EMI",
  "seg": 11,
  "src": "「それじゃあ、よい旅を！",
  "tgt": "「那么，祝旅途愉快！"
 },
 {
  "id": "015409",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "かんそん",
  "tgt": "寒村"
 },
 {
  "id": "015410",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{立绘0000}「まだ、動かん方が ええ‥\n---\n体じゅう、ひどい\n傷だらけじゃ‥",
  "tgt": "{立绘0000}「你还是\n别乱动的好……\n---\n你浑身都是\n重伤呢……"
 },
 {
  "id": "015411",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{立绘0000}「そのまま、休んでな‥\n---\n今、食べ物を\n持って行くけ。",
  "tgt": "{立绘0000}「你就\n躺着歇着吧……\n---\n我这就\n给你拿吃的去。"
 },
 {
  "id": "015412",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「あれま！",
  "tgt": "{框04}{立绘8040}「哎呀呀！"
 },
 {
  "id": "015413",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框04}{立绘8040}「ごめんよー‥\nケムかったろ？\n---\n{立绘8141}うちの かまど\n壊れてんだわ‥！",
  "tgt": "{框04}{立绘8040}「对不住呀——‥\n被烟熏了吧？\n---\n{立绘8141}我家的灶台\n坏掉了呢‥！"
 },
 {
  "id": "015414",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「マミさんの家\nかべが、壊れとるのぉ‥\n---\n教えてやらにゃ‥",
  "tgt": "「玛米家的\n墙，坏了呀‥\n---\n得告诉她才行‥"
 },
 {
  "id": "015415",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「みんな、よく働くよね\n感心しちゃうよ。",
  "tgt": "「大家都很勤快呢\n真让人佩服。"
 },
 {
  "id": "015416",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「あっ！\n---\n今、話しかけねェでけれ\nマメの数、かぞえてんだ‥",
  "tgt": "「啊！\n---\n现在别跟我说话\n我在数豆子呢‥"
 },
 {
  "id": "015417",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「おめ、知ってるぞ‥\nマミさんが、くわえこんだ\nヤロウだべ‥？\n---\n‥ところで、くわえこむって\nどーゆー意味だ？",
  "tgt": "「我认得你！‥\n你就是玛米捡回来\n的那个家伙吧‥？\n---\n‥话说，捡回来\n是什么意思？"
 },
 {
  "id": "015418",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{立绘0202}{码0A}{/色}「きゅー",
  "tgt": "{立绘0202}{码0A}{/色}「啾——"
 },
 {
  "id": "015419",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「つりは、ええのぉ‥",
  "tgt": "「钓鱼呀，妙得很‥"
 },
 {
  "id": "015420",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「はぁ‥？\n変なこと、ききなさるねぇ‥\n---\nここは、{色02}ソン村{/色}‥\n帝都の ずっと東にある\nイナカじゃよ‥？",
  "tgt": "「哈……？\n问这么奇怪的问题……\n---\n这里是{色02}宋村{/色}……\n在帝都东边\n很远的乡下哦……？"
 },
 {
  "id": "015421",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{立绘0303}「お、{码0B}おめぇだな‥！\n---\nマミん家で、やっかいに\nなってるって男は！？",
  "tgt": "{立绘0303}「是，是你呀‥！\n---\n就是寄住在\n玛米家的那个男！？{码0B}おめぇだな‥！\n---\nマミん家で、やっかいに\nなってるって男は！？"
 },
 {
  "id": "015422",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框04}{立绘0303}「おめぇ、何者だ？\nこの村に、よそ者は‥‥{引0E00}",
  "tgt": "{框04}{立绘0303}「你，是什么人？\n这村子里，外乡人‥‥{引0E00}"
 },
 {
  "id": "015423",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「ロンの兄ちゃん！",
  "tgt": "{框05}{立绘0000}「隆哥！"
 },
 {
  "id": "015424",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框04}{立绘8303}「マミ‥、おめぇ‥",
  "tgt": "{框04}{立绘8303}「玛米‥，你‥"
 },
 {
  "id": "015425",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框06}{立绘8000}「あんちゃん\n無理しねぇで‥！",
  "tgt": "{框06}{立绘8000}「大哥\n别硬撑……！"
 },
 {
  "id": "015426",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框06}{立绘8000}「おらの、イトコで\nロンの兄ちゃんって\n言うです‥\n---\nハシビトに 行ってたども\nけがして、戻って来てます‥",
  "tgt": "{框06}{立绘8000}「他是我的表哥\n名叫隆哥……\n---\n之前去了桥民镇\n受伤后就\n回来了……"
 },
 {
  "id": "015427",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框06}{立绘8000}「あの‥、ケガが治るまで\nうちで 世話してるです‥\n---\n{立绘8101}あの‥、よろしく\nお願いします‥！",
  "tgt": "{框06}{立绘8000}「那个……在伤好之前\n就住在我家……\n---\n{立绘8101}那个……\n请多关照……！"
 },
 {
  "id": "015428",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框06}{立绘8000}「さ、行こ‥ あんちゃん。",
  "tgt": "{框06}{立绘8000}「走吧……\n大哥。"
 },
 {
  "id": "015429",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「あやー‥\n地主さまに、バレちまった‥",
  "tgt": "{框06}{立绘8040}「哎呀呀‥\n被地主大人发现啦‥"
 },
 {
  "id": "015430",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框05}{立绘4600}「まずいのか‥？",
  "tgt": "{框05}{立绘4600}「不好吃吗……？"
 },
 {
  "id": "015431",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「やー‥、{码0B}イトコって事に\nしておくから‥\n---\n{立绘8141}心配しねぇで、体を\n治すとええよ‥！",
  "tgt": "{框06}{立绘8040}「呀——，就对外说\n是表亲吧‥\n---\n{码0B}别担心，把身体\n养好就行‥！{立绘8141}心配しねぇで、体を\n治すとええよ‥！"
 },
 {
  "id": "015432",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「さっき、思わず\nイトコだって 言ったけど‥\n---\nおめぇさま、本当は‥",
  "tgt": "{框06}{立绘8040}「刚才一不小心\n说是表亲‥\n---\n其实你，真正的‥"
 },
 {
  "id": "015433",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「いや、何でもねぇ‥",
  "tgt": "{框06}{立绘8040}「不，没什么‥"
 },
 {
  "id": "015434",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框03}{立绘4600}「むかし‥\n---\n{队员06}という、神が\nこの世界に 現れた‥",
  "tgt": "{框03}{立绘4600}「很久以前……\n---\n一位名叫\n{队员06}的神\n出现在这个世界……"
 },
 {
  "id": "015435",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框03}{立绘0404}「そのころ、この地では\n多くの国々が\nたがいに 爭いあっていた。",
  "tgt": "{框03}{立绘0404}「那时，这片大地上\n众多国家\n彼此争战不休。"
 },
 {
  "id": "015436",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框03}{立绘4600}「人々は、{队员06}に‥\n---\n爭いのない、平安な\n世界を 願った‥",
  "tgt": "{框03}{立绘4600}「人们对{队员06}……\n---\n许下了没有争斗、\n和平安宁的\n世界的愿望……"
 },
 {
  "id": "015437",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框03}{立绘4600}「{队员06}は、願いを\n闻き入れて‥\n---\n国々を まとめ\n帝国を築き‥\n自ら、初代皇帝となった。",
  "tgt": "{框03}{立绘4600}「{队员06}听允了\n这个愿望……\n---\n统一各国\n建立帝国……\n自己成为了初代皇帝。"
 },
 {
  "id": "015438",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框03}{立绘4600}「しかし、そこまでで‥\n---\n{队员06}は、力つき‥\n長い眠りに ついた。\n---\n神として‥\n完全では なかったのだ。",
  "tgt": "{框03}{立绘4600}「但也仅止于此……\n---\n{队员06}力竭\n陷入了长眠。\n---\n作为神……\n他还是不完全的。"
 },
 {
  "id": "015439",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框03}{立绘0404}「だが、{队员06}は\nさとっていた‥\nたとえ‥‥",
  "tgt": "{框03}{立绘0404}「但，{队员06}\n早已领悟‥\n即便‥‥"
 },
 {
  "id": "015440",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框03}{立绘0404}「たとえ、神として\n完全だったとしても‥\n---\n人々の 望みを\nかなえる事など\nできないと‥！",
  "tgt": "{框03}{立绘0404}「即便身为神明\n完美无缺‥\n---\n也不可能\n实现人们的\n所有愿望‥！"
 },
 {
  "id": "015441",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框03}{立绘0505}「なぜなら、ヒトは‥{引2100}",
  "tgt": "{框03}{立绘0505}「因为，人类‥{引2100}"
 },
 {
  "id": "015442",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框06}{立绘8000}「あのっ‥！",
  "tgt": "{框06}{立绘8000}「那个……！"
 },
 {
  "id": "015443",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框06}{立绘8000}「あの‥、おら‥\n---\nおめぇさまの 言ってること\nよく分からねぇ、{码0B}けど‥",
  "tgt": "{框06}{立绘8000}「那个……我……\n---\n虽然不太明白\n您说的话\n{码0B}但是……"
 },
 {
  "id": "015444",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框06}{立绘8000}「分からねぇけど‥\n---\nそんな、悲しそうな\n顏されたら‥‥",
  "tgt": "{框06}{立绘8000}「虽然不明白……\n---\n可您露出\n那么悲伤的表情…………"
 },
 {
  "id": "015445",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "休んでいきますか？{码14860C93}休んでいく\n旅の記錄だけする\nやめておく",
  "tgt": "要在此休息吗？休息一下\n只做旅途记录\n还是算了{码14860C93}休んでいく\n旅の記錄だけする\nやめておく"
 },
 {
  "id": "015446",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "ベッドで休みますか？{码148A0C82}休む\n休まない",
  "tgt": "要在床上休息吗？休息\n不休息{码148A0C82}休む\n休まない"
 },
 {
  "id": "015447",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「マミさんなら、下のはたけに\n行ったよ‥\n---\nあの子も よく働くね\n感心しちゃうよ。",
  "tgt": "「玛米的话\n去下面的田里了‥\n---\n那孩子也很勤快\n真让人佩服。"
 },
 {
  "id": "015448",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「おめ、知ってるぞ！\nマミさんの オトコ‥\n---\nじゃなくって、イトコだべ？",
  "tgt": "「我认得你！\n玛米的男人‥\n---\n不对，是表亲吧？"
 },
 {
  "id": "015449",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「おめぇさん‥\nつり、した事あるか？{码14010C82}ある\nない",
  "tgt": "「你‥\n钓过鱼吗？钓过\n没钓过{码14010C82}ある\nない"
 },
 {
  "id": "015450",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「ほ、ほ‥\nやっぱり、つり好きそうな\n顏じゃと 思ったわい。",
  "tgt": "「哦，哦‥\n果然我就觉得\n你是副爱钓鱼的面相呀。"
 },
 {
  "id": "015451",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「はー‥\nつり好きそうな\n感じじゃが、のぉ‥",
  "tgt": "「是吗‥\n虽然一副爱钓鱼的\n模样，但是呀‥"
 },
 {
  "id": "015452",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{立绘0404}「竜の気が‥‥\n高まっている？",
  "tgt": "{立绘0404}「龙的气息‥‥\n在增强吗？"
 },
 {
  "id": "015453",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{立绘4600}「動き始めたと\n言う事か‥？",
  "tgt": "{立绘4600}「你是说\n它开始动了吗……？"
 },
 {
  "id": "015454",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「何か、地なりが\nしたよね‥\n---\nびっくり しちゃったよ。",
  "tgt": "「刚才好像有\n地鸣声呢‥\n---\n吓了我一跳。"
 },
 {
  "id": "015455",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「ん‥？\n---\nマミさんなら、いつも通り\n下のはたけじゃ\nないかねぇ‥",
  "tgt": "「嗯‥？\n---\n玛米的话\n还不是老样子\n在下面的田里吗‥"
 },
 {
  "id": "015456",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「おめ、働いてっか？\n---\nケガ治ったら‥\n働かにゃ、いけんのだぞ。",
  "tgt": "「你，在干活吗？\n---\n伤养好了‥\n可得干活哟。"
 },
 {
  "id": "015457",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{立绘0202}{码0A}{/色}「くふん",
  "tgt": "{立绘0202}{码0A}{/色}「咕吩"
 },
 {
  "id": "015458",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「おめぇさん、今度\nヒマがあったら‥\n---\nつり、してみるがええ‥\n落ち着くから。",
  "tgt": "「你呀，下次\n有空的话‥\n---\n去钓钓鱼挺好‥\n能让人静心。"
 },
 {
  "id": "015459",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「何だか、ゆれたねぇ‥\n---\n何か起きる\n前ぶれだと、ヤダねぇ。",
  "tgt": "「好像晃了一下呢‥\n---\n要是有什么大事的\n前兆，可不妙呀。"
 },
 {
  "id": "015460",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「何じゃろなぁ‥\nさっきの、地鳴りは？",
  "tgt": "「刚才那声\n地鸣，究竟是什么呀‥"
 },
 {
  "id": "015461",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{立绘0404}「やはり、これ以上‥\n---\n関わりを 持つべきでは\nないな‥",
  "tgt": "{立绘0404}「果然，不应再有‥\n---\n更深的\n牵连了呢‥"
 },
 {
  "id": "015462",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「ロンのあんちゃん‥",
  "tgt": "{框06}{立绘8040}「龙家小哥‥"
 },
 {
  "id": "015463",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框06}{立绘8040}「地主様の、言ったこと\n気にしねぇでくれ‥\n---\n村の連中は、村が\nひどいことに、ならねぇで\n助かっただよ‥\n---\n{立绘8141}もちろん、おらも\nかんしゃしてる‥",
  "tgt": "{框06}{立绘8040}「地主大人说的话\n你别放在心上‥\n---\n村里人庆幸\n村子没有\n遭了大难‥\n---\n{立绘8141}当然，我也\n心怀感激‥"
 },
 {
  "id": "015464",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框04}{立绘8303}「こ、{码0B}こちらです\n兵隊さま‥‥",
  "tgt": "{框04}{立绘8303}「就，就是这里\n官爷‥‥{码0B}こちらです\n兵隊さま‥‥"
 },
 {
  "id": "015465",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{立绘C640}「突破する‥‥\n---\nいや、{码0B}やりすごせるか？",
  "tgt": "{立绘C640}「强行突破‥‥\n---\n不，能不能蒙混过去？{码0B}やりすごせるか？"
 },
 {
  "id": "015466",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{立绘C640}「何を、しているのだ\n私は‥‥\n---\n{立绘8545}こんな村が、どうなろうと\nやつらを 倒して‥\n---\n突破できるじゃないか‥？",
  "tgt": "{立绘C640}「我，到底在\n做什么‥‥\n---\n{立绘8545}这种村子怎样都好\n打倒那些家伙‥\n---\n不就能突破了吗‥？"
 },
 {
  "id": "015467",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{立绘0606}「この家に、そいつが\nかくまわれて いるのだな？",
  "tgt": "{立绘0606}「那家伙就藏在\n这户人家里吧？"
 },
 {
  "id": "015468",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框02}{立绘8343}「か、かくまうなど‥！\n---\nそんな 悪人だとは\n知りませんで‥！",
  "tgt": "{框02}{立绘8343}「藏，藏匿什么的‥！\n---\n我不知道他是\n那种坏人‥！"
 },
 {
  "id": "015469",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框02}{立绘8343}「む、{码0B}村の者にも‥\n---\n武器に なりそうな物を\n持たせました‥\n---\nきょ、協力しますんで‥\nへへへ‥",
  "tgt": "{框02}{立绘8343}「而且村里人也‥\n---\n配上了像样的\n武器‥\n---\n请多关照呀‥\n嘿嘿嘿‥{码0B}村の者にも‥\n---\n武器に なりそうな物を\n持たせました‥\n---\nきょ、協力しますんで‥\nへへへ‥"
 },
 {
  "id": "015470",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框02}{立绘0303}「マミ‥！？{延时30}",
  "tgt": "{框02}{立绘0303}「玛米‥！？{延时30}"
 },
 {
  "id": "015471",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{立绘8545}「そう、か‥‥\n---\nそうだな‥‥",
  "tgt": "{立绘8545}「这样，啊‥‥\n---\n是啊‥‥"
 },
 {
  "id": "015472",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框02}{立绘8404}「私を かくまった\nお前が‥\n---\n私を 捕まえないと‥\n---\n皆に、しろい目で\n見られてしまうな‥？",
  "tgt": "{框02}{立绘8404}「收留了我的\n你‥\n---\n不把我交出去的话‥\n---\n会被大家\n白眼相待吧‥？"
 },
 {
  "id": "015473",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框04}{立绘8000}「おめぇさまが‥\nふつうの人で、ないって事は\n---\n分かってたです‥",
  "tgt": "{框04}{立绘8000}「您\n不是普通人\n这件事……\n---\n我早就知道……"
 },
 {
  "id": "015474",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框02}{立绘8040}「何かに、追われていても\nここで、ひっそりと\nしていれば‥\n---\nそのうち、ふつうに‥\nいっしょに くらせる‥",
  "tgt": "{框02}{立绘8040}「就算被什么\n追着，只要在这儿\n安安静静地过‥\n---\n总有一天就能\n像平常一样生活‥"
 },
 {
  "id": "015475",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框02}{立绘8141}「そんな‥、{码0B}夢みてぇな事\n考えてました‥！",
  "tgt": "{框02}{立绘8141}「我曾经想着\n那种梦一般的事‥！{码0B}夢みてぇな事\n考えてました‥！"
 },
 {
  "id": "015476",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框02}{立绘8040}「すまねぇ‥\nむり言って ひきとめた\nばっかりに‥！",
  "tgt": "{框02}{立绘8040}「对不住‥\n都怪我硬把你\n留下来‥！"
 },
 {
  "id": "015477",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框02}{立绘8343}「マミ‥！\n何してる、開けねぇか！",
  "tgt": "{框02}{立绘8343}「玛米‥！\n在干什么，快开门呀！"
 },
 {
  "id": "015478",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框02}{立绘0040}「かまどが、壊れてて\nそこから ウラへ出れます‥\n---\n早く‥！",
  "tgt": "{框02}{立绘0040}「灶台破了\n从那里能绕到后头……\n---\n快……！"
 },
 {
  "id": "015479",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框02}{立绘0040}「かまどから、出たら‥\n---\n見つからないように\n森のほこらへ\n行って下さい‥\n---\nほこらのウラに\n抜け穴が あります。",
  "tgt": "{框02}{立绘0040}「从灶台出来后……\n---\n请小心别被发现\n去森林的祠堂……\n---\n祠堂后面\n有一条密道。"
 },
 {
  "id": "015480",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{框02}{立绘0040}「早く‥、行ってくれ！",
  "tgt": "{框02}{立绘0040}「快……快去吧！"
 },
 {
  "id": "015481",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{立绘0101}「へへ‥\n---\nかまど、壊れてるの‥\nこんな時に\n役だっただね‥",
  "tgt": "{立绘0101}「嘿嘿‥\n---\n灶台坏了‥\n这种时候\n反倒派上用场了呢‥"
 },
 {
  "id": "015482",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "かまどのウラの壁が、壊れている。\n無理をすれば、抜けられそうだ‥",
  "tgt": "灶台后面的墙坏了。\n硬闯的话似乎能穿过去‥"
 },
 {
  "id": "015483",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{立绘0707}「この女だけです‥！",
  "tgt": "{立绘0707}「只有这个女人‥！"
 },
 {
  "id": "015484",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{立绘0808}「{队员06}を\nかくまっていた‥\n---\nいっしょに 住んでいたのか？",
  "tgt": "{立绘0808}「你收留了\n{队员06}‥\n---\n还一起住了下来吗？"
 },
 {
  "id": "015485",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{立绘8808}「アスタナに、連れて行け。\n---\n呪砲が、使えるかもしれん‥",
  "tgt": "{立绘8808}「押到阿斯塔纳去。\n---\n咒炮说不定能派上用场‥"
 },
 {
  "id": "015486",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{立绘0303}「お、おらぁ‥\n悪くねぇ‥{码0B}‥{码0B}‥\n---\nマミ‥‥、おめぇが‥‥",
  "tgt": "{立绘0303}「我，我没做\n坏事‥‥‥\n---\n玛米‥‥，你‥‥{码0B}‥{码0B}‥\n---\nマミ‥‥、おめぇが‥‥"
 },
 {
  "id": "015487",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「おめぇさん‥\nつり、した事あるか？{码14010C82}ある\nない",
  "tgt": "「你‥\n钓过鱼吗？钓过\n没钓过{码14010C82}ある\nない"
 },
 {
  "id": "015488",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「ほ、ほ‥\nあんたも、つり好きそうな\n顏じゃと 思ったわい。",
  "tgt": "「哦，哦‥\n果然我就觉得\n你也是副爱钓鱼的面相呀。"
 },
 {
  "id": "015489",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「はー‥\nあんたも、ないんか？\n---\nつり好きそうな\n感じじゃが、のぉ‥",
  "tgt": "「是吗‥\n你也没钓过？\n---\n虽然一副爱钓鱼的\n模样，但是呀‥"
 },
 {
  "id": "015490",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "{立绘0303}「お、{码0B}おめ どうして‥！？\n---\n‥{码0B}‥あ、{码0B}いや。\n---\nよそ者は、あんまり\nこの边に 来ねぇでくれ‥",
  "tgt": "{立绘0303}「你，你怎么在这‥！？\n---\n‥‥啊，没事。\n---\n外乡人尽量\n别来这一带‥{码0B}おめ どうして‥！？\n---\n‥{码0B}‥あ、{码0B}いや。\n---\nよそ者は、あんまり\nこの边に 来ねぇでくれ‥"
 },
 {
  "id": "015491",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「帝都は、化け物に\nおそわれたって 言うし‥\n---\nいったい、なにが\nどうなってるのかねぇ‥",
  "tgt": "「听说帝都被\n怪物袭击了‥\n---\n到底\n出了什么事呀‥"
 },
 {
  "id": "015492",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「おめぇら、知らねだろ‥\n---\nこの村、へーたいが\nいっぱい来たことが、あんだぞ。",
  "tgt": "「你们不知道吧‥\n---\n这村子，以前来过\n好多好多官兵哟。"
 },
 {
  "id": "015493",
  "file": "WORLD/AREAS035.EMI",
  "seg": 11,
  "src": "「あれ、おめぇ‥{码0B}‥{码0B}‥\n---\nいや、ちがうだな‥",
  "tgt": "「咦，你‥‥‥\n---\n不，认错了‥{码0B}‥{码0B}‥\n---\nいや、ちがうだな‥"
 },
 {
  "id": "015494",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "せきしょ",
  "tgt": "关所"
 },
 {
  "id": "015495",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{立绘0000}「お、アンタら‥\n---\nシュークの町に、行こうと\n思ってるのかい？",
  "tgt": "{立绘0000}「哦，你们……\n---\n是打算\n去修克镇吗？"
 },
 {
  "id": "015496",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{立绘0000}「なんでも、今‥\n連合の国どうしが\nモメてるらしくて‥\n---\nシュークのやつら、ここを\n通してくれないんだ。",
  "tgt": "{立绘0000}「听说现在……\n联合的各国之间\n闹了别扭……\n---\n修克那帮人\n不让我们\n从这里过去。"
 },
 {
  "id": "015497",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{立绘C440}「夜を待って\n攻撃を かけよう‥\n---\nあれぐらいの 人数なら\n突破できる。",
  "tgt": "{立绘C440}「等到夜里\n再发起攻击吧‥\n---\n那点人数\n突得过去。"
 },
 {
  "id": "015498",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{立绘0101}「{队员04}さん‥\nそれは、{码0B}ちょっと‥",
  "tgt": "{立绘0101}「{队员04}‥\n那个，有点‥{码0B}ちょっと‥"
 },
 {
  "id": "015499",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{立绘8242}「なぜだ‥？\n---\n夜になってから、攻めたほうが\n有利だぞ‥",
  "tgt": "{立绘8242}「为什么‥？\n---\n等到夜里再攻\n才占优势呀‥"
 },
 {
  "id": "015500",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{立绘0303}「ぶっそうな話は\nやめてもらおうか‥\n---\n{立绘4200}{队员00}、その\n危なっかしい女を\nおさえていろ‥",
  "tgt": "{立绘0303}「危险的话题\n就免了吧……\n---\n{立绘4200}{队员00}，看住那个\n冒冒失失的女人……"
 },
 {
  "id": "015501",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{立绘C200}「少しばかり、モメていても\n同じ連合の 人間なんだ‥\n---\n話せば、分かってもらえる。",
  "tgt": "{立绘C200}「就算闹了点别扭\n大家也是联合的人……\n---\n好好谈谈\n他们会明白的。"
 },
 {
  "id": "015502",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{框02}{立绘0404}「ん‥、{码0B}おい！\n---\nお前、フーレン族の\n{队员02}じゃ、ないか？",
  "tgt": "{框02}{立绘0404}「嗯‥，喂！\n---\n你，是弗雷恩族的\n{码0B}吧？{队员02}じゃ、ないか？"
 },
 {
  "id": "015503",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{框02}{立绘0545}「お前、ルディアで\nおたずね者に\nなってるじゃないか！\n---\nそんな、やっかい者を\n通したら‥\n後々めんどうだ。",
  "tgt": "{框02}{立绘0545}「你，在鲁迪亚\n可是被通缉的\n要犯呀！\n---\n放这种\n麻烦家伙过去‥\n以后有得麻烦。"
 },
 {
  "id": "015504",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{框02}{立绘0404}「そうだ‥！\nたたき返してやる！！",
  "tgt": "{框02}{立绘0404}「没错‥！\n把他轰回去！！"
 },
 {
  "id": "015505",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{立绘8643}「う、うわ‥！",
  "tgt": "{立绘8643}「呜，哇‥！"
 },
 {
  "id": "015506",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{立绘4200}「す‥、すまん‥‥",
  "tgt": "{立绘4200}「对……对不起……"
 },
 {
  "id": "015507",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{立绘8141}「いえ‥、兄さま‥\n---\nあの‥、それより‥‥",
  "tgt": "{立绘8141}「不‥，兄长大人‥\n---\n那个‥，比起这个‥‥"
 },
 {
  "id": "015508",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{框03}{立绘0701}「この、荷車を\nうまく 使えないでしょうか？",
  "tgt": "{框03}{立绘0701}「能不能巧妙利用\n那辆手推车呢？"
 },
 {
  "id": "015509",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{框06}{立绘C200}「あ、{码0B}ああ‥\n---\nふむ‥、ためしてみよう。",
  "tgt": "{框06}{立绘C200}「啊，{码0B}啊……\n---\n嗯……那就试试吧。"
 },
 {
  "id": "015510",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{立绘0000}「アンタら‥、むちゃするね。\n---\nケンカっぱやいのは\nよくないよ‥？",
  "tgt": "{立绘0000}「你们……\n真是乱来。\n---\n动不动就动手\n可不好哦……？"
 },
 {
  "id": "015511",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{立绘0404}「よよ‥、よくも\nやってくれたな‥‥",
  "tgt": "{立绘0404}「好啊‥，干得\n真漂亮呀‥‥"
 },
 {
  "id": "015512",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{立绘0505}「くそ‥、もう絶対\n通してやらないからな！",
  "tgt": "{立绘0505}「可恶‥，绝对\n不会再放你们过去了！"
 },
 {
  "id": "015513",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "荷車がある、押せば\n動きそうだ‥",
  "tgt": "有辆手推车，推的话\n似乎能动‥"
 },
 {
  "id": "015514",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "こちらからでは\n押せない！",
  "tgt": "从这边\n推不动！"
 },
 {
  "id": "015515",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "「君は、賢樹って知ってる？{码14000C92}うん、知ってる\nいいや、知らない",
  "tgt": "「你知道贤树吗？{码14000C92}嗯，知道\n不，不知道"
 },
 {
  "id": "015516",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "「オレも、一目見ようと\n来たんだけど‥\n---\n関所が 通れないなんて\nツイてないなあ‥",
  "tgt": "「我也是来\n见识一眼的‥\n---\n偏偏关所过不去\n真不走运呀‥"
 },
 {
  "id": "015517",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "「シュークに 向かう\nとちゅうの森に‥\n---\nなんと、人のコトバを\n話す木が あるんだって\n---\n人間なんかより、ずっと\n長生きしてる間に\nチエを つけたらしいよ。",
  "tgt": "「在去休克\n路上的森林里‥\n---\n据说有棵会说\n人话的树\n---\n比人类活得久得多\n便在漫长岁月里\n开悟了智慧。"
 },
 {
  "id": "015518",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "「何を 急いでるか\n知らんが‥\n---\nすこし 休んで\n落ち着きな。{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく",
  "tgt": "「不知你在急什么‥\n——不过呀‥\n---\n但不如歇一歇\n定定心。住一晚\n只做旅途记录\n还是算了{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく"
 },
 {
  "id": "015519",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{立绘0805}「み、見張りのオレを\n倒しても 関所は\n通れないぞ‥\n---\nわ、わかったら\nあっち行け！",
  "tgt": "{立绘0805}「就，就算打倒\n放哨的我\n关所也过不去‥\n---\n明，明白了的话\n给我到那边去！"
 },
 {
  "id": "015520",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{立绘0906}「時は金なり\n店は世界なり‥\n---\nマニーロ屋グループの\nモットーでっせ！{码14850C93}トレードしよう\nけいひんをこうかんしよう\nやめておこう",
  "tgt": "{立绘0906}「时间就是金钱\n店铺就是世界‥\n---\n这可是马尼罗屋集团的\n座右铭哟！来交易吧\n交换纪念品\n还是算了吧{码14850C93}トレードしよう\nけいひんをこうかんしよう\nやめておこう"
 },
 {
  "id": "015521",
  "file": "WORLD/AREAS037.EMI",
  "seg": 8,
  "src": "{立绘0A07}「せっかく 君たちの\n砂船に 乘せてもらったのに‥\n---\nこの関所が 通れないんじゃ\nしょうがないよ‥",
  "tgt": "{立绘0A07}「好不容易搭上\n你们的沙船‥\n---\n这关所过不去\n也是没办法呀‥"
 },
 {
  "id": "015522",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "るでぃあまち",
  "tgt": "鲁迪亚镇"
 },
 {
  "id": "015523",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "{立绘0000}「この先は、ルディア城だよ。",
  "tgt": "{立绘0000}「前面就是卢迪亚城。"
 },
 {
  "id": "015524",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "{立绘0101}「この部屋には‥\nある事件の 参考人が\n入れられてるんだ‥\n---\n‥って、アンタらの事だよ！",
  "tgt": "{立绘0101}「这个房间里‥\n关着某起事件的\n涉案证人‥\n---\n‥说的就是你们啦！"
 },
 {
  "id": "015525",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "「ルディアも‥\n---\n戦爭のころは いろんな\n機协を作ったりして\nさかえてたんだけど、なぁ‥",
  "tgt": "「鲁迪亚也曾‥\n---\n战争年代造过各种\n机械装备\n风光过一阵呢‥"
 },
 {
  "id": "015526",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "「ダムで集めた 金属を‥\n---\nここで とかして\n機协の部品に するんだ‥",
  "tgt": "「在水坝收集的金属‥\n---\n就在这里熔炼\n做成机械零件‥"
 },
 {
  "id": "015527",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "「南から 旅して来たけど‥\n---\nとちゅうの森で 何者かに\n目をつつかれたんだ‥\n---\nあの森には 何か\nとりついてるよ。",
  "tgt": "「我从南边旅行过来‥\n---\n半路上的森林被什么\n戳了眼睛‥\n---\n那片森林里\n肯定附了什么东西。"
 },
 {
  "id": "015528",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "「あの森は ぜったい\nおかしいぜ‥\n---\n何も いないのに\n話し声がしたり‥\n---\nみみを ひっぱられたり\nかみつかれたり、するんだ！",
  "tgt": "「那片森林绝对\n有古怪‥\n---\n明明什么都没有\n却有说话声‥\n---\n耳朵会被拽\n还会被咬呢！"
 },
 {
  "id": "015529",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "「あたしも 旅のとちゅう\nあの森で‥\n---\n‥‥を、つままれちゃった！",
  "tgt": "「我旅行途中\n也在那片森林里‥\n---\n‥‥被、被掐了！"
 },
 {
  "id": "015530",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "「まったく‥\n戦爭が終わってから\nヒマになったよ。",
  "tgt": "「真是的‥\n战争结束后就\n闲得发慌了。"
 },
 {
  "id": "015531",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "「仕事が無いってのに\n食ってばっかり‥！",
  "tgt": "「明明没工作\n就知道吃‥！"
 },
 {
  "id": "015532",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "「戦爭が終わって\n仕事は 減るし‥\n---\n休戦条約の もんだいも\nあるしで‥\n---\nルディア王家も 大変だね。",
  "tgt": "「战争结束后\n活儿少了‥\n---\n停战条约又有\n一堆问题‥\n---\n鲁迪亚王室也不好过呀。"
 },
 {
  "id": "015533",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "{立绘0202}「ねー、闻いた？\nなんでも フーレン族の\n族長が‥\n---\n{立绘FFFF}{立绘8343}「王女様を 助けようと\n帝国に しのびこんだのよね！",
  "tgt": "{立绘0202}「喂，听说了吗？\n据说弗雷恩族的\n族长‥\n---\n{立绘FFFF}{立绘8343}「为了救王女大人\n潜进了帝国呢！"
 },
 {
  "id": "015534",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "{立绘0303}「それで、その王女様‥\nルディアの王子の‥\n---\n{立绘FFFF}{立绘8242}「いいなずけ、なんでしょ！？\n---\n王家って スキャンダラスね！",
  "tgt": "{立绘0303}「然后，那位王女‥\n是鲁迪亚王子的‥\n---\n{立绘FFFF}{立绘8242}「未婚妻，对吧！？\n---\n王室真是绯闻不断呢！"
 },
 {
  "id": "015535",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "「かーちゃんたち\nウワサ話 ばっかり！",
  "tgt": "「妈妈们\n就知道嚼舌根！"
 },
 {
  "id": "015536",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "{立绘0404}「あかんな、工業の町は‥\nまともな宿も あらへん！\n---\n{金钱00}ま、それは さておき\n何か買うておくれ！{码14840C94}買い物をしよう\n何か売ろう\n武器を下取りしてもらおう\n今はやめておく",
  "tgt": "{立绘0404}「不行啊，工业镇就是…\n连个像样的旅店都没有！\n---\n{金钱00}嘛，闲话少说\n买点啥吧！{码14840C94}买点东西\n卖点东西\n折卖武器\n现在先算了"
 },
 {
  "id": "015537",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "{立绘8040}「しかし‥、王子も\nつめたい お人だねぇ‥\n---\n{立绘FFFF}{立绘0101}「いや、でも‥\n---\nそのぐらいじゃないと\n国を 治めるなんて\nできないのかも‥",
  "tgt": "{立绘8040}「不过‥王子也是\n够冷酷的人呀‥\n---\n{立绘FFFF}{立绘0101}「不，可是‥\n---\n没有那份冷酷\n也许就没法\n治理国家吧‥"
 },
 {
  "id": "015538",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "{立绘0101}「つみに 問われるのが\n分かっていて‥\n---\nフーレンの族長は\n帝国まで、行ったのかな‥\n---\n{立绘FFFF}{立绘8040}「エリーナ様のことが‥\n---\nそれほど、好きだって\n事なのかねぇ‥",
  "tgt": "{立绘0101}「明知会被\n问罪也甘愿‥\n---\n弗雷恩的族长\n还是去了帝国‥\n---\n{立绘FFFF}{立绘8040}「对艾莉娜大人的心意‥\n---\n就深到了\n这个地步吗‥"
 },
 {
  "id": "015539",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "{立绘0404}「こんな夜ふけに\n出步いちゃ 危ないで‥\n---\n{金钱00}ま、それは さておき\n何か買うておくれ！{码14840C94}買い物をしよう\n何か売ろう\n武器を下取りしてもらおう\n今はやめておく",
  "tgt": "{立绘0404}「大半夜的\n还在外面晃悠，危险…\n---\n{金钱00}嘛，闲话少说\n买点啥吧！{码14840C94}买点东西\n卖点东西\n折卖武器\n现在先算了"
 },
 {
  "id": "015540",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "「こんな夜は‥\n---\nどこかで 眠っている\n{色03}お宝{/色}に、おもいを\nはせたくなりますね‥",
  "tgt": "「这样的夜晚‥\n---\n总会让人想起\n沉睡在某处的\n宝藏呢‥{色03}お宝{/色}に、おもいを\nはせたくなりますね‥"
 },
 {
  "id": "015541",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "\n  早く{队员02}を助けに行こう‥",
  "tgt": "\n快去救{队员02}吧‥"
 },
 {
  "id": "015542",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "「カミさんに\n見つかると‥\n---\n仕事しろって\nうるさいんだよ。",
  "tgt": "「被我家那位\n发现的话‥\n---\n就会唠叨个不停\n叫我干活。"
 },
 {
  "id": "015543",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "「仕事もしないで\nどこ 行ったんだろうね\nうちのヤドロク‥",
  "tgt": "「不干活就跑\n不知去哪了呀\n我家那口子‥"
 },
 {
  "id": "015544",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "「最近、ルディアの兵が\nよく 出かけて行くが‥\n---\nまた戦爭を 始める気じゃ\nないよな？",
  "tgt": "「最近鲁迪亚的士兵\n老往外跑‥\n---\n该不会又想\n开战吧？"
 },
 {
  "id": "015545",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "「おいおい\n闻いてくれよ‥！{码14000C82}闻く\n闻かない",
  "tgt": "「喂喂\n听我说说嘛…！{码14000C82}听\n不听"
 },
 {
  "id": "015546",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "「ダムが、泥の底に\nうまっちまったとかで\n---\n機协の部品を作る\n金属が 集まらねえ‥\n困ったもんだよ。",
  "tgt": "「听说水坝埋进了\n泥底里‥\n---\n造机械零件的\n金属收不上来‥\n愁死人了。"
 },
 {
  "id": "015547",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "「まあ、アンタらに\n話しても しょうが\nないもんな‥",
  "tgt": "「嘛，跟你们\n说了\n也是白说‥"
 },
 {
  "id": "015548",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "「フーレンの人に\n南の森で、化かされるって\n闻いて 来たんだけど\n---\n何にも 起こらなかったよ‥",
  "tgt": "「我听说弗雷恩人\n在南边的森林\n会闹鬼才来的‥\n---\n结果啥事都没有‥"
 },
 {
  "id": "015549",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "「商品の 買いつけに\n来たんだが‥\n---\nずいぶん、さびしい\n町ですなぁ。",
  "tgt": "「我是来采购\n商品的‥\n---\n这镇子可真够\n冷清的呀。"
 },
 {
  "id": "015550",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "{立绘0505}{码0A}",
  "tgt": "{立绘0505}{码0A}"
 },
 {
  "id": "015551",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "「ほう、なかなかすてきな\n{色03}{占位00}{/色}を\nお持ちだ‥\n---\nどうです、わたしの\n{色03}お宝{/色}と\n取り替えませんか？{码14010C92}取り替えよう！\nやめておこう‥",
  "tgt": "「哦，你这{色03}{占位00}{/色}\n还挺不错…\n---\n怎么样，跟我的\n{色03}宝贝{/色}\n换换吗？{码14010C92}交换吧！\n算了…"
 },
 {
  "id": "015552",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "\n {色03}{占位01}{/色}と 取り替えた！\n---\n",
  "tgt": "\n换成了{色03}{占位01}{/色}！\n---\n"
 },
 {
  "id": "015553",
  "file": "WORLD/AREAS038.EMI",
  "seg": 8,
  "src": "「ありがとう、今夜は\n良い夢が 見れそうです。",
  "tgt": "「谢谢你，今晚\n应该能做个好梦。"
 },
 {
  "id": "015554",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "どんきちしつない",
  "tgt": "团吉室内"
 },
 {
  "id": "015555",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0000}「あら、{码0B}お客さんとは\nめずらしい‥\n---\nぼく、ここのリーダーの\nタブって者です。\n---\n‥今、ごはんだから\nご用があるんなら\nちょっと待ってね。{码14000C12}じゃあ、町でも ぶらつこう\nここで しばらく待とう",
  "tgt": "{立绘0000}「哎呀，{码0B}客人\n真是稀客……\n---\n我是这里的\n领头人，叫塔布。\n---\n……现在正吃饭\n有事的话\n请稍等一下。{码14000C12}那去镇上逛逛\n就在这里等等"
 },
 {
  "id": "015556",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0000}「そうね、何もない所だけど\nひと回りして来てよ。",
  "tgt": "{立绘0000}「也好，这里没什么好玩的\n去转一圈再回来吧。"
 },
 {
  "id": "015557",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0000}「ん、{码0B}ここで待つ？\n町でも おさんぽして\nまた来てくれても、いいよ？{码14010C12}やっぱり町を回ってこよう\nいや、ここで待ちます",
  "tgt": "{立绘0000}「嗯，{码0B}要在这里等？\n也可以去镇上\n散散步再回来哟？{码14010C12}还是去镇上逛逛\n不，就在这里等"
 },
 {
  "id": "015558",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0000}「あ、そう‥\nじゃ、ささっと食べるよ。",
  "tgt": "{立绘0000}「啊，好……\n那我快点吃完。"
 },
 {
  "id": "015559",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0101}「呪いを防ぐ、ヨロイは\nやたら重いから‥\n---\n動き回ると、ハラ減るよ。",
  "tgt": "{立绘0101}「防诅咒的铠甲\n重得要命‥\n---\n一活动就饿了呢。"
 },
 {
  "id": "015560",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0202}「ちょっと、呪いに\nやられたかなぁ‥\n---\n身体の調子、わるいや。",
  "tgt": "{立绘0202}「好像被诅咒\n伤到一点‥\n---\n身体状态，很差呀。"
 },
 {
  "id": "015561",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0303}「あっちの、ナベの前に\n立ってるのが‥\n---\n俺達の、親方だよ\nもぐまぐ。",
  "tgt": "{立绘0303}「站在那边\n锅前面的就是‥\n---\n我们的工头哟\n咕叽咕叽。"
 },
 {
  "id": "015562",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0404}「呪い、ってのは\n悪口みたいな物かな‥\n---\n悪口、言われると\n気分いいもんじゃ、ねぇだろ？\n---\nそれを、ずっと強力にしたのが\n呪いってワケさ‥",
  "tgt": "{立绘0404}「诅咒，就像\n恶语相向差不多吧‥\n---\n被人恶语中伤\n心情肯定好不了吧？\n---\n把那个强力放大\n就是所谓的诅咒‥"
 },
 {
  "id": "015563",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0505}「戦爭で使われた呪いは\nまっ黒な、キリみたいで‥\n---\nその中に、悪靈どもが\nウジャウジャいるんだ‥\n---\nヨロイ無しで、くらったら\nアっと言う間に、死んじまう！",
  "tgt": "{立绘0505}「战争中使用的诅咒\n像漆黑的浓雾‥\n---\n里面挤满了\n恶灵‥\n---\n不穿铠甲吸上一口\n眨眼间就死！"
 },
 {
  "id": "015564",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0606}「女子供の、来るような\n場所じゃないぜ‥\n---\n呪われちまうぞ！？",
  "tgt": "{立绘0606}「可不是女人小孩\n来的地方‥\n---\n会被诅咒的！？"
 },
 {
  "id": "015565",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{框03}{立绘0000}「お待たせ‥\nで、どんなご用です？",
  "tgt": "{框03}{立绘0000}「久等了……\n那么，什么事？"
 },
 {
  "id": "015566",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{框04}{立绘C140}「あの‥、わたしたち\nチャンバの町を\n通り抜けたいんですけど‥\n---\n呪いが消えるまで\n無理なんですか？",
  "tgt": "{框04}{立绘C140}「那个‥，我们\n想穿过\n占巴镇‥\n---\n诅咒不散\n就没办法吗？"
 },
 {
  "id": "015567",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{框03}{立绘0000}「無理ね。\n---\n呪いのキリの中には\n邪悪なものが、たくさんいて‥\n---\n特別なヨロイを 着てないと\n立ち入れないの‥",
  "tgt": "{框03}{立绘0000}「不行。\n---\n诅咒之雾里\n住着许多邪恶的东西……\n---\n不穿上特别的铠甲\n就进不去……"
 },
 {
  "id": "015568",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{框03}{立绘0000}「呪いを 消しおわって\n町が、元どおりになるには‥\n---\nまだ、一年ぐらい\nかかるかな‥",
  "tgt": "{框03}{立绘0000}「要消完诅咒\n让镇子恢复原样……\n---\n还得再花\n一年左右吧……"
 },
 {
  "id": "015569",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{框03}{立绘0000}「でも まあ、{码0B}今すぐ\n通りたいって言うなら‥",
  "tgt": "{框03}{立绘0000}「不过嘛，{码0B}要是想\n马上过去的话……"
 },
 {
  "id": "015570",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{框03}{立绘0000}「仲間の誰かを\nガイドにして、案內させれば‥\n---\n何とか、行けなくもないかな。",
  "tgt": "{框03}{立绘0000}「让同伴中的谁\n当向导带路的话……\n---\n想办法\n也不是过不去。"
 },
 {
  "id": "015571",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{框04}{立绘C140}「つまり、誰かに\nガイドが お願いできれば\nいいんですね‥？{码0B}{码0B}{码0B}{引1200}",
  "tgt": "{框04}{立绘C140}「也就是说\n只要能请到向导\n就可以了‥？{码0B}{码0B}{码0B}{引1200}"
 },
 {
  "id": "015572",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{框05}{立绘0000}「ま、そう言う事。",
  "tgt": "{框05}{立绘0000}「嘛，就是这么回事。"
 },
 {
  "id": "015573",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0000}「ちなみに、ぼくは\nお役に立てないよ‥\n---\n呪いの中に、連れて行くのは\n危険すぎるからね。",
  "tgt": "{立绘0000}「顺便说一句\n我可帮不上忙哦……\n---\n带进诅咒里\n实在太危险了。"
 },
 {
  "id": "015574",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0404}「呪いの中に入る‥？\nヨロイなしで！？\n---\nだめだめ、そんなの\n死んじまうよ！",
  "tgt": "{立绘0404}「不穿铠甲\n进诅咒区‥？\n---\n不行不行，那样\n会死的哟！"
 },
 {
  "id": "015575",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0505}「たしかに‥、呪いが消えて\n通れる部分もあるけど‥\n---\nでも、やっぱり\nやばいよ‥",
  "tgt": "{立绘0505}「确实‥，诅咒散去\n能走通的地方也有‥\n---\n但还是\n很危险哟‥"
 },
 {
  "id": "015576",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0606}「呪いの中を\n案內してほしいって？\n---\n呪いの怖さを 知らないから\nそんなこと言えるんだ‥",
  "tgt": "{立绘0606}「说要人带路\n穿诅咒区？\n---\n因为不知道诅咒\n多可怕才敢这么说‥"
 },
 {
  "id": "015577",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0707}「ここの人たちは\nみんな、お仕事に\n行ってもうた‥\n---\n{金钱00}わしは、おるすばん\nやねんけど‥\n何か買うてくれるか？{码14840C94}買い物しよう\n何か売ろう\n下取りしてもらおう\nやめておこう",
  "tgt": "{立绘0707}「这里的人都\n出去干活了……\n---\n{金钱00}我是在\n看家呢……\n要不要买点什么？{码14840C94}买点什么\n卖点什么\n折价回收\n这次算了吧"
 },
 {
  "id": "015578",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0707}{金钱00}「やあ、何か買うて‥\n防呪ヨロイは 無いけどな。{码14840C94}買い物しよう\n何か売ろう\n下取りしてもらおう\nやめておこう",
  "tgt": "{立绘0707}{金钱00}「来，买点什么吧……\n不过防咒铠甲\n是没有的。{码14840C94}买点什么\n卖点什么\n折价回收\n这次算了吧"
 },
 {
  "id": "015579",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0404}「え、行くんだ‥！？\n知らないよ‥、どうなっても。",
  "tgt": "{立绘0404}「诶，要去‥！？\n出了事我可不管哟。"
 },
 {
  "id": "015580",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0404}「{队员05}‥、お前\nひきうけた からには\nちゃんとやれよ！？",
  "tgt": "{立绘0404}「{队员05}‥，你\n既然接了\n就要好好干呀！？"
 },
 {
  "id": "015581",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0505}「呪いのキリに、さわったら‥\n---\n毒にやられたり\n頭が変になったり\n大ダメージを受けたり‥\n---\nとにかく、ロクな事ないから\nさわらないようにね！",
  "tgt": "{立绘0505}「碰到诅咒的雾‥\n---\n会中毒\n脑子会变怪\n受大伤害‥\n---\n总之没半点好处\n千万别碰！"
 },
 {
  "id": "015582",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0505}「{队员05}、{码0B}お前は\n呪いが防げるんだから‥\n---\nこの人たちを、ちゃんと\n守ってやれよ。",
  "tgt": "{立绘0505}「{队员05}，你能\n防住诅咒‥\n---\n就好好\n保护这些人哟。{码0B}お前は\n呪いが防げるんだから‥\n---\nこの人たちを、ちゃんと\n守ってやれよ。"
 },
 {
  "id": "015583",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0606}「{队员05}の案內で\n呪いの中に入るって！？\n---\n恐いことするなぁ‥",
  "tgt": "{立绘0606}「由{队员05}带路\n进诅咒区！？\n---\n干吓人的事呀‥"
 },
 {
  "id": "015584",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0606}「おまえって、変な奴だと\n思ってたけど‥\n---\nほんとに、変な事\nひきうけたなぁ‥",
  "tgt": "{立绘0606}「我一直觉得\n你是个怪家伙‥\n---\n没想到真接了\n这么怪的活呀‥"
 },
 {
  "id": "015585",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0808}「町の中心部は\n入り組んでるから‥\n---\n迷わないようにな。",
  "tgt": "{立绘0808}「镇子中心地带\n道路纵横交错‥\n---\n可别迷路了。"
 },
 {
  "id": "015586",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0808}「おい、{队员05}‥\n目の前で、死なれないよう\n気をつけなよ。",
  "tgt": "{立绘0808}「喂，{队员05}‥\n可别让人\n死在眼前呀。"
 },
 {
  "id": "015587",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "「ん、休みたいなら\nベッド‥かしてあげるけど？{码14860C93}休む\n旅の記錄だけする\n今はやめておく",
  "tgt": "「嗯，想休息的话\n床‥可以借你哟？休息\n只做旅途记录\n现在算了{码14860C93}休む\n旅の記錄だけする\n今はやめておく"
 },
 {
  "id": "015588",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0101}「みんな、仕事に\n出かけちまったよ‥\n---\nおれは、{码0B}まあ なんだ\n体調不良ってやつだ‥",
  "tgt": "{立绘0101}「大家\n都出门干活去了‥\n---\n我嘛，算是\n身体不适吧‥{码0B}まあ なんだ\n体調不良ってやつだ‥"
 },
 {
  "id": "015589",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0808}「最近、仕事する気が\nうすれちゃってね‥\n---\nこれも 呪いのせいだよ\nああ、きっとそうさ。",
  "tgt": "{立绘0808}「最近干活的\n劲头都没了‥\n---\n这也是诅咒的错\n唉，肯定是。"
 },
 {
  "id": "015590",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0404}「ここの呪いは\nそうとう手強いな‥\n---\nセネスタでの作業は\nさっさと\nカタがついたんだが‥",
  "tgt": "{立绘0404}「这里的诅咒\n相当难缠呀‥\n---\n在塞内斯塔的活\n早就\n收尾了‥"
 },
 {
  "id": "015591",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0101}「わかったよ、{队员05}\nこれ食ったら\nすぐ仕事に行くって‥",
  "tgt": "{立绘0101}「知道了，{队员05}\n吃完这个\n就马上去干活‥"
 },
 {
  "id": "015592",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0404}「そういや、{队员05}は\nセネスタで 仕事してた時は\nまだいなかったよな？",
  "tgt": "{立绘0404}「说起来，在塞内斯塔\n干活的时候\n{队员05}还没来着？"
 },
 {
  "id": "015593",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0808}「遲かったな {队员05}\n---\n‥町の中心部で\n迷ってたんじゃないのか？",
  "tgt": "{立绘0808}「够慢的呀{队员05}\n---\n‥该不会在\n镇子中心迷路了吧？"
 },
 {
  "id": "015594",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0303}「もうすぐ ここも‥\n---\nセネスタみたいに\n人が戻ってくるよ\nもぐまぐ。",
  "tgt": "{立绘0303}「这里很快也会‥\n---\n像塞内斯塔一样\n人回来的\n咕叽咕叽。"
 },
 {
  "id": "015595",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0909}「ここでの 仕事が\n終わったら\n---\n俺達‥これから\nどうしたら いいんだ？\n---\n{立绘FFFF}{立绘8A4A}「また 戦爭が\n始まっちまえば‥\n---\nいやでも お声が\nかかるって。",
  "tgt": "{立绘0909}「这里的活\n干完之后‥\n---\n我们‥接下来\n该怎么办呀？\n---\n{立绘FFFF}{立绘8A4A}「等战争\n再打起来‥\n---\n自然有人来\n叫我们。"
 },
 {
  "id": "015596",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0000}「あら、ひさしぶり‥\n---\nもうすぐ ここの呪いも\n消えてなくなるよ\n---\n私達も、めでたく\n戦爭の シリぬぐいから\n解放‥ってわけね。",
  "tgt": "{立绘0000}「哎呀，好久不见……\n---\n这里的诅咒\n马上就要消散了\n---\n我们也终于\n能从战争的\n烂摊子里解脱了呢。"
 },
 {
  "id": "015597",
  "file": "WORLD/AREAS039.EMI",
  "seg": 8,
  "src": "{立绘0A0A}「町のおくに、魚みたいな\nバケモンが 出るって話‥\n闻いたか？\n---\n{立绘FFFF}{立绘8949}「ああ、この呪いだ‥\n---\nおかしなモンが\n生まれても\nおかしく ないからな。",
  "tgt": "{立绘0A0A}「听说镇子深处\n出现了像鱼一样的\n怪物‥\n---\n{立绘FFFF}{立绘8949}「嗯，拜这诅咒所赐‥\n---\n就算生出了\n什么怪东西\n也不稀奇呀。"
 },
 {
  "id": "015598",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}すみやきごや！",
  "tgt": "{立绘0000}炭烧小屋！"
 },
 {
  "id": "015599",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{框03}{立绘0000}「‥気がついたか。",
  "tgt": "{框03}{立绘0000}「…醒了啊。"
 },
 {
  "id": "015600",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{框03}{立绘0000}「体の方は\nもう、いいのか‥？\n---\n何しろ、ずいぶん\n長い間‥‥",
  "tgt": "{框03}{立绘0000}「身体\n没什么大碍了吧…？\n---\n毕竟睡了\n好长一段时间……"
 },
 {
  "id": "015601",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{框03}{立绘0000}「ああ、そうか‥\n---\nここは、ジンガの山の中で‥\nわしは、ババデルって者だ。",
  "tgt": "{框03}{立绘0000}「哦，对了…\n---\n这里是津加山中…\n老夫叫巴巴德尔。"
 },
 {
  "id": "015602",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{框03}{立绘0000}「何日か前に、下の川で\n倒れてた お前さんを\n見つけて‥\n---\n小屋へ 運んだんだ‥",
  "tgt": "{框03}{立绘0000}「几天前发现你\n倒在下边的川里…\n---\n就把你\n搬进了小屋…"
 },
 {
  "id": "015603",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{框04}{立绘0101}「そうか‥、世話をかけたな\nババデルとやら‥",
  "tgt": "{框04}{立绘0101}「原来如此‥，让你费心了\n巴巴德尔‥"
 },
 {
  "id": "015604",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{框03}{立绘0000}「それは、いいが‥\nだいじょうぶか？{延时40}",
  "tgt": "{框03}{立绘0000}「那倒不急…\n你没事吧？{延时40}"
 },
 {
  "id": "015605",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}「無理をするな‥\n---\n死んでも おかしくない\nヤケドだったんだ‥",
  "tgt": "{立绘0000}「别硬撑…\n---\n那烫伤\n差点要了你的命…"
 },
 {
  "id": "015606",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「もうしばらく、休め‥\n---\nそれとも、なにか\n急ぐ理由でも あるのか\nお前さ‥{引0900}",
  "tgt": "{框05}{立绘0000}「再休息一阵…\n---\n还是说\n有什么急事\n非走不可啊…{引0900}"
 },
 {
  "id": "015607",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{框04}{立绘4600}「{队员06}‥",
  "tgt": "{框04}{立绘4600}「{队员06}…"
 },
 {
  "id": "015608",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{框04}{立绘C600}「名前だ。",
  "tgt": "{框04}{立绘C600}「报名字。"
 },
 {
  "id": "015609",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「ほう‥、{队员06}‥？\n---\n初代の 皇帝さまと\n同じ名前だな‥",
  "tgt": "{框05}{立绘0000}「哦…，{队员06}…？\n---\n和初代皇帝\n同一个名字啊…"
 },
 {
  "id": "015610",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「もう、いいようだな‥",
  "tgt": "{框05}{立绘0000}「看来已经好多了…"
 },
 {
  "id": "015611",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{框06}{立绘C640}「世話になった、ババデル\n私は 行こう‥",
  "tgt": "{框06}{立绘C640}「受你照顾了，巴巴德尔\n我这就走‥"
 },
 {
  "id": "015612",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「{队员06}‥",
  "tgt": "{框05}{立绘0000}「{队员06}…"
 },
 {
  "id": "015613",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「ワケが ありそうなんで\n闻かなかったが‥\nお前さんの あのケガ‥\n---\nまた、戦が\n始まるのか‥？",
  "tgt": "{框05}{立绘0000}「看你像有隐情\n就没多问…\n你那伤…\n---\n是要开战\n了吗…？"
 },
 {
  "id": "015614",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「長い間 戦をしてたんで‥\n---\nなんとなく 気配が\n分かる‥",
  "tgt": "{框05}{立绘0000}「老夫打了大半辈子仗…\n---\n多少能\n嗅出气息…"
 },
 {
  "id": "015615",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{框06}{立绘C640}「‥軍に いたのか？",
  "tgt": "{框06}{立绘C640}「‥你之前在军中？"
 },
 {
  "id": "015616",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「あ、ああ‥\nトシをとったのも あるが‥\n---\nなんだか バカバカしく\nなって、やめたがね。",
  "tgt": "{框05}{立绘0000}「啊，是啊…\n人老了也是一方面…\n---\n主要是觉得\n太蠢了，就不打了。"
 },
 {
  "id": "015617",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{框05}{立绘0000}「あの戦も‥\n---\n初代皇帝さまが\nお始めになった ころには\n意味があったのかも 知らんが\n---\n長く續きすぎて‥\nワケが分からなく\nなっていたんだ。",
  "tgt": "{框05}{立绘0000}「那场战争…\n---\n初代皇帝陛下\n开创之初\n或许还有意义…\n---\n但打得\n太久…\n早就变了味。"
 },
 {
  "id": "015618",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「分からない‥\n---\nうつろうもの、{码0B}か‥",
  "tgt": "{框06}{立绘8141}「不清楚‥\n---\n变化不定之物，吗‥{码0B}か‥"
 },
 {
  "id": "015619",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{框06}{立绘C640}「いや、{码0B}何でもない‥\n---\nでは、な‥",
  "tgt": "{框06}{立绘C640}「不，没什么‥\n---\n那么，再会‥{码0B}何でもない‥\n---\nでは、な‥"
 },
 {
  "id": "015620",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}「どこへ行くのか 知らんが\n気をつけてな‥",
  "tgt": "{立绘0000}「不知道你要去哪\n路上小心…"
 },
 {
  "id": "015621",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "ここなら 休めそうだ‥{码148B0C93}休んでいく\n旅の記錄だけする\nやめておく",
  "tgt": "在这里似乎能休息‥休息一下\n只保存旅程记录\n算了{码148B0C93}休んでいく\n旅の記錄だけする\nやめておく"
 },
 {
  "id": "015622",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}ババデル\n「‥ここらでは\n見かけない顏だな。\n---\nわしに何か用でも\nあるのか？\n---\n見てのとおりの\nただの世捨て人だが。{码14820C92}ただものではない\n用はないです",
  "tgt": "{立绘0000}巴巴德尔\n「…你这面孔\n这附近少见。\n---\n找老夫\n有事吗？\n---\n老夫不过是个\n人畜无害的弃世之人。{码14820C92}绝不简单\n没事"
 },
 {
  "id": "015623",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}‥なるほど。\nお前たちのその目‥\n---\n何かをなしとげようとする\n人間の目だ。\n---\nこのままここで\n一生を終えるのも\nいいと思っていたが‥\n---\nお前たちなら\nわしの戦いの技を\n---\n少しは良きことに\n役立ててくれる\nかもしれん。\n---\nこの{色04}しんがん{/色}は\n敵を確実にとらえる技だ。\n---\nまずはこれで、\nうでを みがくといい。\n---\n誰が覺えるのだ？",
  "tgt": "{立绘0000}…原来如此。\n你们那双眼…\n---\n是立志成事\n之人的眼。\n---\n老夫原以为\n就在此了却\n余生也好…\n---\n但若是你们\n老夫的战斗之技…\n---\n或许还能\n用于正途。\n---\n这个{色04}神眼{/色}\n是准确捕捉敌人的技能。\n---\n先用它\n磨磨身手吧。\n---\n谁来学？"
 },
 {
  "id": "015624",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}‥つまるところ\n戦いとは\n---\n迷いのない一太刀を\nいかに放てるかに\nかかっている。\n---\nたった一撃で\n{色02}{占位00}{/色}以上の\nダメージを放てたら\n---\nまた わしのもとに\n来るがいい。",
  "tgt": "{立绘0000}…说到底\n所谓战斗\n---\n关键在于\n能否放出\n毫无迷惘的一刀。\n---\n若能一击\n打出{色02}{占位00}{/色}以上的\n伤害\n---\n再来\n老夫这里吧。"
 },
 {
  "id": "015625",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}ふん。\n---\nなぜそんなことを\n言うのかは分からぬが‥\n---\nわしの見たところ\nお前たちの方が\nただものではない。\n---\n‥だがまだ\n世界を知らなさすぎる。\n---\nもっと多くの人間に会い、\nその力と考えを\n学ぶがいい。\n---\n話はそれからだ。",
  "tgt": "{立绘0000}哼。\n---\n虽不明白\n你为何这么说…\n---\n但老夫看\n你们也绝非\n等闲之辈。\n---\n…只是你们\n阅历太浅。\n---\n多去见些人\n学习他们的力量\n与想法吧。\n---\n之后再谈。"
 },
 {
  "id": "015626",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}さらばだ。",
  "tgt": "{立绘0000}后会有期。"
 },
 {
  "id": "015627",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}ババデル\n「‥おまえたちか。\n---\n‥そろそろ来るころかと\n思っていたぞ。\n---\nどうだ？\n---\nあれから さらに\n自分を高めることは\nできたか？",
  "tgt": "{立绘0000}巴巴德尔\n「…是你们啊。\n---\n…老夫估摸着\n也该来了。\n---\n如何？\n---\n从那之后\n有没有\n更上一层楼？"
 },
 {
  "id": "015628",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}‥なるほど。\n---\nどうやら わしが\n思った以上の人間に\n---\nそだとうと\nしているらしい。\n---\nそろそろこの技を\n教えるときが来たようだ。\n---\n時と場所を\nよく考えて使ってくれ。\n---\nオウギ{色03}{占位01}{/色}を\n教えてもらった！",
  "tgt": "{立绘0000}…原来如此。\n---\n看来你们\n比老夫想的\n---\n更有出息。\n---\n也该到\n教这招的时候了。\n---\n用时\n多想想时机与场合。\n---\n绝技{色03}{占位01}{/色}\n学会了！"
 },
 {
  "id": "015629",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}戦いの道は底なしだ。\n---\nきわめるごとに\n今まで見えなかったものが\n見えてくる。\n---\n{色02}{占位00}{/色}以上の\n一撃を放てたら\n---\nまた来るがいい。",
  "tgt": "{立绘0000}武道无边。\n---\n每精进一分\n便能看到\n前所未见之物。\n---\n若能放出\n{色02}{占位00}{/色}以上的一击\n---\n便再来吧。"
 },
 {
  "id": "015630",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}‥おどろいたぞ。\n---\nお前にはもう\n何も教えてやることが\nなくなった。\n---\nさらなる高みを\nもとめるなら、\n---\nあとは自分で こたえを\n見つけるがいい。\n---\nお前なら やれるはずだ。",
  "tgt": "{立绘0000}…老夫吃惊了。\n---\n已经没有\n什么可以\n教你的了。\n---\n若想攀登\n更高处…\n---\n答案\n就自己去寻吧。\n---\n你应该做得到。"
 },
 {
  "id": "015631",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}今回は何のようだ？{码14820C93}教えてください\n自分で自分を高めます\n何でもないです",
  "tgt": "{立绘0000}这次有何贵干？{码14820C93}请教我\n自己提升自己\n没什么事"
 },
 {
  "id": "015632",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}他にも何かあるのか？{码14820C93}教えてください\n自分で自分を高めます\n何でもないです",
  "tgt": "{立绘0000}还有别的事吗？{码14820C93}请教我\n自己提升自己\n没什么事"
 },
 {
  "id": "015633",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}みんなすでに\nわしに教わってるぞ。",
  "tgt": "{立绘0000}大家都已经\n跟老夫学过了。"
 },
 {
  "id": "015634",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}それでは{占位02}に\nわしの戦い方を\n教えよう。",
  "tgt": "{立绘0000}那就把老夫的\n战法\n教给{占位02}。"
 },
 {
  "id": "015635",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}それでは お前たちに\nわしの戦い方を\n教えよう。",
  "tgt": "{立绘0000}那就把老夫的\n战法\n教给你们。"
 },
 {
  "id": "015636",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}誰も教わらないのか？\n変なやつらだ。",
  "tgt": "{立绘0000}没人要学吗？\n怪人一群。"
 },
 {
  "id": "015637",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}‥今教えてるやつは\nこの中には\n誰もいないぞ。",
  "tgt": "{立绘0000}…在学的家伙\n这当中\n一个也没有。"
 },
 {
  "id": "015638",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}{占位02}は\nやめるのか‥\n---\n自分を決定するのは\n自分だけだ。\n---\nそれもまたよかろう。",
  "tgt": "{立绘0000}{占位02}\n要退师吗…\n---\n决定自己命运的\n只有自己。\n---\n这样也好。"
 },
 {
  "id": "015639",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}自分を決定するのは\n自分だけだ。\n---\nやめるのもまた、\n一つの こたえなのだろう。",
  "tgt": "{立绘0000}决定自己命运的\n只有自己。\n---\n退师也是\n一种答案吧。"
 },
 {
  "id": "015640",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}‥誰もやめないのか？\n---\n変なやつらだ。",
  "tgt": "{立绘0000}…没人要退师吗？\n---\n怪人一群。"
 },
 {
  "id": "015641",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}戦いの道は底なしだ。\n---\nきわめるごとに\n今まで見えなかったものが\n見えてくる。\n---\n{色02}{占位00}{/色}以上の\n一撃を放てたら\n---\nまた来るがいい。",
  "tgt": "{立绘0000}武道无边。\n---\n每精进一分\n便能看到\n前所未见之物。\n---\n若能放出\n{色02}{占位00}{/色}以上的一击\n---\n便再来吧。"
 },
 {
  "id": "015642",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "{立绘0000}ババデル\n「‥どんな人間でも\n死ねばそれで終わりだ。\n---\n無理はするなよ‥",
  "tgt": "{立绘0000}巴巴德尔\n「…无论何人\n一死万事皆休。\n---\n别硬撑…"
 },
 {
  "id": "015643",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "3000",
  "tgt": "3000"
 },
 {
  "id": "015644",
  "file": "WORLD/AREAS040.EMI",
  "seg": 11,
  "src": "5000",
  "tgt": "5000"
 },
 {
  "id": "015645",
