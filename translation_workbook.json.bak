  "tgt": "资料"
 },
 {
  "id": "001960",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "やめる",
  "tgt": "取消"
 },
 {
  "id": "001961",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "師事する伝承師を かえます",
  "tgt": "更换拜师的传承师"
 },
 {
  "id": "001962",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "伝承師の素質を かくにんします",
  "tgt": "确认传承师的资质"
 },
 {
  "id": "001963",
  "file": "SYSTEM/MASTER.EMI",
  "seg": 9,
  "src": "伝承師への師事を やめます",
  "tgt": "停止跟随传承师"
 },
 {
  "id": "001964",
