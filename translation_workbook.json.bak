  "seg": 8,
  "src": "新しい仕事が\nふえたよう",
  "tgt": "新的工作\n增加了哟"
 },
 {
  "id": "008652",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "新しい家が\n建ったよう",
  "tgt": "新房子\n盖好了哟"
 },
 {
  "id": "008653",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "土地がやっと\nひろがったよう",
  "tgt": "土地终于\n扩展了哟"
 },
 {
  "id": "008654",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "なんとなく\nはってみたよう",
  "tgt": "不知为何\n贴了上去哟"
 },
 {
  "id": "008655",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "ちゃんと見てる？",
  "tgt": "有好好看着吗？"
 },
 {
  "id": "008656",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "あたしのおやつ盗んだ人\nはやく名乘り出てよう",
  "tgt": "偷我点心的人\n快点站出来哟"
 },
 {
  "id": "008657",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "仕事をさぼっている人が\nいるよう！",
  "tgt": "有人偷懒\n不干活哟！"
 },
 {
  "id": "008658",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "みんなもっと\nあたしに話しかけてよう",
  "tgt": "大家多来\n找我聊天哟"
 },
 {
  "id": "008659",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "外出は10さいに\nなってからだよう",
  "tgt": "外出要等\n满10岁才行哟"
 },
 {
  "id": "008660",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "あいうえお\nあえいおう",
  "tgt": "啊咿呜诶哦\n啊诶咿哦呜"
 },
 {
  "id": "008661",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "「わたしの夢」\nもっとでかくなる",
  "tgt": "「我的梦想」\n变得更大"
 },
 {
  "id": "008662",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "「わたしの夢」\nとりになる",
  "tgt": "「我的梦想」\n变成鸟"
 },
 {
  "id": "008663",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "すこし\nへこんでるよう‥",
  "tgt": "有些\n消沉哟‥"
 },
 {
  "id": "008664",
  "file": "WORLD/AREAE026.EMI",
  "seg": 8,
  "src": "死ぼう報告",
  "tgt": "死亡报告"
 },
