  "tgt": "悟性"
 },
 {
  "id": "008171",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "年れい",
  "tgt": "年龄"
 },
 {
  "id": "008172",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "職業",
  "tgt": "职业"
 },
 {
  "id": "008173",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "整理方法をえらんでください",
  "tgt": "请选择整理方式"
 },
 {
  "id": "008174",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "解体できます",
  "tgt": "可拆除"
 },
 {
  "id": "008175",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "空き家です 解体できます",
  "tgt": "空房 可拆除"
 },
 {
  "id": "008176",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "建築中です 解体できます",
  "tgt": "建筑中 可拆除"
 },
 {
  "id": "008177",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "空き地です 家を建てることができます",
  "tgt": "空地 可以建房"
 },
 {
  "id": "008178",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "選べません",
  "tgt": "无法选择"
 },
 {
  "id": "008179",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "家を解体しますか？",
  "tgt": "要拆除房屋吗？"
 },
 {
  "id": "008180",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "建てたい場所を選んでください",
  "tgt": "请选择想建房的位置"
 },
 {
  "id": "008181",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "空き地にもどしていいですか？",
  "tgt": "要恢复为空地吗？"
 },
 {
  "id": "008182",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「土木」の妖精がいません",
  "tgt": "没有「土木」的妖精"
 },
 {
  "id": "008183",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "{码14000C92}「仕事のことだけど\n「最近どう？",
  "tgt": "{码14000C92}「关于工作\n「最近怎么样？"
 },
 {
  "id": "008184",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "ひりょうを与えてみますか？{码14820C82}与える\nやめとく",
  "tgt": "要试着施肥吗？施肥\n算了{码14820C82}与える\nやめとく"
 },
 {
  "id": "008185",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "与えたいアイテムを選んでください",
  "tgt": "请选择要给予的物品"
 },
 {
  "id": "008186",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "いくつ与えますか？",
  "tgt": "要给多少？"
 },
 {
  "id": "008187",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "実がなっている\nゆらしてとってみよう",
  "tgt": "结出了果实\n摇一摇试着摘下吧"
 },
 {
  "id": "008188",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "{占位00}を{占位01}コ手に入れた！",
  "tgt": "获得了{占位00}{占位01}个！"
 },
 {
  "id": "008189",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "作戦とは、妖精の働き具合です\nこれで作業成果と食物消化が\n変化します\n『{色02}じゆうに{/色}』に関しては、\n作業成果はそこそこですが\n{色07}センス{/色}があがりやすいようです",
  "tgt": "作战指妖精的干劲\n作业成果与食物消耗\n会随之变化\n至于『{色02}自由{/色}』，\n作业成果一般\n但{色07}品味{/色}似乎容易提升"
 },
 {
  "id": "008190",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "シゴトについていない妖精を\nあらわします\n妖精が生まれると\n最初にこの中に入ります",
  "tgt": "表示未从事工作的妖精\n妖精出生后\n最初会进入\n这里"
 },
 {
  "id": "008191",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "食べ物を集めます\nたくさん取れるときがあれば\n少ないときもあり\nその作業効果に関しては\n不安定です",
  "tgt": "收集食物\n收获有时多\n有时少\n作业效果\n并不稳定"
 },
 {
  "id": "008192",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "土地をひろげ家を建てます\nこのウインドウにいれておくと\n土地は自動でひろがりますが\n家を建てるときは\nコマンドメニューの『土地』を\n選んでください",
  "tgt": "开垦土地建造房屋\n放在此窗口中\n土地会自动扩展\n但建房时\n请选择命令菜单中的\n『土地』"
 },
 {
  "id": "008193",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "食べ物を作ります\nリンゴ配分を高めることにより\nプレイヤー用のアイテムを\n作ることも可能です\n良いひりょうを与えることで\nできるアイテムが変化します",
  "tgt": "制作食物\n提高苹果配比后\n也可制作\n玩家用的道具\n给予好的肥料\n可改变产出物品"
 },
 {
  "id": "008194",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "道具を売買します\n妖精の せいかくにより\nあつかう商品が変化します\n『文化』の度合が高いほど\n商品の種類が多くなります",
  "tgt": "买卖道具\n会因妖精的性格\n而改变经营的商品\n『文化』程度越高\n商品种类越多"
 },
 {
  "id": "008195",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "武器を売買します\n妖精の せいかくにより\nあつかう商品が変化します\n『文化』の度合が高いほど\n商品の種類が多くなります",
  "tgt": "买卖武器\n会因妖精的性格\n而改变经营的商品\n『文化』程度越高\n商品种类越多"
 },
 {
  "id": "008196",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "宿屋です\nタダでとまることができます\nここでさまざまなプレイヤー\n情報を闻くこともできます",
  "tgt": "旅店\n可以免费住宿\n在这里也能打听到\n各种玩家情报"
 },
 {
  "id": "008197",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "探険をしてアイテムを\n見つけてきます\n探険にシッパイすると\n归らぬ人となることも‥‥",
  "tgt": "外出探险寻找道具\n若探险失败\n也可能变成\n不归之人‥‥"
 },
 {
  "id": "008198",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "プレイヤーの戦闘を\n助けてくれます\n人数が多く能力が高いほど\n妖精魔法が強力になります",
  "tgt": "会在玩家的战斗中\n施以援手\n人数越多能力越高\n妖精魔法越强大"
 },
 {
  "id": "008199",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "音楽を闻かせてくれます\nセンスが高いほど\nたくさんの曲を闻けるように\nなります",
  "tgt": "会为玩家演奏音乐\n悟性越高\n能听到的曲子\n越多"
 },
 {
  "id": "008200",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "イラストを見せてくれます\nセンスが高いほど\nたくさんの作品を見れるように\nなります",
  "tgt": "会展示插画\n悟性越高\n能看到的\n作品越多"
 },
 {
  "id": "008201",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "メタルの売買を行います\n（手数りょうは10%です）\nかかくは変動するので\n安いときに買って\n高いときに売れば\nお金をもうけることも可能です",
  "tgt": "进行金属买卖\n（手续费为10%）\n价格会波动\n低价买入\n高价卖出\n也能赚到钱"
 },
 {
  "id": "008202",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "さまざまなミニゲームを\n楽しむことができます",
  "tgt": "可以游玩\n各种小游戏"
 },
 {
  "id": "008203",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "保険に入っておけば\n全滅しても その場で\nやりなおせることが\nあります\n保険にさまざまな特約を\nつけることも可能です",
  "tgt": "若入了保险\n即使全灭\n有时也能当场\n重来\n还能为保险\n附加各种特约"
 },
 {
  "id": "008204",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "空き家です\nまず職業を決めて下さい",
  "tgt": "空房\n请先决定职业"
 },
 {
  "id": "008205",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「ハラペコよう‥",
  "tgt": "「肚子饿了哟"
 },
 {
  "id": "008206",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「ヒトの目を 突っつくと\n痛がるから、おかしいよう！",
  "tgt": "「戳人类的眼睛\n它们会喊痛，真有趣哟！"
 },
 {
  "id": "008207",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「{队员00}は、どうも\n信用できないよう‥",
  "tgt": "「总感觉\n没法信任{队员00}…"
 },
 {
  "id": "008208",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「ねむいよう",
  "tgt": "「困了哟"
 },
 {
  "id": "008209",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「はあ‥",
  "tgt": "「哈啊‥"
 },
 {
  "id": "008210",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「せつないよう‥",
  "tgt": "「好难受哟‥"
 },
 {
  "id": "008211",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「どうして、仕事なんて\nしなくちゃ いけないのよう！？",
  "tgt": "「为什么非得\n工作不可啊！？"
 },
 {
  "id": "008212",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「別に、話すことないよう",
  "tgt": "「没什么好说的哟"
 },
 {
  "id": "008213",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「{队员00}って\nみんなに きらわれる\nタイプだよう",
  "tgt": "「{队员00}这种类型\n大家都会\n讨厌的哟"
 },
 {
  "id": "008214",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「なによう？",
  "tgt": "「什么事哟？"
 },
 {
  "id": "008215",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「{队员00}って‥\nあたしたちを\n食い物にしてるって、ほんと？{码14000C02}本当だよ\nまさか",
  "tgt": "「{队员00}…\n把我们当\n摇钱树，真的假的？{码14000C02}真的哦\n怎么会"
 },
 {
  "id": "008216",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「食べかけの 木の実を\n落としちゃった‥\n---\nついてないよう‥",
  "tgt": "「咬了一半的坚果\n掉掉了‥\n---\n真倒霉哟‥"
 },
 {
  "id": "008217",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「仕事が、つまらないよう‥",
  "tgt": "「工作，好无聊哟‥"
 },
 {
  "id": "008218",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「いそがしいよう‥\nいやだよう‥",
  "tgt": "「好忙哟‥\n讨厌哟‥"
 },
 {
  "id": "008219",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「旅に‥、出たいよう‥",
  "tgt": "「好想‥、去旅行哟‥"
 },
 {
  "id": "008220",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「しあわせじゃ、ないよう‥",
  "tgt": "「我不幸福哟‥"
 },
 {
  "id": "008221",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「はいはい‥",
  "tgt": "「是是‥"
 },
 {
  "id": "008222",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「もう、逃げたいよう‥",
  "tgt": "「真想，逃走哟‥"
 },
 {
  "id": "008223",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「また、無理なこと\n言うよう‥",
  "tgt": "「又提\n过分要求哟‥"
 },
 {
  "id": "008224",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「ぶー",
  "tgt": "「噗——"
 },
 {
  "id": "008225",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「やっぱり‥",
  "tgt": "「果然‥"
 },
 {
  "id": "008226",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「ほんとかなぁ‥",
  "tgt": "「真的吗‥"
 },
 {
  "id": "008227",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「たてた家に出てるメーターは\n活気度をあらわすよう\n---\nみどり色が長いほど\n活気があるらしいよう",
  "tgt": "「建好的房子上显示的槽\n表示活跃度哟\n---\n绿色越长\n好像越有活力哟"
 },
 {
  "id": "008228",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「ルートを移動中、かならず\n{色02}？マーク{/色}が出る場所があるよう\n---\nそこには何かあるから\nとりあえず入ってみたほうが\nいいよう",
  "tgt": "「赶路途中，肯定会有\n冒出{色02}？标记{/色}的地方哟\n---\n那里有东西\n先进去探一探\n比较好哟"
 },
 {
  "id": "008229",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「{队员00}達が 外で\n戦闘している間に‥\n---\nあたし達、はたらいて\nいるんだよう",
  "tgt": "「{队员00}他们\n在外面战斗的时候…\n---\n我们\n在干活哟"
 },
 {
  "id": "008230",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「能力のひくい人を\n探険に行かせちゃ\nだめだよう！",
  "tgt": "「让能力低的家伙\n去探险\n可不行哟！"
 },
 {
  "id": "008231",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「あたし達は、オトコでも\nオンナでも、ないのよう‥\n---\n知ってた？",
  "tgt": "「我们既不是\n男人也不是女人哟‥\n---\n你知道吗？"
 },
 {
  "id": "008232",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「まめに 来てくれると\nみんな よろこぶよう",
  "tgt": "「常来看我们\n大家会很高兴哟"
 },
 {
  "id": "008233",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「変わり者って、\nあまり生まれないから\n変わり者なんだよう",
  "tgt": "「怪胎之所以是怪胎\n是因为很少\n生出怪胎哟"
 },
 {
  "id": "008234",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「あたし達の 仲間で‥\n---\nヒトと いっしょに住んでる\n妖精が いるよう",
  "tgt": "「我们的同伴中‥\n---\n有妖精和人类\n住在一起哟"
 },
 {
  "id": "008235",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「もっと休みがほしいよう",
  "tgt": "「想要更多休息哟"
 },
 {
  "id": "008236",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「食べ物の 残り数に\n注意してよう",
  "tgt": "「注意食物的\n剩余量哟"
 },
 {
  "id": "008237",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「狩り場であったら\n手伝ってよう",
  "tgt": "「在狩猎场遇到\n就帮忙一下哟"
 },
 {
  "id": "008238",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「たまには あたしたちの\n性かくにも注意してよう",
  "tgt": "「偶尔也注意\n一下我们的性格哟"
 },
 {
  "id": "008239",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「{码03}のせなかに\nなにか ついてるよう",
  "tgt": "「背上\n好像沾着什么东西哟{码03}のせなかに\nなにか ついてるよう"
 },
 {
  "id": "008240",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「つれない魚は\nルアーをかえるといいらしいよう",
  "tgt": "「不给面子的鱼\n据说换换拟饵比较好哟"
 },
 {
  "id": "008241",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「{队员00}は、どのくらい\nあたしたちのこと すき？{码14010C13}いっぱい\nふつう\n··",
  "tgt": "「{队员00}有多\n喜欢我们呀？{码14010C13}超喜欢\n一般\n··"
 },
 {
  "id": "008242",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「おみやげ ちょうだい",
  "tgt": "「给我带伴手礼嘛"
 },
 {
  "id": "008243",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「あたしたちはシゴトすることで\n成長するんだよう",
  "tgt": "「我们通过工作\n成长哟"
 },
 {
  "id": "008244",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「あたしたちは ごはんより\nイタズラとおひるねが\n大好きなのよう",
  "tgt": "「比起吃饭\n我们更喜欢恶作剧\n和睡午觉哟"
 },
 {
  "id": "008245",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「よく性かくがいいって言われない？\n---\n{码0B}··なーんちゃって ウソだよう！",
  "tgt": "「常被人夸性格好？\n---\n··开玩笑的骗你的哟！{码0B}··なーんちゃって ウソだよう！"
 },
 {
  "id": "008246",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「狩りはねー 成功すると\nいっぱい食べ物がとれるけど\nしっぱいすることもあるのよう",
  "tgt": "「狩猎呀，成功的话\n能收获好多食物\n但也会失败哟"
 },
 {
  "id": "008247",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「うそつき",
  "tgt": "「骗子"
 },
 {
  "id": "008248",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「ふーん",
  "tgt": "「哦——"
 },
 {
  "id": "008249",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「ざんねん",
  "tgt": "「遗憾"
 },
 {
  "id": "008250",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「ルートを移動中、かならず\n{色02}？マーク{/色}が出る場所があるよう\n---\nそこには何かあるから\nとりあえず入ってみたほうが\nいいよう",
  "tgt": "「赶路途中，肯定会有\n冒出{色02}？标记{/色}的地方哟\n---\n那里有东西\n先进去探一探\n比较好哟"
 },
 {
  "id": "008251",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「{队员00}がくると\nもっとシゴトがんばろうって\n思うのよう",
  "tgt": "「{队员00}一来\n干活就更有\n劲头了哟"
 },
 {
  "id": "008252",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「空気のいいところは\n能力が成長しやすいのよう",
  "tgt": "「空气好的地方\n能力容易成长哟"
 },
 {
  "id": "008253",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「『文化』がひくいと\nいい商品は作れないよう",
  "tgt": "「『文化』低的话\n做不出好商品哟"
 },
 {
  "id": "008254",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「となりに家があると、活気が\n高くなってショップの品物が\n早くふえるよう",
  "tgt": "「旁边有房子的话\n活跃度会变高\n商店的商品增加更快哟"
 },
 {
  "id": "008255",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「今は{队员00}のこと好きだけど\nあたしたちは気まぐれだから\nこれからは わからないよう",
  "tgt": "「现在是喜欢{队员00}\n但我们很善变\n以后就不知道了哟"
 },
 {
  "id": "008256",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「{队员00}といっしょに\n遊ぶのよう",
  "tgt": "「和{队员00}\n一起玩哟"
 },
 {
  "id": "008257",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「あたし この町だーいすき\n{队员00} ありがとう！！",
  "tgt": "「人家最喜欢这个镇子啦\n{队员00} 谢谢你！！"
 },
 {
  "id": "008258",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「妖精の伝承師はもう見つけた？{码14020C02}見つけた\nまだ",
  "tgt": "「找到妖精的传承师了吗？找到了\n还没有{码14020C02}見つけた\nまだ"
 },
 {
  "id": "008259",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「闻いて 闻いて\n---\nあたし、ミスターフェアリーに\n選ばれたのよう！！\n---\nえっオトコじゃないって？\n{码0B}うーん、フクザツな気分··",
  "tgt": "「听听听我说\n---\n我，被选为\n妖精先生了哟！！\n---\n诶？不是男人？\n唔，心情好复杂··{码0B}うーん、フクザツな気分··"
 },
 {
  "id": "008260",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「海って見たことある？\n見てみたいなあ",
  "tgt": "「你见过海吗？\n好想看看啊"
 },
 {
  "id": "008261",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「たてた家に出てるメーターは\n活気度をあらわすよう\n---\nみどり色が長いほど\n活気があるらしいよう",
  "tgt": "「建好的房子上显示的槽\n表示活跃度哟\n---\n绿色越长\n好像越有活力哟"
 },
 {
  "id": "008262",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「底の方にいる魚って\nねらわないとつりにくいよね",
  "tgt": "「待在深处的鱼\n不瞄准的话很难钓呢"
 },
 {
  "id": "008263",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「きのうね‥‥\n{队员00}のユメをみたよう",
  "tgt": "「昨天啊……\n梦到{队员00}了哟"
 },
 {
  "id": "008264",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「よう兵は、使えば使うほど\n強くなるんだよう",
  "tgt": "「佣兵呀，越用\n越强哟"
 },
 {
  "id": "008265",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「伝承師を見つけたいなら\n---\nむかし行ったところに\nもう1度行ってみるべきだよう",
  "tgt": "「想找传承师的话\n---\n应该再去\n以前去过的地方看看哟"
 },
 {
  "id": "008266",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「あたしたちがアイツに\n食べられなかったのは\n{队员00}のおかげだよう",
  "tgt": "「我们能不被\n那家伙吃掉\n全靠{队员00}哟"
 },
 {
  "id": "008267",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「タイプによってダメな作戦と\nいい作戦があるの気づいてた？\n共感度が大きく変わるのよう",
  "tgt": "「不同类型有好用和\n不好用的作战，注意到了吗？\n共鸣度会大不相同哟"
 },
 {
  "id": "008268",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「みずうみでの 水あび\n気持ちがいいんだよう",
  "tgt": "「在湖里洗澡\n可舒服了哟"
 },
 {
  "id": "008269",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「会話って大切だよう\nあいてがどう思っているか\nわかるもんね",
  "tgt": "「对话很重要哟\n能知道对方\n在想什么呢"
 },
 {
  "id": "008270",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「そう",
  "tgt": "「是吗"
 },
 {
  "id": "008271",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「どっかで人間と\nくらしているよう",
  "tgt": "「好像在哪和人类\n一起生活哟"
 },
 {
  "id": "008272",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「最初はグー\n---\n‥そんなことをいいながら\nじゃんけんする人がいるよう",
  "tgt": "「第一把出石头\n---\n‥有人一边这么说\n一边猜拳哟"
 },
 {
  "id": "008273",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「作物のひりょうは\n魚がいいみたいだけど‥\n---\n{色02}くさったニク{/色} {色02}おこげ{/色}\n{色02}鳥のフン{/色}もいいらしいわよう",
  "tgt": "「作物施肥\n好像用鱼最好…\n---\n{色02}腐肉{/色} {色02}锅巴{/色}\n{色02}鸟粪{/色}好像也不错哟"
 },
 {
  "id": "008274",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「{色03}スーパーコンボ{/色}は\nコンボの3人目で出すと\nいいらしいよう",
  "tgt": "「超级连击\n在连击第3人时\n放出好像不错哟{色03}スーパーコンボ{/色}は\nコンボの3人目で出すと\nいいらしいよう"
 },
 {
  "id": "008275",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「{色03}反射撃ち{/色} {色03}ワータイガー{/色}\n{色03}夢氷絶命剣{/色} {色03}火の鳥{/色}‥\n---\nどれか知ってる？",
  "tgt": "「反射射击双头虎\n梦冰绝命剑火之鸟‥\n---\n知道哪个？{色03}反射撃ち{/色} {色03}ワータイガー{/色}\n{色03}夢氷絶命剣{/色} {色03}火の鳥{/色}‥\n---\nどれか知ってる？"
 },
 {
  "id": "008276",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「つりの深度メーターって\nよく見るとたまに光らない？\n---\nあれはね‥もしかしたら\n魚がたくさんいる場所で\nよく光るのかもしれないよう",
  "tgt": "「钓鱼的深度槽\n仔细看，偶尔会不会发光？\n---\n那个呀‥说不定\n在鱼多的地方\n容易发光哟"
 },
 {
  "id": "008277",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「{色02}やすにく{/色}は1つぶん\n{色02}ロース{/色}は3つぶん\n{色02}うまにく{/色}は5つぶん‥\n---\n{色02}マンモにく{/色}ならなんと\n10こぶんの食べ物になるよう",
  "tgt": "「{色02}便宜肉{/色}顶1份\n{色02}里脊{/色}顶3份\n{色02}好肉{/色}顶5份…\n---\n{色02}猛犸肉{/色}居然能顶\n10份口粮哟"
 },
 {
  "id": "008278",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「ちゅきっ！！！",
  "tgt": "「啾——！！！"
 },
 {
  "id": "008279",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「敵によっては回復魔法で\nダメージをあたえられるよう",
  "tgt": "「有的敌人\n用恢复魔法也能造成伤害哟"
 },
 {
  "id": "008280",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「『がんばれ』って共感度を\n下げない作戦なんだよう",
  "tgt": "「『加油』是不会降低\n共鸣度的作战哟"
 },
 {
  "id": "008281",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「どこかにものすごい強い敵が\nいるらしいよう\n---\n{色02}ペイル{/色}だかなんだか\nたしかそんな名前ではじまる\nやつだったよう",
  "tgt": "「好像哪里有个\n超强的大敌哟\n---\n叫{色02}佩尔{/色}什么的\n好像名字就是那么开头的家伙哟"
 },
 {
  "id": "008282",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「ああっ\nすっごいラッキーなことが\nおこるわよう",
  "tgt": "「啊——\n会有超幸运的\n事发生哟"
 },
 {
  "id": "008283",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「狩りしているところで\n出会ったら\n助けてほしいよう",
  "tgt": "「在狩猎时\n若遇到\n请帮帮我们哟"
 },
 {
  "id": "008284",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「もう ここの住人になっちゃえば\nいいよう",
  "tgt": "「干脆变成这里的\n居民就好了哟"
 },
 {
  "id": "008285",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「ごちそうつくるから\n家によっていってよう",
  "tgt": "「我会做好吃的\n请来家里玩哟"
 },
 {
  "id": "008286",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「これからも ずーっとよろしくね",
  "tgt": "「今后也请一直多多关照"
 },
 {
  "id": "008287",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「パーツがほしければ難度2‥\n---\nなんのことだか\nよくわからないよう",
  "tgt": "「想要零件的话难度2‥\n---\n完全搞不懂\n什么意思哟"
 },
 {
  "id": "008288",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「{队员00}がいないと\nさみしいよう",
  "tgt": "「没有{队员00}\n好寂寞哟"
 },
 {
  "id": "008289",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「{队员00}って神様みたい",
  "tgt": "「{队员00}像神明一样"
 },
 {
  "id": "008290",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「逃走回数で攻撃力のあがる\nスキルもあるらしいよう",
  "tgt": "「似乎还有凭逃跑次数\n提升攻击力的技能哟"
 },
 {
  "id": "008291",
  "file": "WORLD/AREAE025.EMI",
  "seg": 8,
  "src": "「{色02}アケロン{/色}って魚、知ってる？\n---\n呪いで変異した魚らしいよう",
  "tgt": "「知道{色02}阿克隆{/色}鱼吗？\n---\n好像是受诅咒变异的鱼哟"
 },
 {
  "id": "008292",
