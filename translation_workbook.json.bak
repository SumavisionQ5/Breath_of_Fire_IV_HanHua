  "tgt": "1"
 },
 {
  "id": "013229",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "「ふん、ンなこと言って\nごちそうするだけの金‥\nアンタ 持ってるのか？{码14030C92}はい\nいいえ",
  "tgt": "「哼，嘴上说得好听\n请客的钱‥\n你身上有吗？有\n没有{码14030C92}はい\nいいえ"
 },
 {
  "id": "013230",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "「ふーん‥{码0B}だったら\nもうちょっと{色03}カネ{/色}持って\n出直してくるんだな！",
  "tgt": "「哼～‥那就\n多带点钱\n再来吧！{码0B}だったら\nもうちょっと{色03}カネ{/色}持って\n出直してくるんだな！"
 },
 {
  "id": "013231",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "{占位00}を {占位01}コ\n手に入れた！",
  "tgt": "{占位00}{占位01}个\n到手了！"
 },
 {
  "id": "013232",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "「戦爭は、今\nお休みなんだってねぇ‥\n---\nまた始まったら\nヤダねぇ‥",
  "tgt": "「听说战争现在\n休战中呢‥\n---\n要再打起来\n可就讨厌啦‥"
 },
 {
  "id": "013233",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "「この町の 近所で\n帝国のやつらを見たって\n話があるんだ‥\n---\nまた、戦爭でも\nおっぱじめる気かな‥",
  "tgt": "「听说有人在\n这镇子附近见过\n帝国的家伙‥\n---\n该不会又想\n挑起战争吧‥"
 },
 {
  "id": "013234",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "\n『{占位00}』を 手に入れた！",
  "tgt": "\n得到了『{占位00}』！"
 },
 {
  "id": "013235",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "{金钱00}「いらっしゃい\nお泊りは{占位00}ゼニーですが\n休んで行かれますか？{码14860C93}泊まって行く\n旅の記錄だけする\nやめておく",
  "tgt": "{金钱00}「欢迎光临\n住店{占位00}泽尼\n要休息一下吗？{码14860C93}住下再走\n只记录旅程\n还是算了"
 },
 {
  "id": "013236",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "「あら？\nお金が足りませんわよ",
  "tgt": "「哎呀？\n钱不够了哟"
 },
 {
  "id": "013237",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "「戦爭になったら\nチャンバや セネスタみたいに\n---\n呪われて しまうのかねぇ\n怖いねぇ‥",
  "tgt": "「真打起仗来\n会像占巴和塞内斯塔\n那样被咒沉吗‥\n---\n好可怕呀‥"
 },
 {
  "id": "013238",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "「帝国の軍隊が、町に\n来てるって 話しだ‥\n---\nやっぱ、また戦爭か？",
  "tgt": "「听说帝国的军队\n进镇来了‥\n---\n果然，又要打仗了？"
 },
 {
  "id": "013239",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "{立绘0B0A}「{特效}{/特效}{码08}ふぅ〜〜〜〜〜〜ぬ！{码0E}\n---\n{码0B}‥{码0B}‥{码0B}今のは アクビだふぬ。",
  "tgt": "{立绘0B0A}「呼——————奴！\n---\n‥‥刚那是打哈欠的说。{特效}{/特效}{码08}ふぅ〜〜〜〜〜〜ぬ！{码0E}\n---\n{码0B}‥{码0B}‥{码0B}今のは アクビだふぬ。"
 },
 {
  "id": "013240",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "{码0A}\n---\n「ちちう。",
  "tgt": "{码0A}\n---\n「啾——。"
 },
 {
  "id": "013241",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "「{特效}{/特效}\nべ、別に ネズミが\n怖くって{码0E}\n---\n{特效}{/特效}\nおりられない\nわけじゃ‥{码0B}{码0B}{码0B}ないわよ。{码0E}",
  "tgt": "「\n才，才不是\n因为怕老鼠\n---\n\n才待在\n这种地方的。{特效}{/特效}\nべ、別に ネズミが\n怖くって{码0E}\n---\n{特效}{/特效}\nおりられない\nわけじゃ‥{码0B}{码0B}{码0B}ないわよ。{码0E}"
 },
 {
  "id": "013242",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "{立绘0303}「帝国の 連中が\n暴れていってから‥\n---\nめっきり 客が\n減っちまってね‥",
  "tgt": "{立绘0303}「帝国的家伙们\n来闹过之后‥\n---\n客人就\n一下子少喽‥"
 },
 {
  "id": "013243",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "「君は いつかの‥\nずいぶん、たくましく\nなったね。",
  "tgt": "「你是那次的‥\n变得相当\n结实了呢。"
 },
 {
  "id": "013244",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "「帝国で、呪砲が\n使われたって‥\n---\n旅の人から 闻いたけど\n本当かねぇ‥？",
  "tgt": "「听说帝国那边\n用了咒炮‥\n---\n是旅行的人说的\n是真的吗‥？"
 },
 {
  "id": "013245",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "「この前、帝国兵が\n来たと思ったら\n今度は 呪砲か‥\n---\nやっぱり 戦爭‥\n始まるのかなあ？",
  "tgt": "「前阵子帝国兵\n刚来过\n这回又是咒炮‥\n---\n果然战争‥\n要开始了吗？"
 },
 {
  "id": "013246",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "{立绘0303}「ここにいた客‥？\n---\nみんな ビビって\n逃げ归っちまったよ‥",
  "tgt": "{立绘0303}「之前在店的客人‥？\n---\n全都吓得\n逃回去了哟‥"
 },
 {
  "id": "013247",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "「帝国の エラいさん‥\n顏にケガして、ザマぁなかったよ。",
  "tgt": "「帝国的大人物‥\n脸上挂了彩，真是活该。"
 },
 {
  "id": "013248",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "「あの人達‥竜を\n探してたんだって？\n---\n戦爭しに 来たんじゃなくて\nホント、よかったよ。",
  "tgt": "「那些人‥说是\n在找龙？\n---\n不是来打仗的\n真是太好了。"
 },
 {
  "id": "013249",
  "file": "WORLD/AREAS001.EMI",
  "seg": 12,
  "src": "「帝国のヤツら‥\n---\n暴れるのは、竜を\n捕まえる 時だけに\nして欲しいね‥",
  "tgt": "「帝国的家伙们‥\n---\n拜托他们撒野\n只限定在抓龙的\n时候吧‥"
 },
 {
  "id": "013250",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}うぃんでぃあのへや",
  "tgt": "{立绘0000}温蒂亚的房间"
 },
 {
  "id": "013251",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{金钱00}「こんにちは、旅の方\n{占位00}ゼニーですけど\n休んで行かれます？{码14860C93}休む\n旅の記錄だけする\n今はやめておく",
  "tgt": "{金钱00}「您好，旅人\n{占位00}泽尼\n要休息吗？{码14860C93}休息\n只记录旅程\n这次先不了"
 },
 {
  "id": "013252",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「すみませんが\nお金が、足りないようです。",
  "tgt": "「很抱歉\n钱，好像不够。"
 },
 {
  "id": "013253",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「今は、旅してるけど‥\n---\n{金钱00}そのうち、店を持つんだ。\nりっぱな 武器屋さ！{码14840C94}装備品を買う\n持ち物を売る\n装備品の下取り\n今は用がない",
  "tgt": "「现在还在旅行……\n---\n{金钱00}迟早要开自己的店。\n成为像样的武器商人！{码14840C94}购买装备\n卖掉身上的东西\n装备折价回收\n这次没事"
 },
 {
  "id": "013254",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「いなくなった、エリーナ様を\n探して‥\n---\n{队员01}様まで\n出ていっちまったって\n話しだねぇ‥\n---\n王様も、さぞや\nご心配だろうねぇ‥",
  "tgt": "「为了寻找失踪的\n艾莉娜大人‥\n---\n连{队员01}大人\n都亲自出马了\n听说了吗‥\n---\n国王也一定\n非常担心吧‥"
 },
 {
  "id": "013255",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「ボクも‥\nおねいちんが、いなくなったら\n探しに行くー。",
  "tgt": "「我也要‥\n姐姐不见了的话\n就去找——。"
 },
 {
  "id": "013256",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「ばかね‥\nわたしは、いなくならないの。",
  "tgt": "「笨蛋‥\n我才不会不见呢。"
 },
 {
  "id": "013257",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「ここは、へいわだね‥\nけど、かすかに におうね\n---\n戦のにおいが‥",
  "tgt": "「这里很和平呢‥\n不过呢，隐约闻得到\n---\n战争的气味‥"
 },
 {
  "id": "013258",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「ウインディアの女性は\nきれいだね‥\n---\nウチのかみさんも\nそりゃ、かわいかったよ‥",
  "tgt": "「温迪亚的女性\n真漂亮呀‥\n---\n我家那位\n当年也是可爱得很哟‥"
 },
 {
  "id": "013259",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0101}{码0A}",
  "tgt": "{立绘0101}{码0A}"
 },
 {
  "id": "013260",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「デブぼっちゃんが\nこれ以上 太らないように‥\n---\n食器を ぜんぶ\nかくしちゃいました‥！",
  "tgt": "「为了不让胖少爷\n继续胖下去‥\n---\n把餐具全都\n藏起来了‥！"
 },
 {
  "id": "013261",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{码0A}\n「ちう",
  "tgt": "{码0A}\n「啾"
 },
 {
  "id": "013262",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「ふあはぁ〜〜\nはやぐ、食ぁべたいよぉう‥！",
  "tgt": "「呼啊哈——～\n好想吃东西呀——‥！"
 },
 {
  "id": "013263",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「うう、おいたわしや\nおぼっちゃま‥\n---\n食器が見つかるまでの\nごしんぼうです‥！",
  "tgt": "「呜呜，少爷真是\n可怜呀‥\n---\n在找到餐具之前\n就忍忍吧‥！"
 },
 {
  "id": "013264",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「{道具1701}も、{道具4F03}も\n{道具4501}も、{道具3603}も\n{道具4D00}も‥\n---\nみーんな、無くなって\nしまったデスよ。",
  "tgt": "「{道具1701}也好，{道具4F03}也好\n{道具4501}也好，{道具3603}也好\n{道具4D00}也好……\n---\n全都\n没有了哟。"
 },
 {
  "id": "013265",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "おちゃづけだ‥\n{道具1701}が あれば\n食べられるだろう‥",
  "tgt": "茶泡饭呀‥\n有{道具1701}的话\n就能吃了吧‥"
 },
 {
  "id": "013266",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "たこやきだ‥\n{道具3603}が あれば\n食べられるだろう‥",
  "tgt": "章鱼烧呀‥\n有{道具3603}的话\n就能吃了吧‥"
 },
 {
  "id": "013267",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "スパゲッティだ‥\n{道具4501}が あれば\n食べられるだろう‥",
  "tgt": "意大利面呀‥\n有{道具4501}的话\n就能吃了吧‥"
 },
 {
  "id": "013268",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "プリンだ‥\n{道具4F03}が あれば\n食べられるだろう‥",
  "tgt": "布丁呀‥\n有{道具4F03}的话\n就能吃了吧‥"
 },
 {
  "id": "013269",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "クリームソーダだ‥\n{道具4D00}が あれば\nのめるだろう‥",
  "tgt": "是奶油苏打啊……\n要是有{道具4D00}\n就能喝了吧……"
 },
 {
  "id": "013270",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「ウチの子は、キビシく\nしつけて おるから\nマナーが、良いんじゃ‥\n---\n決して、手づかみで\n食事をしたり、せんぞ。",
  "tgt": "「我家孩子管教得\n很严，所以\n礼仪很好哟‥\n---\n绝不会用手\n抓着吃饭的。"
 },
 {
  "id": "013271",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「{队员01}様、お戻りに\nなったってねぇ‥\n---\n王様も、さぞかし およろこびに\nなったろうねぇ‥",
  "tgt": "「听说{队员01}大人\n回来了呢‥\n---\n国王也一定\n非常高兴吧‥"
 },
 {
  "id": "013272",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「ボクも‥\nおねいちんが、もどってきたら\nおよろこぶー。",
  "tgt": "「我也要‥\n姐姐回来的话\n就开心——。"
 },
 {
  "id": "013273",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「ばかね‥\nわたしは、いなくなって\nないでしょ。",
  "tgt": "「笨蛋‥\n我才没有\n不见呢。"
 },
 {
  "id": "013274",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「この近くで、ルディア兵\nらしき姿を見たよ\nいよいよ、におってきたね‥\n---\n戦のにおいだ‥",
  "tgt": "「在这附近见到了\n像是鲁迪亚兵的身影\n越来越有味道了‥\n---\n战争的气味‥"
 },
 {
  "id": "013275",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「におったのになぁ\nヘンだなぁ‥",
  "tgt": "「明明闻到了呀\n真奇怪呀‥"
 },
 {
  "id": "013276",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「{队员01}様、また\nエリーナ様を さがしに\n出て行ったらしいねぇ‥\n---\n今度こそ\n見つかるといいねぇ‥",
  "tgt": "「听说{队员01}大人\n又去找\n艾莉娜大人了‥\n---\n但愿这回\n能找到呀‥"
 },
 {
  "id": "013277",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「ボクも‥\nまた、おねいちんを\n探しに行くー",
  "tgt": "「我也要‥\n再去找\n姐姐——"
 },
 {
  "id": "013278",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「だから‥\nわたしは いなくならないって。",
  "tgt": "「所以啦‥\n我才不会不见呢。"
 },
 {
  "id": "013279",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「あーあ‥せっかく\n食器を かくしたのに‥！",
  "tgt": "「唉——‥好不容易\n藏好的餐具呀‥！"
 },
 {
  "id": "013280",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「おお、あなたがお持ちの\nそれは まさしく‥\n---\n{引2 2000}",
  "tgt": "「哦，你手里拿的\n那件正是‥‥\n---\n{引2 2000}"
 },
 {
  "id": "013281",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "そうですか、ではその‥\n---\n",
  "tgt": "是这样呀，那这件‥\n---\n"
 },
 {
  "id": "013282",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{色03}{占位00}{/色}‥！\n---\nそれを‥{色03}{占位01}{/色}\n{占位02}まいと、こうかんしては\nいただけないでしょうか？{码14000CC2}はい\nいいえ",
  "tgt": "{色03}{占位00}{/色}……！\n---\n能不能用{色03}{占位01}{/色}\n{占位02}个\n和您交换呢？{码14000CC2}是\n否"
 },
 {
  "id": "013283",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "そうですか、また食器を\n見つけた時はぜひ‥",
  "tgt": "是这样呀，再找到\n餐具时务必‥"
 },
 {
  "id": "013284",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "おお、ありがたい‥！\n---\nこれでおぼっちゃまに\nお食事を めしあがって\nいだだけます。",
  "tgt": "哦，太感谢了‥！\n---\n这样就能让\n少爷用上餐具\n用餐了。"
 },
 {
  "id": "013285",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{色03}{占位01}{/色}を\n{占位02}まい 手に入れた！",
  "tgt": "{色03}{占位01}{/色}得到了{占位02}\n"
 },
 {
  "id": "013286",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「ふあはぁ〜〜\nもっど、食ぁべたいよぉう‥！",
  "tgt": "「呼啊哈——～\n还、还想吃呀——‥！"
 },
 {
  "id": "013287",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「もう、ざいりょうが\nぜーんぶ なくなって\nしまったデスよ‥",
  "tgt": "「材料已经\n全——都\n用光了呀‥"
 },
 {
  "id": "013288",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「うう、おいたわしや\nおぼっちゃま‥\n---\n次のお食事が できるまでの\nごしんぼうです‥！",
  "tgt": "「呜呜，少爷真是\n可怜呀‥\n---\n在下次用餐之前\n就忍忍吧‥！"
 },
 {
  "id": "013289",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "ううむ、それは残念‥",
  "tgt": "唔嗯，那真遗憾‥"
 },
 {
  "id": "013290",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「あら、あなたも\nうらないに来たの？{码14010C00}はい\nいいえ",
  "tgt": "「哎呀，你也是\n来占卜的吗？{码14010C00}是\n否"
 },
 {
  "id": "013291",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「じゃあ教えてあげる、あのね\nここから 外に出た時に‥\n---\n風車の {色02}あかいハネ{/色}が\n二人の頭の上で 止まると‥\n---\nその二人は、必ず結ばれるって\n伝說があるのよー\nロマンチックでしょ？{码14020C00}はい\nいいえ",
  "tgt": "「那就告诉你吧\n从这里出去的时候……\n---\n要是风车的{色02}红翅膀{/色}\n正好停在两人头顶上……\n---\n传说这两人\n就一定会结成连理哟\n很浪漫吧？{码14020C00}是\n否"
 },
 {
  "id": "013292",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「あ、そ‥",
  "tgt": "「哦，是吗‥"
 },
 {
  "id": "013293",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「アナタ達も\nうらなってみてねー。",
  "tgt": "「你们也来\n占个卜嘛——。"
 },
 {
  "id": "013294",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「運命の人が\n見つかるといいねー。",
  "tgt": "「能找到命中注定的\n人就太好啦——。"
 },
 {
  "id": "013295",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "『ハウ トウ ユーズ ツマヨウジ』\n{码0B}{码0B}と、書かれた本がある。",
  "tgt": "有一本书，写着\n『如何使用牙签』。{码0B}{码0B}と、書かれた本がある。"
 },
 {
  "id": "013296",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "『食事からはじめる 子供のしつけ』\n{码0B}{码0B}‥本のタイトルだ。",
  "tgt": "『从吃饭开始的孩子管教』\n‥是书名。{码0B}{码0B}‥本のタイトルだ。"
 },
 {
  "id": "013297",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "本がある、タイトルは\n{码0B}{码0B}『ダイエットハード·3』‥",
  "tgt": "有一本书，书名是\n『减肥硬汉·3』‥{码0B}{码0B}『ダイエットハード·3』‥"
 },
 {
  "id": "013298",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「えっ、ウチのかみさん？\n---\nまた外で 立ち話でも\nしてるんじゃ ないかなあ？",
  "tgt": "「诶，我家那位？\n---\n是不是又在外面\n站着聊天呢呀？"
 },
 {
  "id": "013299",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「{队员01}様も\nエリーナ様も‥\n---\n早く お城に戻って\n王様を、安心させて\nあげて欲しいねぇ‥",
  "tgt": "「{队员01}大人和\n艾莉娜大人‥\n---\n真希望他们快点\n回到王城\n让国王安心呀‥"
 },
 {
  "id": "013300",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0202}「くーっ、他の商人に\n先こされてもうた‥",
  "tgt": "{立绘0202}「哼——，被别的商人\n抢先一步啦‥"
 },
 {
  "id": "013301",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "「うちの おとうと\n見ませんでした‥？\n---\nわたしが おつかいに\n行ってる間に\nいなく なっちゃって‥",
  "tgt": "「见到我弟弟\n了吗？\n---\n我去跑腿的工夫\n他就\n不见了‥"
 },
 {
  "id": "013302",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}モモ\n「ねえねえ‥\n---\nなんで、わたしって\nこんな所に いるのかなぁ‥\n---\n部屋で 実驗してて\n爆発した ところまでは\n覺えてるんだけどー‥‥\n---\n‥{码0B}‥{码0B}‥ま、いっか。\n---\nところで、あなた達‥\nわたしの 話しあいてに\nならないー？{码14820C92}なってみようかな\nやめておきます",
  "tgt": "{立绘0000}桃桃\n「呐呐……\n---\n我为什么会\n在这种地方呢……\n---\n在房间里做实验\n然后爆炸了\n我记得到这里为止……\n---\n……{码0B}……{码0B}……算了。\n---\n话说，你们……\n愿意听\n我说话吗——？{码14820C92}当你的听众吧\n不必了"
 },
 {
  "id": "013303",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}ありがとうー‥！\n---\nわたし、こう見えても\nけっこう、旅したり\nしてるからー‥\n---\n色々、役に立つ話も\nできると思うのー‥\n---\nで、{码0B}とりあえずは この\n{色04}のんびり{/色}を\n教えてあげる。\n---\nこれで少しは\nリラックスしてみてー。",
  "tgt": "{立绘0000}谢谢——！\n---\n我别看这样\n其实也去过\n不少地方——……\n---\n我想有用的闲谈\n我也能讲不少——……\n---\n那{码0B}就先教给你\n{色04}悠闲{/色}\n吧。\n---\n试着用这个\n放松放松——。"
 },
 {
  "id": "013304",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}「じゃあ、またー‥\nひまな時にでも 来てね。\n---\n他に何か 教えられる事が\nあったら‥\n---\n教えてあげるわ。",
  "tgt": "{立绘0000}「那么，再见——……\n有空再来玩啊。\n---\n要是还有\n什么能教你的……\n---\n我会教给你的。"
 },
 {
  "id": "013305",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}「あ、{码0B}そう‥\n---\nま、いっか‥\nまた遊びに来てねー。",
  "tgt": "{立绘0000}「啊，{码0B}这样……\n---\n算了……\n再来玩哟——。"
 },
 {
  "id": "013306",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}ばいばい。",
  "tgt": "{立绘0000}拜拜。"
 },
 {
  "id": "013307",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}モモ\n「あ、来てくれたのー‥\n---\nちょうど ヒマだったし\nうれしいわねー。",
  "tgt": "{立绘0000}桃桃\n「啊，你来啦——……\n---\n正好闲着呢\n真开心——。"
 },
 {
  "id": "013308",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}そういえば‥\nこんな技、知ってるー？\n---\n‥{码0B}‥{码0B}‥{码0B}って\n知ってるワケ、ないか。\n---\nじゃ、はい！\nこの、{色03}{占位01}{/色}を\n教えてあげる。",
  "tgt": "{立绘0000}说起来……\n这样的技艺，你知道吗——？\n---\n……{码0B}……{码0B}……{码0B}也\n对哦，你不可能知道。\n---\n那，给你！\n这招{色03}{占位01}{/色}\n教给你。"
 },
 {
  "id": "013309",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}ひまな時にでも、また\n会いに来てよ‥\n---\n他にも、何かあったら\n教えてあげるー。",
  "tgt": "{立绘0000}有空的时候\n再来找我玩啊……\n---\n要是还有别的什么\n我再教你——。"
 },
 {
  "id": "013310",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}どうも、あなた達に\n教えられるものは‥\n---\n全部、教えちゃったみたいー。\n---\n‥{码0B}‥{码0B}‥それなりに\n楽しかったわよー。\n---\n何か、師匠にでも\nなったみたいでー！",
  "tgt": "{立绘0000}看来能教给\n你们的东西……\n---\n好像\n全教完了——。\n---\n……{码0B}……{码0B}……还挺\n开心的哟——。\n---\n感觉就像\n当了回师父——！"
 },
 {
  "id": "013311",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}今日はどうするのー？{码14820C93}教えてください\nいいです\n何でもないです",
  "tgt": "{立绘0000}今天怎么样——？{码14820C93}请教我\n不用了\n没什么事"
 },
 {
  "id": "013312",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}ほかにはー？{码14820C93}教えてください\nいいです\n何でもないです",
  "tgt": "{立绘0000}还有别的吗——？{码14820C93}请教我\n不用了\n没什么事"
 },
 {
  "id": "013313",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}‥新しく教える人は\nいないみたいよ。",
  "tgt": "{立绘0000}……看来\n没有新的人要教哟。"
 },
 {
  "id": "013314",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}‥じゃ、{占位02}に\nこの {色04}のんびり{/色}を\n教えてあげるね。",
  "tgt": "{立绘0000}……那就教{占位02}\n这招{色04}悠闲{/色}\n吧。"
 },
 {
  "id": "013315",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}じゃ、あなたたちに\nこの {色04}のんびり{/色}を\n教えてあげるね。",
  "tgt": "{立绘0000}那就教你们\n这招{色04}悠闲{/色}\n吧。"
 },
 {
  "id": "013316",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}‥なによー？",
  "tgt": "{立绘0000}……怎么啦——？"
 },
 {
  "id": "013317",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}‥あれー？\n---\nわたし、誰かに何か\n教えてたっけ‥？",
  "tgt": "{立绘0000}……咦——？\n---\n我是不是\n教过谁\n什么东西来着……？"
 },
 {
  "id": "013318",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}‥じゃ、{占位02}は\nやめちゃうのねー。",
  "tgt": "{立绘0000}……那\n{占位02}就\n不学了吗——。"
 },
 {
  "id": "013319",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}‥じゃ あなたたち\nやめちゃうのねー。",
  "tgt": "{立绘0000}……那你们\n就不学了吗——。"
 },
 {
  "id": "013320",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}‥なによー？",
  "tgt": "{立绘0000}……怎么啦——？"
 },
 {
  "id": "013321",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}なんだか、わたしって\n場違いじゃ なーい？\n---\nどーも、違う世界に\n迷いこんだような\n気がするのよねー‥",
  "tgt": "{立绘0000}总觉得\n我是不是\n很格格不入——？\n---\n总觉得像是\n误入了\n别的世界似的——……"
 },
 {
  "id": "013322",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "{立绘0000}モモ\n「‥‥なーに？\n---\n道先を知りたいなら\nたぶんわたしの方が\nわからないわよー。",
  "tgt": "{立绘0000}桃桃\n「……什——么？\n---\n要是想问路的话\n多半我\n比你们还不认路哟——。"
 },
 {
  "id": "013323",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "25",
  "tgt": "25"
 },
 {
  "id": "013324",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "30",
  "tgt": "30"
 },
 {
  "id": "013325",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "40",
  "tgt": "40"
 },
 {
  "id": "013326",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "50",
  "tgt": "50"
 },
 {
  "id": "013327",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "スプレー",
  "tgt": "喷雾"
 },
 {
  "id": "013328",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "草むしり",
  "tgt": "拔草"
 },
 {
  "id": "013329",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "オラクル",
  "tgt": "神谕"
 },
 {
  "id": "013330",
  "file": "WORLD/AREAS002.EMI",
  "seg": 11,
  "src": "からにこもる",
  "tgt": "藏入壳中"
 },
 {
  "id": "013331",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "さらいしつない\n---\n001の0やど\n001の2さかば\n004の0さかばウラ\n004の1そうこ\n004の2みんか",
  "tgt": "萨莱室内\n---\n001之0旅店\n001之2酒馆\n004之0酒馆后\n004之1仓库\n004之2民宅"
 },
 {
  "id": "013332",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「酒場ってのは\n色んなウワサが\n闻けるからね‥\n---\n何か 知りたい事があれば\nここの連中と 話すのが\nいいかもよ。",
  "tgt": "「酒馆这种地方\n能听到\n各种传闻‥\n---\n有什么想知道的事\n跟这里的家伙们\n聊聊也许有用哟。"
 },
 {
  "id": "013333",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0000}「‥で、その穴の底に\n何がいたって？\n---\n{立绘FFFF}{立绘8141}「すっげぇバケモノさ！\nそこらのモンスターとは\nわけがちがうぜ！\n---\nありゃ、きっと\n何か悪い 前ぶれだぜ！",
  "tgt": "{立绘0000}「……然后，那个洞底\n有什么来着？\n---\n{立绘FFFF}{立绘8141}「是个超大的怪物！\n跟一般的魔物\n完全不一样！\n---\n那玩意儿\n肯定是\n什么凶兆！"
 },
 {
  "id": "013334",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0101}「ここへ来る とちゅうに\nすっげぇ大きな\n穴ボコが あってね‥\n---\n{立绘FFFF}{立绘8040}「‥そこに 落っこちて\n荷物を 無くしたんだろ？",
  "tgt": "{立绘0101}「来这儿的路上\n有个超大的\n大坑洞呢‥\n---\n{立绘FFFF}{立绘8040}「‥你是掉进去\n弄丢了行李吧？"
 },
 {
  "id": "013335",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「いらっしゃい、旅の人\nサライへは はじめて？",
  "tgt": "「欢迎光临，旅行的人\n是头一次来萨莱？"
 },
 {
  "id": "013336",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0202}「がふがふがふ‥",
  "tgt": "{立绘0202}「嘎夫嘎夫嘎夫‥"
 },
 {
  "id": "013337",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「この町の連中は\nすぐ お金をたかるから\n気をつけた方が、いいわよ。",
  "tgt": "「这镇上的家伙们\n动不动就讨钱\n还是当心点好哟。"
 },
 {
  "id": "013338",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「何か、探しものなら‥\n---\nここの連中に\n酒でも おごって\n闻いてみれば？",
  "tgt": "「要找什么东西的话‥\n---\n请这里的家伙们\n喝点酒\n再打听打听如何？"
 },
 {
  "id": "013339",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0303}「は？ 砂船の部品？\n知らないよ‥\n---\nこっちは、見てのとおり\n酒場だからねぇ‥",
  "tgt": "{立绘0303}「哈？沙船零件？\n不知道哟‥\n---\n你看，这里\n是酒馆嘛‥"
 },
 {
  "id": "013340",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「戦爭は、今\nお休みなんだってねぇ‥\n---\nまた始まったら\nヤダねぇ‥",
  "tgt": "「听说战争现在\n休战中呢‥\n---\n要再打起来\n可就讨厌啦‥"
 },
 {
  "id": "013341",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「この町の 近所で\n帝国のやつらを見たって\n話があるんだ‥\n---\nまた、戦爭でも\nおっぱじめる気かな‥",
  "tgt": "「听说有人在\n这镇子附近见过\n帝国的家伙‥\n---\n该不会又想\n挑起战争吧‥"
 },
 {
  "id": "013342",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「何か、探してるんなら\n酒場で話を闻くのがいいけど‥\n---\n女の子には、ちょっと\nムズかしいかなぁ‥",
  "tgt": "「要找什么的话\n在酒馆打听是好办法\n---\n不过对女孩子来说\n有点难开口吧‥"
 },
 {
  "id": "013343",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「あら‥、女の子ちゃんが\n酒場に来るなんて\nめずらしい。",
  "tgt": "「哎呀‥，小姑娘\n来酒馆\n可真稀奇。"
 },
 {
  "id": "013344",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0303}「何だか知らんが‥\n---\nあんたの探してる\nようなものは‥\n---\nここには ないよ\nおじょうさん‥",
  "tgt": "{立绘0303}「不知怎么的‥\n---\n像你要找的\n那种东西‥\n---\n这儿可没有哟\n小姑娘‥"
 },
 {
  "id": "013345",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0404}「‥て言うか、お買い得\n{色03}お宝{/色}は いらない？\n---\n{金钱00}たったの158ゼニー！{码14000C82}買う\n買わない",
  "tgt": "{立绘0404}「……话说，超值的\n{色03}宝物{/色}\n不要吗？\n---\n{金钱00}只要158泽尼！{码14000C82}买\n不买"
 },
 {
  "id": "013346",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0404}「まいどあり！\n---\nこれって ぜったい\nボッたくりじゃないよ！",
  "tgt": "{立绘0404}「多谢惠顾！\n---\n这可绝对\n不是宰客哟！"
 },
 {
  "id": "013347",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0404}「ホント、お買い得なのに‥",
  "tgt": "{立绘0404}「真的很划算的说‥"
 },
 {
  "id": "013348",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0404}「‥って言うか\nお金、足りないよ。",
  "tgt": "{立绘0404}「‥话说回来\n钱，不够哟。"
 },
 {
  "id": "013349",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「探してる物は\n見つかったかい？",
  "tgt": "「要找的东西\n找到了吗？"
 },
 {
  "id": "013350",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0000}「やっと戦爭が\nなくなった‥ってのに\nエンギでもねぇな‥\n---\n{立绘FFFF}{立绘8141}「穴の底にいたんだ‥\n---\n世界を 滅ぼすみたいな\nすげぇ バケモノが‥",
  "tgt": "{立绘0000}「好不容易\n战争刚结束……\n真不吉利啊……\n---\n{立绘FFFF}{立绘8141}「就在洞底……\n---\n那怪物大得\n好像能毁灭世界……"
 },
 {
  "id": "013351",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0101}「それにしても‥\n穴に落としてきた\n荷物が‥‥\n---\n{立绘FFFF}{立绘8040}「どうせ、{道具1502}か\n何かだろ‥",
  "tgt": "{立绘0101}「话说回来‥\n掉进坑里弄丢的\n行李‥‥\n---\n{立绘FFFF}{立绘8040}「反正是{道具1502}\n什么的吧‥"
 },
 {
  "id": "013352",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「そこの 商人さん‥\n---\nどこかで 荷物を\n落として来たんだって‥！",
  "tgt": "「那边的商人‥\n---\n听说在哪儿\n弄丢了行李‥！"
 },
 {
  "id": "013353",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0202}「また食うぞ‥\nがふがふがふ",
  "tgt": "{立绘0202}「还要吃哟\n嘎夫嘎夫嘎夫"
 },
 {
  "id": "013354",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「ま、戦爭とちがって\nたかられた ぐらいじゃ\n死なないから、いいわね。",
  "tgt": "「嘛，跟战争不一样\n被敲诈点钱\n又死不了人，还好啦。"
 },
 {
  "id": "013355",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「あの じいさん‥\nずっと ここにいて\n何か食ってるから‥\n---\nその分、いろんなウワサ話\n闻いてるんだよ‥",
  "tgt": "「那老爷子‥\n一直待在这儿\n吃东西‥\n---\n所以也听了\n各种传闻哟‥"
 },
 {
  "id": "013356",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0303}「ここは、酒場だよ\nあんたらが 探してるような‥",
  "tgt": "{立绘0303}「这里是酒馆哟\n你们要找的那种东西‥"
 },
 {
  "id": "013357",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0303}「なんだ、知ってたのか‥\nじゃ、しょうがない。",
  "tgt": "{立绘0303}「怎么，早知道呀‥\n那，没办法了。"
 },
 {
  "id": "013358",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0303}「おくへどうぞ‥",
  "tgt": "{立绘0303}「请进里面吧‥"
 },
 {
  "id": "013359",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0303}「ヤバイ物を 商売するには\n注意しないとね。",
  "tgt": "{立绘0303}「做危险买卖\n可得当心点呀。"
 },
 {
  "id": "013360",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0505}「なぜ こんなに\n回りくどい事を するのかと\n言うと‥‥",
  "tgt": "{立绘0505}「要说为什么\n做得如此\n拐弯抹角‥‥"
 },
 {
  "id": "013361",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框05}{立绘0505}「砂船を 商売するのが\n危険だからだ‥",
  "tgt": "{框05}{立绘0505}「因为买卖沙船\n是危险行当‥"
 },
 {
  "id": "013362",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框05}{立绘0505}「砂船は、もともと\n戦爭の道具だ‥\n---\nそんな物を 売ってるのが\n帝国に バレたら‥\n---\nまた、戦爭になった時\n狙われてしまう‥",
  "tgt": "{框05}{立绘0505}「沙船本就是\n战争的道具‥\n---\n卖这种东西\n一旦被帝国发现‥\n---\n等战争再起\n就会成为眼中钉‥"
 },
 {
  "id": "013363",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框05}{立绘0505}「チャンバや‥\nセネスタの町みたいに‥\n---\n町ごと 呪いの底に\n沈められるのは ゴメンだ。",
  "tgt": "{框05}{立绘0505}「我可不想像占巴‥\n塞内斯塔镇那样‥\n---\n整座镇子被咒沉到\n诅咒的底下去。"
 },
 {
  "id": "013364",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「では、砂船の部品は\n無いんですか！？",
  "tgt": "{框06}{立绘C140}「那，沙船的零件\n是没有吗！？"
 },
 {
  "id": "013365",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框05}{立绘0505}「いや、そうじゃない‥\n---\nこの近くに、{色02}砂船の谷{/色}と\n呼ばれる場所がある‥\n---\nこわれた船の\n捨て場なんだが‥",
  "tgt": "{框05}{立绘0505}「不，不是那个……\n---\n这附近有个地方\n叫{色02}沙船谷{/色}……\n---\n是丢弃\n破船的地方……"
 },
 {
  "id": "013366",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框05}{立绘0505}「まず、そこへ行って\n使えそうな ざいりょうを\n探してくれば‥\n---\n部品を 作ってやろう。\n分かったかね‥？",
  "tgt": "{框05}{立绘0505}「先去那里\n找找能用的\n材料回来‥\n---\n我就给你们做零件。\n明白了吗‥？"
 },
 {
  "id": "013367",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「{色02}砂船の谷{/色}ですね‥\n分かりました！",
  "tgt": "{框06}{立绘C140}「是{色02}沙船谷{/色}吧……\n明白了！"
 },
 {
  "id": "013368",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0505}「用心ぶかくないと\nこの商売は できんよ‥",
  "tgt": "{立绘0505}「不多加小心\n这买卖可做不得哟‥"
 },
 {
  "id": "013369",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0606}「谷は、町を出て\n南の方だぜ‥",
  "tgt": "{立绘0606}「山谷在出镇后\n往南的方向哟‥"
 },
 {
  "id": "013370",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「やっぱり、また\n戦爭かねぇ‥ やだやだ。",
  "tgt": "「果然又要\n打仗了吗‥讨厌讨厌。"
 },
 {
  "id": "013371",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "「帝国兵が この町にも\n現れたらしいな‥",
  "tgt": "「听说帝国兵\n连这镇子都出现了呀‥"
 },
 {
  "id": "013372",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框06}{立绘8141}「{特效}て{码0E}{/特效}",
  "tgt": "{框06}{立绘8141}「说{特效}て{码0E}{/特效}"
 },
 {
  "id": "013373",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框03}{立绘0707}「何も、ムズかしい事じゃ\nないのよ‥\n---\nアナタが 見たって言う\nその、バケモノの事を‥\n---\nくわしく教えて欲しいだけ。",
  "tgt": "{框03}{立绘0707}「这可不是什么\n难事哟‥\n---\n只是想请你详细讲讲\n你见到的\n---\n那怪物的事而已。"
 },
 {
  "id": "013374",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框04}{立绘8141}「へっ‥‥\n---\nおめぇらに 教える事なんざ\n何もないねッ！",
  "tgt": "{框04}{立绘8141}「哼‥‥\n---\n才没什么\n好告诉你们的呢！"
 },
 {
  "id": "013375",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框03}{立绘0707}「あらあら‥{码0B}‥\n---\nイケませんよ\nそんな態度を とってると‥",
  "tgt": "{框03}{立绘0707}「哎呀呀‥‥\n---\n摆出这种态度\n可不行哟‥{码0B}‥\n---\nイケませんよ\nそんな態度を とってると‥"
 },
 {
  "id": "013376",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框0B}{立绘0707}「‥{码0B}‥イタイ思いを\nするんですよ。",
  "tgt": "{框0B}{立绘0707}「‥‥会让你\n吃苦头的哟。{码0B}‥イタイ思いを\nするんですよ。"
 },
 {
  "id": "013377",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框0C}{立绘8808}「何してるんです！？",
  "tgt": "{框0C}{立绘8808}「您在干什么！？"
 },
 {
  "id": "013378",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框06}{立绘8948}「ど、{码0B}どうして こんな\nらんぼうな事を‥！？\n---\n戦爭も終わったって\n言うのに‥！",
  "tgt": "{框06}{立绘8948}「为，为什么这么\n蛮不讲理‥！？\n---\n战争不是\n都结束了吗‥！{码0B}どうして こんな\nらんぼうな事を‥！？\n---\n戦爭も終わったって\n言うのに‥！"
 },
 {
  "id": "013379",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框05}{立绘0707}「すなおじゃ、ないからよ\nそれに‥‥",
  "tgt": "{框05}{立绘0707}「都怪你不肯老实\n而且‥‥"
 },
 {
  "id": "013380",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框03}{立绘0707}「戦爭は、{色02}終わった{/色}んじゃ\nないのよ‥\n---\n{色02}一時休戦{/色}ってヤツなの‥\n---\n分かる？ おじょうさ‥",
  "tgt": "{框03}{立绘0707}「战争可\n没有{色02}结束{/色}哦……\n---\n只是{色02}暂时休战{/色}……\n---\n明白吗？小姑娘……"
 },
 {
  "id": "013381",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框03}{立绘0707}「あなた‥、{码0B}ウインディアの‥\n---\n{立绘0A09}「あらあら、いもうとの方ね！",
  "tgt": "{框03}{立绘0707}「你是‥，温迪亚的‥\n---\n{码0B}「哎呀呀，是妹妹那边呀！{立绘0A09}「あらあら、いもうとの方ね！"
 },
 {
  "id": "013382",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框03}{立绘0707}「竜を探してて‥\nおもしろいモノに\n出くわしたわ‥‥\n---\n{立绘0A09}「これは、おさえといて\nソンはないわね！",
  "tgt": "{框03}{立绘0707}「我正在找龙‥\n碰上了有趣的\n东西‥‥\n---\n{立绘0A09}「这个先收好\n不亏的哟！"
 },
 {
  "id": "013383",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框06}{立绘C140}「ちょ、ちょっと\n待って下さい‥\n---\n姉さまのこと、何か‥",
  "tgt": "{框06}{立绘C140}「请，请等\n一下‥\n---\n您知道我姐姐的‥"
 },
 {
  "id": "013384",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框03}{立绘0707}「我が名において\n命ずる‥\n---\n出でよ、鉄鬼！",
  "tgt": "{框03}{立绘0707}「以吾之名\n下令‥\n---\n出来吧，铁鬼！"
 },
 {
  "id": "013385",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框03}{立绘0707}「ジョよ‥\nその娘を 捕らえなさい\n---\n‥殺さないでね。",
  "tgt": "{框03}{立绘0707}「乔哟‥\n把那丫头抓起来\n---\n‥可别杀了她呢。"
 },
 {
  "id": "013386",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框03}{立绘0707}「まー‥\n意外とやるのね！",
  "tgt": "{框03}{立绘0707}「嘛～‥\n意外地能干呢！"
 },
 {
  "id": "013387",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框03}{立绘0707}「あらあら‥\nナイトのお出まし‥？",
  "tgt": "{框03}{立绘0707}「哎呀呀‥\n骑士大人驾到‥？"
 },
 {
  "id": "013388",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框03}{立绘0707}「ナイトだったら‥\nおひめさまを\n守らないとねー‥\n---\n{立绘0A09}「今ごろ出てきて\nふるえてるようじゃ‥",
  "tgt": "{框03}{立绘0707}「身为骑士‥\n就该守护好\n公主大人呀——‥\n---\n{立绘0A09}「这时候才出来\n还瑟瑟发抖呢‥"
 },
 {
  "id": "013389",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框03}{立绘0707}「き‥、{码0B}{码0B}きさまーっ！",
  "tgt": "{框03}{立绘0707}「你‥，你这家伙——！{码0B}{码0B}きさまーっ！"
 },
 {
  "id": "013390",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框04}{立绘8948}「に、{码0B}{特效}にげましょう··{码0E}{/特效}{占位00}",
  "tgt": "{框04}{立绘8948}「快，快逃吧··{码0B}{特效}にげましょう··{码0E}{/特效}{占位00}"
 },
 {
  "id": "013391",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框05}{立绘0707}「何してる！？\n追わんかっ！！",
  "tgt": "{框05}{立绘0707}「在干什么！？\n快追呀！！"
 },
 {
  "id": "013392",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0202}「がふがふがふ‥\n---\nん‥\n何か 闻きたいのか？",
  "tgt": "{立绘0202}「嘎夫嘎夫嘎夫‥\n---\n嗯‥\n想打听什么？"
 },
 {
  "id": "013393",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0202}「ふーん、がふがふ\n---\nまあ、それなら‥\n人に物を たずねる\n態度ってモンが、あるじゃろ？{码14010C92}ごちそうします\n何のことでしょう？",
  "tgt": "{立绘0202}「哦～，嘎夫嘎夫\n---\n嘛，那样的话‥\n求人办事\n总得有求人的态度吧？请客\n什么事呢？{码14010C92}ごちそうします\n何のことでしょう？"
 },
 {
  "id": "013394",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0202}「れいぎが なっとらんな\nがふがふがふん。",
  "tgt": "{立绘0202}「礼数都不懂呀\n嘎夫嘎夫嘎夫。"
 },
 {
  "id": "013395",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0202}「お！ オゴってくれるのか？\n---\n悪いのー‥\nサイソクした みたいで！",
  "tgt": "{立绘0202}「哦！要请客吗？\n---\n真不好意思——‥\n是我误会你了！"
 },
 {
  "id": "013396",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框21}食事とお酒をふるまって\nオヤジさんを{色02}滿足{/色}させます\n---\n食事は {色03}滿腹{/色}と{色02}滿足{/色}が\nお酒は {色03}醉い{/色}と{色02}滿足{/色}が\nそれぞれ 上がります\n---\n{色02}滿足{/色}より先に {色03}醉い{/色}と{色03}滿腹{/色}が\nMAXにならないように\nふるまって下さい\n---\nおなじ物ばかり\nふるまっていると\n---\n{色02}滿足{/色}が 上がりにくく\nなってくるので注意！\n---\n\n  もう一度、說明を讀みますか？{码14020C82}はい\nいいえ",
  "tgt": "{框21}请客人吃饭喝酒\n让大叔感到{色02}满足{/色}\n---\n吃饭会提升{色03}饱腹{/色}与{色02}满足{/色}\n喝酒会提升{色03}醉意{/色}与{色02}满足{/色}\n分别提升\n---\n但别让{色03}醉意{/色}和{色03}饱腹{/色}\n抢在{色02}满足{/色}之前\n达到MAX\n---\n要是总请同一种\n东西的话……\n---\n{色02}满足{/色}就会\n越来越难提升，注意！\n---\n\n  要再读一遍说明吗？{码14020C82}是\n否"
 },
 {
  "id": "013397",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "    操作の說明",
  "tgt": "操作说明"
 },
 {
  "id": "013398",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0202}「‥{码0B}‥{码0B}‥\n---\n{特效}げっふーん{码0E}{/特效}{道具0113}ふ足じゃわい！\n---\nよーし、では 教えよう\n探し物なら‥\n---\n宿屋の前に 情報屋の男が\nいるはずだから\nそいつに 闻くんじゃ！\n---\nげふ。",
  "tgt": "{立绘0202}「‥‥‥\n---\n嗝——{码0B}呼痛快呀！\n---\n好——，那就告诉你吧\n要找东西的话‥\n---\n旅店门前应该站着\n一个情报屋男\n去问他吧！\n---\n嗝。{码0B}‥\n---\n{特效}げっふーん{码0E}{/特效}{道具0113}ふ足じゃわい！\n---\nよーし、では 教えよう\n探し物なら‥\n---\n宿屋の前に 情報屋の男が\nいるはずだから\nそいつに 闻くんじゃ！\n---\nげふ。"
 },
 {
  "id": "013399",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0202}「{特效}う{码0E}{/特效}\n---\n\n---\nく、食いすぎて\n腹が‥‥\n---\n腹が、い{码0B}た{码0B}い‥",
  "tgt": "{立绘0202}「呜\n---\n\n---\n吃，吃得太多\n肚子‥‥\n---\n肚子，疼了‥{特效}う{码0E}{/特效}\n---\n\n---\nく、食いすぎて\n腹が‥‥\n---\n腹が、い{码0B}た{码0B}い‥"
 },
 {
  "id": "013400",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0202}「{特效}ううぇえ〜〜い！\nぃ醉っぱ‥らっっ\nちった、よ〜〜〜〜い！{码0E}{/特效}\n",
  "tgt": "{立绘0202}「呜诶————！\n醉醉醉醉醉醉‥醉了\n倒喽，喽————！\n{特效}ううぇえ〜〜い！\nぃ醉っぱ‥らっっ\nちった、よ〜〜〜〜い！{码0E}{/特效}\n"
 },
 {
  "id": "013401",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0202}「がふがふ‥ お！？\n---\nまた何か オゴって\nくれるのかい？{码14010C82}はい\nいいえ",
  "tgt": "{立绘0202}「嘎夫嘎夫‥哦！？\n---\n又要请我\n吃什么吗？好\n不要{码14010C82}はい\nいいえ"
 },
 {
  "id": "013402",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0202}「おお、そうかい！\nそれじゃ さっそく‥",
  "tgt": "{立绘0202}「哦哦，是吗！\n那就马上开始‥"
 },
 {
  "id": "013403",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{框21}\n   操作の說明を讀みますか？{码14020C82}はい\nいいえ",
  "tgt": "{框21}\n要阅读操作说明吗？是\n否{码14020C82}はい\nいいえ"
 },
 {
  "id": "013404",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0202}「がふがふがっふん‥\n---\nオゴる気に なったか？{码14010C82}はい\nいいえ",
  "tgt": "{立绘0202}「嘎夫嘎夫嘎夫‥\n---\n想请客了吗？好\n不要{码14010C82}はい\nいいえ"
 },
 {
  "id": "013405",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0202}「ふーん‥\n---\n人に 物をたずねる態度が\nなっちょらんね！",
  "tgt": "{立绘0202}「哼～‥\n---\n求人的态度\n实在差劲呢！"
 },
 {
  "id": "013406",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0202}「お‥、情報屋には\n会ったのか？\n---\nやつは、宿屋の前に\n立ってるハズじゃ‥",
  "tgt": "{立绘0202}「哦‥，见到\n情报屋了吗？\n---\n那家伙应该\n站在旅店门前‥"
 },
 {
  "id": "013407",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{立绘0202}「それにしても\nアンタの オゴりっぷり‥\n---\nまったく、若いのに\n大したもんじゃ‥！\n---\n気に入ったから\nコイツを やるわい！",
  "tgt": "{立绘0202}「话说回来\n你这请客的气派‥\n---\n年纪轻轻\n真不简单呀‥！\n---\n我喜欢你\n这家伙就送你了！"
 },
 {
  "id": "013408",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "\n{色03}{占位00}{/色}を 手に入れた！",
  "tgt": "\n得到了{色03}{占位00}{/色}！"
 },
 {
  "id": "013409",
  "file": "WORLD/AREAS004.EMI",
  "seg": 11,
  "src": "{色03}滿腹{/色}",
  "tgt": "{色03}饱腹{/色}"
 },
