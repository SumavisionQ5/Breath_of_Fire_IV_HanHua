  "tgt": "取消"
 },
 {
  "id": "017279",
  "file": "WORLD/D141BTL.EMI",
  "seg": 5,
  "src": "アイテムを 買います",
  "tgt": "购买道具"
 },
 {
  "id": "017280",
  "file": "WORLD/D141BTL.EMI",
  "seg": 5,
  "src": "装備を 買います",
  "tgt": "购买装备"
 },
 {
  "id": "017281",
  "file": "WORLD/D141BTL.EMI",
  "seg": 5,
  "src": "持ち物を 売ります",
  "tgt": "出售随身物品"
 },
 {
  "id": "017282",
  "file": "WORLD/D141BTL.EMI",
  "seg": 5,
  "src": "装備を 下取りします",
  "tgt": "装备以旧换新"
 },
 {
