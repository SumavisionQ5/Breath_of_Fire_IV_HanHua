  "id": "002831",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "ゲームの設定を へんこうします",
  "tgt": "更改游戏设置"
 },
 {
  "id": "002832",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "コントローラの設定を へんこうします\n>現在の設定は タイプ{占位00}です",
  "tgt": "更改手柄设置\n>当前设置为类型{占位00}"
 },
 {
  "id": "002833",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "画面ポジションを 調整します",
  "tgt": "调整画面位置"
 },
 {
  "id": "002834",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "すべての設定を 初期状態に戻します\n>ボタン設定、スクリーンも初期状態に戻ります",
  "tgt": "将所有设置恢复初始状态\n>按键设置、屏幕也会恢复初始"
 },
 {
  "id": "002835",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "すべての設定を 初期化してよろしいですか",
  "tgt": "确定初始化所有设置吗"
 },
 {
  "id": "002836",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "振動機能の ON/OFFができます\n>振動機能はデュアルショックでお楽しみください",
  "tgt": "可开关震动功能\n>震动功能需用双震手柄体验"
 },
 {
  "id": "002837",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "ダッシュボタンを押して走るか、步くかを選べます\n>アナログモードでも ゆうこうです",
  "tgt": "可选择按冲刺键奔跑还是步行\n>模拟模式下同样有效"
 },
 {
  "id": "002838",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "カメラがまわる方向を へんこうします",
  "tgt": "更改镜头转动方向"
 },
 {
  "id": "002839",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "方向キー上下左右でななめ移動に設定できます\n>フィールド移動のみ ゆうこうです",
  "tgt": "可设方向键斜向移动\n>仅原野移动时有效"
 },
 {
  "id": "002840",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "メッセージスピードを へんこうします",
  "tgt": "更改文字速度"
 },
 {
  "id": "002841",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
  "src": "サウンド設定を へんこうします",
  "tgt": "更改音效设置"
 },
 {
  "id": "002842",
  "file": "SYSTEM/SGAMEN.EMI",
  "seg": 9,
