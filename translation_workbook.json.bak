 },
 {
  "id": "009480",
  "file": "WORLD/AREAE033.EMI",
  "seg": 9,
  "src": "何も、ないようだ‥",
  "tgt": "似乎，什么都没有‥"
 },
 {
  "id": "009481",
  "file": "WORLD/AREAE033.EMI",
  "seg": 9,
  "src": "「船にもどりますか？{码1400775F}\nいいえ",
  "tgt": "「要回船上吗？{码1400775F}\n否"
 },
 {
  "id": "009482",
  "file": "WORLD/AREAE033.EMI",
  "seg": 9,
  "src": "‥それから、しばらく",
  "tgt": "‥在那之后，有一阵子"
 },
 {
  "id": "009483",
  "file": "WORLD/AREAE033.EMI",
  "seg": 9,
  "src": "わたし達の 船の旅は",
  "tgt": "我们的海上航行"
 },
 {
  "id": "009484",
  "file": "WORLD/AREAE033.EMI",
  "seg": 9,
  "src": "何事もなく 續きました。",
  "tgt": "平安无事地继续着。"
 },
 {
  "id": "009485",
  "file": "WORLD/AREAE033.EMI",
  "seg": 9,
  "src": "{框22}\n      船の動かし方{码14010C15}風向きと、船のすすむ方向\n風のよみ方\nしょくりょうについて\nたんさくについて\n說明の終了",
  "tgt": "{框22}\n船的驾驶方式风向与船行方向\n读风的方法\n关于食物\n关于探险\n说明结束{码14010C15}風向きと、船のすすむ方向\n風のよみ方\nしょくりょうについて\nたんさくについて\n說明の終了"
 },
 {
  "id": "009486",
  "file": "WORLD/AREAE033.EMI",
  "seg": 9,
  "src": "{框22}{色0A}×{/色}ボタンで 『ほ』を上げると\n船は、風下に向かいます。\n---\n方向キーを使って、船の向きを\n変える事ができますが\n風上には、すすめません。\n---\n{色0A}○{/色}ボタンを押して\n船を こぐ事もできます。\n---\n{引2 1300}",
  "tgt": "{框22}{色0A}按×键升起「帆」\n船便会驶向下风处。\n---\n可用方向键改变\n船的方向\n但无法逆风前行。\n---\n按○键\n也可以划船。\n---\n{/色}ボタンで 『ほ』を上げると\n船は、風下に向かいます。\n---\n方向キーを使って、船の向きを\n変える事ができますが\n風上には、すすめません。\n---\n{色0A}○{/色}ボタンを押して\n船を こぐ事もできます。\n---\n{引2 1300}"
 },
 {
  "id": "009487",
  "file": "WORLD/AREAE033.EMI",
  "seg": 9,
  "src": "{框22}画面右上の やじるしは\n風の向きと、強さを あらわします。\n---\n次にふく風の よそうが、となりに\n出ているので‥\n---\n自分の行きたい方向の風が\nふきはじめるまで‥\n---\n『ほ』をはらずに、風を待つのも\nひとつのコツです。\n---\n{引2 1300}",
  "tgt": "{框22}画面右上方的箭头\n表示风的方向与强弱。\n---\n旁边显示着\n下一阵风的预测‥\n---\n在吹起想去的\n方向的风之前‥\n---\n不升帆等风来\n也是诀窍之一。\n---\n{引2 1300}"
 },
 {
  "id": "009488",
  "file": "WORLD/AREAE033.EMI",
  "seg": 9,
  "src": "{框22}画面下のバーは、船の食べ物を\nあらわしています。\n---\n時間がたつごとに、食ベ物は減り‥\n---\nこれがなくなると、船は自動的に\n港へ戻されます。\n---\nまた、{色0A}○{/色}ボタンで、こぐと\nたくさん食べ物を 使います。\n---\n{引2 1300}",
  "tgt": "{框22}画面下方的槽\n表示船上的食物。\n---\n随时间流逝，食物会减少‥\n---\n耗尽后，船会自动\n被送回港口。\n---\n另外，按○键划船\n会消耗大量食物。\n---\n{色0A}○{/色}ボタンで、こぐと\nたくさん食べ物を 使います。\n---\n{引2 1300}"
 },
 {
  "id": "009489",
  "file": "WORLD/AREAE033.EMI",
  "seg": 9,
  "src": "{框22}{色0A}△{/色}ボタンで、船のまわりを\nたんさくします。\n---\n上陸できる島が 近くにある場合は\nその島に上陸します。\n---\n港の近くで{色0A}△{/色}ボタンを おすと\n入港します。\n---\n{引2 1300}",
  "tgt": "{框22}{色0A}按△键探索\n船的四周。\n---\n附近有可登陆的岛时\n就会登上该岛。\n---\n在港口附近按△键\n就会入港。\n---\n{/色}ボタンで、船のまわりを\nたんさくします。\n---\n上陸できる島が 近くにある場合は\nその島に上陸します。\n---\n港の近くで{色0A}△{/色}ボタンを おすと\n入港します。\n---\n{引2 1300}"
 },
 {
  "id": "009490",
  "file": "WORLD/AREAE034.EMI",
  "seg": 11,
  "src": "「すなぶねのうえ",
  "tgt": "「砂船之上"
 },
 {
  "id": "009491",
  "file": "WORLD/AREAE034.EMI",
  "seg": 11,
  "src": "{立绘4200}「くそ‥",
  "tgt": "{立绘4200}「可恶…"
 },
 {
  "id": "009492",
  "file": "WORLD/AREAE034.EMI",
  "seg": 11,
  "src": "{立绘4200}「マーロックの奴‥",
  "tgt": "{立绘4200}「马洛克那家伙…"
 },
 {
  "id": "009493",
  "file": "WORLD/AREAE034.EMI",
  "seg": 11,
  "src": "{立绘4200}「こんな 木箱に\n押しこめて‥\n---\n何が VIPルームだ！",
  "tgt": "{立绘4200}「把我们塞进\n这种木箱…\n---\n还什么VIP包厢！"
 },
 {
  "id": "009494",
  "file": "WORLD/AREAE034.EMI",
  "seg": 11,
  "src": "{立绘0000}「あのなぁ‥\n---\n戦爭してた、敵さんの所へ\nしのびこむんやで‥",
  "tgt": "{立绘0000}「我说啊…\n---\n可要潜进交战的\n敌国去啊…"
 },
 {
  "id": "009495",
  "file": "WORLD/AREAE034.EMI",
  "seg": 11,
  "src": "{立绘0000}「それぐらいの 苦勞は\nガマンしなはれ。",
  "tgt": "{立绘0000}「这点罪\n就忍着吧。"
 },
 {
  "id": "009496",
  "file": "WORLD/AREAE034.EMI",
  "seg": 11,
  "src": "{框05}{立绘0101}「くっ、{码0B}この\nごうつく商人め！",
  "tgt": "{框05}{立绘0101}「可恶，这个\n奸商家伙！{码0B}この\nごうつく商人め！"
 },
 {
  "id": "009497",
  "file": "WORLD/AREAE034.EMI",
  "seg": 11,
  "src": "{框06}{立绘8242}「{特效}{/特效}{码08}ふわ！{码0E}\n---\n",
  "tgt": "{框06}{立绘8242}「呼哇！\n---\n{特效}{/特效}{码08}ふわ！{码0E}\n---\n"
 },
 {
  "id": "009498",
  "file": "WORLD/AREAE034.EMI",
  "seg": 11,
  "src": "{框06}{立绘8342}「に、兄さま\n暴れないで‥！",
  "tgt": "{框06}{立绘8342}「哥、哥哥大人\n别乱动‥！"
 },
 {
  "id": "009499",
  "file": "WORLD/AREAE034.EMI",
  "seg": 11,
  "src": "{立绘8000}「なんで‥、このワイが‥\n---\nあの連中に、金を\n都合してやったか\n分かるか‥？",
  "tgt": "{立绘8000}「知道…本大爷…\n---\n为什么肯掏钱\n给那帮家伙吗…？"
 },
 {
  "id": "009500",
  "file": "WORLD/AREAE034.EMI",
  "seg": 11,
  "src": "{立绘8000}「‥{码0B}‥{码0B}‥\n---\nあいつらは、その內に\nどえらい事を やらかしおる。\n---\nその時には、この果が\nでっかくなって\n返ってくるんや‥",
  "tgt": "{立绘8000}「…{码0B}…{码0B}…\n---\n那帮家伙迟早\n会闹出大事。\n---\n到那时\n这笔钱会\n成倍收回来的…"
 },
 {
  "id": "009501",
  "file": "WORLD/AREAE036.EMI",
  "seg": 12,
  "src": "砂船こーすまっぷう",
  "tgt": "砂船航线路图嗯"
 },
