  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "{占位01}より",
  "tgt": "来自{占位01}"
 },
 {
  "id": "008008",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "この木で作物をそだてるよう\n良いひりょうをあたえて\nほしいよう",
  "tgt": "用这棵树培育作物哟\n希望能给予\n好肥料哟"
 },
 {
  "id": "008009",
  "file": "WORLD/AREAE024.EMI",
  "seg": 8,
  "src": "道具屋です",
  "tgt": "道具屋"
 },
 {
  "id": "008010",
  "file": "WORLD/AREAE024.EMI",
